##------------------------------------------------------------------
## ProcNameStart  : sta_qual_report_summary_libfiles
## ProcArguments  : sta_qual_report_summary_libfiles Xfilename
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_report_summary_libfiles Xfilename {
    global CORNER LINK_PATH
    set start  [date]
    puts "**INFO:: Lib Extraction : [date]"
    echo "#STATUS_PVTRU,#CORNER,#USAGE,#LIB_NAME,#LINK_PATH,#FILE_NAME" > $Xfilename
    set main_collection [sizeof_collection [get_libs *]]
    set i 0
    set j 0
    foreach_in_collection lib [get_libs *] {
        incr i
        incr j
        if { $j >= [expr $main_collection/10 ] } {
            puts "         -- process $i / $main_collection  [date]"
            set j 0
        }
        set lib_path [get_object_name $lib]
        set pvt_p   0
        set pvt_v   0
        set pvt_t   0
        set pvt_rc  0
        set lib_used 0

        foreach process_combo [list sspg ffpg sfg fsg] {
             if { [regexp $process_combo $CORNER] } {
                if { [regexp $process_combo $lib_path] } {
                    set pvt_p "1"
                }
             }
        }

        foreach voltage_combo [list 1p1000v 1p0000v 0p9000v 0p8000v 0p7900v 0p7100v 0p6100v 0p5400v 0p4750v] {
             if { [regexp $voltage_combo $CORNER] } {
                if { [regexp $voltage_combo $lib_path] } {
                    set pvt_v "1"
                }
             }
        }

        foreach temperature_combo [list 125c m25c] {
             if { [regexp $temperature_combo $CORNER] } {
                if { [regexp $temperature_combo $lib_path] } {
                    set pvt_t "1"
                }
             }
        }

        foreach rc_combo [list rcmax cmax cmin rcmin] {
             if { [regexp $rc_combo $CORNER] } {
                if { [regexp "sig$rc_combo" $lib_path] || [regexp "ln05lpe_sc_.*nominal" $lib_path]  } {
                    set pvt_rc "1"
                }
             }
        }


        set count 1
    
        set count [sizeof_collection [get_cells -quiet -of_object [get_lib_cells -quiet $lib_path/*]]]

        if { $count > 0 } { set lib_used 1 }
        set status_word "${pvt_p}${pvt_v}${pvt_t}${pvt_rc}${lib_used}"
        if { [regexp "0...1" $status_word] } { set STATUS "FAILED_$status_word" }
        if { [regexp ".0..1" $status_word] } { set STATUS "FAILED_$status_word" }
        if { [regexp "..0.1" $status_word] } { set STATUS "FAILED_$status_word" }
        if { [regexp "...01" $status_word] } { set STATUS "FAILED_$status_word" }
        if { [regexp "....0" $status_word] } { set STATUS "WAIVED_$status_word" }        
        if { [regexp "1111." $status_word] } { set STATUS "PASSED_$status_word" }

        set path      [get_attr -quiet [get_lib $lib_path] source_file_name]
        regsub -all [file dirname $path] $path {} base_path 
        set link_path $path
        foreach my_link_path $LINK_PATH {
            regsub -all [file dirname $my_link_path] $my_link_path {} tempbase_path 
            if { $tempbase_path == $base_path } {
                set link_path $my_link_path 
                break
            }
        }
        echo "$STATUS,$CORNER,$count,$lib_path,$link_path,$path" >> $Xfilename
        #puts "**STA_LIB_INFO: $lib_path: $path"
    }
    puts "**STA_LIB_INFO: Dumped Lib File as $Xfilename"
    set end  [date]
    puts "**INFO:: Lib Extraction : Start $start"
    puts "**INFO:: Lib Extraction : End   $end"



}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_report_summary_libfiles
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_report_summary_modulecellprofile
## ProcArguments  : sta_qual_report_summary_modulecellprofile BASE_TAG outdir module_list
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_report_summary_modulecellprofile {BASE_TAG outdir module_list} {
    array unset inst_map
    array unset inst_cnt
    array unset cell_map
    array unset cell_col
    array unset cell_split
    
    file mkdir $outdir
    set file_all "$outdir/$BASE_TAG.all.csv"
    set file_clk "$outdir/$BASE_TAG.clk.csv"
    set file_dat "$outdir/$BASE_TAG.dat.csv"
    set file_mim "$outdir/$BASE_TAG.mim.csv"

    set TOP_MODULE [get_object_name [current_design]]
    #------------------------------------------
    # Clock/Data Sub Class Filter
    #------------------------------------------
    # 
    set class_pair  [list  SEQ_MEM:is_memory_cell==true  SEQ_ICG:is_integrated_clock_gating_cell==true  SEQ_FFR:is_rise_edge_triggered==true  SEQ_FFF:is_fall_edge_triggered==true  SEQ_LTP:is_positive_level_sensitive==true  SEQ_LTN:is_negative_level_sensitive==true  SEQ_XXX:is_sequential==true  COM_BUF:ref_name=~*BUF*  COM_DLY:ref_name=~*DLY*  COM_INV:ref_name=~*INV*  COM_MUX:is_mux==true  COM_XXX:is_combinational==true  ]

    set type_pair  [list  CLK:is_clock_network_cell==true  DAT:is_clock_network_cell==false  ]
    #------------------------------------------
    # Top Collection Filter
    #------------------------------------------
    puts "**STA_RPT_INFO:  Start Cell Profiling across $module_list @ [date]"       

    set flat_collection  [get_cells -quiet -hier * -filter "is_hierarchical==false"]
    puts "**STA_RPT_INFO:  End   Cell Collection \[size=[sizeof_collection $flat_collection]\]@ [date]"  
    foreach module [list $TOP_MODULE 0FLAT0] {
        set cell_col($module)  $flat_collection
        set inst_map($module)  "$module"
        set inst_cnt($module)  1
    }

    set flat_libs        [get_lib_cells -of_object $flat_collection]
    puts "**STA_RPT_INFO:  End   Lib  Collection \[size=[sizeof_collection $flat_libs]\]@ [date]"  
    foreach_in_collection xlib $flat_libs {
        set cell_name [lindex [split [get_object_name $xlib] "/"] end]
        set cell_map($cell_name) 1
    }

    #------------------------------------------
    # Module Collection Mapping
    #------------------------------------------
    foreach module $module_list {
        set inst [get_cells -quiet -hier * -filter "ref_name==$module"]
        if { [sizeof_collection $inst] > 0 } {
             foreach_in_collection  x $inst {
                set inst_name                 [get_object_name $x]
                set inst_map($module)         $inst_name
                set inst_cnt($module)         [sizeof_collection $inst]
                set cell_col($module)         [get_cells -quiet $cell_col($TOP_MODULE) -filter "full_name=~$inst_name/*"]
                set cell_col($TOP_MODULE)     [remove_from_collection $cell_col($TOP_MODULE) $cell_col($module)]
             }
        } else {
             puts "**STA_RPT_WARN:  No Valid Inst for @ $module"        
        }
        puts "**STA_RPT_INFO:  End   Cell Filtering \[Module=$module\]@ [date]"  
    }


    #------------------------------------------
    # Lib Cell To Module Collection Mapping
    #------------------------------------------
    puts "**STA_RPT_INFO:  Start Cell Mapping @ [date]"  
    set module_key_split  [lsort -unique [array names inst_map]]
    set cell_key_split    [lsort -unique [array names cell_map]]
    lappend cell_key_split "*"
    set loop_size [llength $cell_key_split];set i 0;set j 0

    echo "LibCell,[join $module_key_split ","]" > $file_all
    echo "LibCell,[join $module_key_split ","]" > $file_clk
    echo "LibCell,[join $module_key_split ","]" > $file_dat
    echo "Module,MIMCount,InstName,CellCount,ClockCellCount,DataCellCount"   > $file_mim


    foreach lib_cell $cell_key_split {
        set data_all "$lib_cell"
        set data_clk "$lib_cell"
        set data_dat "$lib_cell"
        foreach module $module_key_split {
            set mim_cnt   $inst_cnt($module)
            set inst_name $inst_map($module)
            set valid_col         [filter_collection $cell_col($module) "ref_name=~$lib_cell"]
            set cell_col($module) [remove_from_collection $cell_col($module) $valid_col]

            set cell_cnt_all     [sizeof_collection $valid_col]
            set cell_cnt_clk     [sizeof_collection [filter_collection $valid_col "is_clock_network_cell==true"]]
            set cell_cnt_dat     [sizeof_collection [filter_collection $valid_col "is_clock_network_cell==false"]]
                        
            set data_all "$data_all,$cell_cnt_all" 
            set data_clk "$data_clk,$cell_cnt_clk" 
            set data_dat "$data_dat,$cell_cnt_dat" 

            if { $lib_cell == "*" }  { 
                echo "$module,$mim_cnt,$inst_name,$cell_cnt_all,$cell_cnt_clk,$cell_cnt_dat" >> $file_mim
            }
        }
        echo "$data_all" >> $file_all
        echo "$data_clk" >> $file_clk
        echo "$data_dat" >> $file_dat
        # Loop Counter
        incr i;incr j; if { $j >= [expr $loop_size/20 ] } { set j 0; puts "         -- processed $i / $loop_size  [date]" ;}
    }


    #------------------------------------------
    # Release Output
    #------------------------------------------
    puts "**STA_RPT_INFO:  End   Cell Profiling : $outdir/$BASE_TAG*csv [date]"  
     
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_report_summary_modulecellprofile
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_report_summary_mpcmpw
## ProcArguments  : sta_qual_report_summary_mpcmpw args
## ProcDependency :  
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_report_summary_mpcmpw args {
    global MODE CORNER GC_STA_HIER_MAP ssi_sta_tool_unit_dly
    # Default inputs
    array unset inputs
    set inputs(type)     "mpcmpw"
    set inputs(view)     "default.default"
    set inputs(suffix)   ""

    catch { set inputs(view)     "$MODE.$CORNER" }

    # Parse Arguments
    parse_proc_arguments -args $args proc_x_args
    foreach x [array names proc_x_args] {
        regsub -all {\-} $x {} y
        set inputs($y) $proc_x_args($x)
        #puts [format "\t%20s = %-20s %20s" $y $x $proc_x_args($x)]
    }

    # Normalize Dir path
    set inputs(rep_dir) [file normalize $inputs(rep_dir)]
    set suffix $inputs(suffix)

    # Print Arguments
    puts [format "<GC::PROC> Start %-50s  [date]"   "sta_qual_report_summary_mpcmpw : $inputs(rep_dir)" ]
    foreach x [array names inputs] {
        puts [format "\t%20s = %-20s" $x $inputs($x)]
    }
    set delay_type [list]
    if { [regexp "mpc" $inputs(type)] } { lappend delay_type "min_period"}
    if { [regexp "mpw" $inputs(type)] } { lappend delay_type "min_pulse_width"}

    # Create dir
    file mkdir $inputs(rep_dir)

    # Dump Raw Reports
    foreach delay $delay_type {
        # Extract Timing Paths
        report_$delay -all_violators -significant_digits 4 -nosplit  -path_type summary >  $inputs(rep_dir)/.$inputs(base_tag).drv.$delay$suffix.raw
        # Extract Net For Unification
        set in  [open $inputs(rep_dir)/.$inputs(base_tag).drv.$delay$suffix.raw]
        set out [open $inputs(rep_dir)/$inputs(base_tag).drv.$delay$suffix.csv w+]
        puts $out "#start,#end,#req,#act,#slk,#end_clk,#view,#class"
        # MPW
        # sram/CK (low)               0.1999  -0.0459  -0.2458 (VIOLATED)
        # MP
        # sram/CK (coreclk_IF fall)   0.2570   0.2080  -0.0490 (VIOLATED)

        # Pre Flags
        set start 0

        while { [gets $in line] >= 0 } {
            set edge ""
            if { [regexp "fall. " $line] } { set edge "_F"}
            if { [regexp "rise. " $line] } { set edge "_R"}
            if { [regexp "high. " $line] } { set edge "_H"}
            if { [regexp "low. " $line]  } { set edge "_L"}

            regsub -all { fall\)} $line {} line
            regsub -all { rise\)} $line {} line
            regsub -all {\(} $line {} line
            set pin     [lindex  $line  0]
            set end_clk [lindex  $line  1]
            set rt      [lindex  $line  2]
            set at      [lindex  $line  3]
            set slk     [lindex  $line  4]
            set view    $inputs(view)
            # Stop Parsing Flag
            if { $line == ""} {
                set start 0
            }

            # Hier Mapping
            set hierx "TOP"
            foreach virtual_hier [array name GC_STA_HIER_MAP] {
              if {[regexp $virtual_hier $pin] } {
                 set hierx  $GC_STA_HIER_MAP($virtual_hier)
              }
            }

            # Parse lines
            if { $start == "1"} {

                set categ  [get_attr -quiet [get_pins -quiet $pin ] clocks]
                set ref [get_attr -quiet [get_cells -of_object [get_pins $pin]] ref_name]
                if { [sizeof_collection $categ] > 0 } {
                    # Fastest Clock Sorting -start
                    array unset listx
                    foreach_in_collection clk $categ {
                        set periodx [get_attr -quiet $clk period]
                        if { $periodx != ""} {
                           set freq [format "%04.0fMHz" [expr $ssi_sta_tool_unit_dly / $periodx]]
                        } else {
                           set freq [format "%04.0fMHz" "0.00"]
                        }
                        set listx($freq) [get_object_name $clk]
                    }
                    set freq_key [lindex [lsort -decreasing [array name listx]] 0]
                    set fastest_clk  $listx($freq_key)
                    regsub -all {\}} $fastest_clk {} fastest_clk
                    regsub -all {\{} $fastest_clk {} fastest_clk
                    # Fastest Clock Sorting -end
                    set end_clk "${hierx}_${fastest_clk}$edge"

                } else {
                    # Add Slack section -start
                    set is_timed_SU [get_attr -quiet [get_pins -quiet $pin ] max_slack]
                    set is_timed_HD [get_attr -quiet [get_pins -quiet $pin ] min_slack]
                    if { $is_timed_SU == "INFINITY" && $is_timed_HD == "INFINITY"  } {
                      set hierx "${hierx}_UNC"
                    }
                    # Add Slack section -end
                    set end_clk "no_clock.$hierx"
                }
                puts $out "$ref,$pin,$rt,$at,$slk,$end_clk,$view,${delay}"
            }

            # Start Parsing Flag
            if { [regexp "\-\-\-\-\-\-\-\-\-" $pin]  } {
                set start 1
            }
        }
        close $in
        close $out
    }
    puts [format "<GC::PROC> End   %-50s  [date]"   "sta_qual_report_summary_mpcmpw : $inputs(rep_dir)" ]


}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_report_summary_mpcmpw
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_report_summary_path
## ProcArguments  : sta_qual_report_summary_path args
## ProcDependency :  
## ProcInfluence  : 2
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_report_summary_path args {
    global MODE CORNER my_flow_control  GC_STA_HIER_MAP ssi_sta_tool_unit_dly
    # Default inputs
    array unset inputs
    set inputs(max_path)  "100000"
    set inputs(nworst)    "5"
    set inputs(type)      "maxmin"
    set inputs(pba)       "path"
    set inputs(slack_lt)  "-0.0009"
    set inputs(slack_gt)  "-999999"
    set inputs(rpt_type)  "full"
    set inputs(uniq_by)   "end"
    set inputs(dump_json) "0"
    set inputs(suffix)    ""

    set inputs(view)     "default.default"
    catch { set inputs(view)     "$MODE.$CORNER" }

    # Parse Arguments
    parse_proc_arguments -args $args proc_x_args
    foreach x [array names proc_x_args] {
        regsub -all {\-} $x {} y
        set inputs($y) $proc_x_args($x)
        #puts [format "\t%20s = %-20s %20s" $y $x $proc_x_args($x)]
    }

    # Normalize Dir path
    set inputs(rep_dir) [file normalize $inputs(rep_dir)]

    # Print Arguments
    puts [format "<GC::PROC> Start %-50s  [date]"   "sta_qual_report_summary_path : $inputs(rep_dir)" ]
    foreach x [array names inputs] {
        puts [format "\t%20s = %-20s" $x $inputs($x)]
    }
    set delay_type [list]
    if { [regexp "max" $inputs(type)] } { lappend delay_type "max"}
    if { [regexp "min" $inputs(type)] } { lappend delay_type "min"}

    set suffix $inputs(suffix)

    # Create dir
    file mkdir $inputs(rep_dir)
    # Dump Raw Reports
    foreach delay $delay_type {
        # Extract Timing Paths
        #set path_query_method    "single"
        #set path_query_method    "segmented_through"
        set path_query_method    "segmented_filters"
        # Always Query full path clock expanded
        set cmd_string     "get_timing_paths -include_hierarchical_pins -delay $delay -max_path $inputs(max_path) -nworst $inputs(nworst) -slack_lesser_than $inputs(slack_lt) -slack_greater_than $inputs(slack_gt) -pba $inputs(pba) -path_type full_clock_expanded "
        if { $path_query_method == "segmented_through" } {
            # exclusion
            set cmd_string_r2r "$cmd_string -exclude \[get_ports *\]"
            set cmd_string_i2x "$cmd_string -through \[all_inputs -exclude_clock_ports\] -exclude \[all_outputs\]"
            set cmd_string_x2o "$cmd_string -through \[all_outputs\]  -exclude \[all_inputs -exclude_clock_ports\]"
            set cmd_string_i2o "$cmd_string -through \[all_inputs -exclude_clock_ports\] -through \[all_outputs\]"
        } elseif { $path_query_method == "segmented_filters" } {
            # start_end_type
            set cmd_string_r2r "$cmd_string -start_end_type reg_to_reg"
            set cmd_string_i2x "$cmd_string -start_end_type in_to_reg"
            set cmd_string_x2o "$cmd_string -start_end_type reg_to_out"
            set cmd_string_i2o "$cmd_string -start_end_type in_to_out"
        } else {
            # brute_force
            set cmd_string_r2r "$cmd_string"
            set cmd_string_i2r "$cmd_string"
            set cmd_string_r2o "$cmd_string"
            set cmd_string_i2o "$cmd_string"
        }

        # Collection Mapping
        if { [regexp "segmented_" $path_query_method] } {
            # Start Report Query
            set path_collection_r2r [eval $cmd_string_r2r]
            regsub -all {get_timing_paths} $cmd_string_r2r "report_timing -nosplit -path_type summary -significant_digits 4 " cmd_string_r2r
            puts "<CMD::$path_query_method [date] > $cmd_string_r2r"
            eval "$cmd_string_r2r " > $inputs(rep_dir)/$inputs(base_tag).path.$delay$suffix.raw_r2r.rpt

            set path_collection_i2x [eval $cmd_string_i2x]
            regsub -all {get_timing_paths} $cmd_string_i2x "report_timing -nosplit -path_type summary -significant_digits 4 " cmd_string_i2x
            puts "<CMD::$path_query_method [date] > $cmd_string_i2x"
            eval "$cmd_string_i2x " > $inputs(rep_dir)/$inputs(base_tag).path.$delay$suffix.raw_i2x.rpt

            set path_collection_x2o [eval $cmd_string_x2o]
            regsub -all {get_timing_paths} $cmd_string_x2o "report_timing -nosplit -path_type summary -significant_digits 4 " cmd_string_x2o
            puts "<CMD::$path_query_method [date]> $cmd_string_x2o"
            eval "$cmd_string_x2o " > $inputs(rep_dir)/$inputs(base_tag).path.$delay$suffix.raw_x2o.rpt

            set path_collection_i2o [eval $cmd_string_i2o]
            regsub -all {get_timing_paths} $cmd_string_i2o "report_timing -nosplit -path_type summary -significant_digits 4 " cmd_string_i2o
            puts "<CMD::$path_query_method [date]> $cmd_string_i2o"
            eval "$cmd_string_i2o " > $inputs(rep_dir)/$inputs(base_tag).path.$delay$suffix.raw_i2o.rpt

            set  path_collection    $path_collection_r2r
            append_to_collection   -unique  path_collection   $path_collection_i2x
            append_to_collection   -unique  path_collection   $path_collection_x2o
            append_to_collection   -unique  path_collection   $path_collection_i2o

            puts "<CMD::$path_query_method [date]> TotalPaths=[sizeof_collection $path_collection] = R2R + I2R + R2O + I2O = [sizeof_collection $path_collection_r2r] + [sizeof_collection $path_collection_i2x] + [sizeof_collection $path_collection_x2o] + [sizeof_collection $path_collection_i2o]"
        } else {
            # Start Report Query
            set path_collection [eval $cmd_string]
            regsub -all {get_timing_paths} $cmd_string "report_timing -nosplit -path_type summary -significant_digits 4 " cmd_string
            puts "<CMD::$path_query_method [date] > $cmd_string"
            eval "$cmd_string " > $inputs(rep_dir)/$inputs(base_tag).path.$delay$suffix.raw.rpt
            puts "<CMD::$path_query_method [date]> TotalPaths=[sizeof_collection $path_collection] = R2R + I2R + R2O + I2O "
        }

        # Report Streaming
        set out [open $inputs(rep_dir)/$inputs(base_tag).path.${delay}_path$suffix.csv w+]
        if { [regexp "max" $delay] } {
           set out_freq [open $inputs(rep_dir)/$inputs(base_tag).path.${delay}_freq$suffix.csv w+]
           puts $out_freq "#start,#end,#tblock,#slk,#Dfreq,#end_clk,#view,#class,#TFreq,#start_clk"
        }

        array unset uniq_path
        array unset uniq_keys


        puts $out "#start,#end,#tblock,#slk,#norm_slk,#end_clk,#view,#class,#start_clk,#crpr_point,#crpr_L,#crpr_C,#Open_Edge,#Close_Edge"
        foreach_in_collection path  $path_collection {
            set view          $inputs(view)
            set start         [get_object_name [get_attr -quiet $path startpoint]]
            set end           [get_object_name [get_attr -quiet $path endpoint]]
            set slk           [get_attr -quiet $path slack]
            set norm_slk      [get_attr -quiet $path normalized_slack]
	    set crpr_point     "None"
	    set crp_obj       [get_attr -quiet $path crpr_common_point]	
	    if { [sizeof_collection $crp_obj] } {
            	set crpr_point    [get_object_name $crp_obj]

	    }
	    set crpr_L        $crpr_point
            set crp_L_obj     [get_attr -quiet [get_attr  -quiet [get_attr  -quiet $path launch_clock_paths  ]  points ] object ]
	    if { [sizeof_collection $crp_L_obj] } {
	    	catch { set crpr_L   [lindex [get_object_name $crp_L_obj] [expr [lsearch [get_object_name $crp_L_obj] $crpr_point] + 1 ]] }
	    }

	    set crpr_C        $crpr_point
            set crp_C_obj     [get_attr -quiet [get_attr  -quiet [get_attr  -quiet $path capture_clock_paths ]  points ] object ]
	    if { [sizeof_collection $crp_C_obj] } {
	    	catch { set crpr_C   [lindex [get_object_name $crp_C_obj] [expr [lsearch [get_object_name $crp_C_obj] $crpr_point] + 1 ]] }
	    }
                
            set start_edge     [get_attr -quiet $path startpoint_clock_open_edge_value]
            set end_edge       [get_attr -quiet $path endpoint_clock_open_edge_value]

            set xkey "$end"
            # Decide Uniq Key:
            #
            if { $inputs(uniq_by) == "start" } {
                set xkey "$start"
            } elseif {$inputs(uniq_by) == "startend"} {
                set xkey "$start,$end"
            } else {
                set xkey "$end"
            }
            # Check if path is worse or new
            if { ![info exists uniq_keys($xkey)] || ([info exists uniq_keys($xkey)] && $uniq_keys($xkey) > $slk) } {
                # Update
                set uniq_path($xkey) $path
                set uniq_keys($xkey) $slk
                #srt $path
            }
            set run_debug 0
            if { $run_debug == "1"} {
            	if { ![info exists uniq_keys($xkey)]}  {
            	    puts [format "%5s %+0.3f -> %+0.3f %s" "ADD" "0.000" $slk $xkey]
            	    set uniq_path($xkey) $path
            	    set uniq_keys($xkey) $slk
            	} elseif { ([info exists uniq_keys($xkey)] && $uniq_keys($xkey) > $slk) } {
            	    puts [format "%5s %+0.3f -> %+0.3f %s" "UPD" $uniq_keys($xkey) $slk $xkey]
            	    set uniq_path($xkey) $path
            	    set uniq_keys($xkey) $slk
            	} else {
            	    puts [format "%5s %+0.3f -> %+0.3f %s" "SKP" $uniq_keys($xkey) $slk $xkey]
            	}
            }
            # For Hold or non freq paths make it same as slack
            if { $norm_slk == "UNINIT"} {
                set norm_slk $slk;
            }
            if { [sizeof_collection [get_ports -quiet $start]] } {
                set start_block "in"
            } else {
                set start_block "TOP"
            }

            if { [sizeof_collection [get_ports -quiet $end]] } {
                set end_block "out"
            } else {
                set end_block "TOP"
            }
            foreach virtual_hier [array name GC_STA_HIER_MAP] {
              if {[regexp $virtual_hier $start] } {
                 set start_block  $GC_STA_HIER_MAP($virtual_hier)
              }
              if {[regexp $virtual_hier $end] } {
                 set end_block  $GC_STA_HIER_MAP($virtual_hier)
              }
            }


            # Block IO and Interface Mapping
            if { $end_block == $start_block } {
                set tblock "$end_block"
            } else {
                set tblock "$start_block.$end_block"
            }



            # Clock Mapping
            set end_clk       [get_object_name [get_attr -quiet $path endpoint_clock]];
            set start_clk     [get_object_name [get_attr -quiet $path startpoint_clock]];
            if { $end_clk  == ""} {
                set end_clk "no_clock"
            }
            if { $start_clk  == ""} { 
                set start_clk "no_clock"
            }
            # Write Report
            puts $out "$start,$end,$tblock,$slk,$norm_slk,$end_clk,$view,${delay}_path$suffix,$start_clk,$crpr_point,$crpr_L,$crpr_C,$start_edge,$end_edge"

            if { [regexp "max" $delay] } {
                set start_edge     [get_attr -quiet $path startpoint_clock_open_edge_value]
                set end_edge       [get_attr -quiet $path endpoint_clock_open_edge_value]
                set norm_delay     [expr 1.000*(0 + $end_edge -  $start_edge  + 0) ];
                set Tfreq          [format "%0.1f" [expr $ssi_sta_tool_unit_dly/$norm_delay ]]
                set Dfreq          $Tfreq
                catch { set Dfreq  [format "%0.1f" [expr $ssi_sta_tool_unit_dly/($norm_delay - $slk) ]] }
                puts $out_freq "$start,$end,$tblock,$slk,$Dfreq,$end_clk,$view,${delay}_freq$suffix,$Tfreq,$start_clk"
            }

        }
        close $out
        if { [regexp "max" $delay] } { close $out_freq  }


        # Map Uniq worst paths
        set dump_paths_collection [remove_from_collection [get_clocks *] [get_clocks *] ]
        set l_cnt 0
        foreach path_key [array names uniq_path] {
           set dump_paths_collection  [add_to_collection  $uniq_path($path_key) $dump_paths_collection]
           incr l_cnt
        }
        puts [format "<GC::PROC> Start %-50s  [date]"   "sta_qual_report_summary_path : report_timing uniq_paths [sizeof_collection $dump_paths_collection] , while loop count = $l_cnt" ]
        report_timing $dump_paths_collection -include -nets -nosplit -path_type $inputs(rpt_type) -input_pins -crosstalk_delta -capacitance -transition_time  > $inputs(rep_dir)/$inputs(base_tag).path.${delay}_path$suffix.detail.rpt
        puts [format "<GC::PROC> Done %-50s  [date]"   "sta_qual_report_summary_path : report_timing uniq_paths" ]



        # Report Global Summary
        puts [format "<GC::PROC> Start %-50s  [date]"   "sta_qual_report_summary_path : report_global_timing -pba_mode none (GBA)" ]
        report_global_timing  -format {csv wide} -output $inputs(rep_dir)/$inputs(base_tag).path.${delay}_rgt.GBA$suffix.csv -delay $delay -separate_all_groups  -pba none > $inputs(rep_dir)/.$inputs(base_tag).path.${delay}_rgt.GBA$suffix.rpt
        puts [format "<GC::PROC> Done  %-50s  [date]"   "sta_qual_report_summary_path : report_global_timing -pba_mode none (GBA)" ]
        puts [format "<GC::PROC> Start %-50s  [date]"   "sta_qual_report_summary_path : report_global_timing -pba_mode $inputs(pba) (PBA)" ]
        report_global_timing  -format {csv wide} -output $inputs(rep_dir)/$inputs(base_tag).path.${delay}_rgt.$suffix.csv -delay $delay -separate_all_groups  -pba $inputs(pba) > $inputs(rep_dir)/.$inputs(base_tag).path.${delay}_rgt.$suffix.rpt
        puts [format "<GC::PROC> Done %-50s  [date]"   "sta_qual_report_summary_path : report_global_timing -pba_mode $inputs(pba) (PBA)" ]

    }
    puts [format "<GC::PROC> Done %-50s  [date]"   "sta_qual_report_summary_path : $inputs(rep_dir)" ]
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_report_summary_path
