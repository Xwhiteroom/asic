##------------------------------------------------------------------
## ProcNameStart  : autodesign_get_wildcard
## ProcArguments  : autodesign_get_wildcard patternlist nodepat
## ProcDependency :  
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc autodesign_get_wildcard {patternlist nodepat} {
    	regsub -all {[0-9]+} $nodepat {*} nodepat
	foreach pat $patternlist {
		regsub -all $pat $nodepat {*} nodepat
	}
	return $nodepat	
}
