## ProcNameStart  : rtx_clkpin
## ProcArguments  : rtx_clkpin pin maxcone
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc rtx_clkpin {pin maxcone} {

	set all_fanoutx    [all_fanout -from $pin -flat -end -only_cells -trace_arcs all]
	set all_fanoutx_ck [get_pins -of_object $all_fanoutx -filter "is_clock_pin==true"]
	array unset pg_col

	set pg_col(setup_to)   [get_timing_paths -to   $all_fanoutx    -max_path $maxcone -slack_less 0.010 -delay max]
	set pg_col(setup_from) [get_timing_paths -from $all_fanoutx_ck -max_path $maxcone -slack_less 0.010 -delay max]
	set pg_col(hold_to)    [get_timing_paths -to   $all_fanoutx    -max_path $maxcone -slack_less 0.010 -delay min]
	set pg_col(hold_from)  [get_timing_paths -from $all_fanoutx_ck -max_path $maxcone -slack_less 0.010 -delay min]

	set pathout ""
	foreach x [array names pg_col] {
		append_to_collection pathout $pg_col($x)
		puts "\n\n<Paths $x>"
		report_timing $pg_col($x) -nos -path_type end
	}
	puts "\n\n"
	return $pathout
}
##------------------------------------------------------------------
## ProcNameEnd    : rtx_clkpin
##------------------------------------------------------------------


