		set tracey([format "%04d" $xindex]) [format "   %15s {%-s %-s} ;" "remove_buffer" [lindex $x 0] [lindex $y 0]]
		puts "     $tracey([format "%04d" $xindex])"
	}
	puts "\n\n"
	set anno_node   [get_object_name [filter_collection [all_fanout -from [get_pins $cname/* -filter "direction==out"] -flat -pin_level 1] "direction==in"]]
	puts "<CMD> set set_final_pin $anno_node; set push 0.000 ; set dly 0.030 ; set_annotated_transition \$dly \$set_final_pin ;   set_annotated_delay -net \[expr \$dly + \$push\]  -to \$set_final_pin"
	puts "<CMD> set set_final_pin $anno_node"
	puts "<CMD> set set_final_pin $cname"
	puts "<CMD> set_clk_pin_anno 0.030 \$set_final_pin"
	puts "\n\n"
	parray tracey
	puts "\n\n"
	return $chain
}
