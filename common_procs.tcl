##------------------------------------------------------------------
## ProcNameStart  : pt_dmsa_quick_timing_summary
## ProcArguments  : pt_dmsa_quick_timing_summary pba tag ior
## ProcDependency : autodesign_print_stage , sh , quick_timing_summary 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc pt_dmsa_quick_timing_summary {pba tag ior} {
        global pt_dmsa_quick_timing_summary_iter_counter
	if { [info exist pt_dmsa_quick_timing_summary_iter_counter] } {
		incr pt_dmsa_quick_timing_summary_iter_counter
	} else {
		set pt_dmsa_quick_timing_summary_iter_counter 0
	}
	set tag [format "$tag/timing.iter%03d" $pt_dmsa_quick_timing_summary_iter_counter]
        file mkdir $tag
	regsub -all { } $tag {_} tag
        autodesign_print_stage  blue "ReportingIter$pt_dmsa_quick_timing_summary_iter_counter [expr [mem] / (1024*1024)]GB"
        autodesign_print_stage  blue "StartRemoteExecute [expr [mem] / (1024*1024)]GB"
        set cmdx "remote_execute  { quick_timing_summary $pba $tag $ior }"
	redirect -file $tag/run.log { eval $cmdx }
        autodesign_print_stage  blue "EndRemoteExecute [expr [mem] / (1024*1024)]GB"
        redirect      -file $tag.all     { sh cat $tag*csv | sort -u | column -t -s ,                             }
        redirect      -file $tag.sum     { sh cat $tag*csv | sort -u | column -t -s ,   | egrep 'Group'           }
        redirect      -file $tag.csv     { sh cat $tag*csv  }

        redirect  -file $tag.setup   { sh cat $tag*csv | sort -u | column -t -s ,   | egrep 'Group' | egrep -v 'minreg2reg'  }
        redirect  -file $tag.hold    { sh cat $tag*csv | sort -u | column -t -s ,   | egrep 'Group' | egrep -v 'maxreg2reg'  }
        
        redirect         -tee -file $tag.vio    { puts ""  }
        redirect -append -tee -file $tag.vio    { sh cat $tag*csv | sort -u | column -t -s ,   | egrep 'Group' | egrep -v 'minreg2reg|AllClocks.*+0.000'  }
        redirect -append -tee -file $tag.vio    { puts ""  }
        redirect -append -tee -file $tag.vio    { sh cat $tag*csv | sort -u | column -t -s ,   | egrep 'Group' | egrep -v 'maxreg2reg|AllClocks.*+0.000'  }
        redirect -append -tee -file $tag.vio    { puts ""  }


        set $tag.all [file normalize $tag.all]
        set $tag.sum [file normalize $tag.sum]
        set $tag.sum [file normalize $tag.setup]
        set $tag.sum [file normalize $tag.hold]

        set $tag.csv [file normalize $tag.csv]
        autodesign_print_stage  blue "Summarize [expr [mem] / (1024*1024)]GB"
        puts ""
	puts "<Open> :  $tag.all" 
	puts "<Open> :  $tag.sum" 	
	puts "<Open> :  $tag.csv" 	
	puts "<Open> :  $tag.setup" 	
	puts "<Open> :  $tag.hold" 	
	puts "<Open> :  $tag.vio" 	
        puts ""
}
