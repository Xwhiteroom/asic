##------------------------------------------------------------------
## ProcNameStart  : dump_path_group_reports
## ProcArguments  : dump_path_group_reports dir max_path nworst type pg_pair pba_mode slack_lesser_than
## ProcDependency : gettimingpath_dump , get_all_register_split 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc dump_path_group_reports {dir max_path nworst type pg_pair pba_mode slack_lesser_than} {
	suppress_message UITE-479
	suppress_message UITE-416
	suppress_message UITE-502
	if { $pba_mode != "none" & [get_app_var pba_derate_only_mode] == "true" } { 
		set_app_var pba_derate_only_mode "false"; 
		puts "  --- Warn Setting pba_derate_only_mode to false "; 
	}

	file mkdir $dir
	set pg [get_path_groups  *]
	array set endpoints [get_all_register_split]
	array unset pg_map_keep
	array unset pg_map_excl
	set xlist [list ]
	foreach inst_key $pg_pair {
		set inst [lindex [split $inst_key ":"] 0]
		set key  [lindex [split $inst_key ":"] 1]
		set pg_map_keep($key) [list $inst]
		lappend xlist $inst
	}
	set xlist [lsort -u $xlist]
	foreach key [array names pg_map_keep] {
		set data [list]
		foreach key2 [array names pg_map_keep] {
			if { $key != $key2} {
				lappend data $pg_map_keep($key2)
			}
		}
		set pg_map_excl($key) $data
		puts "\t$pg_map_keep($key)\t=\t$pg_map_excl($key)"
	}
	#return 0
	set max_iter_count [sizeof_collection $pg] 
	set cur_iter_count 0
	foreach_in_collection grp $pg {
		incr cur_iter_count
		set group [get_object_name $grp]
		set start [lindex [split $group "\."] 0]
		set end   [lindex [split $group "\."] 2]
		set comment "xxxxx"
		puts "**Info:: Started  GroupID $cur_iter_count of $max_iter_count [date]"
		if { $start == $end } {

			foreach class [list dflop latch cgate async] {
				set comment "intra_$class"
				set col [get_timing_paths  -group $grp -to $endpoints($class) -pba_mode $pba_mode -nworst $nworst -max_path $max_path -delay_type $type -slack_lesser_than $slack_lesser_than -exclude $pg_map_excl($start)]
				gettimingpath_dump $col $dir/$group.$comment.$type.rpt $comment.$group
			}


			foreach class [list dflop latch cgate async] {
				set comment "loop_$class"
				set col [get_timing_paths   -group $grp -to $endpoints($class) -pba_mode $pba_mode -nworst $nworst -max_path $max_path -delay_type $type -slack_lesser_than $slack_lesser_than -through $pg_map_excl($start)]
				gettimingpath_dump $col $dir/$group.$comment.$type.rpt $comment.$group
			}

		
	        } elseif {[regexp "default" $group] } {
			        set comment "global"
				set col [get_timing_paths   -group $grp -pba_mode $pba_mode -nworst $nworst -max_path $max_path -delay_type $type -slack_lesser_than $slack_lesser_than]
				gettimingpath_dump $col $dir/$group.$comment.$type.rpt $comment.$group
		
		} else {
			foreach class [list dflop latch cgate async] {
				set comment "inter_$class"
				set col [get_timing_paths   -group $grp -to $endpoints($class) -pba_mode $pba_mode -nworst $nworst -max_path $max_path -delay_type $type -slack_lesser_than $slack_lesser_than]
				gettimingpath_dump $col $dir/$group.$comment.$type.rpt $comment.$group
			}
		}
		puts "**Info:: Complete GroupID $cur_iter_count of $max_iter_count [date]\n"

	}
	unsuppress_message UITE-479
	unsuppress_message UITE-416
	unsuppress_message UITE-502

}
##------------------------------------------------------------------
## ProcNameEnd    : dump_path_group_reports
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : dump_procs
## ProcArguments  : dump_procs outdir args
## ProcDependency : get_proc_def , alias , parray , get_proc_dependency 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc dump_procs {outdir args} {
    file mkdir          $outdir/alias
    file mkdir          $outdir/procs
    file mkdir          $outdir/master
    file mkdir          $outdir/renamed_procs
    
    array unset name_remap
    set name_remap(None) None
    if { [lindex $args 0] != ""} {
        array unset name_remap
        set patterns [split [lindex $args 0] ";" ]
        foreach pattern $patterns {
            set search_pat  [lindex [split $pattern "," ] 0]
            set replace_pat [lindex [split $pattern "," ] 1]
            set name_remap($search_pat) $replace_pat
        }
    }

    puts "    Proc Rename Patterns : "
    parray name_remap
    puts ""

    set  procs_list     [lsort -dictionary [info procs]]
    set  procs_skipped  [list]
    set  alias_list     ""
    catch { redirect -variable alias_list {alias} }
	

    # Create Proc Dependency Chain
    array unset proc_dependency_data 
    array unset proc_dependency_score    
    array unset proc_order
    array unset proc_dependency_rename 
    array unset proc_is_rename 
    array unset proc_data
    array unset proc_args


    # Iterate Through Each Proc For One Time Dependency
    foreach procx $procs_list {

        # Proc Dependecy
        set proc_dependency_data($procx) [get_proc_dependency $procx]
        set proc_data($procx)            ""
        catch { set proc_data($procx)    [get_proc_def $procx]}
        set proc_args($procx)            [info args $procx]
        
        # Rename Loop
        set renamed_procx                $procx
        set proc_is_rename($procx)       0
        foreach xpattern [array names name_remap] {
            regsub -all $xpattern $renamed_procx $name_remap($xpattern) renamed_procx ; # Change Proc Name
        } 

        # Rename Data Link
        set proc_dependency_data($renamed_procx)        $proc_dependency_data($procx)
        set proc_data($renamed_procx)                   $proc_data($procx)
        set proc_args($renamed_procx)                   $proc_args($procx)

        foreach xpattern [array names name_remap] {
            regsub -all $xpattern $proc_dependency_data($renamed_procx) $name_remap($xpattern) proc_dependency_data($renamed_procx) ; # Change Proc Dependency
            regsub -all $xpattern $proc_data($renamed_procx) $name_remap($xpattern) proc_data($renamed_procx) ; # Change Proc Dependency
            regsub -all $xpattern $proc_args($renamed_procx) $name_remap($xpattern) proc_args($renamed_procx) ; # Change Proc Dependency

        } 

        # Rename Map
        set proc_dependency_rename($procx) $renamed_procx
        if { $renamed_procx != $procx } {
            set proc_is_rename($procx) 1
        }
    

        # Dependency Score
        if { ![info exist proc_dependency_score($procx)] } {
            set proc_dependency_score($procx)          0
            #set proc_dependency_score($renamed_procx) 0
        }

        foreach dependent $proc_dependency_data($procx) {
            if { [info exist proc_dependency_score($dependent)] } {
                set proc_dependency_score($dependent) [expr 1 + $proc_dependency_score($dependent)]
            } else {
                set proc_dependency_score($dependent) 1                
            }
        }
    }


    set proc_name_score        [array get proc_dependency_score]
    set sorted_proc_name_score [lsort -stride 2 -index 1 -integer $proc_name_score]
    
    # File Operations
    set  p2  [open "$outdir/procs/user_procs.tcl"               w+]
    set  p2x [open "$outdir/renamed_procs/user_procs.tcl"       w+]
    set  p4  [open "$outdir/procs/skipped_procs.tcl"            w+]
    set  p5  [open "$outdir/master/master.tcl"                  w+]
    set  p5x [open "$outdir/master/master_renamed.tcl"          w+]

    foreach procx $procs_list {
        set renamed_procx $proc_dependency_rename($procx)
        set data          $proc_data($procx)
        set renamed_data  $proc_data($renamed_procx)
       
        set proc_header   [list]
        lappend proc_header "##------------------------------------------------------------------"
        lappend proc_header "## ProcNameStart  : $procx"
        lappend proc_header "## ProcArguments  : $procx $proc_args($procx)"
        lappend proc_header "## ProcDependency : [join $proc_dependency_data($procx) { , } ] "
        lappend proc_header "## ProcInfluence  : $proc_dependency_score($procx)"
        lappend proc_header "## ProcRenamed    : $proc_is_rename($procx)"
        lappend proc_header "##------------------------------------------------------------------"
 

        set renamed_proc_header   [list]
        lappend renamed_proc_header "##------------------------------------------------------------------"
        lappend renamed_proc_header "## ProcNameStart  : $renamed_procx"
        lappend renamed_proc_header "## ProcArguments  : $renamed_procx $proc_args($renamed_procx)"
        lappend renamed_proc_header "## ProcDependency : [join $proc_dependency_data($renamed_procx) { , } ] "
        lappend renamed_proc_header "## ProcInfluence  : $proc_dependency_score($procx)"
        if { $proc_is_rename($procx) == "1" } {
            lappend renamed_proc_header "## ProcRenamed    : $proc_is_rename($procx) / From=$procx"
        } else {
            lappend renamed_proc_header "## ProcRenamed    : $proc_is_rename($procx)"            
        }
        lappend renamed_proc_header "##------------------------------------------------------------------"

        set proc_footer   [list]
        lappend proc_footer "##------------------------------------------------------------------"
        lappend proc_footer "## ProcNameEnd    : $procx"        
        lappend proc_footer "##------------------------------------------------------------------"

        set renamed_proc_footer   [list]
        lappend renamed_proc_footer "##------------------------------------------------------------------"
        lappend renamed_proc_footer "## ProcNameEnd    : $renamed_procx"        
        lappend renamed_proc_footer "##------------------------------------------------------------------"

        # Filter Loop 
        if { $data == "" } {
            puts "    -- Skip Writing Proc :  $procx (protected)" 
	    lappend procs_skipped $procx
	    puts $p4 "$procx --Skipped"
        } else {
            # Protected Proc
            if { [info body $procx] == "" } {
		puts $p4 "$procx --Protected"
	    }

            # Original Loop
            set  p1  [open "$outdir/procs/$procx.tcl" w+]
            foreach ptr [list $p1 $p2] {
                puts $ptr [join $proc_header "\n" ] 
                puts $ptr $data
            }
            puts $ptr [join $proc_footer "\n" ] 
            puts $ptr "\n"
            close $p1

            # Rename Loop Loop
            set  p1x [open "$outdir/renamed_procs/$renamed_procx.tcl" w+] 
            foreach ptr [list $p1x $p2x] {
                puts $ptr [join $renamed_proc_header "\n" ] 
                puts $ptr $renamed_data
            }
            puts $ptr [join $renamed_proc_footer "\n" ] 
            puts $ptr "\n"
            close $p1x
        }
    }  
    close $p2
    close $p2x

    set  p3 [open "$outdir/alias/user_alias.tcl" w+]
    puts $p3 "##------------------------------------------------------------------"
    puts $p3 "## Aliases"
    puts $p3 "##------------------------------------------------------------------"
    foreach aliasx [lsort [split $alias_list "\n"]] {
        puts $p3 "alias $aliasx"
    }
    puts $p3 "alias upprocs source \[info script\]"
    puts $p3 "alias upprocs_dmsa remote_execute {source \[info script\]}"

    close $p3
    close $p4

    
    foreach filex [list $outdir/alias/user_alias.tcl $outdir/procs/user_procs.tcl] {
	puts $p5 "\n\n##==================================================================="
   	puts $p5 "##  [lindex [file split [file normalize $filex]] end]"
	puts $p5 "##===================================================================\n"

	set infile [open $filex] 
        while { [gets $infile x] >= 0 } {
		puts $p5 $x
	}
    }
    close $p5

    foreach filex [list $outdir/alias/user_alias.tcl $outdir/renamed_procs/user_procs.tcl] {
	puts $p5x "\n\n##==================================================================="
   	puts $p5x "##  [lindex [file split [file normalize $filex]] end]"
	puts $p5x "##===================================================================\n"

	set infile [open $filex] 
        while { [gets $infile x] >= 0 } {
		puts $p5x $x
	}
    }
    close $p5x



    puts "    Open dir  : [file normalize $outdir/procs]" 
    puts "    Open file : [file normalize $outdir/procs/user_procs.tcl]" 
    puts "    Open file : [file normalize $outdir/alias/user_alias.tcl]" 
    puts "    Open file : [file normalize $outdir/procs/skipped_procs.tcl]" 

}
##------------------------------------------------------------------
## ProcNameEnd    : dump_procs
