##------------------------------------------------------------------
## ProcNameStart  : sta_qual_set_ft_port_delay
## ProcArguments  : sta_qual_set_ft_port_delay dlypct latency io_clockx in_port_name out_port_name
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_set_ft_port_delay {dlypct latency io_clockx in_port_name out_port_name} {
    global synopsys_program_name pt_shell_mode
    global sta_qual_clock_period_db
    #if { [info exists ::synopsys_program_name] } {
    #    remove_input_delay $in_port_name
    #    remove_output_delay $out_port_name
    #} else {
    #    reset_input_delay $in_port_name
    #    reset_output_delay $out_port_name
    #}
    foreach_in_collection io_clock [get_clocks -quiet $io_clockx] {
        if { [info exists sta_qual_clock_period_db($io_clock)] } {
            set period $sta_qual_clock_period_db($io_clock)
            puts "For IO delay taking period from internal database $io_clock"
        } else {
            set period    [get_attribute [get_clocks $io_clock] period]
        }
        set io_clock  [get_object_name $io_clock]
        set_input_delay  0 -clock $io_clock [get_ports $in_port_name] -add
        set_output_delay 0 -clock $io_clock [get_ports $out_port_name] -add

        # Setting MCP from in to out to mask invalid timing wrt core_clk
        puts "set_multicycle_path 10 -setup -from $in_port_name -to $out_port_name"
        set_multicycle_path 10 -setup -from $in_port_name -to $out_port_name
        puts "set_multicycle_path  9 -hold  -from $in_port_name -to $out_port_name"
        set_multicycle_path  9 -hold  -from $in_port_name -to $out_port_name

        # Set max/min delay constraint
        set dlyval   [expr ($period * $dlypct) + $latency]
        puts "set_max_delay $dlyval -from [get_object_name [get_clocks $io_clock]] -through $in_port_name -through $out_port_name -to [get_object_name [get_clocks $io_clock]]"
        set_max_delay $dlyval -from [get_clocks $io_clock] -through $in_port_name -through $out_port_name -to [get_clocks $io_clock]
    }

}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_set_ft_port_delay
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_set_load_transition
## ProcArguments  : sta_qual_set_load_transition 
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_set_load_transition {} {

    global sta_qual_clock_src_db sta_qual_driver_transition
    global sta_qual_output_load  sta_qual_input_load
    foreach {key val} [array get sta_qual_clock_src_db] { lappend values $val }
    if { ! [info exists values] } {
        set values "scf_not_applicable"
    }
    set defined_clock_ports [get_ports -quiet $values]
    set defined_data_ports        [remove_from_collection [get_ports *] $defined_clock_ports]
    set_input_transition $sta_qual_driver_transition [filter_collection $defined_data_ports "direction==in"]
    #puts "#CMD set_load -max $sta_qual_output_load [get_object_name [all_outputs]]"
    set_load -max $sta_qual_output_load [all_outputs]
    #puts "#CMD set_load -min 0 [get_object_name [all_outputs]]"
    set_load -min 0 [all_outputs]
    #puts "#CMD set_load -max -pin_load $sta_qual_input_load [get_object_name [all_inputs]]"
    set_load -max -pin_load $sta_qual_input_load [all_inputs]
    #puts "#CMD set_load -min -pin_load $sta_qual_input_load [get_object_name [all_inputs]]"
    set_load -min -pin_load $sta_qual_input_load [all_inputs]

}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_set_load_transition
