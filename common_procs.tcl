##------------------------------------------------------------------
## ProcNameStart  : autodesign_pt_audit
## ProcArguments  : autodesign_pt_audit args
## ProcDependency : autodesign_print_stage , autodesign_pte_warnings , autodesign_validate_spec , autodesign_gspan_mapping , autodesign_check_timing , autodesign_unclocked_registers 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc autodesign_pt_audit args {
    global MODE CORNER SCENARIO sta_qual_global_repo  NETLIST XCORNER
    # Default inputs
    array unset inputs
    set inputs(dft_clocks)   [list *idft* GENOCC* *tessent*] 
    set inputs(checks)       "unclocked.pte.check_timing.validate_spec.clock_relation.gspan_spec"
    set inputs(view)         "default.default"
    set inputs(mssage_list)  [list PTE-075 UITE-461 PTE-053]

    catch { set inputs(view) "$SCENARIO" }

    # Parse Arguments
    autodesign_print_stage red  [format "\n\n<AUTDESIGN_AUDIT> User Arguements MEM=[expr [mem]/ (1024*1024)]GB" ]
    parse_proc_arguments -args $args proc_x_args
    foreach x [array names proc_x_args] {
        regsub -all {\-} $x {} y
        set inputs($y) $proc_x_args($x)
        puts [format "\t%20s = %-20s %20s" $y $x $proc_x_args($x)]
    }

    set design_name [get_object_name [current_design]]
    file mkdir $inputs(rep_dir) 
    set inputs(rep_dir_ext) $inputs(rep_dir)/$design_name/$inputs(view)
    file mkdir $inputs(rep_dir_ext)

    # Total Checks : 26
    array unset check_results

    # Check 01 GSPAN Freq Match
    if { [regexp "gspan_spec" $inputs(checks)] } {
    	set check "gspan_spec"
	# Check 01
	autodesign_print_stage red  [format "\n\n<AUTDESIGN_AUDIT> GSPAN Clock Spec Check MEM=[expr [mem]/ (1024*1024)]GB" ]
    	redirect -tee  -file $inputs(rep_dir_ext)/$check.log { set result [autodesign_gspan_mapping "u_$design_name" $XCORNER $inputs(rep_dir_ext)] }
    	set check_results(01_$check) [list "[lindex $result 0],[lindex $result 1]" "Verify GSPAN freq in sheet for $XCORNER."] 
    }


    # Check 02 + 12 Check Timing Category Wise
    if { [regexp "check_timing" $inputs(checks)] } {
    	set check "check_timing"
	# Check 02
	autodesign_print_stage red  [format "\n\n<AUTDESIGN_AUDIT> CheckTiming Check MEM=[expr [mem]/ (1024*1024)]GB" ]
    	redirect -tee  -file $inputs(rep_dir_ext)/$check.log { set result [autodesign_check_timing $inputs(rep_dir_ext)] }
    	set check_results(02_$check) [list "[lindex $result 0],[lindex $result 1]" "Review check_timing report for voltage_crossings, unclocked, unconst, clock propagation, loops"] 
	# Check 12
	set virtual_clocks [get_object_name [filter_collection [get_clocks *] "undefined(sources)"]]
	if { [llength $virtual_clocks] == 0 } { set virtual_clocks "Clean/No_VirtualClocks" }
        set check_results(12_$check) [list $virtual_clocks "All Virtual Clocks not intented to be virtual clocks - period missing or source missing."]
    }

    # Check 03 Master Cock Not reaching Gen
    if { [regexp "pte" $inputs(checks)] } {
    	set check "pte"
	autodesign_print_stage red  [format "\n\n<AUTDESIGN_AUDIT> Clock Check MEM=[expr [mem]/ (1024*1024)]GB" ]
    	redirect -tee  -file $inputs(rep_dir_ext)/$check.log { set result [autodesign_pte_warnings $inputs(rep_dir_ext) $inputs(mssage_list)] }
    	set check_results(03_$check) [list "[lsearch -all  -inline  -regexp [lindex $result 0] "PTE.075*"],[lindex $result 1]" "Master Clock Not Reaching GenClk"]
    }
     	
    # Check 04 + 05 Unclocked DFT/ Func
    if { [regexp "unclocked" $inputs(checks)] } {
	set check "unclocked"
	autodesign_print_stage red  [format "\n\n<AUTDESIGN_AUDIT> Unclocked Check MEM=[expr [mem]/ (1024*1024)]GB" ]
	redirect -tee  -file $inputs(rep_dir_ext)/$check.log { set result [autodesign_unclocked_registers $inputs(rep_dir_ext) $inputs(dft_clocks) $inputs(view)] }
	set check_results(04_$check) [list "[lindex $result 0],[lindex $result 2]" "no_clock (after removing all DFT/TESSANT Clocks)"]
	set check_results(05_$check) [list "[lindex $result 1],[lindex $result 3]" "no_clock (after removing all non DFT/TESSANT Clocks )"]
    }

    # Check 06-11 Validate Spec
    if { [regexp "validate_spec" $inputs(checks)] } {
    	set check "validate_spec"
	autodesign_print_stage red  [format "\n\n<AUTDESIGN_AUDIT> Validate Spec Check MEM=[expr [mem]/ (1024*1024)]GB" ]
    	redirect -tee  -file $inputs(rep_dir_ext)/$check.log { set result [autodesign_validate_spec $inputs(rep_dir_ext)] }
    	set check_results(06_$check) [list [lsearch -all  -inline  -regexp $result "clock_ports"] "How many shared external PLL/Ref clk ports do you have and are they all clocked ?"]
    	set check_results(07_$check) [list [lsearch -all  -inline  -regexp $result "ll"]  "How many FLLs/PLLs do you have in your LPCM  and are they all clocked with correct freq? Look under column PVT/DutyCycle/Div/PhaseDeg/Type"]
    	set check_results(08_$check) [list [lsearch -all  -inline  -regexp $result "lpcm"] "Are all LPCM wrappers seeing intended clocks/Freq reaching their inputs? Look under column PVT/DutyCycle/Div/PhaseDeg/Type for direction in"]
    	set check_results(09_$check) [list [lsearch -all  -inline  -regexp $result "lpcm"] "Are all LPCM wrappers seeing intended clocks/Freq reaching their inputs? Look under column PVT/DutyCycle/Div/PhaseDeg/Type for direction out"]
    	set check_results(10_$check) [list [lsearch -all  -inline  -regexp $result "div_or"] "How many dividers do you have are they all reviewed for clocks/freq ? Look under column PVT/DutyCycle/Div/PhaseDeg/Type for direction out"]
    	set check_results(11_$check) [list [lsearch -all  -inline  -regexp $result "lpcm"] "Are all boundary static pins for LPCM Wrapper reviewed ? Look for Static0/Static1"]
    }

    # Check 17 Clock Relation
    if { [regexp "clock_relation" $inputs(checks)] } {
    	set check "clock_relation"
	autodesign_print_stage red  [format "\n\n<AUTDESIGN_AUDIT> Clock Relationship Spec Check MEM=[expr [mem]/ (1024*1024)]GB" ]
    	redirect -tee  -file $inputs(rep_dir_ext)/$check.log { set result [autodesign_clock_relation $inputs(rep_dir_ext)] }
    	set check_results(17_$check) [list [lsearch -all  -inline  -regexp $result "Group"] "Clock grouping for review ? Look for P0=SameSrcAsync|DiffSrcSync|DiffSrcPhyEx P1=SameSrcPhyEx  P2=SameSrcSync|DiffSrcAsync"]
    }




    autodesign_print_stage red  [format "\n\n<AUTDESIGN_AUDIT> Final Summary MEM=[expr [mem]/ (1024*1024)]GB" ]
    # Result Query
    foreach categ  [lsort [array names check_results]] {
	autodesign_print_stage blue [format "            %-30s | %-150s | %-s" "$categ" "[lindex $check_results($categ) 1]"  "[lindex $check_results($categ) 0]"]
    }
}
##------------------------------------------------------------------
## ProcNameEnd    : autodesign_pt_audit
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : autodesign_pte_warnings
## ProcArguments  : autodesign_pte_warnings outdir list_messages
## ProcDependency : autodesign_print_stage , print_message_info 
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc autodesign_pte_warnings {outdir list_messages} {
	set design_name [get_object_name [current_design]]
	set outdir $outdir
	file mkdir $outdir
	set outdir [file normalize $outdir]
	autodesign_print_stage blue [format "\n\n=============================================================================================" ]
	autodesign_print_stage red  [format "<SDC_GEN> : Created o/p directory %s"  "$outdir"]
	set filter_tag "pte_warning"
	autodesign_print_stage blue [format "\n\n=============================================================================================" ]
	redirect -tee -file 	$outdir/$filter_tag.rpt  {print_message_info}
	set result [list]
    	foreach x $list_messages {
    		redirect -var result_pte_075 {print_message_info -id $x}
    		set result_typ [lindex [split [join $result_pte_075 ","] ","] 7]
    		set result_pub [lindex [split [join $result_pte_075 ","] ","] 10]
    		set result_sup [lindex [split [join $result_pte_075 ","] ","] 11]
		regsub -all {^$} $result_pub {0} result_pub
		regsub -all {^$} $result_sup {0} result_sup
		if { $result_pub == 0 && $result_sup == 0 } { set x "Clean/$x" }
		lappend result "$x:$result_typ/Pub=$result_pub/Sup=$result_sup"
    	}
	set status [list $result "<OUTDIR>/$filter_tag.rpt"]
	autodesign_print_stage blue [format "=============================================================================================" ]
	autodesign_print_stage red  [format "<SDC_GEN> : Completed Report Generation for  $design_name  $status"]
	autodesign_print_stage blue [format "            [file normalize $outdir/$filter_tag.rpt]"]
	autodesign_print_stage blue [format "            <CMD> sh wc -l [file normalize $outdir]/$filter_tag.*"]
	autodesign_print_stage blue [format "=============================================================================================" ]
	return $status
}
