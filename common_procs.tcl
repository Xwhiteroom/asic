##------------------------------------------------------------------
## ProcNameStart  : lt_map
## ProcArguments  : lt_map div_index_data
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc lt_map div_index_data {
	global ss_module
	set div_index_data_sub [list]
        foreach div_index $div_index_data {
            foreach modx [array names ss_module] {
		if { $ss_module($modx) != "/" && $ss_module($modx) != "" } {
	        	regsub -all "$ss_module($modx)" $div_index "\${${modx}_hier}" div_index
		}
	    }
            lappend div_index_data_sub $div_index
        }
	return [lsort -unique $div_index_data_sub]
}
##------------------------------------------------------------------
## ProcNameEnd    : lt_map
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : lt_mapc
## ProcArguments  : lt_mapc div_index_data
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc lt_mapc div_index_data {
	global ss_module
	set div_index_data_sub [list]
        foreach div_index $div_index_data {
            foreach modx [array names ss_module] {
		if { $ss_module($modx) != "/" && $ss_module($modx) != "" } {
	        	regsub -all "$ss_module($modx)" $div_index "\${${modx}_hier}" div_index
		}
	    }
	    regsub -all {\d+} $div_index "*" div_index
            lappend div_index_data_sub $div_index
        }
	return [lsort -unique $div_index_data_sub]
}
