##------------------------------------------------------------------
## ProcNameStart  : report_delay_slack_pins
## ProcArguments  : report_delay_slack_pins col fanout slack_max delay_th data_clock cell_net
## ProcDependency : puts_tee 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc report_delay_slack_pins {col fanout slack_max delay_th data_clock cell_net} {
	set out_file "temp.report_delay_slack_pins.F$fanout.S$slack_max.D$delay_th.$data_clock.$cell_net.tcl"
        set ptr [open  $out_file w+]
	puts_tee $ptr "**Info :: Base     Collection size_original\t\t[sizeof_collection $col]"
	set col_base        [get_pins $col -filter "is_hierarchical==false"]
	puts_tee $ptr "**Info :: Filtered Collection Non_Hier_Pin\t\t[sizeof_collection $col_base]"
	set col_base_inp    [get_pins $col_base     -filter "direction == in"]
	puts_tee $ptr "**Info :: Filtered Collection Direction=in\t\t[sizeof_collection $col_base_inp]"
	set col_with_slk    [get_pins $col_base_inp -filter "max_slack < $slack_max"]
	puts_tee $ptr "**Info :: Filtered Collection Slk<=$slack_max\t\t[sizeof_collection $col_with_slk]"
	set col_with_slk_fo [get_pins $col_with_slk -filter "fanout_load >= $fanout"]
	puts_tee $ptr "**Info :: Filtered Collection Min_Fanout>=$fanout\t\t[sizeof_collection $col_with_slk_fo]"
	if { $data_clock == "data"} { 
		set col_with_slk_fo [get_pins $col_with_slk_fo -filter "is_clock_pin == false"]
		puts_tee $ptr "**Info :: Filtered Collection Class>=$data_clock\t\t[sizeof_collection $col_with_slk_fo]"
	} elseif { $data_clock == "clock"} {
		set col_with_slk_fo [get_pins $col_with_slk_fo -filter "is_clock_pin == true"]
		puts_tee $ptr "**Info :: Filtered Collection Class>=$data_clock\t\t[sizeof_collection $col_with_slk_fo]"
	}
	
	if { $cell_net == "cell" ||  $cell_net == "cell_net" } 	{
		set cellarcs_col [get_timing_arcs -from $col_with_slk_fo -filter "delay_max >= $delay_th"]
		puts_tee $ptr "**Info :: Filtered Collection ArcDly>=$delay_th\t\t[sizeof_collection $cellarcs_col]"
		set final_col $cellarcs_col
	}
	if { $cell_net == "net"  || $cell_net == "cell_net" } 	{
		set netarcs_col  [get_timing_arcs -to   $col_with_slk_fo -filter "delay_max >= $delay_th"]
		puts_tee $ptr "**Info :: Filtered Collection NetDly>=$delay_th\t\t[sizeof_collection $netarcs_col]"
		set final_col $netarcs_col
	}
	
	if { $cell_net == "cell_net" } 	{
		set final_col [add_to_collection $netarcs_col $cellarcs_col]
	}



	puts $ptr [format "%10s %10s %10s %10s %10s %10s %10s %10s %s %s" "#Type" "#Disabled" "#DlyMax" "#DlyMaxR-F" "#DlyMin" "#DlyMinR-F" "#SiMax" "#SiMin"  "#To_Pin" "#From_Pin"]
	set out_col   [remove_from_collection $final_col $final_col]
	foreach_in_collection arc $final_col {
		#puts_tee $ptr "[get_object_name [get_attr $arc to_pin]]"
		set out [report_arx $arc]
		if { [lindex $out 8] != [lindex $out 9] } {
			set out_col [add_to_collection $out_col $arc]	
			puts $ptr [format "%10s %10s %10s %10s %10s %10s %10s %10s %s %s"  [lindex $out 0] [lindex $out 1] [lindex $out 2] [lindex $out 3] [lindex $out 4] [lindex $out 5] [lindex $out 6] [lindex $out 7] [lindex $out 8] [lindex $out 9] ]	
		}
	}
	puts_tee $ptr "**Info :: Filtered Collection AllArcs\t\t[sizeof_collection $final_col]"
	puts_tee $ptr "**Info :: Filtered Collection RealArcs\t\t[sizeof_collection $out_col]"
	close $ptr
	puts "**Info :: Open file $out_file\n"
	return $out_col
}
