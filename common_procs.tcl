##------------------------------------------------------------------
## ProcNameStart  : get_overload
## ProcArguments  : get_overload cells
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc get_overload cells {
global CORNER
set corner CORNER
	set xcells [get_cells -quiet $cells]
    	foreach_in_collection xcell $xcells {
    		set cell     [get_object_name  $xcell]
    		set in_tran  [lindex [lsort [get_attr [get_pin $cell/* -filter "direction==in"] actual_transition_max]] end]
    		set out_tran [lindex [lsort [get_attr [get_pin $cell/* -filter "direction==out"] actual_transition_max]] end]
		set ref      [get_attr [get_cell $cell] ref_name]
		set pc_10_in [expr 0.2*$in_tran]
		set diff     [expr $out_tran - $in_tran]
                set comment  "NORMAL"
		if { $diff > 0 } { set comment "POOR"}
		if { $diff < 0 } { set comment "GOOD"}
		if { $diff > 0 && $diff > $pc_10_in } { set comment "VERYPOOR"}
		set Sslack "x.xxx"
		set Hslack "x.xxx"
		if { [regexp "POOR" $comment] } {
			catch {set Sslack [format  "%0.3f" [lindex [lsort [get_attr [get_pins $cell/*] max_slack] ] 0]]}
			catch {set Hslack [format  "%0.3f" [lindex [lsort [get_attr [get_pins $cell/*] min_slack] ] 0]]}
	    	}
    		puts [format "#Data %0.3f -> %0.3f %30s %20s %20s | size_cell %s %20s" $in_tran $out_tran "$comment,S->$Sslack,H->$Hslack" $corner $ref $cell $ref]
	}	
}
