##------------------------------------------------------------------
## ProcNameStart  : sta_qual_report_timing
## ProcArguments  : sta_qual_report_timing file_out path_collection args
## ProcDependency :  
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_report_timing {file_out path_collection args} {
    global CORNER MODE
    echo "#Startpin,#Endpin,#Start_Clk.#End_Clk,#Slack,#Norm_Slack,#End_Clk,#View,#Class,#Data_Dly,#Skew,#CRPR,#Pre_Skew,#Post_Skew,#Lib_Req,#Start_SRC,#End_SRC" > $file_out
    if { [sizeof_collection $path_collection] < 1 } {    
        set path_collection [eval "get_timing_paths $args"]
        echo "**INFO: Created Base     Path Collection as : [sizeof_collection $path_collection]  <CMD>  get_timing_paths/report_timing $args"
    } else { 
        echo "**INFO: Using   Existing Path Collection as : [sizeof_collection $path_collection]  <CMD>  get_timing_paths/report_timing $args"
    }



    catch { set view_flow "$CORNER.$MODE"}
    foreach_in_collection path $path_collection {
            set view     [get_attr -quiet $path scenario_name]                        
            if { $view == "" } {  set view     $view_flow    }
            if { $view == "" } {  set view     "default"     }
            set start         [get_object_name [get_attr -quiet $path startpoint]]
            set end           [get_object_name [get_attr -quiet $path endpoint]]
            set start_clk     [get_object_name [get_attr -quiet $path startpoint_clock]];
            set end_clk       [get_object_name [get_attr -quiet $path endpoint_clock]];
            set start_clk_src [get_object_name [get_attr -quiet [get_clocks $start_clk] sources]];
            set end_clk_src   [get_object_name [get_attr -quiet [get_clocks $end_clk] sources]];
            set start_clk_mst [get_object_name [get_attr -quiet [get_clocks $start_clk] master_pin]];
            set end_clk_mst   [get_object_name [get_attr -quiet [get_clocks $end_clk] master_pin]];
            set crpr_point    [get_object_name [get_attr -quiet $path crpr_common_point]]
            set path_type     [get_attr -quiet $path path_type]
            set class_factor   "1" 
            set use_factor     "1" 
            set launch         "late" 
            set capture        "early" 
            set launch_attr    "max" 
            set capture_attr   "min"
            if { $start_clk_mst == "" } { set start_clk_mst $start_clk_src}
            if { $end_clk_mst   == "" } { set end_clk_mst   $end_clk_src  }


            if { $path_type == "max" } { 
                set class_factor   "-1"      ; set use_factor     "1";
                set launch         "late"    ; set capture        "early";
                set launch_attr    "max"     ;  set capture_attr  "min"
            } else {
                set class_factor   "1"       ; set use_factor     "0";
                set launch         "early"   ; set capture        "late";
                set launch_attr    "min"     ;  set capture_attr  "max"
            }
            #Base Info
            #echo "View    : $view"
            #echo "Class   : $path_type"
            #echo "Start   : $start @ $start_clk"
            #echo "End     : $end @ $end_clk"

            # Slack
            set slk           [get_attr -quiet $path slack]
            set norm_slk      [get_attr -quiet $path normalized_slack]
            set norm_dly      [get_attr -quiet $path normalized_delay]
            if { $norm_dly == "" } { set norm_dly 1 ; set norm_slk $slk }
            
            # Skew
            set crpr          [get_attr -quiet $path common_path_pessimism]            
            set start_lat     [get_attr -quiet $path startpoint_clock_latency]
            set end_lat       [get_attr -quiet $path endpoint_clock_latency]


            set start_edge    [get_attr -quiet $path startpoint_clock_open_edge_type]
            set end_edge      [get_attr -quiet $path endpoint_clock_open_edge_type]
            set launch_edge    "pos_edge" 
            set capture_edge   "pos_edge"
            if { $start_edge == "rise" } { 
                set launch_edge    "pos_edge"
            } else {
                set launch_edge    "neg_edge"
            }
            if { $end_edge == "rise" } { 
                set capture_edge    "pos_edge"
            } else {
                set capture_edge    "neg_edge"
            }

            #Default Value
            set start_clk_arr [get_attr -quiet [get_clocks $start_clk] clock_source_latency_${launch}_${start_edge}_${launch_attr}]
            set end_clk_arr   [get_attr -quiet [get_clocks $end_clk  ] clock_source_latency_${capture}_${end_edge}_${capture_attr}]

            set window    [get_attr [get_pins -quiet $start_clk_src] arrival_window]
            if { $window == "" } {
                set window    [get_attr [get_ports -quiet $start_clk_src] arrival_window]                
            }
            regsub -all {\{} $window {}  window
            regsub -all {\}} $window {}  window
            if { $window != ""} {
                    set window_arr [split $window " "]
                    set i 0
                    while {$i < [llength $window_arr] } {
                        set data [lrange $window_arr $i [expr $i + 7]]
                        set i [expr $i+8]
                        if { [lindex $data 0] == $start_clk_mst &  [lindex $data 1] == $launch_edge} {
                            if {      $launch_edge == "pos_edge" & $launch_attr == "min"  } {
                                set start_clk_arr [lindex $data 3]
                            } elseif {$launch_edge == "neg_edge" & $launch_attr == "min" } {
                                set start_clk_arr [lindex $data 4]
                            } elseif {$launch_edge == "pos_edge" & $launch_attr == "max" } {
                                set start_clk_arr [lindex $data 6]
                            } elseif {$launch_edge == "neg_edge" & $launch_attr == "max" } {
                                set start_clk_arr [lindex $data 7]
                            }
                        }
                    }
            }


            set window    [get_attr [get_pins -quiet $end_clk_src] arrival_window]
            if { $window == "" } {
                set window    [get_attr [get_ports -quiet $end_clk_src] arrival_window]                
            }
            regsub -all {\{} $window {}  window
            regsub -all {\}} $window {}  window
            if { $window != ""} {
	            set window_arr [split $window " "]
	            set i 0
	            while {$i < [llength $window_arr] } {
	                set data [lrange $window_arr $i [expr $i + 7]]
	                set i [expr $i+8]
	                if { [lindex $data 0] == $end_clk_mst &  [lindex $data 1] == $capture_edge} {
	                    if {      $capture_edge == "pos_edge" & $capture_attr == "min"  } {
	                       set end_clk_arr [lindex $data 3]
	                    } elseif {$capture_edge == "neg_edge" & $capture_attr == "min" } {
	                       set end_clk_arr [lindex $data 4]
	                    } elseif {$capture_edge == "pos_edge" & $capture_attr == "max" } {
	                       set end_clk_arr [lindex $data 6]
	                    } elseif {$capture_edge == "neg_edge" & $capture_attr == "max" } {
	                       set end_clk_arr [lindex $data 7]
	                    }
	                }
	            }
            }	

            set skew          [expr 0 + $end_lat     - $start_lat + $crpr + 0]
            set skew_S1       [expr 0 + $end_clk_arr - $start_clk_arr + 0]
            set skew_S2       [expr 0 + $end_lat     - $start_lat - $skew_S1 + 0 ]




            # Data 
            set arr_time      [get_attr -quiet $path arrival]
            set data_dly      [expr $arr_time -  $start_lat]
            
            # Required
            set req_time      [get_attr -quiet $path required]            
            set lib_time1     [get_attr -quiet $path endpoint_hold_time_value];
            set lib_time2     [get_attr -quiet $path endpoint_setup_time_value];
            set lib_time3     [get_attr -quiet $path endpoint_removal_time_value];
            set lib_time4     [get_attr -quiet $path endpoint_recovery_time_value]
            set lib_time      [expr $class_factor*(0 + $lib_time1 + $lib_time2 + $lib_time3 + $lib_time4 + 0)]
            set uncert        [get_attr -quiet $path clock_uncertainty]
            set margin        [expr $req_time - $end_lat - $crpr - $lib_time + 0 ]
            
            # Phase
            set start_clk_ph  [get_attr -quiet $path startpoint_clock_open_edge_value];
            set end_clk_ph    [get_attr -quiet $path endpoint_clock_open_edge_value];

            # Back Calculation
            set AT_x          [expr $start_clk_ph + $start_lat + $data_dly ]
            set RT_x          [expr $end_clk_ph   + $end_lat   + $crpr  + $margin + $lib_time ]
            set Bslk          [expr $class_factor*($AT_x - $RT_x)]
            set adjustslk     [expr $slk - $Bslk]

            # Verbose  
            #report_timing -nets -input_pins -path_type full_clock_expanded -nos $path 
            # Key Points
            echo "View    : $view"
            echo "Class   : $path_type"
            echo "Start   : $start @ $start_clk"
            echo "End     : $end @ $end_clk"
            echo "Start_S : $start_clk_src @ $start_clk_mst @ $start_clk_arr using clock_source_latency_${launch}_${start_edge}_${launch_attr}"
            echo "End_S   : $end_clk_src @ $end_clk_mst @ $end_clk_arr using clock_source_latency_${capture}_${end_edge}_${capture_attr}"
            echo "Common  : $crpr_point"
            echo "Slack   : $slk @ $norm_slk/$norm_dly"
            echo "Base    : AT=$arr_time |  RT=$req_time" 
 
            # Timing Equation
            echo [format "Equation: PH= %+0.3f > LP= %+0.3f > DP= %+0.3f > SL= %+0.3f"              $start_clk_ph  $start_lat $data_dly $slk ]
            echo [format "Equation: PH= %+0.3f > CP= %+0.3f > CR= %+0.3f > MR= %+0.3f > LB= %+0.3f" $end_clk_ph    $end_lat   $crpr     $margin $lib_time]
            echo [format "BackCalc: AT= %+0.3f   RT= %+0.3f   SK= %+0.3f   UN= %+0.3f > AD= %+0.3f (SL~ %+0.3f + %+0.3f)" $AT_x $RT_x $skew $uncert $adjustslk $Bslk $adjustslk]
            echo [format "SplitDly: DP= %+0.3f   S1= %+0.3f   S2= %+0.3f   CR= %+0.3f > SK= %+0.3f" $data_dly $skew_S1 $skew_S2 $crpr $skew]
            set clock_groupx  "$start_clk:$end_clk"
            regsub -all {:coreclk} $clock_groupx {} clock_groupx
            if { $start_clk == $end_clk } { set clock_groupx "INTRA|$end_clk"}
            if { $start_clk != $end_clk } { set clock_groupx "INTER|$clock_groupx"}

            echo "$start,$end,$clock_groupx,$slk,$norm_slk,$end_clk,$view,max_path,$data_dly,$skew,$crpr,$skew_S1,$skew_S2,$lib_time,$start_clk_src,$end_clk_src" >> $file_out
    }
    echo "Completed File [file normalize $file_out]"
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_report_timing
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_rt
## ProcArguments  : sta_qual_rt args
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_rt args {
    set cmd "redirect  -variable rpt_var       { report_timing  -nosplit  $args  }"
    set cmd "redirect  -file     temp.file_var { report_timing  -nosplit  $args  }"

    puts "# $cmd"
    #echo "$cmd"   > temp.file_var
    eval "$cmd"
    #source "./temp.file_var"
    set crpr     none
    set startc   none
    set endc     none
    set infile [open ./temp.file_var ]
    while { [gets $infile x] >= 0 } {
        if { [regexp $crpr $x] && $crpr != "none"} {
            puts "\033\[1;31m$x"
        } elseif { [regexp "<-" $x]} {
            puts "\033\[1;35m$x\033\[1;34m"
        } elseif { [regexp " $startc" $x] && $startc != "none" && $endc != "none"} {
            puts "\033\[1;34m$x"
        } elseif { [regexp " $endc" $x] && $endc != "none"} {
            puts "\033\[1;34m$x\033\[0m"
        } elseif { [regexp "data arrival" $x]} {
            puts "\033\[0m$x"
        } else {
            puts "$x"
        }    

        if { [regexp "Last common pin:" $x]} { 
            set crpr [lindex $x end]; 
            #regsub -all {\[|\]} $crpr {.} crpr ; 
            #regsub -all {\]} $crpr {\\]} crpr ;
            regsub -all {\[|\]} $crpr {.} crpr ; 
        }
        
        if { [regexp "Startpoint:" $x]} { 
            set startc [lindex $x 1]; 
            #regsub -all {\[} $startc {\\[} startc ; 
            #regsub -all {\]} $startc {\\]} startc ;
            regsub -all {\[|\]} $startc {.} startc ;
            set crpr "none"
            set endc "none"           
        }

        if { [regexp "Endpoint:" $x]} { 
            set endc [lindex $x 1]; 
            #regsub -all {\[} $endc {\\[} endc; 
            #regsub -all {\]} $endc {\\]} endc;   
            regsub -all {\[|\]} $endc {.} endc ;             
        }
    }    
    close $infile
    #puts "\033\[1;34mStart: $startc\033\[0m"
    #puts "\033\[1;34m  End: $endc\033\[0m"
    #puts "\033\[1;31m CRPR: $crpr\033\[0m"
    puts -nonewline "\033\[1;31m\033\[0m"
    #
    #echo $rpt_var
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_rt
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_rtc
## ProcArguments  : sta_qual_rtc args
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_rtc args {
    set cmd "redirect  -variable rpt_var       { report_timing  -nosplit  $args  }"
    set cmd "redirect  -file     temp.file_var { report_timing  -nosplit  $args  }"

    puts "# $cmd"
    #echo "$cmd"   > temp.file_var
    eval "$cmd"
    #source "./temp.file_var"
    set crpr     none
    set startc   none
    set endc     none
    set logic    none

    set infile [open ./temp.file_var ]
    while { [gets $infile x] >= 0 } {
        #31 Red
        #34 Blue
        #35 Magenta
        
        # ADD CODE TO skip common path
        if { [regexp "(rise edge)" $x] || [regexp "(fall edge)" $x] } { 
            set logic 1            
        }
        if { ([regexp " r$" $x] ||  [regexp " f$" $x] ||  [regexp " r " $x] ||  [regexp " f " $x]) && $logic != "none" && ([regexp $crpr $x] || $crpr == "none") } {
            set logic none
        } elseif { ([regexp "(net)" $x] || [regexp " r$" $x] ||  [regexp " f$" $x] ||  [regexp " r " $x] ||  [regexp " f " $x]) && $logic != "none"} {
          continue
        }



        if { [regexp $crpr $x] && $crpr != "none"} {
            puts "\033\[1;31m$x"
        } elseif { [regexp "<-" $x]} {
            puts "\033\[1;35m$x\033\[1;34m"
        } elseif { [regexp " $startc" $x] && $startc != "none" && $endc != "none"} {
            puts "\033\[1;34m$x"
        } elseif { [regexp " $endc" $x] && $endc != "none"} {
            puts "\033\[1;34m$x\033\[0m"
        } elseif { [regexp "data arrival" $x]} {
            puts "\033\[0m$x"
        } else {
            puts "$x"
        }    


        if { [regexp "Last common pin:" $x]} { 
            set crpr [lindex $x end]; 
            #regsub -all {\[|\]} $crpr {.} crpr ; 
            #regsub -all {\]} $crpr {\\]} crpr ;
            regsub -all {\[|\]} $crpr {.} crpr ; 
        }
        
        if { [regexp "Startpoint:" $x]} { 
            set startc [lindex $x 1]; 
            #regsub -all {\[} $startc {\\[} startc ; 
            #regsub -all {\]} $startc {\\]} startc ;
            regsub -all {\[|\]} $startc {.} startc ;
            set crpr "none"
            set endc "none"          
        }

        if { [regexp "Endpoint:" $x]} { 
            set endc [lindex $x 1]; 
            #regsub -all {\[} $endc {\\[} endc; 
            #regsub -all {\]} $endc {\\]} endc;   
            regsub -all {\[|\]} $endc {.} endc ;             
        }


    }    
    close $infile
    #puts "\033\[1;34mStart: $startc\033\[0m"
    #puts "\033\[1;34m  End: $endc\033\[0m"
    #puts "\033\[1;31m CRPR: $crpr\033\[0m"
    puts -nonewline "\033\[1;31m\033\[0m"
    #
    #echo $rpt_var
}
