##------------------------------------------------------------------
## ProcNameStart  : cellcasestat
## ProcArguments  : cellcasestat col_pat
## ProcDependency : puts_tee 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc cellcasestat col_pat {
    set cells [get_cells -quiet $col_pat]
    set xfile "temp_cellcasestat.info_hier.tcl"
    set out_p [open $xfile w+]
    set place_holder 1; proc x_sort_clock {clocks} {
        set clocks [get_clocks $clocks]
        set listx [list]
        foreach_in_collection clk $clocks {
                if { [sizeof_collection [get_attr -quiet $clk sources]] > 0 && [get_attr -quiet $clk is_generated] == false} {
                        lappend listx "[get_attr -quiet $clk period],[get_object_name $clk]"

                }
        }
        set listx [lsort -increasing $listx]
        return $listx    
    }
    if { [sizeof_collection $cells ] > 0 } {
        array unset max_length
        set max_length(ref)  10
        set max_length(name) 20
        set max_length(area)  5
        set max_length(xy)    5
        set max_length(clk)  10
        set max_length(tieoff)  30
        set max_length(casepro)  30

        set data_x [list]
        #set data_x [list "Area Loc Ref Clock Cell"]
        foreach_in_collection cell [get_cells $cells] {
            set name [get_object_name $cell]
            set clk  [lindex [split [lindex [ x_sort_clock [get_attr -quiet [get_pins $name/*] clocks]] 0] "," ] 1]
            set area [format "%0.3f" [get_attr $cell area]]
            set ref  [get_attr $cell ref_name]
            set x1   "0"
            set y1   "0"
            set caseval_pins [get_pins $name/* -filter "case_value==1     || case_value==0"]
            set xstatic_pins [get_pins $name/* -filter "constant_value==1 || constant_value==0"]
            set tie_offs $xstatic_pins
            set case_pro [remove_from_collection $caseval_pins $xstatic_pins]
            set tie_off_str ""
            foreach_in_collection HL_pin $tie_offs {
                set a [get_object_name $HL_pin]
                set b [lindex [split $a "/"] end]
                set v [get_attr $HL_pin constant_value]
                set tie_off_str "$tie_off_str,$b:$v"
            }
            regsub -all {^,} $tie_off_str {} tie_off_str
            set case_pro_str ""
            foreach_in_collection HL_pin $case_pro {
                set a   [get_object_name $HL_pin]
                set b   [lindex [split $a "/"] end]
                set v   [get_attr $HL_pin case_value]
                set src [get_object_name [filter_collection [all_fanin -to $HL_pin -flat -startpoints_only -trace_arcs all ] "case_value==1     || case_value==0" ]]
                #set src_str "" 
                #foreach c $src {
                #    set src_str "$c:$src_str"
                #}
                set case_pro_str "$case_pro_str,$b:$v:$src"
            }
            regsub -all {^,} $case_pro_str {} case_pro_str
  
              


            catch {set x1 [format "%0.0f" [expr [get_attr -quiet $ret "x_coordinate_max"] / 1000]]}
            catch {set y1 [format "%0.0f" [expr [get_attr -quiet $ret "y_coordinate_max"] / 1000]]}
	    set xy "$x1,$y1"
            if { [string length $name] > $max_length(name)} { set max_length(name) [string length $name] }
            if { [string length $ref] > $max_length(ref)}   { set max_length(ref)  [string length $ref ] }
            if { [string length $area] > $max_length(area)} { set max_length(area) [string length $area] }
            if { [string length $xy] > $max_length(xy)}     { set max_length(xy)   [string length $xy  ] }
            if { [string length $clk] > $max_length(clk)}   { set max_length(clk)  [string length $clk  ] }

            if { [string length $tie_off_str] > $max_length(tieoff)}   { set max_length(tieoff)  [string length $tie_off_str  ] }
            if { [string length $case_pro_str] > $max_length(casepro)}   { set max_length(casepro)  [string length $case_pro_str  ] }

	    lappend data_x "$area $xy $ref $clk $name $tie_off_str $case_pro_str"

        }   
        set dash_line "+[string repeat - $max_length(area)]+[string repeat - $max_length(xy)]+[string repeat - $max_length(ref)]+[string repeat - $max_length(clk)]+[string repeat - $max_length(name)]+[string repeat - $max_length(tieoff)]+[string repeat - $max_length(casepro)]+"
        set  i -1
        foreach data [lsort $data_x] {
            incr i
            if { $i == 0 } { 
                puts_tee $out_p $dash_line                
                set xdata [list Area Loc Ref Clock Cell Tie_Offs_PIN.VAL Case_Propagated_PIN.VAL.PORTS]
                puts_tee $out_p [format "|%-$max_length(area)s|%-$max_length(xy)s|%-$max_length(ref)s|%-$max_length(clk)s|%-$max_length(name)s|%-$max_length(tieoff)s|%-$max_length(casepro)s|" [lindex $xdata 0] [lindex $xdata 1] [lindex $xdata 2] [lindex $xdata 3] [lindex $xdata 4] [lindex $xdata 5] [lindex $xdata 6]]
                puts_tee $out_p $dash_line
            }
            set xdata [split $data " "]            
            puts_tee $out_p [format "|%-$max_length(area)s|%-$max_length(xy)s|%-$max_length(ref)s|%-$max_length(clk)s|%-$max_length(name)s|%-$max_length(tieoff)s|%-$max_length(casepro)s|" [lindex $xdata 0] [lindex $xdata 1] [lindex $xdata 2] [lindex $xdata 3] [lindex $xdata 4] [lindex $xdata 5] [lindex $xdata 6]]
        }
        puts_tee $out_p $dash_line        
    }
    incr i    
    close $out_p
    puts "**Open File : $i cells $xfile"
}
