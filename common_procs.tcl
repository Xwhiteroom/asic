##------------------------------------------------------------------
## ProcNameStart  : inv_path_id_map_loop
## ProcArguments  : inv_path_id_map_loop path idx inv_filex index_j
## ProcDependency : get_path_node_trace_list , inv_timing_points_split , inv_xreport_timing 
## ProcInfluence  : 2
## ProcRenamed    : 0
##------------------------------------------------------------------
proc inv_path_id_map_loop {path idx inv_filex index_j} {
       # Import Global to Local Map
       set j    $index_j 
       # Xreport Data Parsing 
       redirect -variable xreport_timing_var {inv_xreport_timing $path }
       redirect -file $inv_filex {puts $xreport_timing_var }
       # Summary Data	
       set paths_data "$inv_filex,$idx,[lindex [split $xreport_timing_var "\n"] end-2 ]"
       set paths_head "#File,#PathID,[lindex [split $xreport_timing_var "\n"] end-3 ]"
       # Node Data
       set slack               [get_attr -quiet $path slack]
       set return_point_data   [inv_timing_points_split  [get_attr -quiet $path timing_points] "" "" 0]
       set nodetrace           [lindex $return_point_data 7]
       set nodecsv             [get_path_node_trace_list $nodetrace $j $inv_filex $idx $slack]
       set inv_node_data       [list]	
       set csv_head            [lindex [lindex $nodecsv 0] 0]
       if { $j == 0 }          {lappend inv_node_data "$csv_head" ;}
       set j                   [lindex $nodecsv 1]
       foreach x [lrange [lindex $nodecsv 0] 1 end] {
         lappend inv_node_data  "$x"
       }
       return [list $j $paths_head $paths_data $inv_node_data]
}
