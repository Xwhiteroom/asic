##------------------------------------------------------------------
## ProcNameStart  : get_cross_clock
## ProcArguments  : get_cross_clock all_clocks target_clock slack_less_than delay_type max_paths dir
## ProcDependency : sh 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc get_cross_clock {all_clocks target_clock slack_less_than delay_type max_paths dir} {
	file mkdir $dir
	set tag [lindex [get_object_name $target_clock] 0]
	echo "#ClockA,#ClockB,#Size_A_to_B,#Size_B_to_A" 		> $dir/$tag.summary.txt
	echo "#startclk,#endclk,#startpoint,#endpoint,#slack"		> $dir/$tag.verbose.csv			
	
	foreach_in_collection clk1 [get_clocks $all_clocks] {
		if { [get_object_name $clk1] !=  [get_object_name [get_clocks $target_clock]] } {
			set paths_a2b [get_timing_paths -from [get_clocks $clk1] -to   [get_clocks $target_clock] -slack_lesser_than $slack_less_than -delay $delay_type -max_paths $max_paths]
			set paths_b2a [get_timing_paths -to   [get_clocks $clk1] -from [get_clocks $target_clock] -slack_lesser_than $slack_less_than -delay $delay_type -max_paths $max_paths]
			echo "[get_object_name $clk1],[get_object_name $target_clock],[sizeof_collection $paths_a2b],[sizeof_collection $paths_b2a]" >> $dir/$tag.summary.txt
			set paths_a2b [add_to_collection $paths_a2b $paths_b2a]
			foreach_in_collection path $paths_a2b {
				set endpoint   [get_object_name [get_attr $path endpoint]]
				set startpoint  [get_object_name [get_attr $path startpoint]]
				set eclk    [get_object_name [get_attr $path endpoint_clock]]
				set sclk    [get_object_name [get_attr $path startpoint_clock]]
				set slack   [get_attr $path slack]
				echo "$sclk,$eclk,$startpoint,$endpoint,$slack"	>> $dir/$tag.verbose.csv
			}
		}
	}
	sh tree $dir
}
##------------------------------------------------------------------
## ProcNameEnd    : get_cross_clock
