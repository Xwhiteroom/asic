##------------------------------------------------------------------
## ProcNameStart  : autodesign_print_supported_procs
## ProcArguments  : autodesign_print_supported_procs 
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc autodesign_print_supported_procs {} {
	set procs_in_scope  [lsort [info proc autodesign*]]
	foreach x $procs_in_scope {
		puts  [format "                           - \033\[34m%-40s \033\[31m%-s\033\[0m" $x "[info args $x]"]
	}
	set x autodesign_print_supported_procs
	puts  [format "                           - \033\[34m%-40s \033\[31m%-s\033\[0m" $x ""]
}
