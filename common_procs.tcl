## ProcNameStart  : autodesign_get_static_val
## ProcArguments  : autodesign_get_static_val node
## ProcDependency :  
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc autodesign_get_static_val node {
  global synopsys_program_name
  set case_val ""
  if { [info exist synopsys_program_name] } {
	set case_val [get_attribute -quiet  $node case_value]
  } else {
	set case_val [get_attribute -quiet  $node constant_value]
  }
  return $case_val	
}
