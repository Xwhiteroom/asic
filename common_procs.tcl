##------------------------------------------------------------------
## ProcNameStart  : idrv
## ProcArguments  : idrv in_pins
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc idrv in_pins {
    set all  "IDRV DATA ::"
    foreach in_pin $in_pins {
    set pin $in_pin
    set net [get_object_name [all_connected $in_pin]	]
    set net_res_h [get_attribute [get_nets -quiet $net] net_resistance_max]
    set net_cap_h [get_attribute [get_nets -quiet $net] total_capacitance_max]
    set driver  [get_object_name [get_attribute  -quiet [get_nets -quiet $net] leaf_drivers]]
    set d_cell  [get_attribute  -quiet [get_cells -of_objects [get_pins -quiet $driver]] ref_name]
    set d_fan  [sizeof_collection [get_attribute  -quiet  [get_nets -quiet $net] leaf_loads]]
    set load_per_fan "NA"
    set res_per_fan "NA"
    catch {set load_per_fan [expr $net_cap_h/$d_fan]	}
    catch {set res_per_fan [expr  $net_res_h/$d_fan]	}
    set d_pin_tran    [get_attr -quiet [get_pins -quiet $driver] actual_transition_max]
    set d_pin_tran_lt [get_attr -quiet [get_pins -quiet $driver] constraining_max_transition]
    set l_pin_tran    [get_attr -quiet [get_pins -quiet  $pin] actual_transition_max]
    set l_pin_tran_lt [get_attr -quiet [get_pins -quiet  $pin] constraining_max_transition]

    set data "\n\tDriver:: $driver {Cell = $d_cell F/O = $d_fan Cap/fan = $load_per_fan  Res/fan = $res_per_fan } -->\n\t\tNet:: $net {$net_res_h (KOhm) $net_cap_h (fF) } --> Tran $d_pin_tran {$d_pin_tran_lt} to $l_pin_tran {$l_pin_tran_lt}\n\t\t\tLoad:: $pin\n"
    puts $data
    set all "$all\n$data";
}
    return $all
}
