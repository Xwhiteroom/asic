##------------------------------------------------------------------
## ProcNameStart  : autodesign_get_clock_group_mapping
## ProcArguments  : autodesign_get_clock_group_mapping clks
## ProcDependency : autodesign_get_clock_relationship 
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc autodesign_get_clock_group_mapping clks {
	set clks1 [get_clocks -quiet $clks]
	set clks2 [get_clocks -quiet $clks]
	array unset attr_map
	set attr_map({synchronous})          "S"
	set attr_map({asynchronous})         "A"
	set attr_map({physically_exclusive}) "P"
	set attr_map({logically_exclusive})  "L"
	set attr_map(synchronous)            "S"
	set attr_map(asynchronous)           "A"
	set attr_map(physically_exclusive)   "P"
	set attr_map(logically_exclusive)    "L"
	set attr_map(default)                "S"
	set sync_id 0
	array unset clock_map
	foreach_in_collection clk1 $clks1 {
		set clk1_name [get_object_name $clk1]
		if { ! [info exist clock_map($clk1_name)] } {
			incr sync_id
			set  clockgrp [format "S%04d" "$sync_id"]
			#set  clockgrp "$clk1_name"
			set  clock_map($clk1_name) $clockgrp
		} else {
			set  clockgrp $clock_map($clk1_name)
		}
		foreach_in_collection clk2 [remove_from_collection $clks2 $clk1] {
			set clk2_name 	   [get_object_name $clk2]
			set relation       [autodesign_get_clock_relationship [list $clk1_name $clk2_name]]
			set relation_class "S"
			if { [info exist attr_map($relation)] } { 
				set relation_class $attr_map($relation) 
			} else {
				set relation_class $attr_map(default) 
			}
			if { $relation_class == "S" } {
				set clock_map($clk2_name) $clockgrp
			}
 			#puts "$clk1_name $clk2_name : $relation_class : $clock_map($clk1_name.S)"		
		}
	}
	set output [list ]
	foreach id [array name clock_map] {
		#puts "$id :  $clock_map($id)"
		lappend output "$id:$clock_map($id)"
	}
	return $output
}
##------------------------------------------------------------------
## ProcNameEnd    : autodesign_get_clock_group_mapping
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : autodesign_get_clock_group_table
## ProcArguments  : autodesign_get_clock_group_table clks
## ProcDependency : autodesign_print_stage , autodesign_get_clock_relationship , parray 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc autodesign_get_clock_group_table clks {
	set clks1 [get_clocks -quiet $clks]
	set clks2 [get_clocks -quiet $clks]
	array unset attr_map
	set attr_map({synchronous})          "S"
	set attr_map({asynchronous})         "A"
	set attr_map({physically_exclusive}) "P"
	set attr_map({logically_exclusive})  "L"
	set attr_map(synchronous)            "S"
	set attr_map(asynchronous)           "A"
	set attr_map(physically_exclusive)   "P"
	set attr_map(logically_exclusive)    "L"
	set attr_map(default)                "S"
	set sync_id 0
	array unset clock_map
	foreach_in_collection clk1 $clks1 {
		set clk1_name [get_object_name $clk1]
		if { ! [info exist clock_map($clk1_name)] } {
			incr sync_id
			set  clockgrp [format "S%04d" "$sync_id"]
			#set  clockgrp "$clk1_name"
			set  clock_map($clk1_name) $clockgrp
		} else {
			set  clockgrp $clock_map($clk1_name)
		}
		foreach_in_collection clk2 [remove_from_collection $clks2 $clk1] {
			set clk2_name 	   [get_object_name $clk2]
			set relation       [autodesign_get_clock_relationship [list $clk1_name $clk2_name]]
			set relation_class "S"
			if { [info exist attr_map($relation)] } { 
				set relation_class $attr_map($relation) 
			} else {
				set relation_class $attr_map(default) 
			}
			if { $relation_class == "S" } {
				set clock_map($clk2_name) $clockgrp
			}
 			#puts "$clk1_name $clk2_name : $relation_class : $clock_map($clk1_name.S)"		
		}
	}
	set design_name [get_object_name [current_design ]]
	array unset datax

	foreach id [array name clock_map] {
		if { ![info exist datax($clock_map($id))] } {
			set datax($clock_map($id)) " | "	
		}
		set old $datax($clock_map($id))
		set datax($clock_map($id)) "$old  [format "%-50s|" "([sizeof_collection [all_register -clock $id]]) $id "]"
		
	}
	
	autodesign_print_stage blue [format "=============================================================================================" ]
	autodesign_print_stage red  [format "<AUTODESIGN> : Clock Path Mapping"]
	autodesign_print_stage blue [format "=============================================================================================\n" ]
	parray datax
	autodesign_print_stage blue [format "=============================================================================================\n" ]

}
##------------------------------------------------------------------
## ProcNameEnd    : autodesign_get_clock_group_table
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : autodesign_get_clock_ports
## ProcArguments  : autodesign_get_clock_ports ports
## ProcDependency : autodesign_sort_clocks , autodesign_puts_tee 
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc autodesign_get_clock_ports ports {
    global ssi_sta_tool_unit_dly
	catch { suppress_message SEL-003}
	catch { suppress_message ATTR-3}
	set is_ptime [info exists synopsys_program_name]
        set xfile "autodesign_get_clock_ports.info.tcl"
        set out_p [open $xfile w+]
	

	set port_collection [get_ports $ports]
	set data [list]
 	set registers   [get_cells -hierarchical -filter "is_sequential==true && is_hierarchical==false"]
	set filter_base $registers
	set my_design   [get_object_name [current_design]]
 	set pading      [expr 5 + [string length $my_design]]
 	set pading2     [expr 7 + [string length $my_design]]
	
	set chktim ""
	set unclocked_pins  "NA"
	# Synopsys
        catch {  redirect -variable chktim { check_timing -override_defaults no_clock } ; }  
	if { [regexp  "Warning: There are (\[0-9]+) register clock pins with no clock" $chktim] } {
		set unclocked_pins [lindex [split  [lsearch -inline -all [split $chktim "\n"] "Warning*"] " "] 3]
	}
	# Cadence
	if { $unclocked_pins == "NA" ||  $is_ptime == "0"} {
        	catch {  redirect -variable chktim { check_timing  } ; }  
	}

	if { [regexp  "clock pins without clock waveform" $chktim] } {
		set unclocked_pins [lindex [split [lindex [ split [lsearch -all -inline  [lrange [split $chktim "\n"] end-35 end ]  "*lock pins without clock waveform*"]  " " ] end] "\}" ] 0]
	}



	set clock_pins  [filter_collection [all_registers -clock_pins] "is_hierarchical==false"]
	catch { set clock_case  [filter_collection $clock_pins "constant_value==1 || constant_value==0"] }
	#catch { set clock_case  [filter_collection $clock_pins "constant==1 || constant==0"] }

	set clock_undef [remove_from_collection [filter_collection $clock_pins "undefined(clocks)"] $clock_case]
	set clock_unclked $unclocked_pins

	set clock_conei [all_fanin  -to $clock_pins -flat -startpoints_only]
	set clock_ports [get_ports -quiet $clock_conei]


	set reset_pins  [get_pins -of_object $registers -filter "is_async_pin==true || is_clear_pin==true"]
	set reset_conei [all_fanin -quiet -to $reset_pins -flat -startpoints_only]
	set reset_ports [get_ports -quiet $reset_conei]

	set clkrst_ports [remove_from_collection -intersect $reset_ports $clock_ports]
	set clock_ports  [remove_from_collection  $clock_ports $clkrst_ports]
	set reset_ports  [remove_from_collection  $reset_ports $clkrst_ports]
	if { $is_ptime > 0 } {
		set input_clocks    [get_ports -quiet  * -filter "is_clock_network==true && direction==in"]
		set output_clocks   [get_ports -quiet  * -filter "is_clock_network==true && direction==out"]
	} else {
		set input_clocks    [get_ports -quiet  * -filter "is_clock_used_as_clock==true && direction==in"]
		set output_clocks   [get_ports -quiet  * -filter "is_clock_used_as_clock==true  && direction==out"]
	}

	autodesign_puts_tee $out_p "\n\n"
        autodesign_puts_tee $out_p  "\t\t<Info> Sizeof Pins    Clock  = [sizeof_collection $clock_pins]"
        autodesign_puts_tee $out_p  "\t\t<Info> Sizeof Static  Clock  = [sizeof_collection $clock_case]"
        autodesign_puts_tee $out_p  "\t\t<Info> Sizeof Undef   Clock  = [sizeof_collection $clock_undef]"
        autodesign_puts_tee $out_p  "\t\t<Info> Sizeof UnClk   Clock  = $clock_unclked"

        autodesign_puts_tee $out_p  "\t\t<Info> Sizeof ConeI   Clock  = [sizeof_collection $clock_conei]"
        autodesign_puts_tee $out_p  "\t\t<Info> Sizeof Ports   Clock  = [sizeof_collection $clock_ports]"

	autodesign_puts_tee $out_p  "\t\t<Info> Sizeof Pins    Reset  = [sizeof_collection $reset_pins]"
        autodesign_puts_tee $out_p  "\t\t<Info> Sizeof ConeI   Reset  = [sizeof_collection $reset_conei]"
        autodesign_puts_tee $out_p  "\t\t<Info> Sizeof Ports   Reset  = [sizeof_collection $reset_ports]"

        autodesign_puts_tee $out_p  "\t\t<Info> Sizeof Ports   ClkRst = [sizeof_collection $clkrst_ports]"
        autodesign_puts_tee $out_p  "\t\t<Info> Sizeof Cells   Reg    = [sizeof_collection $registers]"
	
	foreach_in_collection x $clock_ports     { set overlap [remove_from_collection -intersect $input_clocks $x]  ; lappend	data  "Clock,[get_attribute  $x direction],[get_object_name $x],Defined=[sizeof_collection $overlap]" }
	foreach_in_collection x $output_clocks   { set overlap [remove_from_collection -intersect $output_clocks $x] ; lappend	data  "Clock,[get_attribute  $x direction],[get_object_name $x],Defined=[sizeof_collection $overlap]" }
	foreach_in_collection x $reset_ports     { set overlap [remove_from_collection -intersect $input_clocks $x]  ; lappend	data  "Reset,[get_attribute  $x direction],[get_object_name $x],Defined=[sizeof_collection $overlap]" }
	foreach_in_collection x $clkrst_ports    { set overlap [remove_from_collection -intersect $input_clocks $x]  ; lappend	data  "ClkRst,[get_attribute $x direction],[get_object_name $x],Defined=[sizeof_collection $overlap]" }
	autodesign_puts_tee $out_p   "\n\n"
	autodesign_puts_tee $out_p   [format  "\t\t%10s  %5s  %20s   %40s  %-70s  %${pading}s  %-20s  %-50s" "<Class>" "<Dir>" "<Attr>"  "<ConeSize>" "<Node>" "<Design>" "<Freq>" "<ClockSpec>"]   
	autodesign_puts_tee $out_p   [format  "\t\t%10s  %5s  %20s   %40s  %-70s  %${pading}s  %-20s  %-50s" "---------" "-----" "---------"  "---------------------" "-----------------------------------------------"  [string repeat "-" $pading]  "---------------------" "--------------------------------------------------"]   
	autodesign_puts_tee $out_p   "\n"     
	set old_cat  "<Class>"
	set old_dir  "<Dir>"
	foreach el $data {
	   set els [split $el ","]
    	   if { $old_cat != [lindex $els 0] ||  $old_dir != [lindex $els 1] } { 
 	      autodesign_puts_tee $out_p   [format  "\t\t%10s  %5s  %20s   %40s  %-70s  %${pading}s %-20s %-50s" "---------" "-----" "---------"  "---------------------" "-----------------------------------------------"  [string repeat "-" $pading]  "---------------------" "--------------------------------------------------"]   
	   }
	   set filter_col [all_fanout  -from [lindex $els 2] -flat -end -only_cells]
	   set filter_base [remove_from_collection $filter_base $filter_col]
	   set csize [sizeof_collection $filter_col]
	   set lsize [sizeof_collection $filter_base]
           set clkx  [get_object_name [get_attribute -quiet [get_ports [lindex $els 2] ] clocks]]
           set tfreq "NA_MHz"
	   if { $clkx != "" } {
		set fast_clocks   [lindex [autodesign_sort_clocks [get_attribute -quiet [get_ports [lindex $els 2] ] clocks]] 0]
		set clkx          [lindex  [split $fast_clocks ","] 1]
		set tfreq         [format "%0.3f_MHz" [expr $ssi_sta_tool_unit_dly / [lindex  [split $fast_clocks ","] 0] ]]
		set clkx          [get_object_name [get_attribute -quiet [get_ports [lindex $els 2] ] clocks]]

	   }		
	   autodesign_puts_tee $out_p   [format  "\t\t%10s  %5s  %20s  %40s  %-70s  %${pading}s  %-20s  %-50s" [lindex $els 0] [lindex $els 1] [lindex $els 3] "$csize (UnMap=$lsize)" [lindex $els 2] $my_design $tfreq $clkx ]      
           set old_cat [lindex $els 0]    
           set old_dir [lindex $els 1]    

	   		
	}
	autodesign_puts_tee $out_p   "\n\n"
	autodesign_puts_tee $out_p   [format  "\t\t%50s  %20s %${pading}s  %-20s  %s" "<Clock>" "<Cones>" "<Design>" "<Freq>" "<Defintion>"]   
	autodesign_puts_tee $out_p   [format  "\t\t%50s  %20s %${pading}s  %-20s  %s" "----------------------------------" "----------------" [string repeat "-" $pading] "---------------------" "-----------------------------------------------"]   
        foreach_in_collection clk [all_clocks] {
		set tfreq         "NA_MHz"
		catch { set tfreq         [format "%0.3f_MHz" [expr $ssi_sta_tool_unit_dly / [get_attribute -quiet  $clk period] ]]}
		autodesign_puts_tee $out_p   [format  "\t\t%50s  %20s  %${pading}s  %-20s  %s" [get_object_name $clk] [sizeof_collection [all_registers -clock [get_object_name $clk]]] $my_design $tfreq [get_object_name [get_attribute [get_clocks $clk] sources]]]
	}
	autodesign_puts_tee $out_p   "\n\n"	
	
	close $out_p
	puts "\033\[1;34m<OPEN> File :   \033\[1;31m[file normalize $xfile]\033\[0m"
	catch { unsuppress_message SEL-003}
	catch { unsuppress_message ATTR-3}

	return [list [file normalize $xfile] $data ]
}
##------------------------------------------------------------------
## ProcNameEnd    : autodesign_get_clock_ports
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : autodesign_get_clock_relationship
## ProcArguments  : autodesign_get_clock_relationship clks
## ProcDependency :  
## ProcInfluence  : 4
## ProcRenamed    : 0
##------------------------------------------------------------------
proc autodesign_get_clock_relationship clks {
  global synopsys_program_name
  if { [info exist synopsys_program_name] } {
  	set relation [get_clock_relationship $clks]
  } else {
        set relation "{disaster}"
  }
  if  {$relation == "{}" || $relation == "" } { set relation "{synchronous}"}
  return $relation
}
