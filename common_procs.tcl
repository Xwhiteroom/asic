## ProcNameStart  : sta_qual_report_attr_cellpin
## ProcArguments  : sta_qual_report_attr_cellpin path pin_col
## ProcDependency : sh 
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_report_attr_cellpin {path pin_col} {
    global MODE CORNER my_flow_control
    set my_design [get_object_name [current_design ]]
    puts "** STA_CFG_INFO: Start Dumping in $path [date]"
    set size_pins [sizeof_collection [get_pins $pin_col -quiet ]]
    if { $size_pins == 0 && $pin_col == "seq"} {
        set registers [get_cells -hier * -filter "is_hierarchical==false and is_sequential==true" ]
        # CK pin reflects worst output sclack
        #set attrpins  [get_pins -quiet -of_objects $registers]
        set attrpins  [get_pins -quiet -of_objects $registers -filter "direction==in"]
        set attrpins  [add_to_collection $attrpins [all_inputs]]
        set attrpins  [add_to_collection $attrpins [all_outputs]]
        puts "** STA_CFG_INFO: Process Collection [sizeof_collection $attrpins] $pin_col"
    } elseif { $size_pins > 0 } {
        set attrpins  [get_pins -quiet -of_objects $pin_col]
        puts "** STA_CFG_INFO: Process Collection [sizeof_collection $attrpins] Custom:Col of $size_pins"
    }
    report_global_slack   -nosplit  $attrpins > $path
    puts "** STA_CFG_INFO: Start Dumping in $path JSON [date]"
    catch { sh python3  $my_flow_control/pd_shell/get_cellpin.py $path }
    puts "** STA_CFG_INFO: Done  Dumping in $path [date]"
}
