## ProcArguments  : sta_qual_match_list lookup target_string
## ProcDependency :  
## ProcInfluence  : 2
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_match_list {lookup target_string} {
	foreach x $lookup {
		if { [regexp $x $target_string] } {
			return 1
		}	
	}
	return 0	
}
