##------------------------------------------------------------------
## ProcNameStart  : x_arrival_window
## ProcArguments  : x_arrival_window start_clk_src launch_edge launch_attr
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc x_arrival_window {start_clk_src launch_edge launch_attr} {
            set window    [get_attr [get_pins -quiet $start_clk_src] arrival_window]
            if { $window == "" } {
                set window    [get_attr [get_ports -quiet $start_clk_src] arrival_window]                
            }
            regsub -all {\{} $window {}  window
            regsub -all {\}} $window {}  window
            set clk_src ""
            if { [sizeof_collection [get_pins -quiet $start_clk_src]] > 0 } {
                set clk_src [get_pins  -quiet $start_clk_src] 
            } else {
                set clk_src [get_ports -quiet $start_clk_src] 
            }
            set start_clk_arr [get_attr -quiet $clk_src ${launch_attr}_arrival]
            set start_clk     [get_object_name [get_attr -quiet $clk_src clocks]]
            set start_clk_mst [get_object_name [get_attr -quiet [get_clocks $start_clk] master_pin]]
            set arr_mode      "A"
            if { $window != ""} { 
                    set window_arr [split $window " "]
                    set i 0
                    while {$i < [llength $window_arr] } {
                        set data [lrange $window_arr $i [expr $i + 7]]
                        set i [expr $i+8]
                        if { [lindex $data 0] == $start_clk_mst  &  [lindex $data 1] == $launch_edge} {
                            if {      $launch_edge == "pos_edge" & $launch_attr == "min"  } {
                                set start_clk_arr [lindex $data 3]
                            } elseif {$launch_edge == "neg_edge" & $launch_attr == "min" } {
                                set start_clk_arr [lindex $data 4]
                            } elseif {$launch_edge == "pos_edge" & $launch_attr == "max" } {
                                set start_clk_arr [lindex $data 6]
                            } elseif {$launch_edge == "neg_edge" & $launch_attr == "max" } {
                                set start_clk_arr [lindex $data 7]
                            }
                            set arr_mode      "S"                            
                        } elseif { [lindex $data 0] == $start_clk  &  [lindex $data 1] == $launch_edge} {
                            if {      $launch_edge == "pos_edge" & $launch_attr == "min"  } {
                                set start_clk_arr [lindex $data 3]
                            } elseif {$launch_edge == "neg_edge" & $launch_attr == "min" } {
                                set start_clk_arr [lindex $data 4]
                            } elseif {$launch_edge == "pos_edge" & $launch_attr == "max" } {
                                set start_clk_arr [lindex $data 6]
                            } elseif {$launch_edge == "neg_edge" & $launch_attr == "max" } {
                                set start_clk_arr [lindex $data 7]
                            }
                            set arr_mode      "P"
                        }
                    }
            }
            return "[list $start_clk_arr $launch_edge $launch_attr $arr_mode $start_clk $start_clk_mst]"
}
##------------------------------------------------------------------
## ProcNameEnd    : x_arrival_window
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : xreport_global_slack
## ProcArguments  : xreport_global_slack minmax pba add_freq pins
## ProcDependency : pt_get_path_period_window 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc xreport_global_slack {minmax pba add_freq pins} {
    global ssi_sta_tool_unit_dly
	set pins [get_pins -quiet $pins]
	array unset datax
	foreach_in_collection pin $pins {
		set pin_name [get_object_name $pin]
		set linex ""
		set headx ""

		if { [regexp "max" $minmax] } {
			set path1_maxr  [get_timing_path -pba $pba -rise_through $pin -delay max]
			set path1_maxf  [get_timing_path -pba $pba -fall_through $pin -delay max]
			set slack_maxr  [get_attr -quiet $path1_maxr slack]
			set slack_maxf  [get_attr -quiet $path1_maxf slack]
			set nslack_maxr [lindex [pt_get_path_period_window $path1_maxr] 2]
			set nslack_maxf [lindex [pt_get_path_period_window $path1_maxf] 2]

			if { $slack_maxr == "" || $slack_maxr == "INFINITY" } { set slack_maxr "*"}
			if { $slack_maxf == "" || $slack_maxf == "INFINITY" } { set slack_maxf "*"}
			
			if { $add_freq == 1 } {
				set freq_r "NA" ;
				set freq_f "NA" ;
                                catch { set freq_r [expr int($ssi_sta_tool_unit_dly/($nslack_maxr - $slack_maxr))] }
                                catch { set freq_f [expr int($ssi_sta_tool_unit_dly/($nslack_maxf - $slack_maxf))] }
				set slack_maxr "$slack_maxr/${freq_r}_MHz"
				set slack_maxf "$slack_maxf/${freq_f}_MHz"   
			}


			set linex [format "$linex         %20s         %20s" $slack_maxr $slack_maxf]
			set headx [format "$headx         %20s         %20s" "Max_Rise" "Max_Fall"]
			
		}
		if { [regexp "min" $minmax] } {
			set path1_minr [get_timing_path -pba $pba -rise_through $pin -delay min]
			set path1_minf [get_timing_path -pba $pba -fall_through $pin -delay min]
			set slack_minr [get_attr -quiet $path1_minr slack]
			set slack_minf [get_attr -quiet $path1_minf slack]
			if { $slack_minr == "" || $slack_minr == "INFINITY" } { set slack_minr "*"}
			if { $slack_minf == "" || $slack_minf == "INFINITY" } { set slack_minf "*"}
			set linex [format "$linex         %20s         %20s" $slack_minr $slack_minf]
			set headx [format "$headx         %20s         %20s" "Min_Rise" "Min_Fall"]
		}

		set pin_name [get_object_name $pin]
		set linex  [format "$linex         %s" $pin_name] 
		set headx  [format "$headx         %s" "Point($pba)"] 
		set datax($pin_name) $linex
		set datax(_0000_) $headx

	}
	foreach x [lsort [array name datax]] {
		puts "$datax($x)"
	}
}
##------------------------------------------------------------------
## ProcNameEnd    : xreport_global_slack
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : xreport_timing
## ProcArguments  : xreport_timing args
## ProcDependency : pt_timing_points_split 
## ProcInfluence  : 4
## ProcRenamed    : 0
##------------------------------------------------------------------
proc xreport_timing args {
    global CORNER MODE ssi_sta_tool_unit_dly
    set is_path_collection "None"
    catch { set is_path_collection  [lindex [get_attr -quiet $args path_type] 0] }
    if { $is_path_collection == "min" ||  $is_path_collection == "max" } {    
    	set path_collection $args
        echo "**WARN: Arguments are Path Collection !"
    } else {
	set rpt_string      "$args"
	regsub -all {\{|\}} $rpt_string "" rpt_string
	set rpt_string      "set path_collection \[get_timing_path $rpt_string\]"
	puts "**INFO: <CMD> $rpt_string"
	set path_collection [eval $rpt_string]
    }	
    echo "**INFO: Created Base Path Collection as : [sizeof_collection $path_collection]  <CMD>  get_timing_paths/report_timing $args"
    set view_flow "default"
    catch { set view_flow "$CORNER.$MODE"}
    foreach_in_collection path $path_collection {
            set view     [get_attr -quiet $path scenario_name]              
            if { $view == "" } {  set view     $view_flow    }
            if { $view == "" } {  set view     "default"     }

	
            set start         [get_object_name [get_attr -quiet $path startpoint]]
            set end           [get_object_name [get_attr -quiet $path endpoint]]
            set start_clk     [get_object_name [get_attr -quiet $path startpoint_clock]];
            set end_clk       [get_object_name [get_attr -quiet $path endpoint_clock]];
            set start_clk_src [get_object_name [get_attr -quiet [get_clocks $start_clk] sources]];
            set end_clk_src   [get_object_name [get_attr -quiet [get_clocks $end_clk] sources]];
            set start_clk_mst [get_object_name [get_attr -quiet [get_clocks $start_clk] master_pin]];
            set end_clk_mst   [get_object_name [get_attr -quiet [get_clocks $end_clk] master_pin]];
            set crpr_point    [get_object_name [get_attr -quiet $path crpr_common_point]]
	    
	    set crpr_point     "None"
	    set crp_obj       [get_attr -quiet $path crpr_common_point]	
	    if { [sizeof_collection $crp_obj] } {
            	set crpr_point    [get_object_name $crp_obj]

	    }
	    set crpr_L        $crpr_point
            set crp_L_obj     [get_attr -quiet [get_attr  -quiet [get_attr  -quiet $path launch_clock_paths  ]  points ] object ]
	    if { [sizeof_collection $crp_L_obj] } {
	    	catch { set crpr_L   [lindex [get_object_name $crp_L_obj] [expr [lsearch [get_object_name $crp_L_obj] $crpr_point] + 1 ]] }
	    }

	    set crpr_C        $crpr_point
            set crp_C_obj     [get_attr -quiet [get_attr  -quiet [get_attr  -quiet $path capture_clock_paths ]  points ] object ]
	    if { [sizeof_collection $crp_C_obj] } {
	    	catch { set crpr_C   [lindex [get_object_name $crp_C_obj] [expr [lsearch [get_object_name $crp_C_obj] $crpr_point] + 1 ]] }
	    }
	    
            # CRPR Segregation
	    if { $crpr_point == "" || $crpr_point == "None" } {	
	        set crpr_point  ""
	    } else {
            	set crpr_pointx $crpr_point
	    }
            ## RC vs Device Data  
            set return_point_data [pt_timing_points_split  [get_attr -quiet $path points] "" "" 0] 
	    set arr_rc        [lindex $return_point_data 0]
	    set arr_cell      [lindex $return_point_data 1]
	    set stg_level     [lindex $return_point_data 2]
	    set totalXY       [lindex $return_point_data 3]
	    set totalarr      [lindex $return_point_data 4]
	    set totalsi       [lindex $return_point_data 5]
	    set datatrace     [lindex $return_point_data 6]
	    set nodetrace     [lindex $return_point_data 7]

            set return_point_data_L [pt_timing_points_split  [get_attr -quiet [get_attr  -quiet $path launch_clock_paths  ] points] "" "" 0] 
	    set arr_rc_L      [lindex $return_point_data_L 0]
	    set arr_cell_L    [lindex $return_point_data_L 1]
	    set stg_level_L   [lindex $return_point_data_L 2]
	    set totalXY_L     [lindex $return_point_data_L 3]
	    set totalarr_L    [lindex $return_point_data_L 4]
	    set totalsi_L     [lindex $return_point_data_L 5]
	    set datatrace_L   [lindex $return_point_data_L 6]
	    set nodetrace_L   [lindex $return_point_data_L 7]

            set return_point_data_C [pt_timing_points_split  [get_attr -quiet [get_attr  -quiet $path capture_clock_paths  ] points] "" "" 0] 
	    set arr_rc_C      [lindex $return_point_data_C 0]
	    set arr_cell_C    [lindex $return_point_data_C 1]
	    set stg_level_C   [lindex $return_point_data_C 2]
	    set totalXY_C     [lindex $return_point_data_C 3]
	    set totalarr_C    [lindex $return_point_data_C 4]
	    set totalsi_C     [lindex $return_point_data_C 5]
	    set datatrace_C   [lindex $return_point_data_C 6]
	    set nodetrace_C   [lindex $return_point_data_C 7]

            set return_point_data_CRL [pt_timing_points_split  [get_attr -quiet [get_attr  -quiet $path launch_clock_paths  ] points] "" $crpr_pointx 0] 
	    set arr_rc_CRL      [lindex $return_point_data_CRL 0]
	    set arr_cell_CRL    [lindex $return_point_data_CRL 1]
	    set stg_level_CRL   [lindex $return_point_data_CRL 2]
	    set totalXY_CRL     [lindex $return_point_data_CRL 3]
	    set totalarr_CRL    [lindex $return_point_data_CRL 4]
	    set totalsi_CRL     [lindex $return_point_data_CRL 5]
	    set datatrace_CRL   [lindex $return_point_data_CRL 6]
	    set nodetrace_CRL   [lindex $return_point_data_CRL 7]

            set return_point_data_CRC [pt_timing_points_split  [get_attr -quiet [get_attr  -quiet $path capture_clock_paths  ] points] "" $crpr_pointx 0] 
	    set arr_rc_CRC      [lindex $return_point_data_CRC 0]
	    set arr_cell_CRC    [lindex $return_point_data_CRC 1]
	    set stg_level_CRC   [lindex $return_point_data_CRC 2]
	    set totalXY_CRC     [lindex $return_point_data_CRC 3]
	    set totalarr_CRC    [lindex $return_point_data_CRC 4]
	    set totalsi_CRC     [lindex $return_point_data_CRC 5]
	    set datatrace_CRC   [lindex $return_point_data_CRC 6]
	    set nodetrace_CRC   [lindex $return_point_data_CRC 7]

            set return_point_data_LCR [pt_timing_points_split  [get_attr -quiet [get_attr  -quiet $path launch_clock_paths  ] points] $crpr_pointx "" 0] 
	    set arr_rc_LCR      [lindex $return_point_data_LCR 0]
	    set arr_cell_LCR    [lindex $return_point_data_LCR 1]
	    set stg_level_LCR   [lindex $return_point_data_LCR 2]
	    set totalXY_LCR     [lindex $return_point_data_LCR 3]
	    set totalarr_LCR    [lindex $return_point_data_LCR 4]
	    set totalsi_LCR     [lindex $return_point_data_LCR 5]
	    set datatrace_LCR   [lindex $return_point_data_LCR 6]
	    set nodetrace_LCR   [lindex $return_point_data_LCR 7]

            set return_point_data_CCR [pt_timing_points_split  [get_attr -quiet [get_attr  -quiet $path capture_clock_paths  ] points] $crpr_pointx "" 0] 
	    set arr_rc_CCR      [lindex $return_point_data_CCR 0]
	    set arr_cell_CCR    [lindex $return_point_data_CCR 1]
	    set stg_level_CCR   [lindex $return_point_data_CCR 2]
	    set totalXY_CCR     [lindex $return_point_data_CCR 3]
	    set totalarr_CCR    [lindex $return_point_data_CCR 4]
	    set totalsi_CCR     [lindex $return_point_data_CCR 5]
	    set datatrace_CCR   [lindex $return_point_data_CCR 6]
	    set nodetrace_CCR   [lindex $return_point_data_CCR 7]


            set path_type     [get_attr -quiet $path path_type]
            set class_factor   "1" 
            set use_factor     "1" 
            set launch         "late" 
            set capture        "early" 
            set launch_attr    "max" 
            set capture_attr   "min"
            if { $start_clk_mst == "" } { set start_clk_mst $start_clk_src}
            if { $end_clk_mst   == "" } { set end_clk_mst   $end_clk_src  } 

            if { $path_type == "max" } { 
                set class_factor   "-1"      ; set use_factor     "1";
                set launch         "late"    ; set capture        "early";
                set launch_attr    "max"     ;  set capture_attr  "min"
            } else {
                set class_factor   "1"       ; set use_factor     "0";
                set launch         "early"   ; set capture        "late";
                set launch_attr    "min"     ;  set capture_attr  "max"
            }


            # Slack
            set slk           [get_attr -quiet $path slack]
            set norm_slk      [get_attr -quiet $path normalized_slack]
            set slk_type      [get_attr -quiet $path path_type]
            set norm_dly      [get_attr -quiet $path normalized_delay]
            catch { set norm_dly      [format "%0.4f"[expr $slk / ($norm_slk + 0.0000000001)]}
            catch { if { $norm_dly == "" } { set norm_dly [get_attr -quiet [get_attr -quiet $path endpoint_clock] period] }}
            if { $norm_dly == ""    } { set norm_dly 1.000 ; set norm_slk $slk}
            if { $slk_type == "max" } {
            	set freq          [format "%0.0fMhz/%0.0fMhz"   [expr $ssi_sta_tool_unit_dly/($slk/$norm_slk - $slk)] [expr $ssi_sta_tool_unit_dly/($norm_dly)]  ] 
                #puts "EQ=1000.0/($slk/$norm_slk - $slk),D=$norm_dly,NS=$norm_slk,S=$slk"
	    } else {
		#set epsetup       [get_attr -quiet [get_attr -quiet $path endpoint] max_slack]
            	set freq          [format "%0.0fMhz/%0.0fMhz"   [expr $ssi_sta_tool_unit_dly/($norm_dly - $slk + 0.000)] [expr $ssi_sta_tool_unit_dly/($norm_dly)]] 
                #puts "EQ=1000.0/($norm_dly + $slk - $epsetup + 0.000),D=$norm_dly,NS=$norm_slk,S=$slk"
	    }      
            # Skew
            set crpr          [get_attr -quiet $path common_path_pessimism] 
            set start_lat     [get_attr -quiet $path startpoint_clock_latency]
            set end_lat       [get_attr -quiet $path endpoint_clock_latency]


            set start_edge    [get_attr -quiet $path startpoint_clock_open_edge_type]
            set end_edge      [get_attr -quiet $path endpoint_clock_open_edge_type]
            set launch_edge    "pos_edge" 
            set capture_edge   "pos_edge"
            if { $start_edge == "rise" } { 
                set launch_edge    "pos_edge"
            } else {
                set launch_edge    "neg_edge"
            }
            if { $end_edge == "rise" } { 
                set capture_edge    "pos_edge"
            } else {
                set capture_edge    "neg_edge"
            }

            #Default Value
            set start_clk_arr [get_attr -quiet [get_clocks $start_clk] clock_source_latency_${launch}_${start_edge}_${launch_attr}]
            set end_clk_arr   [get_attr -quiet [get_clocks $end_clk  ] clock_source_latency_${capture}_${end_edge}_${capture_attr}]
 
            set window    [get_attr [get_pins -quiet $start_clk_src] arrival_window]
            if { $window == "" } {
                set window    [get_attr [get_ports -quiet $start_clk_src] arrival_window]                
            }
            regsub -all {\{} $window {}  window
            regsub -all {\}} $window {}  window
            if { $window != ""} {
                    set window_arr [split $window " "]
                    set i 0
                    while {$i < [llength $window_arr] } {
                        set data [lrange $window_arr $i [expr $i + 7]]
                        set i [expr $i+8]
                        if { [lindex $data 0] == $start_clk_mst &  [lindex $data 1] == $launch_edge} {
                            if {      $launch_edge == "pos_edge" & $launch_attr == "min"  } {
                                set start_clk_arr [lindex $data 3]
                            } elseif {$launch_edge == "neg_edge" & $launch_attr == "min" } {
                                set start_clk_arr [lindex $data 4]
                            } elseif {$launch_edge == "pos_edge" & $launch_attr == "max" } {
                                set start_clk_arr [lindex $data 6]
                            } elseif {$launch_edge == "neg_edge" & $launch_attr == "max" } {
                                set start_clk_arr [lindex $data 7]
                            }
                        }
                    }
            }

        
            set window    [get_attr [get_pins -quiet $end_clk_src] arrival_window]
            if { $window == "" } {
                set window    [get_attr [get_ports -quiet $end_clk_src] arrival_window]                
            }
            regsub -all {\{} $window {}  window
            regsub -all {\}} $window {}  window
            if { $window != ""} {
	            set window_arr [split $window " "]
	            set i 0
	            while {$i < [llength $window_arr] } {
	                set data [lrange $window_arr $i [expr $i + 7]]
	                set i [expr $i+8]
	                if { [lindex $data 0] == $end_clk_mst &  [lindex $data 1] == $capture_edge} {
	                    if {      $capture_edge == "pos_edge" & $capture_attr == "min"  } {
	                       set end_clk_arr [lindex $data 3]
	                    } elseif {$capture_edge == "neg_edge" & $capture_attr == "min" } {
	                       set end_clk_arr [lindex $data 4]
	                    } elseif {$capture_edge == "pos_edge" & $capture_attr == "max" } {
	                       set end_clk_arr [lindex $data 6]
	                    } elseif {$capture_edge == "neg_edge" & $capture_attr == "max" } {
	                       set end_clk_arr [lindex $data 7]
	                    }
	                }
	            }
            }	

            set skew          [expr 0 + $end_lat     - $start_lat + $crpr + 0]
            set skew_S1       [expr 0 + $end_clk_arr - $start_clk_arr + 0]
            set skew_S2       [expr 0 + $end_lat     - $start_lat - $skew_S1 + 0 ]




            # Data 
            set arr_time      [get_attr -quiet $path arrival]
            set data_dly      [expr $arr_time -  $start_lat]
            
            # Required
            set req_time      [get_attr -quiet $path required]            
            set lib_time1     [get_attr -quiet $path endpoint_hold_time_value];
            set lib_time2     [get_attr -quiet $path endpoint_setup_time_value];
            set lib_time3     [get_attr -quiet $path endpoint_removal_time_value];
            set lib_time4     [get_attr -quiet $path endpoint_recovery_time_value]
            set lib_time      [expr $class_factor*(0 + $lib_time1 + $lib_time2 + $lib_time3 + $lib_time4 + 0)]
            set uncert        [get_attr -quiet $path clock_uncertainty]
            set margin        [expr 0 + $req_time - $end_lat - $crpr - $lib_time + 0 ]
            
            # Phase
            set start_clk_ph  [get_attr -quiet $path startpoint_clock_open_edge_value];
            set end_clk_ph    [get_attr -quiet $path endpoint_clock_open_edge_value];
            set max_delayx    "Synchronous_RT"
	    if { $start_clk_ph == "" || $end_clk_ph == "" } {
	       set max_delayx     [get_attr -quiet $path exception_delay] 
               set start_clk_ph   0.000
               set end_clk_ph     $max_delayx
	    }

            set phase_delta   0.000 
	    catch {set phase_delta   [expr $end_clk_ph - $start_clk_ph]}
            
	    # Back Calculation
            set AT_x          [expr $start_clk_ph + $start_lat + $data_dly ]
            set RT_x          [expr $end_clk_ph   + $end_lat   + $crpr  + $margin + $lib_time ]
            set Bslk          [expr $class_factor*($AT_x - $RT_x)]
            set adjustslk     [expr $slk - $Bslk]
            
	    # Xtlk adjust
	    set totalsi_clk     [expr abs($totalsi_L) + abs($totalsi_C)]
	    # Stage adjust
	    set data_stages     [expr ($stg_level + 1) / 2]
	    set clk_stages_L    [expr ($stg_level_L - 1) / 2]
	    set clk_stages_C    [expr ($stg_level_C - 1) / 2]
	    set clk_stages_LCR  [expr ($stg_level_LCR - 2) / 2]
	    set clk_stages_CCR  [expr ($stg_level_CCR - 2) / 2]
	    set clk_stages_CRL  [expr ($stg_level_CRL + 1) / 2]
	    set clk_stages_CRC  [expr ($stg_level_CRC + 1) / 2]

	    # Uncommon Dly Adjust
	    set clk_common      [expr ($totalarr_CRL + $totalarr_CRC)/2]
	    set clk_uncommon_L  [expr $totalarr_LCR - $totalarr_CRL ]
	    set clk_uncommon_C  [expr $totalarr_CCR - $totalarr_CRC ]
	    set clk_stg_common      $clk_stages_CRC
	    set clk_stg_uncommon_L  $clk_stages_LCR
	    set clk_stg_uncommon_C  $clk_stages_CCR
	    set imbalance           [expr $data_stages + $clk_stg_uncommon_L - $clk_stg_uncommon_C]

            # Verbose  
            #report_timing -nets -input_pins -path_type full_clock_expanded -nos -voltage -physical -cap -cross -tran $path 
	    global timing_report_fixed_width_columns_on_left
            set org_format [get_app_var timing_report_fixed_width_columns_on_left]
            set_app_var timing_report_fixed_width_columns_on_left true
            if { $slk_type == "max" } {
            	report_timing -delay max -nets -input_pins -path_type full_clock_expanded -nos -voltage -physical -cap -cross -tran $path 
	    } else {
            	report_timing -delay min -nets -input_pins -path_type full_clock_expanded -nos -voltage -physical -cap -cross -tran $path 
	    }
            set_app_var timing_report_fixed_width_columns_on_left $org_format
	    
	    set crpr_comment ""
            if { $crpr_L == $crpr_point || $crpr_C == $crpr_point } { set crpr_comment "(Add -path_type full_clock in args!)"}
            # Key Points
            echo "#--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------"
            echo "# Summary Primetime" 
            echo "#--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------"          
            echo "View       :  $view"
            echo "Class      :  $path_type"
            echo "Start      :  $start @ $start_clk"
            echo "End        :  $end @ $end_clk"
            echo "StartCK_Arr:  $start_clk_src @ $start_clk_mst @ $start_clk_arr using clock_source_latency_${launch}_${start_edge}_${launch_attr}"
            echo "EndCK_Arr  :  $end_clk_src @ $end_clk_mst @ $end_clk_arr using clock_source_latency_${capture}_${end_edge}_${capture_attr}"
            echo "Common     :  $crpr_point"
            echo "DivgLau    :  $crpr_L $crpr_comment"
            echo "DivgCap    :  $crpr_C $crpr_comment"
            echo "DivgImbal  :  $imbalance ($data_stages + $clk_stg_uncommon_L - $clk_stg_uncommon_C)"
            echo "Slack      :  $slk @ $norm_slk/$norm_dly Freq=$freq"
            echo "Base       :  AT=$arr_time |  RT=$req_time | MaxDelay=$max_delayx" 
            # Timing Equation
            #puts "$start_clk_ph,$start_lat,$data_dly,$slk|$end_clk_ph,$end_lat,$crpr,$margin,$lib_time"
            echo "#--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------"           
            echo [format "LaunchEq:  PH= %+0.3f > LP= %+0.3f > DP= %+0.3f > SL= %+0.3f"              $start_clk_ph  $start_lat $data_dly $slk ]
            echo [format "CapturEq:  PH= %+0.3f > CP= %+0.3f > CR= %+0.3f > MR= %+0.3f > LB= %+0.3f" $end_clk_ph    $end_lat   $crpr     $margin $lib_time]
            echo [format "BackCalc:  AT= %+0.3f   RT= %+0.3f   SK= %+0.3f   UN= %+0.3f > AD= %+0.3f (SL~ %+0.3f + %+0.3f)" $AT_x $RT_x $skew $uncert $adjustslk $Bslk $adjustslk]
            echo [format "SplitDly:  DP= %+0.3f + LB= %+0.3f - SK= %+0.3f  (S1= %+0.3f   S2= %+0.3f  CR= %+0.3f CLKSI= %+0.3f)  (Effective Margin/Phase Adjust Not Accounted)"     $data_dly $lib_time $skew $skew_S1 $skew_S2 $crpr $totalsi_clk]
            echo "#--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------"
            echo [format "DataSplit: DP= %+0.3f   RC= %+0.3f   DV= %+0.3f   SI= %+0.3f  XY= %+5.1f  STG= %+0.1f (Final= %+0.3f)" $data_dly $arr_rc $arr_cell $totalsi $totalXY $data_stages $totalarr ] 
            echo "#--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------"
    catch { echo [format "LClkSplit: LP= %+0.3f   RC= %+0.3f   DV= %+0.3f   SI= %+0.3f  XY= %+5.1f  STG= %+0.1f (Final= %+0.3f)" $start_lat $arr_rc_L $arr_cell_L $totalsi_L $totalXY_L $clk_stages_L $totalarr_L] }
    catch { echo [format "LClkCRPR-: LP= %+0.3f   RC= %+0.3f   DV= %+0.3f   SI= %+0.3f  XY= %+5.1f  STG= %+0.1f (Final= %+0.3f)" $totalarr_CRL $arr_rc_CRL $arr_cell_CRL $totalsi_CRL $totalXY_CRL $clk_stages_CRL  $totalarr_CRL] }
    catch { echo [format "LClkCRPR+: LP= %+0.3f   RC= %+0.3f   DV= %+0.3f   SI= %+0.3f  XY= %+5.1f  STG= %+0.1f (Final= %+0.3f)" $clk_uncommon_L $arr_rc_LCR $arr_cell_LCR $totalsi_LCR $totalXY_LCR $clk_stages_LCR $totalarr_LCR] }
            echo "#--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------"
    catch { echo [format "CClkSplit: CP= %+0.3f   RC= %+0.3f   DV= %+0.3f   SI= %+0.3f  XY= %+5.1f  STG= %+0.1f (Final= %+0.3f)" $end_lat $arr_rc_C $arr_cell_C $totalsi_C $totalXY_C $clk_stages_C $totalarr_C] }
    catch { echo [format "CClkCRPR-: CP= %+0.3f   RC= %+0.3f   DV= %+0.3f   SI= %+0.3f  XY= %+5.1f  STG= %+0.1f (Final= %+0.3f)" $totalarr_CRC $arr_rc_CRC $arr_cell_CRC $totalsi_CRC $totalXY_CRC  $clk_stages_CRC $totalarr_CRC] }
    catch { echo [format "CClkCRPR+: CP= %+0.3f   RC= %+0.3f   DV= %+0.3f   SI= %+0.3f  XY= %+5.1f  STG= %+0.1f (Final= %+0.3f)" $clk_uncommon_C $arr_rc_CCR $arr_cell_CCR $totalsi_CCR $totalXY_CCR  $clk_stages_CCR $totalarr_CCR] }
            echo "#--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------"
    catch { echo "#Slack,#Freq,#Period_Window,#Margin,#Data,#Data(RC),#Data(Si),#Data(Cell),#Data(LibReqd),#Data(Stages),#Data(XY),#Clock(Skew),#Clock(Si),#ClockLat(Start),#ClockLat(End),#Clock(CRPR),#ClockStages(Common),#ClockStages(Launch),#ClockStages(Capture),#ClockXY(Common),#ClockXY(Launch),#ClockXY(Capture),#ImbalanceStages,#Start,#End,#ClockBranch,#ClockLaunch,#ClockCapture,#PathTrace" }
    catch { echo "$slk,$freq,$phase_delta,$margin,$data_dly,$arr_rc,$totalsi,$arr_cell,$lib_time,$data_stages,$totalXY,$skew,$totalsi_clk,$start_lat,$end_lat,$crpr,$clk_stg_common,$clk_stg_uncommon_L,$clk_stg_uncommon_C,$totalXY_CRL,$totalXY_LCR,$totalXY_CCR,$imbalance,$start,$end,$crpr_point,$crpr_L,$crpr_L,$datatrace" }

            echo "#--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------"
    }
}
