##------------------------------------------------------------------
## ProcNameStart  : pt_report_vmin_vmax_cells
## ProcArguments  : pt_report_vmin_vmax_cells dirx cells
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc pt_report_vmin_vmax_cells {dirx cells} {
	file mkdir $dirx
	set dirx  [file normalize $dirx] 
	set xcells [get_cells -quiet $cells ]
	set xpins  [get_pins -of_object $xcells -filter "direction==out"]
	set xpins_with_vmax  [filter_collection $xpins "power_rail_voltage_max>0"]
	set xpins_with_vmin  [filter_collection $xpins "power_rail_voltage_min>0"]

	puts "     <Info> :: Cells          [sizeof_collection $xcells]"
	puts "     <Info> :: Pins           [sizeof_collection $xpins]"
	puts "     <Info> :: Pins w/ Vmax   [sizeof_collection $xpins_with_vmax]"
	puts "     <Info> :: Pins w/ Vmin   [sizeof_collection $xpins_with_vmin]"
	array unset cell_maps 
	set out1 [open $dirx/all_rail_data_verobse.csv        w+]
	set out2 [open $dirx/all_rail_data_exact_match.csv    w+]
	set out3 [open $dirx/all_rail_data_scaled_voltage.csv w+]
	set out4 [open $dirx/all_rail_data_novoltage.csv      w+]
	puts $out1 "#InstancePin,#LibCell,#VMax,#VMin,#DeltaV,#DeltaV(pct),#Rail"
	puts $out2 "#InstancePin,#LibCell,#VMax,#VMin,#DeltaV,#DeltaV(pct),#Rail"
	puts $out3 "#InstancePin,#LibCell,#VMax,#VMin,#DeltaV,#DeltaV(pct),#Rail"
	puts $out4 "#InstancePin,#LibCell,#VMax,#VMin,#DeltaV,#DeltaV(pct),#Rail"
	set counter 0
	set bucket  [expr 0.10 * [sizeof_collection $xpins]]
	set icounter 0
		
	foreach_in_collection xpin $xpins {
		incr counter
		if { $counter > $bucket } { puts "        - [date] Processed $icounter / [sizeof_collection $xpins] ($counter)" ; set icounter [ expr $icounter + $counter] ;set counter 0 ;}
		set namex [get_object_name $xpin]
		set rcell [get_attribute -quiet [get_cells -quiet -of_object $xpin] ref_name]
		set vmax  [get_attribute -quiet $xpin power_rail_voltage_max]
		set vmin  [get_attribute -quiet $xpin power_rail_voltage_min]
		set delta "NA"
		set supplyx [get_object_name [get_supply_net  [lsort -unique [get_attr -quiet [get_pg_pins  -of_objects [get_cells -quiet -of_object $xpin]] supply_connection]] -filter "voltage_max > 0 && voltage_min > 0"]]
		catch { set delta     [expr $vmax - $vmin] }
		catch { set delta_pct [format "%0.1f" [expr 100.0*($vmax - $vmin)/$vmax ]] }
		set data "$namex,$rcell,$vmax,$vmin,$delta,$delta_pct,$supplyx"
		puts $out1 $data
		if { $delta == 0 } {
			puts $out2 $data
		} elseif { $delta > 0 } {
			puts $out3 $data
		} else {
			puts $out4 $data
		}

	}
	close $out1
	close $out2
	close $out3
	close $out4
	puts "     <Info> :: Dir : $dirx/* \n"	


}
