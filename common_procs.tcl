proc ssi_print_supported_procs {{patterns ""}} {
    # Default pattern
    set search_patterns [list "ssi_*"]
    # Append user-supplied patterns
    if {$patterns ne ""} {
        set search_patterns [concat $search_patterns $patterns]
    }
    # Build proc list from all patterns
    set procs_in_scope {}
    foreach pat $search_patterns {
        lappend procs_in_scope {*}[info proc $pat]
    }
    set procs_in_scope [lsort -unique $procs_in_scope]
    foreach x $procs_in_scope {
        puts [format "                           - \033\[34m%-40s \033\[31m%-s\033\[0m" $x "[info args $x]"]
    }
    set x ssi_print_supported_procs
    puts [format "                           - \033\[34m%-40s \033\[31m%-s\033\[0m" $x "patterns"]

}

proc ssi_trace_detour {points {threshold 50}} {
    lassign $points start cell end
    lassign $start sx sy
    lassign $cell  cx cy
    lassign $end   ex ey
    set dSC [expr {abs($cx-$sx) + abs($cy-$sy)}]
    set dCE [expr {abs($ex-$cx) + abs($ey-$cy)}]
    set directDist [expr {abs($ex-$sx) + abs($ey-$sy)}]
    set viaDist    [expr {$dSC + $dCE}]
    set detour     [expr {$viaDist - $directDist}]
    set status [expr {$detour > $threshold ? "FAIL/DETOURED" : "PASS/BOUNDED"}]
    return [list $status [format "SP(%d %d),Cell(%d %d),EP(%d %d),SC=%d,CE=%d,SE=%d,SCE=%d,Detour=%d," $sx $sy $cx $cy $ex $ey $dSC  $dCE $directDist $viaDist $detour] $detour]
}



proc ssi_buffer_offset { cells xfile {slk_th 50} {dtr_th 100}} {
    set fp [open $xfile w+]
    array unset data_set
    proc ssi_get_xy { cell } {
        set bbox  [get_attr $cell bbox]
        set bboxX [format "%0.0f" [lindex [lindex  $bbox 0] 0]]
        set bboxY [format "%0.0f" [lindex [lindex  $bbox 0] 1]]
        return [list $bboxX $bboxY]
    }
    set cells [get_cells $cells]
    

    ssi_print green "" [format "SSI_INFO:: \033\[34m%-40s \033\[31m%-s\033\[0m" "Cells" "[sizeof_collection $cells]"]
    foreach_in_collection cell $cells {
        set namex [get_object_name $cell]
        set opin  [filter_collection [get_pins -of_obj $cell] "direction==out"]
        regsub -all "$namex" [get_object_name $opin] {} opin_lib
        set path  [get_timing_path -thr $opin ]
        set slk   [get_attr $path slack]
        catch { set slk   [format "%0.2f" $slk] }
        set comment ""
        if { $slk != "" && $slk > $slk_th } { 
            set status_timing "PASS/TIMING"
        } else {
            set status_timing "FAIL/TIMING"            
        }
        set comment "$comment|$status_timing"            


        set points  [filter_collection [get_attr $path points.object] "direction==out"]
        set depth   [sizeof_collection $points]
        set tcell   [lsearch [get_object_name $points] [get_object_name $opin]]
        set post    [expr $depth - $tcell - 2]
        set pre     [expr $tcell - 2]
        lassign [ssi_get_xy [get_attr $path startpoint]] SbboxX SbboxY        
        lassign [ssi_get_xy [get_cell $cell           ]] bboxX bboxY
        lassign [ssi_get_xy [get_attr $path endpoint  ]] EbboxX EbboxY 
        set status_detour [ssi_trace_detour [list [list $SbboxX $SbboxY] [list $bboxX $bboxY] [list $EbboxX $EbboxY] ] $dtr_th]
        set comment "$comment|[lindex $status_detour 0]"
        set detour [lindex $status_detour 2]
        set  extra [lindex $status_detour 1]
        set xline [format  "%-40s,SLK=%-5s,STG=%03d,PRE:%03d,POST:%03d,DETOUR:%-s,%-s,%-s" $comment $slk $depth $pre $post $detour $namex $extra ]
        if { [regexp FAIL $comment ]} {
            ssi_print  white  red $xline
        } else {
            ssi_print  white  green $xline
        }
        puts $fp $xline
        #return $path

    }
    close $fp

}


##------------------------------------------------------------------
# --- Build ASCII tree + collect level->object map (per node's subtree) ---
#
#  Usage:

#  set root_node   "u_top/CLK_ROOT"
#  set tree_data   [ssi_build_cts_tree_levels $root_node]
#  ssi_dump_tree_dict_csv $tree_data "/tmp/cts_tree.csv"

#  To merge multiple clock roots into one CSV:

#  set all_trees [dict create]
#  foreach root $clock_roots { set all_trees [dict merge $all_trees [ssi_build_cts_tree_levels $root]]}
#  ssi_dump_tree_dict_csv $all_trees "/tmp/cts_all_trees.csv"
#
#
proc ssi_build_cts_csv {csv_file roots} {
      set all_trees [dict create]

      foreach_in_collection oroot $roots {
          set root [get_object_name $oroot]
          puts "Building CTS tree for: $root"
          set all_trees [dict merge $all_trees [ssi_build_cts_tree_levels $root]]
      }

      ssi_dump_tree_dict_csv $all_trees $csv_file
      puts "CTS tree data written to: $csv_file"

      return $all_trees
}

proc ssi_build_cts_ascii_tree {node  {prefix ""} {visited {}} {level 0}} {
      set result [dict create]
      dict lappend result $level $node

      lappend visited $node
      set clk_cond "is_clock_used_as_clock==true"
      set fanouts [lsort [get_object_name [filter_collection  [all_fanout -flat -pin_level 1 -from $node] "$clk_cond" ]]]
      set fanouts [lsearch -all -inline -not -exact $fanouts $node]
      set count [llength $fanouts]

      set idx 0
      foreach child $fanouts {
          incr idx
          set is_last  [expr {$idx == $count}]
          set branch   [expr {$is_last ? "└── " : "├── "}]
          set nextpref [expr {$is_last ? "$prefix    " : "$prefix│   "}]

          if {[lsearch -exact $visited $child] >= 0} {
              puts "${prefix}${branch}${child} (loop)"
              dict lappend result [expr {$level + 1}] $child
          } else {
              puts "${prefix}${branch}${child}"
              set childResult [ssi_build_cts_ascii_tree $child $nextpref $visited [expr {$level + 1}]]
              dict for {lvl objs} $childResult {
                  foreach obj $objs {
                      dict lappend result $lvl $obj
                  }
              }
          }
      }
      return $result
}

# --- Wrap into node->level->object_list ---
proc ssi_build_cts_tree_levels {node} {
      return [dict create $node [ssi_build_cts_ascii_tree $node]]
}

# --- CSV field escaping ---
proc ssi_csv_quote {val} {
      if {[string match "*\[,\"\n\]*" $val]} {
          return "\"[string map {\" \"\"} $val]\""
      }
      return $val
}

# --- Dump node->level->object_list dict to CSV ---
proc ssi_dump_tree_dict_csv {tree_data filename} {
      set fh [open $filename w]
      puts $fh "root,level,class,object"
      array unset  cond
	  set cond(com) "is_sequential==false && lib_cell.is_buffer == false && lib_cell.is_inverter == false"
	  set cond(buf) "is_sequential==false && lib_cell.is_buffer == true"
	  set cond(inv) "is_sequential==false && lib_cell.is_inverter == true"
	  set cond(rep) "is_sequential==false && lib_cell.number_of_pins == 2"      
	  set cond(icg) "is_sequential==true && is_integrated_clock_gating_cell==true"
	  set cond(seq) "is_sequential==true && is_integrated_clock_gating_cell==false"

      dict for {root levels} $tree_data {
          foreach level [lsort -integer [dict keys $levels]] {
              foreach obj [dict get $levels $level] {
                  if { [sizeof_collection [get_ports -quiet [ssi_csv_quote $obj]]] } {
                    set xclass port_out
                  } else {
                    set xcell [get_cells -of_object [get_pins -quiet [ssi_csv_quote $obj]]] 
                    set xclass PIN                    
                    foreach cls [array names cond] {
                        if {[sizeof_collection [filter_collection $xcell $cond($cls)]]} {set xclass $cls ; break}
                    }
                  }

                  puts $fh "[ssi_csv_quote $root],${level},$xclass,[ssi_csv_quote $obj]"
              }
          }
      }
      close $fh
}


proc ssi_reconnect_hport_sinks { src_hport_list ref_hport } {
   set target_net [get_nets -quiet $ref_hport]
   if { [sizeof_collection $target_net] == 0 } { error "ERROR: ref net '$ref_hport' not found" }
   foreach src_name $src_hport_list {
       set src_net [get_nets -quiet $src_name]
       if { [sizeof_collection $src_net] == 0 } { puts "WARN: '$src_name' not found, skipping"; continue }
       # Snapshot sinks before mutating the collection
       set sinks {}
       foreach_in_collection p [get_pins -quiet -of_objects $src_net] {
           if { [get_attribute $p direction] eq "in" && [get_object_name $p] ne $src_name } {
               lappend sinks [get_object_name $p]
           }
       }
       foreach pname $sinks {
           disconnect_net $src_net    [get_pins -quiet $pname]
           connect_net    $target_net [get_pins -quiet $pname]
       }
       puts "Moved [llength $sinks] sink(s) from '$src_name' -> '$ref_hport'"
   }
}


proc lbbox {bbox_list} {
      set minx {}
      set miny {}
      set maxx {}
      set maxy {}

      foreach bbox $bbox_list {
          lassign [lindex $bbox 0] x1 y1
          lassign [lindex $bbox 1] x2 y2

          if {$minx eq "" || $x1 < $minx} { set minx $x1 }
          if {$miny eq "" || $y1 < $miny} { set miny $y1 }
          if {$maxx eq "" || $x2 > $maxx} { set maxx $x2 }
          if {$maxy eq "" || $y2 > $maxy} { set maxy $y2 }
      }

      return [list [list $minx $miny] [list $maxx $maxy]]
}


proc ybbox {bbox_list} {
    set out [xbbox  $bbox_list]
}

proc xbbox {bbox_list} {
      set minx {} ; set miny {} ; set maxx {} ; set maxy {}
      set sumx 0.0 ; set sumy 0.0
      set centers {}
      set count 0

      foreach bbox $bbox_list {
          lassign [lindex $bbox 0] x1 y1
          lassign [lindex $bbox 1] x2 y2

          if {$minx eq "" || $x1 < $minx} { set minx $x1 }
          if {$miny eq "" || $y1 < $miny} { set miny $y1 }
          if {$maxx eq "" || $x2 > $maxx} { set maxx $x2 }
          if {$maxy eq "" || $y2 > $maxy} { set maxy $y2 }

          set cx [expr {($x1 + $x2) / 2.0}]
          set cy [expr {($y1 + $y2) / 2.0}]
          lappend centers [list $cx $cy]
          set sumx [expr {$sumx + $cx}]
          set sumy [expr {$sumy + $cy}]
          incr count
      }

      set bbox_result [list [list $minx $miny] [list $maxx $maxy]]

      if {$count == 0} {
          puts "bbox: {}  count: 0  centroid: {}  max_dist: {}  min_dist: {}"
          return [list $bbox_result 0 {} {} {} {} {}]
      }

      set centroid_x [expr {$sumx / $count}]
      set centroid_y [expr {$sumy / $count}]
      set centroid [list $centroid_x $centroid_y]

      set maxdist {} ; set maxidx {}
      set mindist {} ; set minidx {}
      set idx 0
      foreach c $centers {
          incr idx
          lassign $c cx cy
          set d [expr {sqrt(pow($cx - $centroid_x, 2) + pow($cy - $centroid_y, 2))}]
          if {$maxdist eq "" || $d > $maxdist} { set maxdist $d ; set maxidx $idx }
          if {$mindist eq "" || $d < $mindist} { set mindist $d ; set minidx $idx }
      }

      set fbbox     [list [list [format "%.3f" $minx] [format "%.3f" $miny]] \
                          [list [format "%.3f" $maxx] [format "%.3f" $maxy]]]
      set fcentroid [list [format "%.3f" $centroid_x] [format "%.3f" $centroid_y]]
      set fmaxdist  [format "%.3f" $maxdist]
      set fmindist  [format "%.3f" $mindist]
      set maxcenter [lindex $centers [expr {$maxidx - 1}]]
      set mincenter [lindex $centers [expr {$minidx - 1}]]
      set fmaxcenter [list [format "%.3f" [lindex $maxcenter 0]] [format "%.3f" [lindex $maxcenter 1]]]
      set fmincenter [list [format "%.3f" [lindex $mincenter 0]] [format "%.3f" [lindex $mincenter 1]]]
      puts "bbox:     $fbbox"
      puts "count:    $count"
      puts "centroid: $fcentroid"
      puts "max_dist: $fmaxdist  (index $maxidx, center $fmaxcenter)  <-- FARTHEST"
      puts "min_dist: $fmindist  (index $minidx, center $fmincenter)  <-- CLOSEST"
      return [list $bbox_result $count $centroid $maxdist $maxidx $mindist $minidx]
}







