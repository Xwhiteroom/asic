## ProcNameStart  : sort_clocks
## ProcArguments  : sort_clocks clocks
## ProcDependency :  
## ProcInfluence  : 2
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sort_clocks clocks {
	set clocks [get_clocks $clocks]
	set listx [list]
	foreach_in_collection clk $clocks {
		if { [sizeof_collection [get_attr -quiet $clk sources]] > 0 } {
			lappend listx "[get_attr -quiet $clk period],[get_object_name $clk]"
		}
	}
	set listx [lsort -increasing $listx]
	return $listx
}
