##------------------------------------------------------------------
## ProcNameStart  : sta_qual_expand_and_map_pll_spec
## ProcArguments  : sta_qual_expand_and_map_pll_spec 
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_expand_and_map_pll_spec {} {
    global sta_qual_clock_spec XREPO_TOP XCHIP
    # Resourcing freq to avoid re-compile
    unset sta_qual_clock_spec
    uplevel #0 {source -echo -verbose $XREPO_TOP/chip/$XCHIP/scf/procs/clock_freq.tcl}
    set ref_spec "NM_FF:10.000:0.050:0.100:0.01:0.01:0.000:0.000:0.000:0.000:HDBULT06_BUF_CAQSY4_16:0.150:0.200:0.400"

    set corner_list [list "USOD_FF" "USOD_SS" "SOD_FF" "SOD_SS" "OD_FF" "OD_SS" "NM_FF" "NM_SS"  "UD_FF"   "UD_SS"   "SUD_FF" "SUD_SS" "UUD_FF" "UUD_SS"]

    foreach {key val} [array get sta_qual_clock_spec] {
        set ref_found 0
        set min_corner 13
        set max_corner 0
        set ref_nm_ff ""
        set ref_sud_ss ""
        set ref_ud_ss ""
        set ref_usod_ff ""
        foreach value $val {
            set corner [lindex [split $value ":"] 0]
            if {[lsearch -exact $corner_list $corner] <= $min_corner} {
                set min_corner [lsearch -exact $corner_list $corner]
                set min_corner_value $corner
                set ref_spec_min $value
            }
            if {[lsearch -exact $corner_list $corner] >= $max_corner} {
                set max_corner [lsearch -exact $corner_list $corner]
                set max_corner_value $corner
                set ref_spec_max $value
            }
            if {$corner == "NM_FF" } {
                set ref_nm_ff $value
            }
            if {$corner == "SUD_SS" } {
                set ref_sud_ss $value
            }
            if {$corner == "UD_SS" } {
                set ref_ud_ss $value
            }
            if {$corner == "USOD_FF" } {
                set ref_usod_ff $value
            }
        }
        #puts "Key -> $key"
        #puts "Min -> $min_corner, Max -> $max_corner"
        #puts "Min -> $min_corner_value, Max -> $max_corner_value"

        # Mapping Spec
        while { $max_corner < 13 } {
            incr max_corner
            set xcorner [lindex $corner_list $max_corner]
            regsub -all "${max_corner_value}:" $ref_spec_max  "${xcorner}:"  target_spec
            lappend sta_qual_clock_spec($key)  $target_spec
            puts    "**STA_SDC_INFO :: Mapped Reference Spec in \$sta_qual_clock_spec($key)  from  $max_corner_value to $xcorner as $target_spec"
            set sta_qual_clock_spec($key) [lsort -unique $sta_qual_clock_spec($key)]
        }

        # Mapping Spec
        while { $min_corner > 0 } {
            incr min_corner -1
            set xcorner [lindex $corner_list $min_corner]
            regsub -all "${min_corner_value}:" $ref_spec_min  "${xcorner}:"  target_spec
            lappend sta_qual_clock_spec($key)  $target_spec
            puts    "**STA_SDC_INFO :: Mapped Reference Spec in \$sta_qual_clock_spec($key)  from  $min_corner_value to $xcorner as $target_spec"
            set sta_qual_clock_spec($key) [lsort -unique $sta_qual_clock_spec($key)]
        }

        set xcorner "NM_TT"
        regsub -all "NM_FF:" ${ref_nm_ff}  "${xcorner}:"  target_spec
        lappend sta_qual_clock_spec($key)  $target_spec
        puts    "**STA_SDC_INFO :: Mapped Reference Spec in \$sta_qual_clock_spec($key)  from  NM_FF to $xcorner as $target_spec"
        set sta_qual_clock_spec($key) [lsort -unique $sta_qual_clock_spec($key)]

        if { $ref_sud_ss != "" } {
            set xcorner "SUD_FF"
            regsub -all "SUD_SS:" ${ref_sud_ss}  "${xcorner}:"  target_spec
            lappend sta_qual_clock_spec($key)  $target_spec
            puts    "**STA_SDC_INFO :: Mapped Reference Spec in \$sta_qual_clock_spec($key)  from  SUD_SS to $xcorner as $target_spec"
            set sta_qual_clock_spec($key) [lsort -unique $sta_qual_clock_spec($key)]
        }

        if { $ref_ud_ss != "" } {
            set xcorner "UD_FF"
            regsub -all "UD_SS:" ${ref_ud_ss}  "${xcorner}:"  target_spec
            lappend sta_qual_clock_spec($key)  $target_spec
            puts    "**STA_SDC_INFO :: Mapped Reference Spec in \$sta_qual_clock_spec($key)  from  UD_SS to $xcorner as $target_spec"
            set sta_qual_clock_spec($key) [lsort -unique $sta_qual_clock_spec($key)]
        }

        if { $ref_usod_ff != "" } {
            set xcorner "USOD_SS"
            regsub -all "USOD_FF:" ${ref_usod_ff}  "${xcorner}:"  target_spec
            lappend sta_qual_clock_spec($key)  $target_spec
            puts    "**STA_SDC_INFO :: Mapped Reference Spec in \$sta_qual_clock_spec($key)  from  USOD_FF to $xcorner as $target_spec"
            set sta_qual_clock_spec($key) [lsort -unique $sta_qual_clock_spec($key)]
        }

    }

}
