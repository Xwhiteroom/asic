##------------------------------------------------------------------
## ProcNameStart  : pt_clkpin_margin
## ProcArguments  : pt_clkpin_margin max_slack_less min_slack_less pins args
## ProcDependency : sh , quick_timing 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc pt_clkpin_margin {max_slack_less min_slack_less pins args} {
	set fanout [all_fanout -from $pins -flat -endpoints -only_cells]
	set dump_attr [lindex $args 0]
	puts "<INFO>  Cells Found [sizeof_collection $fanout]"
	set inpins [get_pins -of_object $fanout -filter "is_clock_pin==false"]
	set inpins [filter_collection $inpins "( max_slack < $max_slack_less && min_slack < 0.100) || (max_slack < 0.100 && min_slack < $min_slack_less)"]
	set pins_size [sizeof_collection $inpins]
	puts "<INFO>  Pins  Found $pins_size"
	set size_limit 50000
	if { $pins_size > $size_limit } {
		set pins_size $size_limit
		set dump_attr 0
		puts "<WARN>  User Collection is Verylarge Trunkacating to $pins_size. Not Attr will be dumped"	
	}
	set paths [get_timing_path -through $inpins -delay max -max_path $size_limit] 
	puts "<INFO>  Setup  [sizeof_collection $paths]"


	set pathh [get_timing_path -through $inpins -delay min -max_path $size_limit] 
	puts "<INFO>  Hold   [sizeof_collection $pathh]"

	set path [add_to_collection $paths $pathh]
	puts "<INFO>  Total Paths   [sizeof_collection $path]"
	quick_timing  none $size_limit  0.050  maxmin  0 $path > temp.info.bin.file
	if { $dump_attr == 1 } {
		puts "<INFO>  Dumping Slack Attribute for $pins_size as [file normalize [pwd]/clock_pin_slacks.rpt]"
		report_global_slack $inpins -nos -sig 2 > clock_pin_slacks.rpt
	}
        puts "<INFO>  [pwd]/temp.info.bin.file"
        sh cat [pwd]/temp.info.bin.file

	return $path

}
##------------------------------------------------------------------
## ProcNameEnd    : pt_clkpin_margin
##------------------------------------------------------------------


