## ProcNameStart  : show_arcs
## ProcArguments  : show_arcs args
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc show_arcs args {
  set arcs [eval [concat get_timing_arcs $args]]
  echo [format "%8s %8s %8s  %-100s  %15s    %-15s  "  "rise" "fall" "when" "is_cellarc" "from_pin" "to_pin"]
  echo [format "%8s %8s %8s  %-100s  %15s    %-15s  "  "----" "----" "----" "----------" "--------" "------"]
 
  foreach_in_collection arc $arcs {
    set is_cellarc [get_attribute -quiet $arc is_cellarc]
    set fpin [get_attribute -quiet  $arc from_pin]
    set tpin [get_attribute -quiet  $arc to_pin]
    set rise [get_attribute -quiet  $arc delay_max_rise]
    set fall [get_attribute -quiet  $arc delay_max_fall]
    set from_pin_name [get_attribute -quiet $fpin full_name]
    set condition [get_attribute  -quiet $arc sdf_cond]
    set to_pin_name [get_attribute -quiet  $tpin full_name]
    echo [format "%8s %8s %8s  %-100s  %15s -> %-15s  "  [format_float $rise] [format_float $fall]    $is_cellarc $condition $from_pin_name $to_pin_name ]
  }
}
##------------------------------------------------------------------
## ProcNameEnd    : show_arcs
