##------------------------------------------------------------------
## ProcNameStart  : pt_slack_compare
## ProcArguments  : pt_slack_compare uniq_by_best_worst outdir args
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc pt_slack_compare {uniq_by_best_worst outdir args} {
	if { [llength $args] < 2} {
		puts   "<ERROR> :  You Must Provide 2 or more files to enable comparision !"
		puts   "Usage   :  pt_slack_compare <outdir> <sort_by best/worst> <files>"
		return 0
	}
	file mkdir $outdir
	set outdir [file normalize $outdir]
	set outfile "$outdir/master_data.csv"
	set out1  [open $outfile w+]
	puts "\n\n"
	puts "<INFO> Run Dir : $outdir"
	
	array unset master_data_node
	array unset master_data_group
	array unset master_group
	array unset master_files
	set i 0
	set j 0

	foreach xfile $args {
		incr j
    		set idx     	[format "fileid_%03d" $j]
		set xfile_full  [file normalize $xfile]
 		catch { file delete -force  $outdir/$idx }
		file link -symbolic $outdir/$idx $xfile_full
		set master_files($idx) $xfile_full

		# Parse File
		set infile [open $xfile_full ]
		set i 0
		puts "\n"
		while { [gets $infile line] >= 0 } {
			incr i
			set data_arr [split $line    " "]
			set slack    [lindex $data_arr 0]
			set node     [lindex $data_arr 1]
			set group    [lindex $data_arr 2]
			# Gui Prompt
			if { [regexp "000000$" $i] }  { puts "               -- Processed $i nodes in $idx [date]" }
			# Slack Unique
			if { [regexp "#" $slack] } {
				continue
			} else {
				set master_data_node($node) 1
				set master_group($group) 1
				# Add Node Data
				if { ! [info exist master_data_group($node,$group)] } {
					set master_data_group($node,$group) $slack
				# Update for Worst Case Slack
				} elseif { $master_data_group($node,$group) > $slack && $uniq_by_best_worst == "worst" } {
					set master_data_group($node,$group) $slack
				# Update for Best Case Slack
				} elseif { $master_data_group($node,$group) < $slack && $uniq_by_best_worst == "best" } {
					set master_data_group($node,$group) $slack
				}
			}
		}
		close $infile
	}
	set header "#Node"
	foreach group [lsort [array names master_group]] {
		set header "$header,#$group/Slack"
		puts $out1 $header
	}
	
	set data "#Node"
	foreach node  [array names master_data_node] {
		set header "$node"
		foreach group [lsort [array names master_group]] {
			if { [info exist master_data_group($node,$group)] } {  
				set header "$header,$master_data_group($node,$group)"
			} else {
				set header "$header,"
			}
		}
		puts $out1 $header
	}

	close $out1
	puts "<INFO> Open File  : $outfile"
	puts "<INFO> Ref  Files : $outdir/fileid_*"
	foreach idx [array name master_files] {
		puts "		     -- $idx --> $master_files($idx)"
	}
	puts "\n\n"
}
##------------------------------------------------------------------
## ProcNameEnd    : pt_slack_compare
