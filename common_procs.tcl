##------------------------------------------------------------------
## ProcNameStart  : sta_qual_report_summary_trancap
## ProcArguments  : sta_qual_report_summary_trancap args
## ProcDependency : sta_qual_report_is_real_clock_network 
## ProcInfluence  : 2
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_report_summary_trancap args {
    global MODE CORNER GC_STA_HIER_MAP ssi_sta_tool_unit_dly
    # Default inputs
    array unset inputs
    set inputs(type)     "trancap"
    set inputs(view)     "default.default"
    catch { set inputs(view)     "$MODE.$CORNER" }

    # Parse Arguments
    parse_proc_arguments -args $args proc_x_args
    foreach x [array names proc_x_args] {
        regsub -all {\-} $x {} y
        set inputs($y) $proc_x_args($x)
        #puts [format "\t%20s = %-20s %20s" $y $x $proc_x_args($x)]
    }

    # Normalize Dir path
    set inputs(rep_dir) [file normalize $inputs(rep_dir)]

    # Print Arguments
    puts [format "<GC::PROC> Start %-50s  [date]"   "sta_qual_report_summary_trancap : $inputs(rep_dir)" ]
    foreach x [array names inputs] {
        puts [format "\t%20s = %-20s" $x $inputs($x)]
    }
    set delay_type [list]
    if { [regexp "tran" $inputs(type)] } { lappend delay_type "max_transition"}
    if { [regexp "cap"  $inputs(type)] } { lappend delay_type "max_capacitance"}

    # Create dir
    file mkdir $inputs(rep_dir)

    # Dump Raw Reports
    foreach delay $delay_type {
        # Extract Timing Paths
        report_constraint -all_violators -$delay -default_scenario_name $inputs(view) -nosplit -format csv -significant_digits 4   -out $inputs(rep_dir)/.$inputs(base_tag).drv.$delay.csv.rpt > $inputs(rep_dir)/$inputs(base_tag).drv.$delay.raw
        # Extract Net For Unification
        set in  [open $inputs(rep_dir)/.$inputs(base_tag).drv.$delay.csv.rpt  ]
        set out [open $inputs(rep_dir)/$inputs(base_tag).drv.$delay.csv w+]

        set clk_out [open $inputs(rep_dir)/$inputs(base_tag).drv.${delay}_clk.csv w+]
        set data_out [open $inputs(rep_dir)/$inputs(base_tag).drv.${delay}_data.csv w+]
        puts $clk_out "#start,#end,#req,#act,#slk,#end_clk,#view,#class"
        puts $data_out "#start,#end,#req,#act,#slk,#end_clk,#view,#class"

        puts $out "#start,#end,#req,#act,#slk,#end_clk,#view,#class"
        #Object,Clock Group,Required Value,Value,Slack,Category,Scenario
        while { [gets $in line] >= 0 } {
            set pin    [lindex [split $line ","] 0]
            # Hier Mapping
            set hierx "TOP"
            foreach virtual_hier [array name GC_STA_HIER_MAP] {
                if {[regexp $virtual_hier $pin] } {
                    set hierx  $GC_STA_HIER_MAP($virtual_hier)
                }
            }

            if { $pin != "Design Object"} {
                set rt     [lindex [split $line ","] 2]
                set at     [lindex [split $line ","] 3]
                set slk    [lindex [split $line ","] 4]
                set view   $inputs(view)
                set categ  [get_attr -quiet [get_pins -quiet $pin ] clocks]
                if { [sizeof_collection $categ] > 0 } {
                    # Fastest Clock Sorting -start
                    array unset listx
                    foreach_in_collection clk $categ {
                        set periodx [get_attr -quiet $clk period]
                        if { $periodx != ""} {
                           set freq [format "%04.0fMHz" [expr $ssi_sta_tool_unit_dly / $periodx]]
                        } else {
                           set freq [format "%04.0fMHz" "0.00"]
                        }
                        set listx($freq) [get_object_name $clk]
                    }
                    set freq_key [lindex [lsort -decreasing [array name listx]] 0]
                    set fastest_clk  $listx($freq_key)
                    regsub -all {\}} $fastest_clk {} fastest_clk
                    regsub -all {\{} $fastest_clk {} fastest_clk
                    # Fastest Clock Sorting -end
                    set end_clk "${hierx}_$fastest_clk"

                } else {
                    # Add Slack section -start
                    set is_timed_SU [get_attr -quiet [get_pins -quiet $pin ] max_slack]
                    set is_timed_HD [get_attr -quiet [get_pins -quiet $pin ] min_slack]
                    if { $is_timed_SU == "INFINITY" && $is_timed_HD == "INFINITY"  } {
                      set hierx "${hierx}_UNC"
                    }
                    # Add Slack section -end
                    set end_clk "no_clock.$hierx"
                }

                set pinsx [get_pins -quiet $pin]
                if { [sizeof_collection $pinsx] > 0} {
                    #set net [get_object_name [get_nets -quiet  [all_connected [get_attr -quiet [get_attr -quiet $pinsx net] leaf_drivers ] ] ] ]
		    # Multi Driven Net Fix
                    set net [get_object_name [get_nets -quiet  [all_connected [index_collection [get_attr -quiet [get_attr -quiet $pinsx net] leaf_drivers ] 0] ] ] ]
                } else {
                    set net "$pin"
                }

                # Net Length Extract
                set x1 [get_attr -quiet [get_nets -quiet $net] x_coordinate_max]
                set x2 [get_attr -quiet [get_nets -quiet $net] x_coordinate_min]
                set y1 [get_attr -quiet [get_nets -quiet $net] y_coordinate_max]
                set y2 [get_attr -quiet [get_nets -quiet $net] y_coordinate_min]
                if { $x1 == "" } { set x1 0 }
                if { $x2 == "" } { set x2 0 }
                if { $y1 == "" } { set x1 0 }
                if { $y2 == "" } { set y2 0 }
                set Nlength "000000"
                catch {set Nlength [format "%06.0f" [expr (abs($x1 - $x2  ) + abs($y1 - $y2))/1000 ] ]}
                if       { $net == ""                                       } { set net "$pin"
                } elseif { [sizeof_collection [get_ports -quiet $net]] > 0  } { set net "$net.PORT.NL.$Nlength" }

                puts $out "$net,$pin,$rt,$at,$slk,$end_clk,$view,$delay"
                set pin_obj [get_pin $pin -quiet]
                set port_obj [get_port $pin -quiet]
                set obj $pin_obj
                if { [sizeof_collection ${port_obj}] > 0 } {
                  set obj ${port_obj}
                }
                if { [sta_qual_report_is_real_clock_network $obj] } {
                  puts $clk_out "$net,$pin,$rt,$at,$slk,$end_clk,$view,${delay}_clk"
                } else {
                  puts $data_out "$net,$pin,$rt,$at,$slk,$end_clk,$view,${delay}_data"
                }
            }

        }
        close $in
        close $out
        close $clk_out
        close $data_out
    }
    puts [format "<GC::PROC> End   %-50s  [date]"   "sta_qual_report_summary_trancap : $inputs(rep_dir)" ]

}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_report_summary_trancap
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_report_summary_unclocked
## ProcArguments  : sta_qual_report_summary_unclocked args
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_report_summary_unclocked args {
    global MODE CORNER
    # Default inputs
    array unset inputs  
    set inputs(type)        "unclocked"    
    set inputs(view)        "default.default"
    catch { set inputs(view)     "$MODE.$CORNER" }

    # Parse Arguments 
    parse_proc_arguments -args $args proc_x_args
    foreach x [array names proc_x_args] {  
        regsub -all {\-} $x {} y
        set inputs($y) $proc_x_args($x)
        #puts [format "\t%20s = %-20s %20s" $y $x $proc_x_args($x)]
    }

    # Normalize Dir path
    set inputs(rep_dir) [file normalize $inputs(rep_dir)]

    # Print Arguments
    puts [format "<GC::PROC> Start %-50s  [date]"   "sta_qual_report_summary_unclocked : $inputs(rep_dir)" ]
    foreach x [array names inputs] {    
        puts [format "\t%20s = %-20s" $x $inputs($x)] 
    }
    set delay_type [list]
    if { [regexp "unclocked" $inputs(type)] } { lappend delay_type "unclocked"}
    
    # Create dir
    file mkdir $inputs(rep_dir)
    
    # Dump Raw Reports
    foreach delay $delay_type {
        # Parse unclocked
        if { $delay == "unclocked"} {
            check_timing -override_defaults no_clock -verbose >  $inputs(rep_dir)/.$inputs(base_tag).ctv.$delay.raw
            set in [open $inputs(rep_dir)/.$inputs(base_tag).ctv.$delay.raw]
            set start 0
            while { [gets $in line] >= 0 } {
                if { $start > 1 & $line != "" & $line != "0" & $line != "1" } {  
                    set found_pins($line) 1
                    regsub -all {\d+} $line {*} lin_pat
                    set found_pins_pat($lin_pat) 1
                    incr start
                }
                if { [regexp "Warning:" $line] & [regexp "pins with no clock" $line] } { 
                    set pins_base [lindex [split $line " "] 3]
                    set comment   "$line"
                    incr start
                }
                if { [regexp "\-\-\-\-\-" $line] & $start == 1  } { 
                    incr start 
                }
            }  
            close $in

            set i 0
            set out1 [open $inputs(rep_dir)/$inputs(base_tag).ctv.${delay}_full.csv w+]            
            set out2 [open $inputs(rep_dir)/$inputs(base_tag).ctv.${delay}_zip.csv w+]
            puts $out1 "#pin,#comment,#value,#value_sub,#pin_size,#end_clk,#view,#class"  
            puts $out2 "#pin,#comment,#value,#value_sub,#pin_size,#end_clk,#view,#class"  
            # Parse full pins
            foreach pin [array names found_pins] {
                incr i
                set size     1                
                set comment_def     "FATAL"
                set comment_val     "FATAL"
                set comment_val_sub "[llength $comment_val]" 

                if {[get_attr -quiet [get_pins -quiet $pin] case_value] != ""}  { 
                    set comment_def      "STATIC"
                    set comment_val     "[get_attr -quiet [get_pins -quiet $pin] case_value]" 
                    set comment_val_sub "[llength $comment_val]" 

                }
                if {[get_ports -quiet [all_fanin -to $pin -flat -trace_arcs all] ] != ""} { 
                    set comment_def "SOURCE"
                    set comment_val "[get_object_name [get_ports -quiet [all_fanin -to $pin -flat -trace_arcs all] ]]"
                    set comment_val_sub "[llength $comment_val]" 
                }
                set view     $inputs(view)                              
                if { $comment_def != "SOURCE" } {
                    set end_clk "no_clock"
                } else {
                    set end_clk $comment_val
                }
                puts $out1 "$pin,$comment_def,$comment_val,$comment_val_sub,$size,$end_clk,$view,$delay"
            }
            puts  "# Summarizing : Total $i : $comment"
            close $out1
            # Parse compressed pins
            set j 0
            foreach pin [array names found_pins_pat] {
                incr j
                set size [sizeof_collection [get_pins -quiet $pin]]
                set comment_def     "FATAL"
                set comment_val     "FATAL"
                set comment_val_sub "[llength $comment_val]" 

                if {[get_attr -quiet [get_pins -quiet $pin] case_value] != ""}  { 
                    set comment_def      "STATIC"
                    set comment_val     "[get_attr -quiet [get_pins -quiet $pin] case_value]" 
                    set comment_val_sub "[llength $comment_val]" 

                }
                if {[get_ports -quiet [all_fanin -to $pin -flat -trace_arcs all] ] != ""} { 
                    set comment_def "SOURCE"
                    set comment_val "[get_object_name [get_ports -quiet [all_fanin -to $pin -flat -trace_arcs all] ]]"
                    set comment_val_sub "[llength $comment_val]" 
                }
                set view     $inputs(view)     
                if { $comment_def != "SOURCE" } {
                    set end_clk "no_clock"
                } else {
                    set end_clk $comment_val
                }

                puts $out2 "$pin,$comment_def,$comment_val,$comment_val_sub,$size,$end_clk,$view,$delay"

            }
            puts  "# Summarizing : Total $j : $comment"
            close $out2
        }

    }
    puts [format "<GC::PROC> End   %-50s  [date]"   "sta_qual_report_summary_unclocked : $inputs(rep_dir)" ]

}
