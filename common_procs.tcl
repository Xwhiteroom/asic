## ProcArguments  : echo_pin_slack line PBA
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc echo_pin_slack {line PBA} {

    global  MODE CORNER TOP_DESIGN
    suppress_message UITE-487
    suppress_message UITE-479

    set data [split $line ","]
    set path_max [get_timing_paths -through [lindex $data 0] -pba $PBA -delay max]
    set path_min [get_timing_paths -through [lindex $data 0] -pba $PBA -delay min]
    echo "$data,$TOP_DESIGN.$MODE.$CORNER.$PBA,[get_attr -quiet $path_max slack],[get_attr -quiet $path_min slack]"
    unsuppress_message UITE-487
    unsuppress_message UITE-479

}
