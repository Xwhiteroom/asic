##------------------------------------------------------------------
## ProcNameStart  : get_feedthru
## ProcArguments  : get_feedthru inst_col pba_mode nworst max_path delay_type slack_lesser_than dir
## ProcDependency : gettimingpath_dump 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc get_feedthru {inst_col pba_mode nworst max_path delay_type slack_lesser_than dir} {
	suppress_message UITE-416
	file mkdir $dir
	foreach_in_collection inst1 $inst_col {
	   set r1 [get_attr $inst1 ref_name ]
           set rest_wo_inst1_col [remove_from_collection $inst_col $inst1] 
	   foreach_in_collection inst2 $rest_wo_inst1_col {
		set r2 [get_attr $inst2 ref_name ]
           	set rest_wo_inst12_col [remove_from_collection $rest_wo_inst1_col $inst2] 
		set pcol [get_timing_paths   -from $inst1 -through $inst2 -to $inst1 -pba_mode $pba_mode -nworst $nworst -max_path $max_path -delay_type $delay_type -slack_lesser_than $slack_lesser_than ]
		gettimingpath_dump $pcol $dir/$r1.$r2.$r1.lpb.$pba_mode.$nworst.rpt "$r1\t$r2\t$r2\t [sizeof_collection $pcol]"
	        foreach_in_collection inst3 $rest_wo_inst12_col {
			set r3 [get_attr $inst3 ref_name ]
			set pcol [get_timing_paths   -from $inst1 -through $inst2 -to $inst3 -pba_mode $pba_mode -nworst $nworst -max_path $max_path -delay_type $delay_type -slack_lesser_than $slack_lesser_than ]
			gettimingpath_dump $pcol $dir/$r1.$r2.$r3.ftr.$pba_mode.$nworst.rpt "$r1\t$r2\t$r3\t [sizeof_collection $pcol]"
		}
   	   }
        }
	unsuppress_message UITE-416
}
