##------------------------------------------------------------------
## ProcNameStart  : profile_cell_stat
## ProcArguments  : profile_cell_stat col fileout
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc profile_cell_stat {col fileout} {
    	if { [sizeof_collection [get_pins -quiet $col]] == 0 } {
		set pins [get_pins -of_object $col -filter "direction==out"]
	} else {
		set pins [get_pins $col -filter "direction==out"]
	}
        puts "<INFO> Processing [sizeof_collection $pins]"
	set data_pin [list "#Cell,#RefCell,#Area,#SlackSetup,#SlackHold,#DelayMax,#DelayMin,#Transition,#Capacitance,#Resistance"]
	foreach_in_collection pinx $pins {
		set cellx    [get_cells -quiet -of_object $pinx]
		set cellname [get_attr  -quiet $cellx full_name]
		set refname  [get_attr  -quiet $cellx ref_name]
		set cellarea [get_attr  -quiet $cellx area]
		set netx     [get_nets  -quiet [all_connected  $pinx]]
		set slackS   [get_attr  -quiet $pinx  max_slack]
		set slackH   [get_attr  -quiet $pinx  min_slack]
		set delaymax [lindex [lsort -increasing [get_attr -quiet [get_timing_arcs -to $pinx ] delay_max] ] end]
		set delaymin [lindex [lsort -increasing [get_attr -quiet [get_timing_arcs -to $pinx ] delay_min] ] 0]
		set tran     [get_attr  -quiet $pinx  actual_transition_max]
		set netC     [get_attr  -quiet $netx  total_capacitance_max]
		set netR     [get_attr  -quiet $netx  net_resistance_max]
		lappend  	data_pin  "$cellname,$refname,$cellarea,$slackS,$slackH,$delaymax,$delaymin,$tran,$netC,$netR"
	}
        puts "<INFO> Completed  [sizeof_collection $pinx]"        
        set out1 [open  $fileout "w+"]
        set out2 [open  $fileout.tcl "w+"]
        puts $out2 "set my_data_pin \[list \]"
        foreach x $data_pin {
           puts $out1 "$x"
           puts $out2 "lappend my_data_pin $x"
        }
        close $out1
        close $out2
        puts "<INFO> Open : "
        puts "              - [file normalize $fileout]"
        puts "              - [file normalize $fileout.tcl]"
        puts ""

	return [list $out1 $out2]
}
##------------------------------------------------------------------
## ProcNameEnd    : profile_cell_stat
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : profile_reset_data
## ProcArguments  : profile_reset_data outdir tag
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc profile_reset_data {outdir tag} {
    set i 0
    set j 0
    set all_preset_pins [get_pins -hier  -filter "full_name=~*/R || full_name=~*/SN"]
    set k [expr 0.05 * [sizeof_collection $all_preset_pins]]
    set x 0
    array unset data
    suppress_message UITE-416
    file mkdir $outdir
    set filex "$outdir/reset_data.$tag"
    set out [open $filex w+]
    puts $out "#Slack(R),#Slack(D),#Arrival(R),#Arrival(D),#StartLat(R),#StartLat(D),#Arrival_RC(R),#Arrival_RC(D),#Arrival_D(R),#Arrival_D(D),#Arrival_XY(R),#Arrival_XY(D),#ClockT(R),#ClockT(D),#Clock(R),#Clock(D),#Tag,#PinName"

    foreach_in_collection pin $all_preset_pins { 
        incr i
        incr x
        if { $i  > $k } { set j [expr $j + 5] ; puts "    - [date] Processed $j percent / $i  / Step=$k / total=$x"; set i 0 }
        set path1 [get_timing_paths -to $pin ]
        set path2 [get_timing_paths -to [get_pins -of_object [get_cells -of_object $pin] -filter "lib_pin_name=~D*"] ]
        set pin_name [get_object_name $pin]
        set slk_r    [get_attribute $path1 slack]
        set slk_d    [get_attribute $path2 slack]
        set arr_r    [get_attribute $path1 arrival]
        set arr_d    [get_attribute $path2 arrival]
        set lat_r    [get_attribute $path1 startpoint_clock_latency]
        set lat_d    [get_attribute $path2 startpoint_clock_latency]
        set clk_r    [get_object_name [get_attribute $path1 endpoint_clock]]
        set clk_d    [get_object_name [get_attribute $path2 endpoint_clock]]
        set clkT_r   [get_attribute [get_clocks $clk_r] period]
        set clkT_d   [get_attribute [get_clocks $clk_d] period]
        # RC vs DATA       
        set old_data [list 0,0,0]
        set arr_rc   0 
        set arr_cell 0 
        set stg_level 0
        set totalXY 0
        foreach_in_collection point [get_attr -quiet $path1 points] {
	        set pin       [get_object_name [get_attr $point object ] ]
                set pdirection [get_attr [get_attr $point object ] direction]
	        set arr       [format "%.3f" [get_attr $point arrival] ]
                set x_cor     [format "%.1f" [expr [get_attr [get_attr $point object ] x_coordinate]/1000] ]
	        set y_cor     [format "%.1f" [expr [get_attr [get_attr $point object ] y_coordinate]/1000] ]
	        incr stg_level 
	             
	        set arr_old   [lindex [split $old_data ","] 0]
	        set x_cor_old [lindex [split $old_data ","] 1]
	        set y_cor_old [lindex [split $old_data ","] 2]
	
	        set delta_x   0
	        set delta_y   0
	        set delta_arr 0
	        set distance  0	
	        catch  { set delta_x   [format "%.1f" [expr   abs($x_cor - $x_cor_old)]] }
	        catch  { set delta_y   [format "%.1f" [expr   abs($y_cor - $y_cor_old)]] }
	        catch  { set delta_arr [expr   $arr   - $arr_old]        }
	        catch  { set distance  [format "%.1f" [expr   $delta_x + $delta_y]]     }
	        set totalXY [format "%.1f"     [expr $totalXY + $distance]]
	        if  { $pdirection == "in"} { 
                    set arr_rc   [format "%.3f" [expr  $arr_rc + $delta_arr] ]
                } else {
                    set arr_cell [format "%.3f" [expr $arr_cell +  $delta_arr] ]
                }
	        set old_data  [list $arr,$x_cor,$y_cor]
        }
        set arr_rc_r   $arr_rc
        set arr_cell_r $arr_cell
        set arr_xy_r   $totalXY
        set old_data [list 0,0,0]
        set arr_rc   0 
        set arr_cell 0 
        set stg_level 0
        set totalXY 0
        foreach_in_collection point [get_attr -quiet $path2 points] {
	        set pin       [get_object_name [get_attr $point object ] ]
                set pdirection [get_attr [get_attr $point object ] direction]
	        set arr       [format "%.3f" [get_attr $point arrival] ]
                set x_cor     [format "%.1f" [expr [get_attr [get_attr $point object ] x_coordinate]/1000] ]
	        set y_cor     [format "%.1f" [expr [get_attr [get_attr $point object ] y_coordinate]/1000] ]
	        incr stg_level 
	             
	        set arr_old   [lindex [split $old_data ","] 0]
	        set x_cor_old [lindex [split $old_data ","] 1]
	        set y_cor_old [lindex [split $old_data ","] 2]
	
	        set delta_x   0
	        set delta_y   0
	        set delta_arr 0
	        set distance  0	
	        catch  { set delta_x   [format "%.1f" [expr   abs($x_cor - $x_cor_old)]] }
	        catch  { set delta_y   [format "%.1f" [expr   abs($y_cor - $y_cor_old)]] }
	        catch  { set delta_arr [expr   $arr   - $arr_old]        }
	        catch  { set distance  [format "%.1f" [expr   $delta_x + $delta_y]]     }
	        set totalXY [format "%.1f"     [expr $totalXY + $distance]]
	        if  { $pdirection == "in"} { 
                    set arr_rc   [format "%.3f" [expr  $arr_rc + $delta_arr] ]
                } else {
                    set arr_cell [format "%.3f" [expr $arr_cell +  $delta_arr] ]
                }
	        set old_data  [list $arr,$x_cor,$y_cor]
        }
        set arr_rc_d   $arr_rc
        set arr_cell_d $arr_cell
        set arr_xy_d   $totalXY


        set data($pin_name) "$slk_r,$slk_d,$arr_r,$arr_d,$lat_r,$lat_d,$arr_rc_r,$arr_rc_d,$arr_cell_r,$arr_cell_d,$arr_xy_r,$arr_xy_d,$clkT_r,$clkT_d,$clk_r,$clk_d"
        puts $out "$data($pin_name),$tag,$pin_name"
    }
    close $out
}
##------------------------------------------------------------------
## ProcNameEnd    : profile_reset_data
