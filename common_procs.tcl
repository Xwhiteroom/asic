##------------------------------------------------------------------
proc get_feed_loop_pins {ref_list max_path delay_type slack_lesser_than dir} {
    suppress_message UITE-416
    file mkdir $dir

    foreach ref $ref_list {
        set insts [get_cells -hier * -filter "ref_name==$ref"]
        foreach_in_collection inst $insts {
            set inst_name [get_object_name $inst]
            set in_pins   [get_pins $inst_name/* -filter "direction==in"]
            set out_pins  [get_pins $inst_name/* -filter "direction==out"]
            set pcol      [get_timing_paths   -through $in_pins -through $out_pins -delay_type $delay_type  -max_path $max_path -slack_lesser_than $slack_lesser_than -include_hierarchical_pins]
            puts "$ref,$inst_name,[sizeof_collection $pcol]"
	    gettimingpath_dump $pcol $dir/$ref.rpt "$ref,$inst_name,[sizeof_collection $pcol]"

        }
    }
	unsuppress_message UITE-416


}
