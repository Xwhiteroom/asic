    set cells [get_cells * -hier -filter "is_hierarchical==false"]
    set sub_classes [list ${track}TUL_*L08 ${track}TUL_*L10 ${track}TSL_*L08 ${track}TSL_*L10 ${track}TL_*L08 ${track}TL_*L10 ${track}TR_*L08 ${track}TR_*L10]
