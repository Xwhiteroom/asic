##------------------------------------------------------------------
## ProcNameStart  : inv_timing_points_split
## ProcArguments  : inv_timing_points_split points start_after_pin end_after_pin debug
## ProcDependency : lx 
## ProcInfluence  : 2
## ProcRenamed    : 0
##------------------------------------------------------------------
proc inv_timing_points_split {points start_after_pin end_after_pin debug} {
            set old_data [list 0,0,0]
            set arr_rc   0 
            set arr_cell 0 
            set stg_level 0
            set totalXY 0
	    set arr     0
            set totalsi 0 
            set pathtrace "" 
            set nodetrace [list "#Index,#Direction,#Delay,#Transition,#Xtlk,#Capacitance(Pin),#Capacitance(Net),#Resistance(Net),#Length(Net),#Cell,#Derate,#Node"] 
	    set arr_rel 0

	    #set debug 1
	    set dat_cache  "SP:$start_after_pin -> EP:$end_after_pin"
	    set data_real   ""
	    set pin_old     ""
	    set net_index       0	
            foreach_in_collection point $points {
	        set pin       [get_object_name [get_attr $point object ] ]
	        set pin_obj   [get_attr $point object ] 
	        set pin_class [get_attr $pin_obj object_class ] 
                set ref_cell  [get_attr -quiet [get_cells -of_object $pin_obj] ref_name]
                set pdirection [get_attr [get_attr $point object ] direction]
		set is_hier    [get_attr -quiet [get_attr $point object ] "is_hierarchical"]
		if { $is_hier == "" || $is_hier == "true" } { continue;}
		# Incr Stage Data
	        set arr       [format "%.3f" [get_attr $point arrival] ]
		set x_cor     "0"
		set y_cor     "0"
                catch { set x_cor     [format "%.1f" [expr [get_attr [get_attr $point object ] x_coordinate]/1.000] ]}
	        catch { set y_cor     [format "%.1f" [expr [get_attr [get_attr $point object ] y_coordinate]/1.000] ]}
	        set arr_si            [format "%.3f" [expr 0.000 + [get_attr -quiet $point annotated_delay_delta] + 0.000 ]]
	        set totalsi           [format "%.3f" [expr $totalsi + $arr_si]]
	        #set slack             [format "%.3f" [expr 0.000 + [get_attr -quiet $point slack] + 0.000 ]]
	        #set incremental       [format "%.3f" [expr 0.000 + [get_attr -quiet $point incremental] + 0.000 ]]
	        set transition        [format "%.3f" [expr 0.000 + [get_attr -quiet $point transition] + 0.000 ]]
	        set derate            [format "%.3f" [expr 0.000 + [get_attr -quiet $point total_derate] + 0.000 ]]

		# Trace Path 
		if { $pdirection == "in" && $net_index > 0 } {
		  set pathtrace "$pathtrace -through $pin"
		}
		#puts "$arr_si $pin"
                # Start
		if { $pin != $start_after_pin && $start_after_pin != "" } { 
                        #set arr_rel $arr
                        #puts "New Arr_rel=$arr_rel | $pin"
	        	set old_data  [list $arr,$x_cor,$y_cor]
			continue 
		} else {
			set data_real "SP:$start_after_pin ($arr)"	
		        set start_after_pin ""
		} 
		# Gen Clk Source Skip check
		if { $pin != $pin_old} {
	        	incr stg_level 
			set pin_old $pin
		}
	
	        set arr_old   [lindex [split $old_data ","] 0]
	        set x_cor_old [lindex [split $old_data ","] 1]
	        set y_cor_old [lindex [split $old_data ","] 2]
	
	        set delta_x   0
	        set delta_y   0
	        set delta_arr 0
	        set distance  0	
	        catch  { set delta_x   [format "%.1f" [expr   abs($x_cor - $x_cor_old)]] }
	        catch  { set delta_y   [format "%.1f" [expr   abs($y_cor - $y_cor_old)]] }
	        catch  { set delta_arr [expr   $arr   - $arr_old]        }
	        catch  { set distance  [format "%.1f" [expr   $delta_x + $delta_y]]     }
	        set totalXY [format "%.1f"     [expr $totalXY + $distance]]
	        if  { $pdirection == "in"} { 
                    # Innovus Arr Offset Negative Fix"
		    if { $net_index == 0 } { 
			set arr_rc [format "%.3f" [expr  $arr_rc - $arr_si ] ] ;
                        set delta_arr 0.000 
                        set arr_rel   $arr
                        #puts "arr_rel=$arr_rel | net_index=$net_index | pin=$pin" 
		    } else {
                        set arr_rc   [format "%.3f" [expr  $arr_rc + $delta_arr - $arr_si ] ]
		    }

                } else {
                    set arr_cell [format "%.3f" [expr $arr_cell +  $delta_arr] ]
                }
	        set old_data  [list $arr,$x_cor,$y_cor]
                # End
		if { $pin == $end_after_pin && $end_after_pin != "" } { 
		  set data_real "$data_real -> EP:$end_after_pin ($arr)" ; break ;
		}
		if { $debug} {
                	puts "     -- Debug $stg_level (XY=$totalXY) $arr $pin"
		}
		# Trace Node
		set net_data "$net_index"
                set net_length $distance
                incr net_index
		set net_obj   [get_nets -quiet [all_connected $pin]]
                set pin_cap   [get_attr -quiet $net_obj pin_capacitance_max]
                set net_cap   [get_attr -quiet $net_obj wire_capacitance_max]
                set net_res   [get_attr -quiet $net_obj resistance_max]


                #"#Index,#Direction,#Delay,#Transition,#Xtlk,#Capacitance(Pin),#Capacitance(Net),#Resistance(Net),#Length(Net),#Cell,#Derate,#Node"
		lappend nodetrace "$net_index,$pdirection,$delta_arr,$transition,$arr_si,$pin_cap,$net_cap,$net_res,$net_length,$ref_cell,$derate,$pin"
            }
	    set totalarr [expr $arr - $arr_rel]
	    if { $debug} {
	    	puts "  - Realx: $data_real  | $stg_level | $arr | $pin"
	    	puts "  - Cache: $data_cache | $stg_level | $arr | $pin\n\n"
                puts "  - Notes: RC=$arr_rc  | Cell=$arr_cell | Stage=$stg_level |Travel=$totalXY | Arr=$totalarr | Si=$totalsi"
                puts "  ----------------------------------------------------------\n"
                lx $nodetrace
	    }

	    set out [list $arr_rc $arr_cell $stg_level $totalXY $totalarr $totalsi $pathtrace $nodetrace]
	    return $out
}
##------------------------------------------------------------------
## ProcNameEnd    : inv_timing_points_split
