##------------------------------------------------------------------
## ProcNameStart  : sta_qc_get_mp_mpw
## ProcArguments  : sta_qc_get_mp_mpw dir tag
## ProcDependency : sh , ls 
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qc_get_mp_mpw {dir tag} {
    global CORNER ssi_sta_tool_unit_dly
    proc my_sort_clocks { clocks} {
    	set clocks [get_clocks $clocks]
    	set listx [list]
    	foreach_in_collection clk $clocks {
    		if { [sizeof_collection [get_attr -quiet $clk sources]] > 0 && [get_attr -quiet $clk is_generated] == false} {
    			lappend listx "[get_attr -quiet $clk period],[get_object_name $clk]"
    		}
    	}
    	set listx [lsort -increasing $listx]
    	return $listx
    }


    file mkdir $dir
    report_min_period  -nos -all_violators  > $dir/$tag.mp.raw
    #report_min_period  -nos   > $dir/$tag.mp.raw

    set in [open $dir/$tag.mp.raw]
    array unset mp_map_ref_stat
    array unset mp_map_ref_list
    array unset ref_count

    set view "xcorner"
    catch {set view $CORNER}
    echo "#VIEW,#CLASS,#LIB,#REF,#PIN,#CLK,#EDGE,#REQ,#ACT,#SLACK,#PERIOD,#UNCERT,#SKEW,#SLAT,#ELAT" > $dir/$tag.mp.csv
    while { [gets $in line] >= 0 } {
	if { [regexp "VIOLATED" $line] || [regexp "MET" $line] } { 
            regsub -all  {^\s+} $line {} line
            regsub -all  {\(} $line {} line
            regsub -all  {\)} $line {} line
            regsub -all  {\s+}  $line {,} line
            set class "MP"
            set data [split $line ","]
            set pin  [lindex $data 0]
            set clk  [lindex $data 1]
            set edg  [lindex $data 2]
            set req  [lindex $data 3]
            set act  [lindex $data 4]
            set slk  [lindex $data 5]
            set unc  [format "%0.3f" [get_attr [get_clocks $clk] setup_uncertainty]]
            set slat "NA"
            set elat "NA"
            set skew "NA"
            set per  [lindex [lsort [get_attr [get_clocks $clk] period]] 0]

            set edgx $edg
            catch { set slat [get_attr [get_pins $pin] max_${edgx}_arrival] }
            catch { set elat [get_attr [get_pins $pin] min_${edgx}_arrival] }
            set skew "$slat - $elat"
            catch { set skew [format "%0.3f" [expr $slat - $elat] ]}
            set ref [get_attr [get_cells -of_object [get_pins [lindex $data 0]]] ref_name]
            set lib [lindex [split [get_object_name [get_lib_cell -quiet */$ref]] "/"] 0]
            if { [ info exist ref_count($ref) ] } {
                incr ref_count($ref)
            } else {
                set ref_count($ref) 1
            }
            set datay [list $view $class $clk [format "%0.3f" $req] [format "%0.3f" $act] [format "%0.3f" $slk] [format "%0.1f" [expr $ssi_sta_tool_unit_dly/$req]] [format "%0.1f" [expr $ssi_sta_tool_unit_dly/$per]] $unc $skew $ref_count($ref) $ref $lib $pin]
            echo "$view,$class,$lib,$ref,$pin,$clk,$edg,$req,$act,$slk,$per,$unc,$skew,$slat,$elat" >> $dir/$tag.mp.csv
            if { ![info exist mp_map_ref_stat($ref)] || ([info exist mp_map_ref_stat($ref)] & [lindex $mp_map_ref_stat($ref)  1] > $slk)} {
                set mp_map_ref_stat($ref) $datay
            }
        }
    }
    close $in
    echo "#Corner #Class #FClock #Req(ns) #Act(ns) #Slack(ns) #Req(Mhz) #Clock(Mhz) #Unc(ns) #Skew_S-E(ns) #Count #Ref #Lib #Pin" > $dir/.$tag.mp.temp

    echo " " >> $dir/.$tag.mp.temp
    foreach ref [array names mp_map_ref_stat] {
        echo "$mp_map_ref_stat($ref)" >> $dir/.$tag.mp.temp
    }
    sh cat $dir/.$tag.mp.temp | column -t -s ' '  > $dir/$tag.mp.summary.txt




    report_min_pulse_width -nos -all_violators  > $dir/$tag.mpw.raw
    set in [open $dir/$tag.mpw.raw]
    array unset mpw_map_ref_stat
    array unset mpw_map_ref_list
    array unset ref_count

    echo "#CORNER,#LIB,#REF,#PIN,#CLK,#EDGE,#REQ,#ACT,#SLACK,#PERIOD,#UNCERT,#SKEW,#SLAT,#ELAT" > $dir/$tag.mpw.csv
    while { [gets $in line] >= 0 } {
	if { [regexp "VIOLATED" $line] || [regexp "MET" $line] } { 
            # sram/CK (low)   0.1999  -0.0459  -0.2458 (VIOLATED)
          
            regsub -all  {^\s+} $line {} line
            regsub -all  {\(} $line {} line
            regsub -all  {\)} $line {} line
            regsub -all  {\s+}  $line {,} line
            #puts "$line"
            set class "MPW"
            #
            set data [split $line ","]
            set pin  [lindex $data 0]
            set clk  "NA"
            set unc  "NA"
            #catch { set clk  [get_object_name [get_attr -quiet  [get_pins -quiet $pin] clocks]] }
            catch { set clk [lindex [ split [lindex [my_sort_clocks [get_attr -quiet  [get_pins -quiet $pin] clocks]] 0] ","] 1]  }


            set edg  [lindex $data 1]
            set req  [lindex $data 2]
            set act  [lindex $data 3]
            set slk  [lindex $data 4]
            catch { set unc  [format "%0.3f" [get_attr [get_clocks $clk] setup_uncertainty]]}
            set slat "NA"
            set elat "NA"
            set skew "NA"
            set per  [lindex [lsort [get_attr [get_clocks $clk] period]] 0]
            if { $edg == "low"} {
                set edgx "fall"
                set edgy "rise"
            } else {
                set edgx "rise"
                set edgy "fall"
            }
            catch { set slat [get_attr [get_pins $pin] max_${edgx}_arrival] }
            catch { set elat [get_attr [get_pins $pin] min_${edgy}_arrival] }
            set skew "$slat - $elat"
            catch { set skew [format "%0.3f" [expr $slat - $elat]]}
            set ref [get_attr [get_cells -of_object [get_pins [lindex $data 0]]] ref_name]
            set lib [lindex [split [get_object_name [get_lib_cell -quiet */$ref]] "/"] 0]
            if { [ info exist ref_count($ref) ] } {
                incr ref_count($ref)
            } else {
                set ref_count($ref) 1
            }
            #puts "$line,$req,$per,"      
            set datay [list $view $class $clk [format "%0.3f" $req] [format "%0.3f" $act] [format "%0.3f" $slk] [format "%0.1f" [expr $ssi_sta_tool_unit_dly/$req]] [format "%0.1f" [expr $ssi_sta_tool_unit_dly/$per]] $unc $skew $ref_count($ref) $ref $lib $pin]
            echo "$view $class,$lib,$ref,$pin,$clk,$edg,$req,$act,$slk,$per,$unc,$skew,$slat,$elat" >> $dir/$tag.mpw.csv
            if { ![info exist mpw_map_ref_stat($ref)] || ([info exist mpw_map_ref_stat($ref)] & [lindex $mpw_map_ref_stat($ref)  1] > $slk)} {
                set mpw_map_ref_stat($ref) $datay
            }
        }
    }
    close $in
    echo "#Corner #Class #FClock #Req(ns) #Act(ns) #Slack(ns) #Req(Mhz) #Clock(Mhz) #Unc(ns) #Skew_S-E(ns) #Count #Ref #Lib #Pin" > $dir/.$tag.mpw.temp
    echo " " >> $dir/.$tag.mpw.temp
    foreach ref [array names mpw_map_ref_stat] {
        echo "$mpw_map_ref_stat($ref)" >> $dir/.$tag.mpw.temp
    }
    sh cat $dir/.$tag.mpw.temp | column -t -s ' '  > $dir/$tag.mpw.summary.txt
    ls $dir/${tag}*
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qc_get_mp_mpw
