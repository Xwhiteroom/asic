##------------------------------------------------------------------
## ProcNameStart  : sta_qual_report_summary_cellprofile
## ProcArguments  : sta_qual_report_summary_cellprofile BASE_TAG dir col clock_not_allowed args
## ProcDependency : sh 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_report_summary_cellprofile {BASE_TAG dir col clock_not_allowed args} {
    array unset ref_map0
    file mkdir $dir
    
    set outfile      "$dir/$BASE_TAG.misc.cellusage.summary.rpt"
    set tempfile     "$dir/$BASE_TAG.misc.cellusage.summary"
    set clockvtfile  "$dir/$BASE_TAG.misc.cellusage.clockcells.rpt"
    set dontusefile  "$dir/$BASE_TAG.misc.cellusage.dontusecells.rpt"
    set track "*"

    set listx [split [lindex $args 0] " "]
    #set listx [list ${track}TUL_*L08 ${track}TUL_*L10 ${track}TSL_*L08 ${track}TSL_*L10 ${track}TL_*L08 ${track}TL_*L10 ${track}TR_*L08 ${track}TR_*L10]
    set vt_string ""
    set dash_string ""

    foreach filx $listx { 
        set vt_string "$vt_string,#$filx"
        regsub -all {.} $filx {-} filx
        set dash_string "$dash_string,-$filx"
    }
    set vt_string "$vt_string,#XXX"
    set header "#Class_Type,#Count(#),#Relative(%)$vt_string"
    set dash   "-----------,---------,------------$dash_string"
    echo "$dash" > $tempfile
    echo "$header" >> $tempfile
    echo "$dash" >> $tempfile


    echo "#inst,#class_type,#ref,#count,#count,#categ,#view,#class" > $dontusefile
    echo "#inst,#class_type,#ref,#count,#count,#categ,#view,#class" > $clockvtfile

        #start,#end,#tblock,#slk,#norm_slk,#end_clk,#view,#class
    set ref_map0(clk)  [get_cells -quiet $col -filter "is_clock_network_cell==true"]
    set ref_map0(dat)  [get_cells -quiet $col -filter "is_clock_network_cell==false"]

    set dontuse_cells  [get_cells -of_object [get_lib_cells */* -filter "dont_use==true"]]
    set ref_map0(duc)  [remove_from_collection -intersect $col $dontuse_cells]

    array unset ref_map1
    foreach class [lsort [array names ref_map0]] {
        #------------------------------------------
        # Clock/Data Top Class Filter
        #------------------------------------------
        # 
        set base $ref_map0($class)
        set ref_size [sizeof_collection $base]
        set filterx $base
            set base_size  [sizeof_collection $filterx]
            set vt_string ""
            foreach filx $listx {
                set cond "ref_name=~$filx"                
                set filtery [get_cells -quiet $filterx -filter "$cond"]
                set vt_size  [sizeof_collection $filtery]
                set vt_string "$vt_string,$vt_size"
                #set base    [remove_from_collection $base    $filtery] 
                set filterx [remove_from_collection $filterx $filtery]            
            }
            set vt_string "$vt_string,[sizeof_collection $filterx]"
            #set base [remove_from_collection $base $filterx]   
            set sub_class "$class.__ALL__"
            set ref_map1($sub_class) [format "%s,%03.2f$vt_string" $base_size [expr 100.000*$base_size/$ref_size] ]
        #------------------------------------------
        # Clock/Data Sub Class Filter
        #------------------------------------------
        # 
        set class_pair  [list  SEQ_MEM:is_memory_cell==true  SEQ_ICG:is_integrated_clock_gating_cell==true  SEQ_FFR:is_rise_edge_triggered==true  SEQ_FFF:is_fall_edge_triggered==true  SEQ_LTP:is_positive_level_sensitive==true  SEQ_LTN:is_negative_level_sensitive==true  SEQ_XXX:is_sequential==true  COM_BUF:ref_name=~*BUF*  COM_DLY:ref_name=~*DLY*  COM_INV:ref_name=~*INV*  COM_MUX:is_mux==true  COM_XXX:is_combinational==true  ]
                        
        foreach pair $class_pair {
            set type [lindex [split $pair ":"] 0]
            set cond [lindex [split $pair ":"] 1]
            set filterx [get_cells -quiet $base -filter "$cond"]
            set base_size  [sizeof_collection $filterx]
            set vt_string ""
            foreach filx $listx {
                set cond "ref_name=~$filx"
                set filtery [get_cells -quiet $filterx -filter "$cond"]
                if { $class == "clk" || $class == "duc" } { 
                    foreach_in_collection el  $filtery {
                        #inst,#class_type,#ref,#count,#count,#categ,#view,#class
                        set inst [get_object_name $el]
                        set ref  [get_attr $el ref_name]
                        set class_type "$class.$type"
                        set view  "default"
                        set is_clock_valid 1
                        if {$class == "clk" } {  
                            #foreach pattern $clock_not_allowed {
                            #    if { [regexp $pattern $ref] } {
                            #        incr is_clock_valid
                            #        break;
                            #    }
                            #}
                            echo "$inst,$class_type,$ref,$is_clock_valid,1,$class,$view,isclock_cell" >>  $clockvtfile
                        }
                        if {$class == "duc" } {  
                            echo "$inst,$class_type,$ref,1,1,$class,$view,dontuse_cell" >>  $dontusefile
                        }
                    }
                }


                set vt_size  [sizeof_collection $filtery]
                set vt_string "$vt_string,$vt_size"
                set base    [remove_from_collection $base    $filtery] 
                set filterx [remove_from_collection $filterx $filtery]            
            }
            set vt_string "$vt_string,[sizeof_collection $filterx]"
            set base [remove_from_collection $base $filterx]   
            set sub_class "$class.$type"
            set ref_map1($sub_class) [format "%s,%03.2f$vt_string" $base_size [expr 100.000*$base_size/$ref_size] ]

        }
        #------------------------------------------
        # Clock/Data Residual Class Filter
        #------------------------------------------
        # 
        set filterx $base
            set base_size  [sizeof_collection $filterx]
            set vt_string ""
            foreach filx $listx {
                set cond "ref_name=~$filx"                
                set filtery [get_cells -quiet $filterx -filter "$cond"]
                set vt_size  [sizeof_collection $filtery]
                set vt_string "$vt_string,$vt_size"
                set base    [remove_from_collection $base    $filtery] 
                set filterx [remove_from_collection $filterx $filtery]            
            }
            set vt_string "$vt_string,[sizeof_collection $filterx]"
            set base [remove_from_collection $base $filterx]   
            set sub_class "$class.XXX_XXX"
            set ref_map1($sub_class) [format "%s,%03.2f$vt_string" $base_size [expr 100.000*$base_size/$ref_size] ]
    }
    #------------------------------------------
    # Print Filter
    #------------------------------------------
    foreach class [lsort [array names ref_map1]] {
        set type [lindex [split $class "."] 1]
        set base $ref_map1($class)        
        if { $type == "__ALL__" } { echo "$dash" >> $tempfile }                
        echo "$class,$base" >> $tempfile
        if { $type == "__ALL__" } { echo "$dash" >> $tempfile }                        
    }
    puts "**Info :: Open files $outfile"
    sh cat $tempfile | column -t -s ','  > $outfile
    sh cat $outfile
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_report_summary_cellprofile
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_report_summary_clktrunk
## ProcArguments  : sta_qual_report_summary_clktrunk args
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_report_summary_clktrunk args {
    global MODE CORNER
    # Default inputs
    array unset inputs  
    set inputs(type)        "clktrunk"        
    set inputs(freq)        "1.000"    
    set inputs(view)        "default.default"
    catch { set inputs(view)   "$MODE.$CORNER" }

    # Parse Arguments 
    parse_proc_arguments -args $args proc_x_args
    foreach x [array names proc_x_args] {  
        regsub -all {\-} $x {} y
        set inputs($y) $proc_x_args($x)
        #puts [format "\t%20s = %-20s %20s" $y $x $proc_x_args($x)]
    }

    # Normalize Dir path
    set inputs(rep_dir) [file normalize $inputs(rep_dir)/$inputs(type)]

    # Print Arguments
    puts [format "<GC::PROC> Start %-50s  [date]"   "sta_qual_report_summary_clktrunk : $inputs(rep_dir)" ]
    foreach x [array names inputs] {    
        puts [format "\t%20s = %-20s" $x $inputs($x)] 
    }
    
    # Create dir
    file mkdir $inputs(rep_dir)


    set PERIOD [format "%0.4f" [expr 1/$inputs(freq)]]
    set xports [get_attr [get_clocks * -filter "period <= $PERIOD" ] sources]




    puts "                               Starting Clock Trunk Extraction For Threshold=$inputs(freq) GHz / $PERIOD"
    foreach_in_collection x $xports { 
        puts "                                       -- found [get_object_name $x]" 
    }
    set XDESIGN [get_object_name [current_design]]
    set_app_var timing_report_fixed_width_columns_on_left true
    set_app_var timing_report_fixed_width_columns_on_left  true
    echo "#Voltage,#Level,#Tran,#Xtalk,#Delay,#Arrival,#Type,#Corner,#Port,#Pin" > $inputs(rep_dir)/$inputs(base_tag).drv.$inputs(type).csv
    foreach_in_collection x $xports {
        set max_path [get_timing_paths   -through $x -delay max]
        set min_path [get_timing_paths   -through $x -delay min]
        set paths    [add_to_collection $max_path $min_path]
        report_timing -nos -tran -net -voltage -crosstalk $paths > $inputs(rep_dir)/$inputs(base_tag).drv.$inputs(type).[lindex [split [get_object_name $x] "/"] end].RAW.rpt
        foreach_in_collection path $paths {
            set arrival_old 0.000
            set level 0
            set type  [get_attr -quiet $path path_type]
            puts "                                       -- processed [get_object_name $x] $type  [date]"
            foreach_in_collection point [get_attr -quiet  $path points] {
                set port    [get_object_name $x]
                set pin     [get_object_name [get_attr -quiet  $point object]]
                set voltage [get_attr -quiet $point voltage]        
                set tran    [get_attr -quiet $point transition]
                set xtalk   [get_attr -quiet $point annotated_delay_delta]
                set arrival [get_attr -quiet $point arrival]
                set delay   [expr $arrival -$arrival_old]
                if { $tran  == "" } { set tran 0.0000 }
                if { $xtalk == "" } { set xtalk 0.0000 }
                set arrival_old $arrival
                set voltage [format "%0.4f" $voltage]
                set tran    [format "%0.4f" $tran]
                set xtalk   [format "%0.4f" $xtalk]
                set arrival [format "%0.4f" $arrival]
                set delay   [format "%0.4f" $delay]
                set levelx  [format "%03d"  $level]
                echo "$voltage,$levelx,$tran,$xtalk,$delay,$arrival,$type,$CORNER,$port,$pin" >> $inputs(rep_dir)/$inputs(base_tag).drv.$inputs(type).csv
                incr level
            }
        }        
    }
    #
    set_app_var timing_report_fixed_width_columns_on_left false
    puts [format "<GC::PROC> End   %-50s  [date]"   "sta_qual_report_summary_clktrunk : $inputs(rep_dir)" ]        
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_report_summary_clktrunk
##------------------------------------------------------------------


