## ProcArguments  : get_pin_net_stat pins filex delay_th
## ProcDependency : sh , get_net_delay 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc get_pin_net_stat {pins filex delay_th} {
  echo "#pin_port,#net,#attr,#val,#attr,#val" > $filex.GT.$delay_th.rpt  
  echo "#pin_port,#net,#attr,#val,#attr,#val" > $filex.LTEQ.$delay_th.rpt  

  foreach_in_collection pin $pins {
     set net  [get_object_name [get_nets -quiet [all_connected $pin]]]
     set val "NA"
     set pinx [get_object_name $pin]
     catch { set data [get_net_delay $net]}
     catch { set attr [ lindex [split [lindex $data 0] ","] 6 ]}
     catch { set val  [ lindex [split [lindex $data 1] ","] 6 ]}
     set slack [get_attr $pin max_slack]
     if { $delay_th < $val & $val != "NA"} {
        echo "$pinx,$net,$attr,$val,#Slack,$slack," >> $filex.GT.$delay_th.rpt
        echo "$pinx,$net,$attr,$val,#Slack,$slack," 
    } else {
        echo "$pinx,$net,$attr,$val,#Slack,$slack," >> $filex.LTEQ.$delay_th.rpt

    }
  }
  sh ls $filex.*

}
##------------------------------------------------------------------
## ProcNameEnd    : get_pin_net_stat
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : get_pin_stat
## ProcArguments  : get_pin_stat pin
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc get_pin_stat pin {
    set pinc [get_pins -quiet $pin]
    set pinv [get_object_name $pinc] 
    set is_clock          [get_attr  -quiet $pinc is_clock_pin]
    set constant_value    [get_attr  -quiet $pinc constant_value] ; # TIE OFF
    set user_case_value   [get_attr  -quiet $pinc user_case_value] ; # CASE SETTING
    set case_value        [get_attr  -quiet $pinc case_value] ; # CASE PROPAGATED
    set direction         [get_attr  -quiet $pinc direction] 
    set is_icg            [get_attr [get_lib_cells -of_object [get_attr $pinc cell]] is_integrated_clock_gating_cell]
    set is_com            [get_attr [get_lib_cells -of_object [get_attr $pinc cell]] is_combinational]
    set is_latN           [get_attr [get_lib_cells -of_object [get_attr $pinc cell]] is_negative_level_sensitive]
    set is_latP           [get_attr [get_lib_cells -of_object [get_attr $pinc cell]] is_positive_level_sensitive]
    set is_sdfr           [get_attr [get_lib_cells -of_object [get_attr $pinc cell]] is_rise_edge_triggered]
    set is_sdff           [get_attr [get_lib_cells -of_object [get_attr $pinc cell]] is_fall_edge_triggered]
    set clock_source      [join [get_object_name [remove_from_collection   [get_ports  [ all_fanin -to [get_pins -of_object [get_attr $pinc cell ] -filter "is_clock_pin==true"] -flat -startpoints_only ]] [get_ports  [ all_fanin -to [get_pins -of_object [get_attr $pinc cell ] -filter "is_clock_pin==false"] -flat -startpoints_only ]]]] "."]
    set cell   "MISC"
          if { $is_icg   == "true" }  { set cell "ICGX"
    } elseif { $is_com   == "true" }  { set cell "COMB"
    } elseif { $is_latN  == "true" }  { set cell "LATN"
    } elseif { $is_latP  == "true" }  { set cell "LATP"
    } elseif { $is_sdfr  == "true" }  { set cell "XFFR"
    } elseif { $is_sdff  == "true" }  { set cell "XFFF"
    } else                            { set cell "MISC" }

    
    set comment            "$cell.$direction"

          if { $constant_value  != "" }  { set comment "$comment.TIEOFF.$constant_value"
    } elseif { $user_case_value != "" }  { set comment "$comment.CASEAPPLY.$user_case_value"
    } elseif { $case_value      != "" }  { set comment "$comment.CASEPROP.$case_value"
    } else                               { set comment "$comment.NOCASE" }
    
    if { $is_clock == "true" } { set comment "$comment.CLOCK" }

    if { $direction == "out" } {
        set fanout [ remove_from_collection  [all_fanout -from  $pinc -trace_arcs all -flat] $pinc]
        if { [sizeof_collection $fanout] == 0 } { set comment "$comment.UNLOADED"}
    }

    if { $direction == "in" } {
        set fanout [ remove_from_collection  [all_fanin -to  $pinc -trace_arcs all -flat] $pinc]
        if { [sizeof_collection $fanout] == 0 } { set comment "$comment.UNDRIVEN"}
    }


    set source_clk        [get_object_name [get_ports -quiet [all_fanin -to $pin -flat -trace_arcs all] ]]
    echo "$pinv,$comment,$is_clock,$clock_source,$constant_value,$user_case_value,$case_value,$source_clk"
}
##------------------------------------------------------------------
## ProcNameEnd    : get_pin_stat
##------------------------------------------------------------------


