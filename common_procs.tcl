##------------------------------------------------------------------
## ProcNameStart  : find_procs
## ProcArguments  : find_procs tcl_file args
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc find_procs {tcl_file args} {
	set display_info 0
	if { [lindex $args 0 ] == "1"} {
		set display_info 1
	}

	set in_file [open $tcl_file ]
	while { [gets $in_file line] >= 0} {
 		regsub -all {\s+} $line " " line
 		regsub -all {^ } $line "" line
 		regsub -all {; } $line "" line
		if { ([regexp "^proc " $line] || [regexp ";proc " $line]) && ![regexp "^#" $line]   } {
 			regsub -all {.*;proc} $line "proc" line
 			regsub -all {\{} $line "" line
 			regsub -all {\}} $line "" line
			puts [format "\t\t %10s %-30s %s" [lindex $line 0]  [lindex $line 1]  [info args [lindex $line 1]]]
			#puts "[lindex "$line" 0]  [lindex "$line" 1]"

		}
	}
	close $in_file
}
##------------------------------------------------------------------
## ProcNameEnd    : find_procs
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : find_remove_buf_chain
## ProcArguments  : find_remove_buf_chain start end
## ProcDependency : parray , x 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc find_remove_buf_chain {start end} {
	set_app_var timing_report_unconstrained_paths true
	puts "\n\n[date]<Info>  :  Start Path Reporting <CMD> get_timing_path -through $start -through $end\n\n"  
	set path       [get_timing_path -through $start -through $end]
	set points     [get_attr -quiet $path points]
	set startname  [get_object_name [get_cells -quiet -of_object $start]]
	set endname    [get_object_name [get_cells -quiet -of_object $end]]

	set  fouts     [sizeof_collection [filter_collection [all_fanout -from $start -flat -only_cells ] "is_sequential==true"]]
	set  foute     [sizeof_collection [filter_collection [all_fanout -from $end -flat -only_cells ] "is_sequential==true"]]

	set  xc_ref    		[lindex [get_attr [get_cells -quiet $startname] x_coordinate_max] 0]
        set  yc_ref    		[lindex [get_attr [get_cells -quiet $startname] y_coordinate_max] 0]
	catch { set  xc_ref   	[format "%0.1f"   [expr $xc_ref/1000] ]   }
	catch { set  yc_ref   	[format "%0.1f"   [expr $yc_ref/1000] ]   }




	set chain [list]
	set start_print 0
	set arrival_base 0
	foreach_in_collection point $points {
		set x 		[get_attr $point  object]
		set xdirection  [get_attr [get_attr $point object ] direction]
		set xname 	[get_object_name $x]
		set xcell       [get_object_name [get_cells -quiet -of_object [get_pins -quiet $xname] ]]
		if { $xcell == $startname && $xdirection == "in"} {
			set start_print 1
			set arrival_base  [get_attr $point arrival]
		}
		if { $start_print && $xdirection == "in"} {
			#puts "  -->  Cell $xcell"
			set  xc    		[lindex [get_attr [get_cells -quiet $xcell] x_coordinate_max] 0]
		        set  yc    		[lindex [get_attr [get_cells -quiet $xcell] y_coordinate_max] 0]
			catch { set  xc   	[format "%0.1f"   [expr $xc/1000] ]   }
			catch { set  yc   	[format "%0.1f"   [expr $yc/1000] ]   }
			set  travel             [expr abs($xc - $xc_ref) + abs($yc - $yc_ref)]
			set  rcell              [get_attr [get_cells -quiet $xcell] ref_name]
			set  arrivalx 		[get_attr $point arrival]
			set  delay  		[expr $arrivalx - $arrival_base]
			catch { set  delay   	[format "%+0.3f"  $delay]	}
			lappend chain [list $xcell $arrivalx $delay $xc $yc $travel $rcell]
		}
		if { $xcell == $endname } {
			set start_print 0
			set arrival_final  [get_attr $point arrival]
			break;
		}

	}

	puts "\n\n[date]<Info>  :  Depth=[llength $chain]  Delay=($arrival_final)-($arrival_base)=[expr  $arrival_final - $arrival_base] F/O Start=$fouts  End=$foute\n\n"  
	set xindex 0
	set tracex([format "%04d" $xindex]) [format "   %5s %10s %10s %10s %20s  %5s  %30s    %-s" "#Delay" "#X" "#Y" "#Travel" "#F/O" "#Type" "#Cell" "#Node"]


	foreach xy $chain {
		set  cname            	[lindex $xy 0]
		set  delay        	[lindex $xy 2]
		set  xc    		[lindex $xy 3]
		set  yc    		[lindex $xy 4]
		set  travel    		[lindex $xy 5]
		set  cell    		[lindex $xy 6]
    		set  cell_is_rep  [sizeof_collection [filter_collection [get_lib_cells */$cell]  "number_of_pins==2 && is_instantiated==true && is_combinational==true"]]
		set  fout  [sizeof_collection [filter_collection [all_fanout -from $cname/* -flat -pin_level 1 -only_cells] "full_name!=$cname"]]
		set type "logicx"
		if { $cell_is_rep } { set type "bufinv" }
		incr xindex 
		set tracex([format "%04d" $xindex]) [format "   %5s %10s %10s %10s %20s  %5s  %30s    %-s" $delay $xc $yc $travel $fout $type $cell $cname]
	}
	set last_cell $cname
	parray tracex
	puts "\n\n"
	set xindex 0
	set tracey([format "%04d" $xindex]) "# Remove Repeater Chain"
	foreach {x y} $chain {
		incr xindex 
		set tracey([format "%04d" $xindex]) [format "   %15s {%-s %-s} ;" "remove_buffer" [lindex $x 0] [lindex $y 0]]
		puts "     $tracey([format "%04d" $xindex])"
	}
	puts "\n\n"
	set anno_node   [get_object_name [filter_collection [all_fanout -from [get_pins $cname/* -filter "direction==out"] -flat -pin_level 1] "direction==in"]]
	puts "<CMD> set set_final_pin $anno_node; set push 0.000 ; set dly 0.030 ; set_annotated_transition \$dly \$set_final_pin ;   set_annotated_delay -net \[expr \$dly + \$push\]  -to \$set_final_pin"
	puts "<CMD> set set_final_pin $anno_node"
	puts "<CMD> set set_final_pin $cname"
	puts "<CMD> set_clk_pin_anno 0.030 \$set_final_pin"
	puts "\n\n"
	parray tracey
	puts "\n\n"
	return $chain
}
##------------------------------------------------------------------
## ProcNameEnd    : find_remove_buf_chain
##------------------------------------------------------------------


