##------------------------------------------------------------------
## ProcNameStart  : cell_profile_db
## ProcArguments  : cell_profile_db hier_list file_path all_cells
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc cell_profile_db {hier_list file_path all_cells} {

    array unset data 
    array unset csv_data 

    set data(all)               [filter_collection [get_cells -quiet $all_cells]     "is_hierarchical==false"]
    set data(all.com)           [filter_collection $data(all)     "is_sequential==false"]
    set data(all.com.BUF)       [filter_collection $data(all.com) "ref_name=~*BUF* || ref_name=~*INV* || ref_name=~*DLY* || ref_name=~*DEL*"]
    set data(all.com.LOG)       [filter_collection $data(all.com) "ref_name!~*BUF* && ref_name!~*INV* && ref_name!~*DLY* && ref_name!~*DEL*"]
    set data(all.seq)           [filter_collection $data(all)     "is_sequential==true"]
    set data(all.seq.ICG)       [filter_collection $data(all.seq) "is_integrated_clock_gating_cell==true"]
    set data(all.seq.LAT)       [filter_collection $data(all.seq) "is_integrated_clock_gating_cell==false && ref_name=~*LAT*"]
    set data(all.seq.MEM)       [filter_collection $data(all.seq) "is_integrated_clock_gating_cell==false && (ref_name=~*ln0* || ref_name=~*mg*)"]
    set data(all.seq.REG)       [filter_collection $data(all.seq) "is_integrated_clock_gating_cell==false &&  ref_name!~*ln0* && ref_name!~*mg* && ref_name!~*LAT*"]
    
    puts "<INFO> :[date]: Size Total   [sizeof_collection $all_cells]"    
    puts "<INFO> :[date]: Size NonHier [sizeof_collection $data(all)]"

    set data_keys [lsort [array names data]]
    set header "#InstanceHierarchy"
    foreach x $data_keys {
          set header "$header,Area.$x"
    }
    foreach x $data_keys {
          set header "$header,Cnt.$x"
    }
    set csv_data("#InstanceHierarchy") $header
    foreach_in_collection hier [get_cells $hier_list] {
      set objectx [get_object_name $hier]
      set areax ""
      set cntx  ""
      puts "<INFO> :[date]: Check hier $objectx"

      foreach x $data_keys {
        #puts "<INFO> :[date]: Size Target $x=[sizeof_collection $data($x)]"
        set valid_collection [filter_collection $data($x) "full_name=~$objectx/*"]
        set area 0
        set cnt  0
        foreach_in_collection y $valid_collection { set area [expr 0 +  [get_attr $y area] + 0 + $area] ; incr cnt }
        set areax "$areax,$area"
        set cntx "$cntx,$cnt"
      }
      set csv_data($objectx) "$objectx$areax$cntx"
    }
    set out [open $file_path w+]
    foreach x [lsort [array names csv_data]] {
        puts $out "$csv_data($x)"
    }
    close $out
    puts "\n\n<INFO> : Open [file normalize $file_path]\n\n"
}
##------------------------------------------------------------------
## ProcNameEnd    : cell_profile_db
