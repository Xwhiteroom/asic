##------------------------------------------------------------------
## ProcNameStart  : autodesign_report_io_timing
## ProcArguments  : autodesign_report_io_timing tag_scenario port_list clock_list pin_bus_ultra skip_infinity_1_0 outdir args
## ProcDependency : autodesign_print_stage , autodesign_debus , autodesign_report_sync_clocks , ls 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc autodesign_report_io_timing {tag_scenario port_list clock_list pin_bus_ultra skip_infinity_1_0 outdir args} {
	puts "\n\n"
	# Process Inputs/Statics
	set SCENARIO	 $tag_scenario
	set XDESIGN   	 [lindex [get_object_name [current_design]] 0]
	set valid_ports  [get_ports  -quiet $port_list]
	set valid_clocks [get_clocks -quiet $clock_list]


	# Process Each Module
	autodesign_print_stage blue [format "=============================================================================================" ]
	array unset module_io
	set module_io(00_BLOCK_00)  [list [list #DESIGN #SCENARIO #PORT_IO #DIR #BUS #IOCLOCK #OTCLOCK #PERIOD #MAX_WINDOW #MAX_SLACK #MAX_DLY_PORT #MAX_DLY_DATA #MAX_DLY_LIB #MAX_DLY_SKEW #MAX_DLY_MARGIN  #MIN_WINDOW #MIN_SLACK #MIN_DLY_PORT #MIN_DLY_DATA #MIN_DLY_LIB #MIN_DLY_SKEW #MIN_DLY_MARGIN #PROCESS]]
	array unset module_bus
	set pcnt 0

	# Bus Compression
	set blk       $XDESIGN
	set module_io($blk)         [list]
	set in_pins   [lsort -unique [get_object_name [get_ports -quiet $valid_ports -filter "direction==in"]]]
	set out_pins  [lsort -unique [get_object_name [get_ports -quiet $valid_ports -filter "direction==out"]]]

	set in_busx   [autodesign_debus $in_pins  ""]
	set out_busx  [autodesign_debus $out_pins ""]

	set in_ultra  [autodesign_debus $in_pins  {\d+}]
	set out_ultra [autodesign_debus $out_pins {\d+}]

	# Bus Selection
	autodesign_print_stage blue [format "     - Infox :   Module $blk : Input=[llength  $in_pins]  / Input(debussed)=[llength  $in_busx]  / Input(compressed)=[llength  $in_ultra]"]
	autodesign_print_stage blue [format "     - Infox :   Module $blk : Output=[llength  $out_pins]  / Output(debussed)=[llength  $out_busx]  / Output(compressed)=[llength  $out_ultra]"]
	set module_bus(Inputs) $in_pins;  set module_bus(Outputs) $out_pins
	if { $pin_bus_ultra == "bus"   } { set module_bus(Inputs) $in_busx;   set module_bus(Outputs) $out_busx  }
	if { $pin_bus_ultra == "ultra" } { set module_bus(Inputs) $in_ultra;  set module_bus(Outputs) $out_ultra }
	autodesign_print_stage red  [format "     - Infox :   Module $blk : Selected --> Input=[llength  $module_bus(Inputs)] | Output=[llength  $module_bus(Outputs)]"]
	autodesign_print_stage blue [format "\t      --------------------------------------------------------------------------------------"]


	# Path Collection
	set empty_collection [remove_from_collection [all_clock] [all_clock]]
	set max_paths $empty_collection
	set min_paths $empty_collection

	# Input/Output Process
	foreach categ [array names module_bus] {
		set direction "in"
		if { $categ == "Outputs" } { set direction "out" }
		set max_size   [llength $module_bus($categ)]
		set bkt_size   [expr $max_size / 10]
		set iter_size  0
		set lst_size   0
		set progress   "0" 
		#puts -nonewline  "[date]       \t\t\t $categ: $progress"
		foreach nodex $module_bus($categ) {
			# Bucket Count:
			incr iter_size
			incr lst_size
			if { $iter_size >= $bkt_size } { 
		                #puts -nonewline [format " -> [expr 100*($lst_size )/$max_size] ($lst_size)"]
                                flush stdout
				set iter_size 0	
			}
			# Map Bust Stat
			incr pcnt
			set bus_pins    [get_ports -quiet [list $nodex] -filter "direction==$direction"]
			set bus_size    [sizeof_collection $bus_pins]
			set bus_idx     $nodex

			# Bus Clocks
			if { $direction == "in"} {
				#set clk_used  [get_clocks -quiet [get_attribute -quiet [get_pins -of_object [all_fanout -quiet -from $bus_pins -flat -end  -only_cells] -filter "is_clock_pin==true"] clocks]]
				set clk_used [get_object_name [get_attribute -quiet [get_ports $bus_pins ] constrained_launch_clocks]]
			} else {
				set clk_used  [get_clocks -quiet [get_attribute -quiet [all_fanin -quiet    -to $bus_pins -flat -start ] clocks]]
				#set clk_usedx "None"
				#set clk_used [get_object_name [get_attribute -quiet [get_ports $bus_pins ] launch_clocks]]
			}
			set clk_used        [autodesign_report_sync_clocks $clk_used $valid_clocks]
			set clock_valid     [lsort -unique [get_object_name [remove_from_collection -intersect $valid_clocks $clk_used]]]
			#set clock_valid    [lsort -unique [get_object_name $valid_clocks]]
			
			# Path Stat
			foreach clkx $clock_valid {
				set refTime 	[clock seconds]
				set period [lindex [get_attribute [get_clocks -quiet $clkx] period] 0]
				if { $direction == "in"} {
					set pathmax [get_timing_path -through $nodex -delay max -from [get_clocks $clkx] -max_path 1 ]
					set pathmin [get_timing_path -through $nodex -delay min -from [get_clocks $clkx] -max_path 1 ]
					set ioattr  "startpoint_input_delay_value"
					set sclkx   [get_object_name [get_attribute -quiet $pathmax startpoint_clock]]
					set eclkx   [get_object_name [get_attribute -quiet $pathmax endpoint_clock]]
					set tclkx   $eclkx
					#set slk     [get_attribute -quiet $pathmax slack] ;puts "$direction,$nodex,Slack=$slk,Start=$sclkx,End=$eclkx,TCLK=$tclkx,CLK=$clkx"
				} else {
					set pathmax [get_timing_path -through $nodex -delay max -to [get_clocks $clkx] -max_path 1 ]
					set pathmin [get_timing_path -through $nodex -delay min -to [get_clocks $clkx] -max_path 1 ]
					set ioattr  "endpoint_output_delay_value"
					set sclkx   [get_object_name [get_attribute -quiet $pathmax startpoint_clock]]
					set eclkx   [get_object_name [get_attribute -quiet $pathmax endpoint_clock]]
					set tclkx   $sclkx
					#set slk     [get_attribute -quiet $pathmax slack] ;puts "$direction,$nodex,Slack=$slk,Start=$sclkx,End=$eclkx,TCLK=$tclkx,CLK=$clkx"
				}
				set period [lindex [get_attribute [get_clocks -quiet $tclkx] period] 0]
				set iodata [list $nodex $direction $bus_size $clkx $tclkx $period]
				set is_infinity_cnt 0
				set path 	$pathmax
				set points      [get_attribute -quiet $path points]
				set dlySP       [get_attribute -quiet $path startpoint_clock_open_edge_value]
				set dlyEP       [get_attribute -quiet $path endpoint_clock_close_edge_value]
				set slack	[get_attribute -quiet $path slack] ; regsub -all {^$} $slack "INFINITY" slack
				set dlyport	[get_attribute -quiet $path $ioattr]
				set dly_window  [expr 0 + $dlyEP - 0 - $dlySP - 0 - $dlyport + 0]
				set point_arr   [get_attribute -quiet $points arrival]
				set dlydata     [lindex  [lsort -increasing $point_arr] end]
				set dlylib      [get_attribute -quiet $path endpoint_setup_time_value]
				set dlyslat     [get_attribute -quiet $path startpoint_clock_latency]
				set dlyelat     [get_attribute -quiet $path endpoint_clock_latency]
				set dlycrpr     [get_attribute -quiet $path common_path_pessimism]
				set dlyskew     [expr 0 + $dlyelat + 0 + $dlycrpr + 0 - $dlyslat + 0]
				set dlymargin   [get_attribute -quiet $path clock_uncertainty]
				#puts "MAXWIN=$dly_window,SLK=$slack,PORT=$dlyport,DATA=$dlydata,LIB=$dlylib,SKEW=$dlyskew,MARGIN=$dlymargin"
				if { $slack == "INFINITY" || $slack == "" } {
					set max_iodata  [list None $slack None None None None None ]
					incr is_infinity_cnt
				} else {
					append_to_collection max_paths $path
					set max_iodata  [list $dly_window $slack $dlyport $dlydata $dlylib $dlyskew $dlymargin]
				}
				set path 	$pathmin
				set points      [get_attribute -quiet $path points]
				set dlySP       [get_attribute -quiet $path startpoint_clock_open_edge_value]
				set dlyEP       [get_attribute -quiet $path endpoint_clock_close_edge_value]
				set slack	[get_attribute -quiet $path slack]; regsub -all {^$} $slack "INFINITY" slack
				set dlyport	[get_attribute -quiet $path $ioattr]
				set dly_window  [expr 0 + $dlyEP - 0 - $dlySP - 0 - $dlyport + 0]
				set point_arr   [get_attribute -quiet $points arrival]
				set dlydata     [lindex  [lsort -increasing $point_arr] end]
				set dlylib      [get_attribute -quiet $path endpoint_setup_time_value]
				set dlyslat     [get_attribute -quiet $path startpoint_clock_latency]
				set dlyelat     [get_attribute -quiet $path endpoint_clock_latency]
				set dlycrpr     [get_attribute -quiet $path common_path_pessimism]
				set dlyskew     [expr 0 + $dlyelat + 0 + $dlycrpr + 0 - $dlyslat + 0]
				set dlymargin   [get_attribute -quiet $path clock_uncertainty]
				#puts "MINWIN=$dly_window,SLK=$slack,PORT=$dlyport,DATA=$dlydata,LIB=$dlylib,SKEW=$dlyskew,MARGIN=$dlymargin"
				if { $slack == "INFINITY" || $slack == "" } {
					set min_iodata  [list None $slack None None None None None ]
					incr is_infinity_cnt
				} else {
					append_to_collection min_paths $path
					set min_iodata  [list $dly_window $slack $dlyport $dlydata $dlylib $dlyskew $dlymargin]
				}
				# Appending Data
				set tarTime [clock seconds]
				set delta   [expr ($tarTime - $refTime)]
				set iodata  [concat $iodata $max_iodata $min_iodata]
				lappend iodata "$delta/sec"
				regsub -all {\{\}} $iodata "None" iodata
				#puts $iodata
				if { ($skip_infinity_1_0 == 1 && $is_infinity_cnt != 2) || $skip_infinity_1_0 == 0 } {
					lappend module_io($blk) $iodata	
				}
			} 	
			#if { $pcnt >= 25 } { break }
		}
		puts ""
	}
	
	# Publish IO Summary
	file mkdir $outdir
	set outdir [file normalize $outdir]
	set file1 [open "$outdir/$XDESIGN.$SCENARIO.io.rpt" w+]
	set file2 [open "$outdir/$XDESIGN.$SCENARIO.io.csv" w+]

	foreach blkx [lsort [array names module_io]] {
		if { $blkx == "00_BLOCK_00"} {
			set iodata [lindex $module_io($blkx) 0]
			set xdata [format "%-20s %-40s %-70s"                                       [lindex $iodata 0]  [lindex $iodata 1]  [lindex $iodata 2]  ]
			set xdata [format "$xdata %-15s %-15s %-50s %-50s %-15s"                    [lindex $iodata 3]  [lindex $iodata 4]  [lindex $iodata 5]  [lindex $iodata 6]  [lindex $iodata 7]]
			set xdata [format "$xdata %-15s %-15s %-15s %-15s %-15s %-15s %-15s"        [lindex $iodata 8]  [lindex $iodata 9]  [lindex $iodata 10] [lindex $iodata 11] [lindex $iodata 12]  [lindex $iodata 13]  [lindex $iodata 14]  [lindex $iodata 15]]
			set xdata [format "$xdata %-15s %-15s %-15s %-15s %-15s %-15s %-15s %-15s"  [lindex $iodata 16] [lindex $iodata 17] [lindex $iodata 18] [lindex $iodata 19] [lindex $iodata 20]  [lindex $iodata 21]  [lindex $iodata 22]  [lindex $iodata 23]]
			set xdata [format "$xdata %-15s"  					    [lindex $iodata 24]]
			regsub -all {\s+} $xdata {,} ydata
			puts $file1 $xdata
			puts $file2 $ydata
			continue
		}
		foreach iodata [lsort $module_io($blkx)] {
			set iodata  [concat [list $blkx $SCENARIO] $iodata]
			set xdata [format "%-20s %-40s %-70s"                                       [lindex $iodata 0]  [lindex $iodata 1]  [lindex $iodata 2]  ]
			set xdata [format "$xdata %-15s %-15s %-50s %-50s %-15s"                    [lindex $iodata 3]  [lindex $iodata 4]  [lindex $iodata 5]  [lindex $iodata 6]  [lindex $iodata 7]]
			set xdata [format "$xdata %-15s %-15s %-15s %-15s %-15s %-15s %-15s"        [lindex $iodata 8]  [lindex $iodata 9]  [lindex $iodata 10] [lindex $iodata 11] [lindex $iodata 12]  [lindex $iodata 13]  [lindex $iodata 14]  [lindex $iodata 15]]
			set xdata [format "$xdata %-15s %-15s %-15s %-15s %-15s %-15s %-15s %-15s"  [lindex $iodata 16] [lindex $iodata 17] [lindex $iodata 18] [lindex $iodata 19] [lindex $iodata 20]  [lindex $iodata 21]  [lindex $iodata 22]  [lindex $iodata 23]]
			set xdata [format "$xdata %-15s"  					    [lindex $iodata 24]]
			regsub -all {\s+} $xdata {,} ydata
			puts $file1 $xdata			                                                                     
			puts $file2 $ydata
			#DESIGN #SCENARIO #PORT_IO #DIRECTION #BUS #IOCLOCK #OTCLOCK #PERIOD #MAX_WINDOW #MAX_SLACK #MAX_DLY_PORT #MAX_DLY_DATA #MAX_DLY_LIB #MAX_DLY_SKEW #MAX_DLY_MARGIN  #MIN_WINDOW #MIN_SLACK #MIN_DLY_PORT #MIN_DLY_DATA #MIN_DLY_LIB #MIN_DLY_SKEW #MIN_DLY_MARGIN #PROCESS/TIME
			#DESIGN #SCENARIO #PORT_IO #DIRECTION #BUS #IOCLOCK #OTCLOCK #PERIOD 
			                                                                     #MAX_WINDOW #MAX_SLACK #MAX_DLY_PORT #MAX_DLY_DATA #MAX_DLY_LIB #MAX_DLY_SKEW #MAX_DLY_MARGIN
			                                                                     #MIN_WINDOW #MIN_SLACK #MIN_DLY_PORT #MIN_DLY_DATA #MIN_DLY_LIB #MIN_DLY_SKEW #MIN_DLY_MARGIN 
			                                                                     #PROCESS
		}
	}
	close $file1
	close $file2

 	set default_frmt [get_app_var timing_report_fixed_width_columns_on_left]
	set_app_var timing_report_fixed_width_columns_on_left false
	report_timing -include_hierarchical_pins    -nets        -nosplit          -input_pins       -crosstalk_delta  -capacitance      -transition_time $min_paths > $outdir/$XDESIGN.$SCENARIO.path.min_path.detail_io.rpt
	report_timing -include_hierarchical_pins    -nets        -nosplit          -input_pins       -crosstalk_delta  -capacitance      -transition_time $max_paths > $outdir/$XDESIGN.$SCENARIO.path.max_path.detail_io.rpt
	set_app_var timing_report_fixed_width_columns_on_left true
	report_timing -include_hierarchical_pins    -nets        -nosplit          -input_pins       -crosstalk_delta  -capacitance      -transition_time -derate -physical $min_paths > $outdir/$XDESIGN.$SCENARIO.path.min_path.readable.rpt
	report_timing -include_hierarchical_pins    -nets        -nosplit          -input_pins       -crosstalk_delta  -capacitance      -transition_time -derate -physical $max_paths > $outdir/$XDESIGN.$SCENARIO.path.max_path.readable.rpt
	set_app_var timing_report_fixed_width_columns_on_left $default_frmt
	autodesign_print_stage blue [format "     - Infox :   Files $outdir/*"]
	foreach x [ls $outdir/*] {
		autodesign_print_stage blue [format "                       - $x"]	
	}
}
##------------------------------------------------------------------
## ProcNameEnd    : autodesign_report_io_timing
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : autodesign_report_sync_clocks
## ProcArguments  : autodesign_report_sync_clocks input_clock super_set_clocks
## ProcDependency : autodesign_get_clock_relationship 
## ProcInfluence  : 3
## ProcRenamed    : 0
##------------------------------------------------------------------
proc autodesign_report_sync_clocks {input_clock super_set_clocks} {
	set master_clk  [remove_from_collection [get_clocks -quiet $super_set_clocks] [get_clocks -quiet $input_clock]]
	set input_clock [get_clocks -quiet $input_clock]
	set return_clks $input_clock
	foreach_in_collection mclk $master_clk {
		foreach_in_collection iclk $input_clock {
			set relation [autodesign_get_clock_relationship [list $mclk $iclk]]
			if { $relation == "{synchronous}" || $relation == "{allow_paths}" } {
				append_to_collection	-unique return_clks $mclk
			}
		}		
	}
	return $return_clks
}
##------------------------------------------------------------------
## ProcNameEnd    : autodesign_report_sync_clocks
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : autodesign_sort_clocks
## ProcArguments  : autodesign_sort_clocks clocks
## ProcDependency :  
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc autodesign_sort_clocks clocks {
        set clocks [get_clocks $clocks]
        set listx [list]
        foreach_in_collection clk $clocks {
                if { [sizeof_collection [get_attr -quiet $clk sources]] > 0 } {
                        lappend listx "[get_attr -quiet $clk period],[get_object_name $clk]"
                }
        }
        set listx [lsort -increasing $listx]
        return $listx
}
##------------------------------------------------------------------
## ProcNameEnd    : autodesign_sort_clocks
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : autodesign_unclocked_registers
## ProcArguments  : autodesign_unclocked_registers outdir dft_pat_list_of_clocknames_collection scenario_should_be_mode_dot_corner
## ProcDependency : autodesign_print_stage 
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc autodesign_unclocked_registers {outdir dft_pat_list_of_clocknames_collection scenario_should_be_mode_dot_corner} {
	set design_name [get_object_name [current_design]]
	set dft_pat_list $dft_pat_list_of_clocknames_collection
	set scenario $scenario_should_be_mode_dot_corner
	set outdir $outdir
	file mkdir $outdir
	set outdir [file normalize $outdir]
	autodesign_print_stage blue [format "\n\n=============================================================================================" ]
	autodesign_print_stage red  [format "<SDC_GEN> : Created o/p directory %s"  "$outdir"]
	set filter_tag "unclocked_registers"
	set empty_collection [remove_from_collection [all_clocks] [all_clocks]]


	# Set Clock Filters
	set valid_dft_clocks [get_clocks -quiet $dft_pat_list]
	if { [llength	 $dft_pat_list] == "0" } { 
		autodesign_print_stage red  [format "\n<SDC_GEN> : No DFT Pattern Provided  (%03d) Clocks  dft_pat_list=%s"  "[sizeof_collection $valid_dft_clocks]" "$dft_pat_list"]
	} elseif { [sizeof_collection $valid_dft_clocks] } { 
		autodesign_print_stage red  [format "\n<SDC_GEN> : DFT Pattern Provided  (%03d) Clocks     dft_pat_list=%s"  "[sizeof_collection $valid_dft_clocks]" "$dft_pat_list"]
		autodesign_print_stage blue [format "            Clocks : [get_object_name $valid_dft_clocks]"]
	} else {
		autodesign_print_stage red  [format "\n<SDC_GEN> : DFT Pattern Provided  (%03d) Matches    dft_pat_list=%s"  "[sizeof_collection $valid_dft_clocks]" "$dft_pat_list"]
	}	
	set valid_func_clocks [remove_from_collection [all_clocks] $valid_dft_clocks]
	autodesign_print_stage red  [format "\n<SDC_GEN> : Valid  (%03d) Clocks  for fuctional case  "  "[sizeof_collection $valid_func_clocks]" "$dft_pat_list"]
	autodesign_print_stage blue [format "            Clocks : [get_object_name $valid_func_clocks]"]

	# Set Register Collection
	set all_seq  		[get_cells -hier -filter "is_hierarchical==false && is_sequential==true"]
	set all_seq_ck		[get_pins -of_object $all_seq -filter "is_clock_network==true && direction==in"]
	set all_reg_ck		[all_register -clock_pins]
	set master_ck           [add_to_collection -unique $all_seq_ck  $all_reg_ck]
	set total_ck            [sizeof_collection $master_ck]
	
	autodesign_print_stage blue [format "=============================================================================================" ]
	autodesign_print_stage red  [format "<SDC_GEN> : Initial Stats for $design_name"]
	autodesign_print_stage blue [format "            %-50s = %10s" "Is_Sequential_True" "[sizeof_collection $all_seq]" ]
	autodesign_print_stage blue [format "            %-50s = %10s" "Is_Sequential_True_CK" "[sizeof_collection $all_seq_ck]" ]
	autodesign_print_stage blue [format "            %-50s = %10s" "All_Reg_CK" "[sizeof_collection $all_reg_ck]" ]
	autodesign_print_stage blue [format "            %-50s = %10s" "Master_CK" "[sizeof_collection $master_ck]" ]
	autodesign_print_stage blue [format "=============================================================================================" ]
	
	if { $total_ck == 0} { return 0 }

	# Creat DB
	array unset clock_db
	
	set clock_db(99_Total_CK)   $master_ck
	
	set type "01_TieOff_CK" ;	set clock_db($type)  [filter_collection $master_ck "constant_value==0"] ; set master_ck [remove_from_collection $master_ck $clock_db($type)]
	set type "02_NoClk_D+CK" ;	set clock_db($type)  [filter_collection $master_ck "undefined(clocks)"] ; #set master_ck [remove_from_collection $master_ck $clock_db($type)]
	
	set temp_db0    $empty_collection
	set temp_db0_0  $empty_collection
	set temp_db0_1  $empty_collection

	set temp_db1_0  $empty_collection
	set temp_db1_1  $empty_collection

	set temp_db2    $empty_collection
	set temp_db2_0  $empty_collection
	set temp_db2_1  $empty_collection
	
	set out_0 [open "$outdir/$filter_tag.master.csv" w+] 
	set out_1 [open "$outdir/$filter_tag.func.csv"   w+] 
	set out_2 [open "$outdir/$filter_tag.dft.csv"    w+] 
	set out_3 [open "$outdir/$filter_tag.both.csv"   w+] 

	puts $out_0 "#Design,#Scenario,#Report_Tag,#Comment,#ClockPin,#Pin_Name,#Func_Clock,#DFT_Clock"
	puts $out_1 "#Design,#Scenario,#Report_Tag,#Comment,#ClockPin,#Pin_Name,#Clock"
	puts $out_2 "#Design,#Scenario,#Report_Tag,#Comment,#ClockPin,#Pin_Name,#Clock"
	puts $out_3 "#Design,#Scenario,#Report_Tag,#Comment,#ClockPin,#Pin_Name,#Clock"

	set func_cnt 0
	set dft_cnt 0
	set both_cnt 0

	foreach_in_collection xck $master_ck {
		# Pin
		set pin_name  [get_object_name $xck]

		set comment_func ""
		set comment_dft ""

		set is_ck_pin [get_attribute -quiet $xck is_clock_pin]
		set clocks  [get_attribute -quiet  $xck clocks]
		# Func Category
		set fclocks [sort_collection [remove_from_collection -intersect $clocks $valid_func_clocks] full_name]
		if {[sizeof_collection $fclocks] == 0  } {  
			set func_clock  "None"
		} else { 
			set func_clock  [join [lsort -unique [get_object_name $fclocks]] "|" ]
		}
		set comment_func [format "Func%03d" [sizeof_collection $fclocks]]

		# DFT Category
		set tclocks [sort_collection [remove_from_collection -intersect $clocks $valid_dft_clocks]  full_name]
		if {[sizeof_collection $tclocks] == 0  } {  
			set dft_clock  "None"
		} else { 
			set dft_clock  [join [lsort -unique [get_object_name $tclocks]] "|" ]
		}
		set comment_dft [format "DFT%03d" [sizeof_collection $tclocks]]
		
		set is_true_clock "ClockPin"
		if  { $is_ck_pin == "false" } { set is_true_clock "NonClockPin" }

		# Comment Process/Enhance
		if { [sizeof_collection $fclocks] == 0 && [sizeof_collection $tclocks] == 0 } {
			# Both Unclocked
			set comment_func "FAIL_Func"	
			set comment_dft  "FAIL_DFT"
		        puts $out_1 "$design_name,$scenario,$filter_tag,$comment_func,$is_true_clock,$pin_name,$func_clock"
		        puts $out_2 "$design_name,$scenario,$filter_tag,$comment_dft,$is_true_clock,$pin_name,$dft_clock"  
			puts $out_3 "$design_name,$scenario,$filter_tag,$comment_func/$comment_dft,$is_true_clock,$pin_name,$func_clock,$dft_clock"
			incr func_cnt
			incr dft_cnt
			incr both_cnt
		} elseif { [sizeof_collection $tclocks] == 0} {
			# Only DFT Unclocked 
			set comment_dft  "FAIL_DFT/PASS_$comment_func"
			puts $out_2 "$design_name,$scenario,$filter_tag,$comment_dft,$is_true_clock,$pin_name,$func_clock"
			incr dft_cnt
		} elseif { [sizeof_collection $fclocks] == 0 } {
			# Only Func Unclocked 
			set comment_func  "FAIL_Func/PASS_$comment_dft"
			puts $out_1 "$design_name,$scenario,$filter_tag,$comment_func,$is_true_clock,$pin_name,$dft_clock"
			incr func_cnt
		} 
		puts $out_0 "$design_name,$scenario,$filter_tag,$comment_func/$comment_dft,$is_true_clock,$pin_name,$func_clock,$dft_clock"

		if { [sizeof_collection $clocks] == 0 } {
			append_to_collection  	temp_db0 $xck
			if  { $is_ck_pin == "false" } { 
				append_to_collection  	temp_db0_0 $xck
			} else {
				append_to_collection  	temp_db0_1 $xck
			}
		} elseif { [sizeof_collection $clocks] == 1 } {
			if { [sizeof_collection [remove_from_collection $clocks $valid_dft_clocks]] } {
				append_to_collection  	temp_db1_0 $xck
			} else {
				append_to_collection  	temp_db1_1 $xck
			}
		} else {
			append_to_collection  	temp_db2 $xck
			if { [sizeof_collection [remove_from_collection -intersect $clocks $valid_func_clocks]] } {
				append_to_collection  	temp_db2_0 $xck
			}
			if { [sizeof_collection [remove_from_collection -intersect $clocks $valid_dft_clocks]] } {
				append_to_collection  	temp_db2_1 $xck
			}
		}
	}
	close $out_0
	close $out_1
	close $out_2
	close $out_3

	set type "03_DXNoClk_CK"  ;	set clock_db($type) $temp_db0_0  ; set master_ck [remove_from_collection $master_ck $clock_db($type)]
	set type "04_CKNoClk_CK"  ;	set clock_db($type) $temp_db0_1  ; set master_ck [remove_from_collection $master_ck $clock_db($type)]
	set type "05_OneFClk_CK"  ;	set clock_db($type) $temp_db1_0  ; set master_ck [remove_from_collection $master_ck $clock_db($type)]
	set type "06_OneTClk_CK"  ;	set clock_db($type) $temp_db1_1  ; set master_ck [remove_from_collection $master_ck $clock_db($type)]
	set type "07_ManyFClk_CK" ;	set clock_db($type) $temp_db2_0  ; set master_ck [remove_from_collection $master_ck $clock_db($type)]
	set type "08_ManyTClk_CK" ;	set clock_db($type) $temp_db2_1  ; set master_ck [remove_from_collection $master_ck $clock_db($type)]

	# Array Query
	foreach categ  [lsort [array names clock_db]] {
		autodesign_print_stage blue [format "            %-50s = %10s  (%0.3f percent)" "$categ" "[sizeof_collection $clock_db($categ)]" "[expr 100.0 * [sizeof_collection $clock_db($categ)]/$total_ck]"]
	}
	# OutLog Query
	set func_status  "([expr {ceil(100.0 * $func_cnt/$total_ck)}] percent)"
	set dft_status   "([expr {ceil(100.0 * $dft_cnt/$total_ck)}] percent)"

	set status [list Func/$func_cnt$func_status DFT/$dft_cnt$dft_status "<OUTDIR>/$filter_tag.func.csv" "<OUTDIR>/$filter_tag.dft.csv"]
	autodesign_print_stage blue [format "=============================================================================================" ]
	autodesign_print_stage red  [format "<SDC_GEN> : Completed Report Generation for  $design_name  $status"]
	autodesign_print_stage blue [format "            [file normalize $outdir/$filter_tag.master.csv]"]
	autodesign_print_stage blue [format "            [file normalize $outdir/$filter_tag.func.csv]"]
	autodesign_print_stage blue [format "            [file normalize $outdir/$filter_tag.dft.csv]"]
	autodesign_print_stage blue [format "            [file normalize $outdir/$filter_tag.both.csv]"]
	autodesign_print_stage blue [format "            <CMD> sh wc -l [file normalize $outdir]/$filter_tag.*"]
	autodesign_print_stage blue [format "=============================================================================================" ]
	return $status
}
##------------------------------------------------------------------
## ProcNameEnd    : autodesign_unclocked_registers
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : autodesign_validate_spec
## ProcArguments  : autodesign_validate_spec outdir
## ProcDependency : autodesign_print_stage , sh , autodesign_get_block_context , autodesign_get_clock_ports 
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc autodesign_validate_spec outdir {
	set design_name [get_object_name [current_design]]
	set outdir $outdir
	file mkdir $outdir
	set outdir [file normalize $outdir]
	autodesign_print_stage blue [format "\n\n=============================================================================================" ]
	autodesign_print_stage red  [format "<SDC_GEN> : Created o/p directory %s"  "$outdir"]
	set filter_tag "validate_spec"
	autodesign_print_stage blue [format "\n\n=============================================================================================" ]
	
	# Array Query
	array unset check_priority
        set check_priority(pll)        		[get_cells -of_object [get_pins -quiet -hier -filter "full_name=~*u_lcm_wrapper*u_lcm_core_pll*/u_pll/u_pll/FOUTPOSTDIV"]]
        set check_priority(fll)        		[get_cells -of_object [get_pins -quiet -hier -filter "full_name=~*u_lcm_wrapper*u_lcm_core/u_fll*/u_fll/fll_clk"]]
        set check_priority(lpcm)                [get_cells -quiet -hierarchical -filter  "ref_name=~*lpcm*wrapper && ref_name!~*mna* && full_name!~*mna*"]
        set check_priority(div_or)              [get_cells -quiet -hierarchical -filter "full_name=~*u_ck_or1/gpl_clk_or*/SIZEONLY_or"]
        set check_priority(occ_fast)            [get_cells -quiet -hierarchical -filter "full_name=~*u_lcm_core/u_occ_*/occ_csta_qual_fast_clock/SIZEONLY_latch_u0 || full_name=~*tessent_persistent_cell_csta_qual_fast_clock/SIZEONLY_latch_u0"]
        set check_priority(occ_slow)            [get_cells -quiet -hierarchical -filter "full_name=~*u_lcm_core/u_occ_*/occ_csta_qual_slow_clock/SIZEONLY_latch_u0 || full_name=~*tessent_persistent_cell_csta_qual_slow_clock/SIZEONLY_latch_u0"]
        set check_priority(occ_mux)             [get_cells -quiet -hierarchical -filter "full_name=~*tessent_persistent_cell_clock_out_mux/gpl_clk_mux/SIZEONLY_mux_u0 || full_name=~*u_lcm_core/u_occ_*/*u_gsl_clk_mux_1/gpl_clk_mux/SIZEONLY_mux_u0"]
        set check_priority(gl_mux)              [get_cells -quiet -hierarchical -filter "full_name=~*u_glitchless_clk_mux/or_u/*/gpl_clk_or[0]/SIZEONLY_or"]

	set status [list ]
	set pvt_corner "PVT_DEF"
	foreach categ  [lsort [array names check_priority]] {
		redirect -file $outdir/.$categ.raw.log {set result [autodesign_get_block_context    [get_pins -of_object $check_priority($categ) -filter "direction!=internal && direction!=inout" ]]}
		set pvt_corner [lindex $result 0]
		file copy -force [lindex $result 1] $outdir/$filter_tag.$categ.$pvt_corner.verbose.rpt
		catch { sh cat $outdir/$filter_tag.$categ.$pvt_corner.verbose.rpt | egrep -v 'DataPin' > $outdir/$filter_tag.$categ.$pvt_corner.rpt }
	        autodesign_print_stage blue [format "            Done %-20s : Cells=%-20s Size=%-s" "$categ" "[sizeof_collection $check_priority($categ)]" "[sh wc -l $outdir/$filter_tag.$categ.$pvt_corner.rpt]" ]
		set x ""
		if { [sizeof_collection $check_priority($categ)] == 0} { set x "Clean" }
		lappend status "$x/$categ:[sizeof_collection $check_priority($categ)],<OUTDIR>/$filter_tag.$categ.$pvt_corner.rpt"
	}
	# Array Query
	array unset check_port
        set check_port(clkport)    		[get_ports * -filter "is_clock_network==true"]
        set check_port(clksinks)   		[filter_collection [all_registers -clock_pins] "is_hierarchical==false && direction==in"]
        set check_port(clkport_likely) 	        [get_ports -quiet [all_fanin  -to $check_port(clksinks) -flat -startpoints_only]]
	set check_port(clkport_likelymiss)      [remove_from_collection $check_port(clkport_likely) $check_port(clkport)]
	set check_port(clkport_common)          [remove_from_collection -intersect $check_port(clkport_likely) $check_port(clkport)]
	set check_port(clkport_all)             [add_to_collection -unique $check_port(clkport) $check_port(clkport_likely)]
	

	set categ "clock_ports"
	set outf [open $outdir/$filter_tag.$categ.$pvt_corner.rpt w+]
	puts $outf "#PortName,#Comment,#Clock"
	set common_cnt 0
	set uncommon_cnt 0
	set missing_cnt 0
	foreach_in_collection x $check_port(clkport_all) {
		set port_name [get_object_name $x]
		set clocks    [get_object_name [get_attribute -quiet $x clocks]]
		set comment "NA"
		if { [sizeof_collection [remove_from_collection -intersect $x $check_port(clkport)]] } {
			if { [sizeof_collection [remove_from_collection -intersect $x $check_port(clkport_likely)]] } {
				set comment "Defined_Port_Clock_Common"
				incr common_cnt
			} else {
				set comment "Defined_Port_Clock_UnCommon"
				incr uncommon_cnt
			}
		} else {
			set comment "Possibly_Missing_Port_Clock"
			incr missing_cnt 
		}
		puts $outf "$port_name,$comment,$clocks"
	}
	close $outf
	lappend status "$categ:Defined=[sizeof_collection $check_port(clkport)]/Missed=$missing_cnt/Common=$common_cnt,<OUTDIR>/$filter_tag.$categ.$pvt_corner.rpt" 
	
	# Autodesign Verbose
	redirect -file $outdir/.categ.raw.log {set result [autodesign_get_clock_ports *]}
	file copy -force [lindex $result 0] $outdir/$filter_tag.$categ.$pvt_corner.verbose.rpt

	autodesign_print_stage blue [format "=============================================================================================" ]
	autodesign_print_stage red  [format "<SDC_GEN> : Completed Report Generation for  $design_name  $status"]
	foreach x $status {
		set datax [split $x ":"]
		autodesign_print_stage blue [format "              %-20s  %-30s  %s" [lindex $datax 0] [lindex $datax 1] [lindex $datax 2]]
	}
	autodesign_print_stage blue [format "            <CMD> sh wc -l [file normalize $outdir]/$filter_tag.*"]
	autodesign_print_stage blue [format "=============================================================================================" ]
	return $status
}
##------------------------------------------------------------------
## ProcNameEnd    : autodesign_validate_spec
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : bad_boyz
## ProcArguments  : bad_boyz cell_list slack_lesser_than
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc bad_boyz {cell_list slack_lesser_than} {
	set cells [get_cells -quiet -hierarchical [list $cell_list] -filter "is_hierarchical==false"]
 	set output_pins [get_pins -quiet -of_object $cells -filter "direction==out && max_slack <= $slack_lesser_than"]
 	set input_pins  [get_pins -quiet -of_object $cells -filter "direction==in && max_slack <= $slack_lesser_than && (is_rise_edge_triggered_data_pin==true || is_fall_edge_triggered_data_pin==true)"]
	puts "**Info : Outputs=[sizeof_collection $output_pins]"
	puts "**Info :  Inputs=[sizeof_collection $input_pins]"

	set all_pins    [add_to_collection $input_pins $output_pins]
	set outfile     "[pwd]/temp.eco.slack_lt.$slack_lesser_than.tcl"
	set outx [open $outfile w+]
	array unset eco_cells
	foreach_in_collection pin $all_pins {
		set cell_name [get_object_name [get_cells -of_object $pin]]
		set ref_name  [get_attribute   -quiet [get_cells $cell_name  ] ref_name]
		set max_slack [get_attribute   -quiet $pin max_slack]
		set min_slack [get_attribute   -quiet $pin min_slack]
		puts $outx " catch { size_cell $cell_name $ref_name } ; #OLD=$ref_name,SETUP=$max_slack,HOLD=$min_slack "
	}
	close $outx
	puts "**Open file :  $outfile"
}
##------------------------------------------------------------------
## ProcNameEnd    : bad_boyz
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : bad_boyz_dmsa
## ProcArguments  : bad_boyz_dmsa cell_list slack_lesser_than
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc bad_boyz_dmsa {cell_list slack_lesser_than} {
        set my_pwd [pwd]
        regsub -all { } [date] {_} datex
	set cmdx "remote_execute { set slave_pwd \[pwd\] ; file mkdir $my_pwd/badboyz_$datex/\$SCENARIO ; cd  $my_pwd/badboyz_$datex/\$SCENARIO ; bad_boyz $cell_list $slack_lesser_than ; cd \$slave_pwd }"
	eval $cmdx
}
