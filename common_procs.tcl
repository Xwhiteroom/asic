## ProcRenamed    : 0
##------------------------------------------------------------------
proc sswrp_map_hier blocks {
         global ss_module
         set  XDESIGN    [lindex [split [get_object_name [current_design]] "."] 0]
         foreach block $blocks {
              global  ${block}_hier
              regsub -all {\d+}   [lindex [get_object_name [get_cells -quiet -hier * -filter "ref_name=~ $block" ]] 0 ] {*} ss_module($block)
              if { $XDESIGN != "$block" } { set  ss_module($block)        "$ss_module($block)/"        }
              set ${block}_hier   $ss_module($block)
              puts    "**STA_SDC_INFO :: Design Hier Mapped  $block to ${block}_hier / ss_module($block) as $ss_module($block)"
          }
}
