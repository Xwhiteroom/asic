##------------------------------------------------------------------
## ProcNameStart  : autodesign_check_timing
## ProcArguments  : autodesign_check_timing outdir
## ProcDependency : autodesign_print_stage 
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc autodesign_check_timing outdir {
	set design_name [get_object_name [current_design]]
	set outdir $outdir
	file mkdir $outdir
	set outdir [file normalize $outdir]
	autodesign_print_stage blue [format "\n\n=============================================================================================" ]
	autodesign_print_stage red  [format "<SDC_GEN> : Created o/p directory %s"  "$outdir"]
	set filter_tag "check_timing"
	autodesign_print_stage blue [format "\n\n=============================================================================================" ]
	
	# Array Query
	array unset check_priority
        set check_priority(category_1) [list ideal_clocks generated_clocks unexpandable_clocks no_clock multiple_clock clock_crossing data_check_no_clock data_check_multiple_clock latency_override]
        set check_priority(category_2) [list loops generic no_driving_cell]
        set check_priority(category_3) [list no_input_delay partial_input_delay unconnected_pg_pins unconstrained_endpoints ]
        set check_priority(category_4) [list latch_fanout ms_separation retain]
        set check_priority(category_5) [list supply_net_voltage operating_conditions signal_level]
        set check_priority(category_6) [list pulse_clock_cell_type pulse_clock_non_pulse_clock_merge pulse_clock_no_pulse_generator pll_configuration]

	# Array Query
	foreach categ  [lsort [array names check_priority]] {
    		check_timing -override $check_priority($categ) -include $check_priority($categ) -verbose  > $outdir/$filter_tag.$categ.rpt
		autodesign_print_stage blue "           - Done $categ : $check_priority($categ)"
	}
	set result "CheckReports"
   	set status [list $result "<OUTDIR>/$filter_tag.category_*.rpt"]
	autodesign_print_stage blue [format "=============================================================================================" ]
	autodesign_print_stage red  [format "<SDC_GEN> : Completed Report Generation for  $design_name  $status"]
	autodesign_print_stage blue [format "            [file normalize $outdir/$filter_tag.rpt]"]
	autodesign_print_stage blue [format "            <CMD> sh wc -l [file normalize $outdir]/$filter_tag.*"]
	autodesign_print_stage blue [format "=============================================================================================" ]
	return $status
}
##------------------------------------------------------------------
## ProcNameEnd    : autodesign_check_timing
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : autodesign_clock_relations
## ProcArguments  : autodesign_clock_relations outdir
## ProcDependency : autodesign_print_stage , autodesign_get_clockgroup , sh 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc autodesign_clock_relations outdir {
	set design_name [get_object_name [current_design]]
	set outdir $outdir
	file mkdir $outdir
	set outdir [file normalize $outdir]
	autodesign_print_stage blue [format "\n\n=============================================================================================" ]
	autodesign_print_stage red  [format "<SDC_GEN> : Created o/p directory %s"  "$outdir"]
	set filter_tag "clock_relation"
	autodesign_print_stage blue [format "\n\n=============================================================================================" ]
	
	redirect -file $outdir/.$filter_tag.raw.log {set result [autodesign_get_clockgroup *]}
	file copy -force [lindex $result 1] $outdir/$filter_tag.rpt
	set status [list]
	set resultx ""
	foreach data_pt [lindex $result 0] {
		#lappend status "Group:$data_pt,<OUTDIR>/$filter_tag.rpt"
		set resultx "$resultx$data_pt"
	}
	regsub -all {_Review|_Waived| |^/} $resultx {} resultx
	regsub -all {=} $resultx {:} resultx

	lappend status "Group:$resultx,<OUTDIR>/$filter_tag.rpt"

	autodesign_print_stage blue [format "=============================================================================================" ]
	autodesign_print_stage red  [format "<SDC_GEN> : Completed Relationship Generation for  $design_name  $status"]
	foreach  data_pt [lindex $result 0] {
		set data_val [split $data_pt "="]
		autodesign_print_stage blue [format "            %-20s : Size=%-20s %-s" "[lindex $data_val 0]"  "[lindex $data_val 1]" "[sh wc -l $outdir/$filter_tag.verbose.rpt]" ]
	}
	autodesign_print_stage blue [format "            <CMD> sh wc -l [file normalize $outdir]/$filter_tag.*"]
	autodesign_print_stage blue [format "=============================================================================================" ]
	return $status
}
