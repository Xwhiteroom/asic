## ProcNameStart  : get_travel
## ProcArguments  : get_travel pin1 pin2 args
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc get_travel {pin1 pin2 args} {
             set x1       "0"
             set y1       "0"
             set x2       "0"
             set y2       "0"
             set diff_x   "0"
             set diff_y   "0"
             set diff     "0"
             set arrival  "0"
             set slack1   "0"
             set slack2   "0"
             set attr_name1 "coordinate"
             set attr_name2 "coordinate"
             set class      "pin"
             catch {set x1 [format "%0.0f" [expr [get_attr -quiet [get_pins $pin1] "x_$attr_name1"] / 1000]]}
             catch {set y1 [format "%0.0f" [expr [get_attr -quiet [get_pins $pin1] "y_$attr_name1"] / 1000]]}
             catch {set x2 [format "%0.0f" [expr [get_attr -quiet [get_pins $pin2] "x_$attr_name2"] / 1000]]}
             catch {set y2 [format "%0.0f" [expr [get_attr -quiet [get_pins $pin2] "y_$attr_name2"] / 1000]]}
             catch {set diff_x [ expr abs($x2 - $x1)]}
             catch {set diff_y [ expr abs($y2 - $y1)]}
             catch {set diff [expr $diff_x + $diff_y]}
             if { $args == ""} { 
                 set arrival1 [get_attr  -quiet [get_pins $pin1] max_arrival]
                 set arrival2 [get_attr  -quiet [get_pins $pin2] max_arrival]
                 set slack1   [get_attr  -quiet [get_pins $pin1] max_slack]
                 set slack2   [get_attr  -quiet [get_pins $pin2] max_slack]

                 catch { set arrival [ expr abs($arrival1 - $arrival2)] }
             }
             set output [format " %04d,%04d -> %04d,%04d  Length_MH=%04d (%04dx+%04dy) Delay=%3.3fps Slack=(%3.3f %3.3f)\t %-s" $x1 $y1 $x2 $y2 $diff $diff_x $diff_y $arrival $slack1 $slack2 " | get_travel $pin1 $pin2" ]
             #puts "$output"
             return $output 
}
##------------------------------------------------------------------
## ProcNameEnd    : get_travel
