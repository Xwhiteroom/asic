##------------------------------------------------------------------
## ProcNameStart  : pt_get_cell_bbox
## ProcArguments  : pt_get_cell_bbox cells factor_scale
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc pt_get_cell_bbox {cells factor_scale} {

	set cells [get_cells -quiet $cells]
	puts "<INFO> Cells found [sizeof_collection $cells]"
	set x_max_points [get_attribute $cells x_coordinate_max]
	set y_max_points [get_attribute $cells y_coordinate_max]
	set xmax         [format "%0.0f" [expr (0.0001 + [lindex [lsort -increasing $x_max_points] end]  +0.0001)/$factor_scale]]
	set xmin         [format "%0.0f" [expr (0.0001 + [lindex [lsort -increasing $x_max_points] 0]  +0.0001)/$factor_scale]]
	set ymax         [format "%0.0f" [expr (0.0001 + [lindex [lsort -increasing $y_max_points] end]  +0.0001)/$factor_scale]]
	set ymin         [format "%0.0f" [expr (0.0001 + [lindex [lsort -increasing $y_max_points] 0] +0.0001)/$factor_scale]]
	set data         [ list [format "%40s %40s %40s %40s %s" "#BBox_X/YMin" "#BBox_X/YMax" "#BBoxOrigin_X/Y" "#Actual_X/Y" "#Inst"]] 
	foreach_in_collection x $cells {
		set cname [get_object_name $x]
		set xname [format "%0.0f" [expr (0.0001 + [get_attribute $x x_coordinate_max] +0.0001)/$factor_scale]]
		set yname [format "%0.0f" [expr (0.0001 + [get_attribute $x y_coordinate_max] +0.0001)/$factor_scale]]
		set xname_offset [format "%0.0f" [expr (0.0001 + $xname - $xmin +0.0001)]]
		set yname_offset [format "%0.0f" [expr (0.0001 + $yname - $ymin +0.0001)]]

		lappend data [format "%40s %40s %40s %40s %s" "$xmin,$ymin" "$xmax,$ymax" "$xname_offset/$yname_offset" "$xname/$yname" "$cname"]		
	}
	echo "# BBoxc Data : " > info.temp.bbox.data.tcl
	foreach x $data { echo $x >>   info.temp.bbox.data.tcl}
	puts "<INFO> BBox Info : [file normalize info.temp.bbox.data.tcl]"
	return $data

}
##------------------------------------------------------------------
## ProcNameEnd    : pt_get_cell_bbox
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : pt_get_clock_target
## ProcArguments  : pt_get_clock_target pattern margin filex pba
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc pt_get_clock_target {pattern margin filex pba} { 
    global CORNER NETLISTS XCORNER ssi_sta_tool_unit_dly
    puts  [format "    %40s %40s %15s %15s %10s %10s %10s  %40s" "#CORNER" "#CLOCK" "#FREQ(Target)" "#FREQ($XCORNER)" "#SLACK(S)" "#SLACK(H)" "PERIOD" "#R2R/F2F/F2R/R2F_SETUP" ]     
    echo "[format "    %40s %40s %15s %15s %10s %10s %10s  %40s" "#CORNER" "#CLOCK" "#FREQ(Target)" "#FREQ($XCORNER)" "#SLACK(S)" "#SLACK(H)" "PERIOD" "#R2R/F2F/F2R/R2F_SETUP"]" >  $filex    
    #set def_sig [get_app_var report_default_significant_digits]
    #set_app_var report_default_significant_digits 3     
    foreach_in_collection clk [get_clocks $pattern] { 
        set clkx [get_object_name $clk];
        set pathH  [get_timing_paths -to $clk -max_path 1 -delay min -pba_mode $pba ]];        
        set pathS1 [get_timing_paths -rise_from $clk -rise_to $clk -max_path 1 -delay max -pba_mode $pba ];
        set pathS2 [get_timing_paths -fall_from $clk -fall_to $clk -max_path 1 -delay max -pba_mode $pba ];
        set pathS3 [get_timing_paths -fall_from $clk -rise_to $clk -max_path 1 -delay max -pba_mode $pba ];
        set pathS4 [get_timing_paths -rise_from $clk -fall_to $clk -max_path 1 -delay max -pba_mode $pba ];

        set period [get_attr $clk period]; 
        set slackH [get_attr $pathH slack];

        set slackS1 [get_attr $pathS1 slack];
        set slackS2 [get_attr $pathS2 slack];
        set slackS3 [get_attr $pathS3 slack];
        set slackS4 [get_attr $pathS4 slack];
        if { $slackS1 == "" } { set slackS1 0.000 }
        if { $slackS2 == "" } { set slackS2 0.000 }
        if { $slackS3 == "" } { set slackS3 0.000 }
        if { $slackS4 == "" } { set slackS4 0.000 }
        set slack_all_setup "$slackS1/$slackS2/$slackS3/$slackS4"
        if { $slackS3 < 0 && $slackS3 != ""  } { set slackS3 [expr 2 * $slackS3] }
        if { $slackS4 < 0 && $slackS4 != ""  } { set slackS4 [expr 2 * $slackS4] }
        set slackS 0
        if { $slackS > $slackS1 } { set slackS $slackS1}
        if { $slackS > $slackS2 } { set slackS $slackS2}
        if { $slackS > $slackS3 } { set slackS $slackS3}
        if { $slackS > $slackS4 } { set slackS $slackS4}


        set freq_ideal [expr $ssi_sta_tool_unit_dly/($period + 0)];


        set freq [expr $ssi_sta_tool_unit_dly/($period + $margin)];

        if { $slackS < 0 } { set freq [expr $ssi_sta_tool_unit_dly/($period - $slackS + $margin)] }
        puts  [format "    %40s %40s %15.0f %15.0f %10s %10s %10s %40s" $CORNER $clkx $freq_ideal $freq $slackS $slackH $period $slack_all_setup] 
        echo "[format "    %40s %40s %15.0f %15.0f %10s %10s %10s %40s" $CORNER $clkx $freq_ideal $freq $slackS $slackH $period $slack_all_setup]" >>  $filex
    }
    #set_app_var report_default_significant_digits $def_sig       
}
##------------------------------------------------------------------
## ProcNameEnd    : pt_get_clock_target
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : pt_get_donttouch
## ProcArguments  : pt_get_donttouch dir tag
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc pt_get_donttouch {dir tag} {
    set cmdx "set dt_cells \[get_object_name  \[get_cells -hier -quiet  * -filter \"dont_touch==true && is_hierarchical==false\"\]\]"
    set cmdx "$cmdx ; set dt_nets \[get_object_name  \[get_nets -hier -quiet  * -filter \"dont_touch==true\"\]\]"
    set cmdx "remote_execute { $cmdx ; }"
    puts "<CMD> $cmdx"
    eval "$cmdx"

    eval "catch { unset    dt_cells} ; get_distributed_variables    dt_cells -merge_type unique_list"
    eval "catch { unset    dt_nets}  ; get_distributed_variables    dt_nets -merge_type unique_list"

    file mkdir $dir/dont_touch_use
    set out [open $dir/dont_touch_use/$tag.DT w+]
    foreach cell ${dt_cells}    { puts $out "$cell,DONTTOUCH,Cell" }
    foreach net ${dt_nets}    { puts $out "$net,DONTTOUCH,Net" }


    close $out
    puts " --    DT CELLS :    dt_cells=[llength ${dt_cells}]"
    puts " --    DT  NETS :    dt_nets=[llength ${dt_nets}]"
    puts " -- FILE  LIST  :  $dir/dont_touch_use/$tag.DT"
  }
##------------------------------------------------------------------
## ProcNameEnd    : pt_get_donttouch
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : pt_get_dontuse_lib
## ProcArguments  : pt_get_dontuse_lib dir tag
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc pt_get_dontuse_lib {dir tag} {
    ## DU Pattern
    global GC_STA_ECO_TECH    
    set cmdx "set du_cells \[get_attr -quiet  \[get_lib_cells -quiet  */* -filter \"dont_use==true\"\] base_name\]"
    set cmdx "$cmdx ; set nondu_cells \[get_attr -quiet  \[get_lib_cells -quiet  */* -filter \"dont_use==false\"\] base_name\]"
    set cmdx "remote_execute { $cmdx ; }"
    puts "<CMD> $cmdx"
    eval "$cmdx"

    eval "catch { unset    du_cells} ; get_distributed_variables    du_cells -merge_type unique_list"
    eval "catch { unset nondu_cells} ; get_distributed_variables nondu_cells -merge_type unique_list"
    file mkdir $dir/dont_touch_use
    set out [open $dir/dont_touch_use/$tag.DU w+]
    foreach cell ${du_cells}    { puts $out "$cell,DONTUSE" }
    foreach cell ${nondu_cells} { puts $out "$cell,USE" }
    close $out
    puts " --    DU CELLS :    du_cells=[llength ${du_cells}]"
    puts " -- NONDU CELLS : nondu_cells=[llength ${nondu_cells}]"
    puts " -- FILE  LIST  :  $dir/dont_touch_use/$tag.DUC"
  }
