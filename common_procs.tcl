##------------------------------------------------------------------
## ProcNameStart  : sta_qc_get_clock_target
## ProcArguments  : sta_qc_get_clock_target pattern margin
## ProcDependency :  
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qc_get_clock_target {pattern margin} {
    global CORNER ssi_sta_tool_unit_dly
    puts [format "    %40s %40s %10s %10s %10s" "#CORNER" "#CLOCK" "#FREQ" "#SLACK" "PERIOD" ]     
    foreach_in_collection clk [get_clocks $pattern] { 
        set clkx [get_object_name $clk];
        set path [get_timing_paths -to $clk -max_path 1];
        set slack [get_attr $path slack];
        set period [get_attr $clk period]; 
        set freq [expr $ssi_sta_tool_unit_dly/($period + $margin)];
        if { $slack < 0 } { set freq [expr $ssi_sta_tool_unit_dly/($period - $slack + $margin)] }
        puts [format "    %40s %40s %10.0f %10s %10s" $CORNER $clkx $freq $slack $period] 
    }

}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qc_get_clock_target
