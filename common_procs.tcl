##------------------------------------------------------------------
## ProcNameStart  : sta_qual_report_summary_powerswitch_new
## ProcArguments  : sta_qual_report_summary_powerswitch_new args
## ProcDependency : ls 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_report_summary_powerswitch_new args {
    global CORNER MODE

    parse_proc_arguments -args $args proc_x_args
    foreach x [array names proc_x_args] {
      regsub -all {\-} $x {} y
      set inputs($y) $proc_x_args($x)
    }
    #set power_pairs [list PWRDOWNPRE_CPU0:PGTESTOUTPRE_CPU0:AN0 PWRDOWNPRE_CPU1:PGTESTOUTPRE_CPU1:AN1 PWRDOWNPRE_CPU2:PGTESTOUTPRE_CPU2:AN2 PWRDOWNPRE_CPU3:PGTESTOUTPRE_CPU3:AN3 PWRDOWNPRE_CPU4:PGTESTOUTPRE_CPU4:EN4 PWRDOWNPRE_CPU5:PGTESTOUTPRE_CPU5:EN5 PWRDOWNPRE_CPU6:PGTESTOUTPRE_CPU6:HE6 PWRDOWNPRE_CPU7:PGTESTOUTPRE_CPU7:HE7 ]
    set  path_collection_max [remove_from_collection [get_clocks *] [get_clocks *]]
    set  path_collection_min [remove_from_collection [get_clocks *] [get_clocks *]]

    set  trickle_max [remove_from_collection [get_clocks *] [get_clocks *]]
    set  trickle_min [remove_from_collection [get_clocks *] [get_clocks *]]

    set  hammer_max [remove_from_collection [get_clocks *] [get_clocks *]]
    set  hammer_min [remove_from_collection [get_clocks *] [get_clocks *]]

    set  memory_max [remove_from_collection [get_clocks *] [get_clocks *]]
    set  memory_min [remove_from_collection [get_clocks *] [get_clocks *]]

    set  my_design [get_object_name [current_design] ]

    set  report_dir "power_switch_latency.$my_design.$MODE.$CORNER"
    set rep_dir [file normalize $inputs(rep_dir)]/${report_dir}
    #set  report_dir [file normalize "."]
    file mkdir $rep_dir
    #set  report_dir [file normalize [ls [pwd]/$report_dir -d ]]
    set  report_tag "$my_design.$MODE.$CORNER.misc.pwrswtlatency"

    set power_pairs $inputs(power_pairs)

    set out [open "$rep_dir/$report_tag.csv" w+]
    puts $out "ID,BLOCK,INPORT,OUTPORT,MAX,MIN,CORNER"

    set unconstrained_paths [get_app_var timing_report_unconstrained_paths]
    set_app_var timing_report_unconstrained_paths true

    foreach port_pair $power_pairs {
      set portin   [lindex [split $port_pair ":"] 0]
      set portout  [lindex [split $port_pair ":"] 1]
      set CORE     [string tolower [lindex [split $port_pair ":"] 2]]

      if {[sizeof_collection [get_ports -quiet $portin]]} {
        set in_type "port"
      } elseif {[sizeof_collection [get_pins -quiet $portin]]} {
        set in_type "pin"
      } else {
        set in_type "NA"
      }
      if {[sizeof_collection [get_ports -quiet $portout]]} {
        set out_type "port"
      } elseif {[sizeof_collection [get_pins -quiet $portout]]} {
        set out_type "pin"
      } else {
        set out_type "NA"
      }

      if { $in_type != "NA" && $out_type != "NA" } {
        set path_max [get_timing_paths -from [get_${in_type} -quiet $portin] -to [get_${out_type} -quiet $portout] -delay max]
        set path_min [get_timing_paths -from [get_${in_type} -quiet $portin] -to [get_${out_type} -quiet $portout] -delay min]
        set max_arr [get_attr -quiet $path_max arrival]
        set min_arr [get_attr -quiet $path_min arrival]
        puts "**Info: Found Port Pair : $port_pair | Arr=$max_arr/$min_arr"

        set path_collection_max [add_to_collection $path_collection_max $path_max]
        set path_collection_min [add_to_collection $path_collection_min $path_min]

        if {[regexp "trickle" $CORE]} {
          set trickle_max [add_to_collection $trickle_max $path_max]
          set trickle_min [add_to_collection $trickle_min $path_min]
        } elseif {[regexp "hammer" $CORE]} {
          set hammer_max [add_to_collection $hammer_max $path_max]
          set hammer_min [add_to_collection $hammer_min $path_min]
        } elseif {[regexp "memorychain" $CORE]} {
          set memory_max [add_to_collection $memory_max $path_max]
          set memory_min [add_to_collection $memory_min $path_min]
        }
      } else {
        puts "**Warn: Missing Port Pair : $port_pair"
        set max_arr NA
        set min_arr NA
      }
      puts $out "$port_pair,$CORE,$portin,$portout,$max_arr,$min_arr,$MODE.$CORNER"

    }
    close $out
    report_timing -nosplit  -input -voltage -tran -cap $path_collection_max > $rep_dir/$report_tag.max.rpt
    report_timing -nosplit  -input -voltage -tran -cap $path_collection_min > $rep_dir/$report_tag.min.rpt

    report_timing -nosplit  -input -voltage -tran -cap $trickle_max > $rep_dir/$report_tag.trickle.max.rpt
    report_timing -nosplit  -input -voltage -tran -cap $trickle_min > $rep_dir/$report_tag.trickle.min.rpt
    report_timing -nosplit  -input -voltage -tran -cap $hammer_max > $rep_dir/$report_tag.hammer.max.rpt
    report_timing -nosplit  -input -voltage -tran -cap $hammer_min > $rep_dir/$report_tag.hammer.min.rpt
    report_timing -nosplit  -input -voltage -tran -cap $memory_max > $rep_dir/$report_tag.memorychain.max.rpt
    report_timing -nosplit  -input -voltage -tran -cap $memory_min > $rep_dir/$report_tag.memorychain.min.rpt

    set_app_var timing_report_unconstrained_paths $unconstrained_paths
}
