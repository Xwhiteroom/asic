##------------------------------------------------------------------
## ProcNameStart  : inv_profile_path_collection
## ProcArguments  : inv_profile_path_collection outdir tag slack max_min path_collection
## ProcDependency : pt_path_id_map_loop , get_proc_def , inv_path_id_map_loop 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc inv_profile_path_collection {outdir tag slack max_min path_collection} {
	file mkdir 		$outdir
	set  tdir          	$outdir/$tag
	file mkdir        	$tdir
	set  path_rpt_dir 	$tdir/post_process
	file mkdir        	$tdir/post_process/innovus
	set  scripts_dir 	$tdir/scripts
	file mkdir        	$tdir/scripts
	
	# Debug Control
	set debug 0

	set  empty_collection   [remove_from_collection [all_clocks] [all_clocks]]
	
	set  path_collection_valid_path      [filter_collection $path_collection "path_type==$max_min"]
	set  path_collection_valid_pathslack [filter_collection $path_collection_valid_path "slack<=$slack"]
  	# Path Filtering
	puts "\n\n"
	puts "<Dir Created>      : $tdir"
	puts "<Timing     Target>: Setup/Hold=$max_min Slack_Less_Than=$slack"
	puts "<Timing     Target>: TotalPaths=[sizeof_collection $path_collection]"
	puts "<Timing     Target>: TotalPaths\[$max_min\]=[sizeof_collection $path_collection_valid_path]"
	puts "<Timing     Target>: TotalPaths\[$max_min.Slack_Lt_$slack\]=[sizeof_collection $path_collection_valid_pathslack]"
 
	# Path Dumping
	#set paths [sort_collection $path_collection_valid_pathslack slack]
	set paths $path_collection_valid_pathslack
	
	set i 0
	set j 0

	set summary  "$path_rpt_dir/$tag.innovus.$max_min.$slack.summary.csv"
	set node_csv "$path_rpt_dir/$tag.innovus.$max_min.$slack.node_data.csv"
	set pt_tcl  "$scripts_dir/$tag.$max_min.$slack.primetime_gen_data.tcl"
	set pt_db    "$scripts_dir/$tag.$max_min.$slack.innovus_import_data.tcl"

	set out1 [open $summary w+]
	set out2 [open $node_csv w+]
	set out3 [open $pt_tcl  w+]
	set out4 [open $pt_db  w+]

	# Procs
	set procs_list [list ]
        lappend  procs_list get_proc_def 
	lappend  procs_list get_path_node_trace_list 
	lappend  procs_list pt_profile_path_collection
	lappend  procs_list inv_profile_path_collection 
	lappend  procs_list xreport_timing 
	lappend  procs_list inv_xreport_timing  
	lappend  procs_list pt_timing_points_split 
	lappend  procs_list inv_timing_points_split 
	lappend  procs_list pt_path_id_map_loop 
	lappend  procs_list inv_path_id_map_loop

	foreach procx $procs_list {
	    set datap ""
            catch { set datap [get_proc_def $procx] }
            if { $datap != "" } {
                puts $out3 "##------------------------------------------------------------------"
                puts $out3 "## ProcNameStart : $procx"
                puts $out3 "##------------------------------------------------------------------"
                puts $out3 $datap
	    }
	}
        puts $out3 "##------------------------------------------------------------------"        
	puts $out3 "## Set Directory Setup"
        puts $out3 "##------------------------------------------------------------------"        
        puts $out3  "    set outdir           [file normalize $tdir]"
        puts $out3  "    file mkdir           \$outdir/post_process/primetime"
        puts $out3  "    file mkdir           \$outdir/post_process/innovus"
        puts $out3  "    catch { exec ln -sn \$outdir . }"
	puts $out3  "    puts \"\""
	puts $out3  "    puts \"\""
        puts $out3  "    puts  \"<INFO> : Linked Reports Directory : \$outdir\"\n\n"

        puts $out3 "##------------------------------------------------------------------"        
	puts $out3 "## Set Init Collection For Primetime"
        puts $out3 "##------------------------------------------------------------------"   
	puts $out3  "    set empty_collection \[remove_from_collection \[all_clock\] \[all_clocks\]\]"
        puts $out3  "    array unset 		primetime_paths_arr"
        puts $out3  "    array unset 		pt_node_arr"
        puts $out3  "    array unset 		pt_summary_arr"
        puts $out3  "    array unset 		pt_pin_arr"
        puts $out3  "    array unset 		pt_missed_arr"
        puts $out3  "    array unset 		inv_node_arr"
        puts $out3  "    array unset 		inv_summary_arr"
        puts $out3  "    array unset 		inv_pin_arr"
        puts $out3  "    array unset 		inv_missed_arr"
        puts $out3  "    set primetime_paths 	\$empty_collection\n\n"

        puts $out3 "##------------------------------------------------------------------"        
	puts $out3 "## Profile Paths"
        puts $out3 "##------------------------------------------------------------------"   
        puts $out3 "    set j 0"   
	puts $out3 "    set summary           \"\$outdir/post_process/$tag.primetime.$max_min.$slack.summary.csv\""
	puts $out3 "    set node_csv          \"\$outdir/post_process/$tag.primetime.$max_min.$slack.node_data.csv\""
	puts $out3 "    set primetime_db      \"\$outdir/scripts/$tag.$max_min.$slack.primetime_import_data.tcl\""
	puts $out3 "    set delta_summary_csv \"\$outdir/post_process/$tag.pt_vs_inv.$max_min.$slack.summary.csv\""
	puts $out3 "    set delta_node_csv    \"\$outdir/post_process/$tag.pt_vs_inv.$max_min.$slack.node_data.csv\""


	puts $out3 "    set out1 \[open \$summary w+\]"
	puts $out3 "    set out2 \[open \$node_csv w+\]"
	puts $out3 "    set out3 \[open \$primetime_db w+\]"
	puts $out3 "    set out4 \[open \$delta_summary_csv w+\]"
	puts $out3 "    set out5 \[open \$delta_node_csv w+\]"
        puts $out3 "    puts \$out3 \"##------------------------------------------------------------------\""        
	puts $out3 "    puts \$out3 \"## PT Import DB\""
        puts $out3 "    puts \$out3 \"##------------------------------------------------------------------\""  
        puts $out3 "    puts \$out3 \"    set outdir            [file normalize $tdir]\""
        puts $out3 "    puts \$out3 \"    array unset 		pt_node_arr\""
        puts $out3 "    puts \$out3 \"    array unset 		pt_summary_arr\""
        puts $out3 "    puts \$out3 \"##------------------------------------------------------------------\""    

        puts $out4 "##------------------------------------------------------------------"        
	puts $out4 "## INV Import DB"
        puts $out4 "##------------------------------------------------------------------"  
        puts $out4  "    set outdir             [file normalize $tdir]"   
        puts $out4  "    array unset 		inv_node_arr"
        puts $out4  "    array unset 		inv_summary_arr"
        puts $out4 "##------------------------------------------------------------------"     


	puts "<Timing     PathCh>: Begin Path Parsing Loop [sizeof_collection $paths]"
	foreach_in_collection path $paths {
    		set idx [format "ID%08d" $i]
    		incr i
    		set spoint   [get_object_name [get_attr $path launching_point]]
    		set epoint   [get_object_name [get_attr $path capturing_point]]
                set slk_type [get_attr -quiet $path path_type]
		if { $slk_type == "max" } { 
			set report_type " -delay max " 
		} else { 
			set report_type " -delay min " 
		}
    		set slack    [get_attr $path slack]
	        set inv_filex   [file normalize $tdir]/post_process/innovus/${max_min}path.$idx.txt 
		
                # Extract INV Path Summary
                set mapped_path_data            [inv_path_id_map_loop $path $idx $inv_filex $j] 
       		set j                           [lindex $mapped_path_data 0]
       		set inv_summary_head            [lindex $mapped_path_data 1]
       		set inv_summary_data            [lindex $mapped_path_data 2]
       		set inv_node_datalist           [lindex $mapped_path_data 3]
		set expected_node_offset        $j
                # Stream INV Header Summary
		if { $i == 1 } {
			puts $out1 "$inv_summary_head" 
			puts $out3  "    set inv_summary_arr([format "ID%08d" -1])  \"$inv_summary_head\""
			puts $out3  "    set pt_summary_arr([format "ID%08d" -1])  \"$inv_summary_head\""
	    	        puts $out3  "    puts \$out1 \"$inv_summary_head\""
	    	        puts $out3  "    puts \$out3 \"set pt_summary_arr([format "ID%08d" -1]) $inv_summary_head\""
                        puts $out3  "    regsub -all {\[^,|#\]} \$pt_summary_arr([format "ID%08d" -1]) {} missing_data_string\n\n"
			puts $out4  "    set inv_summary_arr([format "ID%08d" -1])  \"$inv_summary_head\""
		}
		if { $debug } { puts "                 <Debug>: $idx Path Header Extracted" }

                # Stream INV Data Summary
		puts $out1 "$inv_summary_data"
		if { $debug } { puts "                 <Debug>: $idx Path Summary Extracted" }
      	        puts $out4  "\n    set inv_summary_arr($idx)  \"$inv_summary_data\""

                # Stream INV Node Summary
       		foreach x $inv_node_datalist {
         		puts $out2 "$x"
      	                puts $out3  "    set inv_node_arr($idx.[lindex [split $x ","] end])  \"$x\""
      	                puts $out4  "    set inv_node_arr($idx.[lindex [split $x ","] end])  \"$x\""

       		}
		if { $debug } { puts "                 <Debug>: $idx Path Node Extracted" }

                puts $out3  "\n    #Path ID=$idx"
		puts $out3  "    set pt_filex  \$outdir/post_process/primetime/${max_min}path.$idx.txt"
		puts $out3  "    set primetime_paths_arr($idx)  \[get_timing_path $report_type -slack_lesser_than 20 -path_type full_clock_expanded [lindex [split $inv_summary_data ","] end] \]"
		puts $out3  "    if { \[sizeof_collection \$primetime_paths_arr($idx)\] } {"
                puts $out3  "       append_to_collection primetime_paths \$primetime_paths_arr($idx)"
                #puts $out3  "       #puts \" Dumped $idx Lines=\[lindex \[exec wc -l  \$pt_filex\] 0\]\""
                puts $out3  "       set mapped_path_data            \[pt_path_id_map_loop \$primetime_paths_arr($idx) $idx \$pt_filex \$j\] "
  		puts $out3  "       set j                           \[lindex \$mapped_path_data 0\]"
  		puts $out3  "       set pt_summary_head            \[lindex \$mapped_path_data 1\]"
  		puts $out3  "       set pt_summary_arr($idx) \[lindex \$mapped_path_data 2\]"
  		puts $out3  "       set pt_node_datalist           \[lindex \$mapped_path_data 3\]"
	    	puts $out3  "       puts \$out3 \"\\nset pt_summary_arr($idx) \$pt_summary_arr($idx)\""
                puts $out3  "       foreach x \$pt_node_datalist {"
      	        puts $out3  "         set pt_node_arr($idx.\[lindex \[split \$x \",\"\] end\])  \"\$x\""
      	        puts $out3  "         set pt_pin_arr(\[lindex \[split \$x \",\"\] end\])        $idx"
		puts $out3  "         puts \$out2 \"\$x\""
	    	puts $out3  "         puts \$out3 \"set pt_node_arr($idx.\[lindex \[split \$x \",\"\] end\]) \$x\""
                puts $out3  "       }"    
		puts $out3  "       puts \$out1 \"\$pt_summary_arr($idx)\""
 
                puts $out3  "    } else {"
                puts $out3  "       puts \"       -- Skipped ID=$idx | Node Offset = $expected_node_offset / Present=\$j\""
                puts $out3  "       set j $expected_node_offset"
                puts $out3  "       regsub -all {^#,#,} \$missing_data_string \"#Missing,$idx,\" missing_data"
                puts $out3  "       puts \$out1 \"\$missing_data\""
                puts $out3  "       set  pt_missed_arr($idx) \"\$missing_data\""
                puts $out3  "    }"
      	        puts $out3  "    set inv_summary_arr($idx)  \"$inv_summary_data\"\n"

		if { $debug } { puts "                 <Debug>: $idx Path Innovus Code Completed" }

		
	}

        puts $out3 "##------------------------------------------------------------------"        
	puts $out3 "## Correlate"
        puts $out3 "##------------------------------------------------------------------"   
        puts $out3 "\n\n"
        puts $out3 "      set pt_summary_idx   \[array names pt_summary_arr\]"
        puts $out3 "      set pt_node_idx      \[array names pt_node_arr\]"
        puts $out3 "      set pt_miss_idx      \[array names pt_missed_arr\]"
        puts $out3 "      set inv_summary_idx  \[array names inv_summary_arr\]"
        puts $out3 "      set inv_node_idx     \[array names inv_node_arr\]"
        puts $out3 "      set inv_miss_idx     \[array names inv_missed_arr\]"
	puts $out3 ""
	puts $out3 "      set common_summary_idx \[list\]"     
	puts $out3 "      foreach idx \[lsort \[array names inv_summary_arr\]\] {"
	puts $out3 "        set pt_data \$pt_summary_arr(\$idx)"
	puts $out3 "        set inv_data \$inv_summary_arr(\$idx)"
        #File,#PathID,#Slack,#Freq,#Period_Window,#Margin,#Data,#Data(RC),#Data(Si),#Data(Cell),#Data(LibReqd),#Data(Stages),#Data(XY),#Clock(Skew),#Clock(Si),#ClockLat(Start),#ClockLat(End),#Clock(CRPR),#ClockStages(Common),#ClockStages(Launch),#ClockStages(Capture),#ClockXY(Common),#ClockXY(Launch),#ClockXY(Capture),#ImbalanceStages,#Start,#End,#ClockBranch,#ClockLaunch,#ClockCapture,#PathTrace
	puts $out3 "        regsub -all {#} \$pt_data  {#PT_}  pt_data   ; set pt_arr   \[split \$pt_data  \",\"\] ; set pt_valid  \[lrange \$pt_arr  2 27\];"
	puts $out3 "        regsub -all {#} \$inv_data {#INV_} inv_data  ; set inv_arr  \[split \$inv_data \",\"\] ; set inv_valid \[lrange \$inv_arr 2 27\];"
	puts $out3 "        set csv_data  \"\$idx\""
	puts $out3 "        regsub {ID-0000001} \$csv_data \"#PathID\" csv_data"
	puts $out3 "        foreach pt_attr \$pt_valid  inv_attr \$inv_valid {"
	puts $out3 "            set csv_data \"\$csv_data,\$pt_attr,\$inv_attr\""
	puts $out3 "        }\n"
	puts $out3 "        lappend common_summary_idx \"\$csv_data\""
	puts $out3 "        puts \$out4 \"\$csv_data\""
	puts $out3 "      }\n\n"

	puts $out3 "      set common_summary_idx \[list\]"     
	puts $out3 "      foreach idx \[lsort \[array names inv_node_arr\]\] {"
	puts $out3 "        set pt_data \$pt_node_arr(\$idx)"
	puts $out3 "        set inv_data \$inv_node_arr(\$idx)"
#File,#PathID,#GrossIndex,#Slack,#Index,#Direction,#Delay,#Transition,#Xtlk,#Capacitance(Pin),#Capacitance(Net),#Resistance(Net),#Length(Net),#Cell,#Derate,#Node
	puts $out3 "        regsub -all {#} \$pt_data  {#PT_}  pt_data   ; set pt_arr   \[split \$pt_data  \",\"\] ; set pt_valid  \[lrange \$pt_arr  2 end\];"
	puts $out3 "        regsub -all {#} \$inv_data {#INV_} inv_data  ; set inv_arr  \[split \$inv_data \",\"\] ; set inv_valid \[lrange \$inv_arr 2 end\];"
	puts $out3 "        set csv_data  \"\$idx\""
	puts $out3 "        regsub {ID00000000.#Node} \$csv_data \"#PathID.#Node\" csv_data"
	puts $out3 "        foreach pt_attr \$pt_valid  inv_attr \$inv_valid {"
	puts $out3 "            set csv_data \"\$csv_data,\$pt_attr,\$inv_attr\""
	puts $out3 "        }\n"
	puts $out3 "        lappend common_summary_idx \"\$csv_data\""
	puts $out3 "        puts \$out5 \"\$csv_data\""
	puts $out3 "      }\n\n"



        puts $out3 "      close \$out1"
        puts $out3 "      close \$out2"
        puts $out3 "      close \$out3"
        puts $out3 "      close \$out4"
        puts $out3 "      close \$out5"




	puts $out3 "      puts \"\""
	puts $out3 "      puts \"\""
	puts $out3 "      puts \[format  \"<INFO> :  %10s  %10s   %10s  %10s\"\ \"#Tool\"   \"#Paths\"  \"#Nodes\"    \"#Misses\" \]"
	puts $out3 "      puts \[format  \"          %10s  %10s   %10s  %10s\"\ \"PrimeTime\"   \"\[llength \$pt_summary_idx\]\"  \"\[llength \$pt_node_idx\]\"    \"\[llength \$pt_miss_idx\]\"\]"
	puts $out3 "      puts \[format  \"          %10s  %10s   %10s  %10s\"\ \"Innovus\"     \"\[llength \$inv_summary_idx\]\" \"\[llength \$inv_node_idx\]\"   \"\[llength \$inv_miss_idx\]\"\]"
	puts $out3 "      puts \"\""
	puts $out3 "      puts \"\""
	puts $out3 "      puts \"<INFO> :  Final Comparison Data Dumped :\""
	puts $out3 "      puts \"          - \$delta_summary_csv\""
	puts $out3 "      puts \"          - \$delta_node_csv\""
	puts $out3 "      puts \"\""


	
        puts $out3 "##------------------------------------------------------------------"        
	puts $out3 "## Summarize"
        puts $out3 "##------------------------------------------------------------------"   
	puts $out3 "\n    puts \"<INFO> : Valid  Paths Found     = \[sizeof_collection \$primetime_paths \] / Commits = [sizeof_collection $paths ]\""
	puts $out3 "\n    puts \"<INFO> : Valid  Paths Directory = \$outdir/post_process\""
        puts $out3 "\n\n"


	close $out1
	close $out2
	close $out3
	close $out4


	puts "<File Dir>  :  [file normalize $tdir]/${max_min}path.*.txt"
	puts "<File CSV>  :  $summary"
	puts "<File CSV>  :  $node_csv"
	puts "<File TCL>  :  $pt_tcl"
	puts "<File DB>   :  $pt_db"

}
