##------------------------------------------------------------------
## ProcNameStart  : add_annotation_for_vio
## ProcArguments  : add_annotation_for_vio filex
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc add_annotation_for_vio filex {
    set outfile "$filex.non_ideal_net_aware.rpt"
    set inx  [open $filex]
    set outx [open $outfile w+]
    array unset pin_slack


    puts $outx  "set non_ideal_nets \[list \\"
    while { [gets $inx line] >= 0 } {
        if {![regexp "VIO=" $line]} {
            set slack [lindex $line 0]
            set pin   [lindex $line 1]
            set net   [get_object_name [get_nets [all_connected $pin]] ]
            set pin_slack($pin) $slack


            if { [get_attr [get_nets $net ] is_ideal] == "true"} { 
                regsub -all {\[} $net  {\\[} net
                regsub -all {\]} $net  {\\]} net
                puts $outx "$net \\" 
            }
                
        }
    }
    puts $outx  "]"
    puts $outx  "if { \[llength \$non_ideal_nets \] > 0 } { remove_ideal_network \[get_nets \$non_ideal_nets\] }"

    foreach pin [array names pin_slack] {
        regsub -all {\-} $pin_slack($pin) {} slack_p
        regsub -all {\[} $pin  {\\[} pin
        regsub -all {\]} $pin  {\\]} pin
        puts $outx  "add_delay_ex 0.030 $slack_p $pin" 
    }
    close $inx
    close $outx
    puts "Open : $outfile"
}
##------------------------------------------------------------------
## ProcNameEnd    : add_annotation_for_vio
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : add_bufx
## ProcArguments  : add_bufx tag cell nodes
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc add_bufx {tag cell nodes} {
    global SHAKIR_ECO_COUNTER
    foreach node $nodes {
    	set random  [format "%05d" [lindex [split [expr 10000*rand()] "."] 0]]
    	if { ![info exist SHAKIR_ECO_COUNTER] } {
        	set SHAKIR_ECO_COUNTER 0 
    	} else {
       	incr SHAKIR_ECO_COUNTER
    	}   
       	insert_buffer -new_cell_names ${tag}_${SHAKIR_ECO_COUNTER}_${random}  -new_net_names ${tag}_${SHAKIR_ECO_COUNTER}_${random}  $node $cell
    }
}
##------------------------------------------------------------------
## ProcNameEnd    : add_bufx
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : add_delay
## ProcArguments  : add_delay delay pin args
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc add_delay {delay pin args} {
    set driver [get_object_name [get_pins -quiet -filter "direction==out" [all_fanin -flat -to [get_pins $pin]  -pin_level 1]]]
    set  cmd   "set_annotated_delay -increment  -net -to \[get_pins $pin\] -from \[get_pins $driver\] [expr 0 + $delay]"
    puts "<CMD> $cmd"
    eval $cmd
}
##------------------------------------------------------------------
## ProcNameEnd    : add_delay
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : add_delay_ex
## ProcArguments  : add_delay_ex ext delay pin args
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc add_delay_ex {ext delay pin args} {
    set driver [get_object_name [get_pins -quiet -filter "direction==out" [all_fanin -flat -to [get_pins $pin]  -pin_level 1]]]
    set  cmd   "set_annotated_delay -increment  -net  -to \[get_pins $pin\] -from \[get_pins $driver\] [expr $ext + $delay]"
    puts "<CMD> $cmd"
    eval $cmd
}
##------------------------------------------------------------------
## ProcNameEnd    : add_delay_ex
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : add_delay_ex_cell
## ProcArguments  : add_delay_ex_cell ext delay pin args
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc add_delay_ex_cell {ext delay pin args} {
    set driver [get_pins -quiet -filter "direction==out" [all_fanin -flat -to [get_pins $pin]  -pin_level 1]]
    set net [get_nets [all_connected $pin]]
    if { [get_att $net is_ideal] == "true"} { remove_ideal_network [get_nets $net]}
    set_annotated_delay -delta_only  -net -to [get_pins $pin] -from [get_pins $driver] [expr $ext + $delay]
}
##------------------------------------------------------------------
## ProcNameEnd    : add_delay_ex_cell
##------------------------------------------------------------------


