##------------------------------------------------------------------
## ProcNameStart  : parray
## ProcArguments  : parray a pattern
## ProcDependency :  
## ProcInfluence  : 9
## ProcRenamed    : 0
##------------------------------------------------------------------
proc parray {a {pattern *}} {
    upvar 1 $a array
    if {![array exists array]} {
	return -code error "\"$a\" isn't an array"
    }
    set maxl 0
    set names [lsort [array names array $pattern]]
    foreach name $names {
	if {[string length $name] > $maxl} {
	    set maxl [string length $name]
	}
    }
    set maxl [expr {$maxl + [string length $a] + 2}]
    foreach name $names {
	set nameString [format %s(%s) $a $name]
	puts stdout [format "%-*s = %s" $maxl $nameString $array($name)]
    }
}
##------------------------------------------------------------------
## ProcNameEnd    : parray
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : pininfo_arrival
## ProcArguments  : pininfo_arrival pins
## ProcDependency : sh , pt_map_table 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc pininfo_arrival pins {
	set data [list [list "#Max_Arrival" "#Min_Arrival" "#Period" "#Clock" "#Pin_Name"]]
	foreach_in_collection xpin [get_pins -quiet $pins] {
		set xpin_name   [get_object_name $xpin]
		set max_arrival [get_attribute -quiet $xpin max_arrival]
		set min_arrival [get_attribute -quiet $xpin min_arrival]
		set xclock      [index_collection [ sort_collection [get_attr -quiet $xpin launch_clocks] period] 0]
		set xclock_name [get_object_name $xclock]
		set xclock_per  [get_attribute -quiet  $xclock period]
		lappend data [list $max_arrival $min_arrival "T=$xclock_per" $xclock_name $xpin_name]  
	}
        pt_map_table $data > ./temp.arrival.raw
        redirect -v temp_var {  sh cat ./temp.arrival.raw | egrep '#|=' }
        set delimitx [lindex [split $temp_var ""] 0]
        regsub -all $delimitx $temp_var "," temp_var2
        echo $temp_var2 > ./temp.arrival.csv
        redirect -tee -file ./temp.arrival.all { sh cat ./temp.arrival.csv | column -t -s , }

	puts "\t**Open file ./temp.arrival.all"

 

}
##------------------------------------------------------------------
## ProcNameEnd    : pininfo_arrival
