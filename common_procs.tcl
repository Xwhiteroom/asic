## ProcNameStart  : pt_get_path_period_window
## ProcArguments  : pt_get_path_period_window path
## ProcDependency :  
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc pt_get_path_period_window path {
           set start_clk_ph  [get_attr -quiet $path startpoint_clock_open_edge_value];
           set end_clk_ph    [get_attr -quiet $path endpoint_clock_open_edge_value];
           set phase_delta   0.000 
	   catch {set phase_delta   [expr $end_clk_ph - $start_clk_ph]}
	   return [list $start_clk_ph $end_clk_ph $phase_delta]
}
