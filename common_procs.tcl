    global SHAKIR_ECO_COUNTER
    set random  [format "%05d" [lindex [split [expr 10000*rand()] "."] 0]]
    if { ![info exist SHAKIR_ECO_COUNTER] } {
        set SHAKIR_ECO_COUNTER 0 
    } else {
       incr SHAKIR_ECO_COUNTER
    }    
       insert_buffer -new_cell_names ${tag}_${SHAKIR_ECO_COUNTER}_${random}  -new_net_names ${tag}_${SHAKIR_ECO_COUNTER}_${random}  $node $cell -inverter_pair
}
##------------------------------------------------------------------
## ProcNameEnd    : add_invx
