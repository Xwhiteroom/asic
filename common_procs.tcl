      	        puts $out3  "    set pt_summary_arr($idx)  \"$pt_summary_data\"\n"

		if { $debug } { puts "                 <Debug>: $idx Path Innovus Code Completed" }

		
	}

        puts $out3 "##------------------------------------------------------------------"        
