##------------------------------------------------------------------
## ProcNameStart  : sta_qual_report_budget_offset
## ProcArguments  : sta_qual_report_budget_offset ports clocks threshold_pct args
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_report_budget_offset {ports clocks threshold_pct args} {

    set col_ports  [get_ports  -quiet $ports]
    set col_clocks [get_clocks -quiet $clocks]
    array unset port_data
    set index_i   0
    set formatx "%10s , %10s , %10s , %10s , %10s , %10s , %-30s , %-30s"
    puts "\n\n"
    puts [format "\tPORTS=%04d (%10s)  CLOCKS=%04d  (%10s)  THRESHOLD=%s  ARGS=$args" [sizeof_collection $col_ports] $ports [sizeof_collection $col_clocks] $clocks "$threshold_pct%"]


    set limit_i [expr 0.1 *[sizeof_collection $col_ports]]
    set port_cnt 0
    set buf_cnt  0
    array unset port_data    
    set  port_data($index_i) "#COMMENT,#BUDGET(%),#SLACK(%),#SLACK(ns),#IODLY(ns),#DIR,#PORT,#CLOCK"
    incr index_i

    foreach_in_collection port $col_ports {
        set name [get_object_name $port]
        set direction [get_attribute $port direction]
        incr port_cnt
        incr buf_cnt
        if { $buf_cnt >= $limit_i } {
            set buf_cnt 0
            puts "            -- [date] Done [sizeof_collection $col_ports] / $port_cnt"
        }
        foreach_in_collection xclock  $col_clocks {
            set path            ""
            set port_dly        0.000
            set period          [get_attribute [get_clocks $xclock] period]
            set ck_name         [get_object_name $xclock]
            if { $direction == "in" } {
                eval "set path       \[get_timing_paths -through $name -to \[get_clocks $ck_name\] $args\]"
                catch { eval "set port_dly   \[get_attr \$path startpoint_input_delay_value\]" }

            } elseif { $direction == "out" } {
                eval "set path       \[get_timing_paths -through $name -from \[get_clocks $ck_name\] $args\]"
                catch { eval "set port_dly   \[get_attr \$path endpoint_output_delay_value\]"  }               
            }
            if { $port_dly == "" } { set port_dly 0.000 }
            if { [sizeof_collection $path] } {
                set slack [get_attribute $path slack]
                set pct_slk    [format "%0.1f" [expr $slack * 100 / $period]]
                set pct_budget [format "%0.1f" [expr $port_dly * 100 / $period]]
                if { $pct_slk < $threshold_pct } {
                    set port_data($index_i) "BAD,$pct_budget%,$pct_slk%,$slack,$port_dly,$direction,$name,$ck_name"
                    incr index_i            
                }
            }
        }
    }
    puts "\n\n"
    foreach index_i [lsort -increasing [array names port_data]] {
        set elm [ split $port_data($index_i) ","]
        puts [format $formatx [lindex $elm 0] [lindex $elm 1] [lindex $elm 2] [lindex $elm 3] [lindex $elm 4] [lindex $elm 5] [lindex $elm 6] [lindex $elm 7]]
    }
    puts "\n\n"
    
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_report_budget_offset
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_report_clock_definition
## ProcArguments  : sta_qual_report_clock_definition dir file_tag view_scenario clocks
## ProcDependency : sh 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_report_clock_definition {dir file_tag view_scenario clocks} {
    suppress_message UITE-416
    puts [format "<GC::PROC> Start %-50s  [date]"   "sta_qual_report_clock_definition : $dir" ]

    # Optimize Filter Collection
    set my_design [get_object_name [current_design]]


    # Set File Tag/ Headers
    file mkdir    "$dir"
    set out_sum [open "$dir/$file_tag.clock_info.csv" w+]
    set defintion_data "#Design,#Scenario,#Clock,#Jitter(Full-Cycle),#Jitter(Half-Cycle),#Setup_Uncertainty,#Hold_Uncertainty,#Period,#Waveform,#Source(s)"
    puts $out_sum "$defintion_data"

    # Raw Reports
    report_clock        -nosplit  [get_clocks -quiet $clocks]  > $dir/$file_tag.report_clock.raw
    report_clock_jitter -clock    [get_clocks -quiet $clocks]  > $dir/$file_tag.report_jitter.raw

    # Parse Clocks
    foreach_in_collection my_clk [get_clocks -quiet $clocks] {
        set ck_sources  [get_attribute -quiet $my_clk  sources]
        if { [sizeof_collection $ck_sources] }  {
            set ck_sources  [get_object_name [get_attribute -quiet $my_clk  sources]]
        } else {
            set ck_sources "None"
        }

        # Map Jitter
        set jitter_full "NA"
        set jitter_half "NA"
        catch { redirect -variable jitter_info { report_clock_jitter -clock [get_object_name $my_clk] } }
        catch { set jitter_full  [lindex $jitter_info end-3] }
        catch { set jitter_half  [lindex $jitter_info end-2] }

        set defintion_data  "$my_design,$view_scenario,[get_object_name $my_clk]"
        set defintion_data  "$defintion_data,$jitter_full,$jitter_half,[get_attribute -quiet $my_clk setup_uncertainty],[get_attribute -quiet $my_clk hold_uncertainty],[get_attribute -quiet $my_clk period]"
        set defintion_data  "$defintion_data,[get_attribute -quiet $my_clk waveform],$ck_sources"
        puts $out_sum "$defintion_data"
    }
    close $out_sum
    catch { sh cat $dir/$file_tag.clock_info.csv | column -t -s , > $dir/$file_tag.clock.info }
    puts [format "<GC::PROC> Done  %-50s  [date]"   "sta_qual_report_clock_definition : $dir" ]
    return [file normalize $dir/$file_tag.clock_info]
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_report_clock_definition
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_report_clock_tree_profile
## ProcArguments  : sta_qual_report_clock_tree_profile dir file_tag view_scenario clocks mean_sig1_sig2_sig3_extreme bins_latency bins_stage bins_unit rpt_type per_source_max_path use_ports look_up
## ProcDependency : sta_qual_gen_list_histogram , sh , sta_qual_gen_io_parse_timing_point 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_report_clock_tree_profile {dir file_tag view_scenario clocks mean_sig1_sig2_sig3_extreme bins_latency bins_stage bins_unit rpt_type per_source_max_path use_ports look_up} {
    suppress_message UITE-416
    puts [format "<GC::PROC> Start %-50s  [date]"   "sta_qual_report_clock_tree_profile : $dir" ]

    # Optimize Filter Collection
    set my_design   [get_object_name [current_design]]
    global synopsys_program_name    
    if { $synopsys_program_name == "fc_shell" } {
        set cond_clock_ntw   "(is_clock_used_as_clock==true || is_clock_used_as_data==true)"
        set cond_noclock_ntw "(is_clock_used_as_clock==false &&is_clock_used_as_data==false)"

    } else {
        set cond_clock_ntw   "is_clock_network==true"
        set cond_noclock_ntw "is_clock_network==false"
    }
    set in_ports    [get_ports $use_ports -filter "direction==in &&   $cond_noclock_ntw && max_slack!=INFINITY"]
    set out_ports   [get_ports $use_ports -filter "direction==out &&  $cond_noclock_ntw && max_slack!=INFINITY"]
    set i_cone      [get_pins -quiet -of_objects [get_cells -of_object [filter_collection [all_fanout -quiet -flat -from $in_ports  -endpoints_only    ] "is_async_pin==false" ] ] -filter "$cond_clock_ntw  && is_clock_gating_pin==false"]
    set o_cone      [get_pins -quiet -of_objects [get_cells -of_object [filter_collection [all_fanin  -quiet -flat  -to  $out_ports -startpoints_only  ] "is_async_pin==false" ] ] -filter "$cond_clock_ntw  && is_clock_gating_pin==false"]
    set myclock_col [get_clocks -quiet $clocks]
    set look_up     [split $look_up ","]
    # Global Tracker Arrays
    array unset   pin_data
    array unset   latency_info
    array unset   verbose_summary_info

    # Set File Tag/ Headers
    file mkdir    "$dir/$file_tag"

    # Create Verbose file
    set out_detail      [open "$dir/$file_tag.detail.csv" w+]
    puts $out_detail    "#Design,#Scenario,#Clock,#Source,#Endpin,#Travel,#XLocRef,#YLocRef,#XLoc,#YLoc,#Resistance,#Capacitance,#Class,#Arrival,#CellDelay,#RCDelay,#UnitDelay,#Stages,#Class,#Arrival,#CellDelay,#RCDelay,#UnitDelay,#Stages"
    # Iterate Clocks
    puts [format "                 %-50s  [date]"   "-- Reporting Loop Started" ]
    puts [format "                 %-50s  [date]"   "-- Input  Cones/[sizeof_collection $i_cone] for  In/[sizeof_collection $in_ports]"  ]
    puts [format "                 %-50s  [date]"   "-- Output Cones/[sizeof_collection $o_cone] for Out/[sizeof_collection $out_ports]" ]
    foreach_in_collection  xclk $myclock_col {
        set ck_name [get_object_name $xclk]
        regsub -all {\[|\]|/} $ck_name {_} file_ck_name
        set ck_sources [get_attribute -quiet $xclk sources ]
        #post_eval {} start

        set outs [open "$dir/$file_tag/$file_tag.$file_ck_name.stage_histogram"   w+]
        set outu [open "$dir/$file_tag/$file_tag.$file_ck_name.unit_histogram"    w+]
        set outc [open "$dir/$file_tag/$file_tag.$file_ck_name.cell_histogram"    w+]
        set outr [open "$dir/$file_tag/$file_tag.$file_ck_name.rc_histogram"      w+]
        set outl [open "$dir/$file_tag/$file_tag.$file_ck_name.latency_histogram" w+]
        puts [format "                 %-50s  [date]"   "   -- Parsing Clock=$ck_name MaxPath=$per_source_max_path" ]
        foreach_in_collection src $ck_sources {
            set src_name [get_object_name $src]
            set x_loc_ref   [expr ([get_attribute -quiet $src x_coordinate] + 0) / 1000.0 ]
            set y_loc_ref   [expr ([get_attribute -quiet $src y_coordinate] + 0) / 1000.0 ]

            # Filter I/O cone Contributions for only valid clock sinks / Exclude side nodes like antenna or floating nets
            set cone    [filter_collection [all_fanout -quiet -from $src -flat -end ] "is_clock_used_as_clock==true && is_clock_gating_pin==false && is_hierarchical==false"]
            set cone_i  [remove_from_collection -intersect $cone $i_cone]
            set cone_o  [remove_from_collection -intersect $cone $o_cone]
            set cone_io $cone_i
            append_to_collection -uniq cone_io $cone_o
            set cone    [remove_from_collection $cone $cone_io]

            # Process Cone Paths
            array unset path_collection
            set max_path 1
            if { [sizeof_collection $cone] > 0 } { set max_path [sizeof_collection $cone  ] }
            # Must Have Sample Size Limit as min/max already ensure extrems are covered : Script wont scale across flat designs
            if { [sizeof_collection $cone]  > 50000 } { set max_path 50000 }
            #if { [sizeof_collection $cone]  < 25000 } { set max_path [expr { int(0.25 * [sizeof_collection $cone  ])} + 1] }
            if { $per_source_max_path >      0 } { set max_path $per_source_max_path        }
            puts [format "                 %-50s  [date]"   "   -- Parsing Clock=$ck_name MaxPath=$max_path (cone=[sizeof_collection $cone  ])" ]

            #set look_up [list max.all max.input max.output min.all min.input min.output]
            #set look_up [list max.all max.output min.all min.input ]

            if { [sizeof_collection $cone] > 0 } {
                set path_collection(max.all)    [get_timing_paths -from  [get_clocks $ck_name] -through $src -to $cone   -delay max -max_path $max_path ]
                set path_collection(min.all)    [get_timing_paths -from  [get_clocks $ck_name] -through $src -to $cone   -delay min -max_path $max_path ]
            } else {
                set path_collection(max.all)    ""
                set path_collection(min.all)    ""
            }
            puts [format "                 %-50s  [date]"   "      -- All Sinks for $src_name" ]
            if { [sizeof_collection $cone_i] > 0 } {
                set path_collection(max.input)  [get_timing_paths -from  [get_clocks $ck_name] -through   $src -to $cone_i -delay max -max_path $max_path]
                set path_collection(min.input)  [get_timing_paths -from  [get_clocks $ck_name] -through   $src -to $cone_i -delay min -max_path $max_path]
            } else {
                set path_collection(max.input)    ""
                set path_collection(min.input)    ""
            }
            puts [format "                 %-50s  [date]"   "      -- Input Sinks for $src_name" ]
            if { [sizeof_collection $cone_o] > 0 } {
                set path_collection(max.output) [get_timing_paths -from  [get_clocks $ck_name] -through   $src -to $cone_o -delay max -max_path $max_path]
                set path_collection(min.output) [get_timing_paths -from  [get_clocks $ck_name] -through   $src -to $cone_o -delay min -max_path $max_path]
            } else {
                set path_collection(max.output)    ""
                set path_collection(min.output)    ""
            }
            puts [format "                 %-50s  [date]"   "      -- Output Sinks for $src_name" ]
            # Process Cone Class Stats

            array unset   look_up_data
            array unset   temp_pin_data
            foreach classx $look_up {
                set collection                          $path_collection($classx)
                set look_up_data($classx.count)         0
                set look_up_data($classx.sum_maxlat)    0
                set look_up_data($classx.sum_minlat)    0
                set look_up_data($classx.latmax)        0
                set look_up_data($classx.latin)         0
                set look_up_data($classx.data_arr)      [list ]
                set look_up_data($classx.data_stg)      [list ]
                set look_up_data($classx.data_unt)      [list ]
                set look_up_data($classx.data_cell)     [list ]
                set look_up_data($classx.data_rc)       [list ]
                set look_up_data($classx.head_publish)  "$my_design,$view_scenario,$ck_name,$src_name,$classx"
                set cntx 0
                set intx 0
                puts ""
                puts -nonewline [format "                 %-50s  [date]"   "      -- Completed $classx " ]

                foreach_in_collection x $collection {
                    # Collection Parsing
                    incr cntx
                    if { $cntx > 0.1*[sizeof_collection $collection ] } {
                        incr intx
                        puts -nonewline [format " ->%4s"   "${intx}0%" ]
                        flush stdout
                        set cntx 0
                    }
                    set arrival [get_attribute $x arrival]
                    set end_pin [get_object_name [get_attribute $x endpoint] ]

                    if { $arrival > 0 } {
                        incr look_up_data($classx.count)
                        set  stage [expr { ceil([sizeof_collection [get_attribute $x points]] / 2) }  ]
                        set x_loc  [expr ([get_attribute -quiet [get_attribute $x endpoint] x_coordinate] + 0) / 1000.0 ]
                        set y_loc  [expr ([get_attribute -quiet [get_attribute $x endpoint] y_coordinate] + 0) / 1000.0 ]
                        set travel [expr { abs($x_loc - $x_loc_ref) }  + { abs($y_loc - $y_loc_ref) }  + 0]
                        lappend look_up_data($classx.data_arr)  $arrival
                        lappend look_up_data($classx.data_stg)  $stage
                        lappend look_up_data($classx.data_unt)  [expr $arrival / $stage]

                        # Prepare Verbose Attr File DB
                        if { ($classx == "max.all" || $classx == "min.all") && $rpt_type == "detail" } {
                            # Parse Detailed Paths Only When We have Non Detailed Required
                            set out         [sta_qual_gen_io_parse_timing_point $x [list] 0 ]
                            set travel      [expr 0.0 + [lindex [split $out ","] 4] + [lindex [split $out ","] 5] + 0.0   ]
                            set res_total   [expr 0.0 + [lindex [split $out ","] 6] + 0.0   ]
                            set cap_total   [expr 0.0 + [lindex [split $out ","] 7] + 0.0   ]
                            lappend look_up_data($classx.data_cell) [expr [lindex [split $out ","] 0] / $stage]
                            lappend look_up_data($classx.data_rc)   [expr [lindex [split $out ","] 2] / $stage]

                            if {![info exist temp_pin_data($end_pin)] } {
                                set temp_pin_data($end_pin) "$my_design,$view_scenario,$ck_name,$src_name,$end_pin,$travel,$x_loc_ref,$y_loc_ref,$x_loc,$y_loc,$res_total,$cap_total"
                            }
                            set temp_pin_data($end_pin) [format "$temp_pin_data($end_pin),$classx,%0.4f,%0.4f,%0.4f,%0.4f,%0.0f" $arrival [lindex [split $out ","] 0] [lindex [split $out ","] 2] [expr $arrival/ $stage ] $stage]
                        }
                    }
                }
		puts ""
                # Prepare Summary Stats
                if {($classx == "min.all") } {
                    #puts [format "                 %-50s  [date]"   "      -- Profile Stage/Lat/Unit for $src_name" ]
                }
                set stage_data   [sta_qual_gen_list_histogram $look_up_data($classx.data_stg)  $bins_stage]
                set latency_data [sta_qual_gen_list_histogram $look_up_data($classx.data_arr)  $bins_latency]
                set unit_data    [sta_qual_gen_list_histogram $look_up_data($classx.data_unt)  $bins_unit]
                if { $rpt_type == "detail" } {
                    set cell_data    [sta_qual_gen_list_histogram $look_up_data($classx.data_cell) $bins_unit]
                    set rc_data      [sta_qual_gen_list_histogram $look_up_data($classx.data_rc)   $bins_unit]
                }

                set header "$look_up_data($classx.head_publish),$look_up_data($classx.count)"

                # For Latency Profile
                set ele       $latency_data
                set publish   "latency_publish"
                set look_up_data($classx.$publish) [format "%0.3f,%0.3f,%0.3f,%0.3f,%0.3f,%0.3f,%0.3f" [lindex $ele 0] [lindex $ele 1] [lindex $ele 2] [lindex $ele 3] [lindex $ele 4] [lindex $ele 5] [lindex $ele 6]]
                set header "$header,$look_up_data($classx.$publish)"

                set file_ptrx $outl
                puts $file_ptrx "##############################################"
                puts $file_ptrx "# Header :  $my_design/$view_scenario/$ck_name"
                puts $file_ptrx "# Source :  $src_name ($ck_name)"
                puts $file_ptrx "# Data   :  $publish ($classx)"
                puts $file_ptrx "# Summary:  mean,mse,max,min,sigma3,sigma2,sigma1 > $look_up_data($classx.$publish)"
                puts $file_ptrx "##############################################"
                foreach el [lindex $ele end] {
                  set el_ar [split $el ","]
                  puts $file_ptrx [format "%15s  %15s  %15s  %15s   %15s"  [lindex $el_ar 0]  [lindex $el_ar 1] [lindex $el_ar 2] [lindex $el_ar 3]  [lindex $el_ar 4]]
                }
                puts $file_ptrx "\n"


                # For Stage Profile
                set ele          $stage_data
                set publish      "stage_publish"
                set look_up_data($classx.$publish) [format "%0.3f,%0.3f,%0.3f,%0.3f,%0.3f,%0.3f,%0.3f" [lindex $ele 0] [lindex $ele 1] [lindex $ele 2] [lindex $ele 3] [lindex $ele 4] [lindex $ele 5] [lindex $ele 6]]
                set header "$header,$look_up_data($classx.$publish)"

                set file_ptrx $outs
                puts $file_ptrx "##############################################"
                puts $file_ptrx "# Header :  $my_design/$view_scenario/$ck_name"
                puts $file_ptrx "# Source :  $src_name ($ck_name)"
                puts $file_ptrx "# Data   :  $publish ($classx)"
                puts $file_ptrx "# Summary:  mean,mse,max,min,sigma3,sigma2,sigma1 > $look_up_data($classx.$publish)"
                puts $file_ptrx "##############################################"
                foreach el [lindex $ele end] {
                  set el_ar [split $el ","]
                  puts $file_ptrx [format "%15s  %15s  %15s  %15s   %15s"  [lindex $el_ar 0]  [lindex $el_ar 1] [lindex $el_ar 2] [lindex $el_ar 3]  [lindex $el_ar 4]]
                }
                puts $file_ptrx "\n"

                # For Unit Profile
                set ele          $unit_data
                set publish      "unit_publish"
                set look_up_data($classx.$publish) [format "%0.3f,%0.3f,%0.3f,%0.3f,%0.3f,%0.3f,%0.3f" [lindex $ele 0] [lindex $ele 1] [lindex $ele 2] [lindex $ele 3] [lindex $ele 4] [lindex $ele 5] [lindex $ele 6]]
                set header "$header,$look_up_data($classx.$publish)"

                set file_ptrx $outu
                puts $file_ptrx "##############################################"
                puts $file_ptrx "# Header :  $my_design/$view_scenario/$ck_name"
                puts $file_ptrx "# Source :  $src_name ($ck_name)"
                puts $file_ptrx "# Data   :  $publish ($classx)"
                puts $file_ptrx "# Summary:  mean,mse,max,min,sigma3,sigma2,sigma1 > $look_up_data($classx.$publish)"
                puts $file_ptrx "##############################################"
                foreach el [lindex $ele end] {
                  set el_ar [split $el ","]
                  puts $file_ptrx [format "%15s  %15s  %15s  %15s   %15s"  [lindex $el_ar 0]  [lindex $el_ar 1] [lindex $el_ar 2] [lindex $el_ar 3]  [lindex $el_ar 4]]
                }
                puts $file_ptrx "\n"


                if { $rpt_type == "detail" } {
                    # For Cell Profile
                    set ele          $cell_data
                    set publish      "cell_publish"
                    set look_up_data($classx.$publish) [format "%0.3f,%0.3f,%0.3f,%0.3f,%0.3f,%0.3f,%0.3f" [lindex $ele 0] [lindex $ele 1] [lindex $ele 2] [lindex $ele 3] [lindex $ele 4] [lindex $ele 5] [lindex $ele 6]]
                    set header "$header,$look_up_data($classx.$publish)"

                    set file_ptrx $outc
                    puts $file_ptrx "##############################################"
                    puts $file_ptrx "# Header :  $my_design/$view_scenario/$ck_name"
                    puts $file_ptrx "# Source :  $src_name ($ck_name)"
                    puts $file_ptrx "# Data   :  $publish ($classx)"
                    puts $file_ptrx "# Summary:  mean,mse,max,min,sigma3,sigma2,sigma1 > $look_up_data($classx.$publish)"
                    puts $file_ptrx "##############################################"
                    foreach el [lindex $ele end] {
                      set el_ar [split $el ","]
                      puts $file_ptrx [format "%15s  %15s  %15s  %15s   %15s"  [lindex $el_ar 0]  [lindex $el_ar 1] [lindex $el_ar 2] [lindex $el_ar 3]  [lindex $el_ar 4]]
                    }
                    puts $file_ptrx "\n"

                    # For RC Profile
                    set ele          $rc_data
                    set publish      "rc_publish"
                    set look_up_data($classx.$publish) [format "%0.3f,%0.3f,%0.3f,%0.3f,%0.3f,%0.3f,%0.3f" [lindex $ele 0] [lindex $ele 1] [lindex $ele 2] [lindex $ele 3] [lindex $ele 4] [lindex $ele 5] [lindex $ele 6]]
                    set header "$header,$look_up_data($classx.$publish)"

                    set file_ptrx $outr
                    puts $file_ptrx "##############################################"
                    puts $file_ptrx "# Header :  $my_design/$view_scenario/$ck_name"
                    puts $file_ptrx "# Source :  $src_name ($ck_name)"
                    puts $file_ptrx "# Data   :  $publish ($classx)"
                    puts $file_ptrx "# Summary:  mean,mse,max,min,sigma3,sigma2,sigma1 > $look_up_data($classx.$publish)"
                    puts $file_ptrx "##############################################"
                    foreach el [lindex $ele end] {
                      set el_ar [split $el ","]
                      puts $file_ptrx [format "%15s  %15s  %15s  %15s   %15s"  [lindex $el_ar 0]  [lindex $el_ar 1] [lindex $el_ar 2] [lindex $el_ar 3]  [lindex $el_ar 4]]
                    }
                    puts $file_ptrx "\n"

                }

                set verbose_summary_info($ck_name,$src_name,$classx) $header


            }
            # Stream Verbose if enabled
            puts ""
            puts [format "                 %-50s  [date]"   "      -- Streaming Verbose Size=[llength [array names temp_pin_data]]" ]
            foreach el_end_pin [array names temp_pin_data] {
                puts $out_detail "$temp_pin_data($el_end_pin)"
            }

            # Quote Min Latency as min input Latency else  internal reg2reg
            if { $look_up_data(min.input.count) > 0 } {
               set class_min  "min.input"
            } else {
               set class_min  "min.all"
            }

            # Quote Max Latency as max output Latency else  internal reg2reg
            if { $look_up_data(max.output.count) > 0 } {
               set class_max  "max.output"
            } else {
               set class_max  "max.all"
            }

            # Map Attributes
            set el_ar_max    [split $look_up_data($class_max.latency_publish) ","]
            set el_ar_min    [split $look_up_data($class_min.latency_publish) ","]
            set qvalue       $mean_sig1_sig2_sig3_extreme
            set lu_index_min 0
            set lu_index_max 0

            #Latency/Mean  #Latency/Sigma  #Latency/Max  #Latency/Min  #Latency/3Sig  #Latency/2Sig  #Latency/1Sig
            if {$qvalue == "mean"    } { set lu_index_max 0 ; set lu_index_min 0}
            if {$qvalue == "sigma1"  } { set lu_index_max 6 ; set lu_index_min 6}
            if {$qvalue == "sigma2"  } { set lu_index_max 5 ; set lu_index_min 5}
            if {$qvalue == "sigma3"  } { set lu_index_max 4 ; set lu_index_min 4}
            if {$qvalue == "extreme" } { set lu_index_max 2 ; set lu_index_min 3}

            # Align Header
            set el_ar   [split $look_up_data(max.all.head_publish) ","]
            set latency_info($ck_name,$src_name) [format "%s,%s,%s,%s"  [lindex $el_ar 0]  [lindex $el_ar 1] [lindex $el_ar 2] [lindex $el_ar 3]]
            set latency_info($ck_name,$src_name) [format "$latency_info($ck_name,$src_name),%s,%s,%s,%s,%s" [lindex $el_ar_max $lu_index_max] [lindex $el_ar_min $lu_index_max] $look_up_data($class_max.count) $look_up_data($class_min.count) $qvalue]
            # Publish data
            #puts [format "                 %-50s  [date]"   "    -- Processed Clock=$ck_name/$src_name" ]
        }
        close $outs
        close $outu
        close $outc
        close $outr
        close $outl
        #post_eval {} close

    }

    # Summary Header and file
    set out_sum [open  $dir/$file_tag.summary.csv w+]
    set verbose_summary_info("#HEADER") "#Design,#Scenario,#Clock,#Source,#Class,#Paths-Sinks(n)"
    set valid_data   [list Latency Stages UnitDelay]
    if { $rpt_type == "detail" } { 
        set valid_data [concat $valid_data [list CellDelay RCDelay]]
    }
    foreach categ $valid_data {
        set verbose_summary_info("#HEADER") "$verbose_summary_info("#HEADER"),#$categ/Mean,#$categ/Sigma,#$categ/Max,#$categ/Min,#$categ/3Sig,#$categ/2Sig,#$categ/1Sig"
    }

    foreach el [lsort [array names verbose_summary_info]] {
        puts $out_sum "$verbose_summary_info($el)"
    }
    close $out_sum

    # Macro Summary Header and file
    set latency_info("#HEADER") "#Design,#Scenario,#Clock,#Source,#Latency(Out),#Latency(In),#Sinks(Out),#Sinks(In),#Quote"
    set out_macro [open "$dir/$file_tag.latency.info.csv" w+]
    foreach el [lsort [array names latency_info]] {
        puts $out_macro "$latency_info($el)"
    }
    close $out_macro
    catch { sh cat $dir/$file_tag.latency.info.csv | column -t -s , > $dir/$file_tag.latency.info }

    # Verbose Stats
    close $out_detail

    # Was Suppresed to avoid reporting of unconst clock paths through get_timing_paths
    unsuppress_message UITE-416
    puts [format "<GC::PROC> Done  %-50s  [date]"   "sta_qual_report_clock_tree_profile : [file normalize $dir/$file_tag.latency.info]" ]
    return [file normalize $dir/$file_tag.latency.info]
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_report_clock_tree_profile
