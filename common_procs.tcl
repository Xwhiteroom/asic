##------------------------------------------------------------------
## ProcNameStart  : gen_data_map_report
## ProcArguments  : gen_data_map_report paths
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc gen_data_map_report paths {
    if { [sizeof_collection [get_timing_paths $paths]] > 0 } {
        set max_paths [sizeof_collection [get_timing_paths $paths]] 
        puts "**INFO:: The path collection provided $paths has $max_paths paths."
        set index 0
        foreach_in_collection mypath $paths {
            incr index 
            array unset path_attr
            # STRING ATTR
            set spt       [get_object_name [get_attr -quiet $mypath startpoint]];
            set ept       [get_object_name [get_attr -quiet $mypath endpoint]];
            set sck       [get_object_name [get_attr -quiet $mypath startpoint_clock]];
            set eck       [get_object_name [get_attr -quiet $mypath endpoint_clock]];
            set crpt      [get_object_name [get_attr -quiet $mypath crpr_common_point]];
            set type      [get_attr -quiet $path path_type]


            if { $type == "max" } { 
                set class_factor   "-1"      ; set use_factor    "1";
                set launch         "late"    ; set capture       "early";
                set launch_attr    "max"     ; set capture_attr  "min"
            } else {
                set class_factor   "1"       ; set use_factor    "0";
                set launch         "early"   ; set capture       "late";
                set launch_attr    "min"     ; set capture_attr  "max"
            }





            # NUMERIC ATTR : Launch
            set sck_src   [get_object_name [get_attr -quiet [get_clocks $sck] sources]];
            set sck_mst   [get_object_name [get_attr -quiet [get_clocks $sck] master_pin]];
        
            set rtime     [get_attr -quiet $path required]            
            set libhd     [get_attr -quiet $path endpoint_hold_time_value];
            set libsu     [get_attr -quiet $path endpoint_setup_time_value];
            set librm     [get_attr -quiet $path endpoint_removal_time_value];
            set librc     [get_attr -quiet $path endpoint_recovery_time_value];
            set libtime   [expr $class_factor*(0 + $libsu + $libhd + $librm + $librc + 0)]
            set uncert        [get_attr -quiet $path clock_uncertainty]
            set margin        [expr 0 + $req_time - $end_lat - $crpr - $lib_time + 0 ]




            set eck_src   [get_object_name [get_attr -quiet [get_clocks $eck] sources]];
            set eck_mst   [get_object_name [get_attr -quiet [get_clocks $end_clk] master_pin]];
            
        } 


    } else {
        puts "**INFO:: The path collection provided $paths is either empty or invalid"
    }

}
##------------------------------------------------------------------
## ProcNameEnd    : gen_data_map_report
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : gen_eco_hold
## ProcArguments  : gen_eco_hold filex
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc gen_eco_hold filex {
    global CORNER
    set outfile "$filex.hold_setup_ware.rpt"
    set inx  [open $filex]
    set outx [open $outfile w+]
    array unset pin_slack
    array unset pin_vio
    array unset pin_corner

    set i 0
    puts $outx  "#PIN #HOLD_VIO #SETUP_SLACK #CORNER"
    while { [gets $inx line] >= 0 } {
            incr i  ; if { [regexp "0000" $i ] } { puts "Slack Parsed $i [date]" }        
            set vio   [lindex $line 0]
            set pin   [lindex $line 1]
            set pvt   [lindex $line 2]
            #echo "$vio,$pin,$pvt"
            #return 0
            set slack   [get_attr [get_pins $pin ] max_slack] 
            set pin_vio($pin)   $vio
            set pin_corner($pin) $pvt
            set pin_slack($pin) $slack        
    }
    set i 0
    foreach pin [array names pin_slack] {
        incr i  ; if { [regexp "0000" $i ] } { puts "Slack Reported $i [date]" }
        set vio $pin_vio($pin)  
        set pvt $pin_corner($pin)  
        set slack $pin_slack($pin)  
        puts $outx  "$pin ;#VIO=$vio;#SU=$slack;#PVT=$pvt;#SETUP_PVT:$CORNER" 
    }
    close $inx
    close $outx
    puts "Open : $outfile"
}
##------------------------------------------------------------------
## ProcNameEnd    : gen_eco_hold
