## ProcNameStart  : report_arc
## ProcArguments  : report_arc arc
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc report_arc arc {

		set arc_type   		"dnet";if { [get_attr -quiet  $arc is_cellarc] } { set arc_type "cell"}
		#set sdf_cond   		[get_attr -quiet $arc when]

		set is_disabled   	[get_attr -quiet  $arc is_disabled];
		#if {[get_attr -quiet $arc is_user_disabled] and [get_attr -quiet $arc is_user_disabled] != "" } { set is_disabled "${is_disabled}*u"}
		set delay_max "NA"
		set delay_max_skew "NA"
		catch {set delay_max  		[format "%0.3f" [get_attr -quiet $arc delay_max]]}
		catch {set delay_max_skew  	[format "%0.3f" [expr [get_attr -quiet  $arc delay_max_rise] - [get_attr  -quiet  $arc delay_max_fall]]]}

		set delay_min "NA"
		set delay_min_skew "NA"
		catch {set delay_min  		[format "%0.3f" [get_attr -quiet  $arc delay_min]]}
		catch {set delay_min_skew  	[format "%0.3f" [expr [get_attr -quiet  $arc delay_min_rise] - [get_attr -quiet  $arc delay_min_fall]]]}




		set delta_min "NA"
		set delta_min "NA"
		catch {set delta_max  		[format "%0.3f" [get_attr -quiet  $arc annotated_delay_delta_max]]}
		catch {set delta_min  		[format "%0.3f" [get_attr -quiet $arc annotated_delay_delta_min]]}

		set from_pin   			[get_object_name [get_attr -quiet  $arc from_pin]]
		set to_pin     			[get_object_name [get_attr -quiet $arc to_pin]]

	set out [list $arc_type $is_disabled $delay_max $delay_max_skew $delay_min $delay_min_skew $delta_max $delta_min $to_pin $from_pin]
	return $out

}
