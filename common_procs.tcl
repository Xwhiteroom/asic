proc check_iter_fc {max_min iter {th 100}} {
	global CORNER MODE
	if {![info exist CORNER] } { set CORNER "FC" }
	if {![info exist MODE]   } { set MODE "func" }
    file mkdir sta_summary
    set rpt_dir sta_summary/$iter    
    file mkdir $rpt_dir    
    exec tree $rpt_dir
    
    if { [regexp "max" $max_min] } {	
        ssi_print white red " === Setup_Timing ==="  > $rpt_dir/../$iter.sum
	    report_timing -nosplit -delay max -path_type end_detailed -max_path 10000000   > $rpt_dir/max.$iter.path ; puts "\t\t**Parsing Maxx";
	    catch { slack_parse $rpt_dir/max.$iter.path 6d }  
        catch { 
            exec /home/syiqbal/code/util/uslk.pm -f  $rpt_dir/max.$iter.path.uniq -r 1 -h $th -t $rpt_dir/max.$iter.path.uniq  >> $rpt_dir/../$iter.sum; 
            exec head -n 15 $rpt_dir/max.$iter.path.buck  $rpt_dir/max.$iter.path.uniq.histogram         >> $rpt_dir/../$iter.sum
        }
    }

    if { [regexp "min" $max_min] } {	

        ssi_print white red " === Hold_Timing ==="  >> $rpt_dir/../$iter.sum
        report_timing -nosplit -delay min -path_type end_detailed -max_path 10000000   > $rpt_dir/min.$iter.path ; puts "\t\t**Parsing Minx"; 
	    catch { slack_parse $rpt_dir/min.$iter.path 6d }    
        catch { 
            exec /home/syiqbal/code/util/uslk.pm -f  $rpt_dir/min.$iter.path.uniq -r 1 -h $th -t $rpt_dir/min.$iter.path.uniq  >> $rpt_dir/../$iter.sum  ;  
            exec head -n 10 $rpt_dir/min.$iter.path.buck           >> $rpt_dir/../$iter.sum            
            exec head -n 15 $rpt_dir/min.$iter.path.uniq.histogram  | grep -v  ' 0 :'  | head -15      >> $rpt_dir/../$iter.sum
        }
    }
        ssi_print white blue " === Done_$iter ==="  >> $rpt_dir/../$iter.sum
 
    exec cat   $rpt_dir/../$iter.sum
    #exec echo "\n\nOpen: $rpt_dir/../$iter.sum\n\n"
}

