##------------------------------------------------------------------
## ProcNameStart  : report_clock_cost
## ProcArguments  : report_clock_cost valid_clocks args
## ProcDependency : get_path_stats 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc report_clock_cost {valid_clocks args} {
    array unset clock_data 
    set clocks_u [get_object_name [get_clocks -quiet $valid_clocks]]
    
    foreach x_clk $clocks_u {
        foreach y_clk $clocks_u {
            set cmdr2r "get_timing_paths -rise_from \[get_clocks $x_clk \] -rise_to \[get_clocks $y_clk \] $args"
            set cmdf2f "get_timing_paths -fall_from \[get_clocks $x_clk \] -fall_to \[get_clocks $y_clk \] $args"
            set cmdr2f "get_timing_paths -rise_from \[get_clocks $x_clk \] -fall_to \[get_clocks $y_clk \] $args"
            set cmdf2r "get_timing_paths -fall_from \[get_clocks $x_clk \] -rise_to \[get_clocks $y_clk \] $args"
            set keyx "$x_clk $y_clk"
            if { ! [info exists  clock_data($keyx) ] } {
                set   clock_data($keyx)   [list ]

                set clock_data($keyx) [list ]                
                set paths_min [eval "$cmdr2r -delay min" ]
                set paths_max [eval "$cmdr2r -delay max" ]
                set paths [add_to_collection $paths_max $paths_min]
                set r2r [get_path_stats $paths]
                lappend clock_data($keyx) $r2r
                puts "Done R2R $keyx"

                set paths_min [eval "$cmdf2f -delay min" ]
                set paths_max [eval "$cmdf2f -delay max" ]
                set paths [add_to_collection $paths_max $paths_min]
                set f2f [get_path_stats $paths]
                lappend clock_data($keyx) $f2f
                puts "Done F2F $keyx"


                set paths_min [eval "$cmdr2f -delay min" ]
                set paths_max [eval "$cmdr2f -delay max" ]
                set paths [add_to_collection $paths_max $paths_min]
                set r2f [get_path_stats $paths]
                lappend clock_data($keyx) $r2f
                puts "Done R2F $keyx"

                set paths_min [eval "$cmdf2r -delay min" ]
                set paths_max [eval "$cmdf2r -delay max" ]
                set paths [add_to_collection $paths_max $paths_min]
                set f2r [get_path_stats $paths]
                lappend clock_data($keyx) $f2r
                puts "Done F2R $keyx"

                
            }
        }        
    }
    puts [format "%30s  %30s  %60s %60s %60s %60s" "#Start_Clk"  "End_Clk"  "Rise2Rise"  "Fall2Fall" "Rise2Fall" "Fall2Rise"]

   foreach xkey [array names  clock_data] {
       puts [format "%30s  %30s  %60s %60s %60s %60s" "[lindex $xkey 0]"  "[lindex $xkey 0]"  "[lindex $clock_data($xkey) 0]"  "[lindex $clock_data($xkey) 1]" "[lindex $clock_data($xkey) 2]" "[lindex $clock_data($xkey) 3]"]

   }
}
