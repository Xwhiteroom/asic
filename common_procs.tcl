##------------------------------------------------------------------
## ProcNameStart  : sta_qual_set_clock_exclusivity
## ProcArguments  : sta_qual_set_clock_exclusivity output_pin input_pin type
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_set_clock_exclusivity {output_pin input_pin type} {

    if { [info exists ::synopsys_program_name] || [info exists ::TV_SHELL_VERSION]} {
        puts "set_clock_exclusivity -output [get_object_name [get_pins $output_pin]] -input [get_object_name [get_pins $input_pin]] -type $type"
        set_clock_exclusivity -output [get_pins $output_pin] -input [get_pins $input_pin] -type $type
    } elseif { [info exists ::SPYGLASS_HOME] } {
        puts "No mux exclusivity cmd supported for spyglass"
    } else {
        set clocks_name [get_property [get_pins $input_pin] clocks]
        if { [sizeof_collection $clocks_name] } {
            set group_cmd ""
            foreach_in_collection clock_name $clocks_name {
                set clock_full_name [get_object_name $clock_name]
                if { [string first \{$clock_full_name\} $group_cmd] == -1 } {
                    append group_cmd " -group \{$clock_full_name\}"
                }
            }
            puts "set_clock_exclusivity -pin [get_object_name [get_pins $output_pin]] $group_cmd"
            set cmd "set_clock_exclusivity -pin [get_object_name [get_pins $output_pin]] $group_cmd"
            eval $cmd
        }
    }
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_set_clock_exclusivity
