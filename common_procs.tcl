##------------------------------------------------------------------
## ProcNameStart  : sta_qc_get_noise_attr
## ProcArguments  : sta_qc_get_noise_attr noise_th fileout
## ProcDependency : sh 
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qc_get_noise_attr {noise_th fileout} {
     global sh_product_version
     set place_hold 1; proc sta_qc_get_net_noise_stat {net} {
	set nets [get_nets $net]
	array unset si_nets
	set xlist [list ]
	foreach_in_collection net $nets {
	    set net_name [get_object_name $net]
	    set delta_delay_max [get_attr $net annotated_delay_delta_max] 
	    set delta_delay_min [get_attr $net annotated_delay_delta_min] 
	    set delta_tran_max  [get_attr $net annotated_transition_delta_max] 
	    set delta_tran_min  [get_attr $net annotated_transition_delta_min] 
	    set slack_max       [get_attr $net max_slack]
	    set slack_min       [get_attr $net min_slack]
	    set attr_list	"$delta_delay_max,$delta_delay_min,$delta_tran_max,$delta_tran_min,$slack_max,$slack_min"
	    set xlist 		[lappend xlist "$net_name,$attr_list"]
	    #puts "**Info:: $net_name,$attr_list" 
	    set si_nets($net_name) "$attr_list"
    	}
	return $xlist
    }


     set all_nets 		[get_nets -hier *]; 
     puts "**Info : NonFiltered Nets :: [sizeof_collection $all_nets]"
     set filter_delta	[get_nets $all_nets -quiet -filter "annotated_delay_delta_max >= $noise_th || annotated_delay_delta_min <= -$noise_th"]
     puts "**Info : XtkFiltered Nets :: [sizeof_collection $filter_delta]  @ threshold |$noise_th|"
     set filter_delta_cp 		[get_nets  -quiet  $filter_delta -filter "is_clock_network==true"]; 
     puts "**Info : ClkFiltered Nets :: [sizeof_collection $filter_delta_cp]  @ threshold |$noise_th|"
     set filter_delta_dp 		[get_nets  -quiet  $filter_delta -filter "is_clock_network==false"]; 
     puts "**Info : DatFiltered Nets :: [sizeof_collection $filter_delta_dp]  @ threshold |$noise_th|"


     array unset net_map
     if {[sizeof_collection $filter_delta_cp] > 0 } { set net_map(cp) $filter_delta_cp }
     if {[sizeof_collection $filter_delta_dp] > 0 } { set net_map(dp) $filter_delta_dp }
     puts "**Info : Open output files once completed message appears , File=$fileout\* !"
     
     foreach ref [lsort [array names net_map]] {
	     set fileout1 "${fileout}.$ref.rpt"
	     set fileout2 "${fileout}.$ref.csv"
	     set fileout3 "${fileout}.$ref.txt"

	     set out1 [open $fileout1 w+]
	     set out2 [open $fileout2 w+]
	     set sizex [sizeof_collection $net_map($ref)]
	     set i 0
	     set j [format "%0.0f" [expr 0.050001 * $sizex]]
	     set k 0
	     set l 0
	     puts $out1 "****************************************"
	     puts $out1 "Report : Attribute $ref Noise Threshold = $noise_th "
	     puts $out1 "Design : [get_object_name [current_design]]"
	     puts $out1 "Version: $sh_product_version"
	     puts $out1 "Date   : [date]"
	     puts $out1 "****************************************"
	     puts $out1 ""
	     puts $out1 "Object          delay_delta_max delay_delta_min tran_delta_max tran_delta_min"
	     puts $out1 "\--------------------------------------------------------------------------------"
             set skip_loop 0
             puts $out2 "#net,#delta_delay_max,#delta_delay_min,#delta_tran_max,#delta_tran_min,#slack_max,#slack_min"
	     if { $skip_loop == 0 } {
                foreach_in_collection netx $net_map($ref) {
		    incr i
		    incr k
		    if {$k >$j } {
			puts "			-Processed $i/$l | $sizex  | [expr 100*$i/$sizex ]% @ [date] ...."  
	    		set k 0
			#break;
	    	    }
		    set data     [sta_qc_get_net_noise_stat [get_nets $netx]]
		    set data_arr [split $data ","]
		    puts $out1 "[lrange $data_arr 0 4]"
		    puts $out2 "$data"
	        }
             }
	     puts "			-Processed $i/$l | $sizex  | [expr 100*$i/$sizex ]% @ [date] ...."  
         
	     close $out2
	     close $out1
             catch { sh cat $fileout2 |  column -t -s "," | sort -n -k 2  >  $fileout3 }             
	     puts "**Info :  Open output file once completed message appears , File=$fileout1 !" 
	     puts "**Info :  Open output file once completed message appears , File=$fileout2 !"
	     puts "**Info :  Open output file once completed message appears , File=$fileout3 !"

     }
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qc_get_noise_attr
