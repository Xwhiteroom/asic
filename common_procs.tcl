##------------------------------------------------------------------
## ProcNameStart  : sta_qual_io_map
## ProcArguments  : sta_qual_io_map ports
## ProcDependency :  
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_io_map ports {
     global synopsys_program_name pt_shell_mode
     set place_hold 1;proc x_sort_clk { clocks} {
            set clocks [get_clocks -quiet $clocks]
            set listx [list]
            foreach_in_collection clk $clocks {
                if { [sizeof_collection [get_attribute -quiet $clk sources]] > 0 } {
                        lappend listx "[get_attribute -quiet $clk period]:[get_object_name $clk]"
                }
            }
            set listx [lsort -increasing $listx]
            return $listx
        }
        catch { suppress_message SEL-003 }
        set collection_list [list ]
        foreach_in_collection port [get_ports -quiet $ports] {

                set port [get_object_name $port]
                set clocks ""
                set fin_out "0"
                set direction [get_attribute -quiet [get_ports -quiet $port ] direction]
                if { $direction == "in"} {
                        if { [info exist pt_shell_mode] } {
                            set cone [all_fanout -quiet -from [get_ports -quiet $port] -endpoints_only -flat]
                            set fin_out [sizeof_collection [get_pins -quiet  [all_fanout -quiet -trace_arcs enabled -from $port -pin_level 1  -flat] -filter "direction==in and full_name !=$port"]]
                        } else {
                            set cone [all_fanout        -from [get_ports -quiet $port] -endpoints_only -flat]
                            set fin_out [sizeof_collection [get_pins -quiet  [all_fanout        -trace_arcs enabled -from $port -pin_level 1  -flat] -filter "direction==in and full_name !=$port"]]
                        }
                } elseif {$direction == "out"} {
                        if { [info exist pt_shell_mode] } {
                            set cone [all_fanin -quiet -to [get_ports -quiet $port] -startpoints_only -flat]
                            set fin_out [sizeof_collection [get_pins -quiet  [all_fanin -quiet  -trace_arcs enabled -to $port -pin_level 1  -flat] -filter "direction==out and full_name !=$port"]]
                        } else {
                            set cone [all_fanin        -to [get_ports -quiet $port] -startpoints_only -flat]
                            set fin_out [sizeof_collection [get_pins -quiet  [all_fanin         -trace_arcs enabled -to $port -pin_level 1  -flat] -filter "direction==out and full_name !=$port"]]
                        }
                } else {
                        set cone    [remove_from_collection [get_port -quiet $port] [get_port -quiet  $port]]
                        set fin_out "bidi"
                }
                if { [sizeof_collection $cone] > 0 } {
                        set cone   [ get_pins -quiet -of_object [get_cells -quiet -of_object $cone] -filter "is_clock_pin==true"]
                        set clocks [join [x_sort_clk [lsort -unique [get_object_name [get_attribute -quiet $cone clocks]]]] " "]

                }
                set clk_size [llength $clocks]
                lappend collection_list "START,$port,$direction,$fin_out,$clocks,$clk_size,END"
        }
        catch { unsuppress_message SEL-003 }

        return $collection_list

}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_io_map
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_io_parse_timing_point
## ProcArguments  : sta_qual_io_parse_timing_point path vt_patterns debug
## ProcDependency :  
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_io_parse_timing_point {path vt_patterns debug} {
    set points          [get_attr -quiet  $path points]          
    set dly_rc          0.000000
    set dly_si          0.000000    
    set dly_dv          0.000000
    set dis_x           0.0
    set dis_y           0.0
    set cap_T           0.000
    set cap_W           0.000
    set cap_P           0.000
    set res_T           0.000
    set old_arr         0.000000
    set old_xcor        [format "%.1f" [expr (0 + [get_attr -quiet  [get_attr -quiet  $path startpoint] x_coordinate] + 0)/1000] ]
    set old_ycor        [format "%.1f" [expr (0 + [get_attr -quiet  [get_attr -quiet  $path startpoint] y_coordinate] + 0)/1000] ]

    array unset vt_dly vt_regexp
    foreach vt_alias $vt_patterns {
        set vt   [lindex [split $vt_alias ":"] 0]
        set mark [lindex [split $vt_alias ":"] 1]
        set vt_regexp($vt)              "dly_$mark"
        set vt_dly(dly_$mark)            $dly_dv
    }

    #set  debug 1
    set thru_string ""
    set path_type [get_attr $path path_type]
    if { $debug == "1" } { puts "\t\t\t\tResistance,Capacitance(T),Capacitance(W),Capacitance(P),TravelX,TravelY,CellDly,XtlkDly,RCDly,StageDly,Arrival,Direction,Pin";}
    foreach_in_collection point $points {  
	set pin       [get_object_name [get_attr -quiet  $point object ] ]
        set direction [get_attr -quiet  [get_attr -quiet  $point object ] direction]


	set arr       [format "%.6f" [get_attr -quiet  $point arrival] ]
        set stage     [expr $arr - $old_arr]
        set old_arr   $arr


        set xcor     [format "%.1f" [expr (0 + [get_attr -quiet  [get_attr $point object ] x_coordinate] + 0 )/1000] ]
	set xstage   [expr $xcor - $old_xcor]
        set old_xcor $xcor
        
        
        set ycor     [format "%.1f" [expr (0 + [get_attr  -quiet  [get_attr $point object ] y_coordinate] + 0 ) /1000] ]
        set ystage   [expr $ycor - $old_ycor]
        set old_ycor $ycor

        if { $direction == "in"}  { 
            set net             [get_nets -quiet -of_object [get_pins -quiet $pin]]
            set crosstalk       [expr 0.000 + [get_attr -quiet  $net annotated_delay_delta_$path_type] + 0.000]     
            set total_cap       [expr 0.000 + [get_attr -quiet  $net total_capacitance_$path_type] + 0.000] 
            set pin_cap         [expr 0.000 + [get_attr -quiet  $net pin_capacitance_$path_type] + 0.000]     
            set wire_cap        [expr 0.000 + [get_attr -quiet  $net wire_capacitance_$path_type] + 0.000]     
            set total_res       [expr 0.000 + [get_attr -quiet  $net net_resistance_$path_type] + 0.000]     

            
            set dly_si          [expr $dly_si + $crosstalk] ;
            set dly_rc          [expr $dly_rc + $stage - $crosstalk] ; 
            set cap_T           [expr $cap_T  + $total_cap]
            set cap_P           [expr $cap_P  + $pin_cap]
            set cap_W           [expr $cap_W  + $wire_cap]
            set res_T           [expr $res_T  + $total_res]

            set thru_string     "$thru_string -through $pin" 
        }

        if { $direction == "out"} { 
            set dly_dv          [expr $dly_dv + $stage] 
            set lib_pin         [get_object_name [get_lib_pins -quiet -of_object [get_pins -quiet $pin]]]
            foreach vt_type [array names vt_regexp] {
                #puts "$vt_type $vt_regexp($vt_type)"
                if { [regexp $vt_type $lib_pin] } {
                    set key_match $vt_regexp($vt_type)
                    set vt_dly($key_match) [expr $vt_dly($key_match) + $stage]
                    #puts "$key_match Match  $vt_dly($key_match) + $stage"
                }
            }
        }
        set dis_x [expr $dis_x + abs($xstage)]
        set dis_y [expr $dis_y + abs($ystage)]
        set vt_dly_list ""
        foreach vt [array names vt_dly] {
            set vt_dly_list "$vt_dly_list $vt:$vt_dly($vt)"
        }
        regsub -all {^ } $vt_dly_list {} vt_dly_list
        #puts "\t\t\t\t$dis_x|$dis_y,$xstage|$ystage,DV=$dly_dv,RC=$dly_rc,SI=$crosstalk,$stage,$arr,$direction,$pin"
        if { $debug == "1" } { puts "\t\t\t\t$res_T,$cap_T,$cap_W,$cap_P,$dis_x,$dis_y,$dly_dv=$vt_dly_list,$dly_si,$dly_rc,$stage,$arr,$direction,$pin";}

    }
    regsub -all {^\s+-through} $thru_string {-from} thru_string
    return "$dly_dv,$vt_dly_list,$dly_rc,$dly_si,$dis_x,$dis_y,$res_T,$cap_T,$cap_W,$cap_P,$thru_string"

}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_io_parse_timing_point
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_io_path_attr
## ProcArguments  : sta_qual_io_path_attr path id qattr
## ProcDependency : sta_qual_io_parse_timing_point 
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_io_path_attr {path id qattr} {
           array unset path_attr 
           # ID attr
           set path_attr(id)             $id 
           set path_attr(start_pin)      [get_object_name [get_attr -quiet $path startpoint]]
           set path_attr(start_clk)      [get_object_name [get_attr -quiet $path startpoint_clock]]           
           set path_attr(end_pin)        [get_object_name [get_attr -quiet $path endpoint]]
           set path_attr(end_clk)        [get_object_name [get_attr -quiet $path endpoint_clock]]
           # Slack attr
           set path_attr(slack)          [get_attr -quiet $path slack]
           set path_attr(slack_norm)     [get_attr -quiet $path normalized_slack]
           #set path_attr(dly_norm)       [get_attr [get_clocks $path_attr(end_clk)] period]
           
           # Skew attr
           set path_attr(crpr)           [get_attr -quiet $path common_path_pessimism]            
           set path_attr(start_lat)      [get_attr -quiet $path startpoint_clock_latency]
           set path_attr(end_lat)        [get_attr -quiet $path endpoint_clock_latency]
           set path_attr(start_edge)     [get_attr -quiet $path startpoint_clock_open_edge_value]
           set path_attr(end_edge)       [get_attr -quiet $path endpoint_clock_open_edge_value]
           set path_attr(dly_in)         [get_attr -quiet $path startpoint_input_delay_value]
           set path_attr(dly_out)        [get_attr -quiet $path endpoint_output_delay_value]
 



           set path_attr(diff_lat)       [expr $path_attr(start_lat) - $path_attr(end_lat) + 0]                                 ; # puts "done1"
           set path_attr(dly_skew)       [expr 0 + $path_attr(start_lat) - $path_attr(end_lat)  - $path_attr(crpr)  + 0]        ; # puts "done2"
           set path_attr(dly_norm)       [expr 1.000*(0 + $path_attr(end_edge) -  $path_attr(start_edge)  + 0) ];               ; # puts "done3"



           # Data attr
           set debug "0" 
           # VT Flavours

           set VT_LIST [list 6TL_C:LVT 6TSL_C:SLVT 6TR_C:RVT] 
           set VT_LIST [list ".*_lvt.*l10:LVT10" ".*_lvt.*l08:LVTL08" ".*_slvt.*:SLVT" ".*_rvt.*:RVT"] 
           set VT_LIST [list ".*_lvt.*:LVT"  ".*_slvt.*:SLVT"] 

           set data_path                [split [sta_qual_io_parse_timing_point  $path $VT_LIST $debug] ","]  
           set path_attr(dly_dataC)     [lindex $data_path 0]
           foreach xdata [lindex $data_path 1] { 
              set dly_vt_attr [lindex [split $xdata ":"] 0]
              set dly_vt_val  [lindex [split $xdata ":"] 1]
              set path_attr($dly_vt_attr) $dly_vt_val
          }

           set path_attr(dly_dataR)     [lindex $data_path 2]
           set path_attr(dly_dataX)     [lindex $data_path 3]
           set path_attr(phy_X)         [lindex $data_path 4]
           set path_attr(phy_Y)         [lindex $data_path 5]
           set path_attr(phy_XY)        [expr $path_attr(phy_X) + $path_attr(phy_Y)]
           set path_attr(res_T)         [lindex $data_path 6]
           set path_attr(cap_T)         [lindex $data_path 7]
           set path_attr(cap_W)         [lindex $data_path 8]
           set path_attr(cap_P)         [lindex $data_path 9]
           set path_attr(grt)           [lindex $data_path 10]
           set path_attr(arr_time)      [get_attr -quiet $path arrival]           
           set path_attr(dly_data)      [expr $path_attr(arr_time) - $path_attr(start_lat) + 0] ;   ; # puts "done4"   

           foreach var [array names hier_sub_cmd] {
                regsub -all $hier_sub_cmd($var) $path_attr(grt) "\$\{$var\}" path_attr(grtx)
                regsub -all $hier_sub_cmd($var) $path_attr(grt) "" path_attr(grth)

           }

           # Margin Attr
           set lib_time1                [get_attr -quiet $path endpoint_hold_time_value];
           set lib_time2                [get_attr -quiet $path endpoint_setup_time_value];
           set lib_time3                [get_attr -quiet $path endpoint_removal_time_value];
           set lib_time4                [get_attr -quiet $path endpoint_recovery_time_value]
           set uncert                   [get_attr -quiet $path clock_uncertainty]

           set path_attr(req_time)      [get_attr -quiet $path required]           
           set path_attr(dly_libt)      [expr 1.000*(0 + $lib_time1 + $lib_time2 + $lib_time3 + $lib_time4 - $path_attr(dly_out)  + 0)] ; # puts "done5"
           set path_attr(dly_marg)      [expr -1.000*(0 + $path_attr(req_time) - $path_attr(end_lat) - $path_attr(crpr) + $path_attr(dly_libt) + $path_attr(dly_out) + 0) + 0] ; ; # puts "done6"
           set path_attr(dly_adjt)      [expr $path_attr(dly_norm) + $path_attr(req_time) - $path_attr(arr_time) - $path_attr(slack) + 0  ] ; # puts "done7"

           incr id
           #puts "\n"
           set out [list]
           #foreach attr [lsort [array names path_attr]] {
           #     puts "[format "%08d  %20s %s" $id $attr $path_attr($attr)]"
           #}
           foreach attr $qattr {
                if { ![info exist path_attr($attr)]  } { set path_attr($attr) "NA" }
                #puts "[format "%08d  %20s %s" $id $attr $path_attr($attr)]"
                lappend out "$attr,$path_attr($attr)"
           }
           return $out
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_io_path_attr
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_irt
## ProcArguments  : sta_qual_irt args
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_irt args {
    global ssi_sta_tool_unit_dly
    set cmd "redirect  -variable rpt_var       { report_timing   $args  }"
    set cmd "redirect  -file     temp.file_var { report_timing   $args  }"

    puts "# $cmd"
    #echo "$cmd"   > temp.file_var
    eval "$cmd"
    #source "./temp.file_var"
    set crpr     none
    set startc   none
    set endc     none
    set infile [open ./temp.file_var ]
    
    while { [gets $infile x] >= 0 } {

	#puts "$x--->E: $endc -->S: $startc"
        if { [regexp $crpr $x] && $crpr != "none"} {
            puts "\033\[1;31m$x"
        } elseif { [regexp "<-|->" $x]} {
            puts "\033\[1;31m$x\033\[1;35m"
        } elseif { [regexp "Uncertainty" $x]} {
            puts "\033\[1;31m$x\033\[0m"
       } elseif { [regexp "Phase Shift" $x]} {
	    set freq     "1.0"	   
	    catch { set freq	 [format "%0.1f" [expr $ssi_sta_tool_unit_dly/ [lindex $x 3]]]}
            puts "\033\[1;31m$x \033\[1;35m@${freq}_MHz\033\[0m"
        } elseif { [regexp "Slack Time" $x]} {
	    set xfreq     "1.0"	   
	    set period    [expr $ssi_sta_tool_unit_dly/$freq]
	    catch { set xperiod	  [expr  $period - [lindex $x 3]] }
	    set comment ""	
	    if { $period == "0.000" } {
	    	catch { set xperiod	  $period }
		set comment        "HalfCycle_Path!"	
	    } else {
	    	catch { set xperiod	  [expr  $period - [lindex $x 3]] }
	    }
	    catch { set xfreq	 [format "%0.1f" [expr $ssi_sta_tool_unit_dly /$xperiod]]}
            puts "\033\[1;31m$x \033\[1;35m@LoS=${xfreq}_MHz / Target=${freq}_MHz $comment\033\[0m"
        } elseif { [regexp " $endc" $x] && $endc != "none"} {
            puts "\033\[1;35m$x\033\[0m"
        } elseif { [regexp " $startc" $x] && $startc != "none" && $endc != "none"} {
            puts "\033\[1;35m$x" ;
        } elseif { [regexp "data arrival" $x]} {
            puts "\033\[0m$x"
        } else {
            puts "$x"
        }    

        if { [regexp "Last common pin:" $x]} { 
            set crpr [lindex $x end]; 
            #regsub -all {\[|\]} $crpr {.} crpr ; 
            #regsub -all {\]} $crpr {\\]} crpr ;
            regsub -all {\[|\]} $crpr {.} crpr ; 
        }
        
        if { [regexp "Startpoint:|Beginpoint:" $x]} { 
            set startc [lindex $x 1];
            #regsub -all {\[} $startc {\\[} startc ; 
            #regsub -all {\]} $startc {\\]} startc ;
            regsub -all {\[|\]} $startc {.} startc ;
       
        }

        if { [regexp "Endpoint:" $x]} { 
            set endc [lindex $x 1]; 
            #regsub -all {\[} $endc {\\[} endc; 
            #regsub -all {\]} $endc {\\]} endc;   
            regsub -all {\[|\]} $endc {.} endc ;   
            set crpr "none"
            set startc "none"              
        }
    }    
    close $infile
    #puts "\033\[1;34mStart: $startc\033\[0m"
    #puts "\033\[1;34m  End: $endc\033\[0m"
    #puts "\033\[1;31m CRPR: $crpr\033\[0m"
    puts -nonewline "\033\[1;31m\033\[0m"
    #
    #echo $rpt_var
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_irt
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_mask_hfn_nets
## ProcArguments  : sta_qual_mask_hfn_nets hfn_threshold ideal_net_delay ideal_cell_delay ideal_transition
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_mask_hfn_nets {hfn_threshold ideal_net_delay ideal_cell_delay ideal_transition} {
        global synopsys_program_name pt_shell_mode
	set ALL_NETS  [get_nets -hier * -top_net]
        echo "## Mask HFN: hfn_threshold=$hfn_threshold / ideal_net_delay=$ideal_net_delay / ideal_cell_delay=$ideal_cell_delay / ideal_transition=$ideal_transition" > ./warn_masked_hfn_objects.rpt

	foreach_in_collection net $ALL_NETS {
	  set net_pins [all_connected $net -leaf]
	  if {[sizeof $net_pins] < $hfn_threshold } {
	    continue;
	  }
	  set net_name [get_object_name $net]

	  foreach_in_collection pin $net_pins {
	    if {[filter_collection  $pin "direction==out"] > 0} {
	      set pin_name	[get_object_name $pin]
              set cell_obj      [get_cells -of_objects [get_pins $pin]]
              set inpins        [get_pins -of_objects $cell_obj -filter "direction==in"]

	      echo "## high fanout net: $net_name ([sizeof $net_pins])"  >> ./warn_masked_hfn_objects.rpt
	      echo "  set_annotated_delay -net  $ideal_net_delay  -from \[get_pins $pin_name\]" >> ./warn_masked_hfn_objects.rpt
	      echo "  set_annotated_delay -cell $ideal_cell_delay -to   \[get_pins $pin_name\]" >> ./warn_masked_hfn_objects.rpt
	      echo "  set_annotated_delay -cell $ideal_cell_delay -from \[get_pins $pin_name\]" >> ./warn_masked_hfn_objects.rpt
	      #echo "  set_annotated_delay -cell $ideal_cell_delay -to   \[get_pins $pin_name\] -from \[get_pins \$inpins\]" >> ./warn_masked_hfn_objects.rpt
              echo "  set_timing_derate -pocvm_coeff  -late  0.0 -cell_delay $cell_obj" >> ./warn_masked_hfn_objects.rpt
              echo "  set_timing_derate -pocvm_coeff  -early 0.0 -cell_delay $cell_obj" >> ./warn_masked_hfn_objects.rpt
	      echo "  set_annotated_transition  $ideal_transition       \[get_pins $pin_name\]" >> ./warn_masked_hfn_objects.rpt
	      echo "" >> ./warn_masked_hfn_objects.rpt

	      set_annotated_delay -net  $ideal_net_delay  -from   $pin
	      set_annotated_delay -cell $ideal_cell_delay -to    $pin
	      set_annotated_delay -cell $ideal_cell_delay -from  $pin
              #set_annotated_delay -cell  -load_delay  cell $ideal_cell_delay -to   [get_pins $pin_name] -from [get_pins $inpins]
              set_timing_derate -pocvm_coeff  -late 0.0 -cell_delay $cell_obj
              set_timing_derate -pocvm_coeff  -early 0.0 -cell_delay $cell_obj
	      set_annotated_transition $ideal_transition $pin

	    }

	  }
	}
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_mask_hfn_nets
##------------------------------------------------------------------


