##------------------------------------------------------------------
## ProcNameStart  : sta_qc_report_unclocked
## ProcArguments  : sta_qc_report_unclocked rpt_file
## ProcDependency : ls 
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qc_report_unclocked rpt_file {
    #check_timing -override_defaults no_clock
    check_timing -override_defaults no_clock -verbose > $rpt_file
    set rpt_file [file normalize $rpt_file]
    puts "\t\t**Start Parsing $rpt_file"
    set in [open $rpt_file]
    set start 0
    array unset found_pins
    array unset found_pins_pat

    while { [gets $in line] >= 0 } {
        if { $start > 1 & $line != "" & $line != "0" & $line != "1" } {  
            set found_pins($line) 1
            regsub -all {\d+} $line {*} lin_pat
            set found_pins_pat($lin_pat) 1
            incr start
        }
        if { [regexp "Warning:" $line] & [regexp "pins with no clock" $line] } { 
            set pins_base [lindex [split $line " "] 3]
            set comment   "$line"
            incr start
        }
        if { [regexp "\-\-\-\-\-" $line] & $start == 1  } {  incr start ; }       
    }
    close $in
    set i 0
    set out1 [open $rpt_file.full.rpt w+]
    set out2 [open $rpt_file.comp.rpt w+]
    puts $out1 "#Size #Pin_Name #Comment"
    puts $out2 "#Size #Pin_Pat  #Comment"

    foreach x [array names found_pins] {
        incr i
        set comment_pin "FATAL"
        if {[get_attr -quiet [get_pins -quiet $x] case_value] != ""}  { set comment_pin "STATIC:[get_attr -quiet [get_pins -quiet $x] case_value]" }
        if {[get_ports -quiet [all_fanin -to $x -flat -trace_arcs all] ] != ""} { set comment_pin "SOURCE:[get_object_name [get_ports -quiet [all_fanin -to $x -flat -trace_arcs all] ]]" }
        puts $out1 "1 $x $comment_pin"
    }
    puts $out1 "# Summarizing : Total $i : $comment"
    close $out1



    set j 0
    foreach x [array names found_pins_pat] {
        incr j
        set size [sizeof_collection [get_pins -quiet $x]]
        set comment_pin "FATAL"
        if {[get_attr -quiet [get_pins -quiet $x] case_value] != ""}  { set comment_pin "STATIC:[get_attr -quiet [get_pins -quiet $x] case_value]" }
        if {[get_ports -quiet [all_fanin -to $x -flat -trace_arcs all] ] != ""} { set comment_pin "SOURCE:[get_object_name [get_ports -quiet [all_fanin -to $x -flat -trace_arcs all] ]]" }
        puts $out2 "$size $x $comment_pin"
    }
    puts $out2 "# Summarizing : Total $j : $comment"
    close $out2
    ls ${rpt_file}*

}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qc_report_unclocked
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_add_annotations_for_inst
## ProcArguments  : sta_qual_add_annotations_for_inst clk2q setup clk_pins out_pins data_pins collection
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_add_annotations_for_inst {clk2q setup clk_pins out_pins data_pins collection} {
    global synopsys_program_name pt_shell_mode
    foreach_in_collection mem $collection {
        incr i
        set mem_name [get_object_name $mem]
        foreach clk_pin $clk_pins {
            set c_pins [get_pins -quiet $mem_name/$clk_pin]
            if { [sizeof_collection $c_pins] > 0 } {
                set check ""
                # For Clk to Q arcs
                if { $clk2q != "none"} {
                    foreach out_pin $out_pins {
                        set q_pins [get_pins -quiet $mem_name/$out_pin]
                        if { [sizeof_collection $q_pins] > 0 } {
                            puts "**STA_SDC_INFO:  $i)	Annotating mem clk2q arc for $mem_name{$clk_pin->$out_pin} as ${clk2q}ps  (size [sizeof_collection $q_pins])"
                            set_annotated_delay -cell  -from [get_pins $c_pins] -to [get_pins $q_pins]  $clk2q ;
                                            } else {
                                                puts "**STA_SDC_WARN:  $i)	Missing    mem clk2q arc for $mem_name{$clk_pin->$out_pin}"
                                            }
                                    }
                            }
                            # For Clk to data arcs
                            if { $setup != "none"} {
                                foreach data_pin $data_pins {
                                    set d_pins [get_pins -quiet $mem_name/$data_pin]
                                    if { [sizeof_collection $d_pins] > 0 } {
                                        puts "**STA_SDC_INFO:  $i)	Annotating mem setup arc for $mem_name{$clk_pin->$data_pin} as ${setup}ps  (size [sizeof_collection $d_pins])"
                                        set_annotated_check -setup  -clock  rise -from [get_pins $c_pins] -to [get_pins $d_pins] $setup
                                            } else {
                                                puts "**STA_SDC_WARN:  $i)	Missing    mem setup arc for $mem_name{$clk_pin->$data_pin}"
                                            }
                                    }
                            }
                    }
            }
    }
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_add_annotations_for_inst
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_bad_boyz
## ProcArguments  : sta_qual_bad_boyz cell_list slack_lesser_than
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_bad_boyz {cell_list slack_lesser_than} {
        set cells [get_cells -quiet -hierarchical [list $cell_list] -filter "is_hierarchical==false"]
        set output_pins [get_pins -quiet -of_object $cells -filter "direction==out && max_slack <= $slack_lesser_than"]
        set input_pins  [get_pins -quiet -of_object $cells -filter "direction==in && max_slack <= $slack_lesser_than && (is_rise_edge_triggered_data_pin==true || is_fall_edge_triggered_data_pin==true)"]
        puts "**Info : Outputs=[sizeof_collection $output_pins]"
        puts "**Info :  Inputs=[sizeof_collection $input_pins]"

        set all_pins    [add_to_collection $input_pins $output_pins]
        set outfile     "[pwd]/temp.eco.slack_lt.$slack_lesser_than.tcl"
        set outx [open $outfile w+]
        array unset eco_cells
        foreach_in_collection pin $all_pins {
                set cell_name [get_object_name [get_cells -of_object $pin]]
                set ref_name  [get_attribute   -quiet [get_cells $cell_name  ] ref_name]
                set max_slack [get_attribute   -quiet $pin max_slack]
                set min_slack [get_attribute   -quiet $pin min_slack]
                set indly     [get_attribute   -quiet [index_collection [sort_collection [get_pins  $cell_name/* -filter "direction==in"]  max_arrival] end] max_arrival]
                set outdly    [get_attribute   -quiet [index_collection [sort_collection [get_pins  $cell_name/* -filter "direction==out"] max_arrival] end] max_arrival]
                set delay     "NA"
                catch { set delay     [expr 0.00 + $outdly - $indly + 0.000 ] }
                puts $outx " catch { size_cell $cell_name $ref_name } ; #OLD=$ref_name,DELAY=$delay,SETUP=$max_slack,HOLD=$min_slack "
        }
        close $outx
        puts "**Open file :  $outfile"
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_bad_boyz
##------------------------------------------------------------------


