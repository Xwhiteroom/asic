## ProcArguments  : get_non_buf_inv_fanout in_out pat args
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc get_non_buf_inv_fanout {in_out pat args} {
    
    if { $in_out == "out"} {
        set cone_org  [all_fanout -from  $pat -only_cells -flat]
    } else {
        set cone_org  [all_fanin -to  $pat -only_cells -flat]        
    }

    set cone $cone_org
    foreach ref_pat $args {
        if {$ref_pat  != ""} { 
            set main_filter  [get_cells -quiet -filter "ref_name=~$ref_pat" $cone ]
            set cone         [remove_from_collection $cone $main_filter]
            set data         [format "**  Filtered %20s : Pattern %20s : Remaining %20s : Original %20s" [sizeof_collection $main_filter] $ref_pat [sizeof_collection $cone] [sizeof_collection $cone_org]] 
            puts "$data"
        }
    }
  return $cone
}
