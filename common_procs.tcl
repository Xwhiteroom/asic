		global GC_NODES_max_path               GC_NODES_min_path               GC_NODES_max_transition         GC_NODES_max_capacitance       GC_NODES_glitch                
		global GC_NODES_min_period             GC_NODES_min_pulse_width        GC_STA_ECO_MLDIR                GC_STA_ECO_IP                  IP_PROJ                                                                            
		print_stage blue \"** STA_GLB_INFO: Adding Tech Setting\" 
		 
		set    GC_STA_ECO_IP                   \$sta_qual_global_repo 
		 
		set    GC_STA_ECO_TECH                 \$TRACK 
