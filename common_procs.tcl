##------------------------------------------------------------------
## ProcNameStart  : sta_qual_noisy_boyz
## ProcArguments  : sta_qual_noisy_boyz xtlk_min xtlk_max tag nodes
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_noisy_boyz {xtlk_min xtlk_max tag nodes} {
    set xall_fanin       [filter_collection [get_pins -of_object [all_fanin -quiet -to [get_pins -quiet $nodes] -flat -only_cells]] "direction==in && is_hierarchical==false && max_slack<1"]
    set nets             [get_nets -of_object  $xall_fanin -filter "(annotated_delay_delta_max>$xtlk_max || annotated_delay_delta_min <$xtlk_min)"]
    set eco_file         "$tag.noisyboyz.xtlk_node.Min$xtlk_min.Max$xtlk_max.SizeNets[sizeof_collection $nets].SizeNode[sizeof_collection [get_pins -quiet $nodes]].eco.tcl" 
    set ofile [open $eco_file w+]
    array unset cell_weight 
    foreach_in_collection net $nets {
        set pin       [get_attribute   -quiet $net leaf_drivers]
        set res       [get_attribute   -quiet $net net_resistance_max]
        set wcap      [get_attribute   -quiet $net wire_capacitance_max]
        set tcap      [get_attribute   -quiet $net total_capacitance_max]
        set xtlk      [get_attribute   -quiet $net annotated_delay_delta_max]
        set cell_name [get_object_name [get_cells -of_object $pin]]
        set ref_name  [get_attribute   -quiet [get_cells $cell_name  ] ref_name]
        set max_slack [get_attribute   -quiet $pin max_slack]
        set min_slack [get_attribute   -quiet $pin min_slack]
        set min_slack [get_attribute   -quiet $pin min_slack]
        set indly     [get_attribute   -quiet [index_collection [sort_collection [get_pins  $cell_name/* -filter "direction==in"]  max_arrival] end] max_arrival]
        set outdly    [get_attribute   -quiet [index_collection [sort_collection [get_pins  $cell_name/* -filter "direction==out"] max_arrival] end] max_arrival]
        set delay     "NA"
        catch { set delay     [expr 0.00 + $outdly - $indly + 0.000 ] }

	set in_tran 0.000
	set out_tran 0.000
        catch { set in_tran  [lindex [lsort [get_attr [get_pin $cell_name/* -filter "direction==in"] actual_transition_max]] end] }
        catch { set out_tran [lindex [lsort [get_attr [get_pin $cell_name/* -filter "direction==out"] actual_transition_max]] end] }

        set pc_10_in [expr 0.2*$in_tran] 
        set diff     [expr $out_tran - $in_tran] 
        set comment  "NORMAL"
        if { $diff > 0 } { set comment "POOR"}
        if { $diff < 0 } { set comment "GOOD"}
        if { $diff > 0 && $diff > $pc_10_in } { set comment "VERYPOOR"}
	if { [info exist cell_weight($cell_name)] } { 
		incr cell_weight($cell_name) 
	} else {
		set cell_weight($cell_name)  0
	}
        puts $ofile " catch { size_cell $cell_name $ref_name } ; #OLD=$ref_name; WEIGTH=$cell_weight($cell_name), COMMENT=$comment; TRAN=$in_tran->$out_tran; SETUP=$max_slack; HOLD=$min_slack; DELAY=$delay; XTLK=$xtlk; RESISTANC=$res; WIRECAP=$wcap; TCAP=$tcap;"
    }
    close $ofile
    puts "<INFO> : Open [file normalize $eco_file]"
}
