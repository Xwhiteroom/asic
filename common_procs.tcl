##------------------------------------------------------------------
## ProcNameStart  : sta_qual_get_potential_clock_sources
## ProcArguments  : sta_qual_get_potential_clock_sources args
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_get_potential_clock_sources args {
    global synopsys_program_name pt_shell_mode
    # Extract Potential Clock Ports
    set base_clock_ports ""
    set reg_clk_pin_collection [get_pins -quiet [all_registers -clock_pins]]
    foreach_in_collection in_port [all_inputs] {
        if { [info exist pt_shell_mode] } {
            set fanout_clk_reg [remove_from_collection -intersect $reg_clk_pin_collection [get_pins -quiet [all_fanout -quiet -from $in_port -flat -endpoints_only ]]]
        } else {
            set fanout_clk_reg [remove_from_collection -intersect $reg_clk_pin_collection [get_pins -quiet [all_fanout        -from $in_port -flat -endpoints_only ]]]
        }
        if { [sizeof_collection $fanout_clk_reg] } {
            set base_clock_ports [add_to_collection $in_port $base_clock_ports]
        }
    }
    foreach_in_collection out_port [all_outputs] {
        if { [info exist pt_shell_mode] } {
            set fanin_clk_port [get_ports -quiet [all_fanin -quiet -to $out_port -flat -startpoints_only ]]
        } else {
            set fanin_clk_port [get_ports -quiet [all_fanin        -to $out_port -flat -startpoints_only ]]
        }
        set intersect [remove_from_collection  -intersect $fanin_clk_port $base_clock_ports]
        if { [sizeof_collection $intersect] } {
            set base_clock_ports [add_to_collection $in_port $base_clock_ports]
        }
    }
    return $base_clock_ports
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_get_potential_clock_sources
