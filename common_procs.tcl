##------------------------------------------------------------------
## ProcNameStart  : get_module_interface_stats
## ProcArguments  : get_module_interface_stats module_list outdir pba_mode
## ProcDependency : sh , sta_qual_report_attr_cellpin 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc get_module_interface_stats {module_list outdir pba_mode} {
    global CORNER MODE my_flow_control
	suppress_message UITE-479
        suppress_message SEL-003
        file mkdir $outdir
        set outdir [file normalize $outdir]
	set empty_collection [remove_from_collection [get_clocks *] [get_clocks *] ]
        set top_design [get_object_name [current_design ]]


        puts [format "<GC::PROC> Start %-50s  [date]"   "sta_qual_report_summary_path : JSON CellPin Extraction" ]            
        sta_qual_report_attr_cellpin  $outdir/$top_design.$MODE.$CORNER.attr.cellpin.rpt "seq"            
                
        
        



	foreach module $module_list {
		set pathmax_collection $empty_collection
		set pathmin_collection $empty_collection
                puts "**INFO:: Module Under Analysis -- $module File:$outdir/$module.$MODE.$CORNER.*"
		set budget_file  $outdir/$module.$MODE.$CORNER.csv
		set max_file     $outdir/$module.$MODE.$CORNER.pathmax.rpt
		set min_file     $outdir/$module.$MODE.$CORNER.pathmin.rpt

		echo "# Interface Timing Stat for $module " > $budget_file
		set module_insts [get_cells -hier -filter "ref_name == $module"]
		set module_pins  [get_pins -of_object $module_insts]
		puts "         Instances [sizeof_collection $module_insts]  [get_object_name $module_insts]"
		puts "         Pins      [sizeof_collection $module_pins]"
		set i 0
		set j 0
		set k [expr 0.1 *[sizeof_collection $module_pins]]
                echo "#mode,#corner,#module,#pin_ref_name,#pinx,#slack_max,#slack_min,#max_clk,#min_clk" >> $budget_file
		foreach_in_collection inf_pin $module_pins {
                    	incr i
			incr j
			set path_max 		[get_timing_paths -pba_mode $pba_mode -through $inf_pin -delay max]
			set path_min 		[get_timing_paths -pba_mode $pba_mode -through $inf_pin -delay min]
                        set pathmax_clk         [get_object_name [get_attr -quiet $path_max endpoint_clock]]
                        set pathmin_clk         [get_object_name [get_attr -quiet $path_min endpoint_clock]]
			set slack_max          	[get_attr $path_max slack]
			set slack_min          	[get_attr $path_min slack]
			set pinx 		[get_object_name $inf_pin]
			set direction 		[get_attr $inf_pin direction]
			set pin_ref_name        [get_attr [get_pin $pinx ] lib_pin_name]
                        if {$slack_max == ""} { set slack_max INFINITY }
                        if {$slack_min == ""} { set slack_min INFINITY }

                        if {$slack_max != "INFINITY" & $slack_max != "" } { set pathmax_collection  [add_to_collection $pathmax_collection $path_max] }
                        if {$slack_min != "INFINITY" & $slack_min != "" } { set pathmin_collection  [add_to_collection $pathmin_collection $path_min] }


                        echo "$MODE,$CORNER,$module,$pin_ref_name,$pinx,$slack_max,$slack_min,$pathmax_clk,$pathmin_clk" >> $budget_file
			if { $j >= $k} { puts "\t\t[date] $i/[sizeof_collection $module_pins]"; set j 0; }
                }
                report_timing -include_hierarchical_pins -nets -nosplit -input_pins  -crosstalk_delta  -capacitance -transition_time $pathmax_collection > $max_file
                catch { sh python3 $my_flow_control/pd_shell/get_vios.py  --tech    $my_flow_control/project_config/WHI.5LPE.project_tech.json   --mode    $MODE --check max  --corner $CORNER --design $module         --out     $outdir/$module.$MODE.$CORNER.path.max.json     --cellpin $outdir/$top_design.$MODE.$CORNER.attr.cellpin.json    $max_file   }

                report_timing -include_hierarchical_pins -nets -nosplit -input_pins  -crosstalk_delta  -capacitance -transition_time $pathmin_collection > $min_file
                catch { sh python3 $my_flow_control/pd_shell/get_vios.py  --tech    $my_flow_control/project_config/WHI.5LPE.project_tech.json   --mode    $MODE --check min  --corner $CORNER --design $module         --out     $outdir/$module.$MODE.$CORNER.path.min.json     --cellpin $outdir/$top_design.$MODE.$CORNER.attr.cellpin.json    $min_file   }





        }
        unsuppress_message SEL-003
	unsuppress_message UITE-479
        
}
