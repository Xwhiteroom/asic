##------------------------------------------------------------------
## ProcNameStart  : get_path_stats
## ProcArguments  : get_path_stats collection
## ProcDependency :  
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc get_path_stats collection {
    array unset data 
    array unset vdata 

    foreach_in_collection clk1 [all_clocks] {
        set clk1 [get_object_name $clk1]
        foreach_in_collection clk2 [all_clocks] {
                set clk2 [get_object_name $clk2]
                
                set data($clk1.$clk2.min.wns) 0
                set data($clk1.$clk2.max.wns) 0
                set data($clk1.$clk2.min.tns) 0
                set data($clk1.$clk2.max.tns) 0
                set data($clk1.$clk2.min.fep) 0
                set data($clk1.$clk2.max.fep) 0
                set vdata($clk1.$clk2)        0

        }

    }


    foreach_in_collection path $collection {
        set slack [get_attr $path slack]
        set type [get_attr $path path_type]
        set eclk [get_object_name [get_attr $path endpoint_clock]]
        set sclk [get_object_name [get_attr $path startpoint_clock]]

        if { $slack < 0 } {
           incr  data($sclk.$eclk.$type.fep)
           set data($sclk.$eclk.$type.tns) [expr  $data($sclk.$eclk.$type.tns) + $slack]  
           if { $slack < $data($sclk.$eclk.$type.wns) } { set data($sclk.$eclk.$type.wns) $slack }
           set vdata($sclk.$eclk)        1
        }
    }
    foreach id [array names vdata] {
        if { $vdata($id) != 0 } {
            set clk1 [lindex [split $id "."] 0]
            set clk2 [lindex [split $id "."] 1]
            set tag  "Inter:$clk1/$clk2"
            if { $clk1 == $clk2 } { set tag "Intra:$clk1"}
            set datax [format "      Setup/%05d/%06.2f/%02.3f / Hold/%05d/%06.2f/%02.3f %s" $data($clk1.$clk2.max.fep) $data($clk1.$clk2.max.tns) $data($clk1.$clk2.max.wns) $data($clk1.$clk2.min.fep) $data($clk1.$clk2.min.tns) $data($clk1.$clk2.min.wns) $tag]
            regsub -all {/00000/000.00/0.000} $datax "/Clean             " datax
            puts $datax
        }
    }
    #return $datax
}
##------------------------------------------------------------------
## ProcNameEnd    : get_path_stats
