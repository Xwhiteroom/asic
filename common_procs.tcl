## ProcNameStart  : STA_unitdly
## ProcArguments  : STA_unitdly 
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc STA_unitdly {} {
    puts "Unit Dly"
    reset_timing_derate
    reset_timing_derate [current_design]
    set_app_var  timing_update_effort          low
    set_app_var  si_enable_analysis            false

    set_timing_derate                  -early -cell_delay  0.0
    set_timing_derate                  -early -net_delay   0.0
    set_timing_derate -pocvm_guardband -early 0.0
    set_timing_derate -pocvm_coeff     -early 0.0

    set_timing_derate                  -late -cell_delay  1.0
    set_timing_derate                  -late -net_delay   1.0
    set_timing_derate -pocvm_guardband -early 1.0
    set_timing_derate -pocvm_coeff     -early 1.0


    set_timing_derate                  -late  -cell_check  0.0
    set_timing_derate                  -early -cell_check  0.0
    set_timing_derate -pocvm_guardband -early -cell_check  0.0
    set_timing_derate -pocvm_guardband -late  -cell_check  0.0
    set_timing_derate -pocvm_coeff     -early -cell_check  0.0
    set_timing_derate -pocvm_coeff     -late  -cell_check  0.0

    set_clock_uncertainty -setup -from [all_clocks] -to [all_clocks] 0
    set_clock_uncertainty -hold  -from [all_clocks] -to [all_clocks] 0
    remove_clock_jitter   -clock       [get_clocks]

}
