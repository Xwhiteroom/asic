proc pt_qor {dirx iter min_max_cell_power_eco_save} {
      global MODE CORNER    GC_STA_ECO_PBA GC_STA_ECO_DYN GC_STA_ECO_LKG GC_STA_ECO_POWER
      set cmd_str "current_instance"
      if { [regexp "min"   $min_max_cell_power_eco_save] } {  set cmd_str "$cmd_str;\n pt_qor_timing                   $dirx $iter min"  }
      if { [regexp "max"   $min_max_cell_power_eco_save] } {  set cmd_str "$cmd_str;\n pt_qor_timing                   $dirx $iter max"  }
      if { [regexp "cell"  $min_max_cell_power_eco_save] } {  set cmd_str "$cmd_str;\n pt_qor_cell                     $dirx $iter" }
      if { [regexp "power" $min_max_cell_power_eco_save] } {  set cmd_str "$cmd_str;\n pt_qor_power                    $dirx $iter"} 
      if { [regexp "eco"   $min_max_cell_power_eco_save] } {  set cmd_str "$cmd_str;\n pt_write_eco                    $dirx $iter"} 
      if { [regexp "save"  $min_max_cell_power_eco_save] } {  set cmd_str "$cmd_str;\n pt_write_session                $dirx $iter"} 
      if { [regexp "PTDB"  $min_max_cell_power_eco_save] } {  set cmd_str "$cmd_str;\n pt_write_session_withlib        $dirx $iter"} 

      set cmd_str "remote_execute {\n$cmd_str\n} "
      return "$cmd_str"
  }
