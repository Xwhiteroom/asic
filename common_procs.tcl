## ProcNameStart  : autodesign_debus
## ProcArguments  : autodesign_debus data extra_regexp_to_start
## ProcDependency :  
## ProcInfluence  : 4
## ProcRenamed    : 0
##------------------------------------------------------------------
proc autodesign_debus {data extra_regexp_to_start} {
	regsub -all {\[\d+\]} $data {[*]} xdata
	if { $extra_regexp_to_start != "" } { regsub -all $extra_regexp_to_start $xdata {*} xdata }
	set ydata [lsort -unique $xdata]
	return $ydata
}
