##------------------------------------------------------------------
proc grtnobuf args {
    global grtnobuf_cell_is_buf
    set cell_is_buf [auto_get_buf_inv_cells]
    set cmd "redirect  -variable rpt_var       { report_timing  -nosplit  $args  }"
    set cmd "redirect  -file     temp.file_var { report_timing  -nosplit  $args  }"

    puts "# $cmd"
    #echo "$cmd"   > temp.file_var
    eval "$cmd"
    #source "./temp.file_var"
    set crpr     none
    set startc   none
    set endc     none
    set infile [open ./temp.file_var ]
    set found_buf_inv 0
    set found_arr_del1 ""
    set found_arr_del2 ""
    set found_arr_xy1 ""
    set found_arr_xy2 ""
    set chain_del    ""
    set chain_x       ""
    set chain_y       ""

    set old_color     0	
    set class_buffer  "Common"
    array unset  colormap
    set colormap(Common)    "0"
    set colormap(UnCommon)  "31"
    set colormap(Data)      "34"
    set colormap(xCommon)    "47"
    set colormap(xUnCommon)  "41"
    set colormap(xData)      "44"

    while { [gets $infile x] >= 0 } {
	set is_buffer_inv [sta_qual_match_list [concat  " (net)" $cell_is_buf] $x]
	set is_net        [sta_qual_match_list [concat " (net)" ] $x]

	# Buffer Chain
	if {[regexp " $crpr"  $x]  && $crpr   != "none"} {  set class_buffer  "UnCommon" }
	if {[regexp " $startc" $x] && $startc != "none"} {  set class_buffer  "Data"     }
	if {[regexp " $endc"   $x] && $endc   != "none"} {  set class_buffer  "Common"   }

    if { $is_buffer_inv != 1 && $found_buf_inv > 0} {
        set distance     0
        set velocity     0
        set dly_stage    0
        catch {set distance  [format "%0.2f" [expr $chain_x+$chain_y]]}
        catch {set velocity  [format "%0.2f" [expr $distance / $chain_del]]}
        catch {set dly_stage [format "%0.2f" [expr $chain_del / $found_buf_inv]]}

        puts "\033\[1;47m    -->$class_buffer Path Found $found_buf_inv Buffer Inv Stages ! \033\[1;0m \033\[1;$colormap($class_buffer)m\033\[1;32m Stage=$dly_stage Velocity=$velocity Distance=$distance X=$chain_x Y=$chain_y Delay=$chain_del | Src: $found_arr_xy1 $found_arr_del1  Dst: $found_arr_xy2 $found_arr_del2 \033\[1;$colormap($class_buffer)m"
        set  found_buf_inv 0
    }
       
	if { $is_buffer_inv == 1 && $is_net != 1 } {
	    incr  found_buf_inv
        if {[regexp {(\d+\.\d+\s+[rf])\s+(\([\d\.]+,[\d\.]+\))} $x -> curr_del curr_xy]} {
            regsub -all {\(|\)} $curr_xy {} curr_xy 
        #
        # First stage of chain
        #
            #puts "\t\t\t\t BufInv=$found_buf_inv $curr_del $curr_xy"
            if {$found_buf_inv == 1} {
                set found_arr_del1 $curr_del
                set found_arr_xy1  $curr_xy
                set chain_del     -1
                set chain_x       -1
                set chain_y       -1
            }
        #
        # Always keep updating last stage
        #
            set found_arr_del2 $curr_del
            set found_arr_xy2  $curr_xy
            catch {set chain_del     [expr [lindex [split $found_arr_del2] 0] - [lindex [split $found_arr_del1] 0]]} 
            catch {set chain_x     [expr abs([lindex [split $found_arr_xy2 ","] 0] - [lindex [split $found_arr_xy1 ","] 0])]} 
            catch {set chain_y     [expr abs([lindex [split $found_arr_xy2 ","] 1] - [lindex [split $found_arr_xy1 ","] 1])]} 
            


        }
        #puts "\t\t\t\t BufInv=$found_buf_inv $curr_del $curr_xy | Distance=$chain_x+$chain_y Delay=$chain_del Src: $found_arr_xy1 $found_arr_del1  Dst: $found_arr_xy2 $found_arr_del2"


	}	
	if { $is_buffer_inv == 0 } {
	if { [regexp $crpr $x] && $crpr != "none"} {
	    # Uncommon Clock Path
            puts "\033\[1;31m$x"
	    set old_color "31"	
        } elseif { [regexp "<-" $x]} {
	    # Through Object Path
            puts "\033\[1;35m$x\033\[1;34m"
	    set old_color "34"	
        } elseif { [regexp " $startc" $x] && $startc != "none" && $endc != "none"} {
	    # Start Object Path
            puts "\033\[1;34m$x"
	    set old_color "34"	
        } elseif { [regexp " $endc" $x] && $endc != "none"} {
	    # End Object Path
            puts "\033\[1;34m$x\033\[0m"
	    set old_color "34"	
        } elseif { [regexp "data arrival" $x]} {
	    # Arrival Reset Path
            puts "\033\[0m$x"
	    set old_color "0"	
        } else {
            puts "$x"
	    set old_color "0"	
        }    
        }


        if { [regexp "Last common pin:" $x]} { 
            set crpr [lindex $x end]; 
            #regsub -all {\[|\]} $crpr {.} crpr ; 
            #regsub -all {\]} $crpr {\\]} crpr ;
            regsub -all {\[|\]} $crpr {.} crpr ; 
        }
        
        if { [regexp "Startpoint:" $x]} { 
            set startc [lindex $x 1]; 
            #regsub -all {\[} $startc {\\[} startc ; 
            #regsub -all {\]} $startc {\\]} startc ;
            regsub -all {\[|\]} $startc {.} startc ;
            set crpr "none"
            set endc "none"           
        }

        if { [regexp "Endpoint:" $x]} { 
            set endc [lindex $x 1]; 
            #regsub -all {\[} $endc {\\[} endc; 
            #regsub -all {\]} $endc {\\]} endc;   
            regsub -all {\[|\]} $endc {.} endc ;             
        }
    }    
    close $infile
    #puts "\033\[1;34mStart: $startc\033\[0m"
    #puts "\033\[1;34m  End: $endc\033\[0m"
    #puts "\033\[1;31m CRPR: $crpr\033\[0m"
    puts -nonewline "\033\[1;31m\033\[0m"
    #
    #echo $rpt_var
}
##------------------------------------------------------------------
## ProcNameEnd    : grtnobuf
##------------------------------------------------------------------



proc auto_get_buf_inv_cells {} {
    global grtnobuf_cell_is_buf
    if { [info exist grtnobuf_cell_is_buf] } {
        set cell_is_buf    $grtnobuf_cell_is_buf
    } else {
        set cell_is_buf  [list]
        catch {
            set cell_is_buf  [lsort -uniq [get_attr -quiet [get_lib_cells */* -filter "number_of_pins==2 && is_instantiated==true && is_combinational==true" ] base_name]]
        }
        if { [llength $cell_is_buf] ==0 } {
            catch {
                set cell_is_buf  [lsort -uniq [get_attr -quiet [get_lib_cells */* -filter "number_of_pins==2 && (is_buffer==true || is_inverter==true) && is_combinational==true" ] base_name]]
            }
        } else {
            set cell_is_buf  [lsort -uniq [get_attr -quiet [get_lib_cells [list */*BUF* */*INV* */*DEL*] ] base_name]]
        }
        #set cell_is_buf  [lsort -uniq [get_attr [get_lib_cells [list */*BUF* */*INV* */*DEL*] ] base_name]]
        set grtnobuf_cell_is_buf  $cell_is_buf
    }
    return $cell_is_buf
}


##------------------------------------------------------------------
## ProcNameStart  : grtnobufv
## ProcArguments  : grtnobufv args
## ProcDependency : sta_qual_match_list 
## ProcInfluence  : 0
## ProcRenamed    : 0
