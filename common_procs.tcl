##------------------------------------------------------------------

proc sta_qual_report_summary_clocks args {
    global MODE CORNER my_flow_control  GC_STA_HIER_MAP
    # Default inputs
    array unset inputs
    set inputs(clocks)       "*"
    set inputs(ports)        "*"
    set inputs(supply)       "*"
    set inputs(type)         "latency.legacy_lat.definition.group.io_cost.supply"
    set inputs(stage_bin)    "1.000"
    set inputs(latency_bin)  "0.005"
    set inputs(unitdly_bin)  "0.001"
    set inputs(lookup)       "max.all,max.output,min.all,min.input"
    set inputs(analysis)     "sigma2"     ; # sig1,2,3,extreme,mean
    set inputs(max_path)     "-1"         ; # -1 implies all
    set inputs(rpt_type)     "summary"    ; # detail/summary
    set inputs(suffix)       ""

    set inputs(view)         "default.default"
    catch { set inputs(view)     "$MODE.$CORNER" }

    # Parse Arguments
    parse_proc_arguments -args $args proc_x_args
    foreach x [array names proc_x_args] {
        regsub -all {\-} $x {} y
        set inputs($y) $proc_x_args($x)
        #puts [format "\t%20s = %-20s %20s" $y $x $proc_x_args($x)]
    }

    # Normalize Dir path
    set inputs(rep_dir) [file normalize $inputs(rep_dir)]

    # Print Arguments
    puts [format "<GC::PROC> Start %-50s  [date]"   "sta_qual_report_summary_clocks : $inputs(rep_dir)" ]
    foreach x [array names inputs] {
        puts [format "\t%20s = %-20s" $x $inputs($x)]
    }

    set delay_type [list]
    if { [regexp "latency"      $inputs(type)]  } { lappend delay_type  "latency"       }
    if { [regexp "definition"   $inputs(type)]  } { lappend delay_type  "definition"    }
    if { [regexp "groups"       $inputs(type)]  } { lappend delay_type  "group"         }
    if { [regexp "io_cost"      $inputs(type)]  } { lappend delay_type  "io_cost"       }
    if { [regexp "supply"       $inputs(type)]  } { lappend delay_type  "supply"        }
    if { [regexp "legacy_lat"   $inputs(type)]  } { lappend delay_type  "legacy_lat"    }

    # Create dir
    file mkdir $inputs(rep_dir)

    # Create out file list
    array unset out_file_list

    # Dump Raw Reports
    foreach delay $delay_type {
        # For Latency and  CTS Profiling
        if { $delay == "latency" } {
          puts "\n"
          set file_tag "$inputs(base_tag).attr.cts_profile$inputs(suffix)"
          set cmd_string  "sta_qual_report_clock_tree_profile $inputs(rep_dir) $file_tag $inputs(view) $inputs(clocks) $inputs(analysis) $inputs(latency_bin) $inputs(stage_bin) $inputs(unitdly_bin) $inputs(rpt_type) $inputs(max_path) $inputs(ports) $inputs(lookup)"
          puts [format "<GC::PROC> <CMD> %-50s  [date]"   "$cmd_string" ]
          set out_file_list($delay) [eval $cmd_string]
        }

        # For Clock Definition
        if { $delay == "definition" } {
          puts "\n"
          set file_tag "$inputs(base_tag).attr.clock_definition$inputs(suffix)"
          set cmd_string  "sta_qual_report_clock_definition $inputs(rep_dir) $file_tag $inputs(view) $inputs(clocks)"
          puts [format "<GC::PROC> <CMD> %-50s  [date]"   "$cmd_string" ]
          set out_file_list($delay) [eval $cmd_string]
        }

        # For IO Cost
        if { $delay == "io_cost" } {
          puts "\n"
          set file_tag "$inputs(base_tag).attr.io_cost$inputs(suffix)"
          set time_data  [clock format [clock seconds]  -format %D]
          set cmd_string  "sta_qual_report_io_cost $inputs(rep_dir) $file_tag $inputs(view)  $time_data  $inputs(ports) $inputs(clocks)"
          puts [format "<GC::PROC> <CMD> %-50s  [date]"   "$cmd_string" ]
          set out_file_list($delay) [eval $cmd_string]
        }

        # For Supply
        if { $delay == "supply" } {
          puts "\n"
          set file_tag "$inputs(base_tag).attr.supply$inputs(suffix)"
          set cmd_string  "sta_qual_report_supply_nets $inputs(rep_dir) $file_tag $inputs(view) $inputs(supply)"
          puts [format "<GC::PROC> <CMD> %-50s  [date]"   "$cmd_string" ]
          set out_file_list($delay) [eval $cmd_string]
        }

        # For Legacy Latency Reporting
        if { $delay == "legacy_lat" } {
          puts "\n"
          set file_tag "$inputs(base_tag).attr.legacy_lat$inputs(suffix)"
          set cmd_string  "sta_qual_report_summary_latency $inputs(view) $inputs(rep_dir)"
          puts [format "<GC::PROC> <CMD> %-50s  [date]"   "$cmd_string" ]
          set out_file_list($delay) [eval $cmd_string]
        }

    }

    # Report Summary
    puts "\n"
    foreach delay [array names out_file_list]  {
        puts [format "<GC::PROC> Done  %-50s  [date]"   "sta_qual_report_summary_clocks $delay: [file normalize $out_file_list($delay) ] " ]
    }
    puts [format "<GC::PROC> Done  %-50s  [date]"   "sta_qual_report_summary_clocks : $inputs(rep_dir)" ]
}

define_proc_attributes sta_qual_report_summary_clocks \
    -info "Dispatch wrapper: runs one or more sta_qual_report_* clock qualification reports (latency/definition/io_cost/supply/legacy_lat) selected via -type" \
    -define_args {
        {-rep_dir      "Output report directory (created if missing)" "" string required}
        {-base_tag     "Base tag used to build each report's file name" "" string required}
        {-clocks       "Clock name pattern(s) to report on (defaults to *)" "" string optional}
        {-ports        "Port pattern(s) defining the chip I/O boundary (defaults to *)" "" string optional}
        {-supply       "Supply net pattern(s) for the supply report (defaults to *)" "" string optional}
        {-type         "Dot-joined list of report types to run: latency, definition, groups, io_cost, supply, legacy_lat" "" string optional}
        {-stage_bin    "Histogram bin width for stage-count profiling" "" float optional}
        {-latency_bin  "Histogram bin width for latency profiling" "" float optional}
        {-unitdly_bin  "Histogram bin width for per-stage unit-delay profiling" "" float optional}
        {-lookup       "Comma separated path classes to compute, e.g. max.all,max.output,min.all,min.input" "" string optional}
        {-analysis     "Representative-latency statistic: mean, sigma1, sigma2, sigma3, or extreme" "" string optional}
        {-max_path     "Max paths sampled per source/class (-1 = all)" "" int optional}
        {-rpt_type     "summary or detail (detail adds cell/RC delay breakdown, much slower)" "" string optional}
        {-suffix       "Suffix appended to every generated file tag" "" string optional}
        {-view         "Label stamped into report headers (defaults to MODE.CORNER)" "" string optional}
    }
