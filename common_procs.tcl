##------------------------------------------------------------------
## ProcNameStart  : sta_qual_fixall_parser
## ProcArguments  : sta_qual_fixall_parser list_file waive_pattern_slack_io
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_fixall_parser {list_file waive_pattern_slack_io} {
    global GC_STA_ECO_ITER
    set vio_list [list]
    array unset vio_nodes
    regsub -all { |:.*}  [lrange [date] 1 3]  {_} date_log
    set fixall_dir [pwd]/vio_db
    file mkdir $fixall_dir


    set my_checks [list max_path min_path max_transition max_capacitance min_pulse_width min_period glitch]
    if { ![file exist $list_file] } {  
      
      foreach checkx  $my_checks  { 
          set vio_nodes($my_fix_check) [list ] 
      }  
    } else {

        set input [open $list_file ]
        while { [gets  $input line] > 0 } {
            if { [file exist $line] } {
                puts [format "\t**INFO:: <Importing Violations> %s"  $line]
                regsub -all {.*/} $line {} filebasename
                set check_type [lindex [split $filebasename "."] 0] 
                set map_to_check $check_type 
                foreach my_fix_check $my_checks {
                    if { [regexp $my_fix_check $check_type ] } { set map_to_check $my_fix_check ; break } 
                }
                if { ![info exist vio_nodes($my_fix_check)] }  { set vio_nodes($map_to_check) [list ] ; puts  "\t         <Found Check> $map_to_check from $check_type , Waivers Added : $waive_pattern_slack_io" }

                set filex [open $line ]         
                array unset waiver_count
                set waiver_count(Valid)    0
                set waiver_count(WaivedP)  0
                set waiver_count(WaivedS)  0
                set waiver_count(WaivedIO) 0

                while { [gets  $filex linex] > 0 } {
                    set datax [split $linex ","]

                    set node  [lindex $datax 0]  
                    set categ [lindex $datax 3]                       
                    set slack [lindex $datax 4]        
                    set not_a_waiver 1
                    if { [regexp "pattern" $waive_pattern_slack_io ] && [regexp "_WaivedP"  $categ]} {  
                        set not_a_waiver 0 ; incr waiver_count(WaivedP) 
                    } elseif { [regexp "slack"   $waive_pattern_slack_io ] && [regexp "_WaivedS"  $categ]} {  
                        set not_a_waiver 0 ; incr waiver_count(WaivedS)
                    } elseif { [regexp "io"      $waive_pattern_slack_io ] && [regexp ".PORT.NL" $categ]} {  
                        set not_a_waiver 0 ; incr waiver_count(WaivedIO)
                    } elseif { [regexp "io"      $waive_pattern_slack_io ] && [regexp ".out$"    $categ]} {  
                        set not_a_waiver 0 ; incr waiver_count(WaivedIO)
                    } elseif { [regexp "io"      $waive_pattern_slack_io ] && [regexp "^in."     $categ]} {  
                        set not_a_waiver 0 ; incr waiver_count(WaivedIO)
                    } else {
                        set not_a_waiver 1 ; incr waiver_count(Valid)                        
                    }
                    if { ![regexp "#" $node] && $not_a_waiver == "1"} { lappend vio_nodes($map_to_check) "$node" }
                }
                close $filex
                
                foreach x [array names  waiver_count] { puts [format "	           -  %-25s = $waiver_count($x) " "waiver_count($x)"] }
            } else {
                puts [format "	**WARN:: <Import Failed/NoFile> %s" $line] 
            }
        }   
        close $input
    }
    puts "\n\n"
    set outfile   "$fixall_dir/vio_db.eco_$GC_STA_ECO_ITER.$date_log.tcl"
    set out [open $outfile w+]
    foreach checkx [array names vio_nodes] {
        puts $out "global  GC_NODES_$checkx"
        puts $out "set     GC_NODES_$checkx  \[list \]"
        foreach node $vio_nodes($checkx) {
            regsub -all {\[} $node {\[} node
            regsub -all {\]} $node {\]} node
            puts $out "lappend GC_NODES_$checkx \"$node\""
        }
        puts $out "\n"
    }
    close $out
    set outfile [file normalize $outfile]
    puts [format "	**INFO:: <Export Success> %s" $outfile] 
    return  $outfile
  }
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_fixall_parser
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_gen_io_mapping
## ProcArguments  : sta_qual_gen_io_mapping designs outdir tag view ports
## ProcDependency : sta_qual_io_path_attr 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_gen_io_mapping {designs outdir tag view ports} {
    suppress_message  SEL-003
    file mkdir $outdir
    array unset nodes
    array unset node_split
    set empty_collection [remove_from_collection [get_clocks *]  [get_clocks *]]
    foreach design $designs {
        puts "\n\n"
        set out1 [open $outdir/IO_$design.csv w+]  
        set out2 [open $outdir/IO_$design.clk_cost.csv w+]  
        set out3 [open $outdir/IO_$design.detail.csv w+]  
        puts $out1 "#Tag,#View,#Direction,#Data/Clock,#Port,#Clock,#Slack/Case/Clock,#Dly_Cost"
        puts $out2 "#Tag,#View,#Direction,#Data/Clock,#Port,#Clock,#Slack/Case/Clock,#Dly_Cost,#Clk_Dly"
        puts $out3 "#Tag,#View,#Direction,#Data/Clock,#Port,#Clock,#Slack/Case/Clock,#Dly_Cost,#Port_Dly,#Norm_Dly,#Slack,#Data_Dly,#Clk_Dly,#Margin"

        set top_design    [get_object_name [current_design ]]
        set hier_design   [get_cells -quiet -hier -filter "ref_name==$design"]
        puts [format "<GC::PROC> Start   %-50s  [date]"   "sta_qual_gen_io_mapping : Selected Top  = $design"]
        if { $top_design == $design } {
            puts [format "<GC::PROC> Start   %-50s  [date]"   "sta_qual_gen_io_mapping : Design        = $design \[TOP\]"]
            set nodes($design) [get_ports $ports] 
            #set nodes($design) [get_ports [list *_DD_ctrl* ] ] 
            #set nodes($design) [remove_from_collection [get_ports [list * ] ]  [get_ports [list *_DD_ctrl* I_USER_SPARE_IN*] ] ]

            #set nodes($design) [get_ports [list DD_OUTPUT_CODE_DD_ctrl_hera_0 PWRQACCEPTn RVBARADDR7[2] *CLK I_DFT_RESETn DD_ERROR_FAST_DD_ctrl_hera_* ARDOMAINM0[1] ro_block_out_hpm_enyo_0 nCNTVIRQ[6]] ] 
        } elseif { [sizeof_collection $hier_design] > 0 } {
            puts [format "<GC::PROC> Start   %-50s  [date]"   "sta_qual_gen_io_mapping : Design        = $design \[BLK\]"]
            regsub -all {\d+} [lindex [get_object_name $hier_design] 0 ] {*} mim_inst    
            foreach inst  [concat $mim_inst [get_object_name $hier_design]] {
                puts [format "\t%20s = %-20s" "Sub-block" $inst] 
            }
            set nodes($design) [get_pins $mim_inst/* -filter "is_hierarchical==true"]
        }
        set node_split(all)     $nodes($design)
        set node_split(in)      [filter_collection $nodes($design) "direction==in"]
        set node_split(out)     [filter_collection $nodes($design) "direction==out"]
        set node_split(inout)   [filter_collection $nodes($design) "direction==inout"]

        set node_split(inCK)    $empty_collection
        set node_split(inDATA)  $empty_collection
        set node_split(outCK)   $empty_collection
        set node_split(outDATA) $empty_collection
        set node_split(clocks)  $empty_collection

        # Inputs
        foreach_in_collection el $node_split(in) {
            set is_port [sizeof_collection [get_ports -quiet $el]]
            if { $is_port > 0 } {
                set type inDATA                    
                if { [sizeof_collection [filter_collection $el "is_clock_network==true"]] } { set type inCK }
                #puts "Port CKin : [get_object_name $el]"
                set node_split($type) [add_to_collection -unique $node_split($type) $el] 
                if { [regexp "CK" $type] } { set node_split(clocks) [add_to_collection -unique $node_split(clocks) [get_clocks -quiet [get_attr -quiet $el clocks]]] }               
            } else {
                set type inDATA         
                set pin_drxs  [filter_collection [all_fanin -to $el -pin_level 1 -flat ] "direction==out"] 
                if { [sizeof_collection [filter_collection $pin_drxs "is_clock_network==true"]] } { set type inCK }
                #puts "Port CKin : [get_object_name $el]"                
                set node_split($type) [add_to_collection -unique $node_split($type) $el]   
                if { [regexp "CK" $type] } { set node_split(clocks) [add_to_collection -unique $node_split(clocks) [get_clocks -quiet [get_attr -quiet $pin_drxs clocks]]] }               
            }
        }

        # Outputs
        foreach_in_collection el $node_split(out) {
            set is_port [sizeof_collection [get_ports -quiet $el]]
            if { $is_port > 0 } {
                set type outDATA                    
                if { [sizeof_collection [filter_collection $el "is_clock_network==true"]] } { set type outCK  }
                #puts "Port CKin : [get_object_name $el]"
                set node_split($type) [add_to_collection -unique $node_split($type) $el]
                if { [regexp "CK" $type] } { set node_split(clocks) [add_to_collection -unique $node_split(clocks) [get_clocks -quiet [get_attr -quiet $el clocks]]] }               

            } else {
                set type outDATA         
                set pin_drxs  [filter_collection [all_fanout -from $el -pin_level 1 -flat ] "direction==in"] 
                if { [sizeof_collection [filter_collection $pin_drxs "is_clock_network==true"]] } { set type outCK }
                #puts "Port CKin : [get_object_name $el]"                
                set node_split($type) [add_to_collection -unique $node_split($type) $el]    
                if { [regexp "CK" $type] } { set node_split(clocks) [add_to_collection -unique $node_split(clocks) [get_clocks -quiet [get_attr -quiet $pin_drxs clocks]]] }                               
            }
        }


        # Display Stats
        foreach namex [lsort [array names node_split]] {
            puts [format "<GC::PROC> Start   %-30s %-10s = %10s [date]"   "sta_qual_gen_io_mapping : Stats " $namex  [sizeof_collection $node_split($namex)]]            
        }
        
        # Process : Clock
        foreach_in_collection din [add_to_collection $node_split(outCK) $node_split(inCK)] {
            set d_name   [get_object_name $din]
            set d_obj    $din
            set direct   [get_attr -quiet $din direction]
            set clk_objs  [get_attr -quiet $din clocks]
            foreach clk_obj $clk_objs {
                set c_name [get_object_name $clk_obj]
                set c_cyc  [get_attr -quiet $clk_obj period]
                puts $out1 "$tag,$view,$direct,clock,$d_name,$c_name,$c_cyc,NA"
                puts $out2 "$tag,$view,$direct,clock,$d_name,$c_name,$c_cyc,NA,NA"
                puts $out3 "$tag,$view,$direct,clock,$d_name,$c_name,$c_cyc,NA,NA,NA,NA,NA,NA,NA,NA"
            }
        }
        puts [format "<GC::PROC> Start   %-30s %-10s = %10s [date]"   "sta_qual_gen_io_mapping : Process " "Clocks"  "Done"]            


        set count               [sizeof_collection [add_to_collection $node_split(outDATA) $node_split(inDATA)]] ; set i 0 ; set j 0 ; set limit [expr 0.05*$count]

        # Process : Data
        foreach_in_collection din [add_to_collection $node_split(outDATA) $node_split(inDATA)] {
            incr i
            incr j
            if { $j > $limit } { set j 0 ; puts [format "       ---  Processed : %0.1f/100" [expr 100.0*$i/$count]];}
            set d_obj    $din
            set d_name   [get_object_name $d_obj]            
            set direct   [get_attr -quiet $d_obj  direction]
            set suslk    [get_attr -quiet $d_obj max_slack]
            set xcase    [get_attr -quiet $d_obj case_value]
            regsub -all {INFINITY} $suslk {} suslk 
            #puts   "Done1  $d_name $suslk | "

            if { ($xcase == "1" || $xcase == "0") } { 
                # Check 1 Static Port
                #puts   "Done2  $d_name $suslk | "
                puts $out1 "$tag,$view,$direct,data,$d_name,no_clock,Case_$xcase$suslk,NA"
                puts $out2 "$tag,$view,$direct,data,$d_name,no_clock,Case_$xcase$suslk,NA,NA"
                puts $out3 "$tag,$view,$direct,data,$d_name,no_clock,Case_$xcase$suslk,NA,NA,NA,NA,NA,NA,NA,NA"
            } elseif { $suslk != ""} {
                # Eval All Clocks
                #puts  "Done2  $d_name $suslk | " 
                set was_clock 0
                set clock_mapping $node_split(clocks)
                set clock_mapping [get_clocks *]
                
                foreach_in_collection clk_obj $clock_mapping { 
                    set c_name [get_object_name $clk_obj]
                    set path   [get_timing_paths -through $d_obj -to $clk_obj -slack_less 10000000 ]
                    if { [sizeof_collection $path] } {
                        incr was_clock
                        #puts  "Done3.1 $d_name $suslk | "                        
                        set qattr [list slack dly_dataC dly_dataR dly_dataX dly_libt dly_skew dly_marg dly_adjt dly_norm dly_in dly_out start_pin end_pin]
                        set out [sta_qual_io_path_attr $path "0" $qattr ]
                        array unset path_attrx
                        foreach  attr $out {
                           set path_attrx([lindex [split $attr ","] 0]) [lindex [split $attr ","] 1]
                        }
                        #puts "Done $d_name $suslk"
                        set data_dly [format "%0.3f" [expr $path_attrx(dly_dataC) + $path_attrx(dly_dataR) + $path_attrx(dly_dataX) + $path_attrx(dly_libt)]]
                        set clk_skew [format "%0.3f" [expr $path_attrx(dly_skew) + 0]]
                        set norm_dly [format "%0.3f" [expr $path_attrx(dly_norm) + 0]]
                        set margin   [format "%0.3f" [expr $path_attrx(dly_marg) + 0]]
                        set slack    [format "%0.3f" [expr $path_attrx(slack) + 0]]
                        set port_dly [format "%0.3f" [expr $path_attrx(dly_in) + 0 + $path_attrx(dly_out) + 0]]
                        set dly_cost [expr 0 + $data_dly +  $clk_skew +  $margin + 0]
                        puts $out1 "$tag,$view,$direct,data,$d_name,$c_name,$suslk,$dly_cost"
                        puts $out2 "$tag,$view,$direct,data,$d_name,$c_name,$suslk,$dly_cost,$clk_skew"
                        puts $out3 "$tag,$view,$direct,data,$d_name,$c_name,$suslk,$dly_cost,$port_dly,$norm_dly,$slack,$data_dly,$clk_skew,$margin"
                        #puts  "Done3.2 $d_name $suslk | "
                    } 
                }
                #puts  "Done4 $d_name $suslk | "
                # Eval Max Delay  
            }
            #puts  "Done5 $d_name $suslk | "
            #else {   puts "skip,data,$d_name,$suslk"        }
        }
        puts [format "<GC::PROC> Start   %-30s %-10s = %10s [date]"   "sta_qual_gen_io_mapping : Process " "Data"  "Done"]            
    close $out1
    close $out2
    close $out3

    }
    unsuppress_message  SEL-003
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_gen_io_mapping
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_gen_io_parse_timing_point
## ProcArguments  : sta_qual_gen_io_parse_timing_point path vt_patterns debug
## ProcDependency :  
## ProcInfluence  : 2
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_gen_io_parse_timing_point {path vt_patterns debug} {
    set points          [get_attr -quiet  $path points]
    set dly_rc          0.000000
    set dly_si          0.000000
    set dly_dv          0.000000
    set dis_x           0.0
    set dis_y           0.0
    set cap_T           0.000
    set cap_W           0.000
    set cap_P           0.000
    set res_T           0.000
    set old_arr         0.000000
    set old_xcor        [format "%.1f" [expr (0 + [get_attr -quiet  [get_attr -quiet  $path startpoint] x_coordinate] + 0)/1000] ]
    set old_ycor        [format "%.1f" [expr (0 + [get_attr -quiet  [get_attr -quiet  $path startpoint] y_coordinate] + 0)/1000] ]

    array unset vt_dly vt_regexp
    foreach vt_alias $vt_patterns {
        set vt   [lindex [split $vt_alias ":"] 0]
        set mark [lindex [split $vt_alias ":"] 1]
        set vt_regexp($vt)              "dly_$mark"
        set vt_dly(dly_$mark)            $dly_dv
    }

    #set  debug 1
    set thru_string ""
    set path_type [get_attr $path path_type]
    if { $debug == "1" } { puts "\t\t\t\tResistance,Capacitance(T),Capacitance(W),Capacitance(P),TravelX,TravelY,CellDly,XtlkDly,RCDly,StageDly,Arrival,Direction,Pin";}
    foreach_in_collection point $points {
	set pin       [get_object_name [get_attr -quiet  $point object ] ]
        set direction [get_attr -quiet  [get_attr -quiet  $point object ] direction]


	set arr       [format "%.6f" [get_attr -quiet  $point arrival] ]
        set stage     [expr $arr - $old_arr]
        set old_arr   $arr


        set xcor     [format "%.1f" [expr (0 + [get_attr -quiet  [get_attr $point object ] x_coordinate] + 0 )/1000] ]
	set xstage   [expr $xcor - $old_xcor]
        set old_xcor $xcor


        set ycor     [format "%.1f" [expr (0 + [get_attr  -quiet  [get_attr $point object ] y_coordinate] + 0 ) /1000] ]
        set ystage   [expr $ycor - $old_ycor]
        set old_ycor $ycor

        if { $direction == "in"}  {
            set net             [get_nets -quiet -of_object [get_pins -quiet $pin]]
            set crosstalk       [expr 0.000 + [get_attr -quiet  $net annotated_delay_delta_$path_type] + 0.000]
            set total_cap       [expr 0.000 + [get_attr -quiet  $net total_capacitance_$path_type] + 0.000]
            set pin_cap         [expr 0.000 + [get_attr -quiet  $net pin_capacitance_$path_type] + 0.000]
            set wire_cap        [expr 0.000 + [get_attr -quiet  $net wire_capacitance_$path_type] + 0.000]
            set total_res       [expr 0.000 + [get_attr -quiet  $net net_resistance_$path_type] + 0.000]


            set dly_si          [expr $dly_si + $crosstalk] ;
            set dly_rc          [expr $dly_rc + $stage - $crosstalk] ;
            set cap_T           [expr $cap_T  + $total_cap]
            set cap_P           [expr $cap_P  + $pin_cap]
            set cap_W           [expr $cap_W  + $wire_cap]
            set res_T           [expr $res_T  + $total_res]

            set thru_string     "$thru_string -through $pin"
        }

        if { $direction == "out"} {
            set dly_dv          [expr $dly_dv + $stage]
            set lib_pin         [get_object_name [get_lib_pins -quiet -of_object [get_pins -quiet $pin]]]
            foreach vt_type [array names vt_regexp] {
                #puts "$vt_type $vt_regexp($vt_type)"
                if { [regexp $vt_type $lib_pin] } {
                    set key_match $vt_regexp($vt_type)
                    set vt_dly($key_match) [expr $vt_dly($key_match) + $stage]
                    #puts "$key_match Match  $vt_dly($key_match) + $stage"
                }
            }
        }
        set dis_x [expr $dis_x + abs($xstage)]
        set dis_y [expr $dis_y + abs($ystage)]
        set vt_dly_list ""
        foreach vt [array names vt_dly] {
            set vt_dly_list "$vt_dly_list $vt:$vt_dly($vt)"
        }
        regsub -all {^ } $vt_dly_list {} vt_dly_list
        #puts "\t\t\t\t$dis_x|$dis_y,$xstage|$ystage,DV=$dly_dv,RC=$dly_rc,SI=$crosstalk,$stage,$arr,$direction,$pin"
        if { $debug == "1" } { puts "\t\t\t\t$res_T,$cap_T,$cap_W,$cap_P,$dis_x,$dis_y,$dly_dv=$vt_dly_list,$dly_si,$dly_rc,$stage,$arr,$direction,$pin";}
    }
    regsub -all {^\s+-through} $thru_string {-from} thru_string
    return "$dly_dv,$vt_dly_list,$dly_rc,$dly_si,$dis_x,$dis_y,$res_T,$cap_T,$cap_W,$cap_P,$thru_string"
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_gen_io_parse_timing_point
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_gen_io_path_attr
## ProcArguments  : sta_qual_gen_io_path_attr path id qattr
## ProcDependency : sta_qual_gen_io_parse_timing_point 
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_gen_io_path_attr {path id qattr} {
           array unset path_attr
           # ID attr
           set path_attr(id)             $id
           set path_attr(start_pin)      [get_object_name [get_attr -quiet $path startpoint]]
           set path_attr(start_clk)      [get_object_name [get_attr -quiet $path startpoint_clock]]
           set path_attr(end_pin)        [get_object_name [get_attr -quiet $path endpoint]]
           set path_attr(end_clk)        [get_object_name [get_attr -quiet $path endpoint_clock]]
           # Slack attr
           set path_attr(slack)          [get_attr -quiet $path slack]
           set path_attr(slack_norm)     [get_attr -quiet $path normalized_slack]
           #set path_attr(dly_norm)       [get_attr [get_clocks $path_attr(end_clk)] period]

           # Skew attr
           set path_attr(crpr)           [get_attr -quiet $path common_path_pessimism]
           set path_attr(start_lat)      [get_attr -quiet $path startpoint_clock_latency]
           set path_attr(end_lat)        [get_attr -quiet $path endpoint_clock_latency]
           set path_attr(start_edge)     [get_attr -quiet $path startpoint_clock_open_edge_value]
           set path_attr(end_edge)       [get_attr -quiet $path endpoint_clock_open_edge_value]
           set path_attr(dly_in)         [get_attr -quiet $path startpoint_input_delay_value]
           set path_attr(dly_out)        [get_attr -quiet $path endpoint_output_delay_value]

           set path_attr(diff_lat)       [expr $path_attr(start_lat) - $path_attr(end_lat) + 0]                                 ; # puts "done1"
           set path_attr(dly_skew)       [expr 0 + $path_attr(start_lat) - $path_attr(end_lat)  - $path_attr(crpr)  + 0]        ; # puts "done2"
           set path_attr(dly_norm)       [expr 1.000*(0 + $path_attr(end_edge) -  $path_attr(start_edge)  + 0) ];               ; # puts "done3"

           # Data attr
           set debug "0"
           # VT Flavours
           set VT_LIST [list 6TL_C:LVT 6TSL_C:SLVT 6TR_C:RVT]
           set VT_LIST [list ".*_lvt.*l10:LVT10" ".*_lvt.*l08:LVTL08" ".*_slvt.*:SLVT" ".*_rvt.*:RVT"]
           set VT_LIST [list ".*_lvt.*:LVT"  ".*_slvt.*:SLVT"]

           set data_path                [split [sta_qual_gen_io_parse_timing_point  $path $VT_LIST $debug] ","]
           set path_attr(dly_dataC)     [lindex $data_path 0]
           foreach xdata [lindex $data_path 1] {
              set dly_vt_attr [lindex [split $xdata ":"] 0]
              set dly_vt_val  [lindex [split $xdata ":"] 1]
              set path_attr($dly_vt_attr) $dly_vt_val
           }

           set path_attr(dly_dataR)     [lindex $data_path 2]
           set path_attr(dly_dataX)     [lindex $data_path 3]
           set path_attr(phy_X)         [lindex $data_path 4]
           set path_attr(phy_Y)         [lindex $data_path 5]
           set path_attr(phy_XY)        [expr $path_attr(phy_X) + $path_attr(phy_Y)]
           set path_attr(res_T)         [lindex $data_path 6]
           set path_attr(cap_T)         [lindex $data_path 7]
           set path_attr(cap_W)         [lindex $data_path 8]
           set path_attr(cap_P)         [lindex $data_path 9]
           set path_attr(grt)           [lindex $data_path 10]
           set path_attr(arr_time)      [get_attr -quiet $path arrival]
           set path_attr(dly_data)      [expr $path_attr(arr_time) - $path_attr(start_lat) + 0] ;   ; # puts "done4"

           foreach var [array names hier_sub_cmd] {
                regsub -all $hier_sub_cmd($var) $path_attr(grt) "\$\{$var\}" path_attr(grtx)
                regsub -all $hier_sub_cmd($var) $path_attr(grt) "" path_attr(grth)

           }
           # Margin Attr
           set lib_time1                [get_attr -quiet $path endpoint_hold_time_value];
           set lib_time2                [get_attr -quiet $path endpoint_setup_time_value];
           set lib_time3                [get_attr -quiet $path endpoint_removal_time_value];
           set lib_time4                [get_attr -quiet $path endpoint_recovery_time_value]
           set uncert                   [get_attr -quiet $path clock_uncertainty]

           set path_attr(req_time)      [get_attr -quiet $path required]
           set path_attr(dly_libt)      [expr 1.000*(0 + $lib_time1 + $lib_time2 + $lib_time3 + $lib_time4 - $path_attr(dly_out)  + 0)] ; # puts "done5"
           set path_attr(dly_marg)      [expr -1.000*(0 + $path_attr(req_time) - $path_attr(end_lat) - $path_attr(crpr) + $path_attr(dly_libt) + $path_attr(dly_out) + 0) + 0] ; ; # puts "done6"
           set path_attr(dly_adjt)      [expr $path_attr(dly_norm) + $path_attr(req_time) - $path_attr(arr_time) - $path_attr(slack) + 0  ] ; # puts "done7"

           incr id
           #puts "\n"
           set out [list]
           #foreach attr [lsort [array names path_attr]] {
           #     puts "[format "%08d  %20s %s" $id $attr $path_attr($attr)]"
           #}
           foreach attr $qattr {
                if { ![info exist path_attr($attr)]  } { set path_attr($attr) "NA" }
                #puts "[format "%08d  %20s %s" $id $attr $path_attr($attr)]"
                lappend out "$attr,$path_attr($attr)"
           }
           return $out
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_gen_io_path_attr
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_gen_list_histogram
## ProcArguments  : sta_qual_gen_list_histogram data_list binsize
## ProcDependency :  
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_gen_list_histogram {data_list binsize} {
    array unset  binsx
    array unset  binsid
    set list_out [list "#BinIndex,#BinValue,#Count,#Cumulative,#Percentage"]
    set mean_sum     0
    set mse_sum      0
    set mean         0
    set mse          0
    set max          0
    set min          0
    if { [llength $data_list] > 0 } {
        set data    [lsort -real $data_list]
        set max     [lindex $data end]
        set min     [lindex $data 0]
        set bin_min [expr { int(floor($min/$binsize)) }]
        set bin_max [expr { int(ceil($max/$binsize))  }]
        set reso    [format "Size=%0.3f Max=%f(%f) Min=%f(%f)" $binsize $bin_max $max $bin_min $min]
        set i       $bin_min
        set dx      ""
        while { $i <= $bin_max } {
            set  bin_xy         [expr $i * $binsize]
            set  binsx($bin_xy) $i
            set  binsid($i)     0
            incr i
        }
        # Get Mean and Bin Mapping
        foreach el $data {
          set  present_bin [expr { int(floor($el/$binsize))  }]
          incr binsid($present_bin)
          set  mean_sum [format "%0.4f" [expr $mean_sum + $el]]
        }
        set mean [expr $mean_sum / [llength $data]]
        # Get Sigma Mapping
        foreach el $data {
            set  error_el [expr $mean - $el]
            set  mse_sum  [expr $mse_sum + ($error_el*$error_el)  ]
        }
        set mse   [expr { sqrt ($mse_sum / [llength $data]) } ]
    } else {
        set comment "\t\t<Info> : No Data to create histogram "
    }
    set cummulative 0
    set sigma1      NA
    set sigma2      NA
    set sigma3      NA
    foreach x [lsort -real [array names binsid]]  {
        set cummulative [expr $cummulative + $binsid($x)]
        set percent     [format "%0.2f" [expr 100.00* $cummulative / [llength $data]]]
        if { $percent >= 68.0 && $sigma1 == "NA"} {  set sigma1 [expr $x*$binsize] }
        if { $percent >= 95.0 && $sigma2 == "NA"} {  set sigma2 [expr $x*$binsize] }
        if { $percent >= 99.7 && $sigma3 == "NA"} {  set sigma3 [expr $x*$binsize] }
        lappend  list_out "$x,[expr $x*$binsize],$binsid($x),$cummulative,$percent"
    }
    if { $sigma1 == "NA" }  { set sigma1 0 }
    if { $sigma2 == "NA" }  { set sigma2 0 }
    if { $sigma3 == "NA" }  { set sigma3 0 }
    set out_data [list $mean $mse $max $min $sigma3 $sigma2 $sigma1 $list_out]
    return $out_data
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_gen_list_histogram
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_generate_sdf_outputs
## ProcArguments  : sta_qual_generate_sdf_outputs args
## ProcDependency : sta_qual_get_clock_target , sh , sta_qual_get_io_target 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_generate_sdf_outputs args {
    global TOP_DESIGN CORNER MODE NETLISTS GC_STA_CONTEXT_MODEL_MAP env
    
    # Default inputs
    array unset inputs  
    set inputs(type)             "flat"
    set inputs(view)             "default.default"
    set inputs(dry)              "0"
    set inputs(noio)             "0"

    set inputs(include_hier)     [list]

    catch { set inputs(view)     "$MODE.$CORNER" }

    # Parse Arguments 
    parse_proc_arguments -args $args proc_x_args
    foreach x [array names proc_x_args] {  
        regsub -all {\-} $x {} y
        set inputs($y) $proc_x_args($x)
        #puts [format "\t%20s = %-20s %20s" $y $x $proc_x_args($x)]
    }

    # Normalize Dir path
    set inputs(rep_dir) [file normalize $inputs(rep_dir)]

    # Print Arguments
    puts [format "<GC::PROC> Start %-50s  [date]"   "sta_qual_generate_sdf_outputs : $inputs(rep_dir)" ]
    foreach x [array names inputs] {    
        puts [format "\t%20s = %-20s" $x $inputs($x)] 
    }

    # Map hier
    set gen_type [list]
    if { $inputs(type) == "flat"} { set gen_type [list "flat"] }
    if { $inputs(type) == "hier"} { set gen_type [list "hier"] }
    if { $inputs(type) == "both"} { set gen_type [list "flat" "hier"] }
    
    # Add Modules
    array unset xblocks
    array unset exclude_inst

    set xblocks(hier) [array names GC_STA_CONTEXT_MODEL_MAP]
    set xblocks(flat) [get_object_name [current_design]]
    
    if { [llength $inputs(include_hier)] > 0 } {
        set xblocks(hier) [list]
        foreach modulex $inputs(include_hier) {
            lappend xblocks(hier) $modulex
        }
    }
    # Hier inst mapping  
    
    foreach xblk $xblocks(hier) {
       if { $xblk != $xblocks(flat) } { set exclude_inst($xblk) [get_object_name [get_cells -quiet  -hier * -filter "ref_name==$xblk"]] }
    }
    set exclude_inst($xblocks(flat)) ""
    foreach xblk [array names exclude_inst] {
       if { $xblk != $xblocks(flat) } { set exclude_inst($xblocks(flat))  [concat $exclude_inst($xblocks(flat)) $exclude_inst($xblk)] }
    }

    set exclude_inst($xblocks(flat)) [lsort -uniq [split  $exclude_inst($xblocks(flat)) " "]]
    regsub -all {\{|\}|^\S\+} $exclude_inst($xblocks(flat)) {} exclude_inst($xblocks(flat))
    set exclude_inst($xblocks(flat)) [get_object_name [get_cells -quiet [lsort -uniq [split  $exclude_inst($xblocks(flat)) " "]]]]

    echo "$exclude_inst($xblocks(flat))"
    
    # Create dir
    file mkdir $inputs(rep_dir)/sdf
    set readme "$inputs(rep_dir)/README.$CORNER"
    echo "############################################################"  > $readme
    echo "## Design : $TOP_DESIGN"  >> $readme
    echo "## Corner : $CORNER"      >> $readme    
    echo "## Owner  : $env(USER)"   >> $readme
    echo "## Date   : [date]"       >> $readme
    echo "############################################################"  >> $readme


    file mkdir  $inputs(rep_dir)/misc    
    puts [format "<GC::PROC> End   %-50s  [date]"   "sta_qual_generate_sdf_outputs : $inputs(rep_dir)" ]
    set filex "$inputs(rep_dir)/misc/$inputs(view).FREQ.rpt"
    if { $inputs(dry) == "0" } {sta_qual_get_clock_target * 0.005  $filex }
    echo "<FREQ_RPT> :  $inputs(rep_dir)/misc/$filex" >> $readme
    puts [format "\n\n<GC::PROC> Done  %-50s  [date]\n"   "sta_qual_generate_sdf_outputs : $filex" ]


    set filex "$inputs(rep_dir)/misc/$inputs(view).IO.rpt"    
    if { $inputs(dry) == "0" && $inputs(noio) == "0" } {sta_qual_get_io_target $filex}
    echo "<IOX_RPT>   :  $inputs(rep_dir)/misc/$filex" >> $readme
    puts [format "\n\n<GC::PROC> Done  %-50s  [date]\n"   "sta_qual_generate_sdf_outputs : $filex" ]



    # Gen Flat Collaterals
    foreach type $gen_type {
      echo "$type : $xblocks($type)"   
      if { $type == "flat" } {
        foreach xblk $xblocks($type) {
          set filex "$xblk.$inputs(view).flat.sdf"
          
          set cmd "write_sdf -include  {SETUPHOLD RECREM}  -no_derates -compress gzip -input_port_nets -output_port_nets  -version 3.0 -context verilog $inputs(rep_dir)/sdf/$filex"
          puts "<CMD>  $cmd"
          if { $inputs(dry) == "0" } { eval $cmd }

          
          echo "<FLAT_SDF> :  $inputs(rep_dir)/sdf/$filex" >> $readme
          puts [format "\n\n<GC::PROC> Done  %-50s  [date]\n"   "sta_qual_generate_sdf_outputs : $filex" ]
        
        }
    # Gen Hier Collaterals        
      } else {
        foreach xblk $xblocks($type) {
          set filex "$xblk.$inputs(view).hier.sdf"
          
          if { $xblk != $xblocks(flat) } {
            set cmd   "write_sdf -include  {SETUPHOLD RECREM} -no_derates -compress gzip -instance [lindex $exclude_inst($xblk) 0]  -version 3.0 -context verilog $inputs(rep_dir)/sdf/$filex"
            puts "<CMD>  $cmd" 
            if { $inputs(dry) == "0" } { eval $cmd }
            
            echo "<HIER_SDF> :  $inputs(rep_dir)/sdf/$filex" >> $readme    
            echo "              - Include instance [lindex $exclude_inst($xblk) 0]" >> $readme
            puts [format "\n\n<GC::PROC> Done  %-50s  [date]\n"   "sta_qual_generate_sdf_outputs : $filex" ]            
          
          } else {
            set cmd   "write_sdf -include  {SETUPHOLD RECREM} -no_derates -compress gzip -exclude_cells [list $exclude_inst($xblk)]  -version 3.0 -context verilog $inputs(rep_dir)/sdf/$filex"
            puts "<CMD>  $cmd" 
            if { $inputs(dry) == "0" } { eval $cmd }
            #write_sdf -no_derates -compress gzip -exclude_cells {$exclude_inst($xblk)} -version 3.0 -context verilog $inputs(rep_dir)/sdf/$filex 

            
            echo "<HIER_SDF> :  $inputs(rep_dir)/sdf/$filex" >> $readme
            foreach inst [list $exclude_inst($xblk)] {  echo "              - Exclude instance $inst"  >> $readme }
            puts [format "\n\n<GC::PROC> Done  %-50s  [date]\n"   "sta_qual_generate_sdf_outputs : $filex" ]            
          
          }
        }
      }
    }

    file mkdir  $inputs(rep_dir)/verilog
    foreach x $NETLISTS {
        if { $inputs(dry) == "0" } { sh ln -sfn  $x $inputs(rep_dir)/verilog/. }
        echo "<VERILOGS> :  $inputs(rep_dir)/verilog/[lindex [split $x '/'] end]" >> $readme
    }
    puts [format "\n\n<GC::PROC> Done  %-50s  [date]\n"   "sta_qual_generate_sdf_outputs : verilog linking" ]



}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_generate_sdf_outputs
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_get_clock_cell_hierdata
## ProcArguments  : sta_qual_get_clock_cell_hierdata clock_hier_data view xfile
## ProcDependency :  
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_get_clock_cell_hierdata {clock_hier_data view xfile} {
   set file_data [split $clock_hier_data "\n"]
   set out1 [open $xfile w+]
   set dclass "clk_hier"
   puts $out1 "#pin,#top_clock,#top_block,#top_inst,#pin_size,#view,#class"
   set parse_data 0
   set top_blk  "NA"
   set top_inst "NA"
   foreach line $file_data {
     regsub -all {\s+} $line { } line
     set line_data [split $line " \+"]
     if { [llength $line_data] >= 2} {
        set line_data [split $line " \+"]
        set cell  [lindex $line_data 0]
        set tclk  [lindex $line_data 1]
        set bsen  [lindex $line_data 2]
        set object_cell        [get_cells  -quiet $cell]
        set object_cell_clock  [get_clocks -quiet $cell]
        set object_clk         [get_clocks -quiet $tclk]
        set comment "NA"
        if { [sizeof_collection $object_cell] > 0  && [sizeof_collection $object_clk] > 0 } {
            set top_inst "$cell"
            set line_data [lrange $line_data 0 end-1]
            set comment  "X"
        } elseif { [sizeof_collection $object_clk] > 0  } {
            set line_data [concat [list $top_inst] [lrange $line_data 1 end-1]]
            set comment  "Y"
        }
        if { $comment != "NA"} {
            set top_blk  [get_attr  [get_cells -quiet [lindex $line_data 0 ]]  ref_name]
            set blk_data [lrange $line_data 2 end]
            set clk_size [llength $blk_data]
            set top_inst [lindex $line_data 0]
            set top_clk  [lindex $line_data 1]
            foreach blk_clk $blk_data {
              puts $out1 "$top_clk>$blk_clk,$top_clk,$top_blk,$top_inst,$clk_size,$view,$dclass"
            }
        }
    }
  }
  close $out1
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_get_clock_cell_hierdata
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_get_clock_groups
## ProcArguments  : sta_qual_get_clock_groups clock_col
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_get_clock_groups clock_col {
    array unset phyex_clocks
    set phyex_index 0
    array unset clock_processed
    set valid_clocks $clock_col
    foreach_in_collection clk1 $clock_col {
        set clk1_name [get_object_name $clk1]
        if {! [info exist clock_processed($clk1_name)] } {
            set  phyex_clocks($clk1_name) [list $clk1_name]
            foreach_in_collection clk2 $valid_clocks {
                set clk2_name [get_object_name $clk2]
                if {  $clk1_name != $clk2_name  } {
                    set is_phyex  [get_clock_relationship -type physically_exclusive [get_clocks [list $clk1_name $clk2_name]]]
                    if {$is_phyex == "false"} {
                        lappend phyex_clocks($clk1_name) $clk2_name
                        set  valid_clocks [remove_from_collection  $valid_clocks [get_clocks -quiet [list $clk1_name $clk2_name]]]
                        set clock_processed($clk1_name) 1
                        set clock_processed($clk2_name) 1
                    }
                }
            }
        }
    }
    foreach clk [array names phyex_clocks] {
        puts [format "   %30s \t\t%-30s "  $clk "{$phyex_clocks($clk)}" ]
    }
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_get_clock_groups
##------------------------------------------------------------------


