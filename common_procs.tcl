##------------------------------------------------------------------
## ProcNameStart  : pt_report_eco_qc_reports
## ProcArguments  : pt_report_eco_qc_reports NEW_RPT_DIR PBA MAXPATH VERBOSE
## ProcDependency : sta_qual_report_summary_trancap , sta_qual_report_summary_path , sta_qual_report_summary_glitch 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc pt_report_eco_qc_reports {NEW_RPT_DIR PBA MAXPATH VERBOSE} {
    global GC_STA_ECO_ITER GC_STA_ECO_ITER_ORIG GC_STA_ECO_ITER_OLD IP_PROJ GC_STA_ECO_REPO GC_STA_ECO_FIXALL

    set waiver_string " --hier_map $GC_STA_ECO_REPO/$IP_PROJ/misc/$IP_PROJ.vio_map.json  --slack_waiver  $GC_STA_ECO_REPO/$IP_PROJ/misc/$IP_PROJ.waiver.vio_slack.json  --regex_waiver $GC_STA_ECO_REPO/$IP_PROJ/misc/$IP_PROJ.waiver.vio_regex.csv  --tech $GC_STA_ECO_REPO/$IP_PROJ/misc/$IP_PROJ.design_config.json "
    # Auto Map Iteration
    if { $VERBOSE == "1" } { 
        set files "{*csv,*detail*rpt*}"
    } else {
        set files "*csv"        
    }
    if { ! [info exist GC_STA_ECO_ITER_ORIG] }  {
        set GC_STA_ECO_ITER_ORIG $GC_STA_ECO_ITER
        puts "<INFO> Added   GC_STA_ECO_ITER=$GC_STA_ECO_ITER / GC_STA_ECO_ITER_ORIG=$GC_STA_ECO_ITER_ORIG"
        set GC_STA_ECO_ITER_OLD $GC_STA_ECO_ITER
    } else {
        set  GC_STA_ECO_ITER_OLD  $GC_STA_ECO_ITER
        incr GC_STA_ECO_ITER
        puts "<INFO> Updated GC_STA_ECO_ITER=$GC_STA_ECO_ITER / GC_STA_ECO_ITER_ORIG=$GC_STA_ECO_ITER_ORIG / GC_STA_ECO_ITER_OLD=$GC_STA_ECO_ITER_OLD"
    }


    # Auto Map Summary
    set OLD_RPT_DIR [file normalize $NEW_RPT_DIR/$GC_STA_ECO_ITER_OLD]    
    set NEW_RPT_DIR [file normalize $NEW_RPT_DIR/$GC_STA_ECO_ITER]

    # Dump Reports  
    file mkdir $NEW_RPT_DIR
    set cmd_remote "
    remote_execute {
       global TOP_DESIGN SCENARIO
       set BASE_TAG \$TOP_DESIGN.\$SCENARIO
       catch { sta_qual_report_summary_path    -base_tag \$BASE_TAG -rep_dir $NEW_RPT_DIR -max_path $MAXPATH -pba $PBA -nworst 1 -slack_lt -0.0009 -type maxmin}
       catch { sta_qual_report_summary_trancap -base_tag \$BASE_TAG -rep_dir $NEW_RPT_DIR }
       catch { sta_qual_report_summary_glitch  -base_tag \$BASE_TAG -rep_dir $NEW_RPT_DIR }

    }
    "
    puts "<INFO> Success : Reports   Started [date]"
    eval $cmd_remote 
    puts "<INFO> Success : Reports   Dumped  [date]"

    # Dashboard Gen
    puts "<INFO> Success : Dashboard Started [date]"    
    set cmd_direct "sh /skip_legacy/sta_qc/workspace/redondo-asia/tpe/shared/sta-cpu-1/sshakir/python_venv/python_venv/bin/python  /skip_legacy/sta_qc/workspace/redondo-asia/tpe/user/sshakir/area_1/scripts/common_checkin/dashboard_vX.10013/get_sta_summary.py --nc_resource \"CORES/4 RAM/64000\" --timeout 60m --stamp $GC_STA_ECO_ITER --dir $NEW_RPT_DIR/DB  --drv_full 1 --track_ref $OLD_RPT_DIR/DB/sta_summary.xlsx $waiver_string   $NEW_RPT_DIR/$files > $GC_STA_ECO_ITER.DB.log"  
    
    puts "\n\n<CMD> $cmd_direct\n\n"
    catch {  eval $cmd_direct }
    puts "<INFO> Success : Dashboard Dumped  [date]"    

    # Fixall DB 
    set fixall_file   "$NEW_RPT_DIR/DB/sta_summary.fixall.list"
    set cmd_direct "ls $NEW_RPT_DIR/DB/sta_summary.uniq_vio/*csv > $fixall_file"
    puts "\n\n<CMD> $cmd_direct\n\n"
    catch {  eval $cmd_direct }

    if { [file exist $NEW_RPT_DIR/DB/sta_summary.html/final.html] } {
        puts "<INFO> Success : sh firefox $NEW_RPT_DIR/DB/sta_summary.html/final.html"
        set GC_STA_ECO_FIXALL  $fixall_file
    } else {
        puts "<ERRX> Failure : sh firefox $NEW_RPT_DIR/DB/sta_summary.html/final.html"
    }
    return $GC_STA_ECO_FIXALL
}
