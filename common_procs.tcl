	set frmt      "|%12s|%${freq_size}s|%6s|%${clock_size}s|%-${pin_len}s|"
	puts_tee $out_p "\n\n"
	puts_tee $out_p "+[string repeat "-" ${dash1}]+"
	puts_tee $out_p [format |%-${dash1}s| "    Ref Lib Cell Used ($is_p):      [get_attribute -quiet  [get_cells $cell] ref_name]"]
	puts_tee $out_p "+[string repeat "-" 12]+[string repeat "-" ${freq_size}]+[string repeat "-" 6]+[string repeat "-" ${clock_size} ]+[string repeat "-" ${pin_len}]+"
	puts_tee $out_p [format $frmt "Const" "Freq/MHz" "Dir"  "Clocks"  "[string repeat " " ${space1}]Cell Pin[string repeat " " ${space1}]"]
	puts_tee $out_p "+[string repeat "-" 12]+[string repeat "-" ${freq_size}]+[string repeat "-" 6]+[string repeat "-" ${clock_size} ]+[string repeat "-" ${pin_len}]+"


	foreach_in_collection pin $cpins {
	  # use driver as reference for inputs 
	  set pin_drxs  [all_fanin -to $pin -pin_level 1 -flat ]
	  set pin_drx   $pin 
	  foreach_in_collection drx $pin_drxs {
      	      if { [get_object_name $drx ] != [get_object_name $pin] } { set pin_drx $drx}
	      #puts "             <DEBUG> Driver: [get_object_name $pin]  -> [get_object_name $drx ]"
          }
	  set use_clock_col [get_attribute -quiet  [get_${is_p} -quiet $pin_drx] clocks] 
	  set use_clock_col [add_to_collection $use_clock_col [get_attribute -quiet  [get_port -quiet $pin_drx] clocks]]
	  #puts "                 <DEBUG> Driver: [get_object_name $pin] <- [get_object_name $pin_drx]"
          if {[sizeof_collection $use_clock_col] != 0} {
	  set no_of_clk [sizeof_collection $use_clock_col]
	  set current_clk 0
	   while { $current_clk < $no_of_clk} {
	      set clocks [lindex [get_object_name $use_clock_col] $current_clk]
	      incr current_clk
	      set  my_period [format "%.3f" [get_attribute -quiet [get_clocks $clocks] period]]
	      set  my_attrc  "M"
	      if { [get_attr [get_clocks $clocks]  is_generated]} {
	      	set  my_attrc  "G"
	      }	
	      set pin_curr [get_object_name [get_${is_p} $pin]]
	      foreach_in_collection src [get_attr [get_clocks $clocks] sources] {
	        if { [get_object_name $src] == $pin_curr} {
		   set  my_attrc  "*${my_attrc}"
	    	}
	      }
	
	      if { $current_clk == 1} {
		   set my_freq     [format "%0.1f" [expr $ssi_sta_tool_unit_dly/$my_period]]
	           puts_tee $out_p [format $frmt  "$my_period" "$my_freq/MHz"  "$is_x [get_attribute -quiet  [get_${is_p} $pin] ${is_p}_direction]" " $clocks ($my_attrc)"  " [get_object_name [get_${is_p} $pin]]" ]
	      } else {
		   set my_freq     [format "%0.1f" [expr $ssi_sta_tool_unit_dly/$my_period]]
	           puts_tee $out_p [format $frmt  "$my_period" "$my_freq/MHz"  ""                                                                   " $clocks ($my_attrc)"  "" ]
	      }
	   }
	  } else {
	  set pin_drxs  [all_fanin -to $pin -pin_level 1 -flat ]
	  set pin_drx   $pin 
          foreach_in_collection drx $pin_drxs {
      	      if { [get_object_name $drx ] != [get_object_name $pin] } { set pin_drx $drx}
          }
	   set case_val [get_attribute -quiet  [get_${is_p} $pin_drx] case_value]
           set my_freq  ""
	   if { $case_val != "" } {
             set my_freq "Static$case_val"
	   } 
	   puts_tee $out_p [format $frmt "[get_attribute -quiet  [get_${is_p} $pin_drx] case_value]" "$my_freq" "$is_x [get_attribute -quiet  [get_${is_p} $pin] ${is_p}_direction]" "" " [get_object_name [get_${is_p} $pin]]"]
	  }
	 }
	puts_tee $out_p "+[string repeat "-" 12]+[string repeat "-" ${freq_size}]+[string repeat "-" 6]+[string repeat "-" ${clock_size} ]+[string repeat "-" ${pin_len}]+"

	puts_tee $out_p "\n\n"
	close $out_p
	puts "\t**Open file $xfile"
}
