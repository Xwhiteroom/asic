##------------------------------------------------------------------
proc get_io_lat {corner args} {
  if {[lindex $args 0] == "" } {
    set dir    "./latency_rpt.$corner"
  } else {
    set dir    "[lindex $args 0]/latency_rpt.$corner"      
  }    
  file mkdir $dir

  # Dump Latency Script
  set script "\n #!/usr/bin/perl\n use strict;use warnings;use File::Basename;\n my \$corner 	  = \"\$ARGV\[0\]\";\n my \$latency_file = \"\$ARGV\[1\]\";\n my \$outdir       = \"\$ARGV\[2\]\";\n my \$tagx         = \"\$ARGV\[3\]\";\n my \$outfile      = \"\$outdir/my_latency.\${tagx}.csv\";\n print(\"Corner      :: \$corner\\n\");\n print(\"LatencyFile :: \$latency_file\\n\");\n print(\"Outdir      :: \$outdir\\n\");\n print(\"Tagx        :: \$tagx\\n\");\n my \$full_data  = \"#CORNER,#CLASS,#CLOCK,#TOTAL_REGISTERS,#LATENCY_SUM,#LATENCY_AVG,#LATENCY_MAX,#LATENCY_MIN\\n\";
	if (defined \$latency_file and -e \$latency_file) { \n open(CLK,\"\$latency_file\") || die \"Can not open Latency File  - \$latency_file for reading.\\n\"; \n my \$clock_flag = 0; my \$no_of_reg = 0;  my \$sum_of_latency = 0;  my \$clock = \"NA\";  \n my \$max_latency =  \"NA\";  my \$min_latency =  \"NA\"; my \$avg_lat = \"NA\"; \n my \$lcnt = 0; my \@line_arr;\n while(my \$line = <CLK>) {\n \$lcnt++;\n if (\$lcnt =~ /00000$/m) { print \"\\t\\tFile \$latency_file -Processed lines = \$lcnt \\n\";}\n chomp \$line;\n if (\$line =~ /^\\s+Clock:/m) {\n if  ( \$clock  eq \"NA\" ) {print \"**Found First Clock \$clock\\n\";}\n if  ( \$clock  ne \"NA\" ) {\n if (\$no_of_reg > 0) {	\$avg_lat = \$sum_of_latency/\$no_of_reg;\$avg_lat = sprintf (\"\%.3f\",\$avg_lat);};\n \$no_of_reg = sprintf (\"\%.0f\",\$no_of_reg);\$sum_of_latency = sprintf (\"\%.3f\",\$sum_of_latency);\n if ( \$max_latency ne \"NA\") {\$max_latency = sprintf (\"\%.3f\",\$max_latency);\$min_latency = sprintf (\"\%.3f\",\$min_latency);};\n print \"\t\t\t Data Clock :: \$clock \$no_of_reg \$sum_of_latency \$max_latency \$min_latency\\n\";\n \$full_data  = \"\$full_data\\n\$corner,\$tagx,\$clock,\$no_of_reg,\$sum_of_latency,\$avg_lat,\$max_latency,\$min_latency\";\n printf temp_clk \"##corner,class,clock,no_of_reg,sum_of_latency,avg_latency,max_latency,min_latency\\n\";\n\				
								printf temp_clk \"##\$corner,\$tagx,\$clock,\$no_of_reg,\$sum_of_latency,\$avg_lat,\$max_latency,\$min_latency\\n\";\n close (temp_clk);\n }\n \$clock = \$line; \$clock =~ s/^\\s+Clock:\\s+//g;  \$clock =~ s/ //g;\n open(temp_clk,\">\$outdir/\$clock.\$tagx.rpt\") ;printf temp_clk \"\$line\\n\";\n \$no_of_reg = 0;  \$sum_of_latency = 0; \$max_latency = \"NA\";   \$min_latency = \"NA\";\$avg_lat = \"NA\";\n }\n if (\$line =~ /\\s0\\.0000\\s/m || \$line =~ /\\srp\-\+/m ){\n \@line_arr  =  split(/\\s+/,$\line);\n \$line_arr\[5\]= abs(\$line_arr\[5\]);
						 #Clock_Pin                            Trans   Source  Network Total\n \$no_of_reg++; \$sum_of_latency = \$sum_of_latency + \$line_arr\[5\];\n \$avg_lat = \"NA\";\n if (\$max_latency eq \"NA\" || (\$max_latency < \$line_arr\[5\] && \$line_arr\[5\] > 0 )  )  { \$max_latency = \$line_arr\[5\];};\n if (\$min_latency eq \"NA\" || (\$min_latency > \$line_arr\[5\] && \$line_arr\[5\] >= 0)  ) { \$min_latency = \$line_arr\[5\];};\n printf temp_clk \"\$line\\n\";\n };\n }\n if  ( \$clock  ne \"NA\" ) {\n if (\$no_of_reg > 0) {	\$avg_lat = \$sum_of_latency/\$no_of_reg;\$avg_lat = sprintf (\"\%.3f\",\$avg_lat);};\n \$no_of_reg = sprintf (\"\%.0f\",\$no_of_reg);\$sum_of_latency = sprintf (\"\%.3f\",\$sum_of_latency);\n if ( \$max_latency ne \"NA\") {\$max_latency = sprintf (\"\%.3f\",\$max_latency);\$min_latency = sprintf (\"\%.3f\",\$min_latency);};\n print \"\t\t\t Data Clock :: \$clock \$no_of_reg \$sum_of_latency \$max_latency \$min_latency\\n\";\n \$full_data  = \"\$full_data\\n\$corner,\$tagx,\$clock,\$no_of_reg,\$sum_of_latency,\$avg_lat,\$max_latency,\$min_latency\";\n printf temp_clk \"##corner,class,clock,no_of_reg,sum_of_latency,avg_latency,max_latency,min_latency\\n\";\n\		
								printf temp_clk \"##\$corner,\$tagx,\$clock,\$no_of_reg,\$sum_of_latency,\$avg_lat,\$max_latency,\$min_latency\\n\";\n close (temp_clk);\n }\n print \"\\t\\tFile \$latency_file -Processed lines = \$lcnt \\n\";\n close(CLK) || die \"Can not close Clock File- \$latency_file after reading.\\n\"; \n }\n open (inx1,\">\$outfile\");printf inx1 \"\$full_data\\n\"; close(inx1); \n print \"\\t\\tFile \$latency_file --> \$outfile\\n\";\n "
  set filex "${dir}/get_avg.pl"
  set   out  [open $filex w+]
  puts  $out "$script" 
  close $out
  
  # Initialize collection
  array unset all_reg_collection
  set launch_capture [list launch capture]
  set nworst 10000000  
  #set nworst 1000
  puts "\n\n"

  # Create Pin Collection : reg2out
  set all_regs [get_pins -of [ filter_collection [all_fanin -to [all_outputs] -flat -startpoints_only -only_cells] "is_sequential==true && is_hierarchical==false"] -filter "is_clock_pin"]
  set all_reg_collection(out) $all_regs
  puts "**Info: Parsing collection for outputs : [sizeof_collection $all_reg_collection(out)]"
  # Create Pin Collection : reg2out
  set all_regs [get_pins -of [ filter_collection [all_fanout -from [all_inputs -exclude_clock_ports] -flat -endpoints_only -only_cells] "is_sequential==true && is_hierarchical==false "] -filter "is_clock_pin"]
