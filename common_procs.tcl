##------------------------------------------------------------------
## ProcNameStart  : z
## ProcArguments  : z pin args
## ProcDependency : cell_pin_ref_clk 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc z {pin args} {
        puts "\ <INFO> z is x with a filter over Clk_Sinks"
    	puts "\t##Fain of : $pin"
	foreach_in_collection ret  [all_fanin -to $pin -pin_level 1 -flat ] {
	       set data [cell_pin_ref_clk $ret]
	       #puts "\t\tOrg $data"	       
	       if { ![regexp $pin $data] } {	       puts "\t\t$data"	   }
	       if { $args == "a" || $args == "all"} {if { [regexp $pin $data] } {	       puts "\t**\t$data"	   }}
	}
	puts "\n"
    	puts "\t##Faout of : $pin"	
	set sink_count 0
	foreach_in_collection ret [all_fanout -from $pin -pin_level 1  -flat] {
	        set data [cell_pin_ref_clk $ret]
		#puts "\t\tOrg $data"
	        if { [regexp  "Clk_Sink:" $data] } { incr sink_count
	        } else {
			if { ![regexp $pin $data] } {	       puts "\t\t$data"	   }
	    }
		if { $args == "a" || $args == "all"} {if { [regexp $pin $data] } {	       puts "\t**\t$data"	   }}
	}
	puts "\t\t** Filtered Sink Count Not Shown= $sink_count"
	puts "\n"
}
