##------------------------------------------------------------------
## ProcNameStart  : cell_windows
## ProcArguments  : cell_windows pin_cell
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc cell_windows pin_cell {

    set is_cell  [sizeof_collection [get_cells -quiet $pin_cell]]
    set is_pin   [sizeof_collection [get_pins  -quiet $pin_cell]]
    set is_port  [sizeof_collection [get_ports -quiet $pin_cell]]
    set obj_type "Pin"
    if { $is_cell > 0 }  { 
        set my_objs [get_pins -of_object [get_cells -quiet $pin_cell]]
    } elseif { $is_pin > 0 } {
        set my_objs [get_pins -quiet $pin_cell]
    } elseif { $is_port > 0 } {
        set my_objs [get_ports -quiet $pin_cell] 
        set obj_type "Port"        
    } else {
        return "Not a Cell/Pin/Port Object {$pin_cell} !"
    }
    set design [get_object_name [current_design]]
    set out_data [list]
    set data  "    #direction,#lib_pin,#case_clock,#win_clk,#win_edge,#min_r,#min_f,#max_r,#max_f,#ref_cell,#design,#obj_name"
    set data_line  "    ----------,----------,----------,----------,----------,----------,----------,----------,----------,----------,----------,----------"
    set data_line2  "    ----------,----------,----------,----------,----------,----------,----------,----------,----------,,,"

    lappend out_data $data
    lappend out_data $data_line

    foreach_in_collection my_obj $my_objs {
        set obj_name  [get_object_name $my_obj]
        set direction [get_attribute -quiet  $my_obj direction]
        set windows   [get_attribute -quiet  $my_obj arrival_window]
        set clocks    [get_attribute -quiet  $my_obj clocks]
        set case_val  [get_attribute -quiet  $my_obj constant_value]
        set case_tie  [get_attribute -quiet  $my_obj case_value]
        set slackS    [get_attribute -quiet  $my_obj max_slack]
        set slackH    [get_attribute -quiet  $my_obj min_slack]

        set casex     "TIMED" 
        catch { set casex   [format "H=%+0.3f/S=%+0.3f" $slackH $slackS] }
        if { $slackH == "INFINITY"    } { set casex "UNCONS" }        
        if { $case_val != "" } { set casex "CASE_$case_tie" }
        if { $case_tie != "" } { set casex "TIEOFF_$case_tie" }
        if { [sizeof_collection $clocks] > 0} { set casex "CLOCK" }

        set ref_cell  [get_attribute -quiet  [get_cells -quiet  -of_object $my_obj] ref_name]
        set comment   "None"
        set lib_pin [lindex [split $obj_name "/"] end]
        if { [sizeof_collection $clocks] > 0 } {  
            set clocks [get_object_name $clocks] 
        } else {
            set clocks "None"
        }
        #puts "Done1 $windows"
        if { $windows == "{}" } { set windows [list [list "- - - - - -" ]] }
        #puts "Done2 $windows"

        foreach window_1 $windows {
            #if { $window_1 == "{}" } { set window_1 ",}

            foreach window $window_1 {
                regsub -all {\{|\}|max_r_f|min_r_f} $window {} window
                regsub -all {\s+} $window {,} window  
                set cur_clk [lindex [split $window ","] 0]
                set target_clk [lsearch -all -inline $clocks $cur_clk] 
                if { $target_clk != "" } { set casex "CLOCK*" }
                set data      "    $direction,$lib_pin,$casex,$window,$ref_cell,$design,$obj_name"   
                lappend out_data $data
            }
       }
       lappend out_data $data_line2


    }
    lappend out_data $data_line
    set fileout [open temp_info.clock_arrivals.csv w+]
    foreach el $out_data {
        puts $fileout "$el"
    }
    close  $fileout
    cat  [pwd]/temp_info.clock_arrivals.csv | column -t -s , >  [pwd]/temp_info.clock_arrivals.rpt 
    set in [open  [pwd]/temp_info.clock_arrivals.rpt]
    while { [gets $in line] >= 0 } {
        echo "$line"
    }

    puts "**Open Files :  [pwd]/temp_info.clock_arrivals.csv "
    puts "**Open Files :  [pwd]/temp_info.clock_arrivals.rpt "


}
