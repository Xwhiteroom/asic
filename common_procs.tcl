##------------------------------------------------------------------
## ProcNameStart  : sta_qual_set_case_values
## ProcArguments  : sta_qual_set_case_values my_case_list
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_set_case_values my_case_list {
    foreach port_case $my_case_list {
        set pin_port  [lindex [split $port_case "," ] 0]
        set case      [lindex [split $port_case "," ] 1]
        set ports_cnt [sizeof_collection [ get_port -quiet $pin_port ] ]
        set pins_cnt  [sizeof_collection [ get_pin  -quiet $pin_port ] ]
        if { [expr $ports_cnt + $pins_cnt] > 0 } {
            puts "**STA_SDC_INFO:  CASES: Setting CaseValue  $ports_cnt/$pins_cnt    : $case $pin_port"
            if { $case != "X"} {
                set_case_analysis $case $pin_port
            }
        } elseif { [sizeof_collection [ get_pins -hier -quiet -filter "full_name =~ $pin_port"]] > 0 } {
            puts "**STA_SDC_INFO:  CASES: Setting CaseValue    : $case $pin_port"
            if { $case != "X"} {
                set_case_analysis $case [ get_pins -hier -quiet -filter "full_name =~ $pin_port"]
            }
        } else {
          puts "**STA_SDC_WARN:  CASES: Misisng Pin/Port : $case $pin_port"
        }
    }
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_set_case_values
