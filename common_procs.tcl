## ProcNameStart  : get_path_bins
## ProcArguments  : get_path_bins bins_list max_path_per_bin args
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc get_path_bins {bins_list max_path_per_bin args} {
    set bins_list "$bins_list,-99999.999"
    set bin_arr [split $bins_list ","]
    array unset bin_map
    set  i 0
    foreach binx $bin_arr {
        if { $i < [expr [llength $bin_arr] -1]} {
            set bin_map($i) "[lindex $bin_arr $i] [lindex $bin_arr [expr $i + 1]] $max_path_per_bin"
            puts [format "**INFO: Bin Selected(%02d) ID=%03d   %+10.3f   to   %+10.3f | Paths=%08d" [llength $bin_arr] $i   [lindex $bin_map($i) 0] [lindex $bin_map($i) 1]  [lindex $bin_map($i) 2] ]
            incr i
        }
    } 
    puts "\n\n"
    set path_collection [remove_from_collection [get_clocks *] [get_clocks *]]
    foreach bin_grp [lsort [array names bin_map]] {
        set cmd_str "\[get_timing_paths -slack_lesser_than [lindex $bin_map($bin_grp) 0] -slack_greater_than [lindex $bin_map($bin_grp) 1] -max_paths [lindex $bin_map($bin_grp) 2] $args\]"
        set cmd_str "\[get_timing_paths -slack_greater_than [lindex $bin_map($bin_grp) 1] -max_paths [lindex $bin_map($bin_grp) 2] $args\]"
        eval "set paths $cmd_str"
        set paths [filter_collection $paths "slack < [lindex $bin_map($bin_grp) 0]"]
        set path_collection [add_to_collection -unique $path_collection $paths]
        puts [format "**INFO: Bin Selected ID=%03d   %+10.3f   to   %+10.3f | Paths=%08d/%08d | <CMD> grt  $cmd_str"  $bin_grp   [lindex $bin_map($bin_grp) 0] [lindex $bin_map($bin_grp) 1]  [sizeof_collection $paths]  [sizeof_collection $path_collection] ]
    }

}
