proc sta_qual_report_is_real_clock_network obj {
  set is_clock_network [get_attr $obj is_clock_network -quiet]
  set is_clock_used_as_clock [get_attr $obj is_clock_used_as_clock -quiet]
  if { ${is_clock_network} != "" && ${is_clock_used_as_clock}!= "" && ${is_clock_network} == "true" && ${is_clock_used_as_clock} == "true" } {
