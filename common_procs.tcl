##------------------------------------------------------------------
## ProcNameStart  : apply_sfp_external_module_paths
## ProcArguments  : apply_sfp_external_module_paths target_blocks keep_block
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc apply_sfp_external_module_paths {target_blocks keep_block} {
    suppress_message UITE-216  
    suppress_message UITE-217
    set fp_blocks [list]
    foreach module $target_blocks {
        if { $module != $keep_block} { lappend fp_blocks $module }
    }
    # internal false
    set master_non_keep_pins [remove_from_collection [get_clocks *]  [get_clocks *]]
    set master_non_keep_pins_sp $master_non_keep_pins
    set master_non_keep_pins_ep $master_non_keep_pins
    foreach module $fp_blocks {
        set inst [get_cells -quiet -hier * -filter "ref_name==$module"]    
        if { [sizeof_collection $inst] > 0 } {
             foreach_in_collection  x $inst {
                set block [get_object_name $x]
                set block_pins [get_pins -hier * -filter "full_name =~ $block*"]
                set block_pins_sp [filter_collection [all_registers -clock_pins ]            "full_name =~$block*"]
                set block_pins_ep [filter_collection [all_registers -data_pins -async_pins ] "full_name =~$block*"]
                puts "**STA_SDC_INFO:  SFP: False path internal paths @ $block for module $module" 
                #set_false_path -from [get_pins $block_pins] -to [get_pins $block_pins]    
                set_false_path -from [get_pins $block_pins_sp] -to [get_pins $block_pins_ep]
                set master_non_keep_pins [add_to_collection $master_non_keep_pins $block_pins]
                set master_non_keep_pins_sp [add_to_collection $master_non_keep_pins $block_pins_sp]                
                set master_non_keep_pins_ep [add_to_collection $master_non_keep_pins $block_pins_ep]                
             }
        } else {
             puts "**STA_SDC_WARN:  SFP: No Valid Inst for @ $module"        
        }
    }
    # external false
    puts "**STA_SDC_INFO:  SFP: False path external paths [sizeof_collection [get_pins $master_non_keep_pins]] for $fp_blocks" 
    #set_false_path -from [get_pins $master_non_keep_pins] -to [get_pins $master_non_keep_pins]
    set_false_path -from [get_pins $master_non_keep_pins_sp] -to [get_pins $master_non_keep_pins_ep]
    unsuppress_message UITE-216
    unsuppress_message UITE-217    
}
##------------------------------------------------------------------
## ProcNameEnd    : apply_sfp_external_module_paths
##------------------------------------------------------------------


