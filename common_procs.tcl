## ProcNameStart  : get_hfn_nets
## ProcArguments  : get_hfn_nets max_fanout
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc get_hfn_nets max_fanout {
    set nets [get_nets -hier *]
    set all_nets [remove_from_collection [get_clocks *] [get_clocks *]]
    foreach_in_collection net $nets {
        set loads_x [get_attr -quiet $net leaf_loads]
        set size [sizeof_collection $loads_x]
        if { $size > $max_fanout} {
            #puts "[get_object_name $net],$size"
            set all_nets [add_to_collection $all_nets $net]
        }
    }
    return $all_nets
}
