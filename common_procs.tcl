##------------------------------------------------------------------
## ProcNameStart  : get_glitch_qc
## ProcArguments  : get_glitch_qc pins ir_pct limit
## ProcDependency : recalc_ir_derate 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc get_glitch_qc {pins ir_pct limit} {

    puts [format "%-15s %-15s %-15s %-15s %-15s %-15s %s | %s"   "IR" "LIMIT" "BUMP/OLD" "BUMP/NEW" "DERATE/OLD" "DERATE/NEW"  "Cell/Pin" "CMD"]
    foreach_in_collection pin [get_pins -quiet $pins -filter "direction==in"] {
        set pin       [get_object_name   $pin]
        set bump_old  [format "%0.5f" [get_attr [get_pins -quiet  $pin ] si_noise_height_offset_below_high]]
        set der_old   $bump_old
        set delta_new [ recalc_ir_derate $ir_pct $limit $der_old]
        set der_new   [format "%0.5f" [lindex $delta_new 1] ]
        set bump_new  [format "%0.5f" [expr $der_new * $bump_old] ]
        set cmd       "set_noise_derate -height_offset $bump_new \[get_pins $pin\]"
        puts [format "%-15s %-15s %-15s %-15s %-15s %-15s %s | %s"  $ir_pct $limit $bump_old $bump_new $der_old $der_new $pin $cmd]
    }
}
