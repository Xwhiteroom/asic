proc get_cell_pin_attr {path pin_col} {

    set out1 [open $path w+]
    puts $out1 "****************************************"
    puts $out1 "Report : Attribute"
    puts $out1 "Design : [get_object_name [current_design]]"
    puts $out1 "Version: $sh_product_version"
    puts $out1 "Date   : [date]"
