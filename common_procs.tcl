##------------------------------------------------------------------
## ProcNameStart  : pt_overlap_cone
## ProcArguments  : pt_overlap_cone collection1 collection2 io_epsp trace_genclk
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc pt_overlap_cone {collection1 collection2 io_epsp trace_genclk} {

	if { $trace_genclk == 1 } {
		set fanout11 [all_fanout -quiet -flat -from  $collection1 -continue_trace generated_clock_source]
		set fanout21 [all_fanout -quiet -flat -from  $collection2 -continue_trace generated_clock_source]

		set fanout12 [all_fanout -quiet -flat -from  $collection1 -end -continue_trace generated_clock_source]
		set fanout22 [all_fanout -quiet -flat -from  $collection2 -end -continue_trace generated_clock_source]

		set fanin11  [all_fanin -quiet -flat -to  $collection1 -continue_trace generated_clock_source]
		set fanin21  [all_fanin -quiet -flat -to  $collection2 -continue_trace generated_clock_source]

		set fanin12  [all_fanin -quiet -flat -to  $collection1 -start -continue_trace generated_clock_source]
		set fanin22  [all_fanin -quiet -flat -to  $collection2 -start -continue_trace generated_clock_source]
	} else { 
		set fanout11 [all_fanout -quiet -flat -from  $collection1 ]
		set fanout21 [all_fanout -quiet -flat -from  $collection2 ]

		set fanout12 [all_fanout -quiet -flat -from  $collection1 -end ]
		set fanout22 [all_fanout -quiet -flat -from  $collection2 -end ]

		set fanin11  [all_fanin -quiet -flat -to  $collection1 ]
		set fanin21  [all_fanin -quiet -flat -to  $collection2 ]

		set fanin12  [all_fanin -quiet -flat -to  $collection1 -start ]
		set fanin22  [all_fanin -quiet -flat -to  $collection2 -start ]
	}

	set output   "EMPTY_COLLECTION_SET_$io_epsp"
	if { [regexp "i" $io_epsp]} {	
		set output [remove_from_collection -intersect $fanin11 $fanin21]
		if { [regexp "s" $io_epsp] } {
			set output [remove_from_collection -intersect $fanin12 $fanin22]
		}	
	}
	if { [regexp "o" $io_epsp] } {
		set output [remove_from_collection -intersect $fanout11 $fanout21]
		if { [regexp "e" $io_epsp] } {
			set output [remove_from_collection -intersect $fanout12 $fanout22]
		}	
	}

	return $output

}
##------------------------------------------------------------------
## ProcNameEnd    : pt_overlap_cone
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : pt_path_id_map_loop
## ProcArguments  : pt_path_id_map_loop path idx pt_filex index_j
## ProcDependency : get_path_node_trace_list , xreport_timing , pt_timing_points_split 
## ProcInfluence  : 2
## ProcRenamed    : 0
##------------------------------------------------------------------
proc pt_path_id_map_loop {path idx pt_filex index_j} {
       # Import Global to Local Map
       set j    $index_j 
       # Xreport Data Parsing 
       redirect -variable xreport_timing_var {xreport_timing $path }
       redirect -file $pt_filex {puts $xreport_timing_var }
       # Summary Data	
       set paths_data "$pt_filex,$idx,[lindex [split $xreport_timing_var "\n"] end-2 ]"
       set paths_head "#File,#PathID,[lindex [split $xreport_timing_var "\n"] end-3 ]"
       # Node Data
       set slack               [get_attr -quiet $path slack]
       set return_point_data   [pt_timing_points_split  [get_attr -quiet $path points] "" "" 0]
       set nodetrace           [lindex $return_point_data 7]
       set nodecsv             [get_path_node_trace_list $nodetrace $j $pt_filex $idx $slack]
       set pt_node_data        [list]	
       set csv_head            [lindex [lindex $nodecsv 0] 0]
       if { $j == 0 }          {lappend pt_node_data "$csv_head" ;}
       set j                   [lindex $nodecsv 1]

       foreach x [lrange [lindex $nodecsv 0] 1 end] {
         lappend pt_node_data  "$x"
       }
       return [list $j $paths_head $paths_data $pt_node_data]
}
##------------------------------------------------------------------
## ProcNameEnd    : pt_path_id_map_loop
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : pt_pattern_qor
## ProcArguments  : pt_pattern_qor dirx iter patterns
## ProcDependency :  
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc pt_pattern_qor {dirx iter patterns} {
      global MODE CORNER       
      array unset data_power
      array unset data_size
  
      file mkdir "$dirx/$iter/$MODE.$CORNER/save_power"
      set gen_base_tag  [get_object_name  [current_design ]]_$iter.$MODE.$CORNER
      set sta_qual_metric     [list area total_power dynamic_power switching_power internal_power leakage_power] 
      set file_1 "$dirx/$iter/$MODE.$CORNER/save_power/$gen_base_tag.power.all_power_full.csv"
      set file_2 "$dirx/$iter/$MODE.$CORNER/save_power/$gen_base_tag.power.all_power.csv"
  
      set data "#Tag,#Pattern,#Clock/Data,#Size,#Area,#Total_Power,#Dynamic_Power,#Switching_Power,#Internal_Power,#Leakage_Power"
      set data_compact $data
      echo "$data"         > $file_1
      echo "$data_compact" > $file_2
      set used_patterns ""
  
  
      echo "   -- Patterns : $patterns"
      foreach patternx $patterns {
          set cell_coll [get_cells -hier -quiet * -filter "ref_name=~*${patternx}*"]
          set conditional_split [list ]
          if { [sizeof_collection $cell_coll] > 0 } {    set used_patterns "$used_patterns $patternx" }
          lappend conditional_split "clock_seq,is_memory_cell==false && is_combinational==false  && is_clock_network_cell==true"
          lappend conditional_split "clock_com,is_memory_cell==false && is_combinational==true   && is_clock_network_cell==true"
          lappend conditional_split "data_seq,is_memory_cell==false  && is_combinational==false  && is_clock_network_cell==false"
          lappend conditional_split "data_com,is_memory_cell==false  && is_combinational==true   && is_clock_network_cell==false"
          lappend conditional_split "mem_seq,is_memory_cell==true    && is_combinational==false  && is_clock_network_cell==false"
          lappend conditional_split "mem_com,is_memory_cell==true    && is_combinational==true   && is_clock_network_cell==false"
  
          foreach condition $conditional_split {
              set categ      [lindex [split $condition ","] 0]
              set conditionx [lindex [split $condition ","] 1]
              set xcell_coll [filter_collection $cell_coll "$conditionx"]
  
              set  data_power($patternx,$categ) [list [sizeof_collection $xcell_coll]]
              set  data_size($patternx,$categ)  [list [sizeof_collection $xcell_coll]]
              foreach type $sta_qual_metric {
                  set qor_list [get_attr  -quiet $xcell_coll $type]
                  set qor_val 0.000
                  foreach val $qor_list { set qor_val [expr $qor_val + $val + 0.000] }
                  #lappend data_power($patternx,$categ) $qor_val
                set factor 1.000;set prec   1
                if { ![regexp "area" $type] } { set factor "1000" ; set prec   3; }
                lappend data_power($patternx,$categ) [format "%0.${prec}f" [expr $factor* $qor_val]]
              }
          }
          puts "   -- Done for pattern $patternx"
      }
      foreach  index [lsort [array names data_power]] {
          set x [join $data_power($index) ","]
          echo "$gen_base_tag,$index,$x" >> $file_1
          if {  $data_size($index) > 0 } {        
              echo "$gen_base_tag,$index,$x" >> $file_2
          }
      }  
  
      puts " -- Power Split File              : $file_2"
      puts " -- Power Split Patterns Provided : $patterns"
      puts " -- Power Split Patterns Used     : $used_patterns"
  }
##------------------------------------------------------------------
## ProcNameEnd    : pt_pattern_qor
##------------------------------------------------------------------


