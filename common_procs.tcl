##------------------------------------------------------------------
## ProcNameStart  : pt_process_tetra_max
## ProcArguments  : pt_process_tetra_max ifile outdir maxmin pba
## ProcDependency : xreport_timing 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc pt_process_tetra_max {ifile outdir maxmin pba} {
	file mkdir $outdir
	set outdir [file normalize $outdir]
	set in_temp  [open $ifile]
	array unset path_strings
	set i 0 
	set j 0
	set k 0
    	#set idx   [format "%08d" $i]
	#set path_strings(#IDX) "#Line,#PathID,#PatternName,#Period,#Slack"
	set idx    "NA"
	set fromx  "NA"
        set tox    "NA"
        set thrux  "NA"
	puts "\n\n"
	puts "<INFO> Run      Dir  : $outdir\n"
	puts "<INFO> Tetramax File : $ifile (PBA=$pba / Delay=$maxmin)\n"

	puts "               -- TetraMax File Parsing Started [date]"
	while { [gets $in_temp line] >= 0 } {
		regsub -all  {\s+}  $line {,} line
		regsub -all  {^,}  $line  {}  line
		incr j
		# Path Ext
		if { [regexp ".path,\{" $line] } {
			set k   $j
			set idx_nminus1 $idx
			incr i
    			set idx   [format "%08d" $i]
    			# 1 to N-1 Paths	
    			if { $idx != [format "%08d" 1] } {
				set path_strings($slackx.$idx_nminus1) "Line:[expr $j -1 ],$idx_nminus1,$namex,$cyclex,$slackx,$fromx,$tox,$thrux"
			}
		}
		# Attr Parsing
		if { [regexp ",from:," $line]  } 	{	set fromx  [lindex [split $line ","] 2]	}
		if { [regexp ",to:,"   $line]  } 	{	set tox    [lindex [split $line ","] 2]	}
		if { [regexp ".name," $line]  } 	{	set namex  [lindex [split $line ","] 1] ; regsub -all "\"" $namex "" namex }
		if { [regexp ".cycle," $line] } 	{	set cyclex [lindex [split $line ","] 1] }
		if { [regexp ".slack," $line] } 	{	set slackx [lindex [split $line ","] 1] }
		# Attr Path String
		if { [regexp ".transition,\{" $line]} {
			set thrux "get_timing_path -path_type full_clock_expanded -delay $maxmin -pba_mode $pba"
			while { $line  != "\}" } {
				set thru [gets $in_temp line]
				regsub -all  {\s+}  $line {,} line
				regsub -all  {^,}  $line  {}  line
				set pin  [lindex [split $line ","] 0]
				set edge [lindex [split $line ","] 1]
				if { $line  != "\}" } {
					if { $edge == "v" || $edge == "!" } {
						set thrux "$thrux -fall_through $pin"
					} else {
						set thrux "$thrux -rise_through $pin"
					}
				}
				incr j
			}
		}

	}
	puts "               -- TetraMax File Parsing Completed [date]"

	set max_path $i
	set max_path_buck [expr $max_path/10.0]

	# Last Path
	if {[eof $in_temp]} {
		set path_strings($slackx.$idx) "Line:[expr $j -1 ],$idx,$namex,$cyclex,$slackx,$fromx,$tox,$thrux"
	}
	close $in_temp

	# Stream File
	set tmax_cmd_list "$outdir/tmax_cmd_list.$maxmin.PBA$pba.csv"
	set tmax_sum_list "$outdir/tmax_cmd_summary.$maxmin.PBA$pba.csv"
	set tmax_path_dir "$outdir/paths"
        file mkdir $tmax_path_dir
	set tmax_1        [open $tmax_cmd_list w+]
	set tmax_2        [open $tmax_sum_list w+]

	set i 0
	set j 0
	foreach x [lsort -increasing [array names path_strings]] {
		# Path trace
		set data "$path_strings($x)"
		puts $tmax_1 $data

		# Summary List
		set data_arr 	[split $data ","]
		suppress_message UITE-479
		set path    	[eval [lindex $data_arr end]]
		unsuppress_message UITE-479
		
		#set idx     	[lindex $data_arr 1]
    		set idx     	[format "%08d" $i]
		set tmaxid  	[lindex $data_arr 2]
		set id_file 	${maxmin}path.$idx.$tmaxid.PBA$pba.txt

                redirect -variable xreport_timing_var {xreport_timing $path }
                redirect -file  $tmax_path_dir/$id_file  { echo $xreport_timing_var }

		set csv_head "#File,#PathID,#TetraMaxID,[lindex $xreport_timing_var end-2]"
		set csv_data "$id_file,$idx,$tmaxid,[lindex $xreport_timing_var end-1]"
		if { $i == 0 } { puts $tmax_2 "$csv_head" }
		puts $tmax_2 "$csv_data"
		incr i
		incr j
		if { $j >= $max_path_buck } { puts "               -- Processed 10% / $i paths out of $max_path [date]" ; set j 0 }
	}
	close $tmax_1
	close $tmax_2
	puts "<INFO> Open File : [file normalize $tmax_cmd_list]"
	puts "<INFO> Open File : [file normalize $tmax_sum_list]"
	puts "<INFO> Open File : [file normalize $tmax_path_dir]"
}
##------------------------------------------------------------------
## ProcNameEnd    : pt_process_tetra_max
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : pt_process_tetra_max_pdf_report
## ProcArguments  : pt_process_tetra_max_pdf_report ifile outdir maxmin pba epin_string spin_string debug
## ProcDependency : xreport_timing 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc pt_process_tetra_max_pdf_report {ifile outdir maxmin pba epin_string spin_string debug} {
	file mkdir $outdir
	set outdir [file normalize $outdir]
	set in_temp  [open $ifile]
	array unset path_strings
	set i 0 
	set j 0
	set k 0
    	#set idx   [format "%08d" $i]
	#set path_strings(#IDX) "#Line,#PathID,#PatternName,#Period,#Slack"
	set idx    "NA"
	set fromx  "NA"
        set tox    "NA"
        set thrux  "NA"
	set slackx "ID"
        set pin_obj_dir "NA"
	set is_data_th "NA"
	set is_clk_th "NA"
	if { $debug != "1" } { set debug     "0"}
	set epin_is_not_clock 0
	if { $spin_string == "" || $spin_string == "default" || $spin_string == "x"} {
		set spin_string       "path.*trans=.*#single.*trans=.*#instances"
	}
	if { $epin_string == "" || $epin_string == "default" || $epin_string == "x"} {
		set epin_string       ""
		set epin_is_not_clock 1
	}
	puts "\n\n"
	puts "<INFO> Run  PDF     Dir    : $outdir\n"
	puts "<INFO> PDF Tetramax File   : $ifile (PBA=$pba / Delay=$maxmin)\n"
	puts "             Start Pattern : $spin_string"
	puts "             End  Pattern  : $epin_string"
	puts "             End  AutoDpin : $epin_is_not_clock"
	puts "                             -- PDF TetraMax File Parsing Started [date]"

	while { [gets $in_temp line] >= 0 } {
		regsub -all  {\s+}  $line {,} line
		regsub -all  {^,}  $line  {}  line
		incr j
		# Path Ext
		if { ![regexp "\-\-\-\-\-\-" $line] && ([regexp $spin_string $line] || ($is_clk_th != "1" && $is_data_th == "1" && $pin_obj_dir=="in")) } {
			set k   $j
			set idx_nminus1 $idx
			incr i
    			set idx   [format "%08d" $i]
    			# From
    			#puts "$idx | $pin_obj_dir /$is_data_th"
    			if { $is_data_th == "1" } {
				set is_data_th   "0"
				set line_start_ep $line
			}
			if { [regexp $spin_string $line] } {
				set line_next_ptr [gets $in_temp line_start_ep]
				regsub -all  {\s+}  $line_start_ep {,} line_start_ep
				regsub -all  {^,}   $line_start_ep {}  line_start_ep
			}
			incr j
			set fromx         [lindex [split $line_start_ep ","] 1]
			set rise_fall     [lindex [split $line_start_ep ","] 3]
			regsub -all  {\(R\)}   $rise_fall {-rise}  rise_fall
			regsub -all  {\(F\)}   $rise_fall {-fall}  rise_fall
			if { $debug }  { puts "\n$idx | $j | ${rise_fall}_through $fromx" }
		}
		# Attr Path String
		if {$fromx != "NA" } {
			set thrux     "get_timing_path -path_type full_clock_expanded -delay $maxmin -pba_mode $pba ${rise_fall}_through $fromx"
			set pin       [lindex [split $line ","] 1]
			set is_clk_th [get_pins -quiet $pin -filter "is_clock_used_as_clock==true"]
			set epinx     [get_pins -quiet $epin_string]
			#puts "$idx | $thrux"
			if { $debug }  { puts "$idx | Match=? | ClkPin=$is_clk_th | $fromx | $line" }
			while { ![regexp "\-\-\-\-\-\-" $line] } {
				set thru [gets $in_temp line]
				regsub -all  {\s+}  $line {,} line
				regsub -all  {^,}  $line  {}  line
				set pin  [lindex [split $line ","] 1]
				set edge [lindex [split $line ","] 3]
				set rise_fall $edge
				regsub -all  {\(R\)}   $rise_fall {-rise}  rise_fall
				regsub -all  {\(F\)}   $rise_fall {-fall}  rise_fall
				regsub -all  { }       $pin       {}       pin
				set pin_obj     [get_pins -quiet $pin]
				set pin_obj_dir [get_attr $pin_obj "direction"]
				set cell_obj    [get_cells -of_object $pin_obj]

				set is_clk_th  [sizeof_collection [filter_collection $pin_obj "is_clock_used_as_clock==true"]]
				set is_data_th [sizeof_collection [filter_collection $cell_obj "is_sequential==true && is_integrated_clock_gating_cell==false"]]

				set epin_match [sizeof_collection [remove_from_collection -intersect $pin_obj $epinx]]
				#puts "$idx | CLK=$is_clk_th EPIN=$epin_string EDGE=$edge | $thrux"
				if { $pin  != "" || $epin_match == 1  || ($is_clk_th == "0" && $epin_string == "") } {
					if { $pin != "" && $is_clk_th == "0" && $pin_obj_dir == "in"} {
						if { $edge == "(F)" || $edge == "!" || $edge == "v"} {
							#set thrux "$thrux -fall_through $pin"
							set thrux "$thrux -through $pin"

							if { $debug }  { puts "\t\t\t\t$idx | Match=$epin_match | ClkPin=$is_clk_th | -fall_through $pin" }
						} else {
							#set thrux "$thrux -rise_through $pin"
							set thrux "$thrux -through $pin"
							if { $debug }  { puts "\t\t\t\t$idx | Match=$epin_match | ClkPin=$is_clk_th | -rise_through $pin" }
						}
					}
					if { $is_data_th == "1" && $pin_obj_dir=="in"} {
						#puts "Found Data reg : $is_data_th | $fromx | $pin"
						set line "---------------"
					}

					if { $epin_match == 1 } { 
						set line "---------------"
					}
				} else {
					set line "---------------"
				}
				incr j
				set tox "$pin"
			}
			#puts "$idx | [expr $j ] | $thrux"
			#puts "$thrux"
			set compress_key [binary encode base64 $thrux ]
			regsub -all {,} $compress_key {_} compress_key
			#puts "$idx,[string length $compress_key]"
			#puts "$idx | ${rise_fall}_through $tox"
			set path_strings($idx) "Line:[expr $j],$idx,$compress_key,$fromx,$tox,$thrux"
			puts "$idx | $j | $fromx -> [lindex $thrux end] | isData=$is_data_th | isClk=$is_clk_th"
			set fromx "NA"
			#if { $is_data_th == "1" && $pin_obj_dir=="in"} {
				#puts "Found Data reg : $is_data_th | $pin"
				#puts "Pinx=$pin"
			#}
		}
	}
	puts "                             -- PDF TetraMax File Parsing Completed [date]"
	puts "                             -- PDF TetraMax File Paths=$idx [date]"
	close $in_temp
	set max_path $i
	set max_path_buck [expr $max_path/10.0]

	# Stream File
	set tmax_cmd_list     "$outdir/tmax_pdf_cmd_list.$maxmin.PBA$pba.csv"
	set tmax_sum_list     "$outdir/tmax_pdf_cmd_summary.$maxmin.PBA$pba.csv"
	set tmax_path_dir     "$outdir/paths_pdf"
	set tmax_pathfail_dir "$outdir/paths_fail_pdf"

        file mkdir $tmax_path_dir
        file mkdir $tmax_pathfail_dir
	set tmax_1        [open $tmax_cmd_list w+]
	set tmax_2        [open $tmax_sum_list w+]

	set i 0
	set j 0
	foreach x [lsort -increasing [array names path_strings]] {
		#puts "$path_strings($x)"
		# Path trace
		set data "$path_strings($x)"
		puts $tmax_1 $data

		# Summary List
		set data_arr 	[split $data ","]
		suppress_message UITE-479
		set path    	[eval [lindex $data_arr end]]
		#puts "[lindex $data_arr end]"
		unsuppress_message UITE-479
		if { [sizeof_collection $path] == 0 } {
			puts "\t\t\t\tFailed : $x / [lindex $data_arr 0]"
		        set id_file 	${maxmin}path.$idx.PBA$pba.txt.failed
			regsub -all {\-} [lindex $data_arr end]  "\\\n-" path_string_hack
                        redirect -file  $tmax_pathfail_dir/$id_file  { echo $path_string_hack }
			echo $path_string_hack
		}
		#set idx     	[lindex $data_arr 1]
    		set idx     	[format "%08d" $i]
		set tmaxid  	[lindex $data_arr 2]
		set id_file 	${maxmin}path.$idx.PBA$pba.txt

                redirect -variable xreport_timing_var {xreport_timing $path }
                redirect -file  $tmax_path_dir/$id_file  { echo $xreport_timing_var }

		set csv_head "#File,#PathID,#TetraMaxID,[lindex $xreport_timing_var end-2]"
		set csv_data "$id_file,$idx,$tmaxid,[lindex $xreport_timing_var end-1]"
		if { $i == 0 } { puts $tmax_2 "$csv_head" }
		puts $tmax_2 "$csv_data"
		incr i
		incr j
		if { $j >= $max_path_buck } { puts "               -- Processed 10% / $i paths out of $max_path [date]" ; set j 0 }
	}
	close $tmax_1
	close $tmax_2
	puts "<INFO> Open File : [file normalize $tmax_cmd_list]"
	puts "<INFO> Open File : [file normalize $tmax_sum_list]"
	puts "<INFO> Open File : [file normalize $tmax_path_dir]"


}
##------------------------------------------------------------------
## ProcNameEnd    : pt_process_tetra_max_pdf_report
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : pt_profile_endpoint
## ProcArguments  : pt_profile_endpoint outdir tag end_point pba slack max_min max_path_per_start_point
## ProcDependency : xreport_timing 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc pt_profile_endpoint {outdir tag end_point pba slack max_min max_path_per_start_point} {

	set path_rpt_dir $outdir
	file mkdir $path_rpt_dir
	set  empty_collection      [remove_from_collection [all_clocks] [all_clocks]]
	#set  pba                   "none"

	set end_points    [get_pins -quiet $end_point]
	set start_points  [all_fanin -to $end_points -start -flat]
	set start_cone    [all_fanin -to $end_points -only_cells -flat]
	set tdir          $path_rpt_dir/$tag
	file mkdir        $tdir
	puts "\n\n"
	puts "<Dir Created>      : $tdir"
	puts "<Collection Target>: StartPoints=[sizeof_collection $start_points] --> ComboCone=[sizeof_collection $start_cone] --> EndPoints=[sizeof_collection $end_points]"
	puts "<Timing     Target>: Setup/Hold=$max_min PBA_Mode=$pba Slack_Less_Than=$slack Max_Path/SP=$max_path_per_start_point"

	# Path Loop
	set paths                $empty_collection
	set i                    [expr [sizeof_collection $start_points] / 10.0]
	foreach_in_collection ep $end_points {
		set j                    0
		set k                    0
		foreach_in_collection sp $start_points {
    			set path [get_timing_path  -from $sp -to $ep -path_type full_clock_expanded -delay $max_min -slack_less $slack -pba $pba -max_path $max_path_per_start_point]
			set slack_path [get_attr $path slack]
			if { $slack_path <= $slack && $slack_path != ""} {
    				append_to_collection  paths   $path
				incr j
			} else {
				incr k
			}
			if { $j >= $i } { puts "               -- Processed 10% / $i paths (Invalid=$k) [date]" ; set j 0 }
		}
	}

	# Path Dumping
	puts "<Paths Found> :  [sizeof_collection $paths]"
	set paths [sort_collection $paths slack]
	set i 0
	foreach_in_collection path $paths {
    		set idx [format "%08d" $i]
    		incr i
    		set spoint   [get_object_name [get_attr $path startpoint]]
    		set epoint   [get_object_name [get_attr $path endpoint]]
    		xreport_timing -from $spoint -to $epoint -path_type full_clock_expanded -delay $max_min -slack_less $slack -pba $pba -max_path $max_path_per_start_point > $tdir/${max_min}path.$idx.isPBA$pba.txt
	}
	puts "<File Dir>  :  [file normalize $tdir]/${max_min}path.*.isPBA$pba.txt"
}
##------------------------------------------------------------------
## ProcNameEnd    : pt_profile_endpoint
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : pt_profile_net_collection
## ProcArguments  : pt_profile_net_collection net_collection view outdir
## ProcDependency : get_net_delay , get_net_length 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc pt_profile_net_collection {net_collection view outdir} {
    array unset data_array
    file mkdir $outdir
    set xfile "$outdir/net_delay.$view.csv"
    set printdata "#VIEW,#CLOCKNET,#NET,#LENGTH,#DRIVER,#DRIVERCELL,#DRIVER_TRAN,#SINKS,#SINK(TRAN),#MAXTRAN(REQUIRED),#XTLK(DLY),#XTLK(DTRAN),#DELAY(MAX),#CAP(PIN),#CAP(NET),#RESISTANCE(NET)"
    set i 0    
    set data_array("#NET") $printdata
    puts "          -- start collection trace [sizeof_collection $net_collection] [date]"   
    foreach_in_collection net $net_collection {
        incr i
        set net_name [get_object_name $net]
        set data [get_net_delay $net_name]
        set min_dly [lindex [split [lindex $data 1] ","] 3]
        set max_dly [lindex [split [lindex $data 1] ","] 6]

        set pin_cap     [get_attr -quiet $net pin_capacitance_max]
        set net_cap     [get_attr -quiet $net wire_capacitance_max]
        set net_res     [get_attr -quiet $net net_resistance_max]
        set net_xtlk    [get_attr -quiet $net annotated_delay_delta_max]
        set net_Dxtlk   [get_attr -quiet $net annotated_transition_delta_max]
        set driver      [get_pins -quiet [all_fanin -quiet  -to $net -flat -pin_level 1] -filter "direction==out"] 
	set driver_tran [get_attr -quiet $driver actual_transition_max]
	set driver_name [get_object_name $driver]
	set driver_cell [get_attr -quiet [get_cells -quiet -of_object $driver] ref_name]

	set load_cone   [get_pins -quiet [all_fanout -quiet  -from $net -flat -pin_level 1] -filter "direction==in"]
	set total_load  [sizeof_collection $load_cone]
	set load_tran [lsort -increasing [get_attr -quiet  $load_cone actual_transition_max]]
	set load_tran_worst [lindex $load_tran end]
	set load_tran_best [lindex $load_tran 0]
	set load_target_tran [lsort -increasing [get_attr -quiet  $load_cone drc_actual_max_transition]]
	set load_lib_tran    [lsort -increasing [get_attr -quiet  $load_cone max_transition]]

	set load_tran_limit  [lindex $load_target_tran 0]
	set load_tran_lib    [lindex $load_lib_tran 0]
	set net_is_clk       [get_attr -quiet $net is_clock_network]	
	set net_len   "NA"
        catch { set net_len   [get_net_length $net] }
        set printdata "$view,$net_is_clk,$net_name,$net_len,$driver_name,$driver_cell,$driver_tran,$total_load,$load_tran_worst,$load_tran_lib,$net_xtlk,$net_Dxtlk,$max_dly,$pin_cap,$net_cap,$net_res"
        set data_array($net_name) "$printdata"
    }
    puts "          -- processed $i [date]" 
    puts "          -- done collection trace [date]"   
    set out [open $xfile w+]
    foreach data [lsort [array names data_array]] {
        puts $out "$data_array($data)"
    }
    puts "          -- complete file write [date]"  
    close $out    
    puts "** Open File :: [file normalize $outdir]"
}
##------------------------------------------------------------------
## ProcNameEnd    : pt_profile_net_collection
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : pt_profile_path_collection
## ProcArguments  : pt_profile_path_collection outdir tag slack max_min path_collection
## ProcDependency : pt_path_id_map_loop , get_proc_def , inv_path_id_map_loop 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc pt_profile_path_collection {outdir tag slack max_min path_collection} {
	file mkdir 		$outdir
	set  tdir          	$outdir/$tag
	file mkdir        	$tdir
	set  path_rpt_dir 	$tdir/post_process
	file mkdir        	$tdir/post_process/primetime
	set  scripts_dir 	$tdir/scripts
	file mkdir        	$tdir/scripts
	
	# Debug Control
	set debug 0

	set  empty_collection   [remove_from_collection [all_clocks] [all_clocks]]
	
	set  path_collection_valid_path      [filter_collection $path_collection "path_type==$max_min"]
	set  path_collection_valid_pathslack [filter_collection $path_collection_valid_path "slack<=$slack"]
  	# Path Filtering
	puts "\n\n"
	puts "<Dir Created>      : $tdir"
	puts "<Timing     Target>: Setup/Hold=$max_min Slack_Less_Than=$slack"
	puts "<Timing     Target>: TotalPaths=[sizeof_collection $path_collection]"
	puts "<Timing     Target>: TotalPaths\[$max_min\]=[sizeof_collection $path_collection_valid_path]"
	puts "<Timing     Target>: TotalPaths\[$max_min.Slack_Lt_$slack\]=[sizeof_collection $path_collection_valid_pathslack]"
 
	# Path Dumping
	#set paths [sort_collection $path_collection_valid_pathslack slack]
	set paths $path_collection_valid_pathslack

	set i 0
	set j 0

	set summary  "$path_rpt_dir/$tag.primetime.$max_min.$slack.summary.csv"
	set node_csv "$path_rpt_dir/$tag.primetime.$max_min.$slack.node_data.csv"
	set inv_tcl  "$scripts_dir/$tag.$max_min.$slack.innovus_gen_data.tcl"
	set pt_db    "$scripts_dir/$tag.$max_min.$slack.primetime_import_data.tcl"

	set out1 [open $summary w+]
	set out2 [open $node_csv w+]
	set out3 [open $inv_tcl  w+]
	set out4 [open $pt_db  w+]

	# Procs
	set procs_list [list ]
        lappend  procs_list get_proc_def 
	lappend  procs_list get_path_node_trace_list 
	lappend  procs_list pt_profile_path_collection
	lappend  procs_list inv_profile_path_collection 
	lappend  procs_list xreport_timing 
	lappend  procs_list inv_xreport_timing  
	lappend  procs_list pt_timing_points_split 
	lappend  procs_list inv_timing_points_split 
	lappend  procs_list pt_path_id_map_loop 
	lappend  procs_list inv_path_id_map_loop

	foreach procx $procs_list {
	    set datap ""
            catch { set datap [get_proc_def $procx] }
            if { $datap != "" } {
                puts $out3 "##------------------------------------------------------------------"
                puts $out3 "## ProcNameStart : $procx"
                puts $out3 "##------------------------------------------------------------------"
                puts $out3 $datap
	    }
	}
        puts $out3 "##------------------------------------------------------------------"        
	puts $out3 "## Set Directory Setup"
        puts $out3 "##------------------------------------------------------------------"        
        puts $out3  "    set outdir           [file normalize $tdir]"
        puts $out3  "    file mkdir           \$outdir/post_process/primetime"
        puts $out3  "    file mkdir           \$outdir/post_process/innovus"
        puts $out3  "    catch { exec ln -sn \$outdir . }"
	puts $out3  "    puts \"\""
	puts $out3  "    puts \"\""
        puts $out3  "    puts  \"<INFO> : Linked Reports Directory : \$outdir\"\n\n"

        puts $out3 "##------------------------------------------------------------------"        
	puts $out3 "## Set Init Collection For Innovus"
        puts $out3 "##------------------------------------------------------------------"   
	puts $out3  "    set empty_collection \[remove_from_collection \[all_clock\] \[all_clocks\]\]"
        puts $out3  "    array unset 		innovus_paths_arr"
        puts $out3  "    array unset 		pt_node_arr"
        puts $out3  "    array unset 		pt_summary_arr"
        puts $out3  "    array unset 		pt_pin_arr"
        puts $out3  "    array unset 		pt_missed_arr"
        puts $out3  "    array unset 		inv_node_arr"
        puts $out3  "    array unset 		inv_summary_arr"
        puts $out3  "    array unset 		inv_pin_arr"
        puts $out3  "    array unset 		inv_missed_arr"
        puts $out3  "    set innovus_paths 	\$empty_collection\n\n"

        puts $out3 "##------------------------------------------------------------------"        
	puts $out3 "## Profile Paths"
        puts $out3 "##------------------------------------------------------------------"   
        puts $out3 "    set j 0"   
	puts $out3 "    set summary           \"\$outdir/post_process/$tag.innovus.$max_min.$slack.summary.csv\""
	puts $out3 "    set node_csv          \"\$outdir/post_process/$tag.innovus.$max_min.$slack.node_data.csv\""
	puts $out3 "    set innovus_db        \"\$outdir/scripts/$tag.$max_min.$slack.innovus_import_data.tcl\""
	puts $out3 "    set delta_summary_csv \"\$outdir/post_process/$tag.pt_vs_inv.$max_min.$slack.summary.csv\""
	puts $out3 "    set delta_node_csv    \"\$outdir/post_process/$tag.pt_vs_inv.$max_min.$slack.node_data.csv\""


	puts $out3 "    set out1 \[open \$summary w+\]"
	puts $out3 "    set out2 \[open \$node_csv w+\]"
	puts $out3 "    set out3 \[open \$innovus_db w+\]"
	puts $out3 "    set out4 \[open \$delta_summary_csv w+\]"
	puts $out3 "    set out5 \[open \$delta_node_csv w+\]"
        puts $out3 "    puts \$out3 \"##------------------------------------------------------------------\""        
	puts $out3 "    puts \$out3 \"## INV Import DB\""
        puts $out3 "    puts \$out3 \"##------------------------------------------------------------------\""  
        puts $out3 "    puts \$out3 \"    set outdir            [file normalize $tdir]\""
        puts $out3 "    puts \$out3 \"    array unset 		inv_node_arr\""
        puts $out3 "    puts \$out3 \"    array unset 		inv_summary_arr\""
        puts $out3 "    puts \$out3 \"##------------------------------------------------------------------\""    

        puts $out4 "##------------------------------------------------------------------"        
	puts $out4 "## PT Import DB"
        puts $out4 "##------------------------------------------------------------------"  
        puts $out4  "    set outdir             [file normalize $tdir]"   
        puts $out4  "    array unset 		pt_node_arr"
        puts $out4  "    array unset 		pt_summary_arr"
        puts $out4 "##------------------------------------------------------------------"     


	puts "<Timing     PathCh>: Begin Path Parsing Loop [sizeof_collection $paths]"
	foreach_in_collection path $paths {
    		set idx [format "ID%08d" $i]
    		incr i
    		set spoint   [get_object_name [get_attr $path startpoint]]
    		set epoint   [get_object_name [get_attr $path endpoint]]
                set slk_type [get_attr -quiet $path path_type]
		if { $slk_type == "max" } { 
			set report_type " -late " 
		} else { 
			set report_type " -early " 
		}
    		set slack    [get_attr $path slack]
	        set pt_filex   [file normalize $tdir]/post_process/primetime/${max_min}path.$idx.txt 
		
                # Extract PT Path Summary
                set mapped_path_data            [pt_path_id_map_loop $path $idx $pt_filex $j] 
       		set j                           [lindex $mapped_path_data 0]
       		set pt_summary_head             [lindex $mapped_path_data 1]
       		set pt_summary_data             [lindex $mapped_path_data 2]
       		set pt_node_datalist            [lindex $mapped_path_data 3]
		set expected_node_offset        $j
                # Stream PT Header Summary
		if { $i == 1 } {
			puts $out1 "$pt_summary_head" 
			puts $out3  "    set pt_summary_arr([format "ID%08d" -1])  \"$pt_summary_head\""
			puts $out3  "    set inv_summary_arr([format "ID%08d" -1])  \"$pt_summary_head\""
	    	        puts $out3  "    puts \$out1 \"$pt_summary_head\""
	    	        puts $out3  "    puts \$out3 \"set inv_summary_arr([format "ID%08d" -1]) $pt_summary_head\""
                        puts $out3  "    regsub -all {\[^,|#\]} \$inv_summary_arr([format "ID%08d" -1]) {} missing_data_string\n\n"
			puts $out4  "    set pt_summary_arr([format "ID%08d" -1])  \"$pt_summary_head\""
		}
		if { $debug } { puts "                 <Debug>: $idx Path Header Extracted" }

                # Stream PT Data Summary
		puts $out1 "$pt_summary_data"
		if { $debug } { puts "                 <Debug>: $idx Path Summary Extracted" }
      	        puts $out4  "\n    set pt_summary_arr($idx)  \"$pt_summary_data\""

                # Stream PT Node Summary
       		foreach x $pt_node_datalist {
         		puts $out2 "$x"
      	                puts $out3  "    set pt_node_arr($idx.[lindex [split $x ","] end])  \"$x\""
      	                puts $out4  "    set pt_node_arr($idx.[lindex [split $x ","] end])  \"$x\""

       		}
		if { $debug } { puts "                 <Debug>: $idx Path Node Extracted" }

                puts $out3  "\n    #Path ID=$idx"
		puts $out3  "    set inv_filex  \$outdir/post_process/innovus/${max_min}path.$idx.txt"
		puts $out3  "    set innovus_paths_arr($idx)  \[report_timing $report_type -collection -max_slack 20 -path_type full_clock [lindex [split $pt_summary_data ","] end] \]"
		puts $out3  "    if { \[sizeof_collection \$innovus_paths_arr($idx)\] } {"
                puts $out3  "       append_to_collection innovus_paths \$innovus_paths_arr($idx)"
                #puts $out3  "       #puts \" Dumped $idx Lines=\[lindex \[exec wc -l  \$inv_filex\] 0\]\""
                puts $out3  "       set mapped_path_data            \[inv_path_id_map_loop \$innovus_paths_arr($idx) $idx \$inv_filex \$j\] "
  		puts $out3  "       set j                           \[lindex \$mapped_path_data 0\]"
  		puts $out3  "       set inv_summary_head            \[lindex \$mapped_path_data 1\]"
  		puts $out3  "       set inv_summary_arr($idx) \[lindex \$mapped_path_data 2\]"
  		puts $out3  "       set inv_node_datalist           \[lindex \$mapped_path_data 3\]"
	    	puts $out3  "       puts \$out3 \"\\nset inv_summary_arr($idx) \$inv_summary_arr($idx)\""
                puts $out3  "       foreach x \$inv_node_datalist {"
      	        puts $out3  "         set inv_node_arr($idx.\[lindex \[split \$x \",\"\] end\])  \"\$x\""
      	        puts $out3  "         set inv_pin_arr(\[lindex \[split \$x \",\"\] end\])        $idx"
		puts $out3  "         puts \$out2 \"\$x\""
	    	puts $out3  "         puts \$out3 \"set inv_node_arr($idx.\[lindex \[split \$x \",\"\] end\]) \$x\""
                puts $out3  "       }"    
		puts $out3  "       puts \$out1 \"\$inv_summary_arr($idx)\""
 
                puts $out3  "    } else {"
                puts $out3  "       puts \"       -- Skipped ID=$idx | Node Offset = $expected_node_offset / Present=\$j\""
                puts $out3  "       set j $expected_node_offset"
                puts $out3  "       regsub -all {^#,#,} \$missing_data_string \"#Missing,$idx,\" missing_data"
                puts $out3  "       puts \$out1 \"\$missing_data\""
