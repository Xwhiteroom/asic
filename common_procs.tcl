##------------------------------------------------------------------
## ProcNameStart  : sta_qc_get_sram_stats
## ProcArguments  : sta_qc_get_sram_stats BASE_TAG rep_dir args
## ProcDependency : puts_tee 
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qc_get_sram_stats {BASE_TAG rep_dir args} {
    set rep_dir [file normalize $rep_dir]
    file mkdir $rep_dir
    set xfile "$rep_dir/misc.sram_timing.$BASE_TAG.rpt"
    #Map Collection 
    if { [lindex $args 0] == "" } {
        echo "** STA_CFG_INFO: Extract default memory from design: is_memory_cell true [date]"
        set cells [get_cells -quiet -hier -filter "is_memory_cell==true"]
    } elseif { [sizeof_collection [lindex $args 0]] > 0 } {
        echo "** STA_CFG_INFO: Extract regexp  memory from design: full_name [lindex $args 0] [date]"        
        set cells [get_cells -quiet -hier -filter "full_name=~[lindex $args 0]"]
    } else {
        echo "** STA_CFG_INFO: Extract collection  memory from design: collection [date]"                
        set cells [get_cells [lindex $args 0]]
    }

    # Map Setup Pins
    if { [lindex $args 1] == "" } {
        set inputs [list CSN* CRE* DIN[*] A[*] BWEN[*] ADME[*]]
    } else {
        set inputs [lindex $args 1] 
    }

    # Map C2Q pins
    if { [lindex $args 2] == "" } {
        set outputs [list DOUT[*] ]
    } else {
        set outputs [lindex $args 2] 
    }
    
    # SRAM Cell Info
    set out_p [open $xfile w+]
    set place_holder 1; proc x_sort_clock {clocks} {
        set clocks [get_clocks $clocks]
        set listx [list]
        foreach_in_collection clk $clocks {
                if { [sizeof_collection [get_attr -quiet $clk sources]] > 0 && [get_attr -quiet $clk is_generated] == false} {
                        lappend listx "[get_attr -quiet $clk period],[get_object_name $clk]"
                }
        }
        set listx [lsort -increasing $listx]
        return $listx    
    }
    set place_holder 1; proc x_get_arc_delay {in out} {
        set delay "noarc"
        set case_val [get_attr -quiet  [get_pins $out] case_value]
        if { [llength $case_val] == [sizeof_collection [get_pins $out] ] } {
            set case_val  "xcase"
        } else {
            set case_val  ""
        }

        if { $case_val == "" } {
            catch {set delay [format "%0.3f" [ lindex [lsort -increasing [get_attr -quiet [get_timing_arcs -quiet -from $in -to $out -filter "delay_max<10" ] delay_max] ] end ] ]}
        } else {
            set delay "$case_val"
        }
        return $delay
    }


    # Iteration
    if { [sizeof_collection $cells ] > 0 } {
        array unset max_length
        set max_length(ref)     10
        set max_length(name)    20
        set max_length(area)     5
        set max_length(xy)       5
        set max_length(clk)     10
        set max_length(inputs)  10
        set max_length(outputs) 10

        set data_x [list]
        #set data_x [list "Area Loc Ref Clock Cell"]
        foreach_in_collection cell [get_cells $cells] {
            set name [get_object_name $cell]
            set ckp  [get_pins $name/* -filter "is_clock_pin==true"]
            foreach_in_collection ckpin [get_pins $ckp] {
                set ckp  [get_attr $ckpin lib_pin_name] 
                set clk  "[lindex [split [lindex [ x_sort_clock [get_attr -quiet [get_pins $ckpin] clocks]] 0] "," ] 1]:$ckp"
                set area [format "%0.3f" [get_attr $cell area]]
                set ref  [get_attr $cell ref_name]
                set x1   "0";
                set y1   "0"
                catch {set x1 [format "%0.0f" [expr [get_attr -quiet $ret "x_coordinate_max"] / 1000]]}
                catch {set y1 [format "%0.0f" [expr [get_attr -quiet $ret "y_coordinate_max"] / 1000]]}
	        set xy   "$x1,$y1"
                set Dinputs  ""
                foreach x $inputs {
                    set dpin [get_pins -quiet $name/$x -filter "direction==in"]
                    if { [sizeof_collection $dpin] > 0 } {
                        set delay [x_get_arc_delay $name/$ckp $name/$x]
                        set Dinputs "$x:$delay,$Dinputs"
                    }
                }
                set Doutputs ""
                foreach x $outputs {
                    set dpin [get_pins -quiet $name/$x -filter "direction==out"]
                    if { [sizeof_collection $dpin] > 0 } {
                        set delay [x_get_arc_delay $name/$ckp $name/$x]
                        set Doutputs "$x:$delay,$Doutputs"
                    }
                }



                if { [string length $name] > $max_length(name)}         { set max_length(name)    [string length $name    ] }
                if { [string length $ref] > $max_length(ref)}           { set max_length(ref)     [string length $ref     ] }
                if { [string length $area] > $max_length(area)}         { set max_length(area)    [string length $area    ] }
                if { [string length $xy] > $max_length(xy)}             { set max_length(xy)      [string length $xy      ] }
                if { [string length $clk] > $max_length(clk)}           { set max_length(clk)     [string length $clk     ] }
                if { [string length $Dinputs]  > $max_length(inputs)}   { set max_length(inputs)  [string length $Dinputs ] }
                if { [string length $Doutputs] > $max_length(outputs)}  { set max_length(outputs) [string length $Doutputs] }
	        lappend data_x "$area $xy $ref $clk $Dinputs $Doutputs $name"
            }

        }   
        set dash_line "+[string repeat - $max_length(area)]+[string repeat - $max_length(xy)]+[string repeat - $max_length(ref)]+[string repeat - $max_length(clk)]+[string repeat - $max_length(inputs)]+[string repeat - $max_length(outputs)]+[string repeat - $max_length(name)]+"
        set  i -1
        foreach data [lsort $data_x] {
            incr i
            if { $i == 0 } { 
                puts_tee $out_p $dash_line                
                set xdata [list Area Loc Ref Clock Inputs Outputs Cell]
                puts_tee $out_p [format "|%-$max_length(area)s|%-$max_length(xy)s|%-$max_length(ref)s|%-$max_length(clk)s|%-$max_length(inputs)s|%-$max_length(outputs)s|%-$max_length(name)s|" [lindex $xdata 0] [lindex $xdata 1] [lindex $xdata 2] [lindex $xdata 3] [lindex $xdata 4]  [lindex $xdata 5]  [lindex $xdata 6]]
                puts_tee $out_p $dash_line
            }
            set xdata [split $data " "]            
            puts_tee $out_p [format "|%-$max_length(area)s|%-$max_length(xy)s|%-$max_length(ref)s|%-$max_length(clk)s|%-$max_length(inputs)s|%-$max_length(outputs)s|%-$max_length(name)s|" [lindex $xdata 0] [lindex $xdata 1] [lindex $xdata 2] [lindex $xdata 3] [lindex $xdata 4]  [lindex $xdata 5]  [lindex $xdata 6]]
        }
        puts_tee $out_p $dash_line        
    }
    incr i    
    close $out_p
    puts "**Open File : $i cells $xfile"
    #cellstat $cells
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qc_get_sram_stats
