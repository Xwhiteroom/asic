##------------------------------------------------------------------
## ProcNameStart  : get_feeback_data
## ProcArguments  : get_feeback_data xfile
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc get_feeback_data xfile {
    set place_hold 1; proc x_get_xy {obj} {
	    if { [sizeof_collection [get_nets  -quiet $obj ] ] > 0 } { 
	        set obj_col [get_nets  $obj] ;
	        set attr_name1 "coordinate_max"
	        set attr_name2 "coordinate_min"
	        set class      "net"
	        #puts "nets [sizeof_collection [get_nets  -quiet $obj ] ]"
	    } elseif { [sizeof_collection [get_cells -quiet $obj ] ] > 0 } { 
	        set obj_col [get_cells $obj] ;
	        set attr_name1 "coordinate_max"
	        set attr_name2 "coordinate_min"
	        set class      "cell"
	
	        #puts "cell [sizeof_collection [get_cells  -quiet $obj ] ]"
	    } elseif { [sizeof_collection [get_pins  -quiet $obj ] ] > 0 } { 
	        set obj_col [get_pins  $obj] ;
	        set attr_name1 "coordinate"
	        set attr_name2 "coordinate"
	        set class      "pin"
	
	        #puts "pins [sizeof_collection [get_pins  -quiet $obj ] ]"
	    } else {
	        set obj_col [get_ports $obj] ;
	        set attr_name1 "coordinate"
	        set attr_name2 "coordinate"   
	        set class      "port"
	
	        #puts "port [sizeof_collection [get_ports  -quiet $obj ] ]"        
	    }
	    foreach_in_collection ret $obj_col {
	             set x1       "0"
	             set y1       "0"
	             set x2       "0"
	             set y2       "0"
	             set diff_x       "0"
	             set diff_y       "0"
	             set diff       "0"
	
	             catch {set x1 [format "%0.0f" [expr [get_attr -quiet $ret "x_$attr_name1"] / 1000]]}
	             catch {set y1 [format "%0.0f" [expr [get_attr -quiet $ret "y_$attr_name1"] / 1000]]}
	             catch {set x2 [format "%0.0f" [expr [get_attr -quiet $ret "x_$attr_name2"] / 1000]]}
	             catch {set y2 [format "%0.0f" [expr [get_attr -quiet $ret "y_$attr_name2"] / 1000]]}
	             catch {set diff_x [ expr abs($x2 - $x1)]}
	             catch {set diff_y [ expr abs($y2 - $y1)]}
	             catch {set diff [expr $diff_x + $diff_y]}
	
	             set el [get_object_name $ret]
	    }
             return "$x1:$y1,$x2:$y2,$diff,$diff_x,$diff_y"

    }

   
    set in [open $xfile ]
    while {[gets $in line] >= 0} {
        if { [regexp "^#" $line] } {
            puts "Skip:: $line"
        } else {
            #puts "\n**Pipe:: $line\n"
            #puts "\n**Pipe:: \n"

            set data [split $line " "]
            set buck_pat [lindex $data 0]
            regsub -all {\-\>} $buck_pat {,} buck_pat

            set place                   [lindex $data 1]
            set skew                    [lindex $data 2]
            set budget                  [lindex $data 3]
            set direction               [lindex $data 4]

            set travel                  [split $buck_pat ","]
            set start_port              [lindex $travel 0]
            set end_port                [lindex $travel end]
            set place_start             [get_cells -filter "is_integrated_clock_gating_cell==false" -quiet [all_fanin  -to  $start_port -startpoints_only -flat -only_cells]]
            set place_end               [get_cells -filter "is_integrated_clock_gating_cell==false" -quiet [all_fanout -from $end_port  -endpoints_only -flat -only_cells]]
            
            set direction_blk           [split $direction "."]
            set budget_blk              [split $budget    "."]
            set connected [list ]
            foreach x $travel {
                set x     [lindex [get_object_name [get_pins $x]] 0]
                set y     [get_pins -quiet -filter "full_name!~$x" [all_fanin -to $x -pin_level 1]]
                if { [sizeof_collection $y] == 0 } { set y [get_nets -quiet -filter "full_name!~$x" [all_fanin -to $x -pin_level 1]]}
                regsub -all {[0-9]+} [get_object_name $y] {*} y 
                lappend connected $y
            }
           

            #puts "\t\t-- Travel:[llength $travel] $direction_blk $budget ::  $start_port  -->  $end_port\n\t\t\t$travel\n\t\t\t$connected"

            # Budget Feed back
            #set skew tool
            #set place ""
            # Skew Feed back
            if { $skew != "tool" } {
                puts "\t\t\t -- Skew Feedback Given"
                foreach skew_tar [split $skew ","] {
                    if { $skew_tar > 0 } {
                        foreach_in_collection x $place_end   {     puts "\t\t\t     pnr_skew $skew_tar  [get_object_name [get_pins -of_object $x -filter "is_clock_pin==true"]]" } 
                    } else {
                        foreach_in_collection x $place_start {     puts "\t\t\t     pnr_skew $skew_tar  [get_object_name [get_pins -of_object $x -filter "is_clock_pin==true"]]" }
                    }
                }
            }



            # Place Feed back
            if { [regexp "SP" $place] || [regexp "SP" $place] } {
                puts "\t\t\t -- Place Feedback Given"
                foreach place_tar [split $place ","] {
                    if {$place_tar == "EP"} {
                        foreach_in_collection x [add_to_collection [get_ports -quiet $end_port] [get_pins -quiet $end_port]] {  
                            set new_loc          [lindex [split [x_get_xy $x] ","] 0]
                            set place_cells      [get_cells  -filter "is_integrated_clock_gating_cell==false and (is_sequential==true or (is_sequential==false and full_name=~*SYN*))" -quiet [all_fanout -from $x  -flat -only_cells]]
                            foreach_in_collection y $place_cells {
                                set orig_loc     [lindex [split [x_get_xy $y] ","] 0]
                                puts "\t\t\t    pnr_place $place_tar New:$new_loc  Orig:$orig_loc Cell:[get_object_name $y]  Port:[get_object_name $x]" 
                            }
                        } 

                    } else {
                        foreach_in_collection x [add_to_collection [get_ports -quiet $start_port] [get_pins -quiet $start_port]] {  
                            set new_loc          [lindex [split [x_get_xy $x] ","] 1]
                            set place_cells      [get_cells  -filter "is_integrated_clock_gating_cell==false and (is_sequential==true or (is_sequential==false and full_name=~*SYN*))" -quiet [all_fanin -to $x  -flat -only_cells]]
                            foreach_in_collection y $place_cells {
                                set orig_loc     [lindex [split [x_get_xy $y] ","] 0]
                                puts "\t\t\t    pnr_place $place_tar New:$new_loc  Orig:$orig_loc Cell:[get_object_name $y]  Port:[get_object_name $x]" 
                            }
                        } 

                    }
                }

            }

            
        }
    }
    
    close $in

}
##------------------------------------------------------------------
## ProcNameEnd    : get_feeback_data
