##------------------------------------------------------------------
## ProcNameStart  : sta_qual_group_module_paths
## ProcArguments  : sta_qual_group_module_paths target_blocks
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_group_module_paths target_blocks {
    global synopsys_program_name pt_shell_mode
    catch { suppress_message UITE-216 }
    set fp_blocks $target_blocks
    array unset block_map

    foreach modulex $fp_blocks {
        set module [lindex [split $modulex "."] 0]
        set ID     [lindex [split $modulex "."] 1]
        set inst [get_cells -quiet -hier * -filter "ref_name==$module"]
        set i 0
        if { [sizeof_collection $inst] > 0 } {
             foreach_in_collection  x $inst {
                set block [get_object_name $x]
                set block_map($module.$ID.$i) $block
                incr i
             }
        } else {
             puts "**STA_SDC_WARN:  SFP: No Valid Inst for @ $module"
        }
    }

    foreach categ1 [array names block_map] {
        foreach categ2 [array names block_map] {
             set module1 [lindex [split $categ1 "."] 0]
             set ID1     [lindex [split $categ1 "."] 1]
             set i1      [lindex [split $categ1 "."] 2]
             set inst1   $block_map($categ1)
             set blk_sp  [filter_collection [all_registers -clock_pins ] "full_name =~$inst1*"]
             set module2 [lindex [split $categ2 "."] 0]
             set ID2     [lindex [split $categ2 "."] 1]
             set i2      [lindex [split $categ2 "."] 2]
             set inst2   $block_map($categ2)
             set blk_ep  [filter_collection [all_registers -data_pins -async_pins ] "full_name =~$inst2*"]
             puts "**STA_SDC_INFO:  GRP: Making Group Valid Inst for @ $ID1.$ID2.$i1$i2 |   $inst1 ([sizeof_collection $blk_sp]) -> $inst2 ([sizeof_collection $blk_ep])  [date]"
             group_path -name $ID1.$ID2.$i1$i2 -from $blk_sp -to $blk_ep
             puts "**STA_SDC_INFO:  GRP: Making Group Valid Inst for @ $ID1.$i1.TOP |   $inst1 ([sizeof_collection $blk_sp])   [date]"
             group_path -name $ID1.$i1.TOP         -from $blk_sp
             puts "**STA_SDC_INFO:  GRP: Making Group Valid Inst for @ TOP.$ID2.$i2|   $inst1 ([sizeof_collection $blk_ep])   [date]"
             group_path -name TOP.$ID2.$i2         -to   $blk_ep
        }
    }
    puts "**STA_SDC_INFO:  GRP: Making Group Gross Cells  [date]"
    set MEM [get_cells -hierarchical -filter "is_memory_cell==true"]
    set ICG [filter_collection [all_registers ] "is_integrated_clock_gating_cell == true"]
    set RST [all_registers -async_pins ]
    set REG [remove_from_collection [all_registers] [add_to_collection [add_to_collection $MEM $ICG] $RST] ]
    group_path -name FROM.MEM   -from   $MEM
    group_path -name TO.MEM     -to     $MEM
    group_path -name TO.ICG     -to     $ICG
    group_path -name TO.ASYNC   -to     $RST
    group_path -name TO.REG     -to     $REG
    puts "**STA_SDC_INFO:  GRP: Making Group Sub Groups  [date]"

    foreach categ1 [array names block_map] {
        set module1 [lindex [split $categ1 "."] 0]
        set ID1     [lindex [split $categ1 "."] 1]
        set i1      [lindex [split $categ1 "."] 2]
        set inst1   $block_map($categ1)
        set blk_mem  [filter_collection $MEM "full_name =~$inst1*"]
        set blk_icg  [filter_collection $ICG "full_name =~$inst1*"]
        set blk_rst  [filter_collection $RST "full_name =~$inst1*"]
        set blk_reg  [filter_collection $REG "full_name =~$inst1*"]

        puts "**STA_SDC_INFO:  GRP: Making Group Valid Inst for @ $ID1.MEMIN  |   $inst1 to   ([sizeof_collection $blk_mem])  [date]"
        group_path -name $ID1.MEMIN  -to   $blk_mem
        puts "**STA_SDC_INFO:  GRP: Making Group Valid Inst for @ $ID1.MEMOUT |   $inst1 from ([sizeof_collection $blk_mem])  [date]"
        group_path -name $ID1.MEMOUT -from $blk_mem
        puts "**STA_SDC_INFO:  GRP: Making Group Valid Inst for @ $ID1.ICG    |   $inst1 to   ([sizeof_collection $blk_icg])  [date]"
        group_path -name $ID1.ICG    -to   $blk_icg
        puts "**STA_SDC_INFO:  GRP: Making Group Valid Inst for @ $ID1.ASYNC  |   $inst1 to   ([sizeof_collection $blk_rst])  [date]"
        group_path -name $ID1.ASYNC  -to   $blk_rst
        puts "**STA_SDC_INFO:  GRP: Making Group Valid Inst for @ $ID1.REG    |   $inst1 to   ([sizeof_collection $blk_reg])  [date]"
        group_path -name $ID1.REG    -to   $blk_reg

    }
    catch { unsuppress_message UITE-216 }
}
