##------------------------------------------------------------------
## ProcNameStart  : sta_qual_create_clock_spec
## ProcArguments  : sta_qual_create_clock_spec clock_spec_ref MODE CORNER
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_create_clock_spec {clock_spec_ref MODE CORNER} {
    global synopsys_program_name pt_shell_mode synopsys_program_name
    global sta_qual_default_data_transition sta_qual_default_clk_transition sta_qual_driver_transition
    global sta_qual_clock_src_db sta_qual_clock_period_db sta_qual_clock_unc_db
    upvar $clock_spec_ref clock_spec
    foreach mode_clk [lsort -dictionary [array names  clock_spec]] {
        puts "\t\t\t-- Processing clock = $mode_clk"
        #sta_qual_clock_def($MODE.$CLK) = [list ADDVIRTUAL MASTER:WAVEFORM EXTRA_ARG $sta_qual_clock_spec(PLL_SPEC)    CLK_PORT]
        #sta_qual_clock_def($MODE.$CLK) = [list 1 none:0,0.5 nan $sta_qual_clock_spec(PLL_CPU_L3C) SCLK[0],sclk]

        set xid   [lindex [split $mode_clk "."] 0]
        set xmode [lindex [split $mode_clk "."] 1]
        set xclks [lindex [split $mode_clk "."] 2]
        if { $xmode == $MODE } {

            # Publish Clock
            puts "\n\n\t\t\t-- Added Clock Definiton : $xclks"

            # Check basic spec for clock definition
            # [list ADDVIRTUAL MASTER:WAVEFORM EXTRA_ARG $sta_qual_clock_spec(PLL_SPEC)    CLK_PORT]
            set define_virtual   [lindex $clock_spec($mode_clk) 0]
            set mas_clk          [lindex [split [lindex $clock_spec($mode_clk) 1] ":"] 0]
            # Support for Forced Root Source Pin
            set mas_clk_src_str  [lindex [split $mas_clk "@"] 1]
            set mas_clk          [lindex [split $mas_clk "@"] 0]

            set mas_div          [lindex [split [lindex $clock_spec($mode_clk) 1] ":"] 1]
            set clkshape         [split $mas_div ","]
            set extraopt         [lindex $clock_spec($mode_clk) 2]
            if { [string match -nocase $extraopt "nan"] } {
                set extraopt ""
            }
            set src_name         [lindex $clock_spec($mode_clk) 4]
            if { [info exists ::TV_SHELL_VERSION] } {
                set src_name         [get_object_name $src_name]
            }

            # Split and create multiple sources
            regsub -all {\{|\}} $src_name {} src_name
            if { $src_name == "virtual_source" || $src_name == "" } {
                set src_points_all   ""
                set src_name     "virtual_source"
            } else {
                set src_name [split $src_name ","]
                set src_points_all [get_ports -quiet $src_name]
                if { [sizeof_collection $src_points_all] == 0 } {
                    set src_points_all  [get_pins  -quiet $src_name]
                }
                set src_name     [get_object_name $src_points_all]

                if { $mas_clk_src_str != "" } {
                    set mas_clk_hard_src [get_ports -quiet $mas_clk_src_str]
                    if { [sizeof_collection $mas_clk_hard_src] == 0 } {
                        set mas_clk_hard_src [get_pins -quiet $mas_clk_src_str]
                    }
                } else {
                    set mas_clk_hard_src [remove_from_collection $src_points_all $src_points_all]
                }

            }
            #puts [format "Name=%s  Virtual=%s  Master=%s  Waveform=%s  Extra=%s  Sources=%s" $xclks $define_virtual $mas_clk $mas_div $extraopt $src_name]

            # Parse the Spec
            # PVT:FREQ(GHz):JITTER(ns):JITTER_DCD(ns):SETUP(ns):HOLD(ns):NTWLAT(Max ns):NTWLAT(Min ns):SRCLAT(Max ns):SRCLAT(Min ns):INPUT_DRIVER:INPUT_TRAN(%):CLK_TRAN(%):DATA_TRAN(%)
            foreach freq_spec [lindex $clock_spec($mode_clk) 3] {
                # Specified settings
                set i_cnt 0
                set xpvt      [lindex [split $freq_spec ":"] $i_cnt] ; incr i_cnt
                set freq      [lindex [split $freq_spec ":"] $i_cnt] ; incr i_cnt
                set jitter    [lindex [split $freq_spec ":"] $i_cnt] ; incr i_cnt
                set jitter_dc [lindex [split $freq_spec ":"] $i_cnt] ; incr i_cnt

                set setupU    [lindex [split $freq_spec ":"] $i_cnt] ; incr i_cnt
                set holdU     [lindex [split $freq_spec ":"] $i_cnt] ; incr i_cnt

                set ntwlatMax [lindex [split $freq_spec ":"] $i_cnt] ; incr i_cnt
                set ntwlatMin [lindex [split $freq_spec ":"] $i_cnt] ; incr i_cnt
                set srclatMax [lindex [split $freq_spec ":"] $i_cnt] ; incr i_cnt
                set srclatMin [lindex [split $freq_spec ":"] $i_cnt] ; incr i_cnt

                set drv_ref   [lindex [split $freq_spec ":"] $i_cnt] ; incr i_cnt
                set inptran   [lindex [split $freq_spec ":"] $i_cnt] ; incr i_cnt
                set clktran   [lindex [split $freq_spec ":"] $i_cnt] ; incr i_cnt
                set dattran   [lindex [split $freq_spec ":"] $i_cnt] ; incr i_cnt

                #puts [format "Name=%s PVT=%s Freq=%s Jitter=%s Jitter_DCD=%s Setup=%s  Hold=%s  Network_Lat={%s,%s}  Source_Lat={%s,%s}"  $xclks $xpvt $freq $jitter $jitter_dc $setupU $holdU $ntwlatMax $ntwlatMin $srclatMax $srclatMin ]
                #puts [format "Name=%s Driver=%s Input_Tran=%s Clock_Tran=%s Data_Tran=%s"  $xclks $drv_ref $inptran $clktran $dattran]


                #Inferred Settings
                set period    [format "%.4f" [expr 1 / $freq]]
                set clktran   [format "%.3f" [expr ($clktran  *      $period)]]
                set dattran   [format "%.3f" [expr ($dattran  *      $period)]]
                set inptran   [format "%.3f" [expr ($inptran  *      $period)]]

                regsub -all {[0-9]|\.} $holdU  {} addhold
                regsub -all {[0-9]|\.} $setupU {} addsetup
                set setupU_dc $setupU

                #Driver Modelling
                set drv_exist [sizeof_collection  [get_lib_cell -quiet */$drv_ref]]
                set drv_lib   [lindex [split [get_object_name [get_lib_cell -quiet */$drv_ref]] "/"] 0]
                set drv_pin   [lindex [split [get_object_name [get_lib_pins  -quiet  */$drv_ref/* -filter "direction == out"]] "/"] end]
                set drv_ipin  [lindex [split [get_object_name [get_lib_pins   -quiet */$drv_ref/* -filter "direction == in" ]] "/"] end]
                #puts "**STA_SDC_DEBUG: DRIVER=$drv_lib/$drv_ref  IN=$drv_ipin OUT=$drv_pin"
                #puts "**STA_SDC_DEBUG: mas_clk=$mas_clk mas_div=$mas_div src_name=$src_name ntwlat=$ntwlat srclat=$srclat addunc={$addsetup|$addhold}"
                #puts "**STA_SDC_DEBUG: xpvt={$xpvt} freq={$freq|$period} jitter={$jitter|$jitter_dc} uncert={$setupU|$holdU} tran={$inptran|$clktran|$dattran} drv_ref={$drv_ref}"
                if { $CORNER == $xpvt } {
                    #puts "**STA_SDC_DEBUG: mas_clk=$mas_clk mas_div=$mas_div clkshape=$clkshape ntwlat=$ntwlat srclat=$srclat addunc={$addsetup|$addhold}"
                    if { [sizeof_collection $src_points_all] || $src_name == "virtual_source"} {
                        #puts -nonewline "\[1;34m"; #RED
                        #puts "\[1;34m$clkshape , [llength $clkshape]\[0m"
                        set src_points $src_points_all
                        puts [format "**STA_SDC_INFO: Defining   clock %-15s for %-15s @ %-10s  Attr: Master=%-15s Div=%-5s/$clkshape Loc:%-10s " $xclks $xmode $xpvt $mas_clk $mas_div $src_name]
                        # Define Master Create Clk attributes
                        if { $mas_clk == "none"} {
                            set waveform [list]
                            foreach el $clkshape {
                                lappend waveform [expr $el * $period]
                            }
                            if { $src_name != "virtual_source" } {
                                if { $extraopt != "" } {
                                    puts "<CMD> create_clock -name ${xclks} -period ${period} -waveform [split ${waveform} " "]  -add [get_object_name $src_points] $extraopt"
                                    create_clock -name ${xclks} -period ${period} $src_points -waveform [split ${waveform} " "]  -add $extraopt
                                } else {
                                    puts "<CMD> create_clock -name ${xclks} -period ${period} -waveform [split ${waveform} " "]  -add [get_object_name $src_points]"
                                    create_clock -name ${xclks} -period ${period} $src_points -waveform [split ${waveform} " "]  -add
                                }
                                set sta_qual_clock_src_db(${xclks}) [get_object_name ${src_points}]
                                set sta_qual_clock_period_db(${xclks}) ${period}
                            } else {
                                puts "\t\t\t-- Added virtual $xclks"
                                puts "<CMD> create_clock -name ${xclks} -period ${period} -waveform  [split ${waveform} " "] -add "
                                create_clock -name ${xclks} -period ${period} -waveform  [split ${waveform} " "] -add
                                set sta_qual_clock_period_db(${xclks}) ${period}
                            }

                            # Add driver model if it exists
                            if { $drv_exist } {
                                if { [sizeof_collection [get_ports -quiet $src_points]] > 0 } {
                                    if { $sta_qual_driver_transition > $inptran } {
                                        puts "<CMD> set_driving_cell -lib_cell $drv_ref -from_pin $drv_ipin -pin $drv_pin -input_transition_rise $inptran -input_transition_fall $inptran [get_object_name $src_points]"
                                        set_driving_cell -lib_cell $drv_ref -from_pin $drv_ipin -pin $drv_pin -input_transition_rise $inptran -input_transition_fall $inptran $src_points
                                        #puts "**STA_SDC_INFO: $drv_lib driver model set for clock $xclks !"
                                    } else {
                                        puts "<CMD> set_driving_cell -lib_cell $drv_ref -from_pin $drv_ipin -pin $drv_pin -input_transition_rise $sta_qual_driver_transition -input_transition_fall $sta_qual_driver_transition [get_object_name $src_points]"
                                        set_driving_cell -lib_cell $drv_ref -from_pin $drv_ipin -pin $drv_pin -input_transition_rise $sta_qual_driver_transition -input_transition_fall $sta_qual_driver_transition $src_points
                                    }
                                }
                            } else {
                                puts "**STA_SDC_WARN: No driver model set for clock $xclks !"
                            }

                            # Define Virtual  Clk attributes
                            if { $define_virtual == "1"} {
                                puts "\t\t\t-- Added virtual v_$xclks"
                                puts "<CMD> create_clock -name v_${xclks} -period ${period} -waveform  [split ${waveform} " "] -add "
                                create_clock -name v_${xclks} -period ${period} -waveform  [split ${waveform} " "] -add
                                set xclks [list $xclks v_$xclks]
                            }
                        } else {
                            # Define Generated Clk attributes
                            if { [sizeof_collection [get_clocks -quiet $mas_clk ]] > 0 } {
                                set  master         [lindex [array get clock_spec *.$MODE.$mas_clk] 0]
                                set  edges          $clkshape
                                set  first_edge     [lindex [split ${edges}] 0]
                                set  third_edge     [lindex [split ${edges}] 2]
                                set  div_ratio      [expr [expr ${third_edge} - ${first_edge}] / 2]
                                puts "**STA_SDC_INFO: Div ratio -> $div_ratio"
                                #set  src_gen_pin    [get_pins -of_object [get_cells -of_object [get_pins -quiet $gsrc_points ] ] -filter "is_clock_pin==true && direction==in" ]
                                if { [sizeof_collection [get_clocks -quiet $mas_clk ]] > 1 && [string match "tessent_*" $mas_clk] } {
                                    set reaching_clock [get_attribute $src_points clocks]
                                    if { [sizeof_collection  $reaching_clock] == 0 } {
                                        set reaching_clock [get_property $src_points clocks]
                                    }
                                    set reaching_clock [get_object_name $reaching_clock]
                                    foreach clock_name $reaching_clock {
                                        if { [string match $mas_clk $clock_name] } {
                                            set mas_clk $clock_name
                                        }
                                    }
                                }

                                if { [info exists sta_qual_clock_src_db($mas_clk)] && [sizeof_collection $mas_clk_hard_src] == 0 } {
                                    set src_mas_pin [lsort -unique $sta_qual_clock_src_db($mas_clk)]
                                    puts "**STA_SDC_INFO: Taking src point from internal database"
                                    set master_period $sta_qual_clock_period_db($mas_clk)
                                    set generated_period [expr ${master_period} * ${div_ratio}]
                                    set sta_qual_clock_period_db($xclks) $generated_period
                                    set sta_qual_clock_src_db($xclks)    [get_object_name $src_points]
                                    puts "\t\t\t-- src_mas_pin(Inferred)=$src_mas_pin"
                                    puts "\t\t\t-- master_period=$master_period"
                                    puts "\t\t\t-- generated_period=$generated_period"
                                } elseif { [info exists sta_qual_clock_src_db($mas_clk)] && [sizeof_collection $mas_clk_hard_src] > 0 } {
                                    set src_mas_pin $mas_clk_hard_src
                                    puts "**STA_SDC_INFO: Taking src point from unser entry"
                                    set master_period $sta_qual_clock_period_db($mas_clk)
                                    set generated_period [expr ${master_period} * ${div_ratio}]
                                    set sta_qual_clock_period_db($xclks) $generated_period
                                    set sta_qual_clock_src_db($xclks)    [get_object_name $src_points]
                                    puts "\t\t\t-- src_mas_pin(Forced)=$src_mas_pin"
                                    puts "\t\t\t-- master_period=$master_period"
                                    puts "\t\t\t-- generated_period=$generated_period"
                                } else {
                                    set  src_mas_pin  [get_attribute [get_clocks  -quiet $mas_clk ] sources]
                                    #puts "get_attribute worked : [sizeof_collection $src_mas_pin]"
                                    if { [sizeof_collection  $src_mas_pin] == 0 } {
                                       set  src_mas_pin  [get_property [get_clocks  -quiet $mas_clk ] sources]
                                    }
                                }

                                if { [sizeof_collection [get_pins -quiet $src_points]] > 0 } {
                                    set div_src_points [get_object_name [get_pins -quiet $src_points]]
                                    set div_cell       [file dirname $div_src_points]
                                    set div_or_cell    ${div_cell}/*_clk_div50/u_clk_div_dp/u_ck_or1/gpl_clk_or[0]/SIZEONLY_or
                                    if { [regexp {clk_out\[(.*)\]} $div_src_points match pin_count] } {
                                        set sync_div_or_cell    ${div_cell}/*$pin_count/*_clk_div50/u_clk_div_dp/u_ck_or1/gpl_clk_or[0]/SIZEONLY_or
                                    } else {
                                        set sync_div_or_cell "scf_arc_disable_not_applicable"
                                    }
                                    puts "Div or cell $div_or_cell"
                                    set div_cell_count [sizeof_collection [get_cells -quiet $div_or_cell]]
                                    puts "Div cell count $div_cell_count"
                                    puts "Sync Div or cell $div_or_cell"
                                    set sync_div_cell_count [sizeof_collection [get_cells -quiet $sync_div_or_cell]]
                                    puts "Sync Div cell count $sync_div_cell_count"
                                    if { ! [info exists ::SPYGLASS_HOME] } {
                                        if { $div_cell_count > 0 } {
                                            if { $div_ratio == 1 } {
                                                puts "Div ration 1 on divider, disable timing arc from A1 to X on $div_or_cell"
                                                set_disable_timing -from A1 -to X [get_cells $div_or_cell]
                                            } else {
                                                puts "Div ration $div_ratio on divider, disable timing arc from A2 to X on $div_or_cell"
                                                set_disable_timing -from A2 -to X [get_cells $div_or_cell]
                                            }
                                        } elseif { $sync_div_cell_count > 0 } {
                                            if { $div_ratio == 1 } {
                                                puts "Div ration 1 on divider, disable timing arc from A1 to X on $sync_div_or_cell"
                                                set_disable_timing -from A1 -to X [get_cells $sync_div_or_cell]
                                            } else {
                                                puts "Div ration $div_ratio on divider, disable timing arc from A2 to X on $sync_div_or_cell"
                                                set_disable_timing -from A2 -to X [get_cells $sync_div_or_cell]
                                            }
                                        }
                                    }
                                }
                                puts "<CMD> create_generated_clock -name ${xclks} -add  -master_clock $mas_clk -edges \"[split ${edges}]\" -source $src_mas_pin $src_points $extraopt"
                                if { $extraopt != "" } {
                                    create_generated_clock -name ${xclks} -add  -master_clock $mas_clk -edges "[split ${edges}]" -source $src_mas_pin $src_points $extraopt
                                } else {
                                    create_generated_clock -name ${xclks} -add  -master_clock $mas_clk -edges "[split ${edges}]" -source $src_mas_pin $src_points
                                }

                                #set mas_clock_possible [remove_from_collection -intersect [get_attribute -quiet $src_points clocks] [get_clocks  -quiet $mas_clk]]
                                #if { [sizeof_collection $mas_clock_possible] } {
                                #   puts "<CMD> create_generated_clock -name ${xclks} -add  -master_clock $mas_clk -edges [split ${edges}] -source [get_object_name $src_mas_pin] [get_object_name $src_points]"
                                #   create_generated_clock -name ${xclks} -add  -master_clock $mas_clk -edges [split ${edges}] -source $src_mas_pin $src_points
                                #} else {
                                #    puts "<FAIL> create_generated_clock -name ${xclks} -add  -master_clock $mas_clk -edges [split ${edges}] -source [get_object_name $src_mas_pin] [get_object_name $src_points]"
                                #    puts "      - Master Clock $mas_clk not reaching [get_object_name $src_points]"
                                #}
                            } else {
                                set edges $clkshape
                                if { [info exists sta_qual_clock_src_db($mas_clk)] && [sizeof_collection $mas_clk_hard_src] == 0 } {
                                    set src_mas_pin [lsort -unique $sta_qual_clock_src_db($mas_clk)]
                                } elseif { [info exists sta_qual_clock_src_db($mas_clk)] && [sizeof_collection $mas_clk_hard_src] > 0 } {
                                    set src_mas_pin $mas_clk_hard_src
                                } else {
                                    set src_mas_pin [get_attribute [get_clocks  -quiet $mas_clk ] sources]
                                    if { [sizeof_collection  $src_mas_pin] == 0 } {
                                        set src_mas_pin [get_property [get_clocks -quiet $mas_clk] sources]
                                    }
                                }
                                puts "<FAIL> create_generated_clock -name ${xclks} -add  -master_clock $mas_clk -edges [split ${edges}] -source $src_mas_pin  $src_points"
                                puts "      - Missing Master Clock $mas_clk"
                            }
                        }
                        # Define Common Clk attributes :  Jitter/MAx Tran / Latency
                        if { [sizeof_collection [get_clocks -quiet ${xclks}]] > 0 } {
                            # Adjust for  Additional Setup Full-1/2 Cycle Margin
                            if { $addsetup == "" } {
                              puts "<CMD> set setupU     [expr $jitter     + $setupU]"
                              puts "      - Uncert FullCycle  = $setupU"
                              puts "      - Jitter FullCycle  = $jitter"
                              puts "      - Final     Margin  = [expr $jitter     + $setupU]"
                              set setupU     [expr $jitter     + $setupU]

                              puts "<CMD> set setupU_dc  [expr $jitter_dc + $setupU_dc]"
                              puts "      - Uncert 1/2 Cycle  = $setupU_dc"
                              puts "      - Jitter 1/2 Cycle  = $jitter_dc"
                              puts "      - Final     Margin  = [expr $jitter_dc + $setupU]"
                              set setupU_dc  [expr $jitter_dc  + $setupU_dc]

                            } else {
                              puts "<CMD> set setupU     $jitter"
                              puts "      - Uncert FullCycle  = $setupU"
                              puts "      - Jitter FullCycle  = $jitter"
                              puts "      - Final     Margin  = $jitter"
                              set setupU     $jitter

                              puts "<CMD> set setupU_dc  $jitter_dc"
                              puts "      - Uncert 1/2 Cycle  = $setupU_dc"
                              puts "      - Jitter 1/2 Cycle  = $jitter_dc"
                              puts "      - Final     Margin  = $jitter_dc"
                              set setupU_dc  $jitter_dc
                              set addsetup ""
                            }
                            # Removing clock latency for now
                            # # Add Latencies : supported for master only
                            # puts "<CMD> set_clock_latency     $srclatMax  -source    -max        \[get_clocks -quiet ${xclks}\]"
                            # set_clock_latency     $srclatMax  -source    -max        [get_clocks -quiet ${xclks}]
                            # puts "<CMD> set_clock_latency     $srclatMin  -source    -min        \[get_clocks -quiet ${xclks}\]"
                            # set_clock_latency     $srclatMin  -source    -min        [get_clocks -quiet ${xclks}]
                            # puts "<CMD> set_clock_latency     $ntwlatMax             -max        \[get_clocks -quiet ${xclks}\]"
                            # set_clock_latency     $ntwlatMax             -max        [get_clocks -quiet ${xclks}]
                            # puts "<CMD> set_clock_latency     $ntwlatMin             -min        \[get_clocks -quiet ${xclks}\]"
                            # set_clock_latency     $ntwlatMin             -min        [get_clocks -quiet ${xclks}]

                            # For Ideal Clock
                            if { $sta_qual_default_clk_transition > $inptran } {
                                puts "<CMD> set_clock_transition  $inptran                         \[get_clocks -quiet ${xclks}\]"
                                set_clock_transition  $inptran                           [get_clocks -quiet ${xclks}]
                            } else {
                                puts "<CMD> set_clock_transition  $sta_qual_default_clk_transition            \[get_clocks -quiet ${xclks}\]"
                                set_clock_transition  $sta_qual_default_clk_transition                       [get_clocks -quiet ${xclks}]
                            }

                            # For Propagated Clock
                            if { $sta_qual_default_data_transition > $dattran } {
                                puts "<CMD> set_max_transition    $dattran  -data_path             \[get_clocks -quiet ${xclks}\]"
                                set_max_transition    $dattran    -data_path             [get_clocks -quiet ${xclks}]
                            } else {
                                puts "<CMD> set_max_transition    $sta_qual_default_data_transition  -data_path             \[get_clocks -quiet ${xclks}\]"
                                set_max_transition    $sta_qual_default_data_transition    -data_path             [get_clocks -quiet ${xclks}]
                            }
                            if { $sta_qual_default_clk_transition > $clktran } {
                                puts "<CMD> set_max_transition    $clktran  -clock_path            \[get_clocks -quiet ${xclks}\]"
                                set_max_transition    $clktran               -clock_path [get_clocks -quiet ${xclks}]
                            } else {
                                puts "<CMD> set_max_transition    $sta_qual_default_clk_transition  -clock_path            \[get_clocks -quiet ${xclks}\]"
                                set_max_transition    $sta_qual_default_clk_transition               -clock_path [get_clocks -quiet ${xclks}]
                            }
                            # Add Uncertainty
                            if { $addsetup == "" } {

			        # Intra-clock
                                puts "<CMD> set_clock_uncertainty $setupU  -setup   -rise_from  \[get_clocks -quiet ${xclks}\]  -rise_to  \[get_clocks -quiet ${xclks}\]"
                                set_clock_uncertainty $setupU  -setup   -rise_from  [get_clocks -quiet ${xclks}]  -rise_to  [get_clocks -quiet ${xclks}]
                                puts "<CMD> set_clock_uncertainty $setupU  -setup   -fall_from  \[get_clocks -quiet ${xclks}\]  -fall_to  \[get_clocks -quiet ${xclks}\]"
                                set_clock_uncertainty $setupU  -setup   -fall_from  [get_clocks -quiet ${xclks}]  -fall_to  [get_clocks -quiet ${xclks}]
				
                                puts "<CMD> set_clock_uncertainty $setupU_dc  -setup   -rise_from  \[get_clocks -quiet ${xclks}\]  -fall_to  \[get_clocks -quiet ${xclks}\]"
                                set_clock_uncertainty $setupU_dc  -setup   -rise_from  [get_clocks -quiet ${xclks}]  -fall_to  [get_clocks -quiet ${xclks}]
                                puts "<CMD> set_clock_uncertainty $setupU_dc  -setup   -fall_from  \[get_clocks -quiet ${xclks}\]  -rise_to  \[get_clocks -quiet ${xclks}\]"
                                set_clock_uncertainty $setupU_dc  -setup   -fall_from  [get_clocks -quiet ${xclks}]  -rise_to  [get_clocks -quiet ${xclks}]
                            }
                            if { $addhold  == "" } {
                                puts "<CMD> set_clock_uncertainty $holdU  -hold                  \[get_clocks -quiet ${xclks}\]"
                                set_clock_uncertainty $holdU  -hold                [get_clocks -quiet ${xclks}]
                            }
			    # Get Uncertainty value in Global Variable
                            set sta_qual_clock_unc_db(${xclks}) [list $setupU $setupU_dc]
                        }

                    } else {
                        #puts -nonewline "\[1;43m"; #RED
                        puts [format "**STA_SDC_WARN: Skipping   clock %-15s for %-15s @ %-10s  Attr: Master=%-15s Div=%-5s Loc:%-10s (missing source)" $xclks $xmode $xpvt  $mas_clk $mas_div $src_name]
                    }
                    #puts -nonewline "\[0m";# Reset

                }
            }
        }
    }
}
