## ProcNameStart  : rdc
## ProcArguments  : rdc object args
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc rdc {object args} {
    # if Object is net or not
    set net   [get_nets   -quiet $object]
    set ipin  [get_pins   -quiet $object -filter "direction==in"]
    set oport [get_ports  -quiet $object -filter "direction==out"]

    set opin  [get_pins   -quiet $object -filter "direction==out"]
    set iport [get_ports  -quiet $object -filter "direction==in"]

    

    set drivers  [ filter_collection [all_fanin  -flat -to   $object -pin_levels 1 ] "direction==out && is_hierarchical==false"]
    set loads    [ filter_collection [all_fanout -flat -from $object -pin_levels 1 ] "direction==in  && is_hierarchical==false"]

    if { [sizeof_collection $net] > 0  } {
        puts "<INFO> :: Net    Side Info Provided "
    } elseif { [sizeof_collection $ipin] > 0 || [sizeof_collection $opin] } {
        puts "<INFO> :: Load   Side Info Provided "
    } elseif { [sizeof_collection $opin] > 0 || [sizeof_collection $ipin] } {
        puts "<INFO> :: Driver Side Info Provided "
    } else {
        puts "<WARN> :: Provided Object : is not net / pin /port "
    }

    foreach_in_collection driverx $drivers {
        foreach_in_collection loadx $loads {
            set cmd "report_delay_calculation  -from  [get_object_name $driverx] -to  [get_object_name $loadx]  $args "
            puts "\033\[1;31m <CMD> $cmd\033\[0m"
            eval $cmd
        }
    }
}
