##------------------------------------------------------------------
## ProcNameStart  : cellinfo
## ProcArguments  : cellinfo cell
## ProcDependency : puts_tee 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc cellinfo cell {
    	if { [sizeof_collection [get_pins -quiet $cell]]} { 
	    set cpins [get_pins -quiet $cell]	    
	    set cell [get_object_name [get_cells -of_objects [get_pins $cell]]]
	} else {
	    set cpins [get_pins -quiet $cell/*]
    	}
	set xfile "temp_cell.info.tcl"
	set out_p [open $xfile w+]
    	set is_p "pin"
	set is_x ""
	if { [sizeof_collection $cpins ] == "0"} {
		set cpins [get_ports $cell/*]
		set is_p "port"
		set is_x "IO"
	}
    set max_len 0
    foreach_in_collection p $cpins {
        set len [string length [get_object_name $p]]
        if {$len > $max_len} { set max_len $len }
    }


	set pin_len   [expr ([string length $cell] + 20)]
	set pin_len   [expr ($max_len + 2)]

	if {$pin_len > 150} {set pin_len 150};
	set ref_len   [string length [lindex [get_attribute -quiet  [get_cells $cell] ref_name] 0]]
	set space1    [expr ((${pin_len} - 10)/2)]
	set clock_size "15" 
	foreach clk [get_object_name [get_clocks *]] {
	  if {[string length $clk] >= $clock_size } {
	       set clock_size "[string length $clk]" 
	  }
	}
	set clock_size [expr 5 + $clock_size + 0]  
        
	set dash1     [expr ( 21 + $clock_size + ${pin_len})]
	set frmt "|%12s|%6s|%${clock_size}s|%-${pin_len}s|"
	puts_tee $out_p "\n\n"
	puts_tee $out_p "+[string repeat "-" ${dash1}]+"
	puts_tee $out_p  [format |%-${dash1}s| "    Ref Lib Cell Used :      [get_attribute -quiet  [get_cells $cell] ref_name]"]
	puts_tee $out_p "+[string repeat "-" 12]+[string repeat "-" 6]+[string repeat "-" ${clock_size} ]+[string repeat "-" ${pin_len}]+"
	puts_tee $out_p [format $frmt "Const"  "Dir"  "Clocks"  "[string repeat " " ${space1}]Cell Pin[string repeat " " ${space1}]"]
	puts_tee $out_p "+[string repeat "-" 12]+[string repeat "-" 6]+[string repeat "-" ${clock_size}]+[string repeat "-" ${pin_len}]+"
	foreach_in_collection pin $cpins {
	  if {[sizeof_collection [get_attribute -quiet  [get_${is_p} -quiet $pin] clocks]] != 0} {
	  set no_of_clk [sizeof_collection [get_attribute -quiet  [get_${is_p} -quiet $pin] clocks]]
	  set current_clk 0
	   while { $current_clk < $no_of_clk} {
	      set clocks [lindex [get_object_name [get_attribute -quiet  [get_${is_p} -quiet  $pin] clocks]] $current_clk]
	      incr current_clk
	      set  my_period [format "%.3f" [get_attribute -quiet [get_clocks $clocks] period]]
	      set  my_attrc  "M"
	      if { [get_attr [get_clocks $clocks]  is_generated]} {
	      	set  my_attrc  "G"
	      }	
	      set pin_curr [get_object_name [get_${is_p} $pin]]
	      foreach_in_collection src [get_attr [get_clocks $clocks] sources] {
	        if { [get_object_name $src] == $pin_curr} {
		   set  my_attrc  "*${my_attrc}"
	    	}
	      }
	
	      if { $current_clk == 1} {
	           puts_tee $out_p [format $frmt  "" "" "" "" " $clocks ($my_attrc )" ""]        
	           puts_tee $out_p [format $frmt  "$my_period" "$is_x [get_attribute -quiet  [get_${is_p} $pin] ${is_p}_direction]" " $clocks ($my_attrc)" " [get_object_name [get_${is_p} $pin]]" ]
	           #puts_tee $out_p [format $frmt  "[get_attribute -quiet  [get_${is_p} $pin] case_value]" "$is_x [get_attribute -quiet  [get_${is_p} $pin] ${is_p}_direction]" "$clocks" "[get_object_name [get_${is_p} $pin]]" ]
	      } else {
	           puts_tee $out_p [format $frmt  "$my_period" "" " $clocks ($my_attrc)" "" ]
	      }
	   }
	  } else {
	   puts_tee $out_p [format $frmt "[get_attribute -quiet  [get_${is_p} $pin] case_value]" "$is_x [get_attribute -quiet  [get_${is_p} $pin] ${is_p}_direction]" "" " [get_object_name [get_${is_p} $pin]]"]
	  }
	 }
	puts_tee $out_p "+[string repeat "-" 12]+[string repeat "-" 6]+[string repeat "-" ${clock_size}]+[string repeat "-" ${pin_len}]+"
	puts_tee $out_p "\n\n"
	close $out_p
	puts "\t**Open file $xfile"
}
