##------------------------------------------------------------------
## ProcNameStart  : sget_ct
## ProcArguments  : sget_ct args
## ProcDependency :  
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sget_ct args {
    set dir "[lindex $args 0]/check_timing"
    if { $dir == "/check_timing" } { set dir  check_sdc_sanity/default/check_timing}
    file mkdir $dir
    set checks_include1 [list ideal_clocks generated_clocks unexpandable_clocks no_clock multiple_clock clock_crossing data_check_no_clock data_check_multiple_clock latency_override]
    set checks_include2 [list loops generic no_driving_cell]
    set checks_include3 [list no_input_delay partial_input_delay unconnected_pg_pins unconstrained_endpoints ]
    set checks_include4 [list latch_fanout ms_separation retain]
    set checks_include5 [list supply_net_voltage operating_conditions signal_level]
    set checks_include6 [list pulse_clock_cell_type pulse_clock_non_pulse_clock_merge pulse_clock_no_pulse_generator pll_configuration]


    set exclude [concat $checks_include2 $checks_include3 $checks_include4 $checks_include5 $checks_include6]
    set filex $dir/clock_source_timing.rpt;
    check_timing -include $checks_include1 -verbose -exclude $exclude > $filex;puts "\t\t**Info :CTR: Dumped Verbose $filex"
    
    set exclude [concat $checks_include1 $checks_include3 $checks_include4 $checks_include5 $checks_include6]    
    set filex $dir/connectivity_timing.rpt;
    check_timing -include $checks_include2 -verbose -exclude $exclude > $filex;puts "\t\t**Info :CTR: Dumped Verbose $filex"
    
    set exclude [concat $checks_include1 $checks_include2 $checks_include4 $checks_include5 $checks_include6]        
    set filex $dir/io_timing.rpt;
    check_timing -include $checks_include3 -verbose -exclude $exclude > $filex;puts "\t\t**Info :CTR: Dumped Verbose $filex"
    
    set exclude [concat $checks_include1 $checks_include2 $checks_include3 $checks_include5 $checks_include6]            
    set filex $dir/latch_timing.rpt;
    check_timing -include $checks_include4 -verbose -exclude $exclude > $filex;puts "\t\t**Info :CTR: Dumped Verbose $filex"

    set exclude [concat $checks_include1 $checks_include2 $checks_include3 $checks_include4 $checks_include6]                
    set filex $dir/pvt_timing.rpt;
    check_timing -include $checks_include5 -verbose -exclude $exclude > $filex;puts "\t\t**Info :CTR: Dumped Verbose $filex"

    set exclude [concat $checks_include1 $checks_include2 $checks_include3 $checks_include4 $checks_include5]                    
    set filex $dir/pulse_timing.rpt;
    check_timing -include $checks_include6 -verbose -exclude $exclude > $filex;puts "\t\t**Info :CTR: Dumped Verbose $filex"

}
##------------------------------------------------------------------
## ProcNameEnd    : sget_ct
