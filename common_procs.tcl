proc STA_quick {} {
	array unset data
	set data(registers)       [sizeof_collection [all_registers]]
	set data(all_instances)       [sizeof_collection [get_cells -hier -filter "is_hierarchical==false"]]

	set data(clocks)    	  [sizeof_collection [all_clocks]]
	set data(input_ports)     [sizeof_collection [all_inputs]]
	set data(output_ports)    [sizeof_collection [all_outputs]]
        puts ""

	puts [format "    %-50s   %-15s" "----------------------------------" "-------------------" ]
	puts [format "    %-50s   %-15s" "#Attribute"  "#Value"]
	puts [format "    %-50s   %-15s" "----------------------------------" "-------------------" ]
	foreach x [array names data] {
		puts [format "    %-50s   %-15s" $x $data($x)]
	}
	puts [format "    %-50s   %-15s" "----------------------------------" "-------------------" ]
        puts ""

}
