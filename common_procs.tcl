##------------------------------------------------------------------
## ProcNameStart  : quick_timing_summary
## ProcArguments  : quick_timing_summary pba tag ior
## ProcDependency : sh , quick_timing 
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc quick_timing_summary {pba tag ior} {
    global SCENARIO

	if { [llength $ior] == 0 } {  
		set ior_collection r 
	} else {
		set ior_collection [lindex $ior 0]
	}
	set tag $tag.$SCENARIO.quicksum
	regsub -all { } $tag {_} tag	
    puts ""
	set output_file [quick_timing $pba 100000 -0.000 minmax 0 $ior_collection] 

	redirect -var temp_var { set output_file [quick_timing $pba 100000 -0.000 minmax 0 $ior_collection] }
        redirect      -file $tag.all     { sh cat $output_file | column -t -s ,                 }
        redirect -tee -file $tag.sum     { sh cat $output_file | column -t -s , | egrep 'Group' }
        redirect      -file $tag.csv     { sh cat $output_file }

        set $tag.all [file normalize $tag.all]
        set $tag.sum [file normalize $tag.sum]
        set $tag.csv [file normalize $tag.csv]

        puts ""
	puts "<Open> :  $tag.all" 
	puts "<Open> :  $tag.sum" 	
	puts "<Open> :  $tag.csv" 	
}
