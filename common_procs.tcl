##------------------------------------------------------------------
## ProcNameStart  : get_net_stats
## ProcArguments  : get_net_stats xfile
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc get_net_stats xfile {
    set place_hold 1; proc x_get_xy {obj} {
	    if { [sizeof_collection [get_nets  -quiet $obj ] ] > 0 } { 
	        set obj_col [get_nets  $obj] ;
	        set attr_name1 "coordinate_max"
	        set attr_name2 "coordinate_min"
	        set class      "net"
	        #puts "nets [sizeof_collection [get_nets  -quiet $obj ] ]"
	    } elseif { [sizeof_collection [get_cells -quiet $obj ] ] > 0 } { 
	        set obj_col [get_cells $obj] ;
	        set attr_name1 "coordinate_max"
	        set attr_name2 "coordinate_min"
	        set class      "cell"
	
	        #puts "cell [sizeof_collection [get_cells  -quiet $obj ] ]"
	    } elseif { [sizeof_collection [get_pins  -quiet $obj ] ] > 0 } { 
	        set obj_col [get_pins  $obj] ;
	        set attr_name1 "coordinate"
	        set attr_name2 "coordinate"
	        set class      "pin"
	
	        #puts "pins [sizeof_collection [get_pins  -quiet $obj ] ]"
	    } else {
	        set obj_col [get_ports $obj] ;
	        set attr_name1 "coordinate"
	        set attr_name2 "coordinate"   
	        set class      "port"
	
	        #puts "port [sizeof_collection [get_ports  -quiet $obj ] ]"        
	    }
	    set diff_x       "0"
	    set diff_y       "0"
	    set diff         "0"
	    foreach_in_collection ret $obj_col {
	             set x1       "0"
	             set y1       "0"
	             set x2       "0"
	             set y2       "0"
	             set diff_x       "0"
	             set diff_y       "0"
	             set diff       "0"
	
	             catch {set x1 [format "%0.0f" [expr [get_attr -quiet $ret "x_$attr_name1"] / 1000]]}
	             catch {set y1 [format "%0.0f" [expr [get_attr -quiet $ret "y_$attr_name1"] / 1000]]}
	             catch {set x2 [format "%0.0f" [expr [get_attr -quiet $ret "x_$attr_name2"] / 1000]]}
	             catch {set y2 [format "%0.0f" [expr [get_attr -quiet $ret "y_$attr_name2"] / 1000]]}
	             catch {set diff_x [ expr abs($x2 - $x1)]}
	             catch {set diff_y [ expr abs($y2 - $y1)]}
	             catch {set diff [expr $diff_x + $diff_y]}
	
	             set el [get_object_name $ret]
	             #puts [format " %4.0f,%4.0f --> %4.0f,%4.0f %5s %3.0f (%3.0f,%3.0f) %-s" $x1 $y1 $x2 $y2 $class $diff $diff_x $diff_y $el]
	    }
             return "$diff,$diff_x,$diff_y"

    }
    set place_hold 1;proc x_arc_delay {in out} {
        set delay "noarc"
        set case_val [get_attr -quiet  [get_pins $out] case_value]
        if { [llength $case_val] == [sizeof_collection [get_pins $out] ] } {
            set case_val  "xcase"
        } else {
            set case_val  ""
        }

        if { $case_val == "" } {
            catch {set delay [format "%0.3f" [ lindex [lsort -increasing [get_attr -quiet [get_timing_arcs -quiet -from $in -to $out -filter "delay_max<10" ] delay_max] ] end ] ]}
        } else {
            set delay "$case_val"
        }
        return $delay
    } 

    set inpins [get_pins -hier -filter "is_hierarchical==false and direction==in"]
    set xfile "temp_net.info_hier.tcl"
    #set inpins          [get_pins -filter "direction==in" u_vcpu/u_cpu/u_int_fe/u_int_ls/u_ls/u_dat/g_l1d_data_with_ecc_u_data_ram_hi_word_bank_1_3_5_7_9_11_13_15/u_data_word6_ram/u_sram_way_3210/*]
    puts "Pins   : Add:[sizeof_collection $inpins]"    
    set static          [get_pins -quiet $inpins -filter "case_value==0"] 
    set static          [add_to_collection $static [get_pins $inpins -filter "case_value==1"]] 
    puts "Case   : Rmv:[sizeof_collection $static]"
    set dynamic         [remove_from_collection $inpins $static]
    puts "NoCase : Upd:[sizeof_collection $dynamic]"    
    set clockp          [get_pins -quiet $dynamic -filter "is_clock_pin==true"]
    puts "Clock  : Upd:[sizeof_collection $clockp]"
    set datap           [get_pins -quiet $dynamic -filter "is_clock_pin==false"]
    puts "Data   : Upd:[sizeof_collection $clockp]"



    set out_p [open $xfile w+]
    puts $out_p "#Clock,#Delay,#Slack,#Res,#Cap,#DistXY,#DistX,#DistY,#Net,#Pin"
    set sizex [sizeof_collection $dynamic]
    set i 0
    set j [format "%0.0f" [expr 0.050001 * $sizex]]
    set k 0
    set l 0


    foreach_in_collection pin $dynamic {
        incr i
	incr k
	if {$k >$j } {
	    puts "			-Processed $i/$l | $sizex  | [expr 100*$i/$sizex ]% @ [date] ...."  
	    set k 0
	    #break;
	}
        set ck_or_d [get_attr -quiet  $pin is_clock_pin]
        set lpin    [get_object_name $pin]
        set net     [get_object_name [get_attr -quiet $pin net]]
        set dpin    [get_object_name [get_attr -quiet  [get_net -quiet  $net] leaf_drivers]]
        set manhat  [x_get_xy $net] 
        set res     [get_attr -quiet  [get_nets -quiet  $net] net_resistance_max]
        set cap     [get_attr -quiet  [get_nets -quiet  $net] total_capacitance_max]
        set slack   [get_attr -quiet  $pin max_slack]
        set delay   [x_arc_delay $dpin $lpin]
        puts $out_p "$ck_or_d,$delay,$slack,$res,$cap,$manhat,$net,$lpin"
    }
    puts "			-Processed $i/$l | $sizex  | [expr 100*$i/$sizex ]% @ [date] ...."  
    close $out_p
    puts "\t**Open file $xfile"
}
