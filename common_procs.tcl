##------------------------------------------------------------------
## ProcNameStart  : autodesign_fanout
## ProcArguments  : autodesign_fanout patternlist nodepat target_qpin target_dpin
## ProcDependency : autodesign_puts_tee 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc autodesign_fanout {patternlist nodepat target_qpin target_dpin} {
        set xfile "autodesign_fanout.info.tcl"
        set out_p [open $xfile w+]

	set qdata   [split $target_qpin ","]
	set ddata   [split $target_dpin ","]

	set pins   ""
	foreach q  $qdata {
		append_to_collection -unique pins [get_pins -quiet $nodepat/$q]		
		autodesign_puts_tee $out_p  "      - Size $q = [sizeof_collection $pins]" 

	}
	
	set cone_all  [all_fanout -flat -from $pins -end ]
	set cone_final ""
	foreach d $ddata {
		set cone_temp 	[filter_collection $cone_all " lib_pin_name=~$d"]
		set cone_final	[append_to_collection -unique cone_final $cone_temp]
		autodesign_puts_tee $out_p  "      - Size $d = [sizeof_collection $cone_temp]  / [sizeof_collection $cone_final]" 
	}
	puts "\033\[1;34m<OPEN> File :   \033\[1;31m[file normalize $xfile]\033\[0m"

	close $out_p

}
##------------------------------------------------------------------
## ProcNameEnd    : autodesign_fanout
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : autodesign_generate_block_io
## ProcArguments  : autodesign_generate_block_io modules pin_bus_ultra outdir port_pattern only_endclk args
## ProcDependency : autodesign_print_stage , autodesign_debus , autodesign_generate_block_io_write , sh 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc autodesign_generate_block_io {modules pin_bus_ultra outdir port_pattern only_endclk args} {
    global ssi_sta_tool_unit_dly
	puts "\n\n"
	# Create Module Map
	autodesign_print_stage blue [format "=============================================================================================" ]
	array unset module_map
	array unset module_max_path
	array unset module_min_path
	set empty_collection [remove_from_collection [all_clocks] [all_clocks]]
	foreach blk $modules {
		set blk_insts [get_cells -quiet -hier -filter "ref_name==$blk"]
		if { [sizeof_collection $blk_insts] == 0 } {
			autodesign_print_stage red  [format "     - Warnx :   Missing Module $blk !"]
		} else {
			set module_map($blk) [get_object_name $blk_insts]
			autodesign_print_stage blue [format "     - Infox :   Found Module $blk !  Inst=[lindex $module_map($blk) 0]"]
		}
	}
	puts "\n\n"

	# Process Each Module
	autodesign_print_stage blue [format "=============================================================================================" ]
	array unset module_io
	set module_io(00_BLOCK_00)  [list [list #CONDITION #EXCEPTION #TO/FROM/THRU #PORTS #CLOCKS #BUS/SIZE #BUS/SLACK/STG/LSTG/DLY/FREQ/FREQMET/TDIV  #BUDGET_EFF/BASE/DELAY/DEFAULT #PROCESS/TIME]]

	array unset module_bus
	set pcnt 0
	#suppress_message SEL-005
	foreach  blk [array names module_map] {
		# Bus Selection
		set path_collection [remove_from_collection [all_clocks]  [all_clocks]]
		set inst     $module_map($blk)
		regsub -all {^| } $port_pattern " $inst/" port_list
		autodesign_print_stage blue [format "     - Infox :   Module $blk : Pattern = $port_pattern / Ports Lookup: $port_list"]

		set in_pins   [lsort -unique [get_object_name [get_pins -quiet $port_list -filter "direction==in && is_hierarchical==true"]]]
		set out_pins  [lsort -unique [get_object_name [get_pins -quiet $port_list -filter "direction==out && is_hierarchical==true"]]]

		set in_busx   [autodesign_debus $in_pins  {^$inst/}]
		set out_busx  [autodesign_debus $out_pins {^$inst/}]

		set in_ultra  [autodesign_debus $in_pins  {^$inst/|\d+}]
		set out_ultra [autodesign_debus $out_pins {^$inst/|\d+}]

		autodesign_print_stage blue [format "     - Infox :   Module $blk : Input=[llength  $in_pins]  / Input(debussed)=[llength  $in_busx]  / Input(compressed)=[llength  $in_ultra]"]
		autodesign_print_stage blue [format "     - Infox :   Module $blk : Output=[llength  $out_pins]  / Output(debussed)=[llength  $out_busx]  / Output(compressed)=[llength  $out_ultra]"]
		set module_bus(Inputs) $in_pins;  set module_bus(Outputs) $out_pins
		if { $pin_bus_ultra == "bus"   } { set module_bus(Inputs) $in_busx;   set module_bus(Outputs) $out_busx  }
		if { $pin_bus_ultra == "ultra" } { set module_bus(Inputs) $in_ultra;  set module_bus(Outputs) $out_ultra }
		autodesign_print_stage red  [format "     - Infox :   Module $blk : Selected --> Input=[llength  $module_bus(Inputs)] | Output=[llength  $module_bus(Outputs)]"]
		autodesign_print_stage blue [format "\t      --------------------------------------------------------------------------------------"]
		
		# Init Block
		set module_io($blk) [list]

		# Input/Output Process
		foreach categ [array names module_bus] {
			set direction "in"
			if { $categ == "Outputs" } { set direction "out" }
			set max_size   [llength $module_bus($categ)]
			set bkt_size   [expr $max_size / 10]
			set iter_size  0
			set lst_size   0
			set progress   "0" 
		        puts -nonewline  "[date]       \t\t\t $categ: $progress"
			foreach nodex $module_bus($categ) {
				# Bucket Count:
				incr iter_size
				incr lst_size
				if { $iter_size >= $bkt_size } { 
		                        puts -nonewline [format " -> [expr 100*($lst_size )/$max_size] ($lst_size)"]
                                        flush stdout
					set iter_size 0	
				}

				# Map Bust Stat
				set refTime [clock seconds]
				incr pcnt
				#set nodex    "u_vcpu/u_cpu/u_l*_ctrl/gateway_sib_to_select_*__FEEDTHRU_*\[*\]"
				set bus_pins    [get_pins -quiet [list $nodex] -filter "direction==$direction"]
				set bus_size    [sizeof_collection $bus_pins]
				set bus_idx     [lindex [split $nodex "/"] end]	
				set pathS       [get_timing_path -through       $bus_pins -delay max -max_path 1]
				set slackA   [lindex [lsort -real -increasing [lsort -unique [get_attribute  $pathS slack]]] 0]
				if { $slackA == "" } { set slackA INFINITY }
				# MapIO Category
				set io_data [list "\$XDESIGN == \"$blk\""  "Unknown" " -through "     "\[filter_collection \[get_ports \${${blk}_hier}$bus_idx\] \"direction==$direction\"\]" "#NO_CLK"    "$bus_size"   "$slackA" "No_Budget"]
				#puts "Done MapIO"

				# FalsePaths	
				if { $slackA == "INFINITY" } {
					#puts "Done FalsePaths"
					set commnet_sfp ""
					set non_static_size [sizeof_collection [filter_collection $bus_pins "constant_value!=''"]]
					set is_static_val   [get_attribute -quiet $bus_pins constant_value]
					set is_static      [join [lsort -unique $is_static_val] "_"]

					if { $is_static != "" &&  $non_static_size == 0}  { 
						set commnet_sfp "${commnet_sfp}/Static_$is_static"
					} else {
						set fanin1      [sizeof_collection [filter_collection [all_fanin  -quiet -flat -to   $bus_pins -pin_level 1 ] "direction==out"]]
						if { $fanin1     == "0" } {
							set commnet_sfp "${commnet_sfp}/NoDriver"
						} else {
							set fanout1     [sizeof_collection [filter_collection [all_fanout -quiet -flat -from $bus_pins -pin_level 1 ] "direction==in"]]
							if { $fanout1    == "0" } { 
								set commnet_sfp "${commnet_sfp}/NoLoad"
							} else {
								set faninx      [sizeof_collection  [all_fanin  -quiet -flat -to   $bus_pins -only_cells -start ] ]
								if { $faninx    == "0" } { 
									set commnet_sfp "${commnet_sfp}/NoFanin"
								} else {
									set fanoutx     [sizeof_collection  [all_fanout -quiet -flat -from $bus_pins -only_cells -end   ] ]
									if { $fanoutx    == "0" } { 
										set commnet_sfp "${commnet_sfp}/NoFanout"
									} else {
										set commnet_sfp "${commnet_sfp}/UnTimed"
									}
								}
							}

						}
					}

					set io_data [list "\$XDESIGN == \"$blk\""  "set_false_path" " -through "     "\[filter_collection \[get_ports \${${blk}_hier}$bus_idx\] \"direction==$direction\"\]" "#NO_CLK"    "$bus_size"   "$slackA" "$commnet_sfp"]
				# BudgetPath	
				} else {
					#puts "Done BudgetPath"
					append_to_collection path_collection $pathS
					set slackS    $slackA
					catch { set slackS    [format "%+0.3f" [get_attribute $pathS     slack]] }
					set slackN    $slackS
					catch { set slackN    [format "%+0.3f" [get_attribute $pathS     normalized_slack]] }
					set mcp_factor 1
					catch { set mcp_factor    [expr int($slackN/$slackA)] }
					# Target Clock
					set sclk      [get_object_name  [get_attribute $pathS startpoint_clock] ]	
					set eclk      [get_object_name  [get_attribute $pathS endpoint_clock] ]	

					set clk       $eclk
					set points    [get_attribute $pathS  points]
					set points_ob [get_attribute $points object]
					set point_arr [get_attribute $points arrival]
					set effective_raw        0
					set effective_stage      4
					set effective_stage_pre  [expr $effective_stage /2]
					set effective_stage_post [expr $effective_stage /2]
					set base_raw             0
					set base_stage           4
					set base_stage_pre       [expr $base_stage /2]
					set base_stage_post      [expr $base_stage /2]
					set dly_stage            0.005
					set dly_stage_pre        [expr $dly_stage /2]
					set dly_stage_post       [expr $dly_stage /2]

					set ep_uncr              [get_attribute -quiet $pathS clock_uncertainty]
					set ep_libr              [get_attribute -quiet $pathS endpoint_setup_time_value]
					if { $ep_uncr == "" }    { set 	ep_uncr 0.000 }
					if { $ep_libr == "" }    { set 	ep_libr 0.000 }
					set dly_post_adjust      [expr $ep_libr - $ep_uncr]


				        #puts "Done BudgetPath - BaseProcess"
					#puts "\${${blk}_hier}$bus_idx"
					set point_index 0
					foreach_in_collection xpoint $points_ob {
						set xdir_obj  [get_attribute $xpoint direction]
						set xdir_name [get_object_name  $xpoint]
					        regsub -all {\[|\]|\*} $bus_idx   {.} bus_idx_sq
			        		regsub -all {\[|\]|\d+} [lindex [split $xdir_name "/"] end]  {.} xdir_name_sq
						set dly_stage [lindex $point_arr $point_index] 
						#puts "\nstage_match $bus_idx_sq $xdir_name->$dly_stage"
						if { $xdir_obj == "out" } {
							set fout 	    [sizeof_collection [all_fanout -flat -from $xpoint -pin_level 1] ]
							set log_stage       [expr int(round(log($fout)/log(2)))]
							#puts "\nstage_match $bus_idx_sq -> Fout=$fout/ $log_stage,$effective_raw,$effective_stage  1,$base_raw,$base_stage -> $xdir_name"
							set effective_stage [expr $effective_stage + $log_stage]
							set effective_raw   [expr $effective_raw + $log_stage]
							incr base_stage
							incr base_raw
							#puts "stage_match $bus_idx_sq -> $log_stage,$effective_stage $bus_idx_sq/$xdir_name_sq "
						}
						if { [regexp $bus_idx_sq $xdir_name_sq] && [get_attr -quiet $xpoint is_hierarchical] == "true" } { 
							set effective_stage_pre   [expr $effective_stage - $effective_stage_pre]
							set base_stage_pre        [expr $base_stage      - $base_stage_pre]
							set dly_stage_pre         $dly_stage
							#puts "found_match $bus_idx -> $base_stage_pre/$effective_stage_pre/$dly_stage_pre -> $xdir_name "
						}
						incr point_index

					}
					set base_stage_post      [expr $base_stage      - $base_stage_pre]
					set effective_stage_post [expr $effective_stage - $effective_stage_pre]
					set dly_stage            [expr $dly_stage       + $dly_post_adjust]
					set dly_stage_post       [expr $dly_stage       - $dly_stage_pre] 


					#puts "Done BudgetPath - StageProcess  \${${blk}_hier}$bus_idx $effective_stage_pre+$effective_stage_post=$effective_stage |  $base_stage_pre+$base_stage_post=$base_stage | $dly_stage_pre+$dly_stage_post=$dly_stage"
					set budget_effx_pre      [format "%0.0f" [expr 100.0 * $effective_stage_pre  / $effective_stage]]
					set budget_effx_post     [format "%0.0f" [expr 100.0 * $effective_stage_post / $effective_stage]]
					set budget_base_pre      [format "%0.0f" [expr 100.0 * $base_stage_pre  / $base_stage]]
					set budget_base_post     [format "%0.0f" [expr 100.0 * $base_stage_post / $base_stage]]
					set budget_dlyx_pre      [format "%0.0f" [expr 100.0 * $dly_stage_pre  / $dly_stage]]
					set budget_dlyx_post     [format "%0.0f" [expr 100.0 * $dly_stage_post / $dly_stage]]


					set dly_stage            [format "%0.2f" $dly_stage]
					set dly_stage_pre        [format "%0.2f" $dly_stage_pre]
					set dly_stage_post       [format "%0.2f" $dly_stage_post]

					set budget_effx  [expr 100 - $budget_effx_pre]
					set budget_base  [expr 100 - $budget_base_pre]
					set budget_dlyx  [expr 100 - $budget_dlyx_pre]
					set budget_def   [expr 50]

					if { $direction == "in" }  { 
						if { $only_endclk != "1" } {
							set clk $sclk 
						}
						set budget_effx  [expr 100 - $budget_effx_post]
						set budget_base  [expr 100 - $budget_base_post]
						set budget_dlyx  [expr 100 - $budget_dlyx_post]
					}
					#puts "Done BudgetPath - io_data"
					set freqx  "0000MHz"
					set freqm  "0000MHz"

					catch { set freqx  [format "%04.0fMHz" [expr round($ssi_sta_tool_unit_dly / [get_attribute [get_clocks $clk] period])]] }
					if { $slackS > 0 } {
						set freqm $freqx
					} else {
						catch { set freqm  [format "%04.0fMHz" [expr round($ssi_sta_tool_unit_dly / ([get_attribute [get_clocks $clk] period] * (1 - $slackS ) ))]] }
						catch { set freqm  [format "%04.0fMHz" [expr round($freqx * (1 + ($mcp_factor*$slackN))]] }
					}
					set io_data [list "\$XDESIGN == \"$blk\""  "autodesign_set_${direction}put_delay" " -through "     "\[filter_collection \[get_ports \${${blk}_hier}$bus_idx\] \"direction==$direction\"\]" "$clk"    "$bus_size"   "$slackS/$base_stage=$base_stage_pre+$base_stage_post/$effective_stage=$effective_stage_pre+$effective_stage_post/$dly_stage=$dly_stage_pre+$dly_stage_post/$freqx/$freqm/$mcp_factor" "$budget_effx/$budget_base/$budget_dlyx/$budget_def"]
				}
				#puts "$bus_idx,$bus_size,$nodex,$slackA,$slackS"
				

				set tarTime [clock seconds]
				set delta   [expr ($tarTime - $refTime)]
				lappend module_io($blk) [concat $io_data [list "${delta} sec"]]
				#if { $pcnt >= 350 } { break }
			}
			puts ""
		}
		autodesign_print_stage blue [format "     - Infox :   Module $blk : Steaming I/O"]
		autodesign_generate_block_io_write $module_io($blk) $blk $outdir
		# Add Verbose reports
		set old_format [get_app_var timing_report_fixed_width_columns_on_left]
		set_app_var timing_report_fixed_width_columns_on_left false
		report_timing -include_hierarchical_pins  -nets    -nosplit   -input_pins   -crosstalk_delta  -capacitance  -transition_time $path_collection > $outdir/$blk.mode.corner.path.max_path.detail.rpt
		set_app_var timing_report_fixed_width_columns_on_left true
		report_timing -include_hierarchical_pins  -nets    -nosplit   -input_pins   -crosstalk_delta  -capacitance  -transition_time -physical $path_collection > $outdir/$blk.readable.rpt
		set_app_var timing_report_fixed_width_columns_on_left $old_format

		autodesign_print_stage blue [format "\t      --------------------------------------------------------------------------------------"]
	}
	#unsuppress_message SEL-005
	autodesign_print_stage blue [format "=============================================================================================\n\n" ]
	redirect -variable x {sh tree $outdir/*}
	echo $x > $outdir/io_timing.log
	autodesign_print_stage red  [format "     - Infox :   IO  Extraction Completed ! "]
	autodesign_print_stage blue [format "=============================================================================================\n\n" ]

}
##------------------------------------------------------------------
## ProcNameEnd    : autodesign_generate_block_io
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : autodesign_generate_block_io_path_adjust
## ProcArguments  : autodesign_generate_block_io_path_adjust modules pin_bus_ultra outdir port_pattern args
## ProcDependency : autodesign_print_stage , autodesign_debus , ls 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc autodesign_generate_block_io_path_adjust {modules pin_bus_ultra outdir port_pattern args} {
	puts "\n\n"
	# Create Module Map
	autodesign_print_stage blue [format "=============================================================================================" ]
	array unset module_map
	array unset module_max_path
	array unset module_min_path
	set empty_collection [remove_from_collection [all_clocks] [all_clocks]]
	foreach blk $modules {
		set blk_insts [get_cells -quiet -hier -filter "ref_name==$blk"]
		if { [sizeof_collection $blk_insts] == 0 } {
			autodesign_print_stage red  [format "     - Warnx :   Missing Module $blk !"]
		} else {
			set module_map($blk) [get_object_name $blk_insts]
			autodesign_print_stage blue [format "     - Infox :   Found Module $blk !  Inst=[lindex $module_map($blk) 0]"]
		}
	}
	puts "\n\n"

	# Process Each Module
	autodesign_print_stage blue [format "=============================================================================================" ]
	array unset module_io
	set module_io(00_BLOCK_00)  [list [list #BLOCK #EXCEPTION #TO/FROM/THRU #PORTS #START_CLOCK #END_CLOCK #PT_SLACK #BUS_SIZE #PORT_ID]]

	array unset module_bus
	set pcnt 0
	#suppress_message SEL-005
	foreach  blk [array names module_map] {
		# Bus Selection
		set path_collection [remove_from_collection [all_clocks]  [all_clocks]]
		set inst     $module_map($blk)
		regsub -all {^| } $port_pattern " $inst/" port_list
		autodesign_print_stage blue [format "     - Infox :   Module $blk : Pattern = $port_pattern / Ports Lookup: $port_list"]

		set in_pins   [lsort -unique [get_object_name [get_pins -quiet $port_list -filter "direction==in && is_hierarchical==true"]]]
		set out_pins  [lsort -unique [get_object_name [get_pins -quiet $port_list -filter "direction==out && is_hierarchical==true"]]]

		set in_busx   [autodesign_debus $in_pins  {^$inst/}]
		set out_busx  [autodesign_debus $out_pins {^$inst/}]

		set in_ultra  [autodesign_debus $in_pins  {^$inst/|\d+}]
		set out_ultra [autodesign_debus $out_pins {^$inst/|\d+}]

		autodesign_print_stage blue [format "     - Infox :   Module $blk : Input=[llength  $in_pins]  / Input(debussed)=[llength  $in_busx]  / Input(compressed)=[llength  $in_ultra]"]
		autodesign_print_stage blue [format "     - Infox :   Module $blk : Output=[llength  $out_pins]  / Output(debussed)=[llength  $out_busx]  / Output(compressed)=[llength  $out_ultra]"]
		set module_bus(Inputs) $in_pins;  set module_bus(Outputs) $out_pins
		if { $pin_bus_ultra == "bus"   } { set module_bus(Inputs) $in_busx;   set module_bus(Outputs) $out_busx  }
		if { $pin_bus_ultra == "ultra" } { set module_bus(Inputs) $in_ultra;  set module_bus(Outputs) $out_ultra }
		autodesign_print_stage red  [format "     - Infox :   Module $blk : Selected --> Input=[llength  $module_bus(Inputs)] | Output=[llength  $module_bus(Outputs)]"]
		autodesign_print_stage blue [format "\t      --------------------------------------------------------------------------------------"]
		
		# Init Block
		set module_io($blk) [list]
		
		# Input/Output Process
		foreach categ [array names module_bus] {
			set direction "in"
			if { $categ == "Outputs" } { set direction "out" }
			set max_size   [llength $module_bus($categ)]
			set bkt_size   [expr $max_size / 10]
			set iter_size  0
			set lst_size   0
			set progress   "0" 
		        puts -nonewline  "[date]       \t\t\t $categ: $progress"
			foreach nodex $module_bus($categ) {
				# Bucket Count:
				incr iter_size
				incr lst_size
				if { $iter_size >= $bkt_size } { 
		                        puts -nonewline [format " -> [expr 100*($lst_size )/$max_size] ($lst_size)"]
                                        flush stdout
					set iter_size 0	
				}
				# Map Bust Stat
				set refTime [clock seconds]
				incr pcnt
				#set nodex    "u_vcpu/u_cpu/u_l*_ctrl/gateway_sib_to_select_*__FEEDTHRU_*\[*\]"
				set bus_pins    [get_pins -quiet [list $nodex] -filter "direction==$direction"]
				set bus_size    [sizeof_collection $bus_pins]
				set bus_idx     [lindex [split $nodex "/"] end]	
				set pathS       [get_timing_path -through       $bus_pins -delay max -max_path 1]
				set slackA      [lindex [lsort -real -increasing [lsort -unique [get_attribute  $pathS slack]]] 0]
				if { $slackA == "" } { set slackA INFINITY }
				set eclk "#NO_CLK"
				set sclk "#NO_CLK"
				if { $slackA != "INFINITY" } { 
					set eclk         [get_object_name [get_attribute -quiet $pathS endpoint_clock]]
					set sclk         [get_object_name [get_attribute -quiet $pathS startpoint_clock]]
				}
				if { $eclk == "" } { set eclk "#NO_CLK" }
				if { $sclk == "" } { set sclk "#NO_CLK" }

				# MapIO Category
				#CONDITION #EXCEPTION #TO/FROM/THRU #PORTS #CLOCKS #PT_SLACK
				if { $slackA > 0 } {
					set exception    "autodesign_path_passing"
				} elseif { $slackA <= 0 } {
					set exception    "autodesign_path_failing"
				} 
				if { $slackA != "INFINITY"} {
					set io_data 	 [list "$blk"  "$exception" " -through "     "\[filter_collection \[get_ports \${${blk}_hier}$bus_idx\] \"direction==$direction\"\]" "$eclk" "$sclk"    "$slackA" "$bus_size" "\${${blk}_hier}$bus_idx"]
				        lappend module_io($blk) $io_data
				}
				#puts "Done MapIO"	
			}
			puts ""

		}
	}
	# Create Dir
	file mkdir   $outdir
	set outdir   [file normalize $outdir]
	foreach blk [array name module_io] {
		if { $blk != "00_BLOCK_00"}  {
			set log_file     "$outdir/path_adjust.$blk.log"
			set adjust_file  "$outdir/path_adjust.$blk.tcl"
			set offset_file  "$outdir/path_adjust.$blk.pd_offset.tcl"

			set log_filep    [open $log_file w+]
			set adjust_filep [open $adjust_file w+]
			set offset_filep [open $offset_file w+]

			#set module_io(00_BLOCK_00)  [list [list #BLOCK #EXCEPTION #TO/FROM/THRU #PORTS #START_CLOCK #END_CLOCK #PT_SLACK #BUS_SIZE]]
			foreach y  $module_io(00_BLOCK_00) {
				puts $log_filep     [format "  %-50s %-30s %-20s %-150s %-40s %-40s %-40s %-5s %-50s"  [lindex $y 0] [lindex $y 1] [lindex $y 2] [lindex $y 3] [lindex $y 4] [lindex $y 5] [lindex $y 6] [lindex $y 7] [lindex $y 8]]
				puts $offset_filep  "global path_adjust_pd_offset \n\n"
				puts $offset_filep  "array unset  path_adjust_pd_offset \n"
				puts $adjust_filep  "global path_adjust_pd_offset \n\n"
				puts $adjust_filep  "proc autodesign_path_adjust {  tighten_1_0  relax_1_0 port_object from_clk to_clk path_adjust_pd_offset pt_slack path_id } {"
				puts $adjust_filep  "   set path_adjust_offset \[expr \$pt_slack - \$path_adjust_pd_offset\]"
				puts $adjust_filep  "   if { (\$tighten_1_0 == 1 && \$path_adjust_offset < 0)  || (\$relax_1_0 == 1 && \$path_adjust_offset > 0) } {"
				puts $adjust_filep  "      catch { reset_path_adjust_group -name              \$path_id }"
				puts $adjust_filep  "      catch { set_path_adjust_group   -name              \$path_id -through \$port_object      -clock_from \[get_clocks \$from_clk\]  -clock_to \[get_clocks \$to_clk\] }"
				puts $adjust_filep  "      catch { set_path_adjust         -path_adjust_group \$path_id -setup                      -view  \[all_analysis_views\]  \$path_adjust_offset }"
				puts $adjust_filep  "      puts \"<PT_Info> :: Added   Path Adjust on \$path_id  | pt_slack=\$pt_slack | tighten_1_0=\$tighten_1_0 && \$path_adjust_offset < 0 | relax_1_0 == \$relax_1_0 && \$path_adjust_offset > 0\"" 
				puts $adjust_filep  "   } else {"
				puts $adjust_filep  "      puts \"<PT_Warn> :: Skipped Path Adjust on \$path_id  | pt_slack=\$pt_slack | tighten_1_0=\$tighten_1_0 && \$path_adjust_offset < 0 | relax_1_0 == \$relax_1_0 && \$path_adjust_offset > 0\"" 
				puts $adjust_filep  "   }"
				puts $adjust_filep  "}"

			}

			foreach y  $module_io($blk) {
				puts $log_filep     [format "  %-50s %-30s %-20s %-150s %-40s %-40s %-40s %-5s %-50s"  [lindex $y 0] [lindex $y 1] [lindex $y 2] [lindex $y 3] [lindex $y 4] [lindex $y 5] [lindex $y 6] [lindex $y 7] [lindex $y 8]]
				puts $offset_filep  [format "  set path_adjust_pd_offset(%-50s)  0.000"     [lindex $y 8]]
				set  sta_status "FAIL"
				if { [lindex $y 6] >= 0 } { set sta_status "PASS" }
				puts $adjust_filep  [format "  catch { %-30s %1s %1s %-150s %-40s %-40s %-40s %-5s %-50s } ; #Status=%s"  "autodesign_path_adjust" "1" "0" [lindex $y 3] [lindex $y 4] [lindex $y 5] "\$path_adjust_pd_offset([lindex $y 8])" [lindex $y 6] [lindex $y 8] "$sta_status" ]
				


				# set_path_adjust_group  -from [get_ports idft_ijtag_ue] -name idft_ijtag_ue  
				# set_path_adjust -setup  0.500  -path_adjust_group  idft_ijtag_ue -view  [all_analysis_views ]
			}
			close $adjust_filep
			close $log_filep
			close $offset_filep

			puts ""
			autodesign_print_stage blue [format "     - Infox :   Files $outdir/*${blk}*"]
			foreach x [ls $outdir/*${blk}*] {
				autodesign_print_stage blue [format "                       - $x"]	
			}
		}

	}
}
##------------------------------------------------------------------
## ProcNameEnd    : autodesign_generate_block_io_path_adjust
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : autodesign_generate_block_io_write
## ProcArguments  : autodesign_generate_block_io_write io_db_list blk outdir
## ProcDependency : autodesign_print_stage , autodesign_report_sync_clocks , ls 
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc autodesign_generate_block_io_write {io_db_list blk outdir} {
	# Creat Dir
	file mkdir $outdir
	set outdir [file normalize $outdir]
	# Expected Format :
	array unset  module_io
	set module_io(00_BLOCK_00)  [list [list #CONDITION #EXCEPTION #TO/FROM/THRU #PORTS #CLOCKS #BUS/SIZE #BUS/SLACK/STG/LSTG/DLY/FREQ/FREQMET/TDIV  #BUDGET_EFF/BASE/DELAY/DEFAULT #PROCESS/TIME]]
	set module_io($blk)    $io_db_list
	# Stream Loop
	foreach x [lsort [array name module_io]] {
		set block_dir $outdir/$x
		if { $x == "00_BLOCK_00" } { continue }
		file mkdir $block_dir
		set block_dir [file normalize $block_dir]
	
		set  file_sfp     [open "$block_dir/$x.false_path_always.tcl" w+]
		set  file_sfp_tm  [open "$block_dir/$x.false_path_timing.tcl" w+]
		set  file_sfp_ex  [open "$block_dir/$x.false_path_exclks.tcl" w+]
		set  file_mcp_tm  [open "$block_dir/$x.mcp20_path_timing.tcl" w+]
		set  file_mcp_ex  [open "$block_dir/$x.mcp20_path_exclks.tcl" w+]

		set  file_base    [open "$block_dir/$x.io_base.tcl" w+]
		set  file_effx    [open "$block_dir/$x.io_effx.tcl" w+]
		set  file_dlyx    [open "$block_dir/$x.io_dlyx.tcl" w+]
		set  file_logx    [open "$block_dir/$x.io_log.tcl" w+]

		set common_header "
		#-----------------------------------------------------------------------------------------------------------------------------------
		# Common I/O Tempalte : $x 
		#-----------------------------------------------------------------------------------------------------------------------------------
		set XDESIGN        \[lindex \[get_object_name \[current_design \]\] 0\]
		set ${blk}_hier    \"\"
		set SCALE_FACTOR   \"0.01\"

 		proc autodesign_set_output_delay { budget ports maxmin add clock clock_list} {
     			foreach_in_collection clkx \$clock_list {
          			set_output_delay   \$budget      \$ports    \$maxmin \$add   \$clock   \$clkx                  
     			}
	 	}

 		proc autodesign_set_input_delay { budget ports maxmin add clock clock_list} {
     			foreach_in_collection clkx \$clock_list {
          			set_input_delay   \$budget      \$ports    \$maxmin  \$add   \$clock   \$clkx                  
     			}
 		}
		#-----------------------------------------------------------------------------------------------------------------------------------	
		"
		foreach_in_collection clk [all_clocks] {
			set clk_name      [get_object_name $clk] 
			set valid_list    [get_object_name [autodesign_report_sync_clocks $clk_name [all_clocks]]]
			set common_header "$common_header\n		set LIST_$clk_name	\[get_clocks -quiet \[list $valid_list\]\]"	
		} 

		foreach_in_collection clk [all_clocks] {
			set clk_name      [get_object_name $clk] 
			set common_header "$common_header\n		set PERIOD_$clk_name	\[lindex  \[lsort -increasing \[get_attribute -quiet \[get_clocks -quiet \$LIST_$clk_name\] period \] \] 0\]"	
		} 



		set common_header "$common_header
		#-----------------------------------------------------------------------------------------------------------------------------------
		if { \$XDESIGN == \"$blk\" } \{\n"

		set common_footer "\n		\}\n
		#-----------------------------------------------------------------------------------------------------------------------------------"
		
		puts $file_sfp     "$common_header"
		puts $file_sfp_tm  "$common_header"
		puts $file_sfp_ex  "$common_header"
		puts $file_mcp_tm  "$common_header"
		puts $file_mcp_ex  "$common_header"
		puts $file_base    "$common_header"
		puts $file_effx    "$common_header"
		puts $file_dlyx    "$common_header"

		foreach y [concat $module_io(00_BLOCK_00) $module_io($x)] {	
			# False Path Always File
			if { [lindex $y 1] == "set_false_path" } {
				if { [regexp "UnTimed" [lindex $y 7]] } {
					puts $file_sfp_tm [format "catch {		       %-30s  %-20s  %-150s }; #Clk=%-20s #Bus=%-10s #Slack=%-30s #Budget=%-30s" "set_false_path" [lindex $y 2] [lindex $y 3] [lindex $y 4] [lindex $y 5] [lindex $y 6] [lindex $y 7]]
					puts $file_mcp_tm [format "catch {		       %-30s  %-20s  %-150s }; #Clk=%-20s #Bus=%-10s #Slack=%-30s #Budget=%-30s" "set_multicycle_path -setup 20" [lindex $y 2] [lindex $y 3] [lindex $y 4] [lindex $y 5] [lindex $y 6] [lindex $y 7]]
					puts $file_mcp_tm [format "catch {		       %-30s  %-20s  %-150s }; #Clk=%-20s #Bus=%-10s #Slack=%-30s #Budget=%-30s" "set_multicycle_path -hold  20" [lindex $y 2] [lindex $y 3] [lindex $y 4] [lindex $y 5] [lindex $y 6] [lindex $y 7]]

				} else {
					puts $file_sfp    [format "catch {		       %-30s  %-20s  %-150s }; #Clk=%-20s #Bus=%-10s #Slack=%-30s #Budget=%-30s" "set_false_path" [lindex $y 2] [lindex $y 3] [lindex $y 4] [lindex $y 5] [lindex $y 6] [lindex $y 7]]
				}
			}

			# IO Base File
			if { [lindex $y 1] == "autodesign_set_input_delay" || [lindex $y 1] == "autodesign_set_output_delay" } {
				puts $file_sfp_ex [format "catch {		       %-30s  %-20s  %-150s -to \[remove_from_collection \[all_clocks\] \[get_clocks \$LIST_%-20s\]\] }; #Clk=%-20s #Bus=%-10s #Slack=%-30s #Budget=%-30s" "set_false_path" [lindex $y 2] [lindex $y 3] [lindex $y 4] [lindex $y 4] [lindex $y 5] [lindex $y 6] [lindex $y 7]]
				puts $file_mcp_ex [format "catch {		       %-30s  %-20s  %-150s -to \[remove_from_collection \[all_clocks\] \[get_clocks \$LIST_%-20s\]\] }; #Clk=%-20s #Bus=%-10s #Slack=%-30s #Budget=%-30s" "set_multicycle_path -setup 20" [lindex $y 2] [lindex $y 3] [lindex $y 4] [lindex $y 4] [lindex $y 5] [lindex $y 6] [lindex $y 7]]
				puts $file_mcp_ex [format "catch {		       %-30s  %-20s  %-150s -to \[remove_from_collection \[all_clocks\] \[get_clocks \$LIST_%-20s\]\] }; #Clk=%-20s #Bus=%-10s #Slack=%-30s #Budget=%-30s" "set_multicycle_path -hold  20" [lindex $y 2] [lindex $y 3] [lindex $y 4] [lindex $y 4] [lindex $y 5] [lindex $y 6] [lindex $y 7]]


				set budget_base [lindex [split [lindex $y 7] "/"] 0]
				set budget_effx [lindex [split [lindex $y 7] "/"] 1]
				set budget_dlyx [lindex [split [lindex $y 7] "/"] 2]

				if { $budget_base  > 90 } { set budget_base "90" }
				if { $budget_effx  > 90 } { set budget_effx "90" }
				if { $budget_dlyx  > 90 } { set budget_dlyx "90" }
				if { $budget_base  <  5 } { set budget_base "10" }
				if { $budget_effx  <  5 } { set budget_effx "10" }
				if { $budget_dlyx  <  5 } { set budget_dlyx "10" }

				set budget_base   "\[expr \$SCALE_FACTOR * \$PERIOD_[lindex $y 4] \ * $budget_base\]"
				set budget_effx   "\[expr \$SCALE_FACTOR * \$PERIOD_[lindex $y 4] \ * $budget_effx\]"
				set budget_dlyx   "\[expr \$SCALE_FACTOR * \$PERIOD_[lindex $y 4] \ * $budget_dlyx\]"

				puts $file_base   [format "catch {		       %-30s  %-80s  %-150s -max -add -clock \[get_clocks \$LIST_%-20s\] }; #Clk=%-20s #Bus=%-10s #Slack=%-30s #Budget=%-30s" [lindex $y 1] $budget_base [lindex $y 3] [lindex $y 4] [lindex $y 4] [lindex $y 5] [lindex $y 6] [lindex $y 7]]
				puts $file_effx   [format "catch {		       %-30s  %-80s  %-150s -max -add -clock \[get_clocks \$LIST_%-20s\] }; #Clk=%-20s #Bus=%-10s #Slack=%-30s #Budget=%-30s" [lindex $y 1] $budget_effx [lindex $y 3] [lindex $y 4] [lindex $y 4] [lindex $y 5] [lindex $y 6] [lindex $y 7]]
				puts $file_dlyx   [format "catch {		       %-30s  %-80s  %-150s -max -add -clock \[get_clocks \$LIST_%-20s\] }; #Clk=%-20s #Bus=%-10s #Slack=%-30s #Budget=%-30s" [lindex $y 1] $budget_dlyx [lindex $y 3] [lindex $y 4] [lindex $y 4] [lindex $y 5] [lindex $y 6] [lindex $y 7]]

			}
			puts $file_logx  [format "  %-50s | %-30s %-20s %-150s %-40s %-10s %-60s %-40s %-0s"  [lindex $y 0] [lindex $y 1] [lindex $y 2] [lindex $y 3] [lindex $y 4] [lindex $y 5] [lindex $y 6] [lindex $y 7] [lindex $y 8]]
			
		} 

		puts $file_sfp     "$common_footer"
		puts $file_sfp_tm  "$common_footer"
		puts $file_sfp_ex  "$common_footer"
		puts $file_mcp_tm  "$common_footer"
		puts $file_mcp_ex  "$common_footer"
		puts $file_base    "$common_footer"
		puts $file_effx    "$common_footer"
		puts $file_dlyx    "$common_footer"

		close $file_sfp
		close $file_sfp_tm
		close $file_sfp_ex
		close $file_mcp_tm
		close $file_mcp_ex

		close $file_base
		close $file_effx
		close $file_dlyx

		close $file_logx

		autodesign_print_stage blue [format "     - Infox :   Files $block_dir/*tcl"]
		foreach x [ls $block_dir/*tcl] {
			autodesign_print_stage blue [format "                       - $x"]	
		}
	}
}
##------------------------------------------------------------------
## ProcNameEnd    : autodesign_generate_block_io_write
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : autodesign_generate_clock_at_block
## ProcArguments  : autodesign_generate_clock_at_block modules outdir
## ProcDependency : autodesign_print_stage , parray 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc autodesign_generate_clock_at_block {modules outdir} {
	array unset module_map
	puts "\n\n"
	foreach module $modules {
		set inst    [get_cells -quiet -hierarchical -filter "ref_name=~$module"]
		if { [sizeof_collection $inst] } { 
			set ref_mod [lindex [lsort -unique [get_attribute $inst ref_name]] 0]
			set module_map($ref_mod) [get_object_name $inst]
		}
	}
  #<CMD> create_generated_clock -edges    {1,4,7     } -source $MasterClk_Src  -name DG_LPCM_CPU_PPUCLK  -master_clock DG_LPCM_CPU_SCLK -add [lindex $CPU_PPUCLK 2 ] ; # Scenario= mission PhyEX=default Async=CPU_PPUCLK LogEx=default Tag=GSPAN_CLKS
	
        # Process Boundary
	foreach blkx [array name module_map] {
		set inst_name [lindex $module_map($blkx) 0]
		set all_input     [get_pins $inst_name/* -filter "is_hierarchical==true && direction==in"]
		autodesign_print_stage blue "$blkx->$inst_name"
		foreach_in_collection blk_inpin $all_input {
			set pinname  		[get_object_name $blk_inpin]
			set portname 		[lindex [split $pinname "/"] end]
			set driver   		[filter_collection [all_fanin -quiet -to $blk_inpin -flat -pin_level 1 ] "direction==out && is_hierarchical==false"]
			set clkatdriver 	[get_attribute -quiet  $driver clocks]
			set caseatdriver 	[get_attribute -quiet  $driver case_value]
			if { [sizeof_collection $clkatdriver] > 0 } {
				puts "CLK:$portname-> "
				foreach_in_collection clkx $clkatdriver {
					puts "              [get_object_name $clkx] "
				}
			}
		}
	}
        #SDC Dir 
	file mkdir $outdir
	set outdir [file normalize $outdir]
	autodesign_print_stage red [format "<SDC_GEN> : Created o/p directory %s"  "$outdir"]

	parray module_map

	puts "\n\n"
	
}
##------------------------------------------------------------------
## ProcNameEnd    : autodesign_generate_clock_at_block
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : autodesign_get_block_context
## ProcArguments  : autodesign_get_block_context cell
## ProcDependency : autodesign_get_static_val , autodesign_get_clock_group_mapping , autodesign_puts_tee 
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc autodesign_get_block_context cell {
	global XCORNER ssi_sta_tool_unit_dly
	if { ![info exist XCORNER] } { set XCORNER "PVT_DEF" }
    	if { [sizeof_collection [get_pins -quiet $cell]]} { 
	    set cpins [get_pins -quiet $cell]	    
	    set cell [get_object_name [get_cells -of_objects [get_pins $cell]]]
	} else {
	    set cpins [get_pins -quiet $cell/*]
    	}
        set xfile "autodesign_get_block_context.$XCORNER.info.tcl"
	set out_p [open $xfile w+]
    	set is_p "pin"
	set is_x ""
	if { [sizeof_collection $cpins ] == "0"} {
		set cpins [get_ports $cell/*]
		set is_p "port"
		set is_x "IO"
	
	}
	set pin_len   [expr ([string length $cell] + 20)]
	set lpin_len  20

	if {$pin_len > 100} {set pin_len 100};
	foreach pin [get_object_name $cpins] {
	  set lpin [lindex [split $pin "/"] end]	
	  if {[string length $pin] >= $pin_len} {
	       set pin_len [expr [string length $pin] + 2]
	  }
	  if {[string length $lpin] >= $lpin_len} {
	       set lpin_len [expr [string length $lpin] + 2]
	  }
	}


	set ref_len   [string length [lindex [get_attribute -quiet  [get_cells $cell] ref_name] 0]]
	set space1    [expr ((${pin_len} - 10)/2)]
	set clock_size "10" 
	foreach clk [get_object_name [get_clocks *]] {
	  if {[string length $clk] >= $clock_size } {
	       set clock_size "[string length $clk]" 
	  }
	}


	set clock_size [expr 5 + $clock_size + 0]  

	set ckgrp_size [expr 5 + 10 + 0]  

	set freq_size "10" 
	set freq_size [expr 5 + $freq_size + 0]  
	set wave_size "25" 
	set wave_size [expr 5 + $wave_size + 0]  
	set ref_size $ref_len 
	set ref_size [expr 5 + $ref_size + 0]  
	set cone_size "15" 
	set cone_size [expr 5 + $cone_size + 0]  

	set clkpins_all [get_pins  -quiet  -of_object [all_registers ] -filter "is_clock_pin==true"]
        set clkpins     [get_pins  -quiet [remove_from_collection -intersect $clkpins_all [all_fanout -from $cpins -flat -endpoints_only]]]
	set clkports    [get_ports -quiet * -filter "is_clock_network==true"]
	set resetpins   [all_registers -async_pins ]
	append_to_collection clkpins $clkports
	set dash1       [expr ( 22 + $cone_size + $cone_size + $freq_size + $wave_size + $clock_size + $ckgrp_size + ${lpin_len} + $ref_size + ${pin_len})]
	set frmt       "|%6s|%${cone_size}s|%${cone_size}s|%${freq_size}s|%${wave_size}s|%6s|%${clock_size}s|%${ckgrp_size}s|%${lpin_len}s|%${ref_size}s|%-${pin_len}s|"
	set tick "+";set rept "-"
	set line_seperator1 "|[string repeat ${rept} 6]${tick}[string repeat ${rept} ${cone_size}]${tick}[string repeat ${rept} ${cone_size}]${tick}[string repeat ${rept} ${freq_size}]${tick}[string repeat ${rept} ${wave_size}]${tick}[string repeat ${rept} 6]${tick}[string repeat ${rept} ${clock_size} ]${tick}[string repeat ${rept} ${ckgrp_size} ]${tick}[string repeat ${rept} ${lpin_len}]${tick}[string repeat ${rept} ${ref_size} ]${tick}[string repeat ${rept} ${pin_len}]|"
	set tick ".";set rept "_"
	set line_seperator2 "|[string repeat ${rept} 6]${tick}[string repeat ${rept} ${cone_size}]${tick}[string repeat ${rept} ${cone_size}]${tick}[string repeat ${rept} ${freq_size}]${tick}[string repeat ${rept} ${wave_size}]${tick}[string repeat ${rept} 6]${tick}[string repeat ${rept} ${clock_size} ]${tick}[string repeat ${rept} ${ckgrp_size} ]${tick}[string repeat ${rept} ${lpin_len}]${tick}[string repeat ${rept} ${ref_size} ]${tick}[string repeat ${rept} ${pin_len}]|"
	set tick "+";set rept "="
	set line_seperator3 "|[string repeat ${rept} 6]${tick}[string repeat ${rept} ${cone_size}]${tick}[string repeat ${rept} ${cone_size}]${tick}[string repeat ${rept} ${freq_size}]${tick}[string repeat ${rept} ${wave_size}]${tick}[string repeat ${rept} 6]${tick}[string repeat ${rept} ${clock_size} ]${tick}[string repeat ${rept} ${ckgrp_size} ]${tick}[string repeat ${rept} ${lpin_len}]${tick}[string repeat ${rept} ${ref_size} ]${tick}[string repeat ${rept} ${pin_len}]|"

	autodesign_puts_tee $out_p "\n\n"
	autodesign_puts_tee $out_p "+[string repeat "=" ${dash1}]+"
	autodesign_puts_tee $out_p [format |%-${dash1}s| "    Ref Lib Cell Used ($is_p):      [get_attribute -quiet  [get_cells $cell] ref_name]"]
	autodesign_puts_tee $out_p $line_seperator3
	autodesign_puts_tee $out_p [format $frmt "Const" "RstCone" "ClkCone" "Freq/MHz" "PVT/DutyCyc/Div/PhaseDeg/Type" "Dir"  "Clocks" "ClockGroup"  "LibPin" "RefCell" "[string repeat " " ${space1}]Cell Pin[string repeat " " ${space1}]"]
	autodesign_puts_tee $out_p $line_seperator3
	if { [sizeof_collection $cpins] > 0 } {
		catch { set cpins [sort_collection  -dictionary $cpins  {full_name} ] }
	}

	set interface_clks  [get_attribute -quiet  [all_fanin -to $cpins -pin_level 1 -flat]  clocks]
	array unset autodesign_clkgrp
	
	foreach elclk [autodesign_get_clock_group_mapping $interface_clks] {
		set clkx_name [lindex [split $elclk ":"] 0]
		set clkx_grpx [lindex [split $elclk ":"] 1]
		set autodesign_clkgrp($clkx_name) $clkx_grpx
	}

	#parray autodesign_clkgrp
	#return 0
	foreach_in_collection pin $cpins {
	  # Use driver as reference for inputs 
	  set pin_drxs  [all_fanin -to $pin -pin_level 1 -flat ]
	  set pin_drx   $pin 
	  set ref_type  [get_attribute -quiet [get_cells -of_objects [get_pins $pin ]] ref_name]
	  # clk cone filter
	  set allfanout_clk [all_fanout -from $pin -flat -endpoints_only]
	  set size_clkout   [sizeof_collection [remove_from_collection -intersect $allfanout_clk $clkpins]]
	  set size_rstout   [sizeof_collection [remove_from_collection -intersect $allfanout_clk $resetpins]]

	  foreach_in_collection drx $pin_drxs {
      	      if { [get_object_name $drx ] != [get_object_name $pin] } { set pin_drx $drx}
	      #puts "             <DEBUG> Driver: [get_object_name $pin]  -> [get_object_name $drx ]"
          }
	  set use_clock_col [get_attribute -quiet  [get_${is_p} -quiet $pin_drx] clocks] 
	  set use_clock_col [add_to_collection $use_clock_col [get_attribute -quiet  [get_port -quiet $pin_drx] clocks]]
	  #puts "                 <DEBUG> Driver: [get_object_name $pin] <- [get_object_name $pin_drx]"
          if {[sizeof_collection $use_clock_col] != 0} {
	  set no_of_clk [sizeof_collection $use_clock_col]
	  set current_clk 0
	   while { $current_clk < $no_of_clk} {
	      set clocks [lindex [get_object_name $use_clock_col] $current_clk]
	      set clkgrp ""
	      if {  [info exist autodesign_clkgrp($clocks)] } {	
		 set clkgrp $autodesign_clkgrp($clocks)
	      }
	      incr current_clk
	      set  my_period [format "%.3f" [get_attribute -quiet [get_clocks $clocks] period]]
	      set  my_attrc  "M"
	      if { [get_attr [get_clocks $clocks]  is_generated]} {
	      	set  my_attrc  "G"
	      }	
	      set pin_curr [get_object_name [get_${is_p} $pin]]
	      foreach_in_collection src [get_attr [get_clocks $clocks] sources] {
	        if { [get_object_name $src] == $pin_curr} {
		   set  my_attrc  "*${my_attrc}"
	    	}
	      }
	      set my_freq     [format "%0.1f" [expr $ssi_sta_tool_unit_dly/$my_period]]
	      set my_waveform [get_attr [get_clocks $clocks] waveform]
	      set divratio    1
	      if { [get_attr [get_clocks $clocks]  is_generated] } {
	      	 set master_clk [get_attr [get_clocks $clocks] master_clock] 
		 set divratio   [format "%0.0f" [expr  $my_period / [get_attr $master_clk period] ]]
	      }
	      set ph_0_r      [format "%0.0f"  [expr 100*([lindex [lindex $my_waveform 0] 0] - 0)/$my_period]]
	      set ph_r_f      [format "%0.0f"  [expr 100*([lindex [lindex $my_waveform 0] 1] - [lindex [lindex $my_waveform 0 ] 0])/$my_period]]
	      set ph_f_0      [format "%0.0f"  [expr 100*($my_period                         - [lindex [lindex $my_waveform 0]  1])/$my_period]]
	      set phase       [format "%03.0f" [expr 360*([lindex [lindex $my_waveform 0] 0])/$my_period]]
	      set duty        [format "%0.0f"  [expr $ph_r_f]]
	
	      set my_wave     "$XCORNER/${duty}%/Div$divratio/$phase/$my_attrc"
	      set my_pin_name  [get_object_name [get_${is_p} $pin]]
	      set my_lpin_name [lindex [split $my_pin_name "/"] end]

	      if { $current_clk == 1} {
		   autodesign_puts_tee $out_p $line_seperator2
	           autodesign_puts_tee $out_p [format $frmt  "$my_period"  "$size_rstout"  "$size_clkout" "$my_freq/MHz"  "$my_wave"  "$is_x [get_attribute -quiet  [get_${is_p} $pin] ${is_p}_direction]" " $clocks ($my_attrc)"  "$clkgrp" " $my_lpin_name " " $ref_type " " $my_pin_name " ]
	      } else {
	           autodesign_puts_tee $out_p [format $frmt  "$my_period"  "$size_rstout"  "$size_clkout" "$my_freq/MHz"  "$my_wave"  ""                                                                   " $clocks ($my_attrc)"  "$clkgrp" ""  ""        "" ]
	      }
	   }

	   if { $no_of_clk > 0 } {
		   autodesign_puts_tee $out_p $line_seperator2
           }
           
	  } else {
	  set pin_drxs  [all_fanin -to $pin -pin_level 1 -flat ]
	  set pin_drx   $pin 
          foreach_in_collection drx $pin_drxs {
      	      if { [get_object_name $drx ] != [get_object_name $pin] } { set pin_drx $drx}
          }
	 
	  set case_val [autodesign_get_static_val [get_${is_p} $pin_drx]]
          set my_freq  "DataPin"
	  if { $case_val != "" } {
             set my_freq "Static$case_val"
	  } elseif { [get_attribute -quiet  $pin direction] == "in" } {
	     if { $size_clkout > 0 } {
           	set my_freq  "ClkPinMiss"
	     }
	     if { $size_rstout > 0 } {
           	set my_freq  "Rst$my_freq"
	     }
          } else {
	     if { $size_rstout > 0 } {
           	set my_freq  "Rst$my_freq"
	     }
	  } 
	     set my_pin_name  [get_object_name [get_${is_p} $pin]]
	     set my_lpin_name [lindex [split $my_pin_name "/"] end]
	     autodesign_puts_tee $out_p [format $frmt "[autodesign_get_static_val [get_${is_p} $pin_drx]]"  "$size_rstout" "$size_clkout" "$my_freq" "" "$is_x [get_attribute -quiet  [get_${is_p} $pin] ${is_p}_direction]" ""  "" " $my_lpin_name " " $ref_type " " $my_pin_name "]
	  }
	 }
         autodesign_puts_tee $out_p $line_seperator3
	autodesign_puts_tee $out_p "\n\n"
	close $out_p
	puts "\033\[1;34m<OPEN> File :   \033\[1;31m[file normalize $xfile]\033\[0m"
	return [list $XCORNER [file normalize $xfile]] 
}
##------------------------------------------------------------------
## ProcNameEnd    : autodesign_get_block_context
