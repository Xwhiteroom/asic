##------------------------------------------------------------------
## ProcNameStart  : get_clock_latency_post_branch
## ProcArguments  : get_clock_latency_post_branch branch_string
## ProcDependency :  
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc get_clock_latency_post_branch branch_string {
	array unset branch_data 
	global SCENARIO
	if { ! [info exist SCENARIO] } { set SCENARIO "Unknown"}
	set retain_app  [get_app_var timing_report_unconstrained_paths]
        set_app_var timing_report_unconstrained_paths true
	set branch_data(00_base_fanout)  [all_fanout -quiet -from $branch_string -continue_trace generated_clock_source -flat -endpoint]
	#set branch_data(00_xcts_fanout) [all_fanout -quiet -through $branch_string -continue_trace generated_clock_source -flat -endpoint -clock_tree]
        set branch_data(01_base_clksink) [filter_collection $branch_data(00_base_fanout) "is_clock_used_as_clock==true"]
        set branch_data(01_base_nonclk)  [filter_collection $branch_data(00_base_fanout) "is_clock_used_as_clock==false"]

	set branch_data(02_base_pathsmax)   [get_timing_path -delay max -through $branch_string -to $branch_data(01_base_clksink) -max_path [sizeof_collection $branch_data(01_base_clksink)]]
	set branch_data(02_base_pathsmin)   [get_timing_path -delay min -through $branch_string -to $branch_data(01_base_clksink) -max_path [sizeof_collection $branch_data(01_base_clksink)]]
	
	#set branch_data(03_base_arrmax)     [get_attribute $branch_data(02_base_pathsmax) arrival]    	
	#set branch_data(03_base_arrmin)     [get_attribute $branch_data(02_base_pathsmin) arrival]   
 	
        foreach y [list max min ] { 
        	set data        [lsort -real -increasing [get_attribute $branch_data(02_base_paths$y) arrival]]
		set fep         [llength $data]
		if { $fep == 0 } { puts " <Error> : FEP=0, No Valid Sinks Found !" ; return -1 ; }
        	set min         [lindex  $data 0]
        	set max         [lindex  $data end]
        	set sigma1      [lindex  $data [expr int($fep*0.68)]]
        	set sigma2      [lindex  $data [expr int($fep*0.95)]]
        	set sigma3      [lindex  $data [expr int($fep*0.99)]]
		set sum         0.000
		foreach x $data {
			set sum [expr $sum + $x]
		}
		set mean        [expr $sum / $fep]

		set offset      [get_attribute [filter_collection [all_fanin -flat -pin_level 1 -to $branch_string] "direction==out"] ${y}_arrival]
		set branch_data(03_${y}_latfull)     [format "Offset=%03.3f Min=%03.3f Max=%03.3f 1Sigma=%03.3f 2Sigma=%03.3f 3Sigma=%03.3f Mean=%03.3f" $offset $min $max $sigma1 $sigma2 $sigma3 $mean]
		set branch_data(03_${y}_latoffset)   [format "Offset=%03.3f Min=%03.3f Max=%03.3f 1Sigma=%03.3f 2Sigma=%03.3f 3Sigma=%03.3f Mean=%03.3f" [expr $offset - $offset]  [expr $min - $offset]  [expr $max - $offset] [expr $sigma1 - $offset] [expr $sigma2 - $offset] [expr $sigma3 - $offset] [expr $mean - $offset]]
		set branch_data(03_${y}_size)        $fep
	}
        puts ""
	puts "   <INFO>  Branch Point : $branch_string"
	puts "   <INFO>  Scenario     : $SCENARIO"
	puts "   <INFO>  Target       : [lindex $branch_data(03_min_latoffset) 5] to [lindex $branch_data(03_max_latoffset) 5]" 
	puts [format "           | Summary | %-30s | %-20s | %-20s | %-20s | %s " $SCENARIO [lindex $branch_data(03_min_latoffset) 5]  [lindex $branch_data(03_max_latoffset) 5] $branch_data(03_max_size) $branch_string] 

        puts ""
	foreach x [lsort -increasing [array names branch_data]] {
		puts [format "           %-30s  :   %-s" $x $branch_data($x)]
	}
        puts ""
        set_app_var timing_report_unconstrained_paths $retain_app
	return 0
}
##------------------------------------------------------------------
## ProcNameEnd    : get_clock_latency_post_branch
