	    set attrpins  [get_pins -quiet -of_objects $pin_col]	
	    puts "**Info:: Process Collection [sizeof_collection $attrpins] Custom:Col of $size_pins"		
    }   
	report_global_slack   -nosplit  $attrpins > $path
	puts "**Info:: Done  Dumping in $path [date]"

}
