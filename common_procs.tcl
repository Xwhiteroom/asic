##------------------------------------------------------------------
## ProcNameStart  : sta_qual_dump_sdf_vios
## ProcArguments  : sta_qual_dump_sdf_vios outdir MODE CORNER ior
## ProcDependency : quick_timing 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_dump_sdf_vios {outdir MODE CORNER ior} {
	puts "<INFO> :: Create Run Dir : $outdir/$CORNER"
	file mkdir $outdir/$CORNER
        set target_paths [get_timing_path -start_end_type  reg_to_reg  -max_path 2000000 -pba none -delay_type min -slack_less 0]
	puts "<INFO> :: Found R2R Path = [sizeof_collection $target_paths]"
	if { [regexp "i" $ior] } {
        	append_to_collection -unique target_paths [get_timing_path -start_end_type  in_to_reg  -max_path 2000000 -pba none -delay_type min -slack_less 0]
		puts "<INFO> :: Found R2R+I2R Path = [sizeof_collection $target_paths]"
	} 
	if { [regexp "o" $ior] } {
        	#append_to_collection -unique target_paths [get_timing_path -start_end_type  reg_to_out  -max_path 2000000 -pba none -delay_type min -slack_less 0]
		puts "<INFO> :: Found R2R+I2R+R2O Path = [sizeof_collection $target_paths]"
        } 

	puts "<INFO> :: Start Uniquifying Paths = [sizeof_collection $target_paths]"
	array unset slack_profile 
	foreach_in_collection path $target_paths {
		set epin  [get_object_name [get_attr $path endpoint]]
		set slack [get_attr $path slack]
		if { ![info exist slack_profile($epin)]} {
			set slack_profile($epin) [format "%0.3f" $slack]
		} elseif { $slack_profile($epin) > $slack } {
			set slack_profile($epin) [format "%0.3f" $slack]		
		}
	}
	puts "<INFO> :: Done  Uniquifying Paths = [llength [array names slack_profile]]"
	set wns 0
	set tns 0
	set fep [llength [array names slack_profile]]
	set out1 [open "$outdir/$CORNER/$MODE.uniq.index" w+]
	foreach epin [array names slack_profile] {
		puts $out1 "$slack_profile($epin) $epin $MODE.$CORNER" 
		set tns [expr $tns + $slack_profile($epin)]
		if  { $wns > $slack_profile($epin) } { set wns  $slack_profile($epin) }
	}
	close $out1 
        quick_timing none 2000000 0 min 1 r  > $outdir/$CORNER/$MODE.hold_presummary
        quick_timing none 2000000 0 max 1 r  > $outdir/$CORNER/$MODE.setup_presummary
	puts "<INFO> :: Done  Final Paths = $outdir/$CORNER/$MODE.uniq.index"
	puts "<INFO> :: Done  WNS=$wns/TNS=$tns/FEP=$fep"
        echo "cat *uniq.index  > all_annotation.index ;  /home/syiqbal/code/util/uslk.pm -f all_annotation.index -r 1 -gls 1 -x 1 -t hold_padding " > $outdir/$CORNER/run_me_for_annos.bash 
        puts "<INFO> :: Post Anno <CMD> source $outdir/$CORNER/hold_padding_anno.tcl ; quick_timing none 2000000 0 min 1 r  > $outdir/$CORNER/$MODE.hold_postsummary ; quick_timing none 2000000 0 max 1 r  > $outdir/$CORNER/$MODE.setup_postsummary"
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_dump_sdf_vios
