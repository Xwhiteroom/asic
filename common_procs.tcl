##------------------------------------------------------------------
## ProcNameStart  : sta_qual_overclocking_potential
## ProcArguments  : sta_qual_overclocking_potential outputdir clocks max_path slack_less_than pba_gba start_end_type
## ProcDependency :  
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_overclocking_potential {outputdir clocks max_path slack_less_than pba_gba start_end_type} {
    global SCENARIO ssi_sta_tool_unit_dly
    file mkdir $outputdir
    set clocks [get_clocks -quiet $clocks]
    puts "\n"
    set paths_collection [remove_from_collection $clocks $clocks]
    set     pt_tablex_detail       [list ]
    lappend pt_tablex_detail       [list "#Freq/$SCENARIO" "#Freq_Target/$SCENARIO" "#Slack" "#Uncert" "#Margin" "#Period" "#Clocks" "#EndPoint"]
    set     pt_tablex_summary      [list ]
    lappend pt_tablex_summary      [list "#Freq/$SCENARIO" "#Freq_Target/$SCENARIO" "#Slack" "#Uncert" "#Margin" "#Period" "#Clocks" "#FEP" "#TNS"]

    array unset found_freq_fep	
    array unset found_freq_tns
    array unset found_freq_data	

    if { [sizeof_collection $clocks] } {
        puts "<INFO> : [date] PT Path Collection $SCENARIO [get_object_name $clocks] started !"
        puts "                - MaxPath      = $max_path"
        puts "                - SlackLt      = $slack_less_than"
        puts "                - PBAMode      = $pba_gba"
        puts "                - StartEndType = $start_end_type"
        puts "                - SCENARIO     = $SCENARIO"

	puts "\n"
        set paths_collection [get_timing_paths -to $clocks -max_path $max_path -slack_less $slack_less_than -pba_mode $pba_gba -path_type full_clock_expanded -start_end_type $start_end_type]
        puts "<INFO> : [date] PT Path Collection $SCENARIO [get_object_name $clocks] done [sizeof_collection $paths_collection] !\n"
        foreach_in_collection path $paths_collection {
	        #puts "Error0A"
		set norm_dly 1.000 ;
		set uncert 	  [get_attr -quiet $path clock_uncertainty]
       		set slk           [get_attr -quiet $path slack]
            	set norm_slk      [get_attr -quiet $path normalized_slack]
            	set slk_type      [get_attr -quiet $path path_type]
            	set norm_dly      [get_attr -quiet $path normalized_delay]
		set end_clk       [get_attr -quiet $path endpoint_clock]
		set end_point     [get_attr -quiet $path endpoint]
		set margin        [get_attr -quiet $path pmargin]
	        #puts "Error0B"
            	set norm_dly      [get_attr -quiet [get_attr -quiet $path endpoint_clock] period]
            	if { $norm_dly == ""    } { set norm_dly 1.000 ; set norm_slk $slk}
            	if { $norm_slk == ""    } { set norm_slk $slk}
	        #puts "Error0C"
                set Tfreq          [format "%0.3f"   [expr $ssi_sta_tool_unit_dly/($norm_dly)]  ] 
		if { $norm_slk == $slk && $slk == 0 } { 
			set Dfreq	   $Tfreq
		} else {
                	set Dfreq          [format "%0.3f"   [expr $ssi_sta_tool_unit_dly/($slk/$norm_slk - $slk + 0.000)] ] 
		}
	        #puts "Error1"
                #puts [list $Dfreq $Tfreq $slk $uncert $margin  $norm_dly  [get_object_name $end_clk] [get_object_name $end_point] ]
                lappend pt_tablex_detail [list $Dfreq $Tfreq $slk $uncert $margin  $norm_dly  [get_object_name $end_clk] [get_object_name $end_point] ]
	        #puts "Error2"
		set Dfreq [format "%0.0f" $Dfreq]
		if { ![info exist found_freq_fep($Dfreq)] } {
			set found_freq_fep($Dfreq)  1
			set found_freq_tns($Dfreq)  $slk
		} else {
			incr found_freq_fep($Dfreq)
			set found_freq_tns($Dfreq)  [expr $slk + $found_freq_tns($Dfreq)]
		}
	        #puts "Error3"
			set found_freq_data($Dfreq) [list $Dfreq $Tfreq $slk $uncert $margin  $norm_dly  [get_object_name $end_clk] $found_freq_fep($Dfreq) $found_freq_tns($Dfreq) ]
	}

	if { [sizeof_collection $paths_collection] } { 
        	puts "<INFO> : [date] PT Path Collection $SCENARIO Process Done !\n"
        	puts "<INFO> : [date] PT Freq Bins $SCENARIO [llength [array name found_freq_data]] / [lindex [lsort -increasing [array name found_freq_data]] 0] to [lindex [lsort -increasing [array name found_freq_data]] end] !\n" 

    		puts "<INFO> : [date] PT Freq Bins $SCENARIO Summary $outputdir/$SCENARIO.freq.summary.csv !\n"    
    		set out [open $outputdir/$SCENARIO.freq.summary.csv w+]
    		set linex [join [lindex $pt_tablex_summary 0] ","]
    		puts $out $linex	
    		foreach Dfreq [lsort -increasing [array names found_freq_data] ] {
			lappend  pt_tablex_summary $found_freq_data($Dfreq)
			set linex [join $found_freq_data($Dfreq) ","]
			puts $out $linex	
    		}
    		close $out

    		puts "<INFO> : [date] PT Freq Bins $SCENARIO Full $outputdir/$SCENARIO.freq.full.csv !\n"
    		set out [open $outputdir/$SCENARIO.freq.full.csv w+]
    		foreach Dfreq [concat [list [lindex $pt_tablex_detail 0]] [lsort -increasing [lrange $pt_tablex_detail 1 end]]]  {
			set linex [join $Dfreq ","]
			puts $out $linex	
    		}
    		close $out
	} else {
	return "<WARN> : Empty Path Collection Returned !" 
	return -1

	}
    } else {
	return "<ERROR> : Invalid Clock Passed $clocks !" 
	return -1
    }
    return $paths_collection
    #return [list $paths_collection $pt_tablex_detail $pt_tablex_summary]
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_overclocking_potential
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_port_clock_gls
## ProcArguments  : sta_qual_port_clock_gls ports margin
## ProcDependency : sta_qual_sort_clock_gls 
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_port_clock_gls {ports margin} {
        set collection_list [list ]
        set verbose_mode 1 
        foreach_in_collection port [get_ports -quiet $ports] {
                set port [get_object_name $port]
                set clocks "NA,NA"
                set fin_out "0"
                set direction [get_attr -quiet [get_ports -quiet $port ] direction]
                if { $direction == "in"} {
                        set cone [all_fanout -from [get_ports -quiet $port] -endpoints_only -flat]
                        set fin_out [sizeof_collection [get_pins -quiet  [all_fanout -trace_arcs enabled -from $port -pin_level 1  -flat] -filter "direction==in and full_name !=$port"]]
                } elseif {$direction == "out"} {
                        set cone [all_fanin -to [get_ports -quiet $port] -startpoints_only -flat]
                        set fin_out [sizeof_collection [get_pins -quiet  [all_fanin -trace_arcs enabled -to $port -pin_level 1  -flat] -filter "direction==out and full_name !=$port"]]


                } else {
                        set cone    [remove_from_collection [get_port -quiet  $port] [get_port -quiet  $port]]
                        set fin_out "bidi"
                }

                if { [sizeof_collection $cone] > 0 } {
                        set cone [ get_pins -quiet  -of_object [get_cells -quiet  -of_object $cone] -filter "is_clock_pin==true"]
                        set clocks [lindex [sta_qual_sort_clock_gls [get_attr -quiet   $cone clocks] ] 0]
                }

                set period [lindex [split $clocks ","] 0]
                set ckname [lindex [split $clocks ","] 1]

                if { $period == "NA" || $period == "" } { 
                    lappend collection_list "$port,NA,NA,$direction,slack_uncons"
                } else {
                    set max_slack NA
                    #set max_slack [get_attr -quiet [get_ports $port]  max_slack]
                    #echo "$port,$ckname,$period"
                    set budget    [expr $margin*$period]
                    lappend collection_list "$port,$ckname,$budget,$direction,slack:$max_slack"                    
                }
        }
        return $collection_list

}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_port_clock_gls
