	} else {
	    set para_command_log_file_name "parasitics_command.log"
	}

    ## Create Check Timing Directory
	file mkdir $soc_reports_dir
	
	set check_design_summary_file [open $soc_reports_dir/check_design_summary_temp.csv w]
	puts $check_design_summary_file "---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------"
	puts $check_design_summary_file "                                   PT CHECK DESIGN SUMMARY"
	puts $check_design_summary_file "---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------"
	puts $check_design_summary_file [format %-30s%s%-95s%s%-15s%s%-10s%s%7s%5s%5s%5s%5s%5s%5s Warning/Error "-  " "description" "-  " "sta_qc-id" "-  " "pt_msg_id" "-  "  "-  " "Waived" "-  " "Unwaived" "-  "  "-  " "Man_Page_description"]
	puts $check_design_summary_file "---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------"
    ##----------------------------------------------------------------
    ## Warning Messages from LOG File ( PT )
    ##----------------------------------------------------------------
    puts "INFO:: Processing warning messages from log file $log_file_name"
    puts "INFO:: Processing warning messages from log file $para_command_log_file_name"
   

        set desc(LNK-005)                       "Unable to resolve reference to instances"	
        set desc(LNK-043)                       "Black Box in design"	
        set desc(LNK-045)                       "Library cells are unused in library"
        set desc(LNK-006)	                 "Limit exceeded"
        set desc(LNK-044)                        "Limit exceeded"
        set desc(PARA-006)                       "Incomplete RC annotation"	
        set desc(PARA-007)                       "Unconnected hierarchy pin"	
        set desc(PARA-004)                       "Too many nodes, lumped capacitance will be used"	
        set desc(PARA-010)                       "Multiple occurrences of net, removed parasitics"	
        set desc(PARA-162)                       "Coupling capacitor on net is grounded"	
        set desc(PARA-124)                       "Cannot be found in the given design"	
	
    set subcategories [list link_para_issues]
    set sta_qc_id(LNK-005) "SO.TI.1.1"             
    set sta_qc_id(LNK-043) "SO.TI.1.2"
    set sta_qc_id(LNK-045) "SO.TI.1.3"
    set sta_qc_id(LNK-006) "SO.TI.1.4" 
    set sta_qc_id(LNK-044) "SO.TI.1.5" 
    set sta_qc_id(PARA-006) "SO.TI.1.6"
    set sta_qc_id(PARA-007) "SO.TI.1.7"
    set sta_qc_id(PARA-004) "SO.TI.1.8"
    set sta_qc_id(PARA-010) "SO.TI.1.9"
    set sta_qc_id(PARA-162) "SO.TI.1.10"
    set sta_qc_id(PARA-124) "SO.TI.1.11"
     

    set pt_msg_id(link_para_issues) [list LNK-005 LNK-043 LNK-045 LNK-006 LNK-044 PARA-006 PARA-007  PARA-004  PARA-010 PARA-162 PARA-124 ]



	## Generating summary report for addon check timing.
	foreach sub $subcategories {
	    foreach option $pt_msg_id($sub) {
	      ## Generating from log file.
	      if {![regexp "PARA" $option]} {
                  set log_file_read $log_file_name
              } else {
                  set log_file_read $para_command_log_file_name
              }
        	if { [file exist $log_file_read] } {
	         set logfile [open $log_file_read r]
	         set logfile_contents [split [read $logfile] "\n"]
	         close $logfile
    	        } else {
	          puts "WARNING:: Log File- $log_file_read doesn't exist."
	          set logfile_contents ""
	        }
                echo "$option" 
		set num_occur($option) 0
	        set suppressed($option) 0
                set check_design_message_file [open $soc_reports_dir/$option.csv w]
	        puts $check_design_message_file "---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------"
	        puts $check_design_message_file "                                   Description"
	        puts $check_design_message_file "---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------"
	        puts $check_design_message_file                                        $desc($option)
	        puts $check_design_message_file "---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------"
	        puts $check_design_message_file [format %-10s%s%20s%s%30s Location "-  " "status" "-  " "comment"]
	        puts $check_design_message_file "---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------"
	        set total_waived($option) 0
	        set total_unwaived($option) 0
	        if { [file exist $golden_waiver/$option.csv] } {
	            set waiver [open $golden_waiver/$option.csv r]
	            set waivers_list [split [read $waiver] "\n"]
	            close $waiver
	        } else {
	            # puts "WARNING:: Waiver_file -  $pt_msg_id($opt).csv doesn't exist."
	            set waivers_list ""
	        }
	
	        set file [open $soc_reports_dir/$option.temp w]
     	        foreach line $logfile_contents {
	            if {[regexp $option $line] && $option != "PTE-017"} {
	                if {![regexp "default limit.*exceeded.*Remainder will be suppressed" $line]}  {
		                puts $file "$line"
			} elseif {[regexp "default limit.*exceeded.*Remainder will be suppressed" $line]} {
		                puts $file "$line"; break;
                        }
                    }
                }
                close $file

	        set file_pt [open $soc_reports_dir/$option.temp r]
	        set file_lines [split [read $file_pt] "\n"]
	        foreach file_line $file_lines {
	            set status 0
	            if {$file_line != {}  } {
	                if {$file_line == "Clocks" } {
	                } else {
	                    foreach waiver_list $waivers_list {
				echo $waiver_list
	                        if {$waiver_list != {}} {
	                            if {[regexp "\-.*" $waiver_list] || [regexp "                                   Description" $waiver_list] || [regexp "$desc($option)" $waiver_list] || $waiver_list == "---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------"} {
					continue

	                            } else {
					
	                                set waiver_index [lindex [split [regsub -all "\ \ *" $waiver_list "\ "] " "] 0]
					#echo $waiver_index
					
	                                if {[regexp "$waiver_index"  $file_line ]} {
	                                    set status "waived"
					 #echo $waiver_index
	                                    set total_waived($option) [expr {$total_waived($option) + 1}]    
	                                } 
	                            }
	                        }
			 #echo  "$option  $status"
	                    }
                        }

	           	if {$status == 0} {
                            set status "unwaived"
	                        set total_unwaived($option) [expr {$total_unwaived($option) + 1}]
	                 }

	                    set comment $option
	                    set data [format %-10s%s%20s%s%30s $file_line "-  " $status "-  " $comment]
	                    puts $check_design_message_file $data
	            }
	        }
	        close $file_pt
	        close $check_design_message_file
	        file delete $soc_reports_dir/$option.temp   
	        set man12 "no manual_entry"
	        man $option > $soc_reports_dir/man_descr
	        set file_descr [open $soc_reports_dir/man_descr r]
	        set lines_descr [split [read $file_descr] "\n"]
	        close $file_descr
	        set flag1 0
	        foreach line_descr $lines_descr {
	            if {$line_descr != {}} {
	                if {[regexp "WHAT NEXT" $line_descr] || [regexp "Error:" $line_descr] } {
	                    break
	                }
	                if { $flag1 == 1 } {
	                    set man12  [concat $man12 $line_descr]
	                }
	                if {[regexp "DESCRIPTION" $line_descr]} {
	                    set flag1 1
	                    set man12 {}
	                } 
	            }
	        }
	        set message_id $sta_qc_id($option)
	        set pt_id $option
	        set waived $total_waived($option)
                set unwaived  $total_unwaived($option)
	        echo $option
	        set str [format %-30s%s%-95s%s%-15s%s%-10s%s%7s%5s%5s%5s%5s%5s%5s $sub "-  " $desc($option) "-  " "$message_id" "-  " "$pt_id" "-  "  "-  " $waived  "-  " $unwaived "-  " "-  " $man12]		
	        set message_id {}
	        set pt_id {}
	        #set sub {}
	        echo $str
	        puts $check_design_summary_file $str
	        file delete $soc_reports_dir/man_descr 
	    }
    }	


	close $check_design_summary_file
	sh cat $soc_reports_dir/check_design_summary_temp.csv | grep -v "\\-  0"  > $soc_reports_dir/check_design_summary.csv
        set sh_message_limit "1000"
	report_annotated_parasitics  > $soc_reports_dir/report_annotated_parasitics.rpt

	set infile [open $soc_reports_dir/report_annotated_parasitics.rpt r]
	set lines [split [read $infile] "\n"]
	close $infile
        set unannotated 0
	foreach line [lreverse $lines] {
         ##puts "Line: $line"
          if {[regexp ".*\|.*\|.*" $line]} {
             if {[llength [split $line "\|"]] > 3} {
                set lsplit [split $line "\|"]
                set lnum [llength $lsplit]
                set unannotated [lindex $lsplit [expr $lnum -2]]
            ##     puts "Unanno: $unannotated"
                 break;
             }
	  } else {
          }
        }
        if {$unannotated > 0} {
           puts "Unannotated Nets : $unannotated"
            report_annotated_parasitics -list_not_annotated -max_nets $unannotated > $soc_reports_dir/report_unannotated_nets.rpt
        }
    puts "INFO:: Please check file for Check Timing Summary- $soc_reports_dir/check_design_summary.csv"
    puts "INFO:: Please check file for Check Timing Summary- $soc_reports_dir/report_annotated_parasitics.rpt"

	file delete $soc_reports_dir/check_design_summary_temp.csv
	file delete $soc_reports_dir/man_desc
}
