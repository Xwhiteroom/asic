##------------------------------------------------------------------
## ProcNameStart  : get_clock_stage_delay
## ProcArguments  : get_clock_stage_delay source_collection intermediate_points view outdir
## ProcDependency : get_ck_pin_lat 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc get_clock_stage_delay {source_collection intermediate_points view outdir} {
    array unset data_array

    file mkdir $outdir
    set xfile "$outdir/clock_stage.$view.csv"

    set all_fanout  [get_pins -quiet  [all_fanout -quiet -from $source_collection -endpoints_only -flat] -filter "is_clock_network==true and is_clock_pin==true"]

    set printdata "#VIEW,#PIN,#CLOCK,#LATENCY"
    foreach inter $intermediate_points {
        set point [lindex [split $inter ":"] 0]
        set xalias [lindex [split $inter ":"] 1]
        set printdata "$printdata,#$xalias"
    }

    set i 0    
    set data_array("#PIN") $printdata
    #echo "$printdata" > $yfile
    puts "          -- start fanout trace [sizeof_collection $all_fanout] [date]"   
    foreach_in_collection pin $all_fanout {
    #foreach_in_collection pin $all_fanout {}
        incr i
        set pin_name  [get_object_name $pin]
        set ck_data   [get_ck_pin_lat $pin]
        set pin_clock [lindex $ck_data 8] 
        set data      "[lindex $ck_data 11] [lindex $ck_data 12] [lindex $ck_data 14] [lindex $ck_data 15]"
        regsub -all {NA} $data {} data
        #regsub -all {\s\+} $data {} data
        set latency   [lsort -uniq -increasing [split $data " " ]]
        set latmax    [lindex $latency end]
        set printdata "$view,$pin_name,$pin_clock,$latmax"
        foreach inter $intermediate_points {
            set point               [lindex [split $inter ":"] 0]
            set xalias              [lindex [split $inter ":"] 1]
            set mapx($xalias)       0
            set total_stage [sizeof_collection [all_fanin -quiet  -to $pin -from $point -flat -only_cells]]
            set printdata "$printdata,$total_stage" ;#xalias"
        }
        #echo "$printdata"  >> $yfile
        set data_array($pin_name) $printdata
        if { [regexp  "00000" $i]}  { puts "          -- processed $i / [sizeof_collection $all_fanout] [date]" ;}
    }
    puts "          -- processed $i [date]" 
    puts "          -- done   fanout trace [date]"   
    set out [open $xfile w+]
    foreach data [array names data_array] {
        puts $out "$data_array($data)"
    }
    puts "          -- complete file write [date]"  
    close $out    
    puts "** Open File :: [file normalize $outdir]"
}
##------------------------------------------------------------------
## ProcNameEnd    : get_clock_stage_delay
