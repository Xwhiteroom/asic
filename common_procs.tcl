proc get_put_color {start_digit end_digit} {
	set counter $start_digit
	while { $counter <= $end_digit } {
		puts "    <INFO_CODE=$counter> \033\[1;${counter}m \\033\\\[1;${counter}m   \033\[1;0m"
		incr counter
	}
}
