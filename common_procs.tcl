##------------------------------------------------------------------
## ProcNameStart  : sta_qc_get_session_file
## ProcArguments  : sta_qc_get_session_file dir
## ProcDependency : sh 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qc_get_session_file dir {
    global MODE CORNER link_library NETLISTS SDC_FILE  SPEF_TOP SPEF_SUBS
	set design [get_object_name [current_design]]
        set TOP_DESIGN $design
        file mkdir $dir 

        set dir       [file normalize $dir]


        # Settings
        puts "Writing Settings File ....[date]"        
	set app_var_file   "$dir/settings.${TOP_DESIGN}.${MODE}.${CORNER}.tcl"        
        write_app_var -all  -output $app_var_file

        # Libs/DB
        puts "Writing lib_db File ....[date]"        
	set lib_db_file   "$dir/library.${TOP_DESIGN}.${MODE}.${CORNER}.tcl"  

	echo "set LIBS_DB \[list \\" > $lib_db_file
        foreach lib_db $link_library {
            echo "$lib_db \\" >> $lib_db_file
	}
	echo "\]"  >> $lib_db_file

	echo  "read_db \$LIBS_DB"  >> $lib_db_file

        #Verilog
	set net_file   "$dir/verilog.${TOP_DESIGN}.${MODE}.${CORNER}.tcl"
        puts "Writing Verilog File ....[date]"        
        foreach gv $NETLISTS { 
            echo "$gv" >> $net_file 
            puts "Copying verilog File $gv....[date]"                    
            sh cp $gv $dir/.
        }
        echo "# Verilog used for this Run :" > $net_file
	regsub -all {\n} $NETLISTS {} NETLISTS
	echo  "read_verilog { $NETLISTS }" >>  $net_file



        # SDC Derate
        puts "Writing Constraint File ....[date]"        
	set script_file   "$dir/constraints.${TOP_DESIGN}.${MODE}.${CORNER}.tcl"        
        write_script -nos -format ptsh -output $script_file


        # RC File
	set rc_file   "$dir/parasitics.${TOP_DESIGN}.${MODE}.${CORNER}.tcl"
        echo "set TOP_SPEF    $SPEF_TOP"  > $rc_file
        echo "set BLOCK_SPEFS $SPEF_SUBS" >> $rc_file
        foreach spef $SPEF_TOP {
            echo "read_parasitics -keep_capacitive_coupling $spef" >> $rc_file
        }
        set index 0
        set iters [expr [llength $SPEF_SUBS]/6]
        while { $iters > 0} {
            set inst [lindex $SPEF_SUBS $index];incr index
            set spef [lindex $SPEF_SUBS $index];incr index
            set xcor [lindex $SPEF_SUBS $index];incr index
            set ycor [lindex $SPEF_SUBS $index];incr index
            set rota [lindex $SPEF_SUBS $index];incr index
            set flip [lindex $SPEF_SUBS $index];incr index
            set extra ""
            if { $rota != "NONE" } { set extra "$extra -rotation  $rota"}
            if { $flip != "NONE" } { set extra "$extra -axis_flip $flip"}
            echo "read_parasitics -keep_capacitive_coupling -path $inst -x_offset $xcor -y_offset $ycor $extra $spef" >> $rc_file
            set iters [expr $iters -1]
        }
        




        # Run Dot TCL
	set outfile   "$dir/run.${TOP_DESIGN}.${MODE}.${CORNER}.tcl"
	write_app_var -output $outfile
	set fho [open  $outfile a]
	puts $fho "\n\n\n"
	puts $fho "catch { source  /edascratch/user/sshakir/whi-master/flow_control/scripts/procs/tool.rc }"
	puts $fho "echo \"Done setting globals\""
	puts $fho "\n\n"
	puts $fho "## PVT"
	puts $fho "set MODE \"$MODE\""
	puts $fho "set CORNER \"$CORNER\""
	
	puts $fho "\n\n"
	puts $fho "## Reading app_var"
	puts $fho "source $app_var_file"


	puts $fho "\n\n"
	puts $fho "## Library linking"
        puts $fho "source $lib_db_file"
	puts $fho "set LIBS_DB \[list \\"
	

	puts $fho "\n\n"
	puts $fho "## Reading verilog"
	puts $fho "source $net_file"

	puts $fho "\n\n"
	puts $fho "current_design ${design}"
	puts $fho "link_design"
		

	puts $fho "\n\n"
	puts $fho "## Reading SDC"
	puts $fho "source $script_file"

	puts $fho "\n\n"
	puts $fho "## Reading RC"
	puts $fho "source $rc_file"

	puts $fho "\n\n"
	puts $fho "## Final Timing Update"
	puts $fho "set_propagated_clock \[all_clocks\]"
	puts $fho "update_timing -full"
    
	close $fho

	puts "Open : $dir"
        sh tree $dir




}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qc_get_session_file
