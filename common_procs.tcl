## ProcNameStart  : sta_qual_get_hfn_nets
## ProcArguments  : sta_qual_get_hfn_nets hfn_threshold
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_get_hfn_nets hfn_threshold {
        global synopsys_program_name pt_shell_mode
	set ALL_NETS  [get_nets -hier * -top_net]
        echo "## Get HFN: hfn_threshold=$hfn_threshold" > ./info_hfn_objects.rpt
	foreach_in_collection net $ALL_NETS {
	  set net_pins [all_connected $net -leaf]
	  if {[sizeof $net_pins] < $hfn_threshold } {
	    continue;
	  }
	  set net_name [get_object_name $net]

	  foreach_in_collection pin $net_pins {
	    if {[filter_collection  $pin "direction==out"] > 0} {
	      set pin_name	[get_object_name $pin]
	      echo "$net_name ([sizeof $net_pins])"  >> ./info_hfn_objects.rpt
	    }
	  }
	}
}
