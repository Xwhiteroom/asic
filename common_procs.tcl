##------------------------------------------------------------------
## ProcNameStart  : sta_qual_sort_clock_gls
## ProcArguments  : sta_qual_sort_clock_gls clocks
## ProcDependency :  
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_sort_clock_gls clocks {
        set clocks [get_clocks $clocks]
        set listx [list]
        foreach_in_collection clk $clocks {
                if { [sizeof_collection [get_attr -quiet $clk sources]] > 0 && [get_attr -quiet $clk is_generated] == false} {
                        lappend listx "[get_attr -quiet $clk period],[get_object_name $clk]"
                }
        }
        set listx [lsort -increasing $listx]
        return $listx
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_sort_clock_gls
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_source
## ProcArguments  : sta_qual_source xfile args
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_source {xfile args} {
    file mkdir sdc_log
    set base [lindex [split $xfile "/"] end]
    if { [file exist $xfile ] } {
       puts "**STA_SDC_INFO:  File: source  $xfile"
       if { [lindex $args 0] == "verbose"} {
           redirect -file sdc_log/LOG.$base -tee  { source -verbose $xfile }
       } else {
           redirect -file sdc_log/LOG.$base -tee  { source  $xfile }
       }
    } else {
       puts "**STA_SDC_WARN:  File: missing $xfile"
    }
    puts "**STA_SDC_INFO:  Log File: sdc_log/LOG.$base"

}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_source
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_sram_bira
## ProcArguments  : sta_qual_sram_bira cells
## ProcDependency : sort_clocks 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_sram_bira cells {

    set srams [get_cells $cells]
    set xfile "[pwd]/sram_lassen_data.csv"
    set out [open $xfile w+]
    puts $out "#Block,#Clock,#Ref_Cell,#Capacity,#Depth,#Word,#Area,#cell"
    foreach_in_collection sram $srams {
        set ref_name [get_attribute $sram ref_name]
        set ref_area [get_attribute $sram area]

        set cell_name [get_object_name $sram]
        set sram_depth $ref_name
        set sram_word  $ref_name
        #ln04lpe_mc_rf1rwp_hsr_lvt_128x72m2b1c1
        regsub -all {.*x} $sram_word {} sram_word
        regsub -all {m.*} $sram_word {} sram_word
        regsub -all {.*[a-z]|.*[A-Z]|.*_} $sram_word {} sram_word

        regsub -all {x.*} $sram_depth {} sram_depth
        regsub -all {.*_} $sram_depth {} sram_depth
        regsub -all {.*[a-z]|.*[A-Z]|.*_} $sram_depth {} sram_depth

        set capacity "0"
        catch { set capacity [expr $sram_word * $sram_depth] }
        set clockx [lindex [split [lindex [sort_clocks [get_attr -quiet [get_pins -of_objects $sram ] clocks]] 0] ","] 1]
        puts $out ",$clockx,$ref_name,$capacity,$sram_depth,$sram_word,$ref_area,$cell_name"


    }
    close $out
    puts "**Info : Open $xfile"
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_sram_bira
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_update_inter_clock_uncertainty
## ProcArguments  : sta_qual_update_inter_clock_uncertainty 
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_update_inter_clock_uncertainty {} {

  global CONS_DIR XDESIGN XCORNER
  global sta_qual_clock_map sta_qual_clock_jitter sta_qual_clock_jitter_exclude sta_qual_soc_clock_jitter sta_qual_clock_to_hier_map sta_qual_sswrp_hier_map sta_qual_sswrp_soc_map sta_qual_soc_name_map sta_qual_partition_hier_map

  if {[sizeof_collection [get_clocks -quiet *]] == 1} {
      puts "STA_SDC_WARN: Skip setting inter-clock uncertainty as only one clock is present in the design"
  } else {
      puts "STA_SDC_INFO: Updating inter-clock uncertainties in the design"

      set all_hiers [array names sta_qual_soc_clock_jitter]
      if { [info exists sta_qual_partition_hier_map($XDESIGN)] } {
          set sswrp_module $sta_qual_partition_hier_map($XDESIGN)
      } elseif { [info exists sta_qual_sswrp_soc_map($XDESIGN)] } {
          set sswrp_module $sta_qual_sswrp_soc_map($XDESIGN)
      } else {
          set sswrp_module [lsearch -inline $all_hiers *\/u_${XDESIGN}]
      }
      #the worst case jitter (per-corner) for every sswrp
      set corner_list [list UUD SUD UD NM]
      set clk_jitter_map_val [lindex $sta_qual_soc_clock_jitter($sswrp_module) [lsearch $corner_list [lindex [split $XCORNER "_"] 0]]]
      set clk_dcd_map_val [lindex $sta_qual_soc_clock_jitter($sswrp_module) [expr [lsearch $corner_list [lindex [split $XCORNER "_"] 0]] + [lsearch $corner_list [lindex [split $XCORNER "_"] 0]] + 1]]

      set status 1
      if { [file exists ./${XDESIGN}_inter_clock_uncertainty.tcl] } {
          puts "**STA_SDC_INFO: Clock inter clock uncertainty file already exists! Moving this to ./${XDESIGN}_inter_clock_uncertainty.backup.tcl"
          file rename -force ./${XDESIGN}_inter_clock_uncertainty.tcl ./${XDESIGN}_inter_clock_uncertainty.backup.tcl
      }
      if { [catch {open ./${XDESIGN}_inter_clock_uncertainty.tcl "w"} jitter_fp] } {
          puts "**STA_SDC_ERROR: Cannot open clock inter clock uncertainty file for write!\n"
          set status 0
      } else { 
          puts "**STA_SDC_INFO: Setting clock inter clock uncertainty file to ./${XDESIGN}_inter_clock_uncertainty.tcl\n"
      }

      if { $status == 1 } {

        set all_clocks_coll [get_clocks -quiet *]
        set slow_clocks_coll [get_clocks -quiet * -filter "period>5"]
        set fast_clocks_coll [remove_from_collection $all_clocks_coll $slow_clocks_coll]
        set no_gspan_slow_clocks_coll_revised $slow_clocks_coll
        set no_gspan_fast_clocks_coll_revised $fast_clocks_coll
        set gspan_clocks_coll [get_clocks -quiet -filter "full_name=~*GSPAN* || full_name=~*_SS_*"]
        set all_non_gspan_clocks_coll [remove_from_collection $all_clocks_coll $gspan_clocks_coll]
        foreach_in_collection clk $gspan_clocks_coll {
            set clk_name [get_object_name $clk]
            if { [sizeof_collection [get_clocks $clk_name]] > 0 } {
                if { [sizeof_collection [filter_collection $slow_clocks_coll full_name=~$clk_name]] == 1 } {
                    set no_gspan_slow_clocks_coll_revised [remove_from_collection $no_gspan_slow_clocks_coll_revised $clk]
                }
                if { [sizeof_collection [filter_collection $fast_clocks_coll full_name=~$clk_name]] == 1 } {
                    set no_gspan_fast_clocks_coll_revised [remove_from_collection $no_gspan_fast_clocks_coll_revised $clk]
                }
            }
        }

        puts $jitter_fp "#----------------------------------------------------------------"
        puts $jitter_fp "#List of non-gspan slow clocks (no_gspan_slow_clocks_coll_revised)"
        puts $jitter_fp "#----------------------------------------------------------------\n"
        foreach_in_collection clk $no_gspan_slow_clocks_coll_revised {
            puts $jitter_fp "#[get_object_name $clk]"
        }
        puts $jitter_fp "\n#----------------------------------------------------------------"
        puts $jitter_fp "#List of non-gspan fast clocks (no_gspan_fast_clocks_coll_revised)"
        puts $jitter_fp "#----------------------------------------------------------------\n"
        foreach_in_collection clk $no_gspan_fast_clocks_coll_revised {
            puts $jitter_fp "#[get_object_name $clk]"
        }

        set jitter_override_clocks [array names sta_qual_clock_jitter]
        set no_gspan_jitter_override_clocks [list ]
        set no_gspan_jitter_override_slow_clocks [list ]
        set no_gspan_jitter_override_fast_clocks [list ]
        foreach clk $jitter_override_clocks {
            if { [sizeof_collection [get_clocks -quiet $clk]] == 1 } {
                if { ![regexp {.*GSPAN.*|.*_SS_.*} $clk]} {
                    lappend no_gspan_jitter_override_clocks $clk
                    if { [get_attribute [get_clocks $clk] period] > 5 } {
                        lappend no_gspan_jitter_override_slow_clocks $clk
                    } else {
                        lappend no_gspan_jitter_override_fast_clocks $clk
                    }
                }
            }
        }

        puts $jitter_fp "\n#-----------------------------------------------------------------------------------------"
        puts $jitter_fp "#List of non-gspan slow clocks with jitter override (no_gspan_jitter_override_slow_clocks)"
        puts $jitter_fp "#-----------------------------------------------------------------------------------------\n"
        foreach clk $no_gspan_jitter_override_slow_clocks {
            puts $jitter_fp "#$clk"
        }
        puts $jitter_fp "\n#-----------------------------------------------------------------------------------------"
        puts $jitter_fp "#List of non-gspan fast clocks with jitter override (no_gspan_jitter_override_fast_clocks)"
        puts $jitter_fp "#-----------------------------------------------------------------------------------------\n"
        foreach clk $no_gspan_jitter_override_fast_clocks {
            puts $jitter_fp "#$clk"
        }

        #inter-clock uncertainty for fast clocks based on jitter_map.tcl data
        puts $jitter_fp "\n#-----------------------"
        puts $jitter_fp "#INTER-CLOCK UNCERTAINTIES"
        puts $jitter_fp "#-------------------------\n"
        set clk_jitter_map_val_ns [expr $clk_jitter_map_val*0.001]
        set clk_dcd_map_val_ns [expr $clk_dcd_map_val*0.001]

        puts $jitter_fp "set_clock_uncertainty $clk_jitter_map_val_ns -setup -rise_from \[get_clocks -quiet \$\{no_gspan_fast_clocks_coll_revised\}\] -rise_to \[get_clocks -quiet \$\{no_gspan_fast_clocks_coll_revised\}\]"
        puts $jitter_fp "set_clock_uncertainty $clk_jitter_map_val_ns -setup -fall_from \[get_clocks -quiet \$\{no_gspan_fast_clocks_coll_revised\}\] -fall_to \[get_clocks -quiet \$\{no_gspan_fast_clocks_coll_revised\}\]"
        puts $jitter_fp "set_clock_uncertainty $clk_dcd_map_val_ns -setup -rise_from \[get_clocks -quiet \$\{no_gspan_fast_clocks_coll_revised\}\] -fall_to \[get_clocks -quiet \$\{no_gspan_fast_clocks_coll_revised\}\]"
        puts $jitter_fp "set_clock_uncertainty $clk_dcd_map_val_ns -setup -fall_from \[get_clocks -quiet \$\{no_gspan_fast_clocks_coll_revised\}\] -rise_to \[get_clocks -quiet \$\{no_gspan_fast_clocks_coll_revised\}\]"

        set clk_count 0
        foreach clk $no_gspan_jitter_override_fast_clocks {
            set all_override_minus_clk($clk_count) [lreplace $no_gspan_jitter_override_fast_clocks [lsearch $no_gspan_jitter_override_fast_clocks $clk] [lsearch $no_gspan_jitter_override_fast_clocks $clk]]
            set all_minus_clk($clk_count) [remove_from_collection $no_gspan_fast_clocks_coll_revised $clk]
            foreach clk2 $all_override_minus_clk($clk_count) {
                if { [lindex $sta_qual_clock_jitter($clk2) [lsearch $corner_list [lindex [split $XCORNER "_"] 0]]] >= [lindex $sta_qual_clock_jitter($clk) [lsearch $corner_list [lindex [split $XCORNER "_"] 0]]] } {
                    set max_jitter [lindex $sta_qual_clock_jitter($clk2) [lsearch $corner_list [lindex [split $XCORNER "_"] 0]]]
                } else {
                    set max_jitter [lindex $sta_qual_clock_jitter($clk) [lsearch $corner_list [lindex [split $XCORNER "_"] 0]]]
                }
                if { [lindex $sta_qual_clock_jitter($clk2) [expr [lsearch $corner_list [lindex [split $XCORNER "_"] 0]] + [lsearch $corner_list [lindex [split $XCORNER "_"] 0]] + 1]] >= [lindex $sta_qual_clock_jitter($clk) [expr [lsearch $corner_list [lindex [split $XCORNER "_"] 0]] + [lsearch $corner_list [lindex [split $XCORNER "_"] 0]] + 1]] } {
                    set max_dcd [lindex $sta_qual_clock_jitter($clk2) [expr [lsearch $corner_list [lindex [split $XCORNER "_"] 0]] + [lsearch $corner_list [lindex [split $XCORNER "_"] 0]] + 1]]
                } else {
                    set max_dcd [lindex $sta_qual_clock_jitter($clk) [expr [lsearch $corner_list [lindex [split $XCORNER "_"] 0]] + [lsearch $corner_list [lindex [split $XCORNER "_"] 0]] + 1]]
                }
                set max_jitter_ns [expr $max_jitter*0.001]
                set max_dcd_ns [expr $max_dcd*0.001]
                puts $jitter_fp "set all_override_minus_clk($clk_count) \[lreplace \$no_gspan_jitter_override_fast_clocks \[lsearch \$no_gspan_jitter_override_fast_clocks $clk\] \[lsearch \$no_gspan_jitter_override_fast_clocks $clk\]\]"
                puts $jitter_fp "set_clock_uncertainty $max_jitter_ns -setup -rise_from \[get_clocks -quiet \$\{all_override_minus_clk\($clk_count\)\}\] -rise_to \[get_clocks -quiet $clk\]"
                puts $jitter_fp "set_clock_uncertainty $max_jitter_ns -setup -fall_from \[get_clocks -quiet \$\{all_override_minus_clk\($clk_count\)\}\] -fall_to \[get_clocks -quiet $clk\]"
                puts $jitter_fp "set_clock_uncertainty $max_dcd_ns -setup -rise_from \[get_clocks -quiet \$\{all_override_minus_clk\($clk_count\)\}\] -fall_to \[get_clocks -quiet $clk\]"
                puts $jitter_fp "set_clock_uncertainty $max_dcd_ns -setup -fall_from \[get_clocks -quiet \$\{all_override_minus_clk\($clk_count\)\}\] -rise_to \[get_clocks -quiet $clk\]"
                puts $jitter_fp "set_clock_uncertainty $max_jitter_ns -setup -rise_from \[get_clocks -quiet $clk\] -rise_to \[get_clocks -quiet \$\{all_override_minus_clk\($clk_count\)\}\]"
                puts $jitter_fp "set_clock_uncertainty $max_jitter_ns -setup -fall_from \[get_clocks -quiet $clk\] -fall_to \[get_clocks -quiet \$\{all_override_minus_clk\($clk_count\)\}\]"
                puts $jitter_fp "set_clock_uncertainty $max_dcd_ns -setup -rise_from \[get_clocks -quiet $clk\] -fall_to \[get_clocks -quiet \$\{all_override_minus_clk\($clk_count\)\}\]"
                puts $jitter_fp "set_clock_uncertainty $max_dcd_ns -setup -fall_from \[get_clocks -quiet $clk\] -rise_to \[get_clocks -quiet \$\{all_override_minus_clk\($clk_count\)\}\]"
            }
            if { $clk_jitter_map_val >= [lindex $sta_qual_clock_jitter($clk) [lsearch $corner_list [lindex [split $XCORNER "_"] 0]]] } {
                set max_jitter $clk_jitter_map_val
            } else {
                set max_jitter [lindex $sta_qual_clock_jitter($clk) [lsearch $corner_list [lindex [split $XCORNER "_"] 0]]]
            }
            if { $clk_jitter_map_val >= [lindex $sta_qual_clock_jitter($clk) [expr [lsearch $corner_list [lindex [split $XCORNER "_"] 0]] + [lsearch $corner_list [lindex [split $XCORNER "_"] 0]] + 1]] } {
                set max_dcd $clk_jitter_map_val
            } else {
                set max_dcd [lindex $sta_qual_clock_jitter($clk) [expr [lsearch $corner_list [lindex [split $XCORNER "_"] 0]] + [lsearch $corner_list [lindex [split $XCORNER "_"] 0]] + 1]]
            }
            set max_jitter_ns [expr $max_jitter*0.001]
            set max_dcd_ns [expr $max_dcd*0.001]
            puts $jitter_fp "set all_minus_clk($clk_count) \[remove_from_collection \$no_gspan_fast_clocks_coll_revised $clk\]"
            puts $jitter_fp "set_clock_uncertainty $max_jitter_ns -setup -rise_from \[get_clocks -quiet \$\{all_minus_clk\($clk_count\)\}\] -rise_to \[get_clocks -quiet $clk\]"
            puts $jitter_fp "set_clock_uncertainty $max_dcd_ns -setup -fall_from \[get_clocks -quiet \$\{all_minus_clk\($clk_count\)\}\] -rise_to \[get_clocks -quiet $clk\]"
            puts $jitter_fp "set_clock_uncertainty $max_jitter_ns -setup -rise_from \[get_clocks -quiet $clk\] -rise_to \[get_clocks -quiet \$\{all_minus_clk\($clk_count\)\}\]"
            puts $jitter_fp "set_clock_uncertainty $max_jitter_ns -setup -fall_from \[get_clocks -quiet $clk\] -fall_to \[get_clocks -quiet \$\{all_minus_clk\($clk_count\)\}\]"
            puts $jitter_fp "set_clock_uncertainty $max_dcd_ns -setup -rise_from \[get_clocks -quiet $clk\] -fall_to \[get_clocks -quiet \$\{all_minus_clk\($clk_count\)\}\]"
            puts $jitter_fp "set_clock_uncertainty $max_dcd_ns -setup -fall_from \[get_clocks -quiet $clk\] -rise_to \[get_clocks -quiet \$\{all_minus_clk\($clk_count\)\}\]"
            incr clk_count
        }

        #inter-clock uncertainty for slow<->fast clocks based on jitter_map.tcl data - use fast clk uncertainty

        #for non-override slow<->fast clocks
        puts $jitter_fp "set_clock_uncertainty $clk_jitter_map_val_ns -setup -rise_from \[get_clocks -quiet \$\{no_gspan_slow_clocks_coll_revised\}\] -rise_to \[get_clocks -quiet \$\{no_gspan_fast_clocks_coll_revised\}\]"
        puts $jitter_fp "set_clock_uncertainty $clk_jitter_map_val_ns -setup -rise_from \[get_clocks -quiet \$\{no_gspan_fast_clocks_coll_revised\}\] -rise_to \[get_clocks -quiet \$\{no_gspan_slow_clocks_coll_revised\}\]"
        puts $jitter_fp "set_clock_uncertainty $clk_jitter_map_val_ns -setup -fall_from \[get_clocks -quiet \$\{no_gspan_slow_clocks_coll_revised\}\] -fall_to \[get_clocks -quiet \$\{no_gspan_fast_clocks_coll_revised\}\]"
        puts $jitter_fp "set_clock_uncertainty $clk_jitter_map_val_ns -setup -fall_from \[get_clocks -quiet \$\{no_gspan_fast_clocks_coll_revised\}\] -fall_to \[get_clocks -quiet \$\{no_gspan_slow_clocks_coll_revised\}\]"
        puts $jitter_fp "set_clock_uncertainty $clk_dcd_map_val_ns -setup -rise_from \[get_clocks -quiet \$\{no_gspan_slow_clocks_coll_revised\}\] -fall_to \[get_clocks -quiet \$\{no_gspan_fast_clocks_coll_revised\}\]"
        puts $jitter_fp "set_clock_uncertainty $clk_dcd_map_val_ns -setup -rise_from \[get_clocks -quiet \$\{no_gspan_fast_clocks_coll_revised\}\] -fall_to \[get_clocks -quiet \$\{no_gspan_slow_clocks_coll_revised\}\]"
        puts $jitter_fp "set_clock_uncertainty $clk_dcd_map_val_ns -setup -fall_from \[get_clocks -quiet \$\{no_gspan_slow_clocks_coll_revised\}\] -rise_to \[get_clocks -quiet \$\{no_gspan_fast_clocks_coll_revised\}\]"
        puts $jitter_fp "set_clock_uncertainty $clk_dcd_map_val_ns -setup -fall_from \[get_clocks -quiet \$\{no_gspan_fast_clocks_coll_revised\}\] -rise_to \[get_clocks -quiet \$\{no_gspan_slow_clocks_coll_revised\}\]"

        #for override slow<->fast clocks
        foreach clk $no_gspan_jitter_override_fast_clocks {
            set jitter_val [lindex $sta_qual_clock_jitter($clk) [lsearch $corner_list [lindex [split $XCORNER "_"] 0]]]
            set dcd_val [lindex $sta_qual_clock_jitter($clk) [expr [lsearch $corner_list [lindex [split $XCORNER "_"] 0]] + [lsearch $corner_list [lindex [split $XCORNER "_"] 0]] + 1]]
            set jitter_val_ns [expr $jitter_val*0.001]
            set dcd_val_ns [expr $dcd_val*0.001]

            puts $jitter_fp "set_clock_uncertainty $jitter_val_ns -setup -rise_from \[get_clocks -quiet \$\{no_gspan_jitter_override_fast_clocks\}\] -rise_to \[get_clocks -quiet \$\{no_gspan_slow_clocks_coll_revised\}\]"
            puts $jitter_fp "set_clock_uncertainty $jitter_val_ns -setup -rise_from \[get_clocks -quiet \$\{no_gspan_slow_clocks_coll_revised\}\] -rise_to \[get_clocks -quiet \$\{no_gspan_jitter_override_fast_clocks\}\]"
            puts $jitter_fp "set_clock_uncertainty $jitter_val_ns -setup -fall_from \[get_clocks -quiet \$\{no_gspan_jitter_override_fast_clocks\}\] -fall_to \[get_clocks -quiet \$\{no_gspan_slow_clocks_coll_revised\}\]"
            puts $jitter_fp "set_clock_uncertainty $jitter_val_ns -setup -fall_from \[get_clocks -quiet \$\{no_gspan_slow_clocks_coll_revised\}\] -fall_to \[get_clocks -quiet \$\{no_gspan_jitter_override_fast_clocks\}\]"
            puts $jitter_fp "set_clock_uncertainty $dcd_val_ns -setup -rise_from \[get_clocks -quiet \$\{no_gspan_jitter_override_fast_clocks\}\] -fall_to \[get_clocks -quiet \$\{no_gspan_slow_clocks_coll_revised\}\]"
            puts $jitter_fp "set_clock_uncertainty $dcd_val_ns -setup -rise_from \[get_clocks -quiet \$\{no_gspan_slow_clocks_coll_revised\}\] -fall_to \[get_clocks -quiet \$\{no_gspan_jitter_override_fast_clocks\}\]"
            puts $jitter_fp "set_clock_uncertainty $dcd_val_ns -setup -fall_from \[get_clocks -quiet \$\{no_gspan_jitter_override_fast_clocks\}\] -rise_to \[get_clocks -quiet \$\{no_gspan_slow_clocks_coll_revised\}\]"
            puts $jitter_fp "set_clock_uncertainty $dcd_val_ns -setup -fall_from \[get_clocks -quiet \$\{no_gspan_slow_clocks_coll_revised\}\] -rise_to \[get_clocks -quiet \$\{no_gspan_jitter_override_fast_clocks\}\]"

            puts $jitter_fp "set_clock_uncertainty $jitter_val_ns -setup -rise_from \[get_clocks -quiet \$\{no_gspan_jitter_override_fast_clocks\}\] -rise_to \[get_clocks -quiet \$\{no_gspan_jitter_override_slow_clocks\}\]"
            puts $jitter_fp "set_clock_uncertainty $jitter_val_ns -setup -rise_from \[get_clocks -quiet \$\{no_gspan_jitter_override_slow_clocks\}\] -rise_to \[get_clocks -quiet \$\{no_gspan_jitter_override_fast_clocks\}\]"
            puts $jitter_fp "set_clock_uncertainty $jitter_val_ns -setup -fall_from \[get_clocks -quiet \$\{no_gspan_jitter_override_fast_clocks\}\] -fall_to \[get_clocks -quiet \$\{no_gspan_jitter_override_slow_clocks\}\]"
            puts $jitter_fp "set_clock_uncertainty $jitter_val_ns -setup -fall_from \[get_clocks -quiet \$\{no_gspan_jitter_override_slow_clocks\}\] -fall_to \[get_clocks -quiet \$\{no_gspan_jitter_override_fast_clocks\}\]"
            puts $jitter_fp "set_clock_uncertainty $dcd_val_ns -setup -rise_from \[get_clocks -quiet \$\{no_gspan_jitter_override_fast_clocks\}\] -fall_to \[get_clocks -quiet \$\{no_gspan_jitter_override_slow_clocks\}\]"
            puts $jitter_fp "set_clock_uncertainty $dcd_val_ns -setup -rise_from \[get_clocks -quiet \$\{no_gspan_jitter_override_slow_clocks\}\] -fall_to \[get_clocks -quiet \$\{no_gspan_jitter_override_fast_clocks\}\]"
            puts $jitter_fp "set_clock_uncertainty $dcd_val_ns -setup -fall_from \[get_clocks -quiet \$\{no_gspan_jitter_override_fast_clocks\}\] -rise_to \[get_clocks -quiet \$\{no_gspan_jitter_override_slow_clocks\}\]"
            puts $jitter_fp "set_clock_uncertainty $dcd_val_ns -setup -fall_from \[get_clocks -quiet \$\{no_gspan_jitter_override_slow_clocks\}\] -rise_to \[get_clocks -quiet \$\{no_gspan_jitter_override_fast_clocks\}\]"
        }
    }

    close $jitter_fp

    #source final inter clock jitter/uncertainty constraints in the current session
    if { [file exists ./${XDESIGN}_inter_clock_uncertainty.tcl] } {
      puts "**STA_SDC_INFO: Sourcing inter clock jitter/uncertainty constraints from ./${XDESIGN}_inter_clock_uncertainty.tcl"
      source -echo -verbose ./${XDESIGN}_inter_clock_uncertainty.tcl
    }
  }
}
