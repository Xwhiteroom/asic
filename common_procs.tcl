    sta_qc_report_libfiles    $rep_dir/misc.lib_path.${BASE_TAG}.rpt
    echo "** STA_CFG_INFO: Start dumping timing derates: Constraints      [date]"            
    sta_qc_report_derates     $BASE_TAG $rep_dir
    echo "** STA_CFG_INFO: Start dumping timing  macros: Timing_Delay     [date]"               
    sta_qc_get_sram_stats     $BASE_TAG $rep_dir
    echo "** STA_CFG_INFO: Start dumping timing cells  : Library          [date]"     
