proc pt_add_footprint_attr {} {
    global MODE CORNER  GC_STA_ECO_RUN
    file mkdir $GC_STA_ECO_RUN/VTMAP
    set gen_base_tag  [get_object_name  [current_design ]].$MODE.$CORNER          
    echo "#CMD File" > $GC_STA_ECO_RUN/VTMAP/$gen_base_tag.vtmap.tcl
    echo "#CELL,#FOOTPRINT" > $GC_STA_ECO_RUN/VTMAP/$gen_base_tag.vtmap.csv

    foreach_in_collection lib  [get_lib_cells [list */*S6T* */*M7P5* */*S6P25* */*S7P94* ]] {    
        set cell_name [get_attribute $lib base_name]
        regexp {(.*)_(D.+)_[A-Z]_[A-Z](.*)T(\w+)_\w+[10|8]$} $cell_name -> fname driving_str track type
        set footprint "${fname}_${driving_str}_${track}"
        set_user_attribute -class lib_cell $lib footprint $footprint
        echo "set_user_attribute -class lib_cell [get_lib_cell */$cell_name] footprint $footprint" >> $GC_STA_ECO_RUN/VTMAP/$gen_base_tag.vtmap.tcl
        echo "$cell_name,$footprint" >> $GC_STA_ECO_RUN/VTMAP/$gen_base_tag.vtmap.csv
    }
