##------------------------------------------------------------------
## ProcNameStart  : get_mp_mpw
## ProcArguments  : get_mp_mpw dir tag
## ProcDependency : sh , ls 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc get_mp_mpw {dir tag} {
    global ssi_sta_tool_unit_dly
    file mkdir $dir

    proc my_sort_clocks { clocks} {
    	set clocks [get_clocks $clocks]
    	set listx [list]
    	foreach_in_collection clk $clocks {
    		if { [sizeof_collection [get_attr -quiet $clk sources]] > 0 && [get_attr -quiet $clk is_generated] == false} {
    			lappend listx "[get_attr -quiet $clk period],[get_object_name $clk]"
    		}
    	}
    	set listx [lsort -increasing $listx]
    	return $listx
    }




    puts "**Info:: Start Dumping in MP  Reports [date]"    
    report_min_period  -nos -all_violators  > $dir/$tag.mp.raw
    set in [open $dir/$tag.mp.raw]
    array unset mp_map_ref_stat
    array unset mp_map_ref_list
    array unset ref_count
    echo "#CLASS,#LIB,#REF,#PIN,#CLK,#EDGE,#REQ,#ACT,#SLACK,#PERIOD,#UNCERT,#SKEW,#SLAT,#ELAT" > $dir/$tag.mp.csv
    set line_count  0    
    while { [gets $in line] >= 0 } {
	incr line_count        
	if { [regexp "VIOLATED" $line] } { 
            regsub -all  {^\s+} $line {} line
            regsub -all  {\(} $line {} line
            regsub -all  {\)} $line {} line
            regsub -all  {\s+}  $line {,} line
            set class "MP"
            set data [split $line ","]
            set pin  [lindex $data 0]
            set clk  [lindex $data 1]
            set edg  [lindex $data 2]
            set req  [lindex $data 3]
            set act  [lindex $data 4]
            set slk  [lindex $data 5]
            set unc  [format "%0.3f" [get_attr [get_clocks $clk] setup_uncertainty]]
            set slat "NA"
            set elat "NA"
            set skew "NA"
            set per  [get_attr [get_clocks $clk] period]
            set edgx $edg
            catch { set slat [get_attr [get_pins $pin] max_${edgx}_arrival] }
            catch { set elat [get_attr [get_pins $pin] min_${edgx}_arrival] }
            set skew "$slat - $elat"
            catch { set skew [format "%0.3f" [expr $slat - $elat] ]}
            set ref [get_attr [get_cells -of_object [get_pins [lindex $data 0]]] ref_name]
            set lib [lindex [split [get_object_name [get_lib_cell -quiet */$ref]] "/"] 0]
            if { [ info exist ref_count($ref) ] } {
                incr ref_count($ref)
            } else {
                set ref_count($ref) 1
            }
            set datay [list $class  [format "%0.3f" $req] [format "%0.3f" $act] [format "%0.3f" $slk] [format "%0.1f" [expr $ssi_sta_tool_unit_dly/$req]] [format "%0.1f" [expr $ssi_sta_tool_unit_dly/$per]] $unc $skew $ref_count($ref) $ref $lib $pin]
            echo "$class,$lib,$ref,$pin,$clk,$edg,$req,$act,$slk,$per,$unc,$skew,$slat,$elat" >> $dir/$tag.mp.csv
            if { ![info exist mp_map_ref_stat($ref)] || ([info exist mp_map_ref_stat($ref)] & [lindex $mp_map_ref_stat($ref)  1] > $slk)} {
                set mp_map_ref_stat($ref) $datay
            }
        }
    }
    close $in
    echo "#Class #Req(ns) #Act(ns) #Slack(ns) #Req(Mhz) #Clock(Mhz) #Unc(ns) #Skew_S-E(ns) #Count #Ref #Lib #Pin" > $dir/.$tag.mp.temp
    echo " " >> $dir/.$tag.mp.temp
    foreach ref [array names mp_map_ref_stat] {
        echo "$mp_map_ref_stat($ref)" >> $dir/.$tag.mp.temp
    }
    sh cat $dir/.$tag.mp.temp | column -t -s ' '  > $dir/$tag.mp.summary.txt



    puts "**Info:: Start Dumping in MPW Reports [date]"
    report_min_pulse_width -nos -all_violators  > $dir/$tag.mpw.raw
    set in [open $dir/$tag.mpw.raw]
    array unset mpw_map_ref_stat
    array unset mpw_map_ref_list
    array unset ref_count

    echo "#LIB,#REF,#PIN,#CLK,#EDGE,#REQ,#ACT,#SLACK,#PERIOD,#UNCERT,#SKEW,#SLAT,#ELAT" > $dir/$tag.mpw.csv
    set line_count  0
    while { [gets $in line] >= 0 } {
	incr line_count
        if { [regexp "VIOLATED" $line] } { 
            regsub -all  {^\s+} $line {} line
            regsub -all  {\(} $line {} line
            regsub -all  {\)} $line {} line
            regsub -all  {\s+}  $line {,} line
            #puts "$line_count:$line"
            set class "MPW"
            set data [split $line ","]
            set pin  [lindex $data 0]
            set clk  "NA"
            set unc  "NA"
            catch { set clk [lindex [ split [lindex [my_sort_clocks [get_attr -quiet  [get_pins -quiet $pin] clocks]] 0] ","] 1]  }
            #catch { set clk  [lindex [get_object_name [get_attr -quiet  [get_pins -quiet $pin] clocks]] 0] }
            set edg  [lindex $data 1]
            set req  [lindex $data 2]
            set act  [lindex $data 3]
            set slk  [lindex $data 4]
            catch { set unc  [format "%0.3f" [get_attr [get_clocks $clk] setup_uncertainty]]}
            #echo "$line_count,$pin,$clk,$edg,$req,$act,$slk,$unc"
            #return 0
            set slat "NA"
            set elat "NA"
            set skew "NA"
            set per  [get_attr [get_clocks $clk] period]
            if { $edg == "low"} {
                set edgx "fall"
                set edgy "rise"
            } else {
                set edgx "rise"
                set edgy "fall"
            }
            catch { set slat [get_attr [get_pins $pin] max_${edgx}_arrival] }
            catch { set elat [get_attr [get_pins $pin] min_${edgy}_arrival] }
            set skew "$slat - $elat"
            catch { set skew [format "%0.3f" [expr $slat - $elat]]}
            set ref [get_attr [get_cells -of_object [get_pins [lindex $data 0]]] ref_name]
            set lib [lindex [split [get_object_name [get_lib_cell -quiet */$ref]] "/"] 0]
            if { [ info exist ref_count($ref) ] } {
                incr ref_count($ref)
            } else {
                set ref_count($ref) 1
            }

            set datay [list $class [format "%0.3f" $req] [format "%0.3f" $act] [format "%0.3f" $slk] [format "%0.1f" [expr $ssi_sta_tool_unit_dly/$req]] [format "%0.1f" [expr $ssi_sta_tool_unit_dly/$per]] $unc $skew $ref_count($ref) $ref $lib $pin]
            echo "$class,$lib,$ref,$pin,$clk,$edg,$req,$act,$slk,$per,$unc,$skew,$slat,$elat" >> $dir/$tag.mpw.csv
            if { ![info exist mpw_map_ref_stat($ref)] || ([info exist mpw_map_ref_stat($ref)] & [lindex $mpw_map_ref_stat($ref)  1] > $slk)} {
                set mpw_map_ref_stat($ref) $datay
            }
        }
    }
    close $in
    echo "#Class #Req(ns) #Act(ns) #Slack(ns) #Req(Mhz) #Clock(Mhz) #Unc(ns) #Skew_S-E(ns) #Count #Ref #Lib #Pin" > $dir/.$tag.mpw.temp
    echo " " >> $dir/.$tag.mpw.temp
    foreach ref [array names mpw_map_ref_stat] {
        echo "$mpw_map_ref_stat($ref)" >> $dir/.$tag.mpw.temp
    }
    sh cat $dir/.$tag.mpw.temp | column -t -s ' '  > $dir/$tag.mpw.summary.txt
    ls $dir/${tag}*
}
##------------------------------------------------------------------
## ProcNameEnd    : get_mp_mpw
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : get_ndr_port_info
## ProcArguments  : get_ndr_port_info filein fileout slack pba_gba
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc get_ndr_port_info {filein fileout slack pba_gba} {

    set in [open $filein ]
    set out [open $fileout w+ ]
    puts $out "#Total_Pins,#Pins_gba.lt.$slack,#Slack.$pba_gba,#Comment,#Pattern,#Pin"

    while {[gets $in line] >= 0} {
       set pins    [get_pins $line] 
       #GBA filter 
       set gba_pins [get_pins $pins -filter "max_slack < $slack"]
       foreach_in_collection pinx $gba_pins {
            if { $pba_gba == "pba"} {
                set slack_xba  [get_attr [get_timing_paths -through $pinx -pba_mode path -delay max -max_paths 1] slack]
            } else {
                 set slack_xba [get_attr $pinx max_slack]
            }
            set pinx [get_object_name $pinx]
            if { $slack_xba < $slack } {
                puts $out "[sizeof_collection $pins],[sizeof_collection $gba_pins],$slack_xba,NDR_MUST,$line,$pinx"
            } elseif { $slack_xba < 0 } {
                puts $out "[sizeof_collection $pins],[sizeof_collection $gba_pins],$slack_xba,NDR_OKAY,$line,$pinx"
            } else {
                puts $out "[sizeof_collection $pins],[sizeof_collection $gba_pins],$slack_xba,NDR_SKIP,$line,$pinx"                
            }
        }
    }
    puts "Open File $fileout"

    close $in
    close $out

}
##------------------------------------------------------------------
## ProcNameEnd    : get_ndr_port_info
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : get_net_delay
## ProcArguments  : get_net_delay net
## ProcDependency :  
## ProcInfluence  : 3
## ProcRenamed    : 0
##------------------------------------------------------------------
proc get_net_delay net {
    set nets [get_nets $net]
    array unset dly_nets
    set xlist [list ]
    set attr_l1 [list delay annotated_delay_delta base_delay]
    set attr_l2 [list max  max_rise min_fall min min_rise max_fall ]
    foreach_in_collection net $nets {
	set net_name [get_object_name $net]
	set driver   [get_object_name [get_attribute  -quiet [get_nets -quiet $net] leaf_drivers]]
	set loads    [get_attribute  -quiet [get_nets -quiet $net] leaf_loads]
	foreach_in_collection xload $loads {
	        set load        [get_object_name $xload] 
		set arc [get_timing_arc -from $driver -to $xload]
    		array unset net_attr
		foreach attr1 $attr_l1 {
			foreach attr2 $attr_l2 {
				set xattr "${attr1}_${attr2}"
				if { $attr1 == "base_delay" } {
					set net_attr($xattr)  "na"
				        set net_attr($xattr)  [expr $net_attr(delay_${attr2}) - $net_attr(annotated_delay_delta_${attr2}) ]
			        } else {
					set net_attr($xattr)  [get_attr $arc $xattr]				    
			    	}
		    	}
	    	}
		set attr_list "$net_name,$load"
		foreach xattr [array names net_attr] {	set attr_list  "$attr_list,$net_attr($xattr)";    	}
	    	set xlist [lappend xlist "$attr_list"]
        }
    }
    set header "#Net,#Load"
    foreach xattr [array names net_attr] {		        set header "$header,$xattr";     }
    set xlist [concat $header $xlist]
    return $xlist
}
##------------------------------------------------------------------
## ProcNameEnd    : get_net_delay
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : get_net_delay_minmax
## ProcArguments  : get_net_delay_minmax net_collection view outdir
## ProcDependency : get_net_delay 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc get_net_delay_minmax {net_collection view outdir} {
    array unset data_array
    file mkdir $outdir
    set xfile "$outdir/net_delay.$view.csv"
    set printdata "#VIEW,#NET,#MAX,#MIN"
    set i 0    
    set data_array("#NET") $printdata
    puts "          -- start collection trace [sizeof_collection $net_collection] [date]"   
    foreach_in_collection net $net_collection {
        incr i
        set net_name [get_object_name $net]
        set data [get_net_delay $net_name]
        set min_dly [lindex [split [lindex $data 1] ","] 3]
        set max_dly [lindex [split [lindex $data 1] ","] 6]
        set printdata "$view,$net_name,$max_dly,$min_dly"
        set data_array($net_name) "$printdata"
    }
    puts "          -- processed $i [date]" 
    puts "          -- done collection trace [date]"   
    set out [open $xfile w+]
    foreach data [array names data_array] {
        puts $out "$data_array($data)"
    }
    puts "          -- complete file write [date]"  
    close $out    
    puts "** Open File :: [file normalize $outdir]"


}
##------------------------------------------------------------------
## ProcNameEnd    : get_net_delay_minmax
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : get_net_delay_worst
## ProcArguments  : get_net_delay_worst net
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc get_net_delay_worst net {
    set nets [get_nets $net]
    array unset dly_nets
    set xlist [list ]
    set attr_l1 [list delay annotated_delay_delta base_delay]
    set attr_l2 [list max  max_rise min_fall min min_rise max_fall ]
    foreach_in_collection net $nets {
	set net_name [get_object_name $net]
	set driver   [get_object_name [get_attribute  -quiet [get_nets -quiet $net] leaf_drivers]]
	set arc [get_timing_arc -from $driver]
    	array unset net_attr
	foreach attr1 $attr_l1 {
		foreach attr2 $attr_l2 {
			set xattr "${attr1}_${attr2}"
			if { $attr1 == "base_delay" } {
				set net_attr($xattr)  "na"
			        set net_attr($xattr)  [expr $net_attr(delay_${attr2}) - $net_attr(annotated_delay_delta_${attr2}) ]
		        } else {
			        if { [regexp "max" $attr2] } {	
					set net_attr($xattr) [lindex [lsort  [get_attr $arc $xattr]] end] 
			        } else {
					set net_attr($xattr) [lindex [lsort  [get_attr $arc $xattr]] 0] 				    
			        }
		    	}
		}
	}
	set attr_list "$net_name"
	foreach xattr [array names net_attr] {	set attr_list  "$attr_list,$net_attr($xattr)";    	}
	set xlist [lappend xlist "$attr_list"]
    }
    set header "#Net"
    foreach xattr [array names net_attr] { set header "$header,$xattr";     }
    set xlist [concat $header $xlist]
    return $xlist
}
##------------------------------------------------------------------
## ProcNameEnd    : get_net_delay_worst
