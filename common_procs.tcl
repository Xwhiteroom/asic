##------------------------------------------------------------------
## ProcNameStart  : recalc_ir_derate
## ProcArguments  : recalc_ir_derate perc dvd_limit existing_derate
## ProcDependency :  
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc recalc_ir_derate {perc dvd_limit existing_derate} {

    set linear_result [expr $existing_derate * double($perc / $dvd_limit) ]
    if { $perc > $dvd_limit } {
        #puts "perc: $perc is GREATER than dvd_limit: $dvd_limit"
        set linear_delta [expr $linear_result - $existing_derate]
        set incr_derate [expr ($linear_delta * 2.0) ]
        set new_derate [expr $existing_derate + $incr_derate]
    } else {
        #puts "perc: $perc is LESS than dvd_limit: $dvd_limit"
        set linear_delta [expr $existing_derate - $linear_result]
        set incr_derate [expr ($linear_delta * 0.5) ]
        set new_derate [expr $existing_derate - $incr_derate]
    }
    #puts "linear_delta: $linear_delta"
    return [list $incr_derate $new_derate]
}
##------------------------------------------------------------------
## ProcNameEnd    : recalc_ir_derate
##------------------------------------------------------------------


