##------------------------------------------------------------------
## ProcNameStart  : sta_qual_report_summary_connect
## ProcArguments  : sta_qual_report_summary_connect BASE_TAG rep_dir target_blocks
## ProcDependency : sh 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_report_summary_connect {BASE_TAG rep_dir target_blocks} {
    file mkdir $rep_dir  
    # Floating extract proc
    proc sta_qual_get_module_wise_floating {pins filex inst  module} {
        set i 0;
	array unset summary
        set summary("STATIC") 0
        set summary("UNLOADED") 0
        set summary("OUTPORT") 0
        set summary("UNISOLATED") 0
        set summary("LOADED") 0

        set summary("MULTIDRIVEN") 0
        set summary("INPORT") 0
        set summary("UNDRIVEN") 0
        set summary("DRIVEN") 0

        set summary("0_ALL") 0

        foreach_in_collection pin $pins {
            set driver_pin   [get_pins  -quiet -filter "is_hierarchical==false" [all_fanin  -quiet -to    $pin -flat -pin_level 1]]
            set load_pin     [get_pins  -quiet -filter "is_hierarchical==false" [all_fanout -quiet -from  $pin -flat]]
            set driver_port  [get_ports -quiet  [all_fanin  -quiet -to    $pin -flat -pin_level 1]]
            set load_port    [get_ports -quiet  [all_fanout -quiet -from  $pin -flat ]]
            set constant [get_attr  -quiet  [get_pins   -quiet $pin] constant_value]
            if { [sizeof_collection $driver_pin] == 0 || [sizeof_collection $load_pin] == 0 } {
                incr i
                incr summary("0_ALL")
                set name [get_object_name $pin]
                if {$constant == 0 || $constant == 1 } {
                    set load_comment     "IS_STATIC:$constant"
                    set driver_comment   "IS_STATIC:$constant"
                    incr summary("STATIC")
                } else {
                    # Check load   side
                    set load_comment   "LOADED"
                    if       {[sizeof_collection $load_pin] == 0 & [sizeof_collection $load_port] == 0 } { 
                        set load_comment   "UNLOADED_ERROR:Pin.[sizeof_collection $load_pin]:Port.[sizeof_collection $load_port]"
                        incr summary("UNLOADED") 
                    } elseif {[sizeof_collection $load_port] > 0 & [sizeof_collection $load_pin] == 0 } {
                        set load_comment   "IS_OUTPORT:Pin.[sizeof_collection $load_pin]:Port.[sizeof_collection $load_port]"
                        incr  summary("OUTPORT")
                    } elseif {[sizeof_collection $load_port] > 0 & [sizeof_collection $load_pin] > 0 } {
                        set load_comment   "UNISOLATED_ERROR:Pin.[sizeof_collection $load_pin]:Port.[sizeof_collection $load_port]"
                        incr summary("UNISOLATED")              
                    } else {
                        set load_comment   "IS_LOADED:Pin.[sizeof_collection $load_pin]:Port.[sizeof_collection $load_port]"
                        incr summary("LOADED")                
                    }

                    # Check driver side
                    set driver_comment "DRIVEN"
                    if       {[sizeof_collection $driver_pin] == 0 &  [sizeof_collection $driver_port] == 0 } { 
                        set driver_comment   "UNDRIVEN_ERROR:Pin.[sizeof_collection $driver_pin]:Port.[sizeof_collection $driver_port]"
                        incr summary("UNDRIVEN") 
                    } elseif {[sizeof_collection $driver_port] > 0 &  [sizeof_collection $driver_pin] == 0 } {
                        set driver_comment   "IS_INPORT:Pin.[sizeof_collection $driver_pin]:Port.[sizeof_collection $driver_port]"
                        incr  summary("INPORT")
                    } elseif {[sizeof_collection $driver_port] > 1 || [sizeof_collection $driver_pin] > 1 || [expr [sizeof_collection $driver_port] + [sizeof_collection $driver_pin] > 1] } {
                        set driver_comment   "MULTIDRIVEN_ERROR:Pin.[sizeof_collection $driver_pin]:Port.[sizeof_collection $driver_port]"
                        incr  summary("MULTIDRIVEN")                        
                    } else {
                        set driver_comment   "IS_DRIVEN:Pin.[sizeof_collection $driver_pin]:Port.[sizeof_collection $driver_port]"
                        incr  summary("DRIVEN")                        
                    }
                }


                echo "$module,$inst,$name,$constant,$driver_comment,$load_comment" >> $filex
                #echo "$module,$name,$is_port,$constant,$driver_comment"
            }


        }
        set data [list ]
        foreach x [array names summary] {
            lappend data "[format "%15s:%-6d" $x $summary($x)]"
        }
        return $data
    }

    suppress_message UITE-216
    set filenamex "$rep_dir/misc.float.${BASE_TAG}.rpt"
    echo "#DESIGN,#INST,#PORT,#CONSTANT_VALUE,#DRIVER_ERROR,#LOAD_ERROR" > $filenamex
    foreach module $target_blocks {
        set inst [get_cells -quiet -hier * -filter "ref_name==$module"]
        foreach_in_collection  inst_name $inst {
            set name_inst [get_object_name $inst_name]
            set out [sta_qual_get_module_wise_floating [get_pins $name_inst/*]  $filenamex $name_inst $module]
            echo "** STA_CFG_INFO: Start dumping floating ports: $module [date]"   
            foreach x $out  { puts "\t\t\t $x"}
        }
    }
    sh cat $filenamex | grep _ERROR  > $filenamex.ERROR.rpt
    puts "Open File: $filenamex" 
    puts "Open File: $filenamex.ERROR.rpt" 

    unsuppress_message UITE-216
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_report_summary_connect
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_report_summary_deltasi
## ProcArguments  : sta_qual_report_summary_deltasi args
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_report_summary_deltasi args {
    global MODE CORNER GC_STA_HIER_MAP
    # Default inputs
    array unset inputs  
    set inputs(clock_si)    "0.005"
    set inputs(data_si)     "0.010"
    set inputs(type)        "clockdata"    
    set inputs(view)        "default.default"
    set inputs(col)         "NA"

    catch { set inputs(view)     "$MODE.$CORNER" }

    # Parse Arguments 
    parse_proc_arguments -args $args proc_x_args
    foreach x [array names proc_x_args] {  
        regsub -all {\-} $x {} y
        set inputs($y) $proc_x_args($x)
        #puts [format "\t%20s = %-20s %20s" $y $x $proc_x_args($x)]
    }

    # Normalize Dir path
    set inputs(rep_dir) [file normalize $inputs(rep_dir)]

    # Print Arguments
    puts [format "<GC::PROC> Start %-50s  [date]"   "sta_qual_report_summary_deltasi : $inputs(rep_dir)" ]
    foreach x [array names inputs] {    
        puts [format "\t%20s = %-20s" $x $inputs($x)] 
    }
    set delay_type [list]
    if { [regexp "clock" $inputs(type)] } { lappend delay_type "clock_si"}
    if { [regexp "data" $inputs(type)] } { lappend delay_type "data_si"}
    
    # Create dir
    file mkdir $inputs(rep_dir)
    
    # Init Collection 
    if { $inputs(col) == "NA" } { 
        set all_nets [get_nets -quiet -hier * -filter "( annotated_delay_delta_max > 0 || annotated_delay_delta_min < -0 )"]
    } elseif { [sizeof_collection [get_nets $inputs(col)]] > 0 }  {
        set all_nets [get_nets -quiet  $inputs(col)]
    } else {
        set all_nets [get_nets -quiet -hier * -filter "( annotated_delay_delta_max > 0 || annotated_delay_delta_min < -0 )"]        
    }
    
    # Dump Raw Reports
    foreach delay $delay_type {
        # Extract Noise Nets
        if {$delay == "clock_si"} {
            set target_nets [get_nets  -quiet  $all_nets -filter "is_clock_network==true and ( annotated_delay_delta_max > $inputs($delay) || annotated_delay_delta_min < -$inputs($delay) )"]
        } else {
            set target_nets [get_nets  -quiet  $all_nets -filter "is_clock_network==false and ( annotated_delay_delta_max > $inputs($delay) || annotated_delay_delta_min < -$inputs($delay) )"]        
        }

        set out [open $inputs(rep_dir)/$inputs(base_tag).drv.$delay.csv w+]
        puts $out "#start,#end,#min_slk,#max_slk,#wcs_si,#end_clk,#view,#class"  
        if { [sizeof_collection $target_nets] } {
            foreach_in_collection netx $target_nets {
                set view     $inputs(view)                              
	        set net      [get_object_name $netx]
	        set pin      [get_object_name [get_attr -quiet $netx leaf_drivers]]
                set si_max   [expr abs([get_attr -quiet  $netx annotated_delay_delta_max])] 
	        set si_min   [expr abs([get_attr -quiet $netx annotated_delay_delta_min])] 
	        set slk_max  [get_attr -quiet $netx max_slack]
	        set slk_min  [get_attr -quiet $netx min_slack]
                set categ  [get_attr -quiet [get_pins -quiet $pin ] clocks]
                set ref [get_attr -quiet [get_cells -quiet -of_object [get_pins -quiet  $pin]] ref_name]
                if { $ref == ""} {
                    set ref "ioPORT"
                } 
                # Hier Mapping
                set hierx "TOP"
                foreach virtual_hier [array name GC_STA_HIER_MAP] {
                    if {[regexp $virtual_hier $pin] } {
                        set hierx  $GC_STA_HIER_MAP($virtual_hier)  
                    }
                }
                if { [sizeof_collection $categ] > 0 } {
                    # Fastest Clock Sorting -start
                    set listx [list]
                    foreach_in_collection clk $categ {
                        lappend listx "[get_attr -quiet $clk period],[get_object_name $clk]"
                    }
                    set listx [lsort -increasing $listx]
                    set fastest_clk  [lindex [split $listx "," ] 1]
                    regsub -all {\}} $fastest_clk {} fastest_clk
                    regsub -all {\{} $fastest_clk {} fastest_clk
                    # Fastest Clock Sorting -end
                    set end_clk "${hierx}_$fastest_clk" 

                } else {
                    # Add Slack section -start
                    set is_timed_SU [get_attr -quiet [get_pins -quiet $pin ] max_slack]
                    set is_timed_HD [get_attr -quiet [get_pins -quiet $pin ] min_slack]
                    if { $is_timed_SU == "INFINITY" && $is_timed_HD == "INFINITY"  } { 
                      set hierx "${hierx}_UNC"
                    }
                    # Add Slack section -end
                    set end_clk "no_clock.$hierx"                    
                }
                set wcs_si $si_max
                if { $si_max < $si_min} {
                    set wcs_si $si_min
                }
                puts $out "$pin,$net,$slk_min,$slk_max,$wcs_si,$end_clk,$view,$delay"
            }
        }

        close $out
    }
    puts [format "<GC::PROC> End   %-50s  [date]"   "sta_qual_report_summary_deltasi : $inputs(rep_dir)" ]

}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_report_summary_deltasi
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_report_summary_glitch
## ProcArguments  : sta_qual_report_summary_glitch args
## ProcDependency :  
## ProcInfluence  : 2
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_report_summary_glitch args {
    global MODE CORNER GC_STA_HIER_MAP ssi_sta_tool_unit_dly
    # Default inputs
    array unset inputs  
    set inputs(type)     "glitch"
    set inputs(view)     "default.default"
    catch { set inputs(view)     "$MODE.$CORNER" }

    # Parse Arguments 
    parse_proc_arguments -args $args proc_x_args
    foreach x [array names proc_x_args] {  
        regsub -all {\-} $x {} y
        set inputs($y) $proc_x_args($x)
        #puts [format "\t%20s = %-20s %20s" $y $x $proc_x_args($x)]
    }

    # Normalize Dir path
    set inputs(rep_dir) [file normalize $inputs(rep_dir)]

    # Print Arguments
    puts [format "<GC::PROC> Start %-50s  [date]"   "sta_qual_report_summary_glitch : $inputs(rep_dir)" ]
    foreach x [array names inputs] {    
        puts [format "\t%20s = %-20s" $x $inputs($x)] 
    }
    set delay_type [list]
    if {$inputs(type) == "glitch" } { lappend delay_type "glitch"
    } else {                          lappend delay_type $inputs(type)   }
    # Create dir
    file mkdir $inputs(rep_dir)

    # Dump Raw Reports
    foreach delay $delay_type {
        # Extract Timing Paths
        report_noise -all_violators -significant_digits 4 -nosplit > $inputs(rep_dir)/.$inputs(base_tag).drv.$delay.raw
        report_noise_parameters >    $inputs(rep_dir)/$inputs(base_tag).drv.$delay.noise_param
        printvar si_*           >>   $inputs(rep_dir)/$inputs(base_tag).drv.$delay.noise_param
        printvar timing_*       >>   $inputs(rep_dir)/$inputs(base_tag).drv.$delay.noise_param
        # Extract Net For Unification
        set in  [open $inputs(rep_dir)/.$inputs(base_tag).drv.$delay.raw]
        set out [open $inputs(rep_dir)/$inputs(base_tag).drv.$delay.csv w+]
        puts $out "#start,#end,#width,#height,#slk,#end_clk,#view,#class"        
        # noise_region: above_low
        #pin name (net name)       width    height     slack
        # Pre Flags
        set start 0
        set sub_type "default"

        while { [gets $in line] >= 0 } { 
            set pin    [lindex  $line  0]        
            set net    [lindex  $line  1]  
            set width  [lindex  $line  2]  
            set height [lindex  $line  3]  
            set slk    [lindex  $line  4]  
            set view   $inputs(view)              
            if { [regexp "noise_region:" $pin]   } { 
                set sub_type    [lindex $line 1]   
            }
            # Stop Parsing Flag
            if { $line == ""} { 
                set start 0   
            }
            # Hier Mapping
            set hierx "TOP"
            foreach virtual_hier [array name GC_STA_HIER_MAP] {
              if {[regexp $virtual_hier $pin] } {
                 set hierx  $GC_STA_HIER_MAP($virtual_hier)  
              }
            }



            # Parse lines
            if { $start == "1"} {
                regsub -all {\(} $net {} net
                regsub -all {\)} $net {} net
                set categ  [get_attr -quiet [get_pins -quiet $pin ] clocks]
                if { [sizeof_collection $categ] > 0 } {
                    # Fastest Clock Sorting -start
                    array unset listx
                    foreach_in_collection clk $categ {
                        set periodx [get_attr -quiet $clk period]
                        if { $periodx != ""} {
                           set freq [format "%04.0fMHz" [expr $ssi_sta_tool_unit_dly / $periodx]]
                        } else {
                           set freq [format "%04.0fMHz" "0.00"]
                        }
                        set listx($freq) [get_object_name $clk]
                    }
                    set freq_key [lindex [lsort -decreasing [array name listx]] 0]
                    set fastest_clk  $listx($freq_key)
                    regsub -all {\}} $fastest_clk {} fastest_clk
                    regsub -all {\{} $fastest_clk {} fastest_clk
                    # Fastest Clock Sorting -end
                    set end_clk "${hierx}_${fastest_clk}_$sub_type" 
                    
                } else {
                    # Add Slack section -start
                    set is_timed_SU [get_attr -quiet [get_pins -quiet $pin ] max_slack]
                    set is_timed_HD [get_attr -quiet [get_pins -quiet $pin ] min_slack]
                    if { $is_timed_SU == "INFINITY" && $is_timed_HD == "INFINITY"  } { 
                      set hierx "${hierx}_UNC_$sub_type"
                    }
                    # Add Slack section -end
                    set end_clk "no_clock.$hierx"                    
                }
                puts $out "$net,$pin,$width,$height,$slk,$end_clk,$view,${delay}_$sub_type"        
            }

            # Start Parsing Flag
            if { [regexp "\-\-\-\-\-\-\-\-\-" $pin]  } { 
                set start 1   
            }
        }
        close $in
        close $out
    }
    puts [format "<GC::PROC> End   %-50s  [date]"   "sta_qual_report_summary_glitch : $inputs(rep_dir)" ]

}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_report_summary_glitch
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_report_summary_hiersdc
## ProcArguments  : sta_qual_report_summary_hiersdc args
## ProcDependency : sta_qual_get_clock_cell_hierdata , sta_qual_get_clock_sense 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_report_summary_hiersdc args {
    global MODE CORNER
    # Default inputs
    array unset inputs
    set inputs(type)        "all"
    set inputs(view)        "default.default"
    catch { set inputs(view)     "$MODE.$CORNER" }

    # Parse Arguments
    parse_proc_arguments -args $args proc_x_args
    foreach x [array names proc_x_args] {
        regsub -all {\-} $x {} y
        set inputs($y) $proc_x_args($x)
        #puts [format "\t%20s = %-20s %20s" $y $x $proc_x_args($x)]
    }

    # Normalize Dir path
    set inputs(rep_dir) [file normalize $inputs(rep_dir)]

    # Print Arguments
    puts [format "<GC::PROC> Start %-50s  [date]"   "sta_qual_report_summary_hiersdc : $inputs(rep_dir)" ]
    foreach x [array names inputs] {
        puts [format "\t%20s = %-20s" $x $inputs($x)]
    }
    set delay_type [list]
    if { [regexp "boundary" $inputs(type)] || [regexp "all" $inputs(type)]  } { lappend delay_type "boundary" }
    if { [regexp "sense" $inputs(type)]    || [regexp "all" $inputs(type)]  } { lappend delay_type "sense"    }

    #puts "done1"
    # Create dir
    file mkdir $inputs(rep_dir)
    puts [format "<GC::PROC> Start %-50s  [date]"   "sta_qual_report_summary_hiersdc : $inputs(rep_dir)" ]
    #puts "done2"

    # Common Data
    set flat_instances [get_cells -quiet $inputs(instances)]
    set hier_instances [remove_from_collection $flat_instances $flat_instances]
    foreach blk $inputs(modules) {
        append_to_collection -unique hier_instances [get_cells -quiet -hier -filter "ref_name==$blk"]
        puts [format "       -- For block  %40s  / Found Cells %s " $blk [get_object_name [get_cells -quiet -hier -filter "ref_name==$blk"]]]
    }
    append_to_collection -unique flat_instances $hier_instances

    # Map Instances
    array unset module_map
    foreach_in_collection inst $flat_instances {
        set blk [get_attribute $inst ref_name]
        set module_map($blk) [list]
    }

    # Init Data
    array unset clock_map
    set header_def "#Timing_Mode,#Clock_Name,#PhyEx_Mode,#Sync_Mode,#LogEx_Mode,#Clock_Tag,#Source,#AddVirtual,#MasterClock/Root,#Wave_Form/Edges,#Extra_Options,#Spec,#Condition,#Module,#Instance,#Comments"
    set clock_map_cnt 0
    set clock_map(#Head,$clock_map_cnt) $header_def ; incr clock_map_cnt

    array unset exp_map
    set header_exp "#BugID,#Class,#Setup,#Hold,#Type,#Extra_Arg,#From,#To,#Through,#Define_Collection,#Loop_Type,#Loop_Pre,#Loop_Post,#Comment,#Condition,#Module,#Instance,#Exception_CLass"
    set exp_map_cnt 0
    set exp_map(#Head,$exp_map_cnt) $header_exp ; incr exp_map_cnt


    # Dump Hier SDC Extracts
    foreach delay $delay_type {
        # Parse boundary
        if { $delay == "boundary"} {
            foreach blk [array names module_map] {
                set inst             [get_object_name [get_cells -quiet $flat_instances  -filter "ref_name==$blk"]]
                set module_map($blk) $inst
                # Get Cell
                foreach inst $module_map($blk) {
                    puts "       -- Processing $inst $blk"
                    foreach_in_collection pin [get_pins -quiet $inst/* -filter "is_hierarchical==true && direction==in"] {
                        set pin_name  [get_object_name $pin]
                        set port_name [lindex [split $pin_name "/"] end]
                        set driver [get_pins -quiet [all_fanin -flat -pin_level 1 -to $pin ] -filter "direction==out"]

                        #  For Clocks
                        set clocks [get_attribute -quiet $driver clocks]
                        if {[ sizeof_collection $clocks] > 0 } {
                            foreach xclock [lsort -unique [get_object_name [get_clocks -quiet $clocks]]] {
                                set master_clk "none"
                                if { [get_attribute -quiet [get_clock -quiet $xclock] is_generated] == "true" } {
                                    set master_clk  [get_object_name [get_attribute -quiet [get_clock -quiet $xclock] master_clock]]
                                }
                                set clk_source  [get_object_name [get_attribute -quiet [get_clock -quiet $xclock] sources]]
                                regsub -all {\{|\}} $clk_source {} clk_source
                                set clk_source "{$clk_source}"
                                set comment "$port_name->TOP_CLK:$xclock->TOP_SRC:$clk_source"
                                set waveform [get_attribute -quiet [get_clock -quiet $xclock] waveform]
                                set period   [get_attribute -quiet [get_clock -quiet $xclock] period]
                                # TODO ClkGrp Mapping
                                set data "$MODE,$xclock,PHY_EX,SYNC_EX,LOG_EX,TAG,$port_name,0,$master_clk,$waveform,EXT,PERIOD=$period,\[\$XDESIGN == \"$blk\"\],$blk,$inst,$comment"
                                set clock_map($blk,$inst,$xclock,$clock_map_cnt) $data ; incr clock_map_cnt
                                #puts "$blk $data "
                            }
                        }

                        # For SFP/SCA
                        set case_V     [get_attribute -quiet $driver case_value]
                        set constant_V [get_attribute -quiet $driver constant_value]
                        set slackS     [get_attribute -quiet $driver max_slack]
                        set slackH     [get_attribute -quiet $driver min_slack]
                        if {$case_V != "" } {
                            if { $constant_V != "" } {
                                set comment "TIEOFF/$constant_V/$blk"
                            } else {
                                set comment "CASE/$case_V/$blk"
                            }
                            set valid "Static:$pin_name"
                            set data "BugID<> Static Node $comment,set_case_analysis,,,,$case_V,$pin_name,,,,,,,$valid,\[\$XDESIGN == \"$blk\"\],$blk,$inst,$comment"
                            set exp_map($blk,$inst,SCA,$exp_map_cnt) $data ; incr exp_map_cnt
                        } elseif {  $slackS == "INFINITY" || $slackH == "INFINITY" } {
                            set comment "Unc"
                            if { $slackS == "INFINITY"} {
                                set comment "$comment/Setup"
                            }
                            if { $slackH == "INFINITY"} {
                                set comment "$comment/Hold"
                            }
                            set comment "$comment/$blk"
                            if { [regexp "Hold" $comment] && [regexp "Setup" $comment] } {
                                set data "BugID<> False Path $comment,set_false_path,,,,,,,$pin_name,,,,,Setup/Hold Uncons $pin_name,\[\$XDESIGN == \"$blk\"\],$blk,$inst,$comment"
                            } elseif { [regexp "Hold" $comment] } {
                                set data "BugID<> False Path $comment,set_false_path,,,hold,,,,$pin_name,,,,,Hold Uncons $pin_name,\[\$XDESIGN == \"$blk\"\],$blk,$inst,$comment"
                            } elseif { [regexp "Setup" $comment] } {
                                set data "BugID<> False Path $comment,set_false_path,,,setup,,,,$pin_name,,,,,Setup Uncons $pin_name,\[\$XDESIGN == \"$blk\"\],$blk,$inst,$comment"
                            }
                            set exp_map($blk,$inst,SFP,$exp_map_cnt) $data ; incr exp_map_cnt
                        }
                    }
                }
            }
            foreach_in_collection cell $flat_instances {
                set blk       [get_attribute $cell ref_name]
                set cell_name_org [get_object_name $cell]
                regsub -all {\[|\]|/} $cell_name_org {.} cell_name
                file mkdir $inputs(rep_dir)/$blk/$cell_name
                report_clocks  -nosplit -cells $cell_name_org > $inputs(rep_dir)/$blk/$cell_name/clock_cell_hier_$blk.rpt
                set out1 [open $inputs(rep_dir)/$blk/$cell_name/$inputs(base_tag).ctv.clock_definition_$blk.csv w+]
                foreach item [lsort -increasing [array names clock_map]] {
                    regsub -all {\[|\]|/} $item {.} item_name

                    if { [regexp "#Head" $item_name] || [regexp "$blk,$cell_name" $item_name] } {
                        puts $out1 "$clock_map($item)"
                    }
                }
                close $out1
                set out1 [open $inputs(rep_dir)/$blk/$cell_name/design_exceptions_sfp_sca_$blk.csv w+]
                foreach item [lsort -increasing [array names exp_map]] {
                    regsub -all {\[|\]|/} $item {.} item_name

                    if { [regexp "#Head" $item_name] || [regexp "$blk,$cell_name" $item_name] } {
                        puts $out1 "$exp_map($item)"
                    }
                }
                close $out1
            }

            redirect -var temp_var_file  {report_clocks  -nosplit -cells $flat_instances }
            sta_qual_get_clock_cell_hierdata $temp_var_file $inputs(view) $inputs(rep_dir)/$inputs(base_tag).ctv.clk_hier.csv

            set out1 [open $inputs(rep_dir)/$inputs(base_tag).ctv.clock_definition.csv w+]
            foreach item [lsort -increasing [array names clock_map]] {
                puts $out1 "$clock_map($item)"
            }
            close $out1

            set out1 [open $inputs(rep_dir)/$inputs(base_tag).ctv.design_exceptions_sfp_sca.csv w+]
            foreach item [lsort -increasing [array names exp_map]] {
                puts $out1 "$exp_map($item)"
            }
            close $out1
        }

        # Parse Sense
        if { $delay == "sense"} {
            redirect -var temp_var_file  { report_sense   -nosplit -type clock }
            sta_qual_get_clock_sense $temp_var_file $inputs(view) $inputs(rep_dir)/$inputs(base_tag).ctv.clk_sense.csv
        }
    }
    puts [format "<GC::PROC> End   %-50s  [date]"   "sta_qual_report_summary_hiersdc : $inputs(rep_dir)" ]
    #sh tree -L 1 [file normalize $dir_path]
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_report_summary_hiersdc
