##------------------------------------------------------------------
## ProcNameStart  : sta_qc_gen_sdf_env
## ProcArguments  : sta_qc_gen_sdf_env dir sdf_path
## ProcDependency : sta_qc_get_clock_target , sh , ls 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qc_gen_sdf_env {dir sdf_path} {	
	global MODE CORNER link_library NETLISTS SDC_FILE
	set design [get_object_name [current_design]]
        set TOP_DESIGN $design
        file mkdir $dir 

        set dir       [file normalize $dir]
        set SDF       "$dir/$TOP_DESIGN.$MODE.$CORNER.NO_GBA_HOLD.sdf"
        set NRF_file  "$dir/$TOP_DESIGN.$MODE.$CORNER.NRF.rpt"
        set SYNC_file "$dir/$TOP_DESIGN.$MODE.$CORNER.SYNC.rpt" 
	set outfile   "$dir/SDF_env.${TOP_DESIGN}.${MODE}.${CORNER}.tcl"
	set net_file   "$dir/SDF_vlg.${TOP_DESIGN}.${MODE}.${CORNER}.tcl"

        puts "Writing NRF/SYNC File ....[date]"         
        redirect -bg $NRF_file  { foreach_in_collection pin [get_pins -of_object [get_cells -hier -filter "ref_name=~*SDFFQ_* || ref_name=~*SDFFQN_*"] -filter "direction==out"] { echo "[get_object_name $pin]" }}    
        redirect -bg $SYNC_file { foreach_in_collection pin [get_pins -of_object [get_cells -hier -filter "full_name=~*u_DTSO_sync_*"] -filter "direction==out"]           { echo "[get_object_name $pin]" }}
        
        if {![file exist $sdf_path]} {
            puts "Writing SDF File $SDF.gz ....[date]"
            write_sdf -no_derates -compress gzip -input_port_nets -output_port_nets  -version 3.0 $SDF
            set SDF "$SDF.gz"
        } else {
            puts "Skip Writing SDF File USING $sdf_path ....[date]"
            set SDF "$sdf_path"
        }

        puts "Writing VERILOG File ....[date]"        
        echo "# Verilog used for this Run :" > $net_file
        foreach gv $NETLISTS { 
            echo "$gv" >> $net_file 
            puts "Copying VERILOG File $gv....[date]"                    
            sh cp $gv $dir/.
        }

        puts "Writing SDF Env ....[date]"
        ### The following script dumps out from pt shell, a validation script for the generated SDF.        
	write_app_var -output $outfile
	set fho [open  $outfile a]
	puts $fho "\n\n\n"
	puts $fho "catch { source  /edascratch/user/sshakir/whi-master/flow_control/scripts/procs/tool.rc }"
	puts $fho "echo \"Done setting globals\""
	puts $fho "\n\n\n"
	puts $fho "## PVT"
	puts $fho "set MODE \"$MODE\""
	puts $fho "set CORNER \"$CORNER\""
	
	puts $fho "\n\n\n"
	puts $fho "## Library linking"
	foreach lib_db $link_library {
	puts $fho "read_db $lib_db"
	}
	
	puts $fho "\n\n"
	puts $fho "## Reading verilog"
	#foreach vlog $NETLISTS {
	#puts $fho "read_verilog $vlog"
	#}
	regsub -all {\n} $NETLISTS {} NETLISTS
	puts $fho "read_verilog { $NETLISTS }"
	
	puts $fho "\n\n"
	puts $fho "current_design ${design}"
	puts $fho "link_design"
	
	puts $fho "\n\n"
	puts $fho "## Reading SDF"
	puts $fho "read_sdf [ls $SDF]"
	
	puts $fho "\n\n"
	puts $fho "## Reading SDC"
	## Since read_sdc not honoured for .tcl file puts $fho "read_sdc $SDC_FILE"
	puts $fho "source $SDC_FILE"
	puts $fho "# Add False Path For I/O in SDF Gen Env"
	puts $fho "set_false_path -to   \[all_outputs\]"
	puts $fho "set_false_path -from \[all_inputs\]"
	puts $fho "update_timing"
	puts $fho "set  i 0"
	puts $fho "incr i ; rca_min > min.\$i.path.\$MODE.\$CORNER ; slack_parse min.\$i.path.\$MODE.\$CORNER"
	puts $fho "incr i ; rca_max > max.\$i.path.\$MODE.\$CORNER ; slack_parse max.\$i.path.\$MODE.\$CORNER"
	puts $fho "save_session save_session.post_sdf_annotation.\$MODE.\$CORNER"
	puts $fho "redirect -bg \$CORNER.\$MODE.freq.rpt { sta_qc_get_clock_target * 0.050 }"
	close $fho

	puts "Open : $dir"
        sh tree $dir

}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qc_gen_sdf_env
##------------------------------------------------------------------


