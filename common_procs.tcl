## ProcNameStart  : get_floating_inputs
## ProcArguments  : get_floating_inputs pins filex
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc get_floating_inputs {pins filex} {
    echo "#name,#is_port,#constant,#driver_comment" > $filex
    foreach_in_collection pin $pins {
        set driver   [get_pins -quiet -filter "is_hierarchical==false" [all_fanin -quiet -to  $pin -flat -pin_level 1]]
        set constant [get_attr  -quiet  [get_pins   -quiet $pin] constant_value]
        set is_port  [sizeof_collection [get_ports  -quiet $pin] ]

        if { [sizeof_collection $driver] == 0 } {
            set name [get_object_name $pin]
            set driver_comment ""
            if { $is_port > 0} { set driver_comment "IS_PORT"}
            if { $constant == 0 || $constant == 1} { set driver_comment "${driver_comment}.IS_STATIC_$constant"}
            if { $driver_comment == ""} {       set driver_comment "FLOATING_ERROR"       }
            echo "$name,$is_port,$constant,$driver_comment" >> $filex
            echo "$name,$is_port,$constant,$driver_comment"
        }
    }
    puts "Open File: $filex" 
}
