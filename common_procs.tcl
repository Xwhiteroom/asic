proc ssi_collection { filter base} {
    set base_size  [sizeof_collection $base]
    set filter_size [sizeof_collection $filter]
    if { $base_size > 0 } {
        set perc_val    [expr (100.00* $filter_size / $base_size)]
    } else {
        set perc_val    0.00
    }
    set perc_filt   [format "%03.2f" $perc_val]
    set text_out    [format "Perc : %6s%1s | Size: %-10d  / %-10d" $perc_filt "%"  $filter_size $base_size]
    return [list $text_out $filter_size $base_size $perc_filt]
}





  proc ssi_get_attr_first {obj attr_list} {
      foreach a $attr_list {
          if {![catch {set v [get_attribute $obj $a]}] && $v != ""} {
              return $v
          }
      }
      return ""
  }

  proc ssi_get_die_bbox {} {
      set bbox ""
      if {[catch {set bbox [get_attribute [current_block] bbox]}]} {
          if {[catch {set bbox [get_attribute [current_design] boundary]}]} {
              catch {set bbox [get_die_area]}
          }
      }
      if {$bbox == ""} {
          error "port_bbox_report: could not auto-detect die/core bbox -- open a floorplanned block first, or edit get_die_bbox to point at your boundary source."
      }
      return $bbox
  }

  proc ssi_facing_from_bbox {cx cy die_bbox} {
      set llx [lindex [lindex $die_bbox 0] 0]
      set lly [lindex [lindex $die_bbox 0] 1]
      set urx [lindex [lindex $die_bbox 1] 0]
      set ury [lindex [lindex $die_bbox 1] 1]

      set d_west  [expr {abs($cx - $llx)}]
      set d_east  [expr {abs($urx - $cx)}]
      set d_south [expr {abs($cy - $lly)}]
      set d_north [expr {abs($ury - $cy)}]

      set min_d $d_west
      set facing "west"
      if {$d_east  < $min_d} { set min_d $d_east;  set facing "east"  }
      if {$d_south < $min_d} { set min_d $d_south; set facing "south" }
      if {$d_north < $min_d} { set min_d $d_north; set facing "north" }
      return $facing
  }

  proc ssi_write_port_bbox_report {col xfile} {
      set die_bbox [ssi_get_die_bbox]
      set n [sizeof_collection $col]

      set fp [open $xfile w]
      puts $fp "port_name,llx,lly,urx,ury,center_x,center_y,width,height,area,direction,facing"

      set skipped 0
      foreach_in_collection p $col {
          set pname [ssi_get_attr_first $p {full_name name}]
          set bbox  [ssi_get_attr_first $p {bbox port_bbox physical_bbox}]
          set dir   [ssi_get_attr_first $p {direction port_direction pin_direction}]

          if {$bbox == ""} {
              incr skipped
              continue
          }

          set llx [lindex [lindex $bbox 0] 0]
          set lly [lindex [lindex $bbox 0] 1]
          set urx [lindex [lindex $bbox 1] 0]
          set ury [lindex [lindex $bbox 1] 1]

          set width  [expr {$urx - $llx}]
          set height [expr {$ury - $lly}]
          set area   [expr {$width * $height}]
          set cx     [expr {($llx + $urx) / 2.0}]
          set cy     [expr {($lly + $ury) / 2.0}]

          set facing [ssi_facing_from_bbox $cx $cy $die_bbox]

          puts $fp "$pname,$llx,$lly,$urx,$ury,$cx,$cy,$width,$height,$area,$dir,$facing"
      }

      close $fp
      puts "port_bbox_report: wrote [expr {$n - $skipped}] of $n ports to $xfile ($skipped skipped, no bbox)"
  }









