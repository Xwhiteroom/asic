##------------------------------------------------------------------
## ProcNameStart  : autodesign_get_clockgroup
## ProcArguments  : autodesign_get_clockgroup patternlist
## ProcDependency : autodesign_get_clock_relationship , autodesign_puts_tee 
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc autodesign_get_clockgroup patternlist {
	set clocks1 [get_clocks $patternlist]
	set clocks2 [get_clocks $patternlist]
        set xfile "autodesign_get_clockgroup.info.tcl"
        set out_p [open $xfile w+]

	autodesign_puts_tee $out_p  "\n\n"
	autodesign_puts_tee $out_p  [format  "\t\t%50s  %50s  %50s %40s" "<Clock1>" "<Clock2>" "<Relationship>" "<Comment>"]   
	autodesign_puts_tee $out_p  [format  "\t\t%50s  %50s  %50s %50s" "----------------------------------" "----------------------------------" "----------------------------------" "----------------------------------"]   
	array unset mapped_clock_pairs
	set toggle_dash 0
	array unset review_stat

	foreach_in_collection clk1 $clocks1 {

		set clk1_name [get_object_name $clk1]
		set clk1_src  [get_object_name [get_attribute  -quiet $clk1 sources]]
		if { [get_attribute $clk1 is_generated] } {
		  set clk1_src  [get_object_name [get_attribute  -quiet [get_attribute  -quiet $clk1 master_clock] sources]]	
		}
		set clk1_per  [get_attribute  -quiet $clk1 period]

		foreach_in_collection clk2 $clocks2 {
			set clk2_name [get_object_name $clk2]
			set clk2_src  [get_object_name [get_attribute -quiet $clk2 sources]]
			if { [get_attribute $clk2 is_generated] } {
		  		set clk2_src  [get_object_name [get_attribute  -quiet [get_attribute  -quiet $clk2 master_clock] sources]]	
			}
			set clk2_per  [get_attribute  -quiet $clk2 period]
			set ratio_per 1
			if { $clk2_per > $clk1_per } { set ratio_per [expr $clk2_per / $clk1_per] }
			if { $clk1_per > $clk2_per } { set ratio_per [expr $clk1_per / $clk2_per] }
			set ratio_per_int   [expr int($ratio_per)]
			if { $clk2_name != $clk1_name  && ![info exist mapped_clock_pairs($clk1_name,$clk2_name)] } {
				set mapped_clock_pairs($clk1_name,$clk2_name) mapped
				set mapped_clock_pairs($clk2_name,$clk1_name) mapped
				set relation [autodesign_get_clock_relationship [list $clk1_name $clk2_name]]
				if  {$relation == "{}" || $relation == ""} { set relation "{synchronous}"}
				set window 1
				if { $ratio_per_int < $ratio_per  } { set window 0 }
				set comment ""
				if { $clk2_src == $clk1_src  && [regexp "asynchronous" $relation] }                                               			{  set comment "$comment/SameSrcAsync_Review" }
				if { $clk2_src != $clk1_src  && [regexp "asynchronous" $relation] }                                               			{  set comment "$comment/DiffSrcAsync_Waived" }

				if { $clk2_src == $clk1_src  && [regexp "physically_exclusive" $relation] } 				          			{  set comment "$comment/SameSrcPhyEx_Review" }
				if { $clk2_src != $clk1_src  && [regexp "physically_exclusive" $relation] } 				          			{  set comment "$comment/DiffSrcPhyEx_Review" }

				if { $clk2_src == $clk1_src  && [regexp "logically_exclusive" $relation] } 				          			{  set comment "$comment/SameSrcLogEx_Review" }
				if { $clk2_src != $clk1_src  && [regexp "logically_exclusive" $relation] } 				          			{  set comment "$comment/DiffSrcLogEx_Review" }

				if { $window == 1  && $clk2_src == $clk1_src  && [regexp "synchronous" $relation]  && ![regexp "asynchronous" $relation] }        	{  set comment "$comment/SameSrcSync_Waived"  }
				if { $window == 1  && $clk2_src != $clk1_src  && [regexp "synchronous" $relation]  && ![regexp "asynchronous" $relation] }         	{  set comment "$comment/DiffSrcSync_Review"  }

				if { $window == 0  && $clk2_src == $clk1_src  && [regexp "synchronous" $relation]  && ![regexp "asynchronous" $relation] }         	{  set comment "$comment/SameSrcSyncNoLCM_Review"  }
				if { $window == 0  && $clk2_src != $clk1_src  && [regexp "synchronous" $relation]  && ![regexp "asynchronous" $relation] }         	{  set comment "$comment/DiffSrcSyncNoLCM_Review"  }

				if { ! [info exist review_stat($comment)] } { set  review_stat($comment) 0 }
				if {   [info exist review_stat($comment)] } { incr review_stat($comment)   }

				if { [regexp "_Review" $comment ] && $toggle_dash == 0 }  { 
				    autodesign_puts_tee $out_p  [format  "\t\t%50s  %50s  %50s %50s" "----------------------------------" "----------------------------------" "----------------------------------" "----------------------------------"] 
				    set toggle_dash 1  	
				}
				if { [regexp "_Waived" $comment ] && $toggle_dash == 1 }  { 
				    autodesign_puts_tee $out_p  [format  "\t\t%50s  %50s  %50s %50s" "----------------------------------" "----------------------------------" "----------------------------------" "----------------------------------"] 
				    set toggle_dash 0  	
				}

				autodesign_puts_tee $out_p  [format  "\t\t%50s  %50s  %50s %40s" "$clk1_name" "$clk2_name" "$relation" "$comment"]   
			#}	
		}
	}	
	autodesign_puts_tee $out_p  [format  "\t\t%50s  %50s  %50s %50s" "----------------------------------" "----------------------------------" "----------------------------------" "----------------------------------"]   
	autodesign_puts_tee $out_p  "\n\n"
	set review_list [list]
	foreach xcat [array names review_stat] {
		autodesign_puts_tee $out_p  [format  "\t\t<Info> %20s  %-50s" $review_stat($xcat)  $xcat]
		lappend review_list "$xcat=$review_stat($xcat)"
	}
	autodesign_puts_tee $out_p  "\n\n"
	puts "\033\[1;34m<OPEN> File :   \033\[1;31m[file normalize $xfile]\033\[0m"

	close $out_p
	return [list $review_list [file normalize $xfile]]

}
##------------------------------------------------------------------
## ProcNameEnd    : autodesign_get_clockgroup
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : autodesign_get_register_graph
## ProcArguments  : autodesign_get_register_graph cells target_ddata target_qdata extra_regexp outdir
## ProcDependency : autodesign_get_wildcard 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc autodesign_get_register_graph {cells target_ddata target_qdata extra_regexp outdir} {
	set all_registers [get_cells $cells]
	set reg_count     [sizeof_collection $all_registers] 
	array unset reg_maps
	array unset reg_logs
	array unset reg_stat
	array unset reg_pins

	file mkdir $outdir
	set out1 [open "$outdir/nodelist.csv" w+]
	set patlist [list {_\*_} {\*+}]
	set nodenames [get_object_name $all_registers]
	set nodepats   [lsort -uniq [autodesign_get_wildcard $patlist $nodenames]]
	set reg_pins(ddata) ""
	set reg_pins(qdata) ""
	set myddata   [split $target_ddata ","]
	set myqdata   [split $target_qdata ","]
	foreach nodepat $nodepats {
		set reg_map($nodepat)  [get_cells $nodepat]
		set reg_stat($nodepat) [sizeof_collection $reg_map($nodepat)]
		foreach dpin $myddata {
			append_to_collection -unique reg_pins(ddata) [get_pins -quiet $nodepat/$dpin]
		}	
		foreach qpin $myqdata {
			append_to_collection -unique reg_pins(qdata) [get_pins -quiet $nodepat/$qpin]
		}	
	}
	
	#foreach_in_collection x $all_registers {
	#	set nodename [get_object_name $x]
	#	set nodepat [autodesign_get_wildcard $patlist $nodename]
	#	if { [info exist reg_stat($nodepat)] } {
	#	   set reg_stat($nodepat) [expr $reg_stat($nodepat) + 1]
	#	} else {
	#	   set reg_stat($nodepat) 1
	#	}
	#}
	foreach nodeC [array names reg_stat] {
		puts $out1 "$nodeC,$reg_stat($nodeC)"
	}
	close $out1
	set node_count [llength [array names reg_stat]]
	puts "    -  OutPut Dir      = $outdir"
	puts "    -  Found Regs      = $reg_count"
	puts "    -  Found Patterns  = $node_count"
	puts "    -  Compression     = [expr int($reg_count / $node_count)]"
	puts "    -  Extra RegExp    = $extra_regexp"
	puts "    -  Target Q        = $target_qdata ([sizeof_collection $reg_pins(qdata)])"
	puts "    -  Target D        = $target_ddata ([sizeof_collection $reg_pins(ddata)])"

	
}
##------------------------------------------------------------------
## ProcNameEnd    : autodesign_get_register_graph
##------------------------------------------------------------------


