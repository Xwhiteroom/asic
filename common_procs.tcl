##------------------------------------------------------------------
## ProcNameStart  : sta_qc_report_libfiles
## ProcArguments  : sta_qc_report_libfiles Xfilename
## ProcDependency :  
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qc_report_libfiles Xfilename {
    global CORNER

    echo "####################################################################################################" >  $Xfilename
    echo "## File       : $Xfilename" >> $Xfilename
    echo "## Description: Contains list of libs and paths read." >> $Xfilename
    echo "####################################################################################################" >> $Xfilename
    echo [format "%10s %30s %10s %80s %s" "#STATUS_PVTRU" "#CORNER"  "#USAGE" "#LIB_NAME"    "#FILE_NAME"] >> $Xfilename


    foreach_in_collection lib [get_libs *] {
        set lib_path [get_object_name $lib]
        set pvt_p   0
        set pvt_v   0
        set pvt_t   0
        set pvt_rc  0
        set lib_used 0

        foreach process_combo [list sspg ffpg sfg fsg] {
             if { [regexp $process_combo $CORNER] } {
                if { [regexp $process_combo $lib_path] } {
                    set pvt_p "1"
                }
             }
        }

        foreach voltage_combo [list 1p1000v 1p0000v 0p9000v 0p8000v 0p7900v 0p7100v 0p6100v 0p5400v 0p4750v] {
             if { [regexp $voltage_combo $CORNER] } {
                if { [regexp $voltage_combo $lib_path] } {
                    set pvt_v "1"
                }
             }
        }

        foreach temperature_combo [list 125c m25c] {
             if { [regexp $temperature_combo $CORNER] } {
                if { [regexp $temperature_combo $lib_path] } {
                    set pvt_t "1"
                }
             }
        }

        foreach rc_combo [list rcmax cmax cmin rcmin] {
             if { [regexp $rc_combo $CORNER] } {
                if { [regexp "sig$rc_combo" $lib_path] || [regexp "ln05lpe_sc_.*nominal" $lib_path]  } {
                    set pvt_rc "1"
                }
             }
        }


        #set count 1
        set count [sizeof_collection [get_cells -quiet -of_object [get_lib_cells -quiet $lib_path/*]]]

        if { $count > 0 } { set lib_used 1 }
        set status_word "${pvt_p}${pvt_v}${pvt_t}${pvt_rc}${lib_used}"
        
        if { [regexp "0...1" $status_word] } { set STATUS "FAILED_$status_word" }
        if { [regexp ".0..1" $status_word] } { set STATUS "FAILED_$status_word" }
        if { [regexp "..0.1" $status_word] } { set STATUS "FAILED_$status_word" }
        if { [regexp "...01" $status_word] } { set STATUS "FAILED_$status_word" }
        if { [regexp "....0" $status_word] } { set STATUS "WAIVED_$status_word" }        
        if { [regexp "11111" $status_word] } { set STATUS "PASSED_$status_word" }

        set path     [get_attr -quiet [get_lib $lib_path] source_file_name]
        regsub {.db$} $path {.lib.gz} x
        if { [file exist $x] } { 
	    set path $x
        }
        echo [format "%10s %30s %10s %80s %s" "$STATUS" "$CORNER" "$count" "$lib_path"  "$path"] >> $Xfilename
        #puts "**STA_LIB_INFO: $lib_path: $path"
    }
    puts "**STA_LIB_INFO: Dumped Lib File as $Xfilename"
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qc_report_libfiles
##------------------------------------------------------------------


