proc autodesign_get_blocks {} {
	global SPEF_SUBS
	set modules [list]
	foreach {x y} $SPEF_SUBS {
		lappend modules [get_attribute [get_cells $x] ref_name]
	}
	return [lsort -unique $modules]
}
