## ProcNameStart  : sta_qc_report_pathfull
## ProcArguments  : sta_qc_report_pathfull BASE_TAG rep_dir args
## ProcDependency : sta_qc_report_pathfullclock , sh , sta_qc_report_cellpin 
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qc_report_pathfull {BASE_TAG rep_dir args} {
    global MODE CORNER my_flow_control
    set my_design [get_object_name [current_design ]]
    file mkdir $rep_dir
    set max_paths          1000000
    set slack_lesser_than  -0.0009
    set slack_greater_than -999999

    # Cell_pin_attr first 
    sta_qc_report_cellpin  $rep_dir/attr.cellpin.${BASE_TAG}.rpt "seq"

    set delay_checks [list max min]
    if { [lindex $args 0] >  0     } { set max_paths [lindex $args 0]}
    if { [lindex $args 1] != ""    } { set slack_lesser_than [lindex $args 1 ]}
    if { [regexp "ffpg" $BASE_TAG] } { set delay_checks [list min]; set max_paths 500000}
    if { [lindex $args 2] == "max" } { set delay_checks [list max];}
    if { [lindex $args 2] == "min" } { set delay_checks [list min];}

    # Dump timing reports
    foreach checkx $delay_checks {
            echo "** STA_CFG_INFO: Start dumping timing reports: ${checkx}_path full $max_paths Slack=$slack_lesser_than     [date]"            
            report_timing -include -pba_mode path -nworst 5 -max_path $max_paths -nets -nosplit -input_pins -crosstalk_delta -capacitance -transition_time -delay_type $checkx -path full -unique_pins -slack_lesser_than $slack_lesser_than  > $rep_dir/path.$checkx.${BASE_TAG}.rpt
            echo "** STA_CFG_INFO: Done  dumping timing reports: ${checkx}_path full $max_paths Slack=$slack_lesser_than     [date]"            
    }
    # Dump JSON reports
    foreach checkx $delay_checks {
            echo "** STA_CFG_INFO: Start dumping timing  jsons: ${checkx}_path full $max_paths      [date]" 
            puts "python3  $my_flow_control/pd_shell/get_vios.py  --tech $my_flow_control/project_config/WHI.5LPE.project_tech.json  --mode $MODE --check $checkx  --corner $CORNER --design $my_design  --out $rep_dir/path.$checkx.$BASE_TAG.json $rep_dir/path.$checkx.${BASE_TAG}.rpt --cellpin $rep_dir/attr.cellpin.${BASE_TAG}.json --debug 1"
            catch { sh python3  $my_flow_control/pd_shell/get_vios.py  --tech $my_flow_control/project_config/WHI.5LPE.project_tech.json  --mode $MODE --check $checkx  --corner $CORNER --design $my_design  --out $rep_dir/path.$checkx.$BASE_TAG.json $rep_dir/path.$checkx.${BASE_TAG}.rpt --cellpin $rep_dir/attr.cellpin.${BASE_TAG}.json --debug 1  }
            echo "** STA_CFG_INFO: Done  dumping timing  jsons: ${checkx}_path full $max_paths      [date]"            
    };
    # Dump Full clock reports
    if { [lindex $args 3] == "" } {
        #catch { sta_qc_report_pathfullclock $BASE_TAG $rep_dir}
    }

}
