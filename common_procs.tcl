##------------------------------------------------------------------
## ProcNameStart  : sta_qual_report_summary_capload
## ProcArguments  : sta_qual_report_summary_capload sram_lib_cells out_dir
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_report_summary_capload {sram_lib_cells out_dir} {	
	global CORNER MODE 
        set  XDESIGN [get_object_name [current_design]]
	file mkdir $out_dir
	if { [file exists $TOP_DESIGN.$MODE.$CORNER.macro_output_cap.detail.rpt] } {exec rm $TOP_DESIGN.$MODE.$CORNER.macro_output_cap.detail.rpt}
	if { [file exists $TOP_DESIGN.$MODE.$CORNER.macro_output_cap.error.rpt] } {exec rm $TOP_DESIGN.$MODE.$CORNER.macro_output_cap.error.rpt}
	
	set fp1 [open "$out_dir/$XDESIGN.$MODE.$CORNER.macro_output_cap.detail.rpt" w+]
	set fp2 [open "$out_dir/$XDESIGN.$MODE.$CORNER.macro_output_cap.error.rpt" w+]
	
	set all_macro_libs [get_lib_cells $sram_lib_cells]
	
	foreach_in_collection macro_lib $all_macro_libs {
		if {[sizeof_collection [get_cells -of $macro_lib -q]]} {
		puts $fp1 "\n################################################################################################"
		puts $fp1 "################################################################################################"
		puts $fp1 "#Lib cell: [ get_object_name $macro_lib]"
		puts $fp1 "################################################################################################"
		puts $fp1 "################################################################################################\n"
		set macro_insts [ get_cells -of $macro_lib]
		foreach_in_collection macro_inst $macro_insts {
		puts $fp1 "\n#################################################"
		puts $fp1 "#Lib cell: [ get_object_name $macro_lib]"
		puts $fp1 "##Lib Inst: [ get_object_name $macro_inst] : cap(pf)"
		puts $fp1 "#################################################\n"
		foreach_in_collection pin [filter_collection [ get_pins -of $macro_inst ] "direction==out" ] {
			set cap [ get_attribute [get_pins $pin] effective_capacitance_max]
			puts $fp1 "[ get_object_name $pin] : $cap"
			    if {[expr {$cap > 0.025}]} {
	                        puts $fp2 "[ get_object_name $macro_lib]: [ get_object_name $pin] : $cap"
	                    }
			}
		}
	}
	}
	
	close $fp1
	close $fp2
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_report_summary_capload
