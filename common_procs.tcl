##------------------------------------------------------------------
## ProcNameStart  : sta_qual_set_port_delay
## ProcArguments  : sta_qual_set_port_delay direction dlypct latency max_min io_clockx port_name clock_fall fh
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_set_port_delay {direction dlypct latency max_min io_clockx port_name clock_fall fh} {
    global synopsys_program_name pt_shell_mode
    global sta_qual_clock_period_db sta_qual_io_latency
    foreach_in_collection io_clock [get_clocks -quiet $io_clockx] {
        set io_clock  [get_object_name $io_clock]
        if { [info exists sta_qual_clock_period_db($io_clock)] } {
            set period $sta_qual_clock_period_db($io_clock)
            puts "For IO delay taking period from internal database $io_clock"
        } else {
            set period    [get_attribute [get_clocks $io_clock] period]
        }

        if { [info exists sta_qual_io_latency($io_clock)] } {
            set latency $sta_qual_io_latency($io_clock)
        }

        if { [info exists ::pt_shell_mode] && $latency != 0 } {
            if { [get_attr [get_clocks $io_clock] propagated_clock] } {
                set extra_opt " -network_latency_included"
            } else {
                set extra_opt ""
            }
        } else {
            set extra_opt ""
        }

        if { $direction == "in"} {
            set dlyval   [expr ($period * $dlypct) + $latency]
            puts "**STA_SDC_INFO:  IO: Setting Input  Delay -$max_min for $port_name @ $io_clock as  $dlyval=(B=$dlypct * T=$period  + L=$latency) clock_fall=$clock_fall"
            if { [string compare -nocase $clock_fall "true"] == 0 } {
              if { [sizeof_collection [get_ports -quiet $port_name ]] > 0 } {
                puts "#CMD set_input_delay   $dlyval -$max_min -add -clock [get_object_name [get_clocks $io_clock]] \[get_ports -quiet $port_name \] -clock_fall $extra_opt"
                puts $fh "set_input_delay   $dlyval -$max_min -add -clock [get_object_name [get_clocks $io_clock]] \[get_ports -quiet $port_name \] -clock_fall $extra_opt"
                #set_input_delay   $dlyval -$max_min -add -clock [get_clocks $io_clock] [get_ports -quiet $port_name -filter "direction==in"] -clock_fall
              } else {
                puts $fh "#ERROR: Port not found to apply IO Delay : $port_name"
                puts     "ERROR: Port not found to apply IO Delay : $port_name"
              }
            } else {
              if { [sizeof_collection [get_ports -quiet $port_name ]] > 0 } {
                puts "#CMD set_input_delay   $dlyval -$max_min -add -clock [get_object_name [get_clocks $io_clock]] \[get_ports -quiet $port_name \] $extra_opt"
                puts $fh "set_input_delay   $dlyval -$max_min -add -clock [get_object_name [get_clocks $io_clock]] \[get_ports -quiet $port_name \] $extra_opt"
                #set_input_delay   $dlyval -$max_min -add -clock [get_clocks $io_clock] [get_ports -quiet $port_name -filter "direction==in"]
              } else {
                puts $fh "#ERROR: Port not found to apply IO Delay : $port_name"
                puts     "ERROR: Port not found to apply IO Delay : $port_name"
              }
            }
        } else {
            set dlyval   [expr ($period * $dlypct) - $latency]
            puts "**STA_SDC_INFO:  IO: Setting Output Delay -$max_min for $port_name @ $io_clock as  $dlyval=(B=$dlypct * T=$period  - L=$latency) clock_fall=$clock_fall"
            if { [string compare -nocase $clock_fall "true"] == 0 } {
              if { [sizeof_collection [get_ports -quiet $port_name ]] > 0 } {
                puts "#CMD  set_output_delay  $dlyval -$max_min -add -clock [get_object_name [get_clocks $io_clock]]  \[get_ports -quiet $port_name\] -clock_fall $extra_opt"
                puts $fh "set_output_delay  $dlyval -$max_min -add -clock [get_object_name [get_clocks $io_clock]]  \[get_ports -quiet $port_name\] -clock_fall $extra_opt"
                #set_output_delay  $dlyval -$max_min -add -clock [get_clocks $io_clock] [get_ports -quiet $port_name -filter "direction==out"] -clock_fall
              } else {
                puts $fh "#ERROR: Port not found to apply IO Delay : $port_name"
                puts     "ERROR: Port not found to apply IO Delay : $port_name"
              }
            } else {
              if { [sizeof_collection [get_ports -quiet $port_name ]] > 0 } {
                puts "#CMD set_output_delay  $dlyval -$max_min -add -clock [get_object_name [get_clocks $io_clock]]  \[get_ports -quiet $port_name\] $extra_opt"
                puts $fh "set_output_delay  $dlyval -$max_min -add -clock [get_object_name [get_clocks $io_clock]]  \[get_ports -quiet $port_name\] $extra_opt"

                #set_output_delay  $dlyval -$max_min -add -clock [get_clocks $io_clock] [get_ports -quiet $port_name -filter "direction==out"]
              } else {
                puts $fh "#ERROR: Port not found to apply IO Delay : $port_name"
                puts     "ERROR: Port not found to apply IO Delay : $port_name"
              }
            }
        }
    }

}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_set_port_delay
