  puts "**Info: Parsing collection for inputs  : [sizeof_collection $all_reg_collection(in)]"
  # Create Pin Collection : reg2out
  set  all_regs [get_pins -of_object [all_registers] -filter "is_clock_pin" ] 
  set  all_reg_collection(all) $all_regs
  puts "**Info: Parsing collection for allreg  : [sizeof_collection $all_reg_collection(all)]"

  # Dump reports
  array unset data_to_parse
  array unset data_to_parse_class
  

  foreach direction [array names all_reg_collection] {  
   	foreach mode {launch capture} {
  		file mkdir $dir/$direction.$mode
  		puts "\n"
  		set  infile "$dir/$direction.$mode/avg_lat.$mode.$direction.rpt" 
		puts "**Info:[date] Latency Data : Dumping Latency Report... $direction.$mode"    
		puts "                       <CMD> report_clock_timing -$mode -type latency -to $all_reg_collection($direction) -nworst $nworst -nosplit > $infile  "
		if { $args != "skip"}  { report_clock_timing -type latency -$mode -nworst $nworst -nosplit -to $all_reg_collection($direction) > $infile;};
		puts "**Info:[date]: Latency Data : Processing through perl"
		puts "                       <CMD> eval exec  perl $filex $corner $infile $dir/$direction.$mode  $direction.$mode"    
    	eval exec  perl $filex corner $infile $dir/$direction.$mode  $direction.$mode
		puts "**Info:[date]: Latency Data : Processed $dir/$direction.$mode/my_latency.${direction}.${mode}.csv"

        set in_temp [open $dir/$direction.$mode/my_latency.$direction.$mode.csv]
       	while { [gets $in_temp line] >= 0 } {
       		set line_data [split $line ","]       		
       		set pvt  [lindex $line_data 0]       	
       		set clx  [lindex $line_data 1]          		
       		set clk  [lindex $line_data 2]   
       		set snk  [lindex $line_data 3]   
       		set avg  [lindex $line_data 5]
       		set data_to_parse($clk)   $clx
       		set data_to_parse_class($clk.$clx)  "$pvt,$snk,$avg"
       	}		
        close $in_temp
        #CORNER  #CLASS       #CLOCK         #TOTAL_REGISTERS  #LATENCY_SUM  #LATENCY_AVG  #LATENCY_MAX  #LATENCY_MIN
	#sh cat $dir/$direction.$mode/my_latency.$direction.$mode.csv | column -t -s ","
	}
  }
  puts "\n\n"

}
