##------------------------------------------------------------------
proc sta_qual_report_summary_sanity args {
    global MODE CORNER
    puts "INFO:: Parsing argumnets"
    set MY_DESIGN  [get_object_name [current_design ]]
    ## Parse Arguments
	parse_proc_arguments -args $args results 
	
