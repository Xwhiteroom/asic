## ProcNameStart  : autodesign_print_stage
## ProcArguments  : autodesign_print_stage red_blue comment
## ProcDependency :  
## ProcInfluence  : 18
## ProcRenamed    : 0
##------------------------------------------------------------------
proc autodesign_print_stage {red_blue comment} {
      if { $red_blue == "blue" } {
              puts [format "\033\[34m%-30s %-100s \033\[0m" [date] "$comment" ]
      } else {
              puts [format "\033\[31m%-30s %-100s \033\[0m" [date] "$comment" ]  
      }
}
