##------------------------------------------------------------------
## ProcNameStart  : sta_qual_io_budget_default
## ProcArguments  : sta_qual_io_budget_default ports input_delay output_delay valid_io_clocks temp_file_name
## ProcDependency : sta_qual_io_map 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_io_budget_default {ports input_delay output_delay valid_io_clocks temp_file_name} {
    global synopsys_program_name pt_shell_mode
    set clk_srcs            [get_attribute [get_clocks $valid_io_clocks] sources]
    set clk_ports           [remove_from_collection -intersect [get_ports  -quiet $clk_srcs ] [all_inputs]]
    set data_ports          [remove_from_collection [get_ports -quiet $ports] $clk_ports]
    set i 1
    set place_hold 1;proc x_sort_clk { clocks} {
            set clocks [get_clocks -quiet $clocks]
            set listx [list]
            foreach_in_collection clk $clocks {
                if { [sizeof_collection [get_attribute -quiet $clk sources]] > 0 && [get_attribute -quiet $clk is_generated] == false} {
                        lappend listx "[get_attribute -quiet $clk period]:[get_object_name $clk]"
                }
            }
            set listx [lsort -increasing $listx]
            return $listx
        }
    echo "# Base File Used For I/O bugetting [date]" > $temp_file_name
    echo "# Filtered File Used For I/O bugetting [date]" > $temp_file_name.log
    echo "# CrossCorner File Used For I/O bugetting        [date]" > $temp_file_name.global.tcl
    #Class	#Setup	#Hold	#Freq_Scale	#Latency	#Direction	#Extra_Arg	#Clock	#Port	#Clock_Fall	#Condition

    echo [format "#sta_qc_set_port_delay %10s %15s %40s %10s %30s %40s" "dir" "maxminpct" "\$GCKIOLAT(avg_lat)" "maxmin" "io_clk" "port" ] >> $temp_file_name.global.tcl
    echo [format "%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s" "#Class" "#Setup(%)" "#Hold(%)"  "#MCP"  "#Latency" "#Direction" "#Extra_Arg" "#Clock" "#Port" "#Clock_Fall" "#Condition" ] > $temp_file_name.full.csv
    echo [format "%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s" "#Class" "#Setup(%)" "#Hold(%)"  "#MCP"  "#Latency" "#Direction" "#Extra_Arg" "#Clock" "#Port" "#Clock_Fall" "#Condition" ] > $temp_file_name.zip.csv

    echo "puts \"**STA_SDC_INFO:  IO: Start Sourcing Budget File : $temp_file_name \[date\]\""  >> $temp_file_name
    array unset full_data
    array unset zip_data
    set top_design  [get_object_name [current_design ]]

    foreach_in_collection port $data_ports {
        set port_data  [sta_qual_io_map $port]
        set clock_data [lindex [split $port_data ","] end-2]
        set clock_cnt  [lindex [split $port_data ","] end-1]
        set direction  [lindex [split $port_data ","] 2]
        # Highlight unclocked I/Os
        if { $clock_cnt == "0" } {
            echo "**STA_SDC_WARN:  IO: PORT_HAS_NO_SEQ_SINK:  [get_object_name $port] : {no_clocks} : Direction=$direction" >> $temp_file_name.log
        } else {
            set clock_list [list]
            foreach per_clk $clock_data {
              set ext_clk [lindex [split $per_clk ":"] 1]
              lappend clock_list $ext_clk
            }
            # Highlight Unclocked i/o's with invalid clocks
            set valid_clks [remove_from_collection -intersect $valid_io_clocks [get_clocks $clock_list]]
            if { [sizeof_collection $valid_clks] == 0 } {
                echo "**STA_SDC_WARN:  IO: PORT_HAS_SEQ_SINK_WITH_INVALID_CLKS:  [get_object_name $port] : $clock_data : Direction=$direction"  >> $temp_file_name.log
            } else {
                set valid_clock_data [x_sort_clk $valid_clks]
                set clks_to_add ""
                foreach per_clk $valid_clock_data {
                    set io_per   [lindex [split $per_clk ":"] 0]
                    set io_clk   [lindex [split $per_clk ":"] 1]
                    set in_dly   [expr $io_per * $input_delay]
                    set out_dly  [expr $io_per * $output_delay]
                    set clks_to_add "$clks_to_add $io_clk"
                    set dly_target ""
                    if { $direction == "in" } {
                        echo "set_input_delay  [format "%.3f" $in_dly] -add  -max -clock \[get_clocks $io_clk\] \[get_ports [get_object_name $port] \];#$port_data" >> $temp_file_name
                        echo "set_input_delay  [format "%.3f" 0] -add  -min -clock \[get_clocks $io_clk\] \[get_ports [get_object_name $port] \];#$port_data" >> $temp_file_name
                        set dly_target "$input_delay"
                    } else {
                        echo "set_output_delay [format "%.3f" $out_dly] -add  -max -clock \[get_clocks $io_clk\] \[get_ports [get_object_name $port] \];#$port_data" >> $temp_file_name
                        echo "set_output_delay [format "%.3f" 0] -add   -min -clock \[get_clocks $io_clk\] \[get_ports [get_object_name $port] \];#$port_data"  >> $temp_file_name
                        set dly_target "$output_delay"
                    }
                    set port_name [get_object_name $port]
                    regsub -all {[0-9]+} $port_name {*} port_name_wildcard

                    echo [format "sta_qual_set_port_delay  %10s %35s %40s %10s %30s %40s false" $direction "$dly_target" "\$sta_qual_io_latency($io_clk)" "max" $io_clk "{[get_object_name $port]}"] >> $temp_file_name.global.tcl
                    echo [format "sta_qual_set_port_delay  %10s %35s %40s %10s %30s %40s false" $direction "0"           "\$sta_qual_io_latency($io_clk)" "min" $io_clk "{[get_object_name $port]}"] >> $temp_file_name.global.tcl

                    regsub -all {\[|\]} "$io_clk,$port_name" {.} idx
                    set full_data($idx) [format "%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s" "sta_qual_set_port_delay" "$dly_target" "$dly_target"  "1"  "\$sta_qual_io_latency($io_clk)" "$direction" "" "$io_clk" "{$port_name}" "" "\$XDESIGN == {$top_design}" ]
                    regsub -all {\[|\]} "$io_clk,$port_name_wildcard" {.} idx
                    set zip_data($idx)  [format "%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s" "sta_qual_set_port_delay" "$dly_target" "$dly_target"  "1"  "\$sta_qual_io_latency($io_clk)" "$direction" "" "$io_clk" "{$port_name_wildcard}" "" "\$XDESIGN == {$top_design}" ]
                }
                #echo [format "#sta_qual_set_port_delay %10s %30s \[list %s \]" $direction [get_object_name $port] $clks_to_add] >> $temp_file_name.global.tcl
                echo "**STA_SDC_INFO:  IO: PORT_HAS_SEQ_SINK_WITH___VALID_CLKS:  [get_object_name $port] : $valid_clock_data] : Direction=$direction"   >> $temp_file_name.log
            }
        }
        incr i
    }

    foreach nameid [array names full_data] {
        echo "$full_data($nameid)" >>  $temp_file_name.full.csv
    }
    foreach nameid [array names zip_data] {
        echo "$zip_data($nameid)" >>  $temp_file_name.zip.csv
    }

    puts "**STA_SDC_INFO:  IO: Budget File Sourced : $temp_file_name"
    puts "**STA_SDC_INFO:  IO: Budget File Log     : $temp_file_name.log"
    puts "**STA_SDC_INFO:  IO: Budget File Log     : $temp_file_name.global.tcl"
    puts "**STA_SDC_INFO:  IO: Budget File CSV     : $temp_file_name.full.csv"
    puts "**STA_SDC_INFO:  IO: Budget File CSV     : $temp_file_name.zip.csv"

    echo "puts \"**STA_SDC_INFO:  IO: Done Sourcing Budget File : $temp_file_name \[date\]\""  >> $temp_file_name

    return $temp_file_name
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_io_budget_default
