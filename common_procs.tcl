##------------------------------------------------------------------
## ProcNameStart  : get_io_budgets
## ProcArguments  : get_io_budgets c2q c2d d2q budgets
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc get_io_budgets {c2q c2d d2q budgets} {
	echo "#I/O Spec : C2Q=${c2q}% C2D=${c2d}% D2Q=${d2q}ns" > $budgets
	echo "set use_mode delay; # anno/delay/both" >> $budgets
	echo "set c2q $c2q; # clk to q" >> $budgets
	echo "set c2d $c2d; # setup" >> $budgets
	echo "set d2q $d2q; # in2 out" >> $budgets

        echo "if {\$use_mode == {delay} || \$use_mode == {both}} {" >> $budgets
	echo "set_max_delay \$d2q -from \[all_inputs\] -to \[all_outputs\]" >> $budgets
        echo "}" >> $budgets
	echo "if {\$use_mode == {anno} || \$use_mode == {both}} {" >> $budgets
	echo "set_annotated_delay -net \$d2q -from \[all_inputs\] -to \[all_outputs\]" >> $budgets
        echo "}" >> $budgets
     
	set i_ports [get_ports * -filter "direction==in"]
	set o_ports [get_ports * -filter "direction==out"]
	set a_ports [get_ports]

	puts "**Info:: All_Ports [sizeof_collection $a_ports]"
	puts "**Info:: Inputs    [sizeof_collection $i_ports]\t${c2d}% of T cycle"
	puts "**Info:: Outputs   [sizeof_collection $o_ports]\t${c2q}% of T cycle"
	puts "**Info:: In2Out    [sizeof_collection [add_to_collection $i_ports $o_ports]] $d2q ns"

	foreach_in_collection port [add_to_collection $i_ports $o_ports] {
		set spec [port_clock $port]
		regsub -all {\}} $spec {} spec
		regsub -all {\{} $spec {} spec
                set data [split $spec ","]
		set portx 	[lindex $data 0]
		set direction 	[lindex $data 1]
		set finout 	[lindex $data 2]
		set period 	[lindex $data 3]
		set clockx 	[lindex $data 4]
		#puts "done 0"
		if { $clockx != "" && $direction == "in" } {
		#puts "done 1"
        		echo "if {\$use_mode == {delay} || \$use_mode == {both}} {" >> $budgets
			echo "set_input_delay \[expr ${period}*0.01*(100- \$c2d) \] -add_delay -max -clock \[get_clocks $clockx\] \[get_ports $portx\]; #$spec" >> $budgets
		        echo "}" >> $budgets
			echo "if {\$use_mode == {anno} || \$use_mode == {both}} {" >> $budgets
			echo "set_annotated_delay -net \[expr ${period}*0.01*(\$c2d) \]  -from \[get_ports $portx\]" >> $budgets
        		echo "}" >> $budgets
		} elseif { $clockx != "" && $direction == "out" } {
		#puts "done 2"	
        		echo "if {\$use_mode == {delay} || \$use_mode == {both}} {" >> $budgets
			echo "set_output_delay \[expr ${period}*0.01*(100 -\$c2q)\] -add_delay -max -clock \[get_clocks $clockx\] \[get_ports $portx\];#$spec" >> $budgets
			echo "}" >> $budgets
			echo "if {\$use_mode == {anno} || \$use_mode == {both}} {" >> $budgets
			echo "set_annotated_delay -net \[expr ${period}*0.01*(\$c2q) \] -to \[get_ports $portx\]" >> $budgets
        		echo "}" >> $budgets

		} elseif { $clockx != "" && $direction == "out" && $direction == "in"  } {
		#puts "done 3"
			echo "#**Warn:: BiDi Port $portx; #$spec" >> $budgets
		} elseif { $clockx == "" && $direction == "in" && $finout == 0 } {
		#puts "done 4"
			echo "#**Warn:: Floating input Port $portx; #$spec" >> $budgets
		} elseif  { $clockx == "" && $direction == "out" && $finout == 0 } {
		#puts "done 5"
			echo "#**Warn:: Floating output Port $portx; #$spec" >> $budgets
		} elseif  { $clockx == "" && $direction == "out" && $finout > 0 } {
		#puts "done 6"
			echo "#**Warn:: Static  output Port $portx; #$spec" >> $budgets
		} else {
		#puts "done 7"			
			echo "#**Warn:: Unknown Case Port $portx; #$spec" >> $budgets			
		}
		#puts "done final"

	}

}
