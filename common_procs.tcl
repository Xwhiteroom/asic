##------------------------------------------------------------------
## ProcNameStart  : pt_get_attrx_multi
## ProcArguments  : pt_get_attrx_multi object attributes_list
## ProcDependency :  
## ProcInfluence  : 2
## ProcRenamed    : 0
##------------------------------------------------------------------
proc pt_get_attrx_multi {object attributes_list} {
     	set return_val1 [list ]
     	set return_val2 [list ]

	foreach x $attributes_list {
		set attrx [get_attribute -quiet $object $x]
		if { [llength $attrx] == "1" && [regexp "^_sel" [lindex $attrx 0]] } {
			set attrx [get_object_name $attrx]
		}
		lappend return_val1 "$x,$attrx"
		lappend return_val2 "$attrx"
	}
	return [list $return_val1 $return_val2]
}
##------------------------------------------------------------------
## ProcNameEnd    : pt_get_attrx_multi
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : pt_get_attrx_multi_v
## ProcArguments  : pt_get_attrx_multi_v object attributes_list
## ProcDependency : pt_map_table , pt_get_attrx_multi 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc pt_get_attrx_multi_v {object attributes_list} {
     	set return_val [list [list "#AttrName" "#AttrValue(s)"]]
	set i 0
	foreach x $attributes_list {
        	set return_val [concat $return_val [list [list $x [lindex [lindex [pt_get_attrx_multi $object $attributes_list] 1]  $i]]]]
		incr i
	}
	pt_map_table $return_val
}
