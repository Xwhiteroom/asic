##------------------------------------------------------------------
## ProcNameStart  : cell_pin_ref_clk
## ProcArguments  : cell_pin_ref_clk ret
## ProcDependency :  
## ProcInfluence  : 3
## ProcRenamed    : 0
##------------------------------------------------------------------
proc cell_pin_ref_clk ret {
        set xinst  "[get_cells -quiet -of_objects [get_pins -quiet $ret]]"    
    	set cell "[get_attribute -quiet $xinst ref_name]"
	set name "[get_object_name $ret]"
	set clks [get_attribute -quiet  [get_pins -quiet  $ret] clocks]	
	set clk_name [list]
	if { [sizeof_collection $clks ] == 0 } { 
	     lappend clk_name "NA"
    	} else { 
	     foreach_in_collection cret $clks {lappend clk_name  [get_object_name $cret] ;}
	}
	set opin_type ""
	set clko_name [list]	
	if { [get_attribute  -quiet [get_pins -quiet $ret] direction] == "in"} {
 		set inst "[get_object_name [get_cells -quiet -of_objects [get_pins -quiet $ret]]]"	
		set out [get_pins -quiet $inst/* -filter "direction == out"]
		set clks_out [get_attribute -quiet  [get_pins -quiet  $out] clocks]
		set out_pin  [lindex [split [get_object_name $out] "/"] end]
		if { [sizeof_collection $clks_out ] == 0 } { 
			set opin_type "Clk_Sink:$out_pin"
    		}  else { 
	     		foreach_in_collection cret $clks_out {lappend clko_name  [get_object_name $cret]}
			set thru_clk [list]
			set stop_clk [list]
			set add_clk  [list]

			foreach inclk $clk_name {
			    if { [lsearch -exact $clko_name $inclk] ==  "-1"} { 
				lappend stop_clk $inclk 
			    } else {
				lappend thru_clk $inclk 			    
			    }
			}
			foreach outclk $clko_name {
			    if { [lsearch -exact $clk_name $outclk] ==  "-1"} { 
				lappend add_clk $inclk 
			    }
			}

			if { [llength $add_clk] == 0 &&  [llength $stop_clk] == 0} {set opin_type "Clk_Thru:$out_pin"}
			if { [llength $add_clk] == 0 &&  [llength $stop_clk] != 0} {set opin_type "Clk_Stop:$out_pin"}
			if { [llength $add_clk] != 0 &&  [llength $stop_clk] == 0} {set opin_type "Clk_Addn:$out_pin"}
			if { [llength $add_clk] != 0 &&  [llength $stop_clk] != 0} {set opin_type "Clk_Muxn:$out_pin"}
			
		}

	}
        set comment ""
        if { [sizeof_collection [get_pins $ret -quiet]] > 0} {
             set outslk ""
             set inslk ""
             set suslack ""
             set hdslack ""
             set x       "0"
             set y       "0"
             catch {set x [format "%0.0f" [expr [get_attr -quiet [get_pins $ret] x_coordinate] / 1000]]}
             catch {set y [format "%0.0f" [expr [get_attr -quiet [get_pins $ret] y_coordinate] / 1000]]}
             
             set inst_name [get_object_name $xinst]
             catch {set inslk  [format "%0.3f" [lindex  [lsort  [get_attr [get_pins -quiet -filter "direction==in and is_clock_pin ==false" $inst_name/D* ] max_slack]] end]]}
             catch {set outslk [format "%0.3f" [lindex  [lsort  [get_attr [get_pins -quiet -filter "direction==out" $inst_name/Q* ] max_slack]] end]]}

             catch {set suslack [format "%0.3f" [get_attr [get_pin $ret] max_slack]]}
             catch {set hdslack [format "%0.3f" [get_attr [get_pin $ret] min_slack]]}

            set comment "\[SU=$suslack|HD=$hdslack\]  IN/OUT\[$inslk|$outslk\] X,Y\[$x,$y\]"
        }
        set data [format "%-120s -> %20s @ \[%s\] \[%s\] $comment" $name $cell $clk_name $opin_type]
	return "$data"
}
##------------------------------------------------------------------
## ProcNameEnd    : cell_pin_ref_clk
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : cell_pin_tran
## ProcArguments  : cell_pin_tran cell
## ProcDependency : puts_tee 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc cell_pin_tran cell {
    	if { [sizeof_collection [get_pins -quiet $cell]]} { 
	    set cpins [get_pins -quiet $cell]	    
	    set cell [get_object_name [get_cells -of_objects [get_pins $cell]]]
	} else {
	    set cpins [get_pins -quiet $cell/*]
    	}
	set xfile "temp_cell_tran.info.tcl"
	set out_p [open $xfile w+]
    	set is_p "pin"
	set is_x ""
	if { [sizeof_collection $cpins ] == "0"} {
		set cpins [get_ports $cell/*]
		set is_p "port"
		set is_x "IO"
	
	}
	set pin_len   [expr ([string length $cell] + 20)]
	set ref_len   [string length [get_attribute -quiet  [get_cells $cell] ref_name]]
	set space1    [expr ((${pin_len} - 10)/2)]
	set clock_size "15" 
	foreach clk [get_object_name [get_clocks *]] {
	  if {[string length $clk] >= $clock_size } {
	       set clock_size "[string length $clk]" 
	  }
	}
	set dash1     [expr ( 14 + 15 + $clock_size + ${pin_len})]
	set frmt "|%6s|%6s|%6s|%6s|%${clock_size}s|%-${pin_len}s|"
	puts_tee $out_p "\n\n"
	puts_tee $out_p "+[string repeat "-" ${dash1}]+"
	puts_tee $out_p  [format |%-${dash1}s| "    Ref Lib Cell Used :      [get_attribute -quiet  [get_cells $cell] ref_name]"]
	puts_tee $out_p "+[string repeat "-" 6]+[string repeat "-" 6]+[string repeat "-" 6]+[string repeat "-" 6]+[string repeat "-" ${clock_size} ]+[string repeat "-" ${pin_len}]+"
	puts_tee $out_p [format $frmt "Const"  "Dir" "Tran_R"  "Tran_F" "Clocks"  "[string repeat " " ${space1}]Cell Pin[string repeat " " ${space1}]"]
	puts_tee $out_p "+[string repeat "-" 6]+[string repeat "-" 6]+[string repeat "-" 6]+[string repeat "-" 6]+[string repeat "-" ${clock_size}]+[string repeat "-" ${pin_len}]+"
	foreach_in_collection pin $cpins {
	  set pinx  [filter_collection [all_fanin -to $pin -pin_level 1 -flat ] "direction==out"]
	  if {[sizeof_collection [get_attribute -quiet  [get_${is_p} -quiet $pinx] clocks]] != 0} {
	  set no_of_clk [sizeof_collection [get_attribute -quiet  [get_${is_p} -quiet $pinx] clocks]]
	  set current_clk 0
	   while { $current_clk < $no_of_clk} {
	      set clocks [lindex [get_object_name [get_attribute -quiet  [get_${is_p} -quiet  $pinx] clocks]] $current_clk]
	      incr current_clk
	      set  my_period [format "%.3f" [get_attribute -quiet [get_clocks $clocks] period]]	      
	      if { $current_clk == 1} {
	           #puts_tee $out_p [format $frmt  "" "" "" "" "$clocks" ""]   
                   set tran_r "x"; set tran_f "x"
		   catch { set tran_r [format "%0.3f" [get_attribute -quiet  [get_${is_p} $pinx] actual_rise_transition_max]]}
		   catch { set tran_f [format "%0.3f" [get_attribute -quiet  [get_${is_p} $pinx] actual_fall_transition_max]]}
	           puts_tee $out_p [format $frmt  "$my_period" "$is_x [get_attribute -quiet  [get_${is_p} $pin] ${is_p}_direction]" "$tran_r" "$tran_f" "$clocks" "[get_object_name [get_${is_p} $pin]]" ]
	      } else {
	           puts_tee $out_p [format $frmt  "$my_period" "" "" "" "$clocks" "" ]
	      }
	   }
	  } else {
            set tran_r "x"; set tran_f "x"              
	    catch { set tran_r [format "%0.3f" [get_attribute -quiet  [get_${is_p} $pinx] actual_rise_transition_max]]}
	    catch { set tran_f [format "%0.3f" [get_attribute -quiet  [get_${is_p} $pinx] actual_fall_transition_max]]}
	    puts_tee $out_p [format $frmt "[get_attribute -quiet  [get_${is_p} $pinx] case_value]" "$is_x [get_attribute -quiet  [get_${is_p} $pin] ${is_p}_direction]" "$tran_r" "$tran_f" ""  "[get_object_name [get_${is_p} $pin]]"]
	  }
	 }
	puts_tee $out_p "+[string repeat "-" 6]+[string repeat "-" 6]+[string repeat "-" 6]+[string repeat "-" 6]+[string repeat "-" ${clock_size}]+[string repeat "-" ${pin_len}]+"
	puts_tee $out_p "\n\n"
	close $out_p
	puts "\t**Open file $xfile"
}
