##------------------------------------------------------------------
## ProcNameStart  : sta_qual_report_summary_latency
## ProcArguments  : sta_qual_report_summary_latency corner args
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_report_summary_latency {corner args} {
   
  if {[lindex $args 0] == "" } {
    set dir    "./latency_rpt.$corner"
  } else {
    set dir    "[lindex $args 0]/latency_rpt.$corner"      
  }     
  file mkdir $dir


  set skip_rpt [lindex $args 1] 
  if {$skip_rpt == "skip" } {
    set skip_rpt    "skip"
  } else {
    set skip_rpt    "dontskip"      
  } 

  set type_src_ntw [lindex $args 2] 
  if       { $type_src_ntw == "" } {
    set type_src_ntw    "total"
  } elseif { $type_src_ntw == "network" } {
    set type_src_ntw    "network"      
  } elseif { $type_src_ntw == "source" } {
    set type_src_ntw    "source"      
  } elseif { $type_src_ntw == "network_source" || $type_src_ntw == "source_network"} {
    set type_src_ntw    "network_source"      
  } else {
    set type_src_ntw    "total"
  }      
    
  # Dump Latency Script
  set script "\n #!/usr/bin/perl\n use strict;use warnings;use File::Basename;\n my \$corner 	  = \"\$ARGV\[0\]\";\n my \$latency_file = \"\$ARGV\[1\]\";\n my \$outdir       = \"\$ARGV\[2\]\";\n my \$tagx         = \"\$ARGV\[3\]\";\n my \$type         = \"\$ARGV\[4\]\";\n\        
	my \$outfile      = \"\$outdir/my_latency.\${tagx}.csv\";\n print(\"Corner      :: \$corner\\n\");\n print(\"LatencyFile :: \$latency_file\\n\");\n print(\"Outdir      :: \$outdir\\n\");\n print(\"Tagx        :: \$tagx\\n\");\n my \$full_data  = \"#CORNER,#CLASS,#CLOCK,#TOTAL_REGISTERS,#LATENCY_SUM,#LATENCY_AVG,#LATENCY_MAX,#LATENCY_MIN\\n\";
	if (defined \$latency_file and -e \$latency_file) { \n open(CLK,\"\$latency_file\") || die \"Can not open Latency File  - \$latency_file for reading.\\n\"; \n my \$clock_flag = 0; my \$no_of_reg = 0;  my \$sum_of_latency = 0;  my \$clock = \"NA\";  \n my \$max_latency =  \"NA\";  my \$min_latency =  \"NA\"; my \$avg_lat = \"NA\"; \n my \$lcnt = 0; my \@line_arr;\n while(my \$line = <CLK>) {\n \$lcnt++;\n if (\$lcnt =~ /00000$/m) { print \"\\t\\tFile \$latency_file -Processed lines = \$lcnt \\n\";}\n chomp \$line;\n if (\$line =~ /^\\s+Clock:/m) {\n if  ( \$clock  eq \"NA\" ) {print \"**Found First Clock \$clock\\n\";}\n if  ( \$clock  ne \"NA\" ) {\n if (\$no_of_reg > 0) {	\$avg_lat = \$sum_of_latency/\$no_of_reg;\$avg_lat = sprintf (\"\%.3f\",\$avg_lat);};\n \$no_of_reg = sprintf (\"\%.0f\",\$no_of_reg);\$sum_of_latency = sprintf (\"\%.3f\",\$sum_of_latency);\n if ( \$max_latency ne \"NA\") {\$max_latency = sprintf (\"\%.3f\",\$max_latency);\$min_latency = sprintf (\"\%.3f\",\$min_latency);};\n print \"\t\t\t Data Clock :: \$clock \$no_of_reg \$sum_of_latency \$max_latency \$min_latency\\n\";\n \$full_data  = \"\$full_data\\n\$corner,\$tagx,\$clock,\$no_of_reg,\$sum_of_latency,\$avg_lat,\$max_latency,\$min_latency\";\n printf temp_clk \"##corner,class,clock,no_of_reg,sum_of_latency,avg_latency,max_latency,min_latency\\n\";\n\				
								printf temp_clk \"##\$corner,\$tagx,\$clock,\$no_of_reg,\$sum_of_latency,\$avg_lat,\$max_latency,\$min_latency\\n\";\n close (temp_clk);\n }\n \$clock = \$line; \$clock =~ s/^\\s+Clock:\\s+//g;  \$clock =~ s/ //g;\n open(temp_clk,\">\$outdir/\$clock.\$tagx.rpt\") ;printf temp_clk \"\$line\\n\";\n \$no_of_reg = 0;  \$sum_of_latency = 0; \$max_latency = \"NA\";   \$min_latency = \"NA\";\$avg_lat = \"NA\";\n };\n if (\$line =~ /\\s0\\.0000\\s/m || \$line =~ /\\srp\-\+/m ){\n \@line_arr  =  split(/\\s+/,$\line);\n my \$rpt_lat = abs(\$line_arr\[5\]);
                                                 if (\$type eq \"network\"       ) { \$rpt_lat = abs(\$line_arr\[4\]);                        };\n if (\$type eq \"source\"        ) { \$rpt_lat = abs(\$line_arr\[3\]);                        };\n if (\$type eq \"source_network\") { \$rpt_lat = abs(\$line_arr\[3\]) + abs(\$line_arr\[4\]); };\n if (\$type eq \"network_source\") { \$rpt_lat = abs(\$line_arr\[3\]) + abs(\$line_arr\[4\]); };\n\                                      
						 # \n #Clock_Pin                            Trans   Source  Network Total\n \$no_of_reg++; \$sum_of_latency = \$sum_of_latency + \$rpt_lat;\n \$avg_lat = \"NA\";\n if (\$max_latency eq \"NA\" || (\$max_latency < \$rpt_lat && \$rpt_lat >  0)  ) { \$max_latency = \$rpt_lat;};\n if (\$min_latency eq \"NA\" || (\$min_latency > \$rpt_lat && \$rpt_lat >= 0)  ) { \$min_latency = \$rpt_lat;};\n printf temp_clk \"\$line\\n\";\n };\n }\n if  ( \$clock  ne \"NA\" ) {\n if (\$no_of_reg > 0) {	\$avg_lat = \$sum_of_latency/\$no_of_reg;\$avg_lat = sprintf (\"\%.3f\",\$avg_lat);};\n \$no_of_reg = sprintf (\"\%.0f\",\$no_of_reg);\$sum_of_latency = sprintf (\"\%.3f\",\$sum_of_latency);\n if ( \$max_latency ne \"NA\") {\$max_latency = sprintf (\"\%.3f\",\$max_latency);\$min_latency = sprintf (\"\%.3f\",\$min_latency);};\n print \"\t\t\t Data Clock :: \$clock \$no_of_reg \$sum_of_latency \$max_latency \$min_latency\\n\";\n \$full_data  = \"\$full_data\\n\$corner,\$tagx,\$clock,\$no_of_reg,\$sum_of_latency,\$avg_lat,\$max_latency,\$min_latency\";\n printf temp_clk \"##corner,class,clock,no_of_reg,sum_of_latency,avg_latency,max_latency,min_latency\\n\";\n\		
								printf temp_clk \"##\$corner,\$tagx,\$clock,\$no_of_reg,\$sum_of_latency,\$avg_lat,\$max_latency,\$min_latency\\n\";\n close (temp_clk);\n }\n print \"\\t\\tFile \$latency_file -Processed lines = \$lcnt \\n\";\n close(CLK) || die \"Can not close Clock File- \$latency_file after reading.\\n\"; \n }\n open (inx1,\">\$outfile\");printf inx1 \"\$full_data\\n\"; close(inx1); \n print \"\\t\\tFile \$latency_file --> \$outfile\\n\";\n "
  set filex "${dir}/get_avg.pl"
  set   out  [open $filex w+]
  puts  $out "$script" 
  close $out
  
  # Initialize collection
  array unset all_reg_collection
  set launch_capture [list launch capture]
  set nworst 10000000  
  #set nworst 1000
  puts "\n\n"
    # Create Pin Collection : reg2out
    set all_regs [get_pins -of [ filter_collection [all_fanin -to [all_outputs] -flat -startpoints_only -only_cells] "is_sequential==true && is_hierarchical==false"] -filter "is_clock_pin"]
    set all_reg_collection(out) $all_regs
    puts "**Info: Parsing collection for outputs : [sizeof_collection $all_reg_collection(out)]"
    # Create Pin Collection : in2reg
    set clock_ports  [get_ports -quiet [get_attr [get_clocks *] sources]]
    set reset_ports  [get_ports -quiet [all_fanin -to  [all_registers -async_pins ] -startpoints_only  -flat]]
    set ScanEN_ports [get_ports -quiet [all_fanin -to [filter [all_fanout -from [all_inputs] -endpoints_only  -flat] "full_name=~*/SE"]  -startpoints_only  -flat]]

    set valid_datain_ports [all_inputs  -exclude_clock_port]
    set valid_datain_ports [remove_from_collection  $valid_datain_ports $clock_ports ]
    set valid_datain_ports [remove_from_collection  $valid_datain_ports $reset_ports ]
    set valid_datain_ports [remove_from_collection  $valid_datain_ports $ScanEN_ports]
    
    set all_regs [get_pins -of [ filter_collection [all_fanout -from $valid_datain_ports -flat -endpoints_only -only_cells] "is_sequential==true && is_hierarchical==false "] -filter "is_clock_pin"]


    set all_reg_collection(in) $all_regs
    puts "**Info: Parsing collection for inputs  : [sizeof_collection $all_reg_collection(in)]"
    # Create Pin Collection : all
    set  all_regs [get_pins -of_object [all_registers] -filter "is_clock_pin" ] 
    set  all_reg_collection(all) $all_regs
    puts "**Info: Parsing collection for allreg  : [sizeof_collection $all_reg_collection(all)]"
  
  # Dump reports
  array unset data_to_parse
  array unset data_to_parse_class
  
  puts "**Info:[date] Report Setting : Latency=$type_src_ntw Skip_rpt=$skip_rpt Corner=$corner Dir=$dir"    
  foreach direction [array names all_reg_collection] {  
   	foreach mode {launch capture} {
  		file mkdir $dir/$direction.$mode
  		puts "\n"
  		set  infile "$dir/$direction.$mode/avg_lat.$mode.$direction.rpt" 
		puts "**Info:[date] Latency Data : Dumping Latency Report... $direction.$mode"    
		puts "                       <CMD> report_clock_timing -$mode -type latency -to $all_reg_collection($direction) -nworst $nworst -nosplit > $infile  "
		if { [lindex $args 1] != "skip"}  { report_clock_timing -type latency -$mode -nworst $nworst -nosplit -to $all_reg_collection($direction) > $infile;};
		puts "**Info:[date]: Latency Data : Processing through perl"
		puts "                       <CMD> eval exec  perl $filex $corner $infile $dir/$direction.$mode  $direction.$mode $type_src_ntw"    
    	        eval exec  perl $filex corner $infile $dir/$direction.$mode  $direction.$mode  $type_src_ntw
		puts "**Info:[date]: Latency Data : Processed $dir/$direction.$mode/my_latency.${direction}.${mode}.csv"

                set in_temp [open $dir/$direction.$mode/my_latency.$direction.$mode.csv]
       	        while { [gets $in_temp line] >= 0 } {
       		    set line_data [split $line ","]       		
       		    set pvt  [lindex $line_data 0]       	
       		    set clx  [lindex $line_data 1]          		
       		    set clk  [lindex $line_data 2]   
       		    set snk  [lindex $line_data 3]   
       		    set avg  [lindex $line_data 5]
       		    if { $clk != "#CLOCK" & $clk != ""} {
                        set data_to_parse($clk)   $clk
       		        set data_to_parse_class($clk.$clx)  "$pvt,$snk,$avg"
                        #echo " -added $clk.$clx $data_to_parse_class($clk.$clx)"
                    }
       	}		
        close $in_temp
        #CORNER  #CLASS       #CLOCK         #TOTAL_REGISTERS  #LATENCY_SUM  #LATENCY_AVG  #LATENCY_MAX  #LATENCY_MIN
		#sh cat $dir/$direction.$mode/my_latency.$direction.$mode.csv | column -t -s ","
	}
  }
  puts "\n\n"
  set outx  [open "$dir/my_latency.$corner.$type_src_ntw.csv" w+]  	
  set data "#CORNER,#CLOCK,#IN_CONE,#IN_MAX(L),#IN_MIN(C),#OUT_CONE(L),#OUT_MAX(L),#OUT_MIN(C),#ALL_CONE,#ALL_MAX(L),#ALL_MIN(C),#LATENCY_TYPE"
  puts $outx "$data"
  #MAX_REG2OUT,$xclk $xclx $data_to_parse($xclk)($xclx)"
  foreach xclk [array names data_to_parse] {
    set data "$corner,$xclk"
    foreach xclx1 [list in out all] { 
        foreach xclx2 [list launch capture] {
            set xclx  "$xclx1.$xclx2"
    	    set extra_data [list 0 0.000 0.000]
            if { [info exist data_to_parse_class($xclk.$xclx)]} {
                set extra_data [split $data_to_parse_class($xclk.$xclx) ","]
            }
            if { $xclx2 == "launch" } { 
                set data "$data,[lindex $extra_data 1]"
            }
            set data "$data,[lindex $extra_data end]"
        }
    }
    puts $outx "$data,$type_src_ntw"
  }
  close $outx
  puts "\n\n"
  puts "**Info:[date]: Latency Data : Final File :: $dir/my_latency.$corner.$type_src_ntw.csv"
}
