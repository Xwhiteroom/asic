##------------------------------------------------------------------
## ProcNameStart  : sta_qual_report_summary_pinmargin
## ProcArguments  : sta_qual_report_summary_pinmargin pin_collection xtlk_to_slack_ratio filex
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_report_summary_pinmargin {pin_collection xtlk_to_slack_ratio filex} {
    global CORNER MODE
    echo "#Corner,#Mode,#RefCell,#BaseName,#Setup,#Hold,#HoldPBA,#Xtlk,#Tran,#Cap,#Res,#Comment,#InstPin" > $filex
    set pin_collection [get_pins -quiet $pin_collection]
    set full_set [sizeof_collection $pin_collection]
    set i 0
    set j 0
    foreach_in_collection xpin $pin_collection {
        set instpin  [get_object_name $xpin]
        set basename [get_attr -quiet $xpin lib_pin_name]
        set refcell  [get_attr -quiet [get_cells -quiet -of_object $xpin] ref_name]

        set slackmax [get_attr -quiet $xpin max_slack]
        set slackmin [get_attr -quiet $xpin min_slack]
        set xtlk_max [get_attr -quiet [get_nets -quiet [all_connected $xpin]] annotated_delay_delta_max]
        set xtlk_min [get_attr -quiet [get_nets -quiet [all_connected $xpin]] annotated_delay_delta_min]
        set loadR    [get_attr -quiet [get_nets -quiet [all_connected $xpin]] net_resistance_max]
        set loadC    [get_attr -quiet [get_nets -quiet [all_connected $xpin]] total_capacitance_max]
        set tran     [get_attribute -quiet  [get_pins -quiet $xpin] actual_transition_max]
        if { $slackmax != "" } {  set slackmax [format "%0.3f" $slackmax]   }
        if { $slackmin != "" } {  set slackmin [format "%0.3f" $slackmin]   }
        if { $xtlk_max != "" } {  set xtlk_max [format "%0.3f" $xtlk_max]   }
        if { $xtlk_min != "" } {  set xtlk_min [format "%0.3f" [expr abs($xtlk_min)]]   }
        if { $loadR    != "" } {  set loadR    [format "%0.3f" $loadR   ]   }
        if { $loadC    != "" } {  set loadC    [format "%0.3f" $loadC   ]   }
        if { $tran     != "" } {  set tran     [format "%0.3f" $tran    ]   }

        set xtlk   [lindex [lsort [list $xtlk_max $xtlk_min]] end]
        set comment ""

        set slackminPBA $slackmin
        if { $slackmin < 0  } {
            set slackminPBA [get_attr [get_timing_paths -pba_mode exhaustive -through $pinx  -delay min] slack]
        }

        if { $slackmin >= 0 && $xtlk == 0 } {
            set comment "HOLD_SAFE_GBA"
        } elseif { $slackminPBA >= 0 && $xtlk == 0 } {
            set comment "HOLD_SAFE_PBA"
        } elseif { $slackmin    > 0    && $xtlk > 0 &&  [expr $xtlk/$slackmin] <= $xtlk_to_slack_ratio } {
            set comment "HOLD_SAFE_GBAXTLKMARGIN"
        } elseif { $slackminPBA > 0    && $xtlk > 0 &&  [expr $xtlk/$slackminPBA] <= $xtlk_to_slack_ratio } {
            set comment "HOLD_SAFE_PBAXTLKMARGIN"
        } elseif { $slackminPBA < 0 } {
            set comment "HOLD_CRITICAL_PBA"
        } elseif { $slackmin < 0 } {
            set comment "HOLD_CRITICAL_GBA"
        } else  {
            set comment "HOLD_CRITICAL_XTLK"
        }

        # Loop Counter
        incr i
        incr j
        if { $j >= [expr $full_set/10] } {
            set j 0
            puts "            - processed $i / $full_set [date]"
        }
        # Data Stream
        set data "$CORNER,$MODE,$refcell,$basename,$slackmax,$slackmin,$slackminPBA,$xtlk,$tran,$loadC,$loadR,$comment,$instpin"
        echo $data >> $filex
    }
    puts "**Info : Open Margin File (Margin=$xtlk_to_slack_ratio) $filex"
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_report_summary_pinmargin
