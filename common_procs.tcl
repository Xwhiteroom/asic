## ProcNameStart  : genrate_sdc_hyperscale
## ProcArguments  : genrate_sdc_hyperscale outdir modules
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc genrate_sdc_hyperscale {outdir modules} {
	global MODE XCORNER
	set valid_blks [list]
	file mkdir $outdir
	foreach blk $modules {
		set inst [lindex [lsort [get_object_name [get_cell -quiet -filter "ref_name==$blk"]]] 0]
		if { $inst != ""} {	
			puts "[date] <HYPER_SCALE> CZ Context for $blk @ $inst"
     			characterize_context -block $blk -instances  $inst -name $blk
			lappend valid_blks $blk
		} else {
			puts "[date] <HYPER_SCALE> Invalid $blk"
		}
	}
	puts "[date] <HYPER_SCALE> WR Context Begins"
     	write_context -clock -format sdc -output $outdir/$MODE/$XCORNER/ -nosplit  -exclude_upf $valid_blks
	puts "[date] <HYPER_SCALE> WR Context Ends"
}
