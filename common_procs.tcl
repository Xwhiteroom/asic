##------------------------------------------------------------------
## ProcNameStart  : rgt_x
## ProcArguments  : rgt_x pba_mode delay args
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc rgt_x {pba_mode delay args} {
    global CORNER MODE
    set xview ""
    set xpwd [pwd]
    if { ![info exist CORNER]} { set xview "corner" }
    if {  [info exist CORNER]} { set xview "$CORNER" }
    if { ![info exist MODE]  } { set xview "$xview.mode"}
    if {  [info exist MODE]  } { set xview "$xview.$MODE"}
    report_timing    -nos > $xpwd/.temp_rgt_file
    set cmdx "report_global_timing -separate_all_groups  -format wide -format wide  -pba_mode  $pba_mode $args"
    if {[regexp maxmin $delay] || [regexp minmax $delay] } { 
        set cmdx "$cmdx" 
    } elseif {[regexp max $delay]}    { 
        set cmdx "$cmdx -delay max" 
    } elseif {[regexp min $delay]}    { 
        set cmdx "$cmdx -delay min "         
    }

    eval "$cmdx > $xpwd/${xview}_rgt.info.$pba_mode.$delay.rpt" 
    set in [open   $xpwd/${xview}_rgt.info.$pba_mode.$delay.rpt ] 
    array unset datax  
    set type    "unknown"
    set group   "unknown"
    set header1 "unknown"
    set header2 "unknown"
    set header3 "unknown"
    set max_len1 "10"
    set max_len2 "20"
    set max_len3 "50"

    while { [gets $in line] >= 0 } {
        #Setup violations for paths in HE.0.TOP
        #
            if { [regexp "violations" $line] }    { set type    "[lindex [split $line " "] 0].$pba_mode" ; set group [lindex [split $line " "] end] 
      } elseif { [regexp "WNS"        $line] }    { set header3 "$line"
      } elseif { [regexp "Total"      $line] }    { set header2 "$line" 
      } elseif { [regexp "\-\-\+"     $line] }    { set header1 "$line" 
      } elseif { [regexp " \| "       $line] && $type != "unknown" }    { 
          set data    "$line" ; 
          set datax(${type}/${group}) "$line" ; 
      }
      if { [string length $type]  > $max_len1 } { set max_len1 [expr 2 + [string length $type]] }
      if { [string length $group] > $max_len2 } { set max_len2 [expr 2 + [string length $group]] }
      if { [string length $line]  > $max_len3 } { set max_len3 [expr 5 + [string length $line]] }

    }
    close $in
    puts [format "%${max_len3}s-%${max_len1}s-%${max_len2}s-%${max_len2}s" $header1 [string repeat "-" ${max_len1}] [string repeat "-" ${max_len2}] [string repeat "-" ${max_len2}] ]    
    puts [format "%${max_len3}s %${max_len1}s %${max_len2}s %${max_len2}s" $header2 "Type.PBA" "PathGroup" "CORNER.MODE"]
    puts [format "%${max_len3}s %${max_len1}s %${max_len2}s %${max_len2}s" $header3 ""         ""           ""]    
    set old_type unknown
    foreach x [lsort [array names datax]] { 
       set type  [lindex [split $x "/" ] 0  ] 
       set group [lindex [split $x "/" ] end]
       if { $type !=  $old_type } {
         puts [format "%${max_len3}s-%${max_len1}s-%${max_len2}s-%${max_len2}s" $header1 [string repeat "-" ${max_len1}] [string repeat "-" ${max_len2}] [string repeat "-" ${max_len2}]  ]    
       }       
       puts [format "%${max_len3}s %${max_len1}s %${max_len2}s %${max_len2}s" "$datax($x)" "$type" "$group" "$MODE.$CORNER"]
       set old_type $type
    }
    puts [format "%${max_len3}s-%${max_len1}s-%${max_len2}s-%${max_len2}s" $header1 [string repeat "-" ${max_len1}] [string repeat "-" ${max_len2}] [string repeat "-" ${max_len2}] ]   

    puts "** Open :  $xpwd/${xview}_rgt.info.$pba_mode.$delay.rpt"
}
