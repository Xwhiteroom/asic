##------------------------------------------------------------------
## ProcNameStart  : pt_report_rail_split
## ProcArguments  : pt_report_rail_split dirx nets
## ProcDependency : parray 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc pt_report_rail_split {dirx nets} {
	file mkdir $dirx
	set dirx [file normalize $dirx] 
	set  rail_nets  [lsort -uniq [get_object_name [get_supply_nets   -quiet $nets]  ]]
	set  rail_ports [lsort -uniq [get_object_name [get_supply_ports  -quiet -of_objects [get_supply_nets   -quiet $nets]] ]]
	puts "     <Info> :: RailNets  [llength $rail_nets]"
	puts "     <Info> :: RailPorts [llength $rail_ports]"

	array unset rail_map
	set rail_map(01_both_netports)  [list]
	set rail_map(02_only_ports)     [list]
	set rail_map(03_only_nets)      [list]
	# Common Map
	foreach x $rail_nets {
		foreach y $rail_ports {
			if { $x == $y } {
				lappend rail_map(01_both_netports) $x
			}		
		}
	}
	foreach x $rail_nets {
		if {![llength [lsearch -all -inline $rail_map(01_both_netports)  $x]]} {
				lappend rail_map(03_only_nets) $x
		}
	}
	foreach x $rail_ports {
		if {![llength [lsearch -all -inline $rail_map(01_both_netports)  $x]]} {
				lappend rail_map(02_only_ports) $x
		}
	}
	puts "     <Info> :: Rail Map Spec \n"
	parray rail_map 
	puts "\n"
	
	foreach x $rail_map(01_both_netports) {
		puts    "          - Processing $x"
		report_power_network -net {$x} > $dirx/report_power_network.rail.$x.rpt
	}
	puts "     <Info> :: Dir : $dirx/* \n"	
}
