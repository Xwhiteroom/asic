		set    GC_STA_ECO_CORE                 \"Not_Required\" 
		set    GC_STA_ECO_RECIPE               \"Not_Required\" 
		set    GC_STA_ECO_POWER                \$PATTERN_BASED_POWER_RECOVERY 
		set    GC_STA_ECO_PHYSICAL             \"dataclock\" 
		 
		set    GC_STA_ECO_PATTERN              \$LEAKAGE_SWAP_PATTERN 
		set    GC_STA_ECO_PLUGINS              \"Not_Required\" 
		set    GC_STA_ECO_ITER                 \"100000\" 
		set    GC_STA_ECO_VTMAP                \$LEAKAGE_SWAP_PATTERN 
		set    GC_STA_ECO_GROUP                \"\" 
		set    GC_STA_ECO_BUF_CLOCK            \$CLOCK_DRV_INVERTER_LIST 
		set    GC_STA_ECO_BUF_DATMIN           \$HOLD_FIX_BUFFERS 
