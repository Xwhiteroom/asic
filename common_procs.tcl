##------------------------------------------------------------------
## ProcNameStart  : slack_parse
## ProcArguments  : slack_parse rpt_file args
## ProcDependency :  
## ProcInfluence  : 6
## ProcRenamed    : 0
##------------------------------------------------------------------
proc slack_parse {rpt_file args} {
global CORNER
array unset slack_vio
array unset slack_grp
array unset slack_pvt
array unset slack_stg
array unset slack_at
array unset slack_cnt
array unset slack_zero
array unset buck_vio
array unset buck_cnt
array unset buck_tns
array unset buck_info

set corner $CORNER
set slack_index 1
set pin_index  0
if { $args == "0"} { set slack_index 0;set pin_index 0;};
if { $args == "1"} { set slack_index 1;set pin_index 0;};
if { $args == "2"} { set slack_index 2;set pin_index 0;};
if { $args == "3"} { set slack_index 3;set pin_index 0;};
if { $args == "4"} { set slack_index 4;set pin_index 2;}; # end point report with [start start_cell end end_cell slack]
if { $args == "4s"} { set slack_index 4;set pin_index 0;}; # end point report with [start start_cell end end_cell slack]
if { $args == "4e"} { set slack_index 4;set pin_index 2;}; # end point report with [start start_cell end end_cell slack]
if { $args == "5"} { set slack_index 5;set pin_index 0;}; 
if { $args == "6"} { set slack_index 6;set pin_index 0;};
if { $args == "6d"} { set slack_index 6;set pin_index 0;}; # end point report with [end end_cell AT Edge RT CRP slack endclk stage corner]


puts "Default rca all_vio, 4,4S,4e for summary rtx , 6 for end rtx |  $args slack_index=$slack_index pin_index=$pin_index"



puts "\t\t**Start Parsing $rpt_file"
	set in [open $rpt_file]
	set group "Default"
	while { [gets $in line] >= 0 } {
	    if { [regexp "' group" $line]  } { set group [lindex [split $line "'"] 1]; puts "\t\t\t  - Found Group $group" }
        if { [regexp "VIOLATED" $line] || ( $slack_index == 4 && [llength $line] == 5) || ($slack_index == 6 && ([lindex $line 3]  == "r" || [lindex $line 3]  == "f")) } { 
			set stages ""

			set pin   [lindex $line $pin_index]
            
			set slack [lindex $line $slack_index]
			if { $slack == "0.000" || $slack == "-0.000" || $slack >= "-0.00005"} {
				set slack "0.000"
		    	}
			
			if {  ![info exists slack_cnt($pin)]} { 
			      set  slack_cnt($pin) 1
			      set slack_zero($pin) 0
			} else {
			    set slack_cnt($pin) [expr $slack_cnt($pin) +  1]
			}
			
			if {  ![info exists slack_zero($pin)] && $slack == "0.000"} { 
			      set slack_zero($pin) 1
			} else {
			    set slack_zero($pin) [expr $slack_zero($pin) +  1]
			}
            if { $args == "6d" } {
                set group  [lindex $line 7] 
                set stages [lindex $line 8]                 
                set corner [lindex $line 9] 
                set arrival [lindex $line 2]
                if { $stages != "" && $stages != 0}  {
                    set stg_avg [expr $arrival / $stages]
                } else {
                    set stg_avg -1
                }
               # puts "$stg_avg $slack $pin"                    

                if {$stg_avg < 1 && $stg_avg > 0 } { 
                    set stg_avg [format "%0.3f" $stg_avg]
                } else { 
                    set stg_avg [format "%d" [expr int($stg_avg)]]                    
                }

                #puts "$stg_avg $slack $pin"

                if {$slack > -10} { 
                    set slack [format "%0.3f" $slack]
                } else { 
                    set slack [format "%d" [expr int($slack)]]                    
                }

            }

			if { ($slack < 0 && ![info exists slack_vio($pin)]) || ([info exists slack_vio($pin)] && $slack_vio($pin) > $slack && $slack < 0) } {
                  set slack_vio($pin) $slack
			      set slack_grp($pin) $group
			      set slack_pvt($pin) $corner
			      set slack_stg($pin) "AVG${stg_avg}_STG$stages"
			} 


	 	}
	}
	close $in
	set wns  0;
	set bns  -9999;
        set tns  0;
	set vio  0;
    set bucks  0
        puts "\t\t**Done  Parsing $rpt_file"
	set out [open "$rpt_file.temp" w+]
	set out2 [open "$rpt_file.fix_pins" w+]
	puts $out2 "set fix_pins \[list \\"
	foreach pin [array names slack_vio] {
        #puts "$pin"
		set group $slack_grp($pin)
		set corner $slack_pvt($pin)
		set stages $slack_stg($pin)
        # Buck
		regsub -all {\d+} $pin {*} buck

		if {$slack_vio($pin) < 0} {

			if {![info exists buck_vio($buck)] ||
				$slack_vio($pin) < $buck_vio($buck)} {
				set buck_vio($buck) $slack_vio($pin)
                set buck_info($buck) "$stages/$group"
			}

			if {![info exists buck_cnt($buck)]} {
				set buck_cnt($buck) 1
				set buck_tns($buck) $slack_vio($pin)
				incr bucks
			} else {
				incr buck_cnt($buck)
				set buck_tns($buck) [expr {$buck_tns($buck) + $slack_vio($pin)}]
			}
		}

		set tns [expr $tns + $slack_vio($pin)]	
		incr vio;
		if { $slack_vio($pin) < $wns} { 
		    set wns  $slack_vio($pin)
		}
		if { $slack_vio($pin) > $bns} { 
		    set bns  $slack_vio($pin)
		}



		#puts "$slack_vio($pin) $stages $pin"
		#puts [format "%5d %5.3f %5.3f %5d %5d :: %5.3f %s" $vio $tns $wns  $slack_cnt($pin) $slack_zero($pin) $slack_vio($pin) $pin]
		#puts $out [format "%5d %5.3f %5.3f :: %5.3f %s" $vio $tns $wns  $slack_vio($pin) $pin]
		puts $out [format "%5.3f %s %s %s %s" $slack_vio($pin) $pin $corner $group $stages]
		puts $out2 "$pin \\"
	}
	puts $out [format "VIO=%-5d TNS=%5.3f WNS=%5.3f | BUCKETS=%-5d" $vio $tns $wns $bucks]	
	puts  [format "VIO=%-5d TNS=%5.3f WNS=%5.3f BNS=%5.3f | BUCKETS=%-5d" $vio $tns $wns $bns $bucks]	
	puts $out2 "\]"

	close $out
	close $out2
	set out [open "$rpt_file.btemp" w+]
	set out2 [open "$rpt_file.verbose" w+]
    puts $out2  "#====================================================================================================================="
    puts $out2  "# Verbose Bucket Reports : [format "VIO=%-5d TNS=%5.3f WNS=%5.3f BNS=%5.3f | BUCKETS=%-5d" $vio $tns $wns $bns $bucks]"
    puts $out2  "# Buckets                : $bucks"
    puts $out2  "# Format                 : Bucket --> Top Path"
    puts $out2  "#====================================================================================================================="

	puts  [format " . . . .Streaming | BUCKETS=%-5d" [llength [array names buck_vio ]] ]	
    
    set  i 0
    foreach buck [array names buck_vio ] {
        incr i
        set cone     [all_fanin -flat -only_cells -to $buck]
        set seq_cone [filter_collection $cone "is_hard_macro==false && is_sequential==true"]
        set com_cone [filter_collection $cone "is_hard_macro==false && is_sequential==false"]
        set buf_cone [filter_collection $com_cone "lib_cell.is_buffer == true"]
        set inv_cone [filter_collection $com_cone "lib_cell.is_inverter == true"]
        set com_cone [remove_from_collection  $com_cone $buf_cone]
        set com_cone [remove_from_collection  $com_cone $inv_cone]
        set tns_pct [format "%0.1f"    [expr -100.0 *  $buck_tns($buck) /$tns] ]
        set cns_pct [format "%0.1f" [expr -100.0 *  $buck_cnt($buck) /$vio]  ]
        set bid     [format "ID%05d" $i]
        set cone_data [format "XFF=%08d/LOG=%08d/BUF=%08d/INV=%08d" [sizeof_collection $seq_cone]    [sizeof_collection $com_cone]  [sizeof_collection $buf_cone] [sizeof_collection $inv_cone]]
        puts $out [format " %-25s VIO=%-s %8s FEP=%-5d TNS=%-15.1f WNS=%-10s Cone:%-40s Grp:%-50s %-s"  "$cns_pct%/$tns_pct% (FEP/TNS)" $bid $vio  $buck_cnt($buck)  $buck_tns($buck) $buck_vio($buck)  $cone_data $buck_info($buck) $buck]
        puts $out2 "# TODO: -------------------------------------------------------------------------------------------------------"
        puts $out2 "BucketXXXID:: $bid"
        puts $out2 "BucketXName:: $buck"        
        puts $out2 "BucketCount:: FEP=$buck_cnt($buck)  / TNS=$buck_tns($buck)"
        puts $out2 "BucketCones:: $cone_data"
        puts $out2 "BucketGroup:: $buck_info($buck)"        
        puts $out2 "BucketPathX:: report_timing -phy -include_hier -tran -nos -through $buck"
        set paths [get_timing_path -through $buck -max_path $buck_cnt($buck)]
        set startp [get_object_name [get_attr $paths startpoint]]
		regsub -all {\d+} $startp {*} startpat
        set startpat [lsort -uniq $startpat]
        puts $out2 "BucketSPCnt:: Startpoints=[llength $startp]"
        puts $out2 "BucketSPPat:: $startpat"
        puts $out2 "BucketSPBKX:: $bid | $startpat"        
        catch { redirect -channel $out2 "report_timing -phy -include_hier -tran -nos  -max_path 1 -through $buck" }
        puts $out2 "#*******************************************************************************************************\n"        

    }
	close $out
	close $out2
    
	#exec "cat $rpt_file.temp | sort -n -k 4 > $rpt_file.uniq" 
	exec sort -n -k 1 $rpt_file.temp  -o $rpt_file.uniq
	exec sort -n -k 1 $rpt_file.btemp  -o $rpt_file.buck
	puts "\t\t**Open file $rpt_file.uniq"
	puts "\t\t**Open file $rpt_file.buck"    
	puts "\t\t**Open file $rpt_file.fix_pins"
	puts "\t\t**Open file $rpt_file.verbose"    
}
