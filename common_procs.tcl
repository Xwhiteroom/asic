proc sta_qc_report_histo {BASE_TAG rep_dir args} {
    global MODE CORNER my_flow_control
    set my_design [get_object_name [current_design ]]
    file mkdir $rep_dir
    if { [llength $args] > 2 } { 
            set checkx [lindex $args 0]
            set ref_file  [lindex $args 1]
            echo "** STA_CFG_INFO: Start dumping histo reports: ${checkx}_path full       [date] $ref_file"   
            sh python3  $my_flow_control/pd_shell/get_histo.py --bins " -0.001,-0.017,-0.034,-0.084,-0.167" --by_items "corner hier direction end_clk"     --sort_by "corner hier direction wns"  --out $rep_dir/sum.$checkx.$BASE_TAG.L1 $ref_file
            sh python3  $my_flow_control/pd_shell/get_histo.py --bins " -0.001,-0.017,-0.034,-0.084,-0.167" --by_items "corner hier direction end_clk x2x" --sort_by "corner hier direction wns"  --out $rep_dir/sum.$checkx.$BASE_TAG.L2 $ref_file
            echo "** STA_CFG_INFO: Done  dumping histo reports: ${checkx}_path full       [date] $ref_file"            
    } else {
        foreach checkx [list max min] {
            set ref_file $rep_dir/path.$checkx.$BASE_TAG.json
            echo "** STA_CFG_INFO: Start dumping histo reports: ${checkx}_path full       [date] $ref_file"                        
            sh python3  $my_flow_control/pd_shell/get_histo.py --bins " -0.001,-0.017,-0.034,-0.084,-0.167" --by_items "corner hier direction end_clk"     --sort_by "corner hier direction wns"  --out $rep_dir/sum.$checkx.$BASE_TAG.L1 $ref_file
            sh python3  $my_flow_control/pd_shell/get_histo.py --bins " -0.001,-0.017,-0.034,-0.084,-0.167" --by_items "corner hier direction end_clk x2x" --sort_by "corner hier direction wns"  --out $rep_dir/sum.$checkx.$BASE_TAG.L2 $ref_file
            echo "** STA_CFG_INFO: Done  dumping histo reports: ${checkx}_path full       [date] $ref_file"            
        }
    }
}
