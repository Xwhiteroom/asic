##------------------------------------------------------------------
## ProcNameStart  : get_clock_latency
## ProcArguments  : get_clock_latency clocks dir
## ProcDependency : sh 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc get_clock_latency {clocks dir} {
    global CORNER MODE 
    set my_design [get_object_name [current_design]]
    file mkdir $dir
    set data "#Design,#Scenario,#Clock,#Source,#Sinks,#Latency(Max),#Latency(Min),#Sum_Lat(Max),#Sum_Lat(Min),#Paths(n)"
    puts "$data"
    set myclock_col [get_clocks $clocks]
    foreach_in_collection xclk $myclock_col {
        set ck_name [get_object_name $xclk]
        set ck_sources [get_attribute -quiet $xclk sources ]
        foreach_in_collection src $ck_sources {
            set src_name [get_object_name $src]
            set cone [all_fanout -from $src -flat -end ]
            set total [sizeof_collection $cone] 
            set max_arr 0
            set min_arr 0
            suppress_message UITE-416
            
            set count   0
            set max_arrs  [get_attribute [get_timing_paths -from  $src -to $cone -delay max -max_path $total] arrival] 
            set max_arr_quick 0
            foreach x $max_arrs { 
                set max_arr_quick [expr $max_arr_quick + $x] ;
                if { $max_arr_quick > 0 } {
                    incr count
                }
             }
            if { $count > 0 }  {  set max_arr       [expr $max_arr_quick/$count] }

            set count   0            
            set min_arr_quick 0            
            set min_arrs  [get_attribute [get_timing_paths -from  $src -to $cone -delay min -max_path $total] arrival] 
            foreach x $min_arrs { 
                set min_arr_quick [expr $min_arr_quick + $x] ;
                if { $min_arr_quick > 0 } {
                    incr count
                }
             }
            if { $count > 0 }  {  set min_arr [expr $min_arr_quick/$count] }
                    
            set loop_data "$my_design,$MODE.$CORNER,$ck_name,$src_name,$total,$max_arr,$min_arr,$max_arr_quick,$min_arr_quick,$count"
            set data      "$data\n$loop_data"
            puts "$loop_data"
        }
    }
    set outf [open  $dir/latency.info.csv w+]
    puts $outf $data
    close $outf
    sh cat $dir/latency.info.csv | column -t -s , > $dir/latency.info
     
}
##------------------------------------------------------------------
## ProcNameEnd    : get_clock_latency
##------------------------------------------------------------------


