##------------------------------------------------------------------
proc sta_qc_report_misc {BASE_TAG rep_dir} {
    file mkdir $rep_dir    
    echo "** STA_CFG_INFO: Start dumping timing reports: Check Timing     [date]"
    check_timing -verbose   > $rep_dir/misc.check_timing.${BASE_TAG}.rpt
    sta_qc_report_unclocked   $rep_dir/misc.unclocked.${BASE_TAG}.rpt
    echo "** STA_CFG_INFO: Start dumping timing SDC    : Constraints      [date]"    
    write_sdc -compress gzip -nosplit $rep_dir/misc.sdc.$BASE_TAG.sdc
    echo "** STA_CFG_INFO: Start dumping timing ports  : Floating         [date]"    
    sta_qc_report_floating $BASE_TAG $rep_dir [list borr_shader_tile borr_shader_tile_v2 borr_toplevel DA11QQ DI_borr_ee_top ananke_core enyo_core hera_core hera_intfe hera_l2_ctrl hera_vector ]
