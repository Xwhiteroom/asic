##------------------------------------------------------------------
## ProcNameStart  : cellinfo_hier_slack
## ProcArguments  : cellinfo_hier_slack cell args
## ProcDependency : puts_tee 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc cellinfo_hier_slack {cell args} {
    set ipat $cell
    if { [sizeof_collection [get_pins -quiet $cell]]} { 
	    set cpins [get_pins -quiet $cell]	    
	    set cell [get_object_name [get_cells -of_objects [get_pins -quiet $cell]]]
	} else {
	    set cpins [get_pins -quiet $cell/*]
    	}
        if { $args == "" } {
	    set xfile "temp_cell.info_hier.tcl"
        } else {
	    set xfile "[lindex $args 0].info_hier.tcl"
        }
        set out_p [open $xfile w+]
    	set is_p "pin"
	set is_x ""
	if { [sizeof_collection $cpins ] == "0"} {
		set cpins [get_ports -quiet $cell/*]
		set is_p "port"
		set is_x "IO"
	
	}
	set pin_len   [expr ([string length $cell] + 40)]
	if {$pin_len > 150} {set pin_len 150};
	set ref_len   [string length [lindex [get_attribute -quiet  [get_cells $cell] ref_name] 0]]
	set space1    [expr ((${pin_len} - 10)/2)]
	set clock_size "15" 
	foreach clk [get_object_name [get_clocks *]] {
	  if {[string length $clk] >= $clock_size } {
	       set clock_size "[expr [string length $clk]]"  
	  }
	}
	set ref_size "30" 
    foreach lib [lsort -uniq [get_attribute -quiet  [get_cells -quiet $cell] ref_name]] {
      if {[string length $lib] >= $ref_size } {
	       set ref_size "[string length $lib]" 
	  }
    }


	set dref_size  [expr 5 + $ref_size  + 0]
	set clock_size [expr 5 + $clock_size + 0]  

	set dash1     [expr ( 21 + 14 + 14 + $clock_size + $dref_size + $ref_size + ${pin_len})]
	set frmt "|%12s|%12s|%12s|%12s|%12s|%6s|%12s|%12s|%${clock_size}s|%${dref_size}s|%${ref_size}s|%-${pin_len}s|"
	puts_tee $out_p "\n\n"
	#puts_tee $out_p "+[string repeat "-" ${dash1}]+"
	#puts_tee $out_p  [format |%-${dash1}s| "    Ref Lib Cell Used ($is_p):      [get_attribute -quiet  [get_cells $cell] ref_name]"]
    puts_tee $out_p "INFO: Input Pattern : $ipat"
	puts_tee $out_p "+[string repeat "-" 12]+[string repeat "-" 12]+[string repeat "-" 12]+[string repeat "-" 12]+[string repeat "-" 12]+[string repeat "-" 6]+[string repeat "-" 12]+[string repeat "-" 12]+[string repeat "-" ${clock_size}]+[string repeat "-" ${dref_size}]+[string repeat "-" ${ref_size}]+[string repeat "-" ${pin_len}]+"
	puts_tee $out_p [format $frmt "Const" "Setup" "Hold" "XtlkH" "XtlkL" "Dir" "LoadC" "LoadR" "Clocks" "Driver_Cell" "Ref_Cell"  "[string repeat " " ${space1}]Cell Pin[string repeat " " ${space1}]"]
	puts_tee $out_p "+[string repeat "-" 12]+[string repeat "-" 12]+[string repeat "-" 12]+[string repeat "-" 12]+[string repeat "-" 12]+[string repeat "-" 6]+[string repeat "-" 12]+[string repeat "-" 12]+[string repeat "-" ${clock_size}]+[string repeat "-" ${dref_size}]+[string repeat "-" ${ref_size}]+[string repeat "-" ${pin_len}]+"
	foreach_in_collection pin $cpins {
	  # use driver as reference for inputs 
	  set pin_drxs  [remove_from_collection [all_fanin -to $pin -pin_level 1 -flat -trace_arcs all] [filter_collection $cpins "direction==in"]]
          set pin_drx   $pin
          set my_ref    [get_attr -quiet  [get_cells -of_object $pin] ref_name]
	  set my_dref   "None"
      set my_dref   [lindex [get_attr -quiet [get_cells -of_object $pin_drxs] ref_name] 0]
	  foreach_in_collection drx $pin_drxs {
      	      if { [get_object_name $drx ] != [get_object_name $pin] && [get_attribute -quiet $drx direction] == "in" } { set pin_drx $drx }
          }
          set xtlk_max [get_attr -quiet [get_nets -quiet [all_connected $pin]] annotated_delay_delta_max] 
          set xtlk_min [get_attr -quiet [get_nets -quiet [all_connected $pin]] annotated_delay_delta_min] 
          set loadR    [get_attr -quiet [get_nets -quiet [all_connected $pin]] net_resistance_max]
          set loadC    [get_attr -quiet [get_nets -quiet [all_connected $pin]] total_capacitance_max]

          if { $xtlk_max != "" } {  set xtlk_max [format "%0.3f" $xtlk_max]   }
          if { $xtlk_min != "" } {  set xtlk_min [format "%0.3f" $xtlk_min]   }
          if { $loadR    != "" } {  set loadR    [format "%0.3f" $loadR   ]   }
          if { $loadC    != "" } {  set loadC    [format "%0.3f" $loadC   ]   }



	 if {[sizeof_collection [get_attribute -quiet  [get_${is_p} -quiet $pin_drx] clocks]] != 0} {
	  set no_of_clk [sizeof_collection [get_attribute -quiet  [get_${is_p} -quiet $pin_drx] clocks]]
	  set current_clk 0

	   while { $current_clk < $no_of_clk} {
	      set clocks [lindex [get_object_name [get_attribute -quiet  [get_${is_p} -quiet  $pin_drx] clocks]] $current_clk]
	      incr current_clk
	      set  my_period [format "%.3f" [get_attribute -quiet [get_clocks $clocks] period]]
	      set  my_attrc  "M"
	      if { [get_attr [get_clocks $clocks]  is_generated]} {
	      	set  my_attrc  "G"
	      }	
	      set pin_curr [get_object_name [get_${is_p} $pin]]
	      foreach_in_collection src [get_attr -quiet [get_clocks $clocks] sources] {
	        if { [get_object_name $src] == $pin_curr} {
		   set  my_attrc  "*${my_attrc}"
	    	}
	      }

	      if { $current_clk == 1} {
	           #puts_tee $out_p [format $frmt  "" "" "" "" "" "" "" "" "" "" " $clocks ($my_attrc )" "" ""]        
	           puts_tee $out_p [format $frmt  "$my_period" "" "" "$xtlk_max" "$xtlk_min" "$is_x [get_attribute -quiet  [get_${is_p} $pin] ${is_p}_direction]" "$loadC" "$loadR" " $clocks ($my_attrc)" "$my_dref" "$my_ref" " [get_object_name [get_${is_p} $pin]]" ]
	           #puts_tee $out_p [format $frmt  "[get_attribute -quiet  [get_${is_p} $pin] case_value]" "$is_x [get_attribute -quiet  [get_${is_p} $pin] ${is_p}_direction]" "$clocks" "[get_object_name [get_${is_p} $pin]]" ]
	      } else { 
	           puts_tee $out_p [format $frmt  "$my_period" "" "" "" "" "" "" "" " $clocks ($my_attrc)" "" "" "" ]
	      }
	   }
	  } else {
            set pin_drxs  [all_fanin -to $pin -pin_level 1 -flat ]
            foreach_in_collection drx $pin_drxs {
      	      if { [get_object_name $drx ] != [get_object_name $pin] } { set pin_drx $drx}
            }



            if { [get_attribute -quiet  [get_${is_p} -quiet $pin_drx] case_value] == "" } {
                #Slacky pin
                set slackmax [get_attribute -quiet  [get_${is_p} $pin_drx] max_slack]       
                set slackmin [get_attribute -quiet  [get_${is_p} $pin_drx] min_slack]       


                if { $slackmax != "" } {  set slackmax [format "%0.3f" $slackmax]   }
                if { $slackmin != "" } {  set slackmin [format "%0.3f" $slackmin]   }

	        puts_tee $out_p [format $frmt "Timed" "$slackmax" "$slackmin" "$xtlk_max" "$xtlk_min" "$is_x [get_attribute -quiet  [get_${is_p} -quiet $pin] ${is_p}_direction]" "$loadC" "$loadR" "" "$my_dref" "$my_ref" " [get_object_name [get_${is_p} $pin]]"]               
            } else {
                #static pin
                set case_used     [get_attribute -quiet [get_${is_p} $pin_drx] case_value]
                set consant_used  [get_attribute -quiet [get_${is_p} $pin_drx] constant_value]
                set static "Tie_$case_used"
                if { $case_used == "static" } { set case_used "X" }
                if { $consant_used == "" } { set static "Case_$case_used" }

	        puts_tee $out_p [format $frmt "$static" "" "" "$xtlk_max" "$xtlk_min" "$is_x [get_attribute -quiet  [get_${is_p} $pin] ${is_p}_direction]" "$loadC" "$loadR" "" "$my_dref" "$my_ref" " [get_object_name [get_${is_p} $pin]]"]
            }
	  
          }
	 }
	puts_tee $out_p "+[string repeat "-" 12]+[string repeat "-" 12]+[string repeat "-" 12]+[string repeat "-" 12]+[string repeat "-" 12]+[string repeat "-" 6]+[string repeat "-" 12]+[string repeat "-" 12]+[string repeat "-" ${clock_size}]+[string repeat "-" ${dref_size}]+[string repeat "-" ${ref_size}]+[string repeat "-" ${pin_len}]+"

    puts_tee $out_p "\n\n" 
	close $out_p
	puts "\t**Open file $xfile"
}
