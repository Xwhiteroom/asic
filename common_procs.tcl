##------------------------------------------------------------------
## ProcNameStart  : autodesign_get_zero_iotiming
## ProcArguments  : autodesign_get_zero_iotiming tag_scenario port_list clock_list pin_bus_ultra delay_type slack_more_than_ignore outdir
## ProcDependency : autodesign_print_stage , autodesign_debus , autodesign_report_sync_clocks , ls 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc autodesign_get_zero_iotiming {tag_scenario port_list clock_list pin_bus_ultra delay_type slack_more_than_ignore outdir} {
	puts "\n\n"
	# Process Inputs/Statics
	set SCENARIO	 $tag_scenario
	set XDESIGN   	 [lindex [get_object_name [current_design]] 0]
	set valid_ports  [get_ports  -quiet $port_list]
	set valid_clocks [get_clocks -quiet $clock_list]
	set margin_type  "setup"
	if { $delay_type == "min" } {
		set margin_type  "hold"
	}
	# Process Outfile Files
        file mkdir       $outdir/$tag_scenario/$pin_bus_ultra
	set  xdir        [file normalize $outdir/$tag_scenario/$pin_bus_ultra]
        set  flog        [open $xdir/io.$delay_type.log w+]
        set  fdef        [open $xdir/overrides_io.$delay_type.default_margin.tcl w+]
        set  fadj        [open $xdir/overrides_io.$delay_type.adjust_margin.tcl w+]
        set  fdefclk     [open $xdir/overrides_io.$delay_type.default_margin.clk.tcl w+]
        set  fadjclk     [open $xdir/overrides_io.$delay_type.adjust_margin.clk.tcl w+]

	# Process IO DataBases
	array unset module_io
        array unset module_bus
	set empty_collection [remove_from_collection [all_clock] [all_clock]]
	set module_io(00_BLOCK_00)  [list [list #DESIGN #SCENARIO #PORT_IO #DIR #BUSSIZE #CLOCK #SLACK #MARGIN #ADJUST #PROCESS]]
        
	# Process Each Module
	autodesign_print_stage blue [format "=============================================================================================" ]


	# Bus Compression
	set blk       $XDESIGN
	set in_pins   [lsort -unique [get_object_name [get_ports -quiet $valid_ports -filter "direction==in"]]]
	set out_pins  [lsort -unique [get_object_name [get_ports -quiet $valid_ports -filter "direction==out"]]]

	set in_busx   [autodesign_debus $in_pins  ""]
	set out_busx  [autodesign_debus $out_pins ""]

	set in_ultra  [autodesign_debus $in_pins  {\d+}]
	set out_ultra [autodesign_debus $out_pins {\d+}]

	# Bus Selection
	autodesign_print_stage blue [format "     - Infox :   Module $blk : Input=[llength  $in_pins]  / Input(debussed)=[llength  $in_busx]  / Input(compressed)=[llength  $in_ultra]"]
	autodesign_print_stage blue [format "     - Infox :   Module $blk : Output=[llength  $out_pins]  / Output(debussed)=[llength  $out_busx]  / Output(compressed)=[llength  $out_ultra]"]
	set module_bus(Inputs) $in_pins;  set module_bus(Outputs) $out_pins
	if { $pin_bus_ultra == "bus"   } { set module_bus(Inputs) $in_busx;   set module_bus(Outputs) $out_busx  }
	if { $pin_bus_ultra == "ultra" } { set module_bus(Inputs) $in_ultra;  set module_bus(Outputs) $out_ultra }
	autodesign_print_stage red  [format "     - Infox :   Module $blk : Selected --> Input=[llength  $module_bus(Inputs)] | Output=[llength  $module_bus(Outputs)]"]
	autodesign_print_stage blue [format "\t      --------------------------------------------------------------------------------------"]

	# Path Collection
	set max_paths $empty_collection
	set min_paths $empty_collection

	# Input/Output Process
	foreach categ [array names module_bus] {
		set direction "in"
		if { $categ == "Outputs" } { set direction "out" }
		set max_size   [llength $module_bus($categ)]
		set bkt_size   [expr $max_size / 10]
		set iter_size  0
		set lst_size   0
		set progress   "0" 
		#puts -nonewline  "[date]       \t\t\t $categ: $progress"
		foreach nodex $module_bus($categ) {
			# Bucket Count:
			incr iter_size
			incr lst_size
			if { $iter_size >= $bkt_size } { 
		                #puts -nonewline [format " -> [expr 100*($lst_size )/$max_size] ($lst_size)"]
                                flush stdout
				set iter_size 0	
			}
			# Map Bust Stat
			incr pcnt
			set bus_pins    [get_ports -quiet [list $nodex] -filter "direction==$direction"]
			set bus_size    [sizeof_collection $bus_pins]
			set bus_idx     $nodex

			# Bus Clocks
			if { $direction == "in"} {
				#set clk_used  [get_clocks -quiet [get_attribute -quiet [get_pins -of_object [all_fanout -quiet -from $bus_pins -flat -end  -only_cells] -filter "is_clock_pin==true"] clocks]]
				set clk_used [get_object_name [get_attribute -quiet [get_ports $bus_pins ] constrained_launch_clocks]]
			} else {
				set clk_used  [get_clocks -quiet [get_attribute -quiet [all_fanin -quiet    -to $bus_pins -flat -start ] clocks]]
				#set clk_usedx "None"
				#set clk_used [get_object_name [get_attribute -quiet [get_ports $bus_pins ] launch_clocks]]
			}
			set clk_used        [autodesign_report_sync_clocks $clk_used $valid_clocks]
			set clock_valid     [lsort -unique [get_object_name [remove_from_collection -intersect $valid_clocks $clk_used]]]
			#set clock_valid    [lsort -unique [get_object_name $valid_clocks]]


			# Path Stat Worst
			set xhead   [list $XDESIGN $tag_scenario $bus_idx $direction $bus_size]
			set refTime 	[clock seconds]
			set skip_io 0
			set pathmax [get_timing_path -through $nodex -delay $delay_type -max_path 1 ]
			set eclkx   [get_object_name [get_attribute -quiet $pathmax endpoint_clock]]
			set slackx  [get_attribute -quiet $pathmax slack]
			set marginx [get_attribute -quiet $pathmax path_margin]
			if { $marginx == "" || $marginx ==  0 } {
				set marginx 0.000
			}
			if { $slackx == ""  || $slackx == "INFINITY"} {
				set slackx 0.000
				set skip_io "1"
			}
			set adj_margin [format "%0.3f" [expr 0.000 + $slackx + 0.000 + $marginx + 0.000]]
			set tarTime [clock seconds]
			set delta   [expr ($tarTime - $refTime)]

			set iodata  [list "None" $slackx $marginx $adj_margin $delta]
			if { $skip_io == 0 } { lappend module_io($blk) [concat $xhead $iodata]	}

			# Path Stat Clock
			if { $skip_io == 0 } {
				foreach clkx $clock_valid {
					set refTime 	[clock seconds]
				        set skip_io     "0"
					if { $direction == "in"} {
						set pathmax [get_timing_path -through $nodex -delay $delay_type -from [get_clocks $clkx] -max_path 1 ]
					} else {
						set pathmax [get_timing_path -through $nodex -delay $delay_type -to [get_clocks $clkx] -max_path 1 ]
					}
					set eclkx   [get_object_name [get_attribute -quiet $pathmax endpoint_clock]]
					set slackx  [get_attribute -quiet $pathmax slack]
					set marginx [get_attribute -quiet $pathmax path_margin]
					if { $marginx == "" || $marginx ==  0 } {
						set marginx 0.000
					}
					if { $slackx == "" || $slackx == "INFINITY"} {
						set slackx 0.000
						set skip_io "1"

					}
					set adj_margin [format "%0.3f" [expr 0.000 + $slackx + 0.000 + $marginx + 0.000]]
					set tarTime [clock seconds]
					set delta   [expr ($tarTime - $refTime)]
					set iodata  [list $eclkx $slackx $marginx $adj_margin $delta]
					if { $skip_io == 0 } { lappend module_io($blk) [concat $xhead $iodata] }
				}	
			}
		}
	}

        
	# Publish IO Summary
	foreach blkx [lsort [array names module_io]] {
		if { $blkx == "00_BLOCK_00"} {
			set iodata [lindex $module_io($blkx) 0]
			set xdata [format "%-20s %-40s %-70s"                                       [lindex $iodata 0]  [lindex $iodata 1]  [lindex $iodata 2]  ]
			set xdata [format "$xdata %-15s %-15s %-50s %-15s %-15s %-15s %-15s"        [lindex $iodata 3]  [lindex $iodata 4]  [lindex $iodata 5]  [lindex $iodata 6]  [lindex $iodata 7] [lindex $iodata 8]  [lindex $iodata 9]]
			puts $flog $xdata
			set strx       "global XDESIGN CORNER ; \nif { !\[regexp \"$XDESIGN.*$tag_scenario\" \"\$XDESIGN.\$CORNER\"] } { puts \"<INFO>  Skipping IO Path Adjust\" ; return }"
                        puts $fdef     $strx
                        puts $fdefclk  $strx
                        puts $fadj     $strx
                        puts $fadjclk  $strx			
			continue
		}
		# Main Loop
		foreach iodata [lsort $module_io($blkx)] {
			set xdata [format "%-20s %-40s %-70s"                                       [lindex $iodata 0]  [lindex $iodata 1]  [lindex $iodata 2]  ]
			set xdata [format "$xdata %-15s %-15s %-50s %-15s %-15s %-15s %-15s"        [lindex $iodata 3]  [lindex $iodata 4]  [lindex $iodata 5]  [lindex $iodata 6]  [lindex $iodata 7] [lindex $iodata 8]  [lindex $iodata 9]]
			puts $flog $xdata
			set port_name  [lindex $iodata 2] 
			set port_dir   [lindex $iodata 3] 
			set port_siz   [lindex $iodata 4] 
			set port_clk   [lindex $iodata 5] 
			set port_slk   [lindex $iodata 6] 
			set port_def   [lindex $iodata 7] 
			set port_adj   [lindex $iodata 8] 
			set comment    "Slack=$port_slk OrgMar=$port_def NewMar=$port_adj = ($port_slk + $port_def) Clock=$port_clk Delay=$margin_type BusSize=$port_siz Scenario=$tag_scenario"
  			if { $port_dir == "in" }  { set port_rpt_dir "-from"  ; set clk_rpt_dir "-to"   }
  			if { $port_dir == "out" } { set port_rpt_dir "-to"    ; set clk_rpt_dir "-from" }
          		#set_path_margin  -hold  $margin -to   [get_ports -quiet $defined_data_ports   -filter "direction==out"] -comment ""
			set cmd_head " catch"
			if { $port_slk >= $slack_more_than_ignore } { set cmd_head "#catch" }

			if { $port_clk == "None" } {
				puts $fdef [format "catch { set_path_margin -%5s  %+2.3f  %-10s \[get_ports -quiet -filter \"direction==%-3s\" %s\] -comment \"%s\"}" $margin_type [expr 1 * $port_def] $port_rpt_dir $port_dir $port_name  $comment]
				puts $fadj [format "$cmd_head { set_path_margin -%5s  %+2.3f  %-10s \[get_ports -quiet -filter \"direction==%-3s\" %s\] -comment \"%s\"}" $margin_type [expr 1 * $port_adj] $port_rpt_dir $port_dir $port_name  $comment]
			} else {
				puts $fdefclk [format "catch { set_path_margin -%5s  %+2.3f  %-10s \[get_ports -quiet -filter \"direction==%-3s\" %s\] %-10s \[get_clocks -quiet %s\] -comment \"%s\"}" $margin_type [expr 1 * $port_def] $port_rpt_dir $port_dir $port_name $clk_rpt_dir $port_clk $comment]
				puts $fadjclk [format "$cmd_head { set_path_margin -%5s  %+2.3f  %-10s \[get_ports -quiet -filter \"direction==%-3s\" %s\] %-10s \[get_clocks -quiet %s\] -comment \"%s\"}" $margin_type [expr 1 * $port_adj] $port_rpt_dir $port_dir $port_name $clk_rpt_dir $port_clk $comment]
			}
			#set module_io(00_BLOCK_00)  [list [list #DESIGN #SCENARIO #PORT_IO #DIR #BUSSIZE #CLOCK #SLACK #MARGIN #ADJUST #PROCESS]]

		}

	}


	# Process Outfile Files
        close $flog
        close $fdef
        close $fadj
        close $fdefclk
        close $fadjclk
	autodesign_print_stage blue [format "     - Infox :   Files $xdir/*"]
	foreach x [ls $xdir/*] {
		autodesign_print_stage blue [format "                       - $x"]	
	}

}
##------------------------------------------------------------------
## ProcNameEnd    : autodesign_get_zero_iotiming
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : autodesign_gspan_mapping
## ProcArguments  : autodesign_gspan_mapping prefix XCORNER outdir
## ProcDependency : autodesign_print_stage , sh 
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc autodesign_gspan_mapping {prefix XCORNER outdir} {
    global ssi_sta_tool_unit_dly
	set design_name [get_object_name [current_design]]
	set outdir $outdir
	file mkdir $outdir
	set outdir [file normalize $outdir]
	autodesign_print_stage blue [format "\n\n=============================================================================================" ]
	autodesign_print_stage red  [format "<SDC_GEN> : Created o/p directory %s"  "$outdir"]
	set filter_tag "gspan_spec"
	autodesign_print_stage blue [format "\n\n=============================================================================================" ]


        #set rx_clks [sort_collection [get_pins -hier -filter "full_name=~*/gspan_receiver_subsys/rx_clk"] full_name]
        set tx_clks  [sort_collection [get_pins -hier -filter "full_name=~*/gspan_sender_subsys/tx_clk"] full_name]
        set rx_clks [sort_collection [get_pins -hier -filter "full_name=~*/gspan_receiver_transport/ss_in_clk*"] full_name]

        set clock_list [list "#ClockID,#PortName,#Clock@Port,#Freq/$XCORNER,#SenderSpec,#IPClk"]


  	# Define Gen Clocks for RX_CLKS
        #puts "#============================================================================================" 
        #puts "## RX Clocks"
        #puts "#============================================================================================\n\n" 
        set index 0
        foreach_in_collection  trx_clk $rx_clks {
            # Clock Info
            set trx_clk_name             [get_object_name $trx_clk]
            set trx_clk_port             [get_ports -quiet [all_fanin -quiet  -flat -to $trx_clk_name -start -trace all]]
            set trx_clk_port_name        [get_object_name $trx_clk_port]
	    set trx_clk_at_port          [get_object_name [filter_collection [get_attribute  -quiet $trx_clk_port clocks] "full_name=~*GSPAN* || full_name=~*_SS*"]]
	    
	    if { $trx_clk_at_port != "" } {
		set trx_clk_period       [get_attribute -quiet [get_clocks -quiet $trx_clk_at_port] period]
		set trx_clk_freq         [format "%04d MHz" [expr int($ssi_sta_tool_unit_dly/$trx_clk_period)]]
	    } else {
		set trx_clk_at_port "none"
		set trx_clk_freq    "0000 MHz"
	    }
            # Clock Spec
            set pll_spec_name            "<SSWRP>/$trx_clk_port_name"
            set valid_ip_clk             [get_attribute -quiet [filter_collection [all_fanin -quiet -to $trx_clk -flat -pin_level 1 ] "direction==out" ] clocks]
            set valid_ip_clk_name        [get_object_name [get_attribute -quiet [get_object_name $valid_ip_clk] clocks]]

            if { $valid_ip_clk_name == "" } { set valid_ip_clk_name "none"}    

            # Interface ID
            set trx_if_id                $trx_clk_name
            incr index
            regsub -all {/gspan_sender_subsys/tx_clk|gspan/gspan_sender_|/gspan_receiver_transport/ss_in_clk.0.|gspan/gspan_receiver_} $trx_if_id {} trx_if_id
            regsub -all {.*/} $trx_if_id {} trx_if_id;   regsub -all {^u_} $trx_if_id {} trx_if_id
            set id_index [format "%03d" $index]
            set gspan_clk_name "RX_${id_index}_$trx_if_id"

            # Data Stream
            set  data "$gspan_clk_name,$trx_clk_port_name,$trx_clk_at_port,$trx_clk_freq,$pll_spec_name,$valid_ip_clk_name"
	    #puts $data
            lappend clock_list $data
            
        }    

        # Define Gen Clocks for TX_CLKS
        #puts "#============================================================================================" 
        #puts "## TX Clocks"
        #puts "#============================================================================================\n\n" 
        set index 0
        foreach_in_collection  trx_clk $tx_clks {
            # Clock Info
            set trx_clk_name             [get_object_name $trx_clk]
            set trx_clk_port             [get_ports -quiet [all_fanout -quiet  -flat -from $trx_clk_name -end -trace all]]
            set trx_clk_port_name        [get_object_name $trx_clk_port]
	    set trx_clk_at_port          [get_object_name [filter_collection [get_attribute  -quiet $trx_clk_port clocks] "full_name=~*GSPAN* || full_name=~*_SS*"]]

	    if { $trx_clk_at_port != "" } {
		set trx_clk_period       [get_attribute -quiet [get_clocks -quiet $trx_clk_at_port] period]
		set trx_clk_freq         [format "%04d MHz" [expr int($ssi_sta_tool_unit_dly/$trx_clk_period)]]
	    } else {
		set trx_clk_at_port "none"
		set trx_clk_freq    "0000 MHz"
	    }
            # Clock Spec
            set pll_spec_name            "$prefix/$trx_clk_port_name"
            set valid_ip_clk             [get_attribute -quiet [get_clocks -quiet $trx_clk_at_port] master_clock]
            set valid_ip_clk_name        [get_object_name $valid_ip_clk]

            if { $valid_ip_clk_name == "" } { set valid_ip_clk_name "none"}    

            # Interface ID
            set trx_if_id                $trx_clk_name
            incr index
            regsub -all {/gspan_sender_subsys/tx_clk|gspan/gspan_sender_|/gspan_receiver_transport/ss_in_clk.0.|gspan/gspan_receiver_} $trx_if_id {} trx_if_id
            regsub -all {.*/} $trx_if_id {} trx_if_id;   regsub -all {^u_} $trx_if_id {} trx_if_id
            set id_index [format "%03d" $index]
            set gspan_clk_name "TX_${id_index}_$trx_if_id"

            # Data Stream
            set  data "$gspan_clk_name,$trx_clk_port_name,$trx_clk_at_port,$trx_clk_freq,$pll_spec_name,$valid_ip_clk_name"
	    #puts $data
            lappend clock_list $data

        }    


  	file mkdir $outdir
	set outdir [file normalize $outdir]
        set filex [open "$outdir/$filter_tag.$XCORNER.csv" w+]

        #puts "#============================================================================================"  
        #puts "# GSPAN Clock Def CSV"         
        #puts "#============================================================================================\n\n"  
        foreach x $clock_list { puts $filex $x ;} ; #puts "$x" ; 
        close $filex
	catch { sh cat $outdir/$filter_tag.$XCORNER.csv | sed -e "s/,/, | /g;" | column -t -s "," > $outdir/$filter_tag.$XCORNER.rpt }
	set status "gspan_spec:$XCORNER.Spec,<OUTDIR>/$filter_tag.$XCORNER.rpt"

	autodesign_print_stage blue [format "=============================================================================================" ]
	autodesign_print_stage red  [format "<SDC_GEN> : Completed GSPAN Spec Generation for  $design_name  $status"]
	autodesign_print_stage blue [format "            %-s"  "[sh wc -l $outdir/$filter_tag.$XCORNER.rpt]" ]
	autodesign_print_stage blue [format "            <CMD> sh wc -l [file normalize $outdir]/$filter_tag.*"]
	autodesign_print_stage blue [format "=============================================================================================" ]
	return $status
}
##------------------------------------------------------------------
## ProcNameEnd    : autodesign_gspan_mapping
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : autodesign_id_refcell
## ProcArguments  : autodesign_id_refcell cell
## ProcDependency : parray 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc autodesign_id_refcell cell {
	set col [get_lib_cell -quiet $cell]
        array unset final_data

	if { [sizeof_collection $col] } {
		foreach_in_collection cellx $col {
			set cellid          [get_object_name $cellx]
			array unset data 
			set Xbase_name       [get_attribute -quiet $cellx base_name]         
			set data(_is_comb)   [get_attribute -quiet $cellx is_combinational] 
			set data(_is_icgx)   [get_attribute -quiet $cellx is_integrated_clock_gating_cell] 
			set data(_is_latN)   [get_attribute -quiet $cellx is_negative_level_sensitive] 
			set data(_is_latP)   [get_attribute -quiet $cellx is_positive_level_sensitive] 
			set data(_is_dffR)   [get_attribute -quiet $cellx is_rise_edge_triggered] 
			set data(_is_dffF)   [get_attribute -quiet $cellx is_fall_edge_triggered] 
			set data(_is_isox)   [get_attribute -quiet $cellx is_isolation] 
			set data(_is_lvlx)   [get_attribute -quiet $cellx is_level_shifter] 
			set data(_is_imux)   [get_attribute -quiet $cellx is_mux] 

			set data(_is_smem)   [get_attribute -quiet $cellx is_memory_cell] 
			set data(_op_pins)   [sizeof_collection [get_lib_pins -of_object $cellx -filter "direction==out"] ]
			set data(_o_sense)   [lsort -unique [get_attribute -quiet [get_lib_timing_arc -to [get_lib_pins -of_object $cellx -filter "direction==out"]] sense ]]
			if { $data(_is_comb) == "false" } {  set data(_o_sense) "seq_unate"}
			if { [llength [lsearch -all -inline $data(_o_sense)  "positive_unate"]] && [llength [lsearch -all -inline $data(_o_sense)  "negative_unate"]]} {  set data(_o_sense) "both_unate"}
			if { [llength [lsearch -all -inline $data(_o_sense)  "negative_unate"]]} {  set data(_o_sense) "neg_unate"}
			if { [llength [lsearch -all -inline $data(_o_sense)  "positive_unate"]]}  {  set data(_o_sense) "pos_unate"}

			set data(_i_pins)    [sizeof_collection [get_lib_pins -of_object $cellx  -filter "direction==in"] ]
			set line ""	
			foreach x [lsort [array names data]] {
			  #puts "$cellid $x $data($x)"
			  if { $data($x) == "" } { set data($x) "NA"}
			  set line "$line\t$x=$data($x)"		
			}
			set final_data($Xbase_name) $line
		}
	}
	parray final_data
}
##------------------------------------------------------------------
## ProcNameEnd    : autodesign_id_refcell
