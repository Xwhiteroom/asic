##------------------------------------------------------------------
## ProcNameStart  : sta_qc_report_all
## ProcArguments  : sta_qc_report_all BASE_TAG rep_dir
## ProcDependency : sta_qc_report_misc , sta_qc_report_pathfull , check_iter , sta_qc_report_drv , sta_qc_report_histo 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qc_report_all {BASE_TAG rep_dir} {
    file mkdir $rep_dir
    set my_design [get_object_name [current_design ]]   
    #catch { check_iter max $BASE_TAG }
    #catch { check_iter min $BASE_TAG }
