##------------------------------------------------------------------
## ProcNameStart  : get_proc_def
## ProcArguments  : get_proc_def procName
## ProcDependency :  
## ProcInfluence  : 3
## ProcRenamed    : 0
##------------------------------------------------------------------
proc get_proc_def procName {
    set result [list proc $procName]
    set formals {}
    foreach var [info args $procName] {
        if {[info default $procName $var def]} {
            lappend formals [list $var $def]
        } else {
            # Still need the list-quoting because variable
            # names may properly contain spaces.
            lappend formals [list $var]
        }
    }
    return [lappend result $formals [info body $procName]]
}
##------------------------------------------------------------------
## ProcNameEnd    : get_proc_def
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : get_proc_dependency
## ProcArguments  : get_proc_dependency proc_name
## ProcDependency :  
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc get_proc_dependency proc_name {

    # Master Proc Set
    set all_procs               [lsort [info procs]]
    
    # Trim Proc Body
    set proc_body               [info body $proc_name]
    regsub -all {\t|\t\+| \+}   $proc_body  " "    proc_body                            ; # Spaces 
    regsub -all {\}|\]|"|;}     $proc_body  ""     proc_body                            ; # Braces / Quotes
    regsub -all {;}             $proc_body  "\n"   proc_body                            ; # Line Breaks 
    regsub -all {#}             $proc_body  "\n#"  proc_body                            ; # Comments 
    regsub -all {\[|\{}         $proc_body  "\n"   proc_body                            ; # Proc Hint
    set proc_body               [split $proc_body "\n"]                                 ; # Itemization
    set proc_body_nocomments    [lsearch -inline -all -not -regexp $proc_body "^#"]     ; # Comment Filtering
    set proc_body_noblanks      [lsearch -inline -all -not -regexp $proc_body_nocomments "^$|^ $"]     ; # BlankLine Filtering

    # Match Array
    array unset proc_dependency
    set count                   0
    foreach line $proc_body_noblanks {
        set orgline $line
        set target_proc [lindex $line 0]
        incr count
        # Debug Only
        #puts "$count/[llength $proc_body_nocomments] <$target_proc>$line|$orgline<"
        set proc_dependency($target_proc) 1
    }
    set valid_dependency [list]
    foreach found_proc_candidate  [array names proc_dependency] {
        set proc_matches [lsearch -inline -all -exact $all_procs $found_proc_candidate]
        if { [llength $proc_matches] } {
            lappend valid_dependency $found_proc_candidate
        } 
    }
  return $valid_dependency
}
##------------------------------------------------------------------
## ProcNameEnd    : get_proc_dependency
##------------------------------------------------------------------


