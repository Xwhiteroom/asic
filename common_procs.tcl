##------------------------------------------------------------------
## ProcNameStart  : sta_qual_disable_timing_arcs_ref
## ProcArguments  : sta_qual_disable_timing_arcs_ref all_rams_ref from_pin to_pin
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_disable_timing_arcs_ref {all_rams_ref from_pin to_pin} {
    global synopsys_program_name pt_shell_mode
    set i 0
    foreach_in_collection my_ram_ref $all_rams_ref {
        set my_ram_ref [get_object_name $my_ram_ref]
        incr i
        if { [sizeof_collection [get_lib_pins -quiet $my_ram_ref/$from_pin]] > 0 && [sizeof_collection [get_lib_pins -quiet $my_ram_ref/$to_pin]] > 0 } {
            foreach_in_collection f_pin [get_lib_pins  $my_ram_ref/$from_pin] {
                foreach_in_collection t_pin [get_lib_pins $my_ram_ref/$to_pin] {
                    set f_name [lindex [split [get_object_name $f_pin] "/"]  end]
                    set t_name [lindex [split [get_object_name $t_pin] "/"]  end]
                    if { [info exist pt_shell_mode ] } {
                        set arc    [get_lib_timing_arc -quiet -from [get_object_name $f_pin] -to [get_object_name $t_pin]]
                    } else {
                        set arc    [get_lib_timing_arc        -from [get_object_name $f_pin] -to [get_object_name $t_pin]]
                    }
                    #-of_objects [get_lib_cell $my_ram_ref]]
                    if { [sizeof_collection $arc ] > 0 } {
                    #puts "**STA_SDC_INFO:  $i)	Disabled Cell Lib Arc $f_name<->$t_name $my_ram_ref"
                    set_disable_timing -from $f_name -to $t_name [get_lib_cell $my_ram_ref]
                    }
                }
                puts "**STA_SDC_INFO:  DIS: Disabled LibCell Arc <CMD> set_disable_timing -from $from_pin -to $to_pin \[get_lib_cell $my_ram_ref\]"
            }
        }
    }
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_disable_timing_arcs_ref
