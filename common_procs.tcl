##------------------------------------------------------------------
## ProcNameStart  : get_io_clks
## ProcArguments  : get_io_clks pattern
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc get_io_clks pattern {
    set ports [get_ports -quiet $pattern]
    echo "  <INFO> Port Pattern : $pattern  [sizeof_collection $ports]"
    set clock_ports [get_ports  -quiet [get_attribute -quiet [get_clocks -quiet *] sources]]
    set data [list [format "  %10s %10s %30s"  "Direction" "#Fanout" "#Port_Name"]]
    foreach_in_collection in_port [get_ports $pattern -filter "direction==in"] {
        set fanout_clk_reg [get_pins -quiet [all_fanout -from $in_port -flat -endpoints_only ] -filter "is_clock_pin==true"]
        if { [sizeof_collection $fanout_clk_reg] } {
            lappend data [format "  %10s %10s %30s"  [get_attr [get_ports $in_port] direction ] [sizeof_collection $fanout_clk_reg] [get_object_name $in_port]]
            set clock_ports [add_to_collection $in_port $clock_ports]
        }
    }


    foreach_in_collection out_port [get_ports $pattern -filter "direction==out"] {
        set fanin_clk_port [get_ports -quiet [all_fanin -to $out_port -flat -startpoints_only ]]
        set intersect [remove_from_collection  -intersect $fanin_clk_port $clock_ports]
        if { [sizeof_collection $intersect] } {
            lappend data [format "  %10s %10s %30s"  [get_attr [get_ports $out_port] direction ] [sizeof_collection $intersect] [get_object_name $out_port]]
        }
    }


    #puts [format "  %10s %10s %30s"  "Direction" "#Clock_Fanout" "#Port_Name"]
    foreach x $data {puts "$x";}

}
