##------------------------------------------------------------------
## ProcNameStart  : pt_calc_div_cz
## ProcArguments  : pt_calc_div_cz node xclocks
## ProcDependency : pt_map_table 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc pt_calc_div_cz {node xclocks} {
	global CORNER
	set xdata [list [list "#Corner" "#Clock" "#Clk2Q_RiseMax" "#Clk2Q_RiseMin" "#Clk2Q_FallMax" "#Clk2Q_FallMin" "#DCD_Structural"]]
	foreach_in_collection xclock $xclocks {

		set pathfallmax [get_timing_path -delay max  -through $node -fall_from [get_clocks $xclock] ]
		set pathrisemax [get_timing_path -delay max  -through $node -rise_from [get_clocks $xclock] ]

		set pathfallmin [get_timing_path -delay min  -through $node -fall_from [get_clocks $xclock] ]
		set pathrisemin [get_timing_path -delay min  -through $node -rise_from [get_clocks $xclock] ]
	
		set dcd_1       [expr abs(0 + [get_attr $pathrisemax arrival] -  [get_attr $pathfallmin arrival] + 0)]
		set dcd_2       [expr abs(0 + [get_attr $pathfallmax arrival] -  [get_attr $pathrisemin arrival] + 0)]
		set dcd $dcd_2
		if { $dcd_1 > $dcd_2 }  { set dcd $dcd_1 }

		set data [list $CORNER [get_object_name  $xclock] [get_attr $pathrisemax arrival] [get_attr $pathrisemin arrival]  [get_attr $pathfallmax arrival] [get_attr $pathfallmin arrival] $dcd]
		lappend xdata $data
	}
	pt_map_table $xdata
	return $xdata
}
##------------------------------------------------------------------
## ProcNameEnd    : pt_calc_div_cz
