proc set_tech_dontuse {} {
    ## Tech Lib Pattern
    global GC_STA_ECO_TECH    
    file mkdir dut_logs
    regsub -all { |:.*}  [lrange [date] 1 3]  {_} date_log
    ## Lib Patterns
    if { ![regexp "7T" $GC_STA_ECO_TECH]   } { set dut_libcateg(track)    "*/*M7P5T*"                                                     }
    if { ![regexp "6T" $GC_STA_ECO_TECH]   } { set dut_libcateg(track)    "*/*S6T*"                                                       }
    if {  [regexp "5LPE" $GC_STA_ECO_TECH] } { set dut_libcateg(00_base)  "*/ANTENNA* */FILL* */FRICG*  */MX2_* */POSTICG* */*ECO*"       }
    if {  [regexp "5LPE" $GC_STA_ECO_TECH] } { set dut_libcateg(01_base)  "*/SDFFY* */EPBUF* */EPINV*  */*TIE* *1fin*/* *elk*/*"          }
    # < Add Custom VT here >

    ## Add Dont Use/Touch - Libs (Touch as You dont want to touch SYNCERS)
    set_dont_use      [get_lib_cells -quiet  */*] false
    foreach categ [array names dut_libcateg] {
     set_dont_use      [get_lib_cells -quiet $dut_libcateg($categ)] true
     set_dont_touch    [get_lib_cells -quiet $dut_libcateg($categ)] true
     echo "[date] DU_CELLS  = $categ"    >> ./dut_logs/[current_scenario].dut.$date_log.log
     echo "[date] DT_CELLS  = $categ"    >> ./dut_logs/[current_scenario].dut.$date_log.log
    }

    set du_cells      [get_lib_cells -quiet  */* -filter "dont_use==true"]
    set nondu_cells   [get_lib_cells -quiet  */* -filter "dont_use==false"]
    set dt_cells      [get_lib_cells -quiet  */* -filter "dont_touch==true"]
    set nondt_cells   [get_lib_cells -quiet  */* -filter "dont_touch==false"]

    echo "[date] DU_CELLS    = [sizeof_collection $du_cells]"    >> ./dut_logs/[current_scenario].dut.$date_log.log
    echo "[date] NONDU_CELLS = [sizeof_collection $nondu_cells]" >> ./dut_logs/[current_scenario].dut.$date_log.log
    echo ""  
    echo "[date] DT_CELLS    = [sizeof_collection $dt_cells]"    >> ./dut_logs/[current_scenario].dut.$date_log.log
    echo "[date] NONDT_CELLS = [sizeof_collection $nondt_cells]" >> ./dut_logs/[current_scenario].dut.$date_log.log
    echo ""  
