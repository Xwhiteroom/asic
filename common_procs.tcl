## ProcArguments  : sta_qual_report_config_restore BASE_TAG rep_dir stage
## ProcDependency : print_message_info 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_report_config_restore {BASE_TAG rep_dir stage} {
    file mkdir $rep_dir    
    echo "** STA_CFG_INFO: Start dumping timing settings: write_app_var      [date]"
    write_app_var -all                -output $rep_dir/${BASE_TAG}.$stage.write_app_var.all.rpt
    write_app_var -only_changed_vars  -output $rep_dir/${BASE_TAG}.$stage.write_app_var.changed.rpt

    echo "** STA_CFG_INFO: Start dumping timing settings: print_message_info      [date]"
    print_message_info                 > $rep_dir/${BASE_TAG}.$stage.print_message_info.all.rpt

    echo "** STA_CFG_INFO: Start dumping timing settings: write_session_settings  [date]"
    write_session_settings            -output $rep_dir/${BASE_TAG}.$stage.write_session_settings..rpt

    echo "** STA_CFG_INFO: Start dumping timing settings: print var settings      [date]"
    printvar  -application            > $rep_dir/${BASE_TAG}.$stage.write_print_var.application.rpt
    printvar  -user_defined           > $rep_dir/${BASE_TAG}.$stage.write_print_var.user.rpt
}
