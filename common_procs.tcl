##------------------------------------------------------------------
## ProcNameStart  : report_portsplit
## ProcArguments  : report_portsplit CLOCKS
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc report_portsplit CLOCKS {
    global sta_qual_sta_rundir MODE CORNER TOP_DESIGN SPEF_TOP
    set ip "$TOP_DESIGN.[lindex [split $SPEF_TOP "/"]  end-2]"
    echo "#ip,xclock,direction,port,slack,slvt08,slvt10,lvt08,lvt10,totalc" > $ip.$MODE.$CORNER.report.txt
    foreach xclock [get_object_name [get_clocks $CLOCKS]]  {
        set ports [add_to_collection [all_inputs -exclude_clock_ports -clock $xclock] [all_outputs -clock $xclock]]
        foreach_in_collection xport $ports {
            set port      [get_object_name $xport]
            set direction [ get_attr      [get_ports $xport] direction]
            set slack     [ get_attr      [get_ports $xport] max_slack] 
            if { $direction == "out" } {
                set cone   [get_cells -quiet [all_fanin  -flat -to   $port -only_cells] -filter "is_hierarchical==false"] 
            } else {
                set cone   [get_cells -quiet [all_fanout -flat -from $port -only_cells] -filter "is_hierarchical==false"]         
            }
            set totalc [sizeof_collection $cone]
            set slvt08 [sizeof_collection [filter_collection $cone "ref_name=~*TSL*L08"]]
            set slvt10 [sizeof_collection [filter_collection $cone "ref_name=~*TSL*L10"]]
            set  lvt08 [sizeof_collection [filter_collection $cone "ref_name=~*TL*L08"]]
            set  lvt10 [sizeof_collection [filter_collection $cone "ref_name=~*TL*L10"]]
            echo  "$ip,$xclock,$direction,$port,$slack,$slvt08,$slvt10,$lvt08,$lvt10,$totalc" >> $ip.$MODE.$CORNER.report.txt
        }
    }
    puts "Open File : ./$ip.$MODE.$CORNER.report.txt"

}
