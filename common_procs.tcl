##------------------------------------------------------------------
## ProcNameStart  : sta_qual_check_group_validity
## ProcArguments  : sta_qual_check_group_validity base_set main_set args
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_check_group_validity {base_set main_set args} {
   global synopsys_program_name pt_shell_mode
   set base_clk [get_clocks -quiet $base_set]
   set main_clk [get_clocks -quiet $main_set]
   set comp_main [remove_from_collection $main_clk    $base_clk]
   set comp_all  [remove_from_collection [all_clocks] $base_clk]
   set  i 0
   if { [sizeof_collection $base_clk] < 1 } {
        puts "**STA_SDC_WARN: GRP: Empty Base Group Provided Expect Grouping Error | base_clk = 0 | $args"
        incr i
   }
   if { [sizeof_collection $comp_main] < 1 } {
        puts "**STA_SDC_WARN: GRP: Empty Filtered Complementary Group Provided Expect Grouping Error | main_clocks - base_clk = 0 | $args"
        incr i
   }
   if { [sizeof_collection $comp_all] < 1 } {
        puts "**STA_SDC_WARN: GRP: Empty All Complementary Group Provided Expect Grouping Error | all_clocks - base_clk = 0 | $args"
        incr i
   }

}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_check_group_validity
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_clock_jitter_map
## ProcArguments  : sta_qual_clock_jitter_map 
## ProcDependency : sta_qual_clock_map_generate 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_clock_jitter_map {} {

  global CONS_DIR XDESIGN XCORNER
  global sta_qual_clock_map sta_qual_clock_jitter sta_qual_clock_jitter_exclude sta_qual_soc_clock_jitter sta_qual_clock_to_hier_map sta_qual_sswrp_hier_map sta_qual_sswrp_soc_map sta_qual_soc_name_map sta_qual_partition_hier_map

  if { $XDESIGN == "soc" } {
    sta_qual_clock_map_generate
  }

  puts "**STA_SDC_INFO: Sourcing jitter/uncertainty constraints for all clocks in the design"

  set status 1
  set corner_list [list UUD SUD UD NM]
  set clocks [get_clocks -quiet]
  set gspan_clocks [get_clocks -quiet -filter "full_name=~*GSPAN* || full_name=~*_SS_*"]
  set non_gspan_clocks [remove_from_collection $clocks $gspan_clocks]
  set total_gspan_clocks [sizeof_collection $gspan_clocks]
  set total_non_gspan_clocks [sizeof_collection $non_gspan_clocks]
  puts "**STA_SDC_INFO: Total GSPAN clocks = $total_gspan_clocks, Total non-GSPAN clocks = $total_non_gspan_clocks\n"

  if { [file exists ./${XDESIGN}_clock_uncertainty.tcl] } {
       puts "**STA_SDC_INFO: Clock jitter/uncertainty file already exists! Moving this to ./${XDESIGN}_clock_uncertainty.backup.tcl"
       file rename -force ./${XDESIGN}_clock_uncertainty.tcl ./${XDESIGN}_clock_uncertainty.backup.tcl
  }
  if { [catch {open ./${XDESIGN}_clock_uncertainty.tcl "w"} jitter_fp] } {
      puts "**STA_SDC_ERROR: Cannot open clock jitter/uncertainty file for write!\n"
      set status 0
  } else {
      puts "**STA_SDC_INFO: Setting clock jitter/uncertainty file to ./${XDESIGN}_clock_uncertainty.tcl\n"
  }

  if { $status == 1 } {

    #process gspan clocks
    foreach_in_collection clock $gspan_clocks {
      puts $jitter_fp "##-------------------------------------------------------------------------------------------------"
      puts $jitter_fp "#STA_SDC_INFO: Setting jitter/uncertainty for clock = [get_object_name $clock] (gspan clock) to 0"
      puts $jitter_fp "##-------------------------------------------------------------------------------------------------\n"
      puts $jitter_fp "set_clock_uncertainty 0 -setup -rise_from \[get_clocks -quiet [get_object_name $clock]\] -rise_to \[get_clocks -quiet [get_object_name $clock]\] "
      puts $jitter_fp "set_clock_uncertainty 0 -setup -fall_from \[get_clocks -quiet [get_object_name $clock]\] -fall_to \[get_clocks -quiet [get_object_name $clock]\]"
      puts $jitter_fp "set_clock_uncertainty 0 -setup -rise_from \[get_clocks -quiet [get_object_name $clock]\] -fall_to \[get_clocks -quiet [get_object_name $clock]\]"
      puts $jitter_fp "set_clock_uncertainty 0 -setup -fall_from \[get_clocks -quiet [get_object_name $clock]\] -rise_to \[get_clocks -quiet [get_object_name $clock]\]"
      puts $jitter_fp "set_clock_uncertainty 0 -hold -rise_from \[get_clocks -quiet [get_object_name $clock]\] -fall_to \[get_clocks -quiet [get_object_name $clock]\]"
      puts $jitter_fp "set_clock_uncertainty 0 -hold -fall_from \[get_clocks -quiet [get_object_name $clock]\] -rise_to \[get_clocks -quiet [get_object_name $clock]\]\n\n"
    }

    #process non-gspan clocks
    if { $XDESIGN != "soc" } {
        #no need to parse sta_qual_clock_map for processing clock jitter/uncertainty at sswrp-level
        set all_hiers [array names sta_qual_soc_clock_jitter]
        set all_clocks [array names sta_qual_clock_jitter]

        if { [array names sta_qual_sswrp_hier_map] > 0 } {
          foreach {sswrp_key partition_val} [array get sta_qual_sswrp_hier_map] {
            foreach par $partition_val {
              set sta_qual_partition_hier_map($par) $sswrp_key
            }
          }
        }      

        foreach_in_collection clock $non_gspan_clocks {
          puts $jitter_fp "##---------------------------------------------------------------------------------------------------"
          puts $jitter_fp "#STA_SDC_INFO: Processing jitter/uncertainty for clock = [get_object_name $clock] (non-gspan clock)"
          puts $jitter_fp "##---------------------------------------------------------------------------------------------------\n"

          if { [info exists sta_qual_partition_hier_map($XDESIGN)] } {
              set sswrp_module $sta_qual_partition_hier_map($XDESIGN)
          } elseif { [info exists sta_qual_sswrp_soc_map($XDESIGN)] } {
              set sswrp_module $sta_qual_sswrp_soc_map($XDESIGN)
          } else {
              set sswrp_module [lsearch -inline $all_hiers *\/u_${XDESIGN}]
          }

          if { [lsearch [array names sta_qual_clock_jitter_exclude] [get_object_name $clock]] > -1 && [lsearch -exact $sta_qual_clock_jitter_exclude([get_object_name $clock]) $XDESIGN] >= 0 } {
              puts $jitter_fp "#STA_SDC_INFO: Jitter/DCD numbers for clock [get_object_name $clock] will not be applied as clock is excluded in sta_qual_clock_jitter_exclude for $XDESIGN\n"
          } else {
              if { [lsearch [array names sta_qual_clock_jitter] [get_object_name $clock]] > -1 } {
                  set jitter_value [lindex $sta_qual_clock_jitter([get_object_name $clock]) [lsearch $corner_list [lindex [split $XCORNER "_"] 0]]]
                  puts $jitter_fp "#STA_SDC_INFO: Jitter for clock [get_object_name $clock] = $jitter_value ps"
                  set dcd_value [lindex $sta_qual_clock_jitter([get_object_name $clock]) [expr [lsearch $corner_list [lindex [split $XCORNER "_"] 0]] + [lsearch $corner_list [lindex [split $XCORNER "_"] 0]] + 1]]
                  puts $jitter_fp "#STA_SDC_INFO: DCD for clock [get_object_name $clock] = $dcd_value ps"
              } elseif { $sswrp_module != "" } {
                  set jitter_value [lindex $sta_qual_soc_clock_jitter($sswrp_module) [lsearch $corner_list [lindex [split $XCORNER "_"] 0]]]
                  puts $jitter_fp "#STA_SDC_INFO: Jitter for clock [get_object_name $clock] = $jitter_value ps"
                  set dcd_value [lindex $sta_qual_soc_clock_jitter($sswrp_module) [expr [lsearch $corner_list [lindex [split $XCORNER "_"] 0]] + [lsearch $corner_list [lindex [split $XCORNER "_"] 0]] + 1]]
                  puts $jitter_fp "#STA_SDC_INFO: DCD for clock [get_object_name $clock] = $dcd_value ps"
              } else {
                  puts $jitter_fp "#STA_SDC_WARN: Unable to trace jitter value in sta_qual_soc_clock_jitter and sta_qual_clock_jitter for [get_object_name $clock]\n\n"
                  continue
              }

             if { $jitter_value != "" } {
                 set jitter_value_ns [expr $jitter_value*0.001]
                 puts $jitter_fp "set_clock_uncertainty $jitter_value_ns -setup -rise_from \[get_clocks -quiet [get_object_name $clock]\] -rise_to \[get_clocks -quiet [get_object_name $clock]\]"
                 puts $jitter_fp "set_clock_uncertainty $jitter_value_ns -setup -fall_from \[get_clocks -quiet [get_object_name $clock]\] -fall_to \[get_clocks -quiet [get_object_name $clock]\]"
             }
             if { $dcd_value != "" } {
                 set dcd_value_ns [expr $dcd_value*0.001]
                 puts $jitter_fp "set_clock_uncertainty $dcd_value_ns -setup -rise_from \[get_clocks -quiet [get_object_name $clock]\] -fall_to \[get_clocks -quiet [get_object_name $clock]\]"
                 puts $jitter_fp "set_clock_uncertainty $dcd_value_ns -setup -fall_from \[get_clocks -quiet [get_object_name $clock]\] -rise_to \[get_clocks -quiet [get_object_name $clock]\]"
                 puts $jitter_fp "set_clock_uncertainty $dcd_value_ns -hold -rise_from \[get_clocks -quiet [get_object_name $clock]\] -fall_to \[get_clocks -quiet [get_object_name $clock]\]"
                 puts $jitter_fp "set_clock_uncertainty $dcd_value_ns -hold -fall_from \[get_clocks -quiet [get_object_name $clock]\] -rise_to \[get_clocks -quiet [get_object_name $clock]\]\n\n"
             }
          }
        }
    } else {
        #parse sta_qual_clock_map data for processing clock jitter/uncertainty at soc-level
        set all_map_clocks [array names sta_qual_clock_map]
        foreach_in_collection clock $non_gspan_clocks {
          set top_level_clock [get_object_name $clock]
          if { [lsearch -inline $all_map_clocks $top_level_clock] != "" } {
            set block_level_clock $sta_qual_clock_map($top_level_clock)
            if { [lsearch [array names sta_qual_clock_to_hier_map] $top_level_clock] > -1 } {
              if { [info exists sta_qual_soc_name_map($sta_qual_clock_to_hier_map($top_level_clock))] } {
                  set sswrp_module $sta_qual_soc_name_map($sta_qual_clock_to_hier_map($top_level_clock))
              } else {
                  set sswrp_module $sta_qual_clock_to_hier_map($top_level_clock)
              }
            }
            puts $jitter_fp "##---------------------------------------------------------------------------------------------------"
            puts $jitter_fp "#STA_SDC_INFO: Processing jitter/uncertainty for clock = $top_level_clock (non-gspan clock)"
            puts $jitter_fp "##---------------------------------------------------------------------------------------------------\n"
            if { [lsearch [array names sta_qual_clock_jitter] $block_level_clock] > -1 } {
                set jitter_value [lindex $sta_qual_clock_jitter($block_level_clock) [lsearch $corner_list [lindex [split $XCORNER "_"] 0]]]
                puts $jitter_fp "#STA_SDC_INFO: Jitter for clock $top_level_clock = $jitter_value ps"
                set dcd_value [lindex $sta_qual_clock_jitter($block_level_clock) [expr [lsearch $corner_list [lindex [split $XCORNER "_"] 0]] + [lsearch $corner_list [lindex [split $XCORNER "_"] 0]] + 1]]
                puts $jitter_fp "#STA_SDC_INFO: DCD for clock $top_level_clock = $dcd_value ps"
            } elseif { $sswrp_module != "" } {
                set jitter_value [lindex $sta_qual_soc_clock_jitter($sswrp_module) [lsearch $corner_list [lindex [split $XCORNER "_"] 0]]]
                puts $jitter_fp "#STA_SDC_INFO: Jitter for clock $top_level_clock = $jitter_value ps"
                set dcd_value [lindex $sta_qual_soc_clock_jitter($sswrp_module) [expr [lsearch $corner_list [lindex [split $XCORNER "_"] 0]] + [lsearch $corner_list [lindex [split $XCORNER "_"] 0]] + 1]]
                puts $jitter_fp "#STA_SDC_INFO: DCD for clock $top_level_clock = $dcd_value ps"
            } else {
                puts $jitter_fp "#STA_SDC_WARN: Unable to trace jitter value in sta_qual_soc_clock_jitter and sta_qual_clock_jitter for $top_level_clock (block level clock name = $block_level_clock)\n\n"
                continue
            }
            if { $jitter_value != "" } {
                set jitter_value_ns [expr $jitter_value*0.001]
                puts $jitter_fp "set_clock_uncertainty $jitter_value_ns -setup -rise_from \[get_clocks -quiet [get_object_name $clock]\] -rise_to \[get_clocks -quiet [get_object_name $clock]\]"
                puts $jitter_fp "set_clock_uncertainty $jitter_value_ns -setup -fall_from \[get_clocks -quiet [get_object_name $clock]\] -fall_to \[get_clocks -quiet [get_object_name $clock]\]"
            }
            if { $dcd_value != "" } {
                set dcd_value_ns [expr $dcd_value*0.001]
                puts $jitter_fp "set_clock_uncertainty $dcd_value_ns -setup -rise_from \[get_clocks -quiet [get_object_name $clock]\] -fall_to \[get_clocks -quiet [get_object_name $clock]\]"
                puts $jitter_fp "set_clock_uncertainty $dcd_value_ns -setup -fall_from \[get_clocks -quiet [get_object_name $clock]\] -rise_to \[get_clocks -quiet [get_object_name $clock]\]"
                puts $jitter_fp "set_clock_uncertainty $dcd_value_ns -hold -rise_from \[get_clocks -quiet [get_object_name $clock]\] -fall_to \[get_clocks -quiet [get_object_name $clock]\]"
                puts $jitter_fp "set_clock_uncertainty $dcd_value_ns -hold -fall_from \[get_clocks -quiet [get_object_name $clock]\] -rise_to \[get_clocks -quiet [get_object_name $clock]\]\n\n"
            }
          }
        }
    }
    close $jitter_fp

    #source final clock jitter/uncertainty constraints in the current session
    if { [file exists ./${XDESIGN}_clock_uncertainty.tcl] } {
      puts "**STA_SDC_INFO: Sourcing clock jitter/uncertainty constraints from ./${XDESIGN}_clock_uncertainty.tcl"
      source -echo -verbose ./${XDESIGN}_clock_uncertainty.tcl
    }
  }
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_clock_jitter_map
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_clock_map_generate
## ProcArguments  : sta_qual_clock_map_generate 
## ProcDependency :  
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_clock_map_generate {} {
  global CONS_DIR XDESIGN XCORNER sta_qual_clock_map sta_qual_clock_to_hier_map
  set clkmap_f "${CONS_DIR}/${XDESIGN}_clkmap.tcl"
  if { [file exists $clkmap_f] } {
      set clkmap_fp [open $clkmap_f "r"]
      set lines [split [read $clkmap_fp] "\n"]
      close $clkmap_fp
      foreach line $lines {
        if { [regexp {.*#---.*} $line] || [regexp {^HIER\s+BLOCK.*} $line] } {
          continue
        }
        set line_new [regsub -all {\s+} $line " "]
        set sswrp_module [lindex $line_new 0]
        set block_level_clock [lindex $line_new 1]
        set top_level_clock [lindex $line_new 2]
        if { $top_level_clock != "" && $block_level_clock != "" } {
          set sta_qual_clock_map($top_level_clock) $block_level_clock
          set sta_qual_clock_to_hier_map($top_level_clock) $sswrp_module
        }
      }
  } else {
      puts "**STA_SDC_WARN: Cannot find ${XDESIGN}_clkmap.tcl in ${CONS_DIR}"
  }
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_clock_map_generate
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_clocks_soc_db
## ProcArguments  : sta_qual_clocks_soc_db clock_def_ref soc_map_dst_ref
## ProcDependency : parray 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_clocks_soc_db {clock_def_ref soc_map_dst_ref} {

  upvar $clock_def_ref clock_def
  upvar $soc_map_dst_ref soc_map_dst
  array unset sta_qual_clock_source
  array unset sta_qual_clock_db_master_source
  array unset sta_qual_clock_level
  array unset sta_qual_clock_id
  foreach name [lsort -dictionary [array names clock_def]] {
    set point [lindex $clock_def($name) end]
    set clk_id [lindex [split $name "."] 0]
    set id_value [regexp -all -inline -- {[0-9]+} $clk_id]
    set clk_value [lindex [split $clk_id $id_value] 0]
    set clk_level [llength [split $clk_value G]]
    set clk_name  [lindex [split $name "."] 2]
    set sta_qual_clock_level($clk_name) $clk_level
    lappend sta_qual_clock_id($clk_value) $id_value
    set master  [lindex [split [lindex $clock_def($name) 1] ":"] 0]
    lappend sta_qual_clock_db_master_source($master) $name
    set sta_qual_clock_source($point) [lindex [split $name "."] 2]
  }

  foreach name [array names sta_qual_clock_id] {
    set max [tcl::mathfunc::max {*}$sta_qual_clock_id($name)]
    set sta_qual_clock_id($name) $max
  }

  parray sta_qual_clock_source
  parray sta_qual_clock_db_master_source
  parray sta_qual_clock_level
  parray sta_qual_clock_id
  set remove_clocks [list ]
  foreach name [lsort -dictionary [array names clock_def]] {
    set point [lindex $clock_def($name) end]
    regsub -all (\\\[|\\\]) $point {\\\1} point_pattern
    puts "**STA_SDC_INFO: source of $name in sta_qual_clock_def is $point"
    set dst_list [array names soc_map_dst]
    puts "**STA_SDC_INFO: List of destination points from sta_qual_soc_map_dst -> $dst_list"
    set source_list_w_def [array names sta_qual_clock_source]
    puts "**STA_SDC_INFO: Checking for $point in list of destination points from sta_qual_soc_map_dst"
    if {[lsearch $dst_list $point_pattern] > -1 } {
      puts "**STA_SDC_WARN: Definition at $point has source at $soc_map_dst($point)"
      set source_point $soc_map_dst($point)
      regsub -all (\\\[|\\\]) $source_point {\\\1} source_point_pattern

      set old_master [lindex [split $name "."] 2]
      puts "**STA_SDC_INFO: Checking $source_point in sta_qual_clock_source"
      if {[lsearch $source_list_w_def [lindex $source_point_pattern 0]] > -1} {
          puts "**STA_SDC_WARN: Found definition at source $source_point"
          set new_master $sta_qual_clock_source([lindex $source_point 0])
          puts "**STA_SDC_WARN: Need to remove dest [lindex [split $name "."] 2] as clock at source is $sta_qual_clock_source([lindex $source_point 0])"
          lappend remove_clocks $name

          if {[info exists sta_qual_clock_db_master_source($old_master)]} {
            puts "**STA_SDC_WARN: Old master $old_master exists in sta_qual_clock_db_master_source"
            set gen_clocks $sta_qual_clock_db_master_source($old_master)
            puts "**STA_SDC_WARN: Need to change master of $gen_clocks to $new_master"
          } else {
            set gen_clocks ""
          }

          foreach clock $gen_clocks {
            set old_data $clock_def($clock)
            puts "**STA_SDC_WARN: Data for $clock -> $old_data"
            set old_master_clk_edges [lindex $old_data 1]
            set edges [lindex [split $old_master_clk_edges ":"] 1]
            set new_master_clk_edges $new_master:$edges
            puts "$new_master_clk_edges"
            set new_data [lreplace $old_data 1 1 $new_master_clk_edges]
            puts "New Data for $clock -> $new_data"
            puts "Level of new master $sta_qual_clock_level($new_master)"
            set level $sta_qual_clock_level($new_master)
            set new_id "CLK"
            while {$level > 0} {
              set new_id ${new_id}G
              incr level -1
            }
            if {[info exists sta_qual_clock_id($new_id)] == 1} {
              set id_value $sta_qual_clock_id($new_id)
              incr id_value
              set sta_qual_clock_id($new_id) $id_value
              set new_id ${new_id}${id_value}
            } else {
              set sta_qual_clock_id($new_id) 1
              set new_id ${new_id}1
            }
            puts "New id $new_id"
            puts "**STA_SDC_INFO: Adding $clock to the list of clocks to remove"
            lappend remove_clocks $clock
            set mode [lindex [split $clock "."] 1]
            set base_clk_name [lindex [split $clock "."] 2]
            set new_clock_name ${new_id}.${mode}.${base_clk_name}
            puts "**STA_SDC_INFO: Adding new clock $new_clock_name to sta_qual_clock_def"
            set clock_def($new_clock_name) $new_data
          }
      } elseif {[info exists sta_qual_clock_db_master_source($old_master)]} {
        puts "**STA_SDC_WARN: Warn : No definition at source point, will not remove clock as generated clock present"
      } else {
          puts "**STA_SDC_WARN: Need to remove clock $name, no corresponding generated clock"
          lappend remove_clocks $name
      }
    } else {
      puts "**STA_SDC_WARN: $point has no driver at top"
    }
  }

  foreach remove_clock $remove_clocks {
    puts "**STA_SDC_INFO: Removing clock $remove_clock"
    unset clock_def($remove_clock)
  }

  return [array get clock_def]
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_clocks_soc_db
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_conv_ICC2INNVOUS
## ProcArguments  : sta_qual_conv_ICC2INNVOUS ICC_ECO SOCE_ECO
## ProcDependency :  
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_conv_ICC2INNVOUS {ICC_ECO SOCE_ECO} {

###   if { [file exists $SOCE_ECO] } {
###     file delete -force $SOCE_ECO
###   }

  set outfile [open ${SOCE_ECO} w]

  # Write ECO mode options
  doHeader $outfile

  set infile [open ${ICC_ECO} r]

  while { [gets $infile line] != -1 } {
    # Reset skip_line at each new line read
    set skip_line false
    regsub -all {\[get_pins} $line {get_pins} line
    regsub -all {\[get_cells} $line {get_cells} line
    regsub -all {\[get_net} $line {get_net} line
    regsub -all {\[get_ports} $line {get_ports} line
    regsub -all {\}\]} $line \} line
    regsub -all {\"\ } $line {} line
    regsub -all {\"\]} $line {} nline

    if { [regexp "^#" [lindex $nline 0]] } {
      continue
    }
    if { [llength $nline] == 1 && [lindex $nline 0] == "current_instance" } {
      set c_instance ""
      set hGuide     ""
      set abor_flag 0
      puts $outfile "\n# current_instance = $c_instance \(top_cell\)"
      continue
    }
    if { [llength $nline] == 2 && [lindex $nline 0] == "current_instance" } {
      set c_instance [lindex $nline 1]
      set hGuide     $c_instance
      set abor_flag 0
      puts $outfile "\n# current_instance = $c_instance"
      continue
    }
    if { $c_instance != ""} {
      ##############################################
      # Here current instance is not the top-level #
      ##############################################

      if { [lindex $nline 0] == "insert_buffer" } {

        # -------------
        # insert_buffer
        # -------------

        #set n_pin [expr [lsearch -exact $nline "get_pins"] + 1]

        if {[regexp "get_ports" $nline]} {
          set n_port [expr [lsearch -exact $nline "get_ports"] + 1]
          set t_pin [get_pins -of [get_nets -of [get_ports [lindex $nline $n_port]]]]
          if {[sizeof $t_pin] > 1} {
            puts $outfile "### Warning: Buffer insertion multiple port net. insert_buffer will be ignored."
            puts $outfile "###    Offending Line: $nline"
            set skip_line true
          } else {
            set n_pin $n_port
            set tpin [lindex $nline $n_pin]
          }
        } elseif {[regexp "get_pins" $nline]} {
          set n_pin [expr [lsearch -exact $nline "get_pins"] + 1]
          set tpin [lindex $nline $n_pin]
        }

        if {$skip_line == "false"} {
          #set tpin [lindex $nline $n_pin]
          set buf  [lindex $nline [expr $n_pin + 1]]
          set pin "$c_instance/$tpin"
          set tmp_cell [lindex $nline [expr [lsearch -exact $nline "-new_cell_names"] + 1]]
          set new_cell "$tmp_cell"

          if { "-location" in $nline } {
            set n_location [expr [lsearch -exact $nline "-location"] + 1]
            set xloc [lindex [lindex $nline $n_location] 0]
            set yloc [lindex [lindex $nline $n_location] 1]
          }
          if { "-orientation" in $nline } {
            set n_ori [expr [lsearch -exact $nline "-orientation"] + 1]
            set old_ori [lindex [lindex $nline $n_ori] 0]
            set new_ori [oriconvert $old_ori]
          }

          # Set hGuide. Note that the pin may be at a lower level than c_instance, but
          # the buffer being inserted should ALWAYS be at the current instance level

          ### set spl [split $tpin "/"]
          ### if { [llength $spl] > 2 } {
          ###   # Here pin is at lower level than c_instance
          ###   set hh [join [lrange $spl 0 end-2] "/"]
          ###   set hGuide ${c_instance}/${hh}
          ### } else {
          ###   set hGuide ${c_instance}
          ### }

          set hGuide ${c_instance}

          ### puts $outfile "catch {set termptr \[dbGet top.insts.instTerms.name $c_instance\/$tpin\ \-p]}"
          puts $outfile "catch {set termptr \[dbGetObjByName $c_instance\/$tpin\]}"
          puts $outfile "catch {set tname \[dbGet \$termptr\.name\]}"
          # Now print out the eco line
          if { ("-location" in $nline) && ("-orientation" in $nline) } {
              puts $outfile "catch {ecoAddRepeater  -term \[lindex \$tname 0\] -hinstGuide \{$hGuide\} -name \{$new_cell\} -cell \{$buf\} -loc \{ $xloc $yloc \} -bufOrient $new_ori}"
          } else {
              puts $outfile "catch {ecoAddRepeater  -term \[lindex \$tname 0\] -hinstGuide \{$hGuide\} -name \{$new_cell\} -cell \{$buf\}}"
          }
        }

      } elseif { [lindex $nline 0] == "size_cell" } {

        #----------
        # size_cell
        #----------

        set tcell   [lindex $nline 1]
        set newref  [lindex $nline 2]
        set hGuide ${c_instance}
        set cell  "$c_instance/$tcell"
        puts $outfile "catch {ecoChangeCell -inst $cell -cell $newref}"

      } elseif { [lindex $nline 0] == "remove_buffer" } {

        #--------------
        # remove_buffer
        #--------------

        set n_cell [expr [lsearch -exact $nline "get_cells"] + 1]
        set tcell   [lindex $nline $n_cell]
        set cell $c_instance/$tcell
        puts $outfile "catch {ecoDeleteRepeater -inst $cell}"

      } elseif { [lindex $nline 0] == "add_buffer_on_route" } {

        #---------------------
        # add_buffer_on_route
        #---------------------

        set n_cell [expr [lsearch -exact $nline "get_net"] + 2]
        set start_pin [lindex $nline $n_cell]

        ### set start_cell [get_cells -of $c_instance/$start_pin]
        set n_cell [expr [lsearch -exact $nline "-user_specified_buffers"] + 1]
        set t_cells [lindex $nline $n_cell]

        set t_names ""
        set t_refs ""
        set t_locs ""
        set abor_flag 1  ; # This flag will tell the subsequent set_cell_location command
                           # to handle that cell's instance name differently.
        # user_specified_buffers is a 5-tuple consisting of <inst_name> <lib_cell_name> <xloc> <yloc> <lyr>
        for { set t [expr [llength $t_cells]/5] } { $t > 0 } {incr t -1} {
          set idx [expr $t - 1]
          set t_names [lindex $t_cells [expr $idx*5]]
          set t_refs  [lindex $t_cells [expr $idx*5+1]]
          set t_locs "[lindex $t_cells [expr $idx*5+2]]"
          set t_locs [concat $t_locs "[lindex $t_cells [expr $idx*5+3]]"]

          # Get net name from start_pin (under current_instance) and set hGuide.
          # Note that the start_pin may be at a lower level than c_instance, but the
          # on-route buffer(s) being inserted should ALWAYS be at the current instance level

          ### set spl [split $start_pin "/"]
          ### if { [llength $spl] > 2 } {
          ###   # Here start_pin is at lower level than c_instance
          ###   set hh [join [lrange $spl 0 end-2] "/"]
          ###   set hGuide ${c_instance}/${hh}
          ### } else {
          ###   set hGuide ${c_instance}
          ### }

          set hGuide ${c_instance}

          ### puts $outfile "catch {set termptr \[dbGet top.insts.instTerms.name $c_instance\/$start_pin\ \-p]}"
          puts $outfile "catch {set termptr \[dbGetObjByName $c_instance\/$start_pin\]}"
          puts $outfile "catch {set nname \[dbGet \$termptr\.net\.name\]}"
          puts $outfile "catch {ecoAddRepeater -net \[lindex \$nname 0\] -hinstGuide \{$hGuide\}  -name \{$t_names\} -cell \{$t_refs\} -offLoadAtLoc \{$t_locs\}}"
          set t_names ""
          set t_refs ""
          set t_locs ""
        }

      } elseif { [lindex $nline 0] == "set_cell_location" } {

        #------------------
        # set_cell_location
        #------------------

        # Here we have a set_cell_location command. Expecting c_instance/hGuide is already set correctly
        set n_cell [expr [lsearch -exact $nline "get_cells"] + 1]
        set acell [lindex $nline $n_cell]

        # Handle case (due to PT bug?) where add_buffer_on_route is adding buffer at one level of hierarchy
        # but is doing set_cell_location referencing the cell at a lower level level in the hierachy.
        # In this case, we want to only use the tail of the "acell". (b/172040393)
        set spl [split $acell "/"]
        set tcell [lindex $spl end]

        if { "-coordinates" in $nline } {
          set n_location [expr [lsearch -exact $nline "-coordinates"] + 1]
          set xloc [lindex [lindex $nline $n_location] 0]
          set yloc [lindex [lindex $nline $n_location] 1]
        }
        if { "-orientation" in $nline } {
          set n_ori [expr [lsearch -exact $nline "-orientation"] + 1]
          set old_ori [lindex [lindex $nline $n_ori] 0]
          set new_ori [oriconvert $old_ori]
        }
        # Write out the location commands.
        # Note: The set_cell_location command can follow a size_cell command (abor_flag=0),
        # ----  in which case we need to use the $acell as the instance name; or it can
        #       follow an add_buffer_on_route command ($abor_flag=1), in which case we need
        #       to use $tcell as the instance name.
        if { $abor_flag == 0 } {
          puts $outfile "catch {  set instptr \[dbGet top.insts.name ${hGuide}\/$acell \-p\]}"
        } else {
          ### puts $outfile "catch {  set instptr \[dbGet top.insts.name \*$tcell \-p\]}"
          puts $outfile "catch {  set instptr \[dbGet top.insts.name ${hGuide}\/$tcell \-p\]}"

        }
        puts $outfile "catch {  dbSet \$instptr\.pt_x $xloc}"
        puts $outfile "catch {  dbSet \$instptr\.pt_y $yloc}"
        puts $outfile "catch {  dbSet \$instptr\.orient $new_ori}"

      } elseif { [lindex $nline 0] == "map_freeze_silicon" } {

        #--------------------
        # map_freeze_silicaon
        #--------------------

        set n_cell [expr [lsearch -exact $nline "-spare_cell"] + 1]
        set tcell [lindex $nline $n_cell]
        set cell $cinstance/$tcell
        puts $outfile "\n# DBG: dbGet \[dbGet top.insts.name $cell -p\].pt_x"
        puts $outfile "catch {deleteFiller -inst $cell}"
      }

    } else {

      ######################################
      # Here current_instance is top-level #
      ######################################

      if { [lindex $nline 0] == "insert_buffer" } {

        #--------------------------
        # insert_buffer (top-level)
        #--------------------------

        if {[regexp "get_ports" $nline]} {
          set n_port [expr [lsearch -exact $nline "get_ports"] + 1]
          set t_pin [get_pins -of [get_nets -of [get_ports [lindex $nline $n_port]]]]
          if {[sizeof $t_pin] > 1} {
            puts $outfile "### Warning: Buffer insertion multiple port net. insert_buffer will be ignored."
            puts $outfile "###    Offending Line: $nline"
            set skip_line true
          } else {
            set n_pin $n_port
            set tpin [lindex $nline $n_pin]
          }
        } elseif {[regexp "get_pins" $nline]} {
          set n_pin [expr [lsearch -exact $nline "get_pins"] + 1]
          set tpin [lindex $nline $n_pin]
        }
        if {$skip_line == "false"} {
          #set tpin [lindex $nline $n_pin]
          set buf  [lindex $nline [expr $n_pin + 1]]
          set pin "$tpin"
          set tmp_cell [lindex $nline [expr [lsearch -exact $nline "-new_cell_names"] + 1]]
          set new_cell "$tmp_cell"

          if { "-location" in $nline } {
            set n_location [expr [lsearch -exact $nline "-location"] + 1]
            set xloc [lindex [lindex $nline $n_location] 0]
            set yloc [lindex [lindex $nline $n_location] 1]
          }
          if { "-orientation" in $nline } {
            set n_ori [expr [lsearch -exact $nline "-orientation"] + 1]
            set old_ori [lindex [lindex $nline $n_ori] 0]
            set new_ori [oriconvert $old_ori]
          }
          ### puts $outfile "catch {set termptr \[dbGet top.insts.instTerms.name  $tpin\ \-p]}"
          puts $outfile "catch {set termptr \[dbGetObjByName $tpin\]}"
          puts $outfile "catch {set tname \[dbGet \$termptr\.name\]}"
          # Now print out the eco line
          if { ("-location" in $nline) && ("-orientation" in $nline) } {
          puts $outfile "catch {ecoAddRepeater -term \[lindex \$tname 0\] -name \{$new_cell\} -cell \{$buf\} -loc \{ $xloc $yloc \} -bufOrient $new_ori}"
          } else {
          puts $outfile "catch {ecoAddRepeater -term \[lindex \$tname 0\] -name \{$new_cell\} -cell \{$buf\}}"
          }
        }

      } elseif { [lindex $nline 0] == "size_cell" } {

        #----------------------
        # size_cell (top-level)
        #----------------------

        set tcell   [lindex $nline 1]
        set newref  [lindex $nline 2]
        set cell "$tcell"
        puts $outfile "catch {ecoChangeCell -inst $cell -cell $newref}"

      } elseif { [lindex $nline 0] == "remove_buffer" } {

        #--------------------------
        # remove_buffer (top-level)
        #--------------------------

        set n_cell [expr [lsearch -exact $nline "get_cells"] + 1]
        set tcell   [lindex $nline $n_cell]
        set cell $tcell
        puts $outfile "catch {ecoDeleteRepeater -inst $cell}"

      } elseif { [lindex $nline 0] == "add_buffer_on_route" } {

        #--------------------------------
        # add_buffer_on_route (top-level)
        #--------------------------------

        set n_cell [expr [lsearch -exact $nline "get_net"] + 2]
        set start_pin [lindex $nline $n_cell]

        ### set start_cell [get_cells -of $start_pin]
        set n_cell [expr [lsearch -exact $nline "-user_specified_buffers"] + 1]
        set t_cells [lindex $nline $n_cell]

        set t_names ""
        set t_refs ""
        set t_locs ""
        set abor_flag 1  ; # This flag will tell the subsequent set_cell_location command
                           # to handle that cell's instance name differently.
        # user_specified_buffers is a 5-tuple consisting of <inst_name> <lib_cell_name> <xloc> <yloc> <lyr>
        for { set t [expr [llength $t_cells]/5] } { $t > 0 } {incr t -1} {
          set idx [expr $t - 1]
          set t_names [lindex $t_cells [expr $idx*5]]
          set t_refs  [lindex $t_cells [expr $idx*5+1]]
          set t_locs "[lindex $t_cells [expr $idx*5+2]]"
          set t_locs [concat $t_locs "[lindex $t_cells [expr $idx*5+3]]"]
          # Get net name from start_pin (current_instance is top level design)
          ### puts $outfile "catch {set termptr \[dbGet top.insts.instTerms.name $start_pin \-p\]}"
          puts $outfile "catch {set termptr \[dbGetObjByName $start_pin\]}"
          puts $outfile "catch {set nname \[dbGet \$termptr\.net\.name\]}"
          puts $outfile "catch {ecoAddRepeater -net \[lindex \$nname 0\] -name \{$t_names\} -cell \{$t_refs\} -offLoadAtLoc \{$t_locs\}}"
          set t_names ""
          set t_refs ""
          set t_locs ""
          }

      } elseif { [lindex $nline 0] == "set_cell_location" } {

        #------------------------------
        # set_cell_location (top-level)
        #------------------------------

        # Here we have a set_cell_location command.
        set n_cell [expr [lsearch -exact $nline "get_cells"] + 1]
        set acell [lindex $nline $n_cell]

        # Handle case (due to PT bug?) where add_buffer_on_route or insert_buffer
        # is adding buffer at one level of hierarchy but is doing set_cell_location
        # referencing the cell at a lower level level in the hierachy.
        # In this case, we want to only use the tail of the "acell". (b/172040393)
        set spl [split $acell "/"]
        set tcell [lindex $spl end]

        if { "-coordinates" in $nline } {
          set n_location [expr [lsearch -exact $nline "-coordinates"] + 1]
          set xloc [lindex [lindex $nline $n_location] 0]
          set yloc [lindex [lindex $nline $n_location] 1]
        }
        if { "-orientation" in $nline } {
          set n_ori [expr [lsearch -exact $nline "-orientation"] + 1]
          set old_ori [lindex [lindex $nline $n_ori] 0]
          set new_ori [oriconvert $old_ori]
        }
        # Write out the location commands
        # Remember...even if c_instance is null, we may be dealing with
        # a case (due to a bug in PT?) where the add_buffer_on_route
        # is adding a buffer at the the top-level but the set_cell_location is
        # referencing the cell at a different location in the hierarchy.
        if { $abor_flag == 0 } {
          puts $outfile "catch {  set instptr \[dbGet top.insts.name $acell \-p\]}"
        } else {
          puts $outfile "catch {  set instptr \[dbGet top.insts.name $tcell \-p\]}"
        }
        puts $outfile "catch {  dbSet \$instptr\.pt_x $xloc}"
        puts $outfile "catch {  dbSet \$instptr\.pt_y $yloc}"
        puts $outfile "catch {  dbSet \$instptr\.orient $new_ori}"

      } elseif { [lindex $nline 0] == "map_freeze_silicon" } {

        #--------------------------------
        # map_freeze_silicon ((top-level)
        #--------------------------------

        set n_cell [expr [lsearch -exact $nline "-spare_cell"] + 1]
        set tcell [lindex $nline $n_cell]
        set cell $tcell
        puts $outfile "\n# DBG: dbGet \[dbGet top.insts.name $cell -p\].pt_x"
        puts $outfile "catch {deleteFiller -inst $cell}"
      }

    }

  }

  # Reset ECO mode options
  doFooter $outfile

  close $infile
  close $outfile

}
