## ProcNameStart  : sta_qual_get_clock_sense
## ProcArguments  : sta_qual_get_clock_sense clock_sense_data view xfile
## ProcDependency :  
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_get_clock_sense {clock_sense_data view xfile} {
   set file_data [split $clock_sense_data "\n"]
   set out1 [open $xfile w+]
   set data "#Point,#Hier_Net,#Clock,#Sense"
   set dclass "clk_sense"
   puts $out1 "#pin,#top_clock,#top_block,#top_inst,#pin_size,#view,#class"
   set parse_data 0
   foreach line $file_data {
     regsub -all {\S\+} $line { } line
     set line_data [split $line " "]
     set point [lindex $line_data 0]
     set pclk  [lindex $line_data 1]
     set psen  [lindex $line_data 2]
     set object_point       [get_pins -quiet $point]
     append_to_collection  object_point  [get_nets -quiet $point]
     append_to_collection  object_point  [get_port -quiet $point]
     if { [llength $line_data] >= 3 && [sizeof_collection $object_point]} {
        set hnet     [get_object_name [get_nets -quiet [all_connected $point ]  ]]
        set clk_all  [get_attribute -quiet [get_pins -quiet $point] clocks]
        set clk_size [sizeof_collection  $clk_all]
        puts $out1 "$point->$pclk,$pclk,$psen,$hnet,$clk_size,$view,$dclass"
     }
  }
  close $out1
}
