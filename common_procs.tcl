##------------------------------------------------------------------
## ProcNameStart  : get_lib_usage
## ProcArguments  : get_lib_usage args
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc get_lib_usage args {
  if { [llength $args] == 0 } {
    set inst_collection  [get_cells -quiet -hier -filter "is_hierarchical==false"]
    set cell_collection  [get_lib_cells -quiet -of_object $inst_collection]
    set libs_collection  [get_libs -quiet -of_object $cell_collection]
  } elseif { [sizeof_collection [get_cells -quiet [lindex $args 0] -filter "is_hierarchical==false"]] > 0 } {
    set inst_collection  [get_cells -quiet [lindex $args 0] -filter "is_hierarchical==false"]
    set cell_collection  [get_lib_cells -quiet -of_object $inst_collection]
    set libs_collection  [get_libs -quiet -of_object $cell_collection]
  } elseif { [sizeof_collection [get_lib_cells -quiet [lindex $args 0]]] > 0 } {
    set cell_collection  [get_lib_cells -quiet [lindex $args 0]]
    set inst_collection  [get_cells  -quiet -of_object $cell_collection]
    set libs_collection  [get_libs  -quiet -of_object $cell_collection]
  } elseif { [sizeof_collection [get_libs -quiet [lindex $args 0]]] > 0 } {
    set libs_collection  [get_libs -quiet [lindex $args 0]]
    set cell_collection  [get_lib_cells -quiet $libs_collection]
    set inst_collection  [get_cells  -quiet -of_object $cell_collection]  
  } else {
    puts "**ERROR:: Argument provided is not a valid collection pattern or collection. Valid are cells/lib_cells/libs"
  }
    puts [format "**INFOX:: Cells=%020d    Lib_Cells=%010d     Libs=%010d" [sizeof_collection $inst_collection] [sizeof_collection $cell_collection] [sizeof_collection $libs_collection]]
    
    foreach_in_collection lib $libs_collection {
        set lib_name [get_object_name $lib]
        set cells_present [get_lib_cells -quiet -of_object $lib]
        set insts_used    [get_cells -quiet -of_object $lib]
        set cells_used    [get_lib_cells -quiet -of_object $insts_used]
        set cell_type     [lsort -uniq [get_attr $cells_used is_combinational]]
        puts [format  "%010d  %010d  %010s  %015d %s" [sizeof_collection $cells_present] [sizeof_collection $cells_used] $cell_type [sizeof_collection $insts_used] $lib_name]
    }


}
##------------------------------------------------------------------
## ProcNameEnd    : get_lib_usage
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : get_libx
## ProcArguments  : get_libx cell
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc get_libx cell {
    set lib_cell [get_lib_cell -quiet */$cell]
    set lib_cell [lindex [get_object_name $lib_cell] 0]
    set lib_path [lindex [split $lib_cell "/"] 0]
    set path     [lindex [get_attr [get_lib $lib_path] source_file_name] 0]
    regsub {.db$} $path {.lib.gz} x
    #set path "OrgFile: $path" 
    if { [file exist $x] } { 
	set path $x
    } else {
      regsub {.db$} $path {.lib} x
      if { [file exist $x] } { 
	  set path $x
      }
    }
    puts  "$lib_cell :  $path"
}
