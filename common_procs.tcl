##------------------------------------------------------------------
## ProcNameStart  : debug_wire_velocity
## ProcArguments  : debug_wire_velocity path_collection dump_detail xdebug xdir
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc debug_wire_velocity {path_collection dump_detail xdebug xdir} {
    file mkdir $xdir
    set dfile [open $xdir/detailed.rpt w+]
    set sfile [open $xdir/compact.csv w+]
    set header "#Arr,#X,#Y,#DArr,#DY,#DY,#DXY,#DVel,#TotalXY,#CumVel,#CumRCVel,#CumCellVel,#Dly_RC,#Dly_Cell,#Slack,#Slack_N,#FreqAct,#FreqReq,#Level,#Clock,#StartPoint"
    puts $sfile "$header"
    foreach_in_collection path $path_collection {
        set points [get_attr $path points]
        set x_ref 0
        set y_ref 0
        set path_stat [list $header]
        set totalXY 0.0
        set slack      [get_attr $path slack] 
        set norm_slack [get_attr $path normalized_slack]
        set xclock     [get_object_name [get_attr $path endpoint_clock]]
        set period     [get_attr [get_attr $path endpoint_clock] period]
        set arr_rc     0
        set arr_cell   0
        set level 0
        set startpin   [get_object_name    [get_attr $path startpoint]]
        set endpin     [get_object_name    [get_attr $path endpoint]]
        if { $norm_slack == "" } { set norm_slack $slack }

        if { $slack != "INFINITY" } {

                set  freq_tar   [format "%.3f" [expr 1/$period]]
                set  freq       [format "%.3f" [expr 1/($period - $slack)]]

	        
                foreach_in_collection point $points {
	            set pin       [get_object_name [get_attr $point object ] ]
                    set direction [get_attr [get_attr $point object ] direction]
	            set arr       [format "%.3f" [get_attr $point arrival] ]
                    set x_cor     [format "%.1f" [expr [get_attr [get_attr $point object ] x_coordinate]/1000] ]
	            set y_cor     [format "%.1f" [expr [get_attr [get_attr $point object ] y_coordinate]/1000] ]
	            incr level
	            
	            set old_data  [lindex $path_stat end]
	             
	            set arr_old   [lindex [split $old_data ","] 0]
	            set x_cor_old [lindex [split $old_data ","] 1]
	            set y_cor_old [lindex [split $old_data ","] 2]
	
	            set delta_x   0
	            set delta_y   0
	            set delta_arr 0
	            set distance  0
	            set velocity  0
	
	            set cum_velocity 0
	            set cum_velocity_rc 0
	            set cum_velocity_cell 0

	            catch  { set delta_x   [format "%.1f" [expr   abs($x_cor - $x_cor_old)]] }
	            catch  { set delta_y   [format "%.1f" [expr   abs($y_cor - $y_cor_old)]] }
	            catch  { set delta_arr [expr   $arr   - $arr_old]        }
	            catch  { set distance  [format "%.1f" [expr   $delta_x + $delta_y]]     }
	            catch  { set velocity  [format "%.3f" [expr   $distance/$delta_arr] ]    }
	            set totalXY [format "%.1f"     [expr $totalXY + $distance]]
	            if  { $direction == "in"} { 
                            set arr_rc   [format "%.3f" [expr  $arr_rc + $delta_arr] ]
                    } else {
                            set arr_cell [format "%.3f" [expr $arr_cell +  $delta_arr] ]
                    }

	            catch  { set cum_velocity      [format "%.3f" [ expr $totalXY/$arr]] }
	            catch  { set cum_velocity_rc   [format "%.3f" [ expr $totalXY/$arr_rc]] }
	            catch  { set cum_velocity_cell [format "%.3f" [ expr $totalXY/$arr_cell]] }

	            set data      "$arr,$x_cor,$y_cor,$delta_arr,$delta_x,$delta_y,$distance,$velocity,$totalXY,$cum_velocity,$cum_velocity_rc,$cum_velocity_cell,$arr_rc,$arr_cell,$slack,$norm_slack,$freq,$freq_tar,$level,$xclock,$pin"
	            lappend path_stat $data
	            #puts "$data"
	        }
                puts $sfile "[lindex $path_stat end]"
	        foreach data_point $path_stat {
	           if { $xdebug == "1"} {
                        set sample [split $data_point ","]
	                set outdata [format " %8s %12s %12s %8s %12s %12s %12s %12s %12s %12s %12s %12s %12s %12s %12s %12s %8s %8s %7s %12s %s"  [lindex $sample 0]  [lindex $sample 1]  [lindex $sample 2]  [lindex $sample 3]  [lindex $sample 4]  [lindex $sample 5]  [lindex $sample 6]  [lindex $sample 7]  [lindex $sample 8]  [lindex $sample 9]  [lindex $sample 10]  [lindex $sample 11]  [lindex $sample 12]  [lindex $sample 13]  [lindex $sample 14]  [lindex $sample 15]  [lindex $sample 16]  [lindex $sample 17]  [lindex $sample 18]  [lindex $sample 19]  [lindex $sample 20]  ]
	                puts "$outdata"
                   }
                   if { $dump_detail == "1"} { puts $dfile "$data_point" } 
	        }
                if { $dump_detail == "1"} { puts $dfile "" }      
        }
    }
    close $dfile
    close $sfile
    puts "\n\n\t\t**Open Dir [file normalize $xdir]\n\n"

}
##------------------------------------------------------------------
## ProcNameEnd    : debug_wire_velocity
