##------------------------------------------------------------------
## ProcNameStart  : sta_qual_report_supply_nets
## ProcArguments  : sta_qual_report_supply_nets dir file_tag view_scenario ports
## ProcDependency : sh 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_report_supply_nets {dir file_tag view_scenario ports} {
    puts [format "<GC::PROC> Start %-50s  [date]"   "sta_qual_report_supply_nets : $dir" ]

    # Optimize Filter Collection
    set my_design [get_object_name [current_design]]
    # Set File Tag/ Headers
    file mkdir    "$dir"
    set out_sum [open "$dir/$file_tag.nets.csv" w+]

    set supply_data "#Design,#Scenario,#Type,#Port,#Supply"
    set port_supply [get_supply_nets -quiet $ports]
    puts [format "<GC::PROC>       %-50s  [date]"   "                      : Ports=$ports" ]

    foreach_in_collection my_pwr $port_supply {
        set voltage  [format "%0.4f" "0"]
        if { [get_attribute -quiet $my_pwr voltage_max] != "" } {
            set voltage  [format "%0.4f" [get_attribute -quiet $my_pwr voltage_max]]
        }
        set supply_data  "$supply_data\n$my_design,$view_scenario,Supply_Net,[get_object_name $my_pwr],$voltage"
    }
    puts $out_sum "$supply_data"
    close $out_sum
    catch { sh cat $dir/$file_tag.nets.csv | column -t -s , > $dir/$file_tag.info }

    puts [format "<GC::PROC> Done  %-50s  [date]"   "sta_qual_report_supply_nets : $dir" ]
    return [file normalize $dir/$file_tag.supply_info]
}
