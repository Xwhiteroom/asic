##------------------------------------------------------------------
## ProcNameStart  : get_interface_db
## ProcArguments  : get_interface_db module_list outfile pba_mode
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc get_interface_db {module_list outfile pba_mode} {
	suppress_message UITE-479

	foreach module $module_list {
		puts "**INFO:: Module Under Analysis -- $module File:$outfile.$module.tcl"
		set budget_file  $outfile.$module.tcl
		echo "# timing Budget for $module" > $budget_file
		set module_insts [get_cells -hier -filter "ref_name == $module"]
		set module_pins  [get_pins -of_object $module_insts]
		puts "         Instances [sizeof_collection $module_insts]  [get_object_name $module_insts]"
		puts "         Pins      [sizeof_collection $module_pins]"
		set i 0
		set j 0
		set k [expr 0.1 *[sizeof_collection $module_pins]]
		foreach_in_collection inf_pin $module_pins {
			incr i
			incr j
			#if { $i > 1000 } { return 0};
			set path 		[get_timing_paths -pba_mode $pba_mode -through $inf_pin]
			set slack          	[get_attr $path slack]
			set pinx 		[get_object_name $inf_pin]
			set direction 		[get_attr $inf_pin direction]
			set arrival_pre		0
			set arrival_total	0
			set points		[get_attr $path points]
			set pin_ref_name        [get_attr [get_pin $pinx ] lib_pin_name]

			#puts "[sizeof_collection $points] $pinx $slack" 
			if { $slack != "INFINITY" &&  $slack != "" } { 
				set points		[get_attr $path points]				
				set arrival_total  	[get_attr $path arrival]
				set required_total 	[expr $slack + $arrival_total]

				foreach_in_collection point $points {  
					if { [get_object_name [get_attr $point object]] == $pinx} {  
						set arrival_pre [get_attr $point arrival] 
					}
					#puts "\t\t\t[get_attr $point arrival] [get_object_name [get_attr $point object]]"
				}
				set arrival_post	[expr $arrival_total - $arrival_pre]
				set path_stat 		"SK=$slack RT=$required_total AT=$arrival_total AI=$arrival_pre AO=$arrival_post Dir=$direction $pinx"
				if { $j >= $k} { puts "\t\t[date] $i/[sizeof_collection $module_pins]) $pinx P=$pin_ref_name $path_stat"; set j 0; }
				if { $direction == "in"} {
					set clk [get_object_name [get_attr $path endpoint_clock]]
					echo "set_input_delay [format "%.3f" [expr $required_total*$arrival_pre/$arrival_total]]  -max -clock \[get_clocks $clk\] \[get_ports $pin_ref_name\]; # $path_stat"    >> $budget_file
				} else {
					set clk [get_object_name [get_attr $path startpoint_clock]]					
					echo "set_output_delay [format "%.3f" [expr $required_total*$arrival_post/$arrival_total]] -max -clock \[get_clocks $clk\] \[get_ports $pin_ref_name\]; # $path_stat"  >> $budget_file					
				}
			} else {
				echo "#Free_Port \[get_ports $pin_ref_name\];" >> $budget_file
			}
		}

	}
	unsuppress_message UITE-479

}
##------------------------------------------------------------------
## ProcNameEnd    : get_interface_db
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : get_interface_net_stat
## ProcArguments  : get_interface_net_stat module_list outfile
## ProcDependency :  
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc get_interface_net_stat {module_list outfile} {
	suppress_message UITE-479
	foreach module $module_list {
		puts "**INFO:: Module Under Analysis -- $module File:$outfile.$module.tcl"
		set budget_file  $outfile.$module.csv
		echo "#Module,#Dir,#PortIn,#PortOut,#Fout_All,#Fout_Ext,#Fout_Int,#Drvr,#Drvr_Ref,#Net_Res,#Total_Cap,#Wire_Cap,#Pin_Cap,#Slack,#Delay" > $budget_file
		set module_insts [get_cells -hier -filter "ref_name == $module"]
		set module_pins  [get_pins -of_object $module_insts]
		puts "         Instances [sizeof_collection $module_insts]  [get_object_name $module_insts]"
		puts "         Pins      [sizeof_collection $module_pins]"
		set i 0
		set j 0
		set k [expr 0.1 *[sizeof_collection $module_pins]]
	
		foreach_in_collection inf_pin $module_pins {
			incr i
			incr j
			set dir [get_attr $inf_pin direction]
			set slack [get_attr [get_pins $inf_pin] max_slack]
			if { $slack < 0} {
				#puts "[get_object_name $inf_pin],$dir,$slack"
				if { $dir == "in"} {
			    		set in_port  [get_object_name $inf_pin]
			    		set out_drvr [get_object_name [get_pins [all_fanin  -to   $inf_pin -flat -level 1] -filter "direction == out && full_name !~ [get_object_name $module_insts]/*"]]
					set out_port [get_object_name [all_connected $out_drvr]]
				} else {
			   	 	set out_port [get_object_name $inf_pin]
			    		set in_load  [get_object_name [get_pins [all_fanout -from $inf_pin -flat -level 1] -filter "direction == in && full_name !~ [get_object_name $module_insts]/*"]]
					if { [llength $in_load] == 0} { set in_port "None"
					} else {  
						set in_port  [get_object_name [all_connected [lindex [get_object_name [get_pins -filter "direction == in"  $in_load]] 0]]]
					}
				}
				set drvr    [get_object_name [get_attr [get_nets $out_port] leaf_drivers]] 
				set fout_all [sizeof_collection [get_pins -filter "direction == in and is_hierarchical == false" [all_fanout -from $drvr -level 1 -flat ]]]
				set fout_int [sizeof_collection [get_pins -filter "direction == in and is_hierarchical == false" [all_fanout -from $drvr -level 1  ]]]
				set fout_ext [expr $fout_all - $fout_int]
				set dref     [get_attr [get_cells -of_object [get_pins $drvr] ] ref_name]
				set tcap     [get_attr [get_nets [all_connected $drvr]] total_capacitance_max]
				set wcap     [get_attr [get_nets [all_connected $drvr]] wire_capacitance_max]
				set pcap     [get_attr [get_nets [all_connected $drvr]] pin_capacitance_max]
				set tres     [get_attr [get_nets [all_connected $drvr]] net_resistance_max]
				set dly     [lindex [lsort [get_attr [get_timing_arc -from $out_port -to $in_port] delay_max]] end ]
				echo "$module,$dir,$in_port,$out_port,$fout_all,$fout_ext,$fout_int,$drvr,$dref,$tres,$tcap,$wcap,$pcap,$slack,$dly" >> $budget_file
				
			}
			if { $j >= $k} { puts "\t\t[date] $i/[sizeof_collection $module_pins])"; set j 0; }

		}
	}
}
