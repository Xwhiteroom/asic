##------------------------------------------------------------------
## ProcNameStart  : sta_qc_report_cells
## ProcArguments  : sta_qc_report_cells tag dir col args
## ProcDependency : sh 
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qc_report_cells {tag dir col args} {
    array unset ref_map0
    file mkdir $dir
    set outfile  "$dir/$tag.rpt"
    set tempfile "$dir/$tag.csv"
    set clockvtfile  "$dir/$tag.clockcells.rpt"
    set dontusefile  "$dir/$tag.dontusecells.rpt"

    set track "*"

    set listx [split [lindex $args 0] " "]
    #set listx [list ${track}TUL_*L08 ${track}TUL_*L10 ${track}TSL_*L08 ${track}TSL_*L10 ${track}TL_*L08 ${track}TL_*L10 ${track}TR_*L08 ${track}TR_*L10]
    set vt_string ""
    set dash_string ""

    foreach filx $listx { 
        set vt_string "$vt_string,#$filx"
        regsub -all {.} $filx {-} filx
        set dash_string "$dash_string,-$filx"
    }
    set vt_string "$vt_string,#XXX"
    set header "#Class_Type,#Count(#),#Relative(%)$vt_string"
    set dash   "-----------,---------,------------$dash_string"
    echo "$dash" > $tempfile
    echo "$header" >> $tempfile
    echo "$dash" >> $tempfile
    echo "#Type #Ref #Inst" > $clockvtfile
    echo "#Type #Ref #Inst" > $dontusefile

    set ref_map0(clk)  [get_cells -quiet $col -filter "is_clock_network_cell==true"]
    set ref_map0(dat)  [get_cells -quiet $col -filter "is_clock_network_cell==false"]

    set dontuse_cells  [get_cells -of_object [get_lib_cells */* -filter "dont_use==true"]]
    set ref_map0(duc)  [remove_from_collection -intersect $col $dontuse_cells]

    array unset ref_map1
    foreach class [lsort [array names ref_map0]] {
        #------------------------------------------
        # Clock/Data Top Class Filter
        #------------------------------------------
        # 
        set base $ref_map0($class)
        set ref_size [sizeof_collection $base]
        set filterx $base
            set base_size  [sizeof_collection $filterx]
            set vt_string ""
            foreach filx $listx {
                set cond "ref_name=~$filx"                
                set filtery [get_cells -quiet $filterx -filter "$cond"]
                set vt_size  [sizeof_collection $filtery]
                set vt_string "$vt_string,$vt_size"
                #set base    [remove_from_collection $base    $filtery] 
                set filterx [remove_from_collection $filterx $filtery]            
            }
            set vt_string "$vt_string,[sizeof_collection $filterx]"
            #set base [remove_from_collection $base $filterx]   
            set sub_class "$class.__ALL__"
            set ref_map1($sub_class) [format "%s,%03.2f$vt_string" $base_size [expr 100.000*$base_size/$ref_size] ]
        #------------------------------------------
        # Clock/Data Sub Class Filter
        #------------------------------------------
        # 
        set class_pair  [list  SEQ_MEM:is_memory_cell==true  SEQ_ICG:is_integrated_clock_gating_cell==true  SEQ_FFR:is_rise_edge_triggered==true  SEQ_FFF:is_fall_edge_triggered==true  SEQ_LTP:is_positive_level_sensitive==true  SEQ_LTN:is_negative_level_sensitive==true  SEQ_XXX:is_sequential==true  COM_BUF:ref_name=~*BUF*  COM_DLY:ref_name=~*DLY*  COM_INV:ref_name=~*INV*  COM_MUX:is_mux==true  COM_XXX:is_combinational==true  ]
                        
        foreach pair $class_pair {
            set type [lindex [split $pair ":"] 0]
            set cond [lindex [split $pair ":"] 1]
            set filterx [get_cells -quiet $base -filter "$cond"]
            set base_size  [sizeof_collection $filterx]
            set vt_string ""
            foreach filx $listx {
                set cond "ref_name=~$filx"
                set filtery [get_cells -quiet $filterx -filter "$cond"]
                if { $class == "clk" || $class == "duc" } { 
                    foreach_in_collection el  $filtery {
                        if {$class == "clk" } {  echo "$type [get_attr $el ref_name] [get_object_name $el]" >>  $clockvtfile }
                        if {$class == "duc" } {  echo "$type [get_attr $el ref_name] [get_object_name $el]" >>  $dontusefile }
                    }
                }


                set vt_size  [sizeof_collection $filtery]
                set vt_string "$vt_string,$vt_size"
                set base    [remove_from_collection $base    $filtery] 
                set filterx [remove_from_collection $filterx $filtery]            
            }
            set vt_string "$vt_string,[sizeof_collection $filterx]"
            set base [remove_from_collection $base $filterx]   
            set sub_class "$class.$type"
            set ref_map1($sub_class) [format "%s,%03.2f$vt_string" $base_size [expr 100.000*$base_size/$ref_size] ]

        }
        #------------------------------------------
        # Clock/Data Residual Class Filter
        #------------------------------------------
        # 
        set filterx $base
            set base_size  [sizeof_collection $filterx]
            set vt_string ""
            foreach filx $listx {
                set cond "ref_name=~$filx"                
                set filtery [get_cells -quiet $filterx -filter "$cond"]
                set vt_size  [sizeof_collection $filtery]
                set vt_string "$vt_string,$vt_size"
                set base    [remove_from_collection $base    $filtery] 
                set filterx [remove_from_collection $filterx $filtery]            
            }
            set vt_string "$vt_string,[sizeof_collection $filterx]"
            set base [remove_from_collection $base $filterx]   
            set sub_class "$class.XXX_XXX"
            set ref_map1($sub_class) [format "%s,%03.2f$vt_string" $base_size [expr 100.000*$base_size/$ref_size] ]
    }
    #------------------------------------------
    # Print Filter
    #------------------------------------------
    foreach class [lsort [array names ref_map1]] {
        set type [lindex [split $class "."] 1]
        set base $ref_map1($class)        
        if { $type == "__ALL__" } { echo "$dash" >> $tempfile }                
        echo "$class,$base" >> $tempfile
        if { $type == "__ALL__" } { echo "$dash" >> $tempfile }                        
    }
    puts "**Info :: Open files $outfile"
    sh cat $tempfile | column -t -s ','  > $outfile
    sh cat $outfile
}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qc_report_cells
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qc_report_csv_net
## ProcArguments  : sta_qc_report_csv_net infile outfile
## ProcDependency :  
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qc_report_csv_net {infile outfile} {
    set in  [open $infile    ]
    set out1 [open $outfile.clock.csv w+]
    set out2 [open $outfile.data.csv w+]
    puts $out1 "#type,#data_clock_net,#pin,#required,#actual,#slack,#net,"
    puts $out2 "#type,#data_clock_net,#pin,#required,#actual,#slack,#net,"
    array unset drv_nets_clock
    array unset drv_nets_data
    echo "** STA_CFG_INFO: Start CSV Mapping reports:  [date]"
    while { [gets $in line] >= 0 } {
       set pin    [lindex [split $line ","] 0]        
      if { $pin != "Design Object"} { 
       set rt     [lindex [split $line ","] 2]
       set at     [lindex [split $line ","] 3]
       set slack  [lindex [split $line ","] 4]
       set type   [lindex [split $line ","] 5]
       set categ [get_attr -quiet [get_pins -quiet $pin ] is_clock_network]
       set pins [get_pins -quiet $pin]
       if { [sizeof_collection $pins] > 0} {
           set net [get_object_name [get_attr -quiet $pins net]]
       } else {
           set net "No_net:$pin"
       }

       if { $categ == "true"  } { 
           set categ  "clock_net"           
           puts $out1 "$type,$categ,$pin,$rt,$at,$slack,$net,"
           if { ![info exist drv_nets_clock($net)] } {
                set wns $slack
                set tns $slack
                set cns 1
                set drv_nets_clock($net) "$type,$pin,$rt,$at,$wns,$tns,$cns"
           } else {
               set typex [lindex [split $drv_nets_clock($net) ","] 0]                
               set pinx  [lindex [split $drv_nets_clock($net) ","] 1]                
               set rtx   [lindex [split $drv_nets_clock($net) ","] 2]                
               set atx   [lindex [split $drv_nets_clock($net) ","] 3]                
               set wns   [lindex [split $drv_nets_clock($net) ","] 4]                
               set tns   [expr [lindex [split $drv_nets_clock($net) ","] 5] + $slack]
               set cns   [expr [lindex [split $drv_nets_clock($net) ","] 6] + 1]
               if { $wns > $slack} { 
                   set wns $slack
                   set rtx $rt
                   set atx $at
                   set pinx $pin
                   set typex $type
               }
               set drv_nets_clock($net) "$type,$pin,$rt,$at,$wns,$tns,$cns"               
           }
       } else {
           set categ  "data_net"           
           puts $out2 "$type,$categ,$pin,$rt,$at,$slack,$net,"
           if { ![info exist drv_nets_data($net)] } {
                set wns $slack
                set tns $slack
                set cns 1
                set drv_nets_data($net) "$type,$pin,$rt,$at,$wns,$tns,$cns"
           } else {
               set typex [lindex [split $drv_nets_data($net) ","] 0]                
               set pinx  [lindex [split $drv_nets_data($net) ","] 1]                
               set rtx   [lindex [split $drv_nets_data($net) ","] 2]                
               set atx   [lindex [split $drv_nets_data($net) ","] 3]                
               set wns   [lindex [split $drv_nets_data($net) ","] 4]                
               set tns   [expr [lindex [split $drv_nets_data($net) ","] 5] + $slack]
               set cns   [expr [lindex [split $drv_nets_data($net) ","] 6] + 1]
               if { $wns > $slack} { 
                   set wns $slack
                   set rtx $rt
                   set atx $at
                   set pinx $pin
                   set typex $type
               }
               set drv_nets_data($net) "$type,$pin,$rt,$at,$wns,$tns,$cns"               
           }

       }
     }
    }
    echo "** STA_CFG_INFO: End   CSV Mapping reports:  [date]"    
    set out3 [open $outfile.uniq.csv w+]    
    puts $out3  "#type,#pin,#required,#actual,#wns,#tns,#count,#net,#clock_data_net"
    foreach net [array names drv_nets_clock] {
        puts $out3 "$drv_nets_clock($net),$net,clock_net"
    }
    foreach net [array names drv_nets_data] {
        puts $out3 "$drv_nets_data($net),$net,data_net"
    }
    echo "** STA_CFG_INFO: All   CSV Mapping reports:  [date]"

    close $out1
    close $out2
    close $out3
    close $in
}
