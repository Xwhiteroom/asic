##------------------------------------------------------------------
## ProcNameStart  : sta_qual_get_io_target
## ProcArguments  : sta_qual_get_io_target filex
## ProcDependency :  
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_get_io_target filex { 
    global CORNER NETLISTS XCORNER
    echo "[format "%s,%s,%s,%s,%s,%s" "#PORT" "#CLOCK" "#DELAY(data+clk)" "#DIRECTION" "#SLACK(COMMENT)" "PERIOD" ]" >  $filex
    set ports  [add_to_collection [all_outputs] [all_inputs -exclude_clock_ports]]
    set size [sizeof_collection $ports]
    set    i 0
    set    j [expr 0.05 *$size]
    set    k 0 
    report_port [all_inputs -exclude_clock_ports ] -nos -input_delay > $filex.input.raw
    report_port [all_outputs ] -nos -output_delay > $filex.output.raw
    set flist [list in out]
    foreach direction $flist {
       set in [open $filex.${direction}put.raw ]
       while {[gets $in line] >= 0} {
           regsub -all {\s+} $line { } line 
           set data [split $line " "]
           if { [llength $data ] == 8} {
               set port   [lindex $data  0]
               set delay  [lindex $data  3]
               set clk    [lindex $data end-2]
               set period "NA"
               set slack  "NA"
               catch { set period [get_attr -quiet [get_clocks -quiet  $clk] period] }
               catch { set slack  [get_attr -quiet [get_ports -quiet  $port] max_slack] }

               if { [sizeof_collection [get_ports -quiet $port]] == 1 } {
                  echo "$port,$clk,$delay,$direction,$slack,$period" >>  $filex
                  incr i
                  incr k
                  if {$i > $j } { puts "            --Processed $k / $size [date]"; set i 0 }
               } 
           }
       }
       close $in
    } 
    puts "            --Processed $k / $size [date]"
    puts "            -- Open Budget File $filex"

}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_get_io_target
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : sta_qual_get_io_target_budgetted
## ProcArguments  : sta_qual_get_io_target_budgetted margin filex
## ProcDependency : sta_qual_port_clock_gls 
## ProcInfluence  : 0
## ProcRenamed    : 0
##------------------------------------------------------------------
proc sta_qual_get_io_target_budgetted {margin filex} { 
    global CORNER NETLISTS XCORNER
    suppress_message SEL-005
    echo "[format "%s,%s,%s,%s,%s,%s" "#PORT" "#CLOCK" "#DELAY(data+clk)" "#DIRECTION" "#SLACK(COMMENT)" "PERIOD" ]" >  $filex
    set ports  [add_to_collection [all_outputs] [all_inputs -exclude_clock_ports]]
    set size [sizeof_collection $ports]
    set    i 0
    set    j [expr 0.05 *$size]
    set    k 0 
    foreach_in_collection port $ports { 
            set port   [get_object_name $port]
            set data   [sta_qual_port_clock_gls $port $margin]
            regsub -all {\{|\}} $data {} data
            echo $data >> $filex
            incr i
            incr k
            if {$i > $j } { puts "            --Processed $k / $size [date]"; set i 0}
    }
    puts "            --Processed $k / $size [date]"
    puts "            -- Open Budget File"
    unsuppress_message SEL-005

}
##------------------------------------------------------------------
## ProcNameEnd    : sta_qual_get_io_target_budgetted
