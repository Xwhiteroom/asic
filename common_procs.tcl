proc ssi_print {color bg comment} {
      array set fg_codes {
          black   30
          red     31
          green   32
          orange  38;5;208
          blue    34
          magenta 35
          grey    38;5;244
          white   37
      }
      array set bg_codes {
          black   40
          red     41
          green   42
          orange  48;5;208
          blue    44
          magenta 45
          grey    48;5;244
          white   47
      }
      if {![info exists fg_codes($color)]} {
          error "ssi_print:: unknown color '$color' (valid: [lsort [array names fg_codes]])"
      }
      set code $fg_codes($color)
      if {$bg ne "" && $bg ne $color} {
          if {![info exists bg_codes($bg)]} {
              error "ssi_print:: unknown bg color '$bg' (valid: [lsort [array names bg_codes]])"
          }
          append code ";$bg_codes($bg)"
      }
      puts [format "\033\[%sm%-100s %30s\033\[0m" $code "$comment" [date]]
}
