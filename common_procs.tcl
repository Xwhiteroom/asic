##------------------------------------------------------------------
## ProcNameStart  : quick_slack_qor
## ProcArguments  : quick_slack_qor xslack bins
## ProcDependency :  
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc quick_slack_qor {xslack bins} {
	set slack    	[lsort -real -decreasing $xslack]
	set wns      	[lindex  $slack end]
	set fep      	[llength $slack]
	set tns      	0.000
	set empty_bins 	[lrepeat [llength $bins] 0]
	set bin_tdata  	$empty_bins
	set bin_tdataC 	$empty_bins
	set xwns        0.000
	foreach x $slack { 
		set tns [expr $tns + $x]
		if { $x < $xwns  }  { set xwns $x }
		set index_sk 0   
		while { $x <= [lindex $bins $index_sk] } { 
			#puts "[lindex $bins $index_sk] $x "
			# Cum
			lset bin_tdataC $index_sk [expr 1 + [lindex $bin_tdataC $index_sk]]
			incr index_sk
		}
		#Bin
		set index_sk [expr $index_sk -1 ]
		lset bin_tdata $index_sk [expr 1 + [lindex $bin_tdata $index_sk]]
	}
	set rest [list [format "%+0.3f" $wns]  $fep [format "%+0.3f" $tns]]
        #puts " $rest: $wns-->$xwns"
	return [list $bin_tdata $bin_tdataC $rest] 
}
##------------------------------------------------------------------
## ProcNameEnd    : quick_slack_qor
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : quick_timing
## ProcArguments  : quick_timing pba max_path slack_lt delay_min_max cumulative_1_0 ior_collection
## ProcDependency : autodesign_print_stage , sh , quick_timing_qor , pt_map_table 
## ProcInfluence  : 4
## ProcRenamed    : 0
##------------------------------------------------------------------
proc quick_timing {pba max_path slack_lt delay_min_max cumulative_1_0 ior_collection} {
    global SCENARIO
	if { ![info exist SCENARIO] } { set SCENARIO "MODE.PVTRC"}
	array unset timing_data
	array unset timing_col
	set_app_var enable_path_tagging true
	# Bin Checks
	set histo_bins           [list   0.100    0.050  0.010 -0.000 -0.001 -0.005 -0.010 -0.015 -0.025 -0.030 -0.040 -0.050 -0.075 -0.100 -0.150 -0.200 -0.300 -0.500 -1.00]
        if { $slack_lt <= 0 } {
		set histo_bins   [list   0.000  -0.0005 -0.001 -0.002 -0.003 -0.004 -0.005 -0.010 -0.015 -0.025 -0.030 -0.040 -0.050 -0.075 -0.100 -0.150 -0.200 -0.500 -1.00]
	}
    set xscale 1000
    set histo_bins_scaled {}
    set histo_bins_unscaled $histo_bins
    foreach v $histo_bins {
        lappend histo_bins_scaled [expr {$v * $xscale}]
    }
    set histo_bins $histo_bins_scaled

	regsub -all { |$} $histo_bins {ps } split_bins
	set data  [list ]
	set header  [concat [list "#Scenario"  "#Category" "#Group" "#Clock" "#WNS" "#FEP" "#TNS"] $split_bins]
	lappend  data $header
	
	# DLY Checks
    set dly_checks    [list]
	if { [regexp "max" $delay_min_max] }  { lappend dly_checks max }
	if { [regexp "min" $delay_min_max] }  { lappend dly_checks min }

    foreach delay_min_max $dly_checks {
		set ior "$ior_collection"
		if { ![regexp "i" $ior_collection] && ![regexp "o" $ior_collection] && ![regexp "r" $ior_collection]  } {
			if { [sizeof_collection  $ior] } {
				set all_user_paths [filter_collection $ior_collection "path_type==$delay_min_max && slack <= $slack_lt "]
				autodesign_print_stage  red "User   Paths [[sizeof_collection  $ior_collection]]   [expr [mem] / (1024*1024)]GB"
				autodesign_print_stage  red "Filter Paths [[sizeof_collection  $all_user_paths]]   [expr [mem] / (1024*1024)]GB"
				set ior "xxx"
			}
		}
	
		# All Timing Paths:
		autodesign_print_stage  blue "Init    [expr [mem] / (1024*1024)]GB"
	
        set valid_ports         [get_ports -quiet -filter "${delay_min_max}_slack <= $slack_lt"]
        catch { set valid_ports         [filter_collection $valid_ports "is_clock_source==false"]}
		set valid_input_ports   [get_ports -quiet -filter "direction==in"] 
		set valid_output_ports  [get_ports -quiet -filter "direction==out"] 


		autodesign_print_stage  blue "SmartIO [expr [mem] / (1024*1024)]GB"
		
		if { [regexp "xxx" $ior] } {
			set timing_col(${delay_min_max}input)   [filter_collection $all_user_paths "endpoint.object_class==pin  && startpoint.object_class==port"]
			autodesign_print_stage  blue "Input     [expr [mem] / (1024*1024)]GB"
			set timing_col(${delay_min_max}output)  [filter_collection $all_user_paths "endpoint.object_class==port && startpoint.object_class==pin"]
			autodesign_print_stage  blue "Output    [expr [mem] / (1024*1024)]GB"
			set timing_col(${delay_min_max}reg2reg) [filter_collection $all_user_paths "endpoint.object_class==pin  && startpoint.object_class==pin"]
			autodesign_print_stage  blue "Reg2Reg   [expr [mem] / (1024*1024)]GB"
			set timing_col(${delay_min_max}inout)   [filter_collection $all_user_paths "endpoint.object_class==port && startpoint.object_class==port"]
			autodesign_print_stage  blue "Inout     [expr [mem] / (1024*1024)]GB"
		}
	
		if { [regexp "i" $ior] } {
			#set timing_col(${delay_min_max}input)   [get_timing_path -delay $delay_min_max -pba $pba -max_path $max_path -slack_lesser_than $slack_lt -through $valid_input_ports  -exclude [get_ports -filter "direction==out && is_clock_source==false"]  ]
			set timing_col(${delay_min_max}input)   [get_timing_path -delay $delay_min_max -pba $pba -max_path $max_path -slack_lesser_than $slack_lt -through $valid_input_ports  -start_end_type in_to_reg  ]
			autodesign_print_stage  blue "Input   [expr [mem] / (1024*1024)]GB"
		}
	
		if { [regexp "o" $ior] } {
			#set timing_col(${delay_min_max}output)  [get_timing_path -delay $delay_min_max -pba $pba -max_path $max_path -slack_lesser_than $slack_lt -through $valid_output_ports -exclude [get_ports -filter "direction==in  && is_clock_source==false"]  ]
			set timing_col(${delay_min_max}output)  [get_timing_path -delay $delay_min_max -pba $pba -max_path $max_path -slack_lesser_than $slack_lt -through $valid_output_ports -start_end_type reg_to_out ]
	
			autodesign_print_stage  blue "Output  [expr [mem] / (1024*1024)]GB"
		}
	
		if { [regexp "i" $ior] || [regexp "o" $ior] } {
			#set timing_col(${delay_min_max}inout)   [get_timing_path -delay $delay_min_max -pba $pba -max_path $max_path -slack_lesser_than $slack_lt -from    $valid_input_ports  -to      $valid_output_ports ]
			set timing_col(${delay_min_max}inout)   [get_timing_path -delay $delay_min_max -pba $pba -max_path $max_path -slack_lesser_than $slack_lt -from    $valid_input_ports  -to      $valid_output_ports -start_end_type in_to_out]
			autodesign_print_stage  blue "Inout   [expr [mem] / (1024*1024)]GB"
		}
	
		if { [regexp "r" $ior] } {
			#set timing_col(${delay_min_max}reg2reg) [get_timing_path -delay $delay_min_max -pba $pba -max_path $max_path -slack_lesser_than $slack_lt -exclude [get_ports -filter "is_clock_source==false"] ]
			set timing_col(${delay_min_max}reg2reg) [get_timing_path -delay $delay_min_max -pba $pba -max_path $max_path -slack_lesser_than $slack_lt  -start_end_type reg_to_reg ]
	
			autodesign_print_stage  blue "Reg2Reg [expr [mem] / (1024*1024)]GB"
		}
		# All Stats	
		foreach cat [array names timing_col] {
			puts "<Info> -delay $delay_min_max -pba $pba -max_path $max_path -slack_lesser_than $slack_lt | $cat = [sizeof_collection $timing_col($cat)]"
			set out_data [quick_timing_qor $timing_col($cat) $histo_bins $cumulative_1_0]
			foreach x $out_data {
				lappend data [concat [list $SCENARIO] $cat $x] 
			}
		}
	}
	set tag [date].$SCENARIO.summary
	regsub -all { } $tag {_} tag	

	pt_map_table $data  > temp.$tag.raw
        set xfile [file normalize temp.$tag.raw]
	#puts "<Info>  $xfile "

	#puts "<Info>  | sed -e 's/ 0 / . /g' | sed -e 's/ //g' | egrep 'Group|Mhz' | sort -u  | sort -k 2"
        redirect -v temp_var {  sh cat $xfile | sed -e 's/ 0 / . /g' | sed -e 's/ //g' | egrep 'Group|Mhz' | sort -u  | sort -k 2 }
        set delimitx [lindex [split $temp_var ""] 0]
	regsub -all $delimitx $temp_var "," temp_var2
        echo $temp_var2 > temp.$tag.csv
        set yfile [file normalize temp.$tag.csv]
	#puts "<Info>  $yfile "
        redirect -file temp.$tag.all { sh cat ./temp.$tag.csv | column -t -s , }
        set zfile [file normalize temp.$tag.all]
	puts "<Info> $zfile "
        puts "\n"
        redirect -tee -file temp.$tag     { sh cat ./temp.$tag.csv | column -t -s , | egrep 'Group' }
        puts "\n"
	return $yfile
}
##------------------------------------------------------------------
## ProcNameEnd    : quick_timing
##------------------------------------------------------------------


##------------------------------------------------------------------
## ProcNameStart  : quick_timing_qor
## ProcArguments  : quick_timing_qor collection bins cumulative_1_0
## ProcDependency : quick_slack_qor 
## ProcInfluence  : 1
## ProcRenamed    : 0
##------------------------------------------------------------------
proc quick_timing_qor {collection bins cumulative_1_0} {
    global ssi_sta_tool_unit_dly
	set ref_collection [filter_collection $collection "slack<=0"]
	
	set empty_bins  [lrepeat [llength $bins] 0]
	set wns      	0.000
	set fep      	0
	set tns      	0.000
	set rest        [list [format "%+0.3f" $wns]  $fep [format "%+0.3f" $tns]]
	set bin_tdata  	[concat $rest $empty_bins]
	set list_blk    [list]
	if { [sizeof_collection $ref_collection] } {
		set bin_data $empty_bins
		set slack    [lsort -real -decreasing [get_attribute $ref_collection slack]]
		set group    [lsort -unique    [get_object_name  [get_attribute $ref_collection path_group]]]
		set eclock   [lsort -unique    [get_object_name  [get_attribute $ref_collection endpoint_clock]]]
		set sclock   [lsort -unique    [get_object_name  [get_attribute $ref_collection startpoint_clock]]]
		#set start    [lsort -unique    [get_object_name  [get_attribute $ref_collection startpoint]]]
		#set end      [lsort -unique    [get_object_name  [get_attribute $ref_collection endpoint]]]
		set qdata     [quick_slack_qor $slack $bins]
		set bin_tdata [concat [lindex $qdata 2]  [lindex $qdata $cumulative_1_0]]
		foreach groupx $group {
			set group_pathx [filter_collection $ref_collection "path_group.full_name==$groupx"]
			if { [sizeof_collection $group_pathx] } {
				foreach eclockx $eclock {
					set eclock_pathx [filter_collection $group_pathx "endpoint_clock.full_name==$eclockx"]
					if { [sizeof_collection $eclock_pathx] } {
						#set tagset      "$groupx.$eclockx"
						#create_path_tag_set -name $tagset  [get_timing_path -to [get_clocks  $eclockx] -group $groupx]
						#create_path_tag_set -name $tagset  $eclock_pathx
						set bslack    	[lsort -decreasing [get_attribute $eclock_pathx slack]]
						set qdata    	[quick_slack_qor $bslack $bins]
						set bin_data 	[concat [lindex $qdata 2]  [lindex $qdata $cumulative_1_0]]
						set freq        [format "%0000.0fMhz"  [expr $ssi_sta_tool_unit_dly / ( 0.000000001 + [get_attribute [get_clock $eclockx] period] + 0.000000001 )]]
						lappend  list_blk [concat [list "$groupx" "$eclockx ($freq)" ]  $bin_data]
					}
				}
			}
		} 
	}


	set out_data [list [concat [list "AllGroups" "AllClocks" ] $bin_tdata]]
	set out_data [concat $out_data $list_blk]
	return $out_data
}
##------------------------------------------------------------------
## ProcNameEnd    : quick_timing_qor
